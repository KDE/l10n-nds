#. i18n: file ./scripts/tablewizard.kmdr line 268
#. i18n: tag string
#. i18n: file ./scripts/tablewizard.kmdr line 308
#. +> trunk
#: rc.cpp:2815 rc.cpp:2824
msgid ""
"Enter here the title of the table. The title of the table will appear in the "
"table of contents as well, under the \"List of Tables\", if you are using "
"the KDE DocBook tools."
msgstr ""
"Giff hier den Titel vun de Tabell in. Wenn Du de Docbook-Warktüüch vun KDE "
"bruukst, warrt de Tabell ehr Titel ok in't Inholtverteken wiest, un lett sik "
"binnen de \"Tabellenlist\" finnen."

#. i18n: tag string
#. i18n: file ./scripts/tablewizard.kmdr line 300
#. +> trunk
#: rc.cpp:2821
msgid "Table Title"
msgstr "Tabell-Titel"

