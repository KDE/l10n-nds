#, kde-format
msgid "The following options are available for output format %1:"
msgstr "Bi't Utgaavformaat \"%1\" gifft dat disse Utgaavformaten::"

#. +> trunk
#: src/main.cpp:388
msgid "The input codec transforms the input text data into an universal internal format"
msgstr "De Ingaavkoderen wannelt den Ingaavtext üm na en allgemeen intern Formaat."

#. +> trunk
#: src/main.cpp:390
msgid "Default input encoding is 'local' unless input format is 'vcard', in which case the default encoding will be 'utf8'."
msgstr "De Standard-Ingaavkoderen is \"local\", utbenahmen dat Ingaavformaat is \"vcard\" - denn is de Standardkoderen \"utf8\"."

#. +> trunk
#: src/main.cpp:398
msgid "The output codec transforms the output text data from the internal format to an 8-bit text format"
msgstr "De Utgaavkoderen wannelt den Utgaavtext ut dat interne Formaat üm na en 8-Bit-Textformaat."

#. +> trunk
#: src/main.cpp:400
msgid "Default output encoding is 'local' unless output format is 'vcard', in which case the default encoding will be 'utf8'."
msgstr "De Standard-Utgaavkoderen is \"local\", utbenahmen dat Utgaavformaat is \"vcard\" - denn is de Standardkoderen \"utf8\"."

#. +> trunk
#: src/main.cpp:406
msgid "Built-in codecs are UTF8 and LOCAL, respectively using the 8-bit unicode format or your local encoding"
msgstr "Inbuut sünd de Koderen \"utf8\" un \"local\". De eerste bruukt dat 8-Bit-Formaat för Unicode, de anner Dien lokaal Koderen."

#. +> trunk
#: src/main.cpp:410
msgid "Other codecs can be specified by their ISO code, for example 'ISO 8859-15' for western european languages, including the Euro sign"
msgstr "Anner Koderen laat sik mit ehr ISO-Kode angeven, a.B. \"ISO-8859-15\", för westeuropääsch Spraken, de ok dat Euro-Teken bruukt"

#. +> trunk
#: src/main.cpp:423
msgid "kabc2mutt"
msgstr "kabc2mutt"

#. +> trunk
#: src/main.cpp:424
msgid "kabc - mutt converter"
msgstr "kabc-mutt-Wanneln"

#. +> trunk
#: src/main.cpp:427
msgid "Tobias König"
msgstr "Tobias König"

#. +> trunk
#: src/main.cpp:429
msgid "Contributor"
msgstr "Bidreger"

#. +> trunk
#: src/main.cpp:434
msgid "Only show contacts where name or address matches <placeholder>substring</placeholder>"
msgstr "Bloots Kontakten wiesen, bi de <placeholder>substring</placeholder> op Naam oder Adress passt"

#. +> trunk
#: src/main.cpp:436
msgid "Default format is 'alias'. 'query' returns email[tab]name[tab], as needed by mutt's query_command"
msgstr "Standardformaat is \"alias\". \"query\" gifft Nettpost[tab]Naam[tab] torüch, wat Mutt sien \"query_command\" so bruukt."

#. +> trunk
#: src/main.cpp:439
msgid "Default key format is 'JohDoe', this option turns it into 'jdoe'"
msgstr "Dat Standardformaat för Slötels is \"KlaasAchterndiek\", mit disse Optschoon warrt dor \"kachterndiek\" ut."

#. +> trunk
#: src/main.cpp:441
msgid "Make queries case insensitive"
msgstr "Bi Anfragen nich op Groot- un Lüttschrieven kieken"

#. +> trunk
#: src/main.cpp:443
msgid "Return all mail addresses, not just the preferred one"
msgstr "All Nettpostadressen torüchgeven, nich bloots de vörtrocken Adress"

#. +> trunk
#: src/main.cpp:499
msgid "Searching KDE addressbook"
msgstr "KDE-Adressbook warrt dörkeken"

#. +> trunk
#: src/main.cpp:505
msgid "No matches in KDE addressbook"
msgstr "Keen passen Indrääg binnen dat KDE-Adressbook"

#. +> trunk
#: src/inputformatimpls.cpp:46
msgid "Interprets input as a unique KABC contact identifier"
msgstr "Bruukt de Ingaav as eenkennig KABC-Kontakt-ID"

#. +> trunk
#: src/inputformatimpls.cpp:104
msgid "Interprets input as VCard data"
msgstr "Bruukt de Ingaav as vCard-Daten"

#. +> trunk
#: src/inputformatimpls.cpp:134
#, kde-format
msgid "Warning: using codec '%1' with input format vcard, but vCards are usually expected to be in UTF-8."
msgstr "Wohrschoen: För't Ingaavformaat \"vcard\" warrt de Koderen \"%1\" bruukt, man normalerwies warrt bi vCards UTF-8 verwacht."

#. +> trunk
#: src/inputformatimpls.cpp:180
msgid "Interprets input as email and optional name"
msgstr "Bruukt de Ingaav as Nettpostadress un köörwies Naam"

#. +> trunk
#: src/inputformatimpls.cpp:244
msgid ""
"Tries to get email and name from input,\n"
"\t\totherwise sets input text for both"
msgstr ""
"Versöcht, binnen de Ingaav Adress un Naam to finnen,\n"
"\t\tgeiht dat nich, warrt de Ingaav för beed Feller bruukt"

#. +> trunk
#: src/inputformatimpls.cpp:317
msgid ""
"Interprets the input as a name.\n"
"\t\tRecommended format is 'lastname, firstname middlename'"
msgstr ""
"Bruukt de Ingaav as en Naam.\n"
"\t\tAnraadt is dat Formaat \"Nanaam, Vörnaam Middelnaam\""

#. +> trunk
#: src/inputformatimpls.cpp:381
msgid "Interprets the input as a delimiter separated list of fields."
msgstr "Bruukt de Ingaav as en mit en Trennteken scheedt Weertenlist."

#. +> trunk
#: src/inputformatimpls.cpp:569
msgid "Select contacts in a dialog instead of reading input text"
msgstr "Kontakten binnen en Dialoog utsöken, keen Ingaavtext lesen"

