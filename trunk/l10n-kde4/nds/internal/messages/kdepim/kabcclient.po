msgstr "Bi't Ingaavformaat \"%1\" gifft dat disse Optschonen:"

#. +> trunk
#: src/main.cpp:326
msgid "The following output formats are available:"
msgstr "Dat gifft disse Utgaavformaten:"

#. +> trunk
#: src/main.cpp:365
#, kde-format
msgid "No options available for output format %1"
msgstr "Bi't Utgaavformaat \"%1\" gifft dat keen Optschonen."

