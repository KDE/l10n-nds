msgstr "Ingaavdaten as nieg Adressbook-Indrääg tofögen"

#. +> trunk
#: src/main.cpp:79
msgid "Remove entries matching the input data"
msgstr "Indrääg wegmaken, op de de Ingaavdaten passt"

#. +> trunk
#: src/main.cpp:83
msgid "Merge input data into the addressbook"
msgstr "Ingaavdaten mit dat Adressbook tosamenföhren"

#. +> trunk
#: src/main.cpp:87
msgid "Search for entries matching the input data"
msgstr "Na Indrääg söken, op de de Ingaavdaten passt"

#. +> trunk
#: src/main.cpp:91
msgid "List all entries in address book"
msgstr "All Indrääg binnen dat Adressbook oplisten"

#. +> trunk
#: src/main.cpp:93
msgid "Do not save changes to the addressbook on add/remove operations"
msgstr "Bi't Tofögen/Wegmaken de Ännern an't Adressbook nich sekern"

#. +> trunk
#: src/main.cpp:97
msgid "How to interpret the input data."
msgstr "Gifft dat Formaat an, mit dat de Ingaavdaten inleest warrt"

#. +> trunk
#: src/main.cpp:101
msgid "Input options for the selected format"
msgstr "Ingaav-Optschonen för't utsöchte Formaat"

#. +> trunk
#: src/main.cpp:105
msgid "How to present the output data."
msgstr "Gifft an, wodennig de Utgaav formateert warrt."

#. +> trunk
#: src/main.cpp:109
msgid "Output options for the selected format"
msgstr "Utgaav-Optschonen för't utsöchte Formaat"

#. +> trunk
#: src/main.cpp:113
msgid "How to convert the input text."
msgstr "Gifft an, wodennig de Ingaavtext wannelt warrt."

#. +> trunk
#: src/main.cpp:117
msgid "How to convert the output text."
msgstr "Gifft an, wodennig de Utgaavtext wannelt warrt."

#. +> trunk
#: src/main.cpp:119
msgid "Match key fields case sensitive. UID is always matched case sensitive"
msgstr "Bi't Kieken na passen Indrääg op Groot- un Lüttschrieven kieken. Jümmers bi Bruker-IDs."

#. +> trunk
#: src/main.cpp:121
msgid "Input to use instead of reading stdin"
msgstr "Ingaav, vun de ansteed vun de Standardingaav leest warrt"

#. +> trunk
#: src/main.cpp:162
msgid "No operation specified, assuming --search"
msgstr "Keen Akschoon angeven, \"--search\" warrt bruukt"

#. +> trunk
#: src/main.cpp:169 src/main.cpp:300
#, kde-format
msgid "Invalid input format \"%1\". See --input-format help"
msgstr "Leeg Ingaavformaat: \"%1\". Mehr in de Hülp to \"--input-format\""

#. +> trunk
#: src/main.cpp:179
#, kde-format
msgid "Invalid options for input format \"%1\". See --input-format-options help"
msgstr "Leeg Optschonen för't Ingaavformaat \"%1\". Mehr in de Hülp to \"--input-format-options\""

#. +> trunk
#: src/main.cpp:188 src/main.cpp:354
#, kde-format
