msgstr "Keen Beschrieven verföögbor"

#. +> trunk
#: src/main.cpp:311
#, kde-format
msgid "No options available for input format %1"
msgstr "Bi't Ingaavformaat \"%1\" gifft dat keen Optschonen"

#. +> trunk
#: src/main.cpp:312
#, kde-format
