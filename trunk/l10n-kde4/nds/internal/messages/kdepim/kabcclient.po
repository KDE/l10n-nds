#: src/main.cpp:62 src/main.cpp:429
msgid "Kevin Krammer"
msgstr "Kevin Krammer"

#. +> trunk
#: src/main.cpp:62 src/main.cpp:427
msgid "Primary Author"
msgstr "Hööftautor"

