#. +> trunk
#: src/outputformatimpls.cpp:54
msgid "Writes the unique KABC contact identifier"
msgstr "Gifft de eenkennige KABC-Kontakt-ID ut"

#. +> trunk
#: src/outputformatimpls.cpp:125
msgid "Exports to VCard format"
msgstr "Exporteert in't vCard-Formaat"

#. +> trunk
#: src/outputformatimpls.cpp:145
#, kde-format
msgid "Optionally use a different vCard version (default is %1)"
msgstr "Köörwies en anner vCard-Verschoon bruken (Standard is %1)"

#. +> trunk
#: src/outputformatimpls.cpp:151
msgid "Uses the vCard version 2.1"
msgstr "Bruukt de vCard-Verschoon 2.1"

#. +> trunk
#: src/outputformatimpls.cpp:168
#, kde-format
msgid "Warning: using codec '%1' with output format vcard, but vCards are usually expected to be in UTF-8."
msgstr "Wohrschoen: För't Utgaavformaat \"vcard\" warrt de Koderen \"%1\" bruukt, man normalerwies warrt bi vCards UTF-8 verwacht."

#. +> trunk
#: src/outputformatimpls.cpp:250
msgid "Writes email address or formatted name &lt;email address&gt;"
msgstr "Gifft \"Nettpostadress\" oder \"Formateert Naam &lt;Nattpostadress&gt;\" ut"

#. +> trunk
#: src/outputformatimpls.cpp:278
msgid "Comma separated list of: allemails, withname"
msgstr "Mit Kommas trennt List ut \"allemails\", \"withname\""

#. +> trunk
#: src/outputformatimpls.cpp:283 src/outputformatimpls.cpp:427
msgid "List all email addresses of each contact"
msgstr "All Nettpostadressen vun elk Kontakt oplisten"

#. +> trunk
#: src/outputformatimpls.cpp:288
msgid ""
"Prepend formatted name, e.g\n"
"\t\tJohn Doe &lt;jdoe@foo.com&gt;"
msgstr ""
"Formateert Naam vöranstellen, a.B.\n"
"\t\tKlaas Achterndiek &lt;k.achterndiek@nds.net&gt;"

#. +> trunk
#: src/outputformatimpls.cpp:389
msgid "Formats output as needed by the mail client mutt"
msgstr "Formateert de Utgaav, as dat Nettpostprogramm Mutt dat bruukt"

#. +> trunk
#: src/outputformatimpls.cpp:422
msgid "Comma separated list of: allemails, query, alias, altkeys. Default is alias"
msgstr "Mit Kommas trennt List ut \"allemails\", \"query\", \"alias\" un \"altkeys\". Standard is \"alias\"."

#. +> trunk
#: src/outputformatimpls.cpp:432
msgid ""
"Use mutt's query format, e.g.\n"
"\t\tjdoe@foo.com [tab] John Doe\n"
"\t\tConflicts with alias"
msgstr ""
"Mutt sien Anfraagformaat bruken, a.B.\n"
"\t\tk.achterndiek@nds.net [Tab] Klaas Achterndiek\n"
"\t\tGeiht nich mit Alias tosamen"

#. +> trunk
#: src/outputformatimpls.cpp:439
msgid ""
"Use mutt's alias format, e.g.\n"
"\t\talias JohDoe[tab]John Doe &lt;jdoe@foo.com&gt;\n"
"\t\tConflicts with query"
msgstr ""
"Mutt sien Alias-Formaat bruken, a.B.\n"
"\t\talias KlaaDiek[tab]Klaas Achterndiek &lt;k.achterndiek@nds.net&gt;\n"
"\t\tGeiht nich mit Anfraag tosamen"

#. +> trunk
#: src/outputformatimpls.cpp:446
msgid ""
"Use alternative keys with alias format, e.g.\n"
"\t\talias jdoe[tab]John Doe &lt;jdoe@foo.com&gt;"
msgstr ""
"Anner Slötels mit Alias-Formaat bruken, a.B.\n"
"\t\talias Kliek[tab]Klaas Achterndiek &lt;k.achterndiek@nds.net&gt;"

#. +> trunk
#: src/outputformatimpls.cpp:506
msgid "preferred"
msgstr "vörtrocken"

#. +> trunk
#: src/outputformatimpls.cpp:611
msgid "Writes the data as a delimiter separated list of values"
msgstr "Gifft de Daten as över dat Trennteken scheedt Weertenlist ut"

#. +> trunk
#: src/outputformatimpls.cpp:631 src/inputformatimpls.cpp:401
msgid "Specify one of the following CSV templates:"
msgstr "Söök bitte een vun de nakamen CSV-Vörlagen ut:"

