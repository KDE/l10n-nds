msgstr "Leeg Utgaavformaat: \"%1\". Mehr in de Hülp to \"--output-format\""

#. +> trunk
#: src/main.cpp:198
#, kde-format
msgid "Invalid options for output format \"%1\". See --output-format-options help"
msgstr "Leeg Optschonen för't Utgaavformaat \"%1\". Mehr in de Hülp to \"--output-format-options\""

#. +> trunk
#: src/main.cpp:211
#, kde-format
msgid "Invalid input codec \"%1\""
msgstr "Leeg Ingaavkoderen: \"%1\""

#. +> trunk
#: src/main.cpp:222
#, kde-format
msgid "Invalid output codec \"%1\""
msgstr "Leeg Utgaavkoderen: \"%1\""

