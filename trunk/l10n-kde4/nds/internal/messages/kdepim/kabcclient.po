#: src/kabcclient.cpp:48
msgid "Saving modifications to addressbook failed"
msgstr "Sekern vun de Ännern in't Adressbook fehlslaan"

#. +> trunk
#: src/kabcclient.cpp:49
#, kde-format
msgid "Input number %1 matches more than one contact. Skipping it to avoid undesired results"
msgstr "Ingaav Nummer %1 passt op mehr as een Kontakt. Se warrt utlaten, anners gifft dat villicht leeg Resultaten."

#. +> trunk
#: src/kabcclient.cpp:92
#, kde-format
msgid "Input format '%1' not usable with operation '%2'"
msgstr "Ingaavformaat \"%1\" lett sik bi de Akschoon \"%2\" nich bruken"

