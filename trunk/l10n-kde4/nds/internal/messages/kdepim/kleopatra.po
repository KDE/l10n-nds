#: rc.cpp:572
msgid "Create a personal OpenPGP key pair"
msgstr "En persöönlich OpenPGP-Slötelpoor opstellen"

#. i18n: tag string
#. i18n: file ./newcertificatewizard/chooseprotocolpage.ui line 34
#. +> trunk
#: rc.cpp:575
msgid ""
"OpenPGP key pairs are created locally, and certified by your friends and "
"acquaintances. There is no central certification authority; instead, every "
"individual creates a personal Web Of Trust by certifying other user's key "
"pairs with his own certificate."
msgstr ""
"OpenPGP-Slötelporen warrt lokaal opstellt un vun Dien Frünnen un Bekannten "
"beglöövt. Dat gifft keen zentraal Zertifikaatautoriteet, ansteed buut elkeen "
"sien egen Vertroennett op, wenn he anner Lüüd ehr Slötels mit sien egen "
"Slötel beglöven deit."

#. i18n: tag string
#. i18n: file ./newcertificatewizard/chooseprotocolpage.ui line 41
#. +> trunk
#: rc.cpp:578
msgid "Create a personal X.509 key pair and certification request "
msgstr "En persöönlich X.509-Slötelpoor un Beglöövanfraag opstellen"

#. i18n: tag string
#. i18n: file ./newcertificatewizard/chooseprotocolpage.ui line 50
#. +> trunk
#: rc.cpp:581
msgid ""
"X.509 key pairs are created locally, but certified centrally by a "
"certification authority (CA). CAs can certify other CAs, creating a central, "
"hierarchical chain of trust."
msgstr ""
"X.509-Slötelporen warrt lokaal opstellt un vun en zentraal "
"Zertifikaatautoriteet (ZA) beglöövt. ZAen köönt anner ZAen beglöven, so dat "
"en zentraal, hierarch'sch Vertroenkeed opbuut warrt."

