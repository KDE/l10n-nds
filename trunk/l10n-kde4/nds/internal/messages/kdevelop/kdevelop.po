#. +> trunk
#: languages/cpp/debugger/debuggerplugin.cpp:241
msgid ""
"<b>Run to cursor</b>"
"<p>Continues execution until the cursor position is reached."
msgstr ""
"<b>Bet Blinker utföhren</b>"
"<p>Maakt mit dat Utföhren bet na de Blinkerpositschoon wieder."

