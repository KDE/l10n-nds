#. +> trunk
#: mediaobject.cpp:88
msgid ""
"Cannot start playback. \n"
"\n"
"Check your Gstreamer installation and make sure you \n"
"have libgstreamer-plugins-base installed."
msgstr ""
"Afspelen lett sik nich starten. \n"
"\n"
"Prööv bitte Dien GStreamer-Installatschoon un beseker, \n"
"Du hest \"libgstreamer-plugins-base\" installeert."

#. +> trunk
#: mediaobject.cpp:849 mediaobject.cpp:858 mediaobject.cpp:870
#: mediaobject.cpp:877 mediaobject.cpp:882 mediaobject.cpp:902
#: mediaobject.cpp:1217 mediaobject.cpp:1241
msgid "Could not open media source."
msgstr "Stückborn lett sik nich opmaken."

#. +> trunk
#: mediaobject.cpp:865
msgid "Invalid source type."
msgstr "Leeg Borntyp."

#. +> trunk
#: mediaobject.cpp:1215
msgid "Could not locate media source."
msgstr "Stückborn lett sik nich finnen."

#. +> trunk
#: mediaobject.cpp:1225
msgid "Could not open audio device. The device is already in use."
msgstr "Klangreedschap lett sik nich opmaken. De Reedschap is al in Bruuk."

#. +> trunk
#: mediaobject.cpp:1238
msgid "Could not decode media source."
msgstr "Stückborn lett sik nich dekoderen.."

#. +> trunk
#: backend.cpp:171
msgid ""
"Warning: You do not seem to have the package gstreamer0.10-plugins-good installed.\n"
"          Some video features have been disabled."
msgstr ""
"Wohrschoen. As't lett hest Du dat Paket \"gstreamer0.10-plugins-good\" nich installeert.\n"
"          En Reeg Video-Funkschonen wöörn utmaakt."

#. +> trunk
#: backend.cpp:176
msgid ""
"Warning: You do not seem to have the base GStreamer plugins installed.\n"
"          All audio and video support has been disabled"
msgstr ""
"Wohrschoen. As't lett hest Du \"base\"-GStreamer-Modulen nich installeert.\n"
"          De hele Ünnerstütten för Klang un Video wöör utmaakt."
