#: app/tabbar.cpp:42
msgctxt "@info:whatsthis"
msgid ""
"<title>Tab Bar</title>"
"<para>The tab bar allows you to switch between sessions. You can double-click a tab to edit its label.</para>"
msgstr ""
"<title>Paneelbalken</title>"
"<para>Mit den Paneelbalken kannst Du de Törns wesseln. Na en Dubbelklick op en Paneelgreep kannst Du sien Naam bewerken.</para>"

