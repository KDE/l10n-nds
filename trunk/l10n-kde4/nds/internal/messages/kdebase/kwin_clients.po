#: rc.cpp:6
msgid "Display the window &icon in the caption bubble"
msgstr "Lütt&bild binnen de Titelbalken-Bucht wiesen"

#. i18n: tag string
#. i18n: file ./keramik/config/keramikconfig.ui line 28
#. +> trunk stable
#: rc.cpp:9
msgid "Check this option if you want the window icon to be displayed in the caption bubble next to the titlebar text."
msgstr "Aktiveer dit, wenn dat Finsterlüttbild binnen de Bucht blang den Text op den Titelbalken wiest warrn schall."

#. i18n: tag string
#. i18n: file ./keramik/config/keramikconfig.ui line 35
#. +> trunk stable
#: rc.cpp:12
msgid "Draw &small caption bubbles on active windows"
msgstr "Lütte B&uchten bi aktive Finstern"

#. i18n: tag string
#. i18n: file ./keramik/config/keramikconfig.ui line 38
#. +> trunk stable
#: rc.cpp:15
msgid "Check this option if you want the caption bubble to have the same size on active windows that it has on inactive ones. This option is useful for laptops or low resolution displays where you want maximize the amount of space available to the window contents."
msgstr "Aktiveer dit, wenn de Titelbalken-Buchten vun aktive Finstern jüst so groot as bi nich aktive Finstern wesen schöölt. Dat is goot för Klappreekners oder Schirmen mit siete Oplösen, wenn Een den Platz beter för den Finsterinholt bruken kann."

#. i18n: tag string
#. i18n: file ./keramik/config/keramikconfig.ui line 45
#. +> trunk stable
#: rc.cpp:18
msgid "Draw g&rab bars below windows"
msgstr "G&riepbalkens nerrn de Finstern"

#. i18n: tag string
#. i18n: file ./keramik/config/keramikconfig.ui line 48
#. +> trunk stable
#: rc.cpp:21
msgid "Check this option if you want a grab bar to be drawn below windows. When this option is not selected only a thin border will be drawn in its place."
msgstr "Aktiveer dit, wenn nerrn de Finstern en Balken för't Anfaten teekt warrn schall. Wenn dit nich aktiveert is, warrt nerrn bloots en dünne Rahmen teekt."

#. i18n: tag string
#. i18n: file ./keramik/config/keramikconfig.ui line 55
#. i18n: tag string
#. i18n: file ./plastik/config/configdialog.ui line 72
#. +> trunk stable
#: rc.cpp:24 rc.cpp:78
msgid "Use shadowed &text"
msgstr "&Textschadden bruken"

#. i18n: tag string
