#. i18n: tag string
#. i18n: file ./plastik/config/configdialog.ui line 69
#. +> trunk stable
#: rc.cpp:27 rc.cpp:75
msgid "Check this option if you want the titlebar text to have a 3D look with a shadow behind it."
msgstr "Aktiveer dit, wenn de Text op den Titelbalken en Schadden hebben schall."

#. i18n: tag string
#. i18n: file ./ozone/config/oxygenconfig.ui line 22
#. +> trunk
#: rc.cpp:33
msgid "When enabled, this option makes the window title bar use the same colors as the window contents, instead of using the system title bar colors."
msgstr "Wenn anmaakt, bruukt de Finster-Titelbalken de sülven Klören as de Finster-Inholt, man nich de Systeem-Titelbalkenklören."

#. i18n: tag string
#. i18n: file ./ozone/config/oxygenconfig.ui line 25
#. +> trunk
#: rc.cpp:36
msgid "Blend title bar colors with window contents"
msgstr "Titelbalken-Klören na Finsterinholt mischen"

#. i18n: tag string
#. i18n: file ./ozone/config/oxygenconfig.ui line 32
#. i18n: tag string
#. i18n: file ./oxygen/config/oxygenconfig.ui line 22
#. +> trunk
#: rc.cpp:39 rc.cpp:48
msgid "When enabled, this option increases the visibility of the window titlebar by showing stripes"
msgstr "Wenn anmaakt, maakt disse Optschoon den Finster-Titelbalken mit Striepen beter sichtbor."

#. i18n: tag string
#. i18n: file ./ozone/config/oxygenconfig.ui line 35
#. i18n: tag string
