msgid "Luís Pedro Coelho"
msgstr "Luís Pedro Coelho"

#. +> trunk stable
#: kwriteconfig.cpp:27
msgid "Bernhard Rosenkraenzer"
msgstr "Bernhard Rosenkraenzer"

#. +> trunk stable
#: kwriteconfig.cpp:27
msgid "Wrote kreadconfig on which this is based"
msgstr "Hett kreadconfig schreven, wat de Grundlaag för dit Programm weer"

#. +> trunk stable
#: kwriteconfig.cpp:31
msgid "Use <file> instead of global config"
msgstr "Bruuk <Datei> un nich de globalen Instellen"

#. +> trunk
#: kwriteconfig.cpp:32
msgid "Group to look in. Use repeatedly for nested groups."
msgstr "Koppel, binnen den Du kieken wullt. Bi inbett Koppeln mehrmaalig bruken."

#. +> stable
#: kwriteconfig.cpp:32
msgid "Group to look in"
msgstr "Koppel, binnen de keken warrt"

#. +> trunk stable
#: kwriteconfig.cpp:33
msgid "Key to look for"
msgstr "Slötel, de söcht warrt"

#. +> trunk stable
#: kwriteconfig.cpp:34
msgid "Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a string"
msgstr "Typ vun de Variable. Bruuk \"bool\" för'n Boolsche, anners warrt se as en Tekenkeed behannelt"

#. +> trunk stable
#: kwriteconfig.cpp:35
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr "De Weert, de schreven warrn schall. Mutt angeven warrn. Op'n Konsool tweemaal Apostrof ('') bruken, üm en leddigen Weert antogeven."
