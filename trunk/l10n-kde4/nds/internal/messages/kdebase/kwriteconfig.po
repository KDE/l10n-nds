#. +> trunk stable
#: kwriteconfig.cpp:23
msgid "Write KConfig entries - for use in shell scripts"
msgstr "KConfig-Indrääg schrieven - för Bruuk in Befehlsreegskripten"

#. +> trunk stable
#: kwriteconfig.cpp:25
