#. +> trunk stable
#: kio_sftp.cpp:424
msgid "An internal error occurred. Please retry the request again."
msgstr "Dat geev en intern Fehler. Bitte versöök dat nochmaal."

#. +> stable
#: kio_sftp.cpp:506
#, kde-format
msgid "Opening SFTP connection to host <b>%1:%2</b>"
msgstr "SFTP-Verbinnen na den Reekner <b>%1:%2</b> warrt opbuut."

#. +> trunk
#: kio_sftp.cpp:507
#, kde-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "SFTP-Verbinnen na den Reekner \"%1:%2\" warrt opbuut."

#. +> trunk stable
#: kio_sftp.cpp:511
msgid "No hostname specified"
msgstr "Keen Reeknernaam angeven"

#. +> trunk stable
#: kio_sftp.cpp:523
msgid "SFTP Login"
msgstr "SFTP-Anmellen"

#. +> trunk stable
#: kio_sftp.cpp:525
msgid "site:"
msgstr "Server:"

#. +> trunk stable
#: kio_sftp.cpp:629
msgid "Please enter your username and key passphrase."
msgstr "Bitte giff Dien Brukernaam un Slötelsatz in."

#. +> trunk stable
#: kio_sftp.cpp:631
msgid "Please enter your username and password."
msgstr "Bitte giff Dien Brukernaam un Passwoort in."

#. +> trunk stable
#: kio_sftp.cpp:639
msgid "Incorrect username or password"
msgstr "Brukernaam oder Passwoort gellt nich"

#. +> trunk stable
#: kio_sftp.cpp:644
msgid "Please enter a username and password"
msgstr "Bitte giff en Brukernaam un en Passwoort in"

#. +> trunk stable
#: kio_sftp.cpp:705
msgid "Warning: Cannot verify host's identity."
msgstr "Wohrscho: Identiteet vun den Reekner lett sik nich överpröven."

#. +> trunk stable
#: kio_sftp.cpp:716
msgid "Warning: Host's identity changed."
msgstr "Wohrscho: Identiteet vun den Reekner hett sik ännert."

#. +> trunk stable
#: kio_sftp.cpp:727 kio_sftp.cpp:728
msgid "Authentication failed."
msgstr "Identiteetprööv fehlslaan."

#. +> trunk stable
#: kio_sftp.cpp:742 kio_sftp.cpp:757
msgid "Connection failed."
msgstr "Tokoppeln fehlslaan."

#. +> trunk stable
#: kio_sftp.cpp:743 ksshprocess.cpp:819 ksshprocess.cpp:966
msgid "Connection closed by remote host."
msgstr "Verbinnen vun den annern Reekner afbraken."

#. +> trunk stable
#: kio_sftp.cpp:758
#, kde-format
msgid "Unexpected SFTP error: %1"
msgstr "Nich verwacht SFTP-Fehler: %1"

#. +> trunk stable
#: kio_sftp.cpp:802
#, kde-format
msgid "SFTP version %1"
msgstr "SFTP-Verschoon %1"

#. +> trunk stable
#: kio_sftp.cpp:808
msgid "Protocol error."
msgstr "Protokollfehler"

#. +> trunk stable
#: kio_sftp.cpp:814
#, kde-format
msgid "Successfully connected to %1"
msgstr "Verbinnen na %1 opstellt"

#. +> trunk stable
#: kio_sftp.cpp:1174
msgid "An internal error occurred. Please try again."
msgstr "Dat geev en intern Fehler. Bitte versöök dat nochmaal"

#. +> trunk stable
#: kio_sftp.cpp:1195
#, kde-format
msgid "Unknown error was encountered while copying the file to '%1'. Please try again."
msgstr "Dat geev en nich begäng Fehler bi't Koperen vun de Datei na \"%1\". Bitte nochmaal versöken."

#. +> trunk stable
#: kio_sftp.cpp:1432
msgid "The remote host does not support renaming files."
msgstr "De anner Reekner ünnerstütt dat Ümnömen vun Dateien nich."

#. +> trunk stable
#: kio_sftp.cpp:1481
msgid "The remote host does not support creating symbolic links."
msgstr "De anner Reekner ünnerstütt dat Anleggen vun symboolsche Links nich."

#. +> trunk stable
#: kio_sftp.cpp:1606
msgid "Connection closed"
msgstr "Afkoppelt"

#. +> trunk stable
#: kio_sftp.cpp:1608
msgid "Could not read SFTP packet"
msgstr "SFTP-Paket lett sik nich lesen"

#. +> trunk
#: kio_sftp.cpp:1717
msgid "End of file."
msgstr "Dateienn."

#. +> trunk
#: kio_sftp.cpp:1720
msgid "File does not exist."
msgstr "Gifft Datei nich."

#. +> trunk
#: kio_sftp.cpp:1724
msgid "Access is denied."
msgstr "Togriepen torüchwiest."

#. +> trunk stable
#: kio_sftp.cpp:1728
msgid "SFTP command failed for an unknown reason."
msgstr "SFTP-Befehl fehlslaan, de Grund is nich begäng."

#. +> trunk stable
#: kio_sftp.cpp:1732
msgid "The SFTP server received a bad message."
msgstr "De SFTP-Server hett en nich gellen Naricht kregen."

#. +> trunk stable
#: kio_sftp.cpp:1736
msgid "You attempted an operation unsupported by the SFTP server."
msgstr "Du wullst en Akschoon utföhren, de de SFTP-Server nich ünnerstütt."

#. +> trunk stable
#: kio_sftp.cpp:1740
#, kde-format
msgid "Error code: %1"
msgstr "Fehlerkode: %1"

#. +> trunk stable
#: ksshprocess.cpp:415
msgid "Cannot specify a subsystem and command at the same time."
msgstr "En Ünnersysteem un en Befehl köönt nich to de sülve Tiet angeven warrn."

#. +> trunk stable
#: ksshprocess.cpp:752
msgid "No options provided for ssh execution."
msgstr "Keen Optschonen för dat Utföhren vun SSH angeven."

#. +> trunk stable
#: ksshprocess.cpp:760
msgid "Failed to execute ssh process."
msgstr "SSH-Perzess lett sik nich utföhren."

#. +> trunk stable
#: ksshprocess.cpp:785 ksshprocess.cpp:814 ksshprocess.cpp:933
#: ksshprocess.cpp:1005
msgid "Error encountered while talking to ssh."
msgstr "Fehler bi de Kommunikatschoon mit SSH."

#. +> trunk stable
#: ksshprocess.cpp:865
msgid "Please supply a password."
msgstr "Bitte en Passwoort angeven"

#. +> trunk stable
#: ksshprocess.cpp:904
msgid "Please supply the passphrase for your SSH private key."
msgstr "Bitte den Slötelsatz för Dien privaten SSH-Slötel angeven"

#. +> trunk stable
#: ksshprocess.cpp:918
#, kde-format
msgid "Authentication to %1 failed"
msgstr "Identiteetprööv för %1 fehlslaan"

#. +> trunk stable
#: ksshprocess.cpp:941
#, kde-format
msgid "The identity of the remote host '%1' could not be verified because the host's key is not in the \"known hosts\" file."
msgstr "De Identiteet vun den Reekner \"%1\" lett sik nich överpröven, wiel de Slötel vun den Reekner nich binnen de Datei mit begäng Reekners steiht."

#. +> trunk stable
#: ksshprocess.cpp:947
msgid " Manually, add the host's key to the \"known hosts\" file or contact your administrator."
msgstr " Föög den Slötel vun Hand de Datei mit begäng Reekners to oder snack mit Dien Systeempleger."

#. +> trunk stable
#: ksshprocess.cpp:953
#, kde-format
msgid " Manually, add the host's key to %1 or contact your administrator."
msgstr " Föög den Slötel vun Hand de Datei %1 to oder snack mit Dien Systeempleger."

#. +> trunk stable
#: ksshprocess.cpp:985
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified. The host's key fingerprint is:\n"
"%2\n"
"You should verify the fingerprint with the host's administrator before connecting.\n"
"\n"
"Would you like to accept the host's key and connect anyway? "
msgstr ""
"De Identiteet vun den Reekner \"%1\" lett sik nich överpröven. De Fingerafdruck vun den Reekner sien Slötel is:\n"
"%2\n"
"Du schullst den Fingerafdruck vun den Systeempleger vun den Reekner beglöven laten, ehr Du Di tokoppelst.\n"
"\n"
"Wullt Du den Slötel liekers annehmen un Di tokoppeln?"

#. +> trunk stable
#: ksshprocess.cpp:1013
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may have just changed the host's key. Either way, you should verify the host's key fingerprint with the host's administrator. The key fingerprint is:\n"
"%2\n"
"Add the correct host key to \"%3\" to get rid of this message."
msgstr ""
"Wohrscho: De Identiteet vun den Reekner \"%1\" hett sik ännert!\n"
"\n"
"Dat mag wesen, dat Een versöcht, de Verbinnen to beluern, oder de Systeempleger hett bloots den Slötel vun den Reekner utwesselt. In beed Fäll schullst Du den Slötel sien Fingerafdruck vun den Systeempleger vun den Reekner beglöven laten. De Fingerafdruck is:\n"
"%2\n"
"Föög den richtigen Reekner-Slötel \"%3\" to, wenn Du disse Mellen looswarrn wullt."

#. +> trunk stable
#: ksshprocess.cpp:1048
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may have just changed the host's key. Either way, you should verify the host's key fingerprint with the host's administrator before connecting. The key fingerprint is:\n"
"%2\n"
"\n"
"Would you like to accept the host's new key and connect anyway?"
msgstr ""
"Wohrscho: De Identiteet vun den Reekner \"%1\" hett sik ännert!\n"
"\n"
"Dat mag wesen, dat Een versöcht, de Verbinnen to beluern, oder de Systeempleger hett bloots den Slötel vun den Reekner utwesselt. In beed Fäll schullst Du den Slötel sien Fingerafdruck vun den Systeempleger vun den Reekner beglöven laten, ehr Du Di tokoppelst. De Fingerafdruck is:\n"
"%2\n"
"Wullt Du den niegen Slötel liekers annehmen un Di tokoppeln?"

#. +> trunk stable
#: ksshprocess.cpp:1072
msgid "Host key was rejected."
msgstr "Reekner-Slötel wöör afwiest."
