#. +> trunk stable
#: kdessh.cpp:58
msgid "KDE ssh"
msgstr "KDE-ssh"

#. +> trunk stable
#: kdessh.cpp:59
msgid "Runs a program on a remote host"
msgstr "Föhrt en Programm op en feern Reekner ut"

#. +> trunk stable
#: kdessh.cpp:61
msgid "Copyright (c) 2000 Geert Jansen"
msgstr "Copyright (c) 2000 Geert Jansen"

#. +> trunk stable
#: kdessh.cpp:62
msgid "Geert Jansen"
msgstr "Geert Jansen"

#. +> trunk stable
#: kdessh.cpp:62
msgid "Maintainer"
msgstr "Pleger"

#. +> trunk stable
#: kdessh.cpp:68
msgid "Specifies the remote host"
msgstr "Gifft den annern Reekner an"

#. +> trunk stable
#: kdessh.cpp:69
msgid "The command to run"
msgstr "Befehl för't Utföhren"

#. +> trunk stable
#: kdessh.cpp:70
msgid "Specifies the target uid"
msgstr "Leggt de Teel-UID fast"

#. +> trunk stable
#: kdessh.cpp:71
msgid "Specify remote stub location"
msgstr "Gifft den Oort vun den feern Stumpen an"

#. +> trunk stable
#: kdessh.cpp:72
msgid "Do not keep password"
msgstr "Passwoort nich wohren"

#. +> trunk stable
#: kdessh.cpp:73
msgid "Stop the daemon (forgets all passwords)"
msgstr "Den Dämoon anhollen (all Passwöör kaamt weg)"

#. +> trunk stable
#: kdessh.cpp:74
msgid "Enable terminal output (no password keeping)"
msgstr "Utgaav na Terminal anmaken (keen Wohren vun Passwöör)"

#. +> trunk stable
#: kdessh.cpp:99
msgid "No command or host specified."
msgstr "Keen Befehl oder Reekner angeven."

#. +> trunk stable
#: kdessh.cpp:177
msgid ""
"Ssh returned with an error.\n"
"The error message is:\n"
"\n"
msgstr ""
"SSH hett en Fehler torüch geven.\n"
"De Fehlermellen is:\n"
"\n"

#. +> trunk stable
#: kdessh.cpp:189
msgid "Command"
msgstr "Befehl"

#. +> trunk stable
#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Kai F. Lahmann, Sönke Dibbern"

#. +> trunk stable
#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "kfl@3dots.de, s_dibbern@web.de"

#. +> trunk stable
#: sshdlg.cpp:56
msgid "The action you requested needs authentication. Please enter "
msgstr "För de Akschoon muttst Du angeven, wokeen Du büst. Bitte ingeven "

#. +> trunk stable
#: sshdlg.cpp:76
msgid "Conversation with ssh failed.\n"
msgstr "Kommunikatschoon mit ssh is fehlslaan.\n"

#. +> trunk stable
#: sshdlg.cpp:85
msgid ""
"The programs 'ssh' or 'kdesu_stub' cannot be found.\n"
"Make sure your PATH is set correctly."
msgstr ""
"De Programmen 'ssh' oder 'kdesu_stub' wöörn nich funnen.\n"
"Kiek na, wat Dien PATH-Variable richtig instellt is."

#. +> trunk stable
#: sshdlg.cpp:91
msgid "Incorrect password. Please try again."
msgstr "Leeg Passwoort. Versöök dat nochmaal."

#. +> trunk stable
#: sshdlg.cpp:95
msgid "Internal error: Illegal return from SshProcess::checkInstall()"
msgstr "Intern Fehler: SshProcess::checkInstall() hett en verbaden Weert torüchgeven"
