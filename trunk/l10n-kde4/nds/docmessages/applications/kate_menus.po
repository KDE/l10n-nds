#. Tag: title
#: menus.docbook:8 menus.docbook:303
#, no-c-format
msgid "Menu Entries"
msgstr "Menüindrääg"

#. Tag: title
#: menus.docbook:13
#, no-c-format
msgid "The File Menu"
msgstr "Dat Dateimenü"

#. Tag: menuchoice
#: menus.docbook:19
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:28
#, no-c-format
msgid ""
"This command <action>starts a new document</action> in the editing window. "
"In the <guibutton>Documents</guibutton> list on the left the new file is "
"named <emphasis>Untitled</emphasis>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:39
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:48
#, no-c-format
msgid ""
"Displays a standard &kde; <guilabel>Open File</guilabel> dialog. Use the "
"file view to select the file you want to open, and click on <guibutton>Open</"
"guibutton> to open it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:58
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open Recent</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:64
#, no-c-format
msgid ""
"This is a shortcut to open recently saved documents. Clicking on this item "
"opens a list to the side of the menu with several of the most recently saved "
"files. Clicking on a specific file will open it in &kappname; - if the file "
"still resides at the same location."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:77
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open With</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:83
#, no-c-format
msgid ""
"This submenu presents a list of applications known to handle the mime type "
"of your current document. Activating an entry will open the current document "
"with that application."
msgstr ""

#. Tag: para
#: menus.docbook:87
#, no-c-format
msgid ""
"In addition, a entry <guimenuitem>Other...</guimenuitem> command launches "
"the open with dialog box that allows you to <action>select another "
"application to open the active file</action>. Your file will still be open "
"in &kate;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:97
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:106
#, no-c-format
msgid ""
"This command <action>saves your file</action>. Use it often. If the file is "
"<emphasis>Untitled</emphasis> then <guimenuitem>Save</guimenuitem> becomes "
"<guimenuitem>Save As</guimenuitem>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:118
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:124
#, no-c-format
msgid ""
"<action>Name and rename files</action> with this command. It launches the "
"save file dialog box. This dialog works just as the open file dialog box "
"does. You can use it to navigate through your file system, preview existing "
"files, or filter your file view with file masks."
msgstr ""

#. Tag: para
#: menus.docbook:132
#, no-c-format
msgid ""
"Type the name you want to give the file you are saving in the Location combo "
"box and press the <guibutton>OK</guibutton> button."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:143
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:152
#, no-c-format
msgid "This command <action>saves all modified open files</action>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:161
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>F5</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Reload</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:170
#, no-c-format
msgid ""
"<action>Reloads the active file</action>. This command is useful if another "
"program or process has changed the file while you have it open in &kate;"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:181
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Reload All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:187
#, no-c-format
msgid "<action>Reloads all opened files.</action>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:196
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close Orphaned</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:202
#, no-c-format
msgid ""
"<action>Close</action> all documents in the file list, which could not be "
"reopened during startup, because they are not accessible anymore."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:211
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:220
#, no-c-format
msgid "<action>Print the active file</action>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:228
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:237
#, no-c-format
msgid ""
"Close the active file with this command. If you have made unsaved changes, "
"you will be prompted to save the file before &kate; closes it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:247
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close Other</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:253
#, no-c-format
msgid "Close other open documents."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:262
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:268
#, no-c-format
msgid ""
"This command <action>closes all the files you have open</action> in &kate;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:278
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:287
#, no-c-format
msgid ""
"This command <action>closes &kate;</action> and any files you were editing. "
"If you have made unsaved changes to any of the files you were editing, you "
"will be prompted to save them."
msgstr ""

#. Tag: title
#: menus.docbook:298
#, no-c-format
msgid "The Edit Menu"
msgstr ""

#. Tag: para
#: menus.docbook:299
#, no-c-format
msgid ""
"The <guimenu>Edit</guimenu> menu contains a host of commands, all to work "
"with the currently active document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:307
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:314
#, no-c-format
msgid "Undo the last editing command (typing, copying, cutting etc.)"
msgstr ""

#. Tag: para
#: menus.docbook:316
#, no-c-format
msgid ""
"If grouped undo is enabled, this may undo several editing commands of the "
"same type, like typing in characters."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:323
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:330
#, no-c-format
msgid "Redo the last undo step."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:337
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:344
#, no-c-format
msgid ""
"Removes selected text if any, and places a copy of the removed text in the "
"clipboard."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:351
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:358
#, no-c-format
msgid "Copies selected text, if any, to the clipboard."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:365
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:372
#, no-c-format
msgid ""
"Copies the first item in the clipboard into the editor at cursor position."
msgstr ""

#. Tag: para
#: menus.docbook:373
#, no-c-format
msgid ""
"If Overwrite Selection is enabled, the pasted text will overwrite the "
"selection, if any."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:380
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guisubmenu>Clipboard History</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:386
#, no-c-format
msgid ""
"This submenu will display the beginning of portions of text recently copied "
"to the clipboard. Select an item from this menu to paste it in the currently "
"open file."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:395
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:402
#, no-c-format
msgid "Selects all text in the editor."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:409
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>A</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Deselect</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:416
#, no-c-format
msgid "Deselects the selected text in the editor if any."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:423
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift; <keycap>B</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Block Selection "
"Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:431
#, no-c-format
msgid ""
"Toggles Selection Mode. When the Selection Mode is <quote>BLOCK</quote>, you "
"can make vertical selections, &eg; select column 5 to 10 in lines 9 to 15."
msgstr ""

#. Tag: para
#: menus.docbook:433
#, no-c-format
msgid ""
"The status bar shows the current state of the Selection Mode, either "
"<quote>LINE</quote> or <quote>BLOCK</quote>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:438
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keysym>Meta</keysym>&Ctrl;<keycap>V</"
"keycap></keycombo> </shortcut> <guimenu>Edit</guimenu><guimenuitem>VI input "
"Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:445
#, no-c-format
msgid ""
"Switch to a vi-like, modal editing mode. This mode supports the most used "
"commands and motions from vim's normal and visual mode and has an optional "
"vi mode statusbar. This status bar shows commands while they are being "
"entered, output from commands and the current mode.The behavior of this mode "
"can be configured in the <link linkend=\"pref-edit-vi-input-mode\">Vi Input "
"Mode</link> section of the <guilabel>Editing</guilabel> page in &kappname;'s "
"settings dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:455
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>Ins</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Overwrite Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:462
#, no-c-format
msgid ""
"Toggles the Insert/Overwrite modes. When the mode is <guilabel>INS</"
"guilabel>, you insert characters where the cursor is. When the mode is "
"<guilabel>OVR</guilabel>, writing characters will replace the current "
"characters if your cursor is positioned before any character. The status bar "
"shows the current state of the Overwrite Mode, either <guilabel>INS</"
"guilabel> or <guilabel>OVR</guilabel>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:473
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:480
#, no-c-format
msgid ""
"Launch the incremental search bar to allow you to search for text in the "
"edited document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:487
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F3</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guisubmenu>Find Variants</guisubmenu> "
"<guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:494
#, no-c-format
msgid ""
"Go to the nearest downwards match of the last text or regular expression "
"searched for, starting from cursor position"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:501
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>F3</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guisubmenu>Find Variants</guisubmenu> "
"<guimenuitem>Find Previous</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:508
#, no-c-format
msgid ""
"Go to the nearest upwards match of the last text or regular expression "
"searched for, starting from cursor position"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:514
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guisubmenu>Find Variants</guisubmenu> "
"<guimenuitem>Find Selected</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:520
#, no-c-format
msgid "Finds next occurrence of selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:526
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>H</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu><guisubmenu>Find Variants</"
"guisubmenu> <guimenuitem>Find Selected Backwards</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:532
#, no-c-format
msgid "Finds previous occurrence of selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:539
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:546
#, no-c-format
msgid ""
"Launch the power search and replace bar to replace one or more instances of "
"a defined text with something else."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:553
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Go to Line...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:560
#, no-c-format
msgid ""
"Launches the Go To Line bar, allowing you to enter the number of a line to "
"find in the document"
msgstr ""

#. Tag: title
#: menus.docbook:570
#, no-c-format
msgid "The View Menu"
msgstr ""

#. Tag: para
#: menus.docbook:572
#, no-c-format
msgid ""
"The <guimenu>View</guimenu> menu allows you to manage settings specific to "
"the active editor, and to manage frames."
msgstr ""

#. Tag: title
#: menus.docbook:576 menus.docbook:1121
#, no-c-format
msgid "Menu Items"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:581
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>New Window</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:587
#, no-c-format
msgid ""
"<action>Opens another instance of &kate;</action>. The new instance will be "
"identical to your previous instance."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:597
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keysym>Left</keysym></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Previous Document</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:604
#, no-c-format
msgid ""
"Opens the document displayed above the currently open document in the "
"Documents list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:611
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keysym>Right</keysym></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Next Document</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:618
#, no-c-format
msgid ""
"Opens the document displayed below the currently open document in the "
"Documents list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:625
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Show Active</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:632
#, no-c-format
msgid "Displays the currently open document in the Documents list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:639
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Alt;<keycap>O</keycap></"
"keycombo></shortcut> <guimenu>View</guimenu> <guimenuitem>Quick Open</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:646
#, no-c-format
msgid ""
"Show a search field and a list of opened files in the editor area. While "
"entering text in the search field the document names and document urls are "
"searched for matching text. While entering text in the search field you can "
"use the cursor keys <keysym>Up</keysym> and <keysym>Down</keysym> to "
"navigate in the list view. Pressing the &Enter; key or double clicking on an "
"item in the list switches the view to the document selected in the list "
"view. This makes switching between documents easier, if there are a lot of "
"them open."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:660
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>F8</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu><guisubmenu>Split View</guisubmenu> "
"<guimenuitem>Previous Split View</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:667
#, no-c-format
msgid ""
"Focus the previous document view, if you have split the editor area in more "
"views."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:675
#, no-c-format
msgid ""
"<shortcut><keycap>F8</keycap></shortcut> <guimenu>View</"
"guimenu><guisubmenu>Split View</guisubmenu> <guimenuitem>Next Split View</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:682
#, no-c-format
msgid ""
"Focus the next document view, if you have split the editor area in more "
"views."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:690
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>L</keycap></"
"keycombo></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</"
"guisubmenu> <guimenuitem>Split Vertical</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:697
#, no-c-format
msgid ""
"This will split the frame (which may be the main editing area) in two "
"equally sized frames, the new one to the left of the current one. The new "
"frame gets the focus, and will display the same document as the old one."
msgstr ""

#. Tag: para
#: menus.docbook:700 menus.docbook:717 menus.docbook:735
#, no-c-format
msgid "See also <link linkend=\"kate-mdi\">Working with the &kate; MDI</link>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:707
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>T</keycap></"
"keycombo></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</"
"guisubmenu> <guimenuitem>Split Horizontal</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:714
#, no-c-format
msgid ""
"Splits the current frame (which may be the main editing area) in two equally "
"sized frames, the new one at the bottom half. The new frame gets the focus, "
"and displays the same document as the old one."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:724
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>R</keycap></"
"keycombo></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</"
"guisubmenu> <guimenuitem>Close Current View</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:731
#, no-c-format
msgid ""
"Closes the active frame. This is disabled, if there is only one frame (the "
"main editing area)."
msgstr ""

#. Tag: para
#: menus.docbook:732
#, no-c-format
msgid ""
"No documents get closed by closing a frame &ndash; they will still be "
"available in the <link linkend=\"view-menu\"><guimenu>View</guimenu> Menu</"
"link> as well as in the File List."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:743
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Split View</guisubmenu> <guimenuitem>Move "
"Splitter Left</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:749
#, no-c-format
msgid ""
"When Split View is enabled, this will move the border in between two "
"vertically split documents further left."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:757
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Split View</guisubmenu> <guimenuitem>Move "
"Splitter Right</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:763
#, no-c-format
msgid ""
"When Split View is enabled, this will move the border in between two "
"vertically split documents further right."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:771
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Split View</guisubmenu> <guimenuitem>Move "
"Splitter Up</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:777
#, no-c-format
msgid ""
"When Split View is enabled, this will move the border in between two "
"horizontally split documents further up."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:785
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Split View</guisubmenu> <guimenuitem>Move "
"Splitter Down</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:791
#, no-c-format
msgid ""
"When Split View is enabled, this will move the border in between two "
"horizontally split documents further down."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:797
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:803
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Alt;&Shift;<keycap>F</keycap> </"
"keycombo></shortcut><guimenu>View</guimenu><guisubmenu>Tool Views</"
"guisubmenu> <guimenuitem>Show Sidebars</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:806
#, no-c-format
msgid ""
"Toggles the display of the sidebar button rows. This command does not affect "
"the display of the sidebar content widgets, any sidebar that is visible will "
"stay visible, and if you assigned shortcuts to the below commands those will "
"of course continue to work."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:815
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Documents</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:821
#, no-c-format
msgid "Toggle the display of &kate;'s Documents list"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:828
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Terminal</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:834
#, no-c-format
msgid "Toggles the display of the built in terminal emulator."
msgstr ""

#. Tag: para
#: menus.docbook:835
#, no-c-format
msgid "When activated the first time, the terminal will be created."
msgstr ""

#. Tag: para
#: menus.docbook:836
#, no-c-format
msgid ""
"When the terminal emulator is displayed, it will get the focus, so that you "
"can start typing in commands immediately. If the <link linkend=\"config-"
"dialog-general-sync-konsole\">Automatically synchronize the terminal with "
"the current document when possible</link> option is enabled in the "
"<guilabel>Terminal</guilabel> page of the <link linkend=\"config-dialog"
"\">Main configuration dialog</link> the shell session will change to the "
"directory of the active document, if it is a local file."
msgstr ""

#. Tag: para
#: menus.docbook:843
#, no-c-format
msgid ""
"This menu item is displayed by the Terminal Tool View plugin, which is "
"enabled by default."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:853
#, no-c-format
msgid ""
"<shortcut><keycap>F7</keycap></shortcut> <guimenu>View</"
"guimenu><guimenuitem>Switch to Command Line</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:856
#, no-c-format
msgid ""
"This command will toggle the display of the <link linkend=\"advanced-editing-"
"tools-commandline\">built in command line</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:862
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guimenuitem>Show the Javascript Console</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:865
#, no-c-format
msgid ""
"This opens a tool view that allows you to run Javascript code interactively. "
"For more information, see <link linkend=\"dev-scripting\">Extending &kate; "
"with Scripts</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:872
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Schema</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:874
#, no-c-format
msgid ""
"This menu lists the available color schemes. You can change the schema for "
"the current view here, to change the default schema you need to use the "
"<link linkend=\"prefcolors\">Fonts &amp; Colors</link> page of the config "
"dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:882
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap> </keycombo></"
"shortcut> <guimenu>View</guimenu><guimenuitem>Dynamic Word Wrap</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:886
#, no-c-format
msgid ""
"Toggles dynamic word wrap in the current view. Dynamic word wrap makes all "
"the text in a view visible without the need for horizontal scrolling by "
"rendering one actual line on more visual lines as needed."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:895
#, no-c-format
msgid ""
"<guimenu>View</guimenu> <guisubmenu>Dynamic Word Wrap Indicators</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:899
#, no-c-format
msgid ""
"Choose when and how the dynamic word wrap indicators should be displayed. "
"This is only available if the <guilabel>Dynamic Word Wrap</guilabel> option "
"is checked."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:906
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guimenuitem>Show Static Word Wrap Marker</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:908
#, no-c-format
msgid ""
"Toggles the display of a vertical line indicating the position of the wrap "
"width as configured in the <link linkend=\"pref-wrap-words-at\">config "
"dialog</link>. This feature requires that you use a true fixed-width font."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:918
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F6</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Show Icon Border</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:925
#, no-c-format
msgid ""
"This is a toggle item. Setting it on checked will make the Icon Border "
"visible in the left side of the active editor, and vice versa. The Icon "
"Border indicates the positions of the marked lines in the editor."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:934
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F11</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Show Line Numbers</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:941
#, no-c-format
msgid ""
"This is a toggle Item. Setting it on checked will make a pane displaying the "
"line numbers of the document visible in the left border of the active "
"editor, and vice versa."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:948 menus.docbook:965
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Show Scrollbar Marks</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:950 menus.docbook:967
#, no-c-format
msgid ""
"Toggles the visualization of bookmarks (and other marks) on the vertical "
"scrollbar. When enabled, marks are represented by a thin line in the mark "
"color at the scrollbar, middleclicking on the lines will scroll the view to "
"a position near the mark."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:957
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guimenuitem>Show Scrollbar Minimap</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:959
#, no-c-format
msgid ""
"This will replace the scrollbar with a visualization of the current "
"document. For more information on the scrollbar minimap, see <xref linkend="
"\"kate-part-scrollbar-minimap\"/>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:974
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F9</keycap> </keycombo></"
"shortcut> <guimenu>View</guimenu><guimenuitem>Show Folding Markers</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:978
#, no-c-format
msgid ""
"Toggles the display of the folding marker pane in the left side of the view. "
"See <link linkend=\"advanced-editing-tools-code-folding\">Using Code "
"Folding</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:986
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Code Folding</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:989
#, no-c-format
msgid ""
"These options pertain to <link linkend=\"advanced-editing-tools-code-folding"
"\">code folding</link>:"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:994
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>-</keycap></keycombo></"
"shortcut> <guimenuitem>Fold Current Node</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:998
#, no-c-format
msgid "Collapse the region that contains the cursor."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1002
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>+</keycap></keycombo></"
"shortcut> <guimenuitem>Unfold current node</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1006
#, no-c-format
msgid "Expand the region that contains the cursor."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1011
#, no-c-format
msgid "Unfold All Nodes"
msgstr ""

#. Tag: para
#: menus.docbook:1013
#, no-c-format
msgid "Expand all regions in the document."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1018
#, no-c-format
msgid "Fold Multiline Comments"
msgstr ""

#. Tag: para
#: menus.docbook:1020
#, no-c-format
msgid ""
"Fold all multiline comments in the document. (For example, this will fold "
"all comments that use <quote>/* comment */</quote> syntax in C-like "
"programming languages.)"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1026
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; &Shift;<keycap>-</keycap></"
"keycombo></shortcut> <guimenuitem>Fold Toplevel Nodes</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1030
#, no-c-format
msgid "Collapse all toplevel regions in the document."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1035
#, no-c-format
msgid "Fold Nodes in Level 2"
msgstr ""

#. Tag: para
#: menus.docbook:1037
#, no-c-format
msgid "Collapse all level 2 nodes in the document."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1042
#, no-c-format
msgid "Fold Nodes in Level 3"
msgstr ""

#. Tag: para
#: menus.docbook:1044
#, no-c-format
msgid "Collapse all level 3 nodes in the document."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1049
#, no-c-format
msgid "Fold Nodes in Level 4"
msgstr ""

#. Tag: para
#: menus.docbook:1051
#, no-c-format
msgid "Collapse all level 4 nodes in the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1055
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; &Shift;<keycap>+</keycap></"
"keycombo></shortcut> <guimenuitem>Unfold Toplevel Nodes</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1059
#, no-c-format
msgid "Expand all toplevel regions in the document."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1064
#, no-c-format
msgid "Unfold Nodes in Level 2"
msgstr ""

#. Tag: para
#: menus.docbook:1066
#, no-c-format
msgid "Expand all level 2 nodes in the document."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1071
#, no-c-format
msgid "Unfold Nodes in Level 3"
msgstr ""

#. Tag: para
#: menus.docbook:1073
#, no-c-format
msgid "Expand all level 3 nodes in the document."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1078
#, no-c-format
msgid "Unfold Nodes in Level 4"
msgstr ""

#. Tag: para
#: menus.docbook:1080
#, no-c-format
msgid "Expand all level 4 nodes in the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1088
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>+</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu><guimenuitem>Enlarge Font</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1092
#, no-c-format
msgid "This increases the display font size."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1096
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>-</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu><guimenuitem>Shrink Font</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1100
#, no-c-format
msgid "This decreases the display font size."
msgstr ""

#. Tag: title
#: menus.docbook:1108
#, no-c-format
msgid "The Bookmarks Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1110
#, no-c-format
msgid ""
"The <guimenu>Bookmarks</guimenu> menu allows you to work with the bookmarks "
"in the currently active document."
msgstr ""

#. Tag: para
#: menus.docbook:1113
#, no-c-format
msgid ""
"Below the entries described here, one entry for each bookmark in the active "
"document will be available. The text will be the first few words of the "
"marked line. Choose an item to move the cursor to the start of that line. "
"The editor will scroll as necessary to make that line visible."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1126
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>B</keycap></keycombo></"
"shortcut> <guimenu>Bookmarks</guimenu> <guimenuitem>Set Bookmark</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1133
#, no-c-format
msgid ""
"Sets or removes a bookmark in the current line of the active document. (If "
"it's there, it is removed, otherwise one is set.)"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1141
#, no-c-format
msgid ""
"<guimenu>Bookmarks</guimenu> <guimenuitem>Clear All Bookmarks</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1147
#, no-c-format
msgid "Clears (removes) all bookmarks in the active document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1152
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt; <keycap>PgUp</keycap></keycombo></"
"shortcut> <guimenu>Bookmarks</guimenu><guimenuitem>Previous</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1156
#, no-c-format
msgid ""
"This will move the cursor to beginning of the first above line with a "
"bookmark. The menuitem text will include the line number and the first piece "
"of text on the line. This item is only available when there is a bookmark in "
"a line above the cursor."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1163
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt; <keycap>PgDown</keycap></"
"keycombo></shortcut> <guimenu>Bookmarks</guimenu><guimenuitem>Next</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1166
#, no-c-format
msgid ""
"This will move the cursor to beginning of the next line with a bookmark. The "
"menuitem text will include the line number and the first piece of text on "
"the line. This item is only available when there is a bookmark in a line "
"below the cursor."
msgstr ""

#. Tag: title
#: menus.docbook:1177
#, no-c-format
msgid "The Sessions Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1179
#, no-c-format
msgid ""
"This menu contains entries for using and managing &kate; sessions. For more "
"information, read <link linkend=\"fundamentals-using-sessions\">Using "
"Sessions</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1186
#, no-c-format
msgid "<guimenu>Sessions</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1188
#, no-c-format
msgid "Creates a new empty session. All currently open files will be closed."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1194
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Open Session...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1196
#, no-c-format
msgid ""
"Open an existing session. The Session Chooser dialog is displayed to let you "
"choose one."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1201
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guisubmenu>Quick Open Session</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1203
#, no-c-format
msgid "This submenu lets you open an existing session."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1208
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Save Session</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1210
#, no-c-format
msgid ""
"Save the current session. If the session is anonymous, you will be prompted "
"for a session name."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1215
#, no-c-format
msgid ""
"<guimenu>Sessions</guimenu><guimenuitem>Save Session As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1217
#, no-c-format
msgid ""
"Save the current session under a new name. You are prompted for a name to "
"use."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1222
#, no-c-format
msgid ""
"<guimenu>Sessions</guimenu><guimenuitem>Manage Sessions...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1224
#, no-c-format
msgid ""
"Displays the Session Manager dialog which allows you to rename and delete "
"sessions."
msgstr ""

#. Tag: title
#: menus.docbook:1235
#, no-c-format
msgid "The Tools Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1240
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Pipe to Terminal</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1242
#, no-c-format
msgid ""
"Feed the currently selected text into the built in terminal emulator. No "
"newline is added after the text. This menu item is displayed by the Terminal "
"Tool View plugin, which is enabled by default."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1248
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Synchronize Terminal with Current "
"Document</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1252
#, no-c-format
msgid ""
"This will cause the built-in Terminal to <command>cd</command> into the "
"directory of the active document. This menu item is also displayed by the "
"Terminal Tool View plugin."
msgstr ""

#. Tag: para
#: menus.docbook:1256
#, no-c-format
msgid ""
"Alternatively, you can configure &kappname; to always keep the terminal in "
"sync with the current document. See <xref linkend=\"config-dialog-general-"
"sync-konsole\"/> for more information."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1263
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Focus/Defocus Terminal</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1267
#, no-c-format
msgid ""
"Switch the focus from the current document to the terminal and vice versa. "
"This menu item is also displayed by the Terminal Tool View plugin."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1273
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Read Only Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1277
#, no-c-format
msgid ""
"Set the current document to Read Only mode. This prevents any text addition "
"and any changes in the document formatting."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1283
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1287
#, no-c-format
msgid ""
"Choose the filetype scheme you prefer for the active document. This "
"overwrites the global <link linkend=\"pref-open-save-modes-filetypes"
"\">filetype</link> mode set in <menuchoice> <guimenu>Settings</guimenu> "
"<guimenuitem>Configure &kate;...</guimenuitem></menuchoice> in the Filetypes "
"tab for your current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1296
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Highlighting</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1300
#, no-c-format
msgid ""
"Choose the Highlighting scheme you prefer for the active document. This "
"overwrites the global highlighting mode set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem> </"
"menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1308
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Indentation</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1312
#, no-c-format
msgid ""
"Choose the <link linkend=\"kate-part-autoindent\">style of indentation</"
"link> you want for your active document. This overwrites the global "
"indentation mode set in <menuchoice> <guimenu>Settings</guimenu> "
"<guimenuitem>Configure Editor...</guimenuitem> </menuchoice> for your "
"current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1321
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1325
#, no-c-format
msgid ""
"You can overwrite the default encoding set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></"
"menuchoice> in the <guilabel>Open/Save</guilabel> page to set a different "
"encoding for your current document. The encoding you set here will be only "
"valid for your current document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1337
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>End of Line</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1341
#, no-c-format
msgid ""
"Choose your preferred end of line mode for your active document. This "
"overwrites the global end of line mode set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem> </"
"menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1349
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>Add Byte Mark Order (BOM)</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1353
#, no-c-format
msgid ""
"Checking this action you can explicitly add a byte order mark for unicode "
"encoded documents. The byte order mark (BOM) is a Unicode character used to "
"signal the endianness (byte order) of a text file or stream, for more "
"information see <ulink url=\"http://en.wikipedia.org/wiki/Byte_Order_Mark"
"\">Byte Order Mark</ulink>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1361
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Scripts</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1365
#, no-c-format
msgid ""
"This submenu contains a list of all scripted actions. The list can easily be "
"modified by <link linkend=\"dev-scripting-command-line\">writing own "
"scripts</link>. This way, &kate; can be extended with user-defined tools."
msgstr ""

#. Tag: para
#: menus.docbook:1370
#, no-c-format
msgid ""
"For more information about the scripts included with kate, see <xref linkend="
"\"scripts\"/>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1376
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Space</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Invoke Code "
"Completion</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1384
#, no-c-format
msgid ""
"Manually invoke command completion, usually by using a shortcut bound to "
"this action."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1389
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Word Completion</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1394
#, no-c-format
msgid ""
"<guimenuitem>Reuse Word Below</guimenuitem> (<keycombo action=\"simul"
"\">&Ctrl; <keycap>9</keycap></keycombo>) and <guimenuitem>Reuse Word Above</"
"guimenuitem> (<keycombo action=\"simul\">&Ctrl; <keycap>8</keycap></"
"keycombo>) complete the currently typed text by searching for similar words "
"backward or forward from the current cursor position. <guimenuitem>Shell "
"Completion</guimenuitem> pops up a completion box with matching entries."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1404
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>O</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu><guisubmenu>Spelling</"
"guisubmenu> <guimenuitem>Automatic Spell Checking</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1412
#, no-c-format
msgid ""
"When <guimenuitem>Automatic Spell Checking</guimenuitem> is enabled, wrong "
"text is underlined in the document on-the-fly."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1418
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu><guisubmenu>Spelling</"
"guisubmenu><guimenuitem>Spelling...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:1422
#, no-c-format
msgid ""
"This initiates the spellchecking program - a program designed to help the "
"user catch and correct any spelling errors."
msgstr ""

#. Tag: para
#: menus.docbook:1425 menus.docbook:1439 menus.docbook:1451
#, no-c-format
msgid ""
"For more information on how to use the &kde; spellchecking program, see the "
"<ulink url=\"help:/fundamentals/spellcheck.html\"><emphasis>Check Spelling</"
"emphasis> section of the <emphasis>&kde; Fundamentals</emphasis> "
"documentation</ulink>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1432
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu><guisubmenu>Spelling</guisubmenu> "
"<guimenuitem>Spelling (from cursor)...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1436
#, no-c-format
msgid ""
"This initiates the spellchecking program but it starts where your cursor is "
"instead of at the beginning of the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1446
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu><guisubmenu>Spelling</guisubmenu> "
"<guimenuitem>Spellcheck Selection...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1450
#, no-c-format
msgid "Spellchecks the current selection."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1458
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu><guisubmenu>Spelling</guisubmenu> "
"<guimenuitem>Change Dictionary</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1462
#, no-c-format
msgid ""
"Displays a drop down box with all available dictionaries for spellchecking "
"at the bottom of the editor window. This allows easy switching of the "
"spellcheck dictionary &eg; for automatic spellcheck of text in different "
"languages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1494
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1497
#, no-c-format
msgid ""
"This cleans the indentation for the current selection or for the line the "
"cursor is currently in. Cleaning the indentation ensures that all your "
"selected text follows the indentation mode you choose."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1504
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Align</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1509
#, no-c-format
msgid ""
"Causes a realign of the current line or selected lines using the indentation "
"mode and indentation settings in the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1515
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>D</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1522
#, no-c-format
msgid ""
"This adds one space to the beginning of the line where the text cursor is "
"located or to the beginning of any selected lines."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1529
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>D</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uncomment</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1536
#, no-c-format
msgid ""
"This removes one space (if any exist) from the beginning of the line where "
"the text cursor is located or from the beginning of any selected lines."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1542
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1549
#, no-c-format
msgid "Put the selected text or the letter after the cursor in uppercase."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1554
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>U</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Lowercase</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1561
#, no-c-format
msgid "Put the selected text or the letter after the cursor in lowercase."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1566
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>U</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Capitalize</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1573
#, no-c-format
msgid "Capitalize the selected text or the current word."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1578
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>J</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Join Lines</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1585
#, no-c-format
msgid ""
"Joins the selected lines, or the current line and the line below with one "
"white space character as a separator. Leading/trailing white space on joined "
"lines is removed in the affected ends."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1591
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Apply Word Wrap</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1595
#, no-c-format
msgid ""
"Apply static word wrapping on all the document. That means that a new line "
"of text will automatically start when the current line exceeds the length "
"specified by the <guilabel>Wrap words at</guilabel> option in the Editing "
"tab in <menuchoice> <guimenu>Settings</guimenu><guimenuitem>Configure "
"Editor...</guimenuitem></menuchoice>"
msgstr ""

#. Tag: para
#: menus.docbook:1604
#, no-c-format
msgid ""
"Menu items for the selected <link linkend=\"pref-plugins\">plugins</link> "
"are displayed at the end of this menu"
msgstr ""

#. Tag: title
#: menus.docbook:1612
#, no-c-format
msgid "The Settings Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1614
#, no-c-format
msgid ""
"The <guimenu>Settings</guimenu> menu allows you to change the properties of "
"the main window, such as showing/hiding toolbars, and provides access to the "
"configuration dialogs."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1621
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1627
#, no-c-format
msgid ""
"When this is checked, this displays a movable toolbar containing buttons "
"used to initiate frequently used commands. When unchecked the toolbar is "
"hidden."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1635
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1639
#, no-c-format
msgid ""
"When checked, this displays a small bar at the bottom of the editor "
"containing information about the status of the current document. When "
"unchecked the status bar is hidden."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1646
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Path</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1650
#, no-c-format
msgid ""
"When selected, this displays in the titlebar the path (its location in the "
"file system) of the current document. When unchecked the path is hidden."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1656
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>F</keycap></"
"keycombo> </shortcut> <guimenu>Settings</guimenu><guimenuitem>Full Screen "
"Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1662
#, no-c-format
msgid "Toggles full screen display."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1669
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1675
#, no-c-format
msgid ""
"Display the familiar &kde; Keyboard Shortcut Configuration Dialog. For more "
"information on using this, see the <ulink url=\"help:/fundamentals/shortcuts."
"html\"><emphasis>Using and Customizing Shortcuts</emphasis> section of the "
"<emphasis>&kde; Fundamentals</emphasis> documentation</ulink>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1687
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1693
#, no-c-format
msgid ""
"Display the familiar &kde; Toolbar Configuration Dialog. For more "
"information on using this, see the <ulink url=\"help:/fundamentals/config."
"html#toolbars\"><emphasis>Customizing Toolbars</emphasis> section of the "
"<emphasis>&kde; Fundamentals</emphasis> documentation</ulink>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1704
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &kate;...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1710
#, no-c-format
msgid ""
"Launch the <link linkend=\"config-dialog\">Main Configuration Dialog</link>"
msgstr ""

#. Tag: title
#: menus.docbook:1720
#, no-c-format
msgid "The Help Menu"
msgstr "Dat Hülpmenü"

#. Tag: para
#: menus.docbook:1722
#, no-c-format
msgid ""
"Apart from standard &kde; <guimenu>Help</guimenu> menu items described below "
"you will have menu entries to show the <guimenuitem>Tip of the Day</"
"guimenuitem> and the <guimenuitem>About Editor Component</guimenuitem> "
"information."
msgstr ""

#. Tag: sect1
#: menus.docbook:1725
#, no-c-format
msgid "&help.menu.documentation;"
msgstr ""
