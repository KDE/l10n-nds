#: index.docbook:521
#, no-c-format
msgid "TERM"
msgstr ""

#. Tag: entry
#: index.docbook:522
#, no-c-format
msgid "termination signal"
msgstr ""

#. Tag: errorcode
#: index.docbook:525
#, no-c-format
msgid "KILL"
msgstr ""

