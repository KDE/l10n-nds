#: fundamentals.docbook:457
#, no-c-format
msgid "Set a Bookmark"
msgstr ""

#. Tag: keycombo
#: fundamentals.docbook:460
#, no-c-format
msgid "&Ctrl;<keycap>C</keycap>"
msgstr ""

#. Tag: para
#: fundamentals.docbook:461
#, no-c-format
msgid "Copy the marked text to the clipboard."
msgstr ""

#. Tag: keycombo
#: fundamentals.docbook:465
#, no-c-format
msgid "&Ctrl;<keycap>N</keycap>"
msgstr ""

#. Tag: para
#: fundamentals.docbook:466
#, no-c-format
msgid "<link linkend=\"new\">New</link> document"
msgstr ""

#. Tag: keycombo
#: fundamentals.docbook:469
#, no-c-format
msgid "&Ctrl;<keycap>P</keycap>"
msgstr ""

#. Tag: link
#: fundamentals.docbook:470
#, no-c-format
msgid "Print"
msgstr "Drucken"

#. Tag: keycombo
#: fundamentals.docbook:474
#, no-c-format
msgid "&Ctrl;<keycap>Q</keycap>"
msgstr ""

#. Tag: para
#: fundamentals.docbook:475
#, no-c-format
msgid "Quit - close active copy of editor"
msgstr ""

#. Tag: keycombo
#: fundamentals.docbook:478
#, no-c-format
msgid "&Ctrl;<keycap>R</keycap>"
msgstr ""

#. Tag: link
#: fundamentals.docbook:479
#, no-c-format
msgid "Replace"
msgstr "Utwesseln"

#. Tag: keycombo
#: fundamentals.docbook:482
#, no-c-format
msgid "&Ctrl;<keycap>S</keycap>"
msgstr ""

#. Tag: para
#: fundamentals.docbook:483
#, no-c-format
msgid "Save your file."
msgstr "Dien Datei sekern"

#. Tag: keycombo
#: fundamentals.docbook:486
#, no-c-format
msgid "&Ctrl;<keycap>V</keycap>"
msgstr ""

#. Tag: para
#: fundamentals.docbook:487
#, no-c-format
msgid "Paste."
msgstr "Infögen."

#. Tag: keycombo
