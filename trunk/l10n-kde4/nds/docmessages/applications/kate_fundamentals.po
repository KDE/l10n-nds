#: fundamentals.docbook:453
#, no-c-format
msgid "Find again"
msgstr "Nochmaal söken"

#. Tag: keycombo
#: fundamentals.docbook:456
#, no-c-format
msgid "&Ctrl;<keycap>B</keycap>"
