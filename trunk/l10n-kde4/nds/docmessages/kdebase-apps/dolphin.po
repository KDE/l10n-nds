#. Tag: para
#: index.docbook:89
#, no-c-format
msgid ""
"&dolphin; is a file manager for &kde; designed with usability as a primary "
"focus."
msgstr ""
"&dolphin; is en Dateipleger för &kde; un so plaant un buut, dat he sik so "
"eenfach as mööglich bruken lett."

#. Tag: keyword
#: index.docbook:99
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

