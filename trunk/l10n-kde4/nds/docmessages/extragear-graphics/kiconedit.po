#: index.docbook:373
#, no-c-format
msgid "The Menu Entries"
msgstr ""

#. Tag: para
#: index.docbook:375
#, no-c-format
msgid ""
"&kiconedit; has the common &kde; menu items, for more information read the "
"<ulink url=\"help:/fundamentals/ui.html#menus\">Menu</ulink> chapter of the "
"&kde; Fundamentals."
msgstr ""

