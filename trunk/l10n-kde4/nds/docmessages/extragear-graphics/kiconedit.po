#. Tag: title
#: index.docbook:457
#, no-c-format
msgid "Configuration"
msgstr ""

#. Tag: title
#: index.docbook:460
#, no-c-format
msgid "Configuring &kiconedit;"
msgstr ""

#. Tag: para
#: index.docbook:461
#, no-c-format
msgid ""
"Selecting the <menuchoice><guimenu>Settings</guimenu> <guimenuitem>Configure "
"&kiconedit;...</guimenuitem></menuchoice> menu item will open a "
"configuration dialog with the tree tabs <guilabel>Icon Templates</guilabel>, "
"<guilabel>Background</guilabel> and <guilabel>Icon Grid</guilabel>."
msgstr ""

#. Tag: screeninfo
#: index.docbook:467
#, no-c-format
msgid "<screeninfo>&kiconedit; configuration dialog</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:470
#, no-c-format
msgid "<phrase>&kiconedit; configuration dialog</phrase>"
msgstr ""

#. Tag: title
#: index.docbook:475
#, no-c-format
msgid "The Icon Templates Tab"
msgstr ""

#. Tag: para
#: index.docbook:476
#, no-c-format
msgid ""
"<guilabel>Add...</guilabel>, <guilabel>Edit...</guilabel> and "
"<guilabel>Remove</guilabel> the templates for <guilabel>Standard File</"
"guilabel>, <guilabel>Source File</guilabel>, <guilabel>Compressed File</"
"guilabel> &etc;"
msgstr ""

#. Tag: title
#: index.docbook:481
#, no-c-format
msgid "The Background Tab"
msgstr ""

#. Tag: para
#: index.docbook:482
#, no-c-format
msgid ""
"Select to <guibutton>Use color</guibutton> or to <guibutton>Use pixmap</"
"guibutton> as background. A <guilabel>Preview</guilabel> of your choice is "
"displayed."
msgstr ""

#. Tag: title
#: index.docbook:486
#, no-c-format
msgid "The Icon Grid Tab"
msgstr ""

#. Tag: para
#: index.docbook:487
#, no-c-format
msgid ""
"Select to <guilabel>Paste transparent pixels</guilabel> or <guilabel>Show "
"rulers</guilabel> and set a <guilabel>Solid Color</guilabel> or a "
"<guilabel>Checkerboard</guilabel> as <guilabel>Transparency Display</"
"guilabel>. You can set the Checkerboard <guilabel>Size:</guilabel> to "
"<guilabel>Small</guilabel>, <guilabel>Medium</guilabel> or <guilabel>Large</"
"guilabel> and choose <guilabel>Color 1:</guilabel> and <guilabel>Color 2:</"
"guilabel> of the checkerboard."
msgstr ""

