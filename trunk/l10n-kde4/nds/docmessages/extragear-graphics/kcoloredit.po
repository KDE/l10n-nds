#. Tag: para
#: index.docbook:37 index.docbook:51
#, no-c-format
msgid ""
"&kcoloredit; is a palette files editor. It can be used for editing color "
"palettes and for color choosing and naming."
msgstr ""

#. Tag: keyword
#: index.docbook:42
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

