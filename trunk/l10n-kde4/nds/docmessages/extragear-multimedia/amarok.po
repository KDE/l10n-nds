msgstr ""

#. Tag: para
#: index.docbook:2797
#, no-c-format
msgid "Enter the password for the default user."
msgstr ""

#. Tag: guilabel
#: index.docbook:2802
#, no-c-format
msgid "<guilabel>Database</guilabel>"
msgstr ""

#. Tag: para
#: index.docbook:2805
#, no-c-format
