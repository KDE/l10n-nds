#, no-c-format
msgid "Window Layout"
msgstr ""

#. Tag: para
#: index.docbook:1035
#, no-c-format
msgid "&amarok; is organized in four main areas, the toolbar and three panes:"
msgstr ""

#. Tag: para
#: index.docbook:1057
#, no-c-format
msgid "<link linkend=\"toolbar\">The Toolbar</link>&nbsp;"
msgstr ""

#. Tag: para
#: index.docbook:1075
#, no-c-format
msgid ""
"<link linkend=\"the-media-sources-pane\">The Media Sources pane</link>&nbsp;"
msgstr ""

#. Tag: para
