#: index.docbook:122
#, no-c-format
msgid "<guilabel>User Info</guilabel> Tab"
msgstr ""

#. Tag: para
#: index.docbook:124
#, no-c-format
msgid "In the <guilabel>User Info</guilabel> tab you can modify:"
msgstr ""

#. Tag: para
#: index.docbook:128
#, no-c-format
msgid ""
"<guilabel>User login</guilabel> with the user name and a <guibutton>Set "
"Password</guibutton> button for this account,"
msgstr ""

#. Tag: guilabel
#: index.docbook:129
#, no-c-format
msgid "User Id"
msgstr "Bruker-ID"

#. Tag: guilabel
#: index.docbook:130
#, no-c-format
msgid "Full Name"
