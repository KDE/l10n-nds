#. Tag: title
#: index.docbook:1427
#, no-c-format
msgid "How to obtain &jovie;"
msgstr ""

#. Tag: para
#: index.docbook:1433
#, no-c-format
msgid "&install.intro.documentation;"
msgstr ""

#. Tag: para
#: index.docbook:1437
#, no-c-format
msgid ""
"Debian Install Command: <command>apt-get install kdeaccessibility</command>"
msgstr ""

#. Tag: para
#: index.docbook:1440
#, no-c-format
msgid ""
"You will find links to source and binary packages on the <ulink url=\"http://"
"accessibility.kde.org/developer/kttsd/\"> &kde; Accessibility</ulink> web "
"site (http://accessibility.kde.org)."
msgstr ""

#. Tag: para
#: index.docbook:1444
#, no-c-format
msgid ""
"If you have access to the &kde; code repository, you can download &jovie; by "
"checking out the <command>kdeaccessibility</command> module. &jovie; will be "
"found in the <filename class=\"directory\">jovie</filename> folder. You can "
"also download tarballs of the kdeaccessibility source code from <ulink url="
"\"ftp://ftp.kde.org/pub/kde/\"> ftp://ftp.kde.org/pub/kde/</ulink>"
msgstr ""

#. Tag: title
#: index.docbook:1458
#, no-c-format
msgid "Requirements"
msgstr ""

#. Tag: para
#: index.docbook:1460
#, no-c-format
msgid "Mandatory requirements:"
msgstr ""

#. Tag: para
#: index.docbook:1464
#, no-c-format
msgid "&kde; version 4.4 or later."
msgstr ""

#. Tag: para
#: index.docbook:1465
#, no-c-format
msgid "speech-dispatcher version 0.67 or later."
msgstr ""

#. Tag: para
#: index.docbook:1466
#, no-c-format
msgid ""
"A speech synthesizer. The following synthesizers and spoken languages are "
"currently supported."
msgstr ""

#. Tag: entry
#: index.docbook:1475
#, no-c-format
msgid "Espeak"
msgstr ""

#. Tag: entry
