#: scriptappconfig.cpp:137
msgid "Configure Native Application"
msgstr "Normaal Programm instellen"

#: scriptappconfig.cpp:157 scriptappconfig.cpp:207
msgid "Script Application"
msgstr "Skriptprogramm"

#: executescriptplugin.cpp:66
msgid "Execute script support"
msgstr "Ünnerstütten för't Utföhren vun Skripten"

#: executescriptplugin.cpp:66
msgid "Allows running of scripts"
msgstr "Maakt dat Opropen vun Skripten mööglich"

#: executescriptplugin.cpp:67
msgid "Niko Sams"
msgstr "Niko Sams"

#: executescriptplugin.cpp:67
msgid "Author"
msgstr "Autor"

#: executescriptplugin.cpp:118
msgid "No valid executable specified"
msgstr "Keen gellen Programmdatei angeven"

#: executescriptplugin.cpp:128
#, kde-format
msgid ""
"There is a quoting error in the script for the launch configuration '%1'. "
"Aborting start."
msgstr ""
"Binnen de Oproop-Instellen \"%1\" gifft dat binnen dat Skript en Problem mit "
"de Schuultekens. Oproop afbraken."

#: executescriptplugin.cpp:133
#, kde-format
msgid ""
"A shell meta character was included in the script for the launch "
"configuration '%1', this is not supported currently. Aborting start."
msgstr ""
"Binnen de Oproop-Instellen \"%1\" gifft dat en Konsool-Metateken binnen dat "
"Skript, man dor gifft dat opstunns noch keen Ünnerstütten för. Oproop "
"afbraken."

#: executescriptplugin.cpp:150
#, kde-format
msgid "No remote host set for launch configuration '%1'. Aborting start."
msgstr ""
"Binnen de Oproop-Instellen \"%1\" is keen feern Reekner angeven. Oproop "
"afbraken."

#: executescriptplugin.cpp:173
#, kde-format
msgid ""
"There is a quoting error in the arguments for the launch configuration '%1'. "
"Aborting start."
msgstr ""
"Binnen de Oproop-Instellen \"%1\" gifft dat binnen de Argumenten en Problem "
"mit de Schuultekens. Oproop afbraken."

#: executescriptplugin.cpp:177
#, kde-format
msgid ""
"A shell meta character was included in the arguments for the launch "
"configuration '%1', this is not supported currently. Aborting start."
msgstr ""
"Binnen de Oproop-Instellen \"%1\" gifft dat en Konsool-Metateken binnen de  "
"Argumenten, dor gifft dat opstunns noch keen Ünnerstütten för. Oproop "
"afbraken."

#: executescriptplugin.cpp:222
msgid "No valid interpreter specified"
msgstr "Keen gellen Interpreter angeven"

#: executescriptplugin.cpp:232
#, kde-format
msgid ""
"There is a quoting error in the interpreter for the launch configuration "
"'%1'. Aborting start."
msgstr ""
"Binnen de Oproop-Instellen \"%1\" gifft dat binnen den Interpreter en "
"Problem mit de Schuultekens. Oproop afbraken."

#: executescriptplugin.cpp:237
#, kde-format
msgid ""
"A shell meta character was included in the interpreter for the launch "
"configuration '%1', this is not supported currently. Aborting start."
msgstr ""
"Binnen de Oproop-Instellen \"%1\" gifft dat en Konsool-Metateken binnen den "
"Interpreter, man dor gifft dat opstunns noch keen Ünnerstütten för. Oproop "
"afbraken."

#: scriptappjob.cpp:90
#, kde-format
msgid ""
"No environment group specified, looks like a broken configuration, please "
"check run configuration '%1'. Using default environment group."
msgstr ""
"Keen Ümgevenkoppel angeven, lett as en schaadhaftig Instellen. Prööv bitte "
"de Utföhr-Instellen \"%1\". De Standard-Ümgevenkoppel warrt ansteed bruukt."

#: scriptappjob.cpp:161
#, kde-format
msgid "Starting: %1"
msgstr "%1 warrt start"

#: scriptappjob.cpp:175
msgid "*** Killed Application ***"
msgstr "*** Programm afschaten ***"

#: scriptappjob.cpp:185
msgid "*** Exited normally ***"
msgstr "*** Normaal afslaten ***"

#: scriptappjob.cpp:188
#, kde-format
msgid "*** Exited with return code: %1 ***"
msgstr "*** Mit Utstiegkode %1 afslaten ***"

#: scriptappjob.cpp:191
msgid "*** Process aborted ***"
msgstr "*** Perzess afbraken ***"

#: scriptappjob.cpp:193
#, kde-format
msgid "*** Crashed with return code: %1 ***"
msgstr "*** Mit Utstiegkode %1 afstört ***"

#: scriptappjob.cpp:206
#, kde-format
msgid ""
"Could not start program '%1'. Make sure that the path is specified correctly."
msgstr ""
"Programm \"%1\" lett sik nich opropen. Beseker bitte, de Padd is propper "
"angeven."

#: scriptappjob.cpp:208
msgid "Could not start application"
msgstr "Programm lett sik nich starten"

