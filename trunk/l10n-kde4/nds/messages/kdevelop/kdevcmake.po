msgid "Cannot save the change."
msgstr "De Ännern lett sik nich sekern."

#: managers/cmake/cmakemanager.cpp:1113
msgid "Cannot remove the file."
msgstr "De Datei lett sik nich wegmaken."

#: managers/cmake/cmakemanager.cpp:1140
#, kde-format
