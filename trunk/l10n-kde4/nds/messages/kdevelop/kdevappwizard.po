#: appwizard/appwizardplugin.cpp:72
msgid "Support for creating and importing projects"
msgstr "Ünnerstütten för't Opstellen un Importeren vun Projekten"

#: appwizard/appwizardplugin.cpp:81
msgid "&New Project..."
msgstr "&Nieg Projekt ..."

#: appwizard/appwizardplugin.cpp:83
msgid "Generate a new project from a template"
msgstr "Nieg Projekt ut Vörlaag opstellen"

#: appwizard/appwizardplugin.cpp:84
msgid ""
"<b>New project</b><p>This starts KDevelop's application wizard. It helps you "
"to generate a skeleton for your application from a set of templates.</p>"
msgstr ""
"<bNieg Projekt</b><p>Dit start KDevelop sien Programm-Hölper. He hölpt Di "
"bi't Opstellen vun en Rohbuu för Dien Programm mit en Sett vun Vörlagen.</p>"

#: appwizard/appwizardplugin.cpp:91
msgid "&Import Existing Project..."
msgstr "Vörhannen Projekt &importeren..."

#: appwizard/appwizardplugin.cpp:93
msgid "Import existing project"
msgstr "Vörhannen Projekt importeren"

#: appwizard/appwizardplugin.cpp:156
msgid "Could not initialize DVCS repository"
msgstr "DVCS-Archiev lett sik nich torechtmaken"

#: appwizard/appwizardplugin.cpp:164
msgid "Could not add files to the DVCS repository"
msgstr "Dateien laat sik nich na't DVCS-Archiev tofögen."

#: appwizard/appwizardplugin.cpp:171
msgid "Could not import project into"
msgstr "Projekt lett sik nich importeren na"

#: appwizard/appwizardplugin.cpp:205
msgid "Could not checkout imported project"
msgstr "Importeert Projekt lett sik nich utlesen."

#: appwizard/appwizardplugin.cpp:209
msgid "Could not import project"
msgstr "Projekt lett sik nich importeren."

#: appwizard/appwizardplugin.cpp:283
msgid "Could not create new project"
msgstr "Nieg Projekt lett sik nich opstellen."

#: appwizard/appwizardplugin.cpp:369
#, kde-format
msgid "The file %1 cannot be created."
msgstr "De Datei \"%1\" lett sik nich opstellen."

#: appwizard/importproject.cpp:60
msgid ""
"The given name is used by an already opened project. Choose a different name"
msgstr ""
"De angeven Naam warrt al vun en opmaakt Projekt bruukt. Söök bitte en annern "
"ut."

#: appwizard/importproject.cpp:80
msgid "Please choose an existing folder."
msgstr "Söök bitte en vörhannen Orner ut."

#: appwizard/importproject.cpp:85
msgid "Please choose a project name."
msgstr "Söök bitte en Projektnaam ut,"

#: appwizard/importproject.cpp:94
msgid ""
"Cannot create project file.<p><b>Suggestion</b>: check permissions on the "
"selected directory"
msgstr ""
"Projektdatei lett sik nich opstellen.<p><b>Vörslag</b>: Prööv Dien Verlöven "
"för den utsöchten Orner"

