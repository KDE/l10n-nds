msgstr "Disse Kanaal föhrt en Python-Interpreter ut."

#: conduits/sysinfoconduit/sysinfo_conduit.desktop:4
msgctxt "Comment"
msgid "This conduit writes information about your handheld and the sync to a file."
msgstr ""
"Disse Kanaal schrifft Informatschonen över dien Handreekner un de Synkroniseren "
"na en Datei."

#: conduits/sysinfoconduit/sysinfo_conduit.desktop:22
msgctxt "Name"
msgid "System Information"
msgstr "Systeem-Informatschonen"

#: conduits/timeconduit/time_conduit.desktop:4
msgctxt "Comment"
msgid "This conduit sets the time on your handheld from the PC clock."
msgstr "Disse Kanaal stellt de Klock vun dien Handreekner na de Klock vun den PC."

#: conduits/timeconduit/time_conduit.desktop:22
msgctxt "Name"
msgid "Time Synchronization"
msgstr "Tietsynchronisatschoon"

#: conduits/vcalconduit/todo-conduit.desktop:4
msgctxt "Comment"
msgid "This conduit syncs the ToDo list from your handheld to KOrganizer."
msgstr "Disse Kanaal synchroniseert de Opgavenlist vun den Handreekner na KOrganizer."

#: conduits/vcalconduit/todo-conduit.desktop:22
msgctxt "Name"
msgid "ToDos (KOrganizer)"
msgstr "Opgaven (KOrganizer)"

#: conduits/vcalconduit/vcal-conduit.desktop:4
msgctxt "Name"
msgid "Calendar (KOrganizer)"
msgstr "Kalenner (KOrganizer)"

#: conduits/vcalconduit/vcal-conduit.desktop:24
msgctxt "Comment"
msgid "This conduit synchronizes your handheld with the KOrganizer datebook."
msgstr "Disse Kanaal synchoniseert dien Handreekter mit den Mötenkalenner vun KOrganizer."

