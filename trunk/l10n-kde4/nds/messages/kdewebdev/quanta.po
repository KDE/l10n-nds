#. i18n: file: scripts/tablewizard.kmdr:189
#: rc.cpp:2501
msgid "&Add table header"
msgstr "Tabellenkopp &tofögen"

#. i18n: file: scripts/tablewizard.kmdr:203
#: rc.cpp:2503
msgid ""
"Check this box to create a table header. The table header is the first row "
"of the table, and has the same number of entries as the other rows."
msgstr ""
"Maak dit an, wenn Du en Tabellenkopp opstellen wullt. De Tabellenkopp is de "
"eerst Reeg vun de Tabell un bargt de sülve Tall vun Indrääg as de anner "
"Regen."

#. i18n: file: scripts/tablewizard.kmdr:211
#: rc.cpp:2505
msgid "table_id"
msgstr "Tabell-ID"

#. i18n: file: scripts/tablewizard.kmdr:243
#. i18n: file: scripts/tablewizard.kmdr:254
