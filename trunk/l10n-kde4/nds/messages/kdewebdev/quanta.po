"<p><b>\n"
"&nbsp;&nbsp;SpecialAreas=&lt;?xml ?&gt;, &lt;!-- --&gt;, &lt;! &gt;\n"
"&nbsp;&nbsp;SpecialAreaNames = XML PI, comment, DTD\n"
"&nbsp;&nbsp;Comments = &lt;!-- --&gt;\n"
"</b></p>"

