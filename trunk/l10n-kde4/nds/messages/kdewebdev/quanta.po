#: rc.cpp:552 rc.cpp:596
msgid "Comma-separated list of the common attribute groups"
msgstr "Mit Kommas scheedt List vun gemeen Attributkoppeln"

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:551
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel12)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:637
#. i18n: ectx: property (whatsThis), widget (KLineEdit, groupsEdit1)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:551
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel12)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:637
#. i18n: ectx: property (whatsThis), widget (KLineEdit, groupsEdit1)
#: rc.cpp:555 rc.cpp:599
msgid ""
"Comma-separated list of the common attribute groups. The attributes from the "
"listed groups will appear on this page.<br>The common attributes are "
"specified in each DTEP's <i>common.tag</i> file, where the <i>common=\"yes"
"\"</i> attribute must be set.<br>The following example defined the common "
"I18n attribute group:<br><p><b>\n"
"&lt;tag name=\"I18n\" common=\"yes\"><br>\n"
"&nbsp;&nbsp;&lt;attr name=\"lang\" type=\"input\" /><br>\n"
"&nbsp;&nbsp;&lt;attr name=\"dir\" type=\"input\" /><br>\n"
"&lt;/tag>\n"
"</b></p>"
msgstr ""
"Mit Kommas scheedt List vun gemeen Attributkoppeln. Disse Siet wiest de "
"Attributen vun de oplist Koppeln.<br>De gemeen Attributen warrt binnen de "
"Datei <i>common.tag</i> vun elk DTEP fastleggt, bi de dat Attribut <i>common="
"\"yes\"</i> instellt wesen mutt.<br>Dat nakamen Bispill leggt den gemeen "
"I18n-Attributkoppel fast:<br><p><b>\n"
"&lt;tag name=\"I18n\" common=\"yes\"><br>\n"
"&nbsp;&nbsp;&lt;attr name=\"lang\" type=\"input\" /><br>\n"
"&nbsp;&nbsp;&lt;attr name=\"dir\" type=\"input\" /><br>\n"
"&lt;/tag>\n"
"</b></p>"

