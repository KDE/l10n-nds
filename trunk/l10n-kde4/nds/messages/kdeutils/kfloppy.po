#: floppy.cpp:92 floppy.cpp:381 floppy.cpp:727
msgid "Primary"
msgstr "Eerst"

#: floppy.cpp:93 floppy.cpp:385
msgid "Secondary"
msgstr "Tweet"

#: floppy.cpp:95
msgid "<qt>Select the floppy drive.</qt>"
msgstr "<qt>Söök dat Diskettenloopwark ut</qt>"

#: floppy.cpp:102
msgid "&Size:"
msgstr "&Grött:"

#: floppy.cpp:108
msgid "Auto-Detect"
msgstr "Automaatsch opdecken"

#: floppy.cpp:110 floppy.cpp:392 floppy.cpp:728
msgid "3.5\" 1.44MB"
msgstr "3.5\" - 1,44MB"

#: floppy.cpp:111 floppy.cpp:396
msgid "3.5\" 720KB"
msgstr "3.5\" - 720KB"

#: floppy.cpp:112 floppy.cpp:400
msgid "5.25\" 1.2MB"
msgstr "5.25\" - 1,2MB"

#: floppy.cpp:113 floppy.cpp:404
msgid "5.25\" 360KB"
msgstr "5.25\" - 360KB"

#: floppy.cpp:116
msgid "<qt>This allows you to select the floppy disk's size and density.</qt>"
msgstr "<qt>Hier kannst Du de Grött un Dichte vun de Diskett utsöken.</qt>"

#: floppy.cpp:124
msgid "F&ile system:"
msgstr "&Dateisysteem:"

#: floppy.cpp:132 floppy.cpp:144
msgctxt "Linux"
msgid ""
"KFloppy supports three file formats under Linux: MS-DOS, Ext2, and Minix"
msgstr ""
"KFloppy ünnerstütt ünner Linux dree Dateisystemen: MS-DOS, Ext2 un MInix"

#: floppy.cpp:135
msgctxt "BSD"
msgid "KFloppy supports three file formats under BSD: MS-DOS, UFS, and Ext2"
msgstr "KFloppy ünnerstütt ünner BSD dree Dateisystemen: MS-DOS, UFS un Ext2"

#: floppy.cpp:146 floppy.cpp:175 floppy.cpp:603 floppy.cpp:729
msgid "DOS"
msgstr "DOS"

#: floppy.cpp:148
msgctxt "Linux"
msgid "Program mkdosfs found."
msgstr "Programm \"mkdosfs\" funnen."

#: floppy.cpp:151
msgctxt "Linux"
msgid ""
"Program mkdosfs <b>not found</b>. MSDOS formatting <b>not available</b>."
msgstr ""
"Programm \"mkdosfs\" <b>nich funnen</b>. MS-DOS-Formateren <b>nich "
"verföögbor</b>."

#: floppy.cpp:155 floppy.cpp:193 floppy.cpp:620
msgid "ext2"
msgstr "ext2"

#: floppy.cpp:157 floppy.cpp:195
msgid "Program mke2fs found."
msgstr "Programm \"mke2fs\" funnen."

#: floppy.cpp:160 floppy.cpp:198
msgid "Program mke2fs <b>not found</b>. Ext2 formatting <b>not available</b>"
msgstr ""
"Programm\"mke2fs\" <b>nich funnen</b>. Ext2-Formateren <b>nich verföögbor</"
"b>."

#: floppy.cpp:164 floppy.cpp:647
msgid "Minix"
msgstr "Minix"

#: floppy.cpp:166
msgctxt "Linux"
msgid "Program mkfs.minix found."
msgstr "Programm \"mkfs.minix\" funnen."

#: floppy.cpp:169
msgctxt "Linux"
msgid ""
"Program mkfs.minix <b>not found</b>. Minix formatting <b>not available</b>"
msgstr ""
"Programm \"mkfs.minix\" <b>nich funnen</b>. Minix-Formateren <b>nich "
"verföögbor</b>."

#: floppy.cpp:173
msgctxt "BSD"
msgid "KFloppy supports two file formats under BSD: MS-DOS and UFS"
msgstr "KFloppy ünnerstütt ünner BSD twee Dateisystemen: MS-DOS un UFS"

#: floppy.cpp:177
msgctxt "BSD"
msgid "Program newfs_msdos found."
msgstr "Programm \"newfs_msdos\" funnen."

#: floppy.cpp:180
msgctxt "BSD"
msgid ""
"Program newfs_msdos <b>not found</b>. MSDOS formatting <b>not available</b>."
msgstr ""
"Programm \"newfs_msdos\" <b>nich funnen</b>. MSDOS-Formateren <b>nich "
"verföögnor</b>."

#: floppy.cpp:184 floppy.cpp:513 floppy.cpp:638
msgid "UFS"
msgstr "UFS"

#: floppy.cpp:186
msgctxt "BSD"
msgid "Program newfs found."
msgstr "Programm \"newfs\" funnen."

#: floppy.cpp:189
msgctxt "BSD"
msgid "Program newfs <b>not found</b>. UFS formatting <b>not available</b>."
msgstr ""
"Programm \"newfs\" <b>nich funnen</b>. UFS-Formateren <b>nich verföögbor</b>."

#: floppy.cpp:204
msgid "&Formatting"
msgstr "&Formateren"

#: floppy.cpp:207
msgid "Q&uick format"
msgstr "F&ixformateren"

#: floppy.cpp:210
msgid ""
"<qt>Quick format is only a high-level format: it creates only a file system."
"</qt>"
msgstr ""
"<qt>De Fixformateren formateert bloots op högere Evene: se stellt bloots en "
"Dateisysteem op.</qt>"

#: floppy.cpp:213
msgid "&Zero out and quick format"
msgstr "Över&nullen un f&ix formateren"

#: floppy.cpp:216
msgid ""
"<qt>This first erases the floppy by writing zeros and then it creates the "
"file system.</qt>"
msgstr ""
"<qt>De Daten op de Diskett warrt mit Nullen överschreven, ehr dat "
"Dateisysteem opstellt warrt.</qt>"

#: floppy.cpp:218
msgid "Fu&ll format"
msgstr "&Vulle Formateren"

#: floppy.cpp:221
msgid ""
"Full format is a low-level and high-level format. It erases everything on "
"the disk."
msgstr ""
"De vulle Formateren formateert op siete un op hoge Evene. All Daten op de "
"Diskett warrt utradeert."

#: floppy.cpp:230
msgid "Program fdformat found."
msgstr "Programm \"fdformat\" funnen."

#: floppy.cpp:235
msgid "Program fdformat <b>not found</b>. Full formatting <b>disabled</b>."
msgstr ""
"Programm \"fdformat\" <b>nich funnen</b>. Vulle Formateren <b>nich "
"verföögbor</b>."

#: floppy.cpp:242
msgid "Program dd found."
msgstr "Programm \"dd\" funnen."

#: floppy.cpp:246
msgid "Program dd <b>not found</b>. Zeroing-out <b>disabled</b>."
msgstr "Programm \"dd\" <b>nich funnen</b>. Övernullen <b>nich verföögbor</b>."

#: floppy.cpp:251
msgid "&Verify integrity"
msgstr "Integriteet &pröven"

#: floppy.cpp:255
msgid ""
"<qt>Check this if you want the floppy disk to be checked after formatting. "
"Please note that the floppy will be checked twice if you have selected full "
"formatting.</qt>"
msgstr ""
"<qt>Aktiveer dit, wenn Du de Diskett na't Formateren pröven wullt. Beacht "
"bitte, dat de Diskett tweemaal pröövt warrt, wenn Du \"Vulle Formateren\" "
"utsöcht hest.</qt>"

#: floppy.cpp:260
msgid "Volume la&bel:"
msgstr "Diskett&naam:"

#: floppy.cpp:264
msgid ""
"<qt>Check this if you want a volume label for your floppy. Please note that "
"Minix does not support labels at all.</qt>"
msgstr ""
"<qt>Aktiveer dit, wenn de Diskett en Beteker hebben schall. Beacht bitte, "
"dat dat so wat ünner Minix nich gifft.</qt>"

#: floppy.cpp:273 floppy.cpp:725
msgctxt "Volume label, maximal 11 characters"
msgid "KDE Floppy"
msgstr "KDE-Floppy"

#: floppy.cpp:277
msgid ""
"<qt>This is for the volume label. Due to a limitation of MS-DOS the label "
"can only be 11 characters long. Please note that Minix does not support "
"labels, whatever you enter here.</qt>"
msgstr ""
"<qt>Dit is de Diskettnaam. He dörv nich länger wesen as 11 Bookstaven, wiel "
"dat ünner MS-DOS disse Grenz gifft. Beacht bitte, dat Minix gor keen "
"Diskettnaams ünnerstütt.</qt>"

#: floppy.cpp:287 floppy.cpp:495
msgid "&Format"
msgstr "&Formateren"

#: floppy.cpp:294
msgid "<qt>Click here to start formatting.</qt>"
msgstr "<qt>Klick hier, wenn Du nu formateren wullt.</qt>"

#: floppy.cpp:318
msgid "<qt>This is the status window, where error messages are displayed.</qt>"
msgstr ""
"<qt>Dit is dat Statusfinster, binnen dat Fehlermellen wiest warrt.</qt>"

#: floppy.cpp:332
msgid "<qt>Shows progress of the format.</qt>"
msgstr "<qt>Wiest dat Vörankamen bi't Formateren.</qt>"

#: floppy.cpp:340
msgid ""
"KFloppy cannot find any of the needed programs for creating file systems; "
"please check your installation.<br><br>Log:"
msgstr ""
"KFloppy kann keen vun de nödigen Programmen för't Opstellen vun "
"Dateisystemen finnen. Prööv bitte Dien Installatschoon.\n"
"<br><br>Logbook:"

#: floppy.cpp:372
msgid "KDE Floppy Formatter"
msgstr "Disketten-Formateerprogramm för KDE"

#: floppy.cpp:515
msgctxt "BSD"
msgid "Formatting with BSD on a user-given device is only possible with UFS"
msgstr ""
"Ünner BSD lett sik en vun den Bruker angeven Reedschap bloots mit UFS "
"formateren."

#: floppy.cpp:523
#, qt-format
msgid ""
"<qt>Formatting will erase all data on the device:<br/><b>%1</b><br/>(Please "
"check the correctness of the device name.)<br/>Are you sure you wish to "
"proceed?</qt>"
msgstr ""
"<qt>Dat Formateren radeert all Daten op de Reedschap ut:<br/><b>%1</b><br/>"
"(Kiek bitte, wat de Reedschapnaam richtig is.)<br/>Büst Du seker, dat Du "
"wiedermaken wullt?</qt>"

#: floppy.cpp:526 floppy.cpp:541
msgid "Proceed?"
msgstr "Wiedermaken?"

#: floppy.cpp:540
msgid ""
"Formatting will erase all data on the disk.\n"
"Are you sure you wish to proceed?"
msgstr ""
"Dat Formateren radeert all Daten op de Reedschap ut.\n"
"Büst Du seker, dat Du wiedermaken wullt?"

#: format.cpp:270
#, qt-format
msgid "Unexpected drive number %1."
msgstr "Nich verwacht Loopwarknummer: %1."

#: format.cpp:276
#, qt-format
msgid "Unexpected density number %1."
msgstr "Nich verwacht Weert för Schriefdichte: %1."

#: format.cpp:291
#, qt-format
msgid "Cannot find a device for drive %1 and density %2."
msgstr "Reedschap för Loopwark %1 un Schriefdichte %2 lett sik nich finnen."

#: format.cpp:310
#, qt-format
msgid ""
"Cannot access %1\n"
"Make sure that the device exists and that you have write permission to it."
msgstr ""
"Keen Togriep op %1\n"
"Stell seker, dat dat de Reedschap gifft un Du dor Schriefverlööf för hest."

#: format.cpp:341
#, qt-format
msgid "The program %1 terminated with an error."
msgstr "Dat Programm \"%1\" hett sik mit en Fehler beendt."

#: format.cpp:347
#, qt-format
msgid "The program %1 terminated abnormally."
msgstr "Dat Programm \"%1\" hett sik nich normaal beendt."

#: format.cpp:410 format.cpp:571 format.cpp:670 format.cpp:771 format.cpp:850
#: format.cpp:944
msgid "Internal error: device not correctly defined."
msgstr "Intern Fehler: Reedschap nich richtig fastleggt."

#: format.cpp:417
msgid "Cannot find fdformat."
msgstr "Programm \"fdformat\" lett sik nich finnen."

#: format.cpp:449
msgid "Could not start fdformat."
msgstr "Programm \"fdformat\" lett sik nich starten."

#: format.cpp:476
#, qt-format
msgid "Error formatting track %1."
msgstr "Fehler bi't Formateren vun Spoor %1."

#: format.cpp:484 format.cpp:517
msgid ""
"Cannot access floppy or floppy drive.\n"
"Please insert a floppy and make sure that you have selected a valid floppy "
"drive."
msgstr ""
"Keen Togriep op de Diskett oder dat Diskettenloopwark.\n"
"Legg bitte en Diskett in un kiek, wat du dat richtige Diskettenloopwark "
"utsöcht hest."

#: format.cpp:505
#, qt-format
msgid "Low-level formatting error at track %1."
msgstr "Fehler bi de Grund-Formateren op Spoor %1"

#: format.cpp:510
#, qt-format
msgid "Low-level formatting error: %1"
msgstr "Fehler bi de Grund-Formateren: %1"

#: format.cpp:524 format.cpp:727 format.cpp:893 format.cpp:984
msgid ""
"Device busy.\n"
"Perhaps you need to unmount the floppy first."
msgstr ""
"Reedschap hett to doon.\n"
"Villicht muttst Du de Diskett toeerst afhangen."

#: format.cpp:530
#, qt-format
msgid "Low-level format error: %1"
msgstr "Grundformaat-Fehler: %1"

#: format.cpp:578
msgid "Cannot find dd."
msgstr "Programm \"dd\" lett sik nich finnen."

#: format.cpp:593
msgid "Could not start dd."
msgstr "Programm \"dd\" lett sik nich starten."

#: format.cpp:677
msgid "Cannot find a program to create FAT filesystems."
msgstr "Keen Programm för't Opstellen vun FAT-Dateisystemen to finnen."

#: format.cpp:708
msgid "Cannot start FAT format program."
msgstr "Dat FAT-Formateerprogramm lett sik nich starten."

#: format.cpp:722 format.cpp:888 format.cpp:979
msgid ""
"Floppy is mounted.\n"
"You need to unmount the floppy first."
msgstr ""
"Diskett is inhangt.\n"
"Du muttst de Diskett toeerts afhangen."

#: format.cpp:778
msgctxt "BSD"
msgid "Cannot find a program to create UFS filesystems."
msgstr "Keen Programm för't Opstellen vun UFS-Dateisystemen to finnen."

#: format.cpp:796
msgctxt "BSD"
msgid "Cannot start UFS format program."
msgstr "Dat UFS-Formateerprogramm lett sik nich starten."

#: format.cpp:857
msgid "Cannot find a program to create ext2 filesystems."
msgstr "Keen Programm för't Opstellen vun ext2-Dateisystemen to finnen."

#: format.cpp:874
msgid "Cannot start ext2 format program."
msgstr "Dat ext2-Formateerprogramm lett sik nich starten."

#: format.cpp:951
msgid "Cannot find a program to create Minix filesystems."
msgstr "Keen Programm för't Opstellen vun Minix-Dateisystemen to finnen."

#: format.cpp:968
msgid "Cannot start Minix format program."
msgstr "Dat Minix-Formateerprogramm lett sik nich starten."

