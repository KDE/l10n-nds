#: rc.cpp:137 rc.cpp:140
msgid ""
"Check the Post-message box and enter a Post-message, which will be spoken "
"when a text job resumes after being interrupted by another message."
msgstr ""
"Aktiveer dat Ankrüüzfeld \"Naklapp\" un giff en Text in, de vörleest warrt, "
"wenn dat Vörlesen na en Ünnerbreken dör en anner Naricht wiedergeiht."

#. i18n: file: kcmkttsmgr/kcmkttsmgrwidget.ui:418
#. i18n: ectx: property (text), widget (QCheckBox, textPostMsgCheck)
#: rc.cpp:143
msgid "Post-&message:"
