#: kmouth.cpp:217 kmouth.cpp:218
msgid "Copies the currently selected phrases from the history to the clipboard"
msgstr ""
"Kopeert de opstunns utsöchten Utdrück ut de Vörgeschicht na de Twischenaflaag"

