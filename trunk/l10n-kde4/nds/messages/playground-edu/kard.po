#: kardview.cpp:264
#, kde-format
msgid ""
"Congratulations!\n"
"You finished the game in %1 tries.\n"
"The best you could have done is %2 tries.\n"
"Do you want to play again?"
msgstr ""
"Graleren!\n"
"Du hest dat mit %1 Versöken henkregen.\n"
"Dat leet sik man ok mit %2 Versöken maken.\n"
"Noch en Törn?"

#: kardview.cpp:268
msgid "Game is Finished"
msgstr "Speel vörbi"

#: kardwidget.cpp:36
msgid "Click to see what is on the back of the card"
msgstr "Klick, dormit Du der Koort ehr Vörsiet ankieken kannst"

#: kardwidget.cpp:37
msgid ""
"Click on two cards to find out what is on the back of the card and try "
"matching a pair"
msgstr ""
"Klick twee Koorten an, dormit Du ehr Vörsieden sühst, un versöök, wat Du en "
"passen Poor finnst."

#: kardwidget.cpp:38
msgid "Click on another card and try matching a pair"
msgstr "Klick en anner Koort an, un versöök, wat Du en passen Poor finnst."

#: main.cpp:31
