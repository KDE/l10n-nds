#: settings/kio/kmanualproxydlg.cpp:444
msgid ""
"<qt>Make sure none of the addresses or URLs you specified contain invalid or "
"wildcard characters such as spaces, asterisks (*), or question marks(?).<br /"
"><br /><u>Examples of VALID entries:</u><br /><code>http://mycompany.com, "
"192.168.10.1, mycompany.com, localhost, http://localhost</code><br /><br /"
"><u>Examples of INVALID entries:</u><br /><code>http://my company.com, http:/"
"mycompany,com file:/localhost</code></qt>"
msgstr ""
"<qt>Beseker bitte, wat keen vun de angeven Adressen lege Tekens bargt, as t."
"B. Freetekens, Steerns (*) oder Fraagtekens (?).<br /><br /><u>Bispelen för "
"gellen Indrääg:</u><br /><code>http://mienbedrief.com, 192.168.10.1, "
"mienbedrief.com, localhost, http://localhost</code><br /><br /><u>Bispelen "
"för leeg Indrääg:</u><br /><code>http://mien bedrief.com, http:/mienbedrief,"
"com, file:/localhost</code></qt>"

#: settings/kio/kmanualproxydlg.cpp:465
msgid "Enter the URL or address that should use the above proxy settings:"
msgstr ""
"Giff de URL oder Adress in, för de Du de Proxy-Instellen baven bruken wullt:"

