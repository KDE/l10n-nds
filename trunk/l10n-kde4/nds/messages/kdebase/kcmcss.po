msgstr "<b>Biller</b><p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 159
#: rc.cpp:93
msgid "&Suppress images"
msgstr "&Keen Biller wiesen"

#. i18n: tag string
#. i18n: file csscustom.ui line 162
#: rc.cpp:96
msgid ""
"<b>Suppress images</b><p>Selecting this will prevent Konqueror from loading "
"images.</p>"
msgstr ""
"<b>Keen Biller wiesen</b><p>Wenn aktiveert, warrt Konqueror keen Biller "
"laden.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 169
#: rc.cpp:99
msgid "Suppress background images"
msgstr "Keen Achtergrundbiller wiesen"

#. i18n: tag string
#. i18n: file csscustom.ui line 175
#: rc.cpp:102
msgid ""
"<b>Suppress background images</b><p>Selecting this option will prevent "
"Konqueror from loading background images.</p>"
msgstr ""
"<b>Keen Achtergrundbiller wiesen</b><p>Wenn aktiveert, warrt Konqueror keen "
"Achtergrundbiller wiesen.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 185
#: rc.cpp:105
msgid "Font Family"
msgstr "Schriftfamilie"

#. i18n: tag string
#. i18n: file csscustom.ui line 188
#: rc.cpp:108
msgid ""
"<b>Font family</b><p>A font family is a group of fonts that resemble one "
"another, with family members that are e.g. bold, italic, or any number of "
"the above.</p>"
msgstr ""
"<b>Schriftfamilie</b><p>En Schriftfamilie is en Koppel vun Schriftoorden, de "
"recht liek to enanner sünd. De enkelten tohören Schriften sünd denn t.B. "
"Fett, Kursiev oder hebbt en anner Egenoort.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 194
#: rc.cpp:111
msgid "Base fa&mily:"
msgstr "Basis-Schrift&familie:"

#. i18n: tag string
#. i18n: file csscustom.ui line 215
#: rc.cpp:114
msgid "<p>This is the currently selected font family</p>"
msgstr "<p>Dit is de aktuell utsöchte Schriftfamilie</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 238
#: rc.cpp:117
msgid "Use same family for all text"
msgstr "Sülve Schriftfamilie för allens bruken"

#. i18n: tag string
#. i18n: file csscustom.ui line 241
#: rc.cpp:120
msgid ""
"<b>Use same family for all text</b><p>Select this option to override custom "
"fonts everywhere in favor of the base font.</p>"
msgstr ""
"<b>Sülve Schriftfamilie för allens bruken</b><p>Wenn aktiveert, warrt all "
"angeven Schriftoorden mit de Basis-Schriftoort överschreven.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 272
#: rc.cpp:123
msgid "&Preview"
msgstr "&Vöransicht"

#. i18n: tag string
#. i18n: file csscustom.ui line 275
#: rc.cpp:126
msgid ""
"<b>Preview</b><p>Click on this button to see what your selections look like "
"in action.</p>"
msgstr ""
"<b>Vöransicht</b><p>Klick op dissen Knoop, wenn Du Dien Instellen in "
"Akschoon ankieken wullt.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 300
#: rc.cpp:129
msgid "Colors"
msgstr "Klören"

#. i18n: tag string
#. i18n: file csscustom.ui line 312
#: rc.cpp:132
msgid "&Black on white"
msgstr "&Swatt op Witt"

#. i18n: tag string
#. i18n: file csscustom.ui line 318
#: rc.cpp:135
msgid "<b>Black on White</b><p>This is what you normally see.</p>"
msgstr "<b>Swatt op Witt</b><p>Dat sühst Du normalerwies.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 325
#: rc.cpp:138
msgid "&White on black"
msgstr "&Witt op Swatt"

#. i18n: tag string
#. i18n: file csscustom.ui line 328
#: rc.cpp:141
msgid "<b>White on Black</b><p>This is your classic inverse color scheme.</p>"
msgstr ""
"<b>Witt op Swatt</b><p>Dat is dat normale Klöörschema mit ümkehrt Klören.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 335
#: rc.cpp:144
msgid "Cus&tom"
msgstr "&Egen"

#. i18n: tag string
#. i18n: file csscustom.ui line 338
#: rc.cpp:147
msgid ""
"<b>Custom</b><p>Select this option to define a custom color for the default "
"font.</p>"
msgstr ""
"<b>Egen</b><p>Hier kannst Du en Klöör för de Standardschriftoort fastleggen."
"</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 356
#. i18n: tag string
#. i18n: file csscustom.ui line 433
#: rc.cpp:150 rc.cpp:156
msgid ""
"<b>Foreground color</b><p>The foreground color is the color that the text is "
"drawn in.</p>"
msgstr "<b>Vörgrundklöör</b><p>Dit is de Klöör vun den Text.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 427
#: rc.cpp:153
msgid "&Foreground:"
msgstr "&Vörgrund:"

#. i18n: tag string
#. i18n: file csscustom.ui line 446
#: rc.cpp:159
msgid ""
"<b>Background</b><p>Behind this door lays the ability to choose a custom "
"default background.</p>"
msgstr ""
"<b>Achtergrund</b><p>Hier kannst Du en egen Standardachtergrund fastleggen.</"
"p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 453
#: rc.cpp:162
msgid "Bac&kground:"
msgstr "&Achtergrund"

#. i18n: tag string
#. i18n: file csscustom.ui line 459
#: rc.cpp:165
msgid ""
"<b>Background</b><p>This background color is the one displayed behind the "
"text by default. A background image will override this.</p>"
msgstr ""
"<b>Achtergrund</b><p>Disse Klöör warrt standardwies achter den Text wiest, "
"man en Achtergrundbild kann dor noch över liggen.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 471
#: rc.cpp:168
msgid "Use same color for all text"
msgstr "Sülve Klöör för helen Text bruken"

#. i18n: tag string
#. i18n: file csscustom.ui line 474
#: rc.cpp:171
msgid ""
"<b>Use same color for all text</b><p>Select this option to apply your chosen "
"color to the default font as well as any custom fonts as specified in a "
"stylesheet.</p>"
msgstr ""
"<b>Sülve Klöör för helen Text bruken</b><p>Wenn aktiveert, warrt de "
"Standardschriftoort, un ok all anner Schriftoorden, de binnen en Stilvörlaag "
"angeven sünd, mit de utsöchte Klöör wiest.</p>"

