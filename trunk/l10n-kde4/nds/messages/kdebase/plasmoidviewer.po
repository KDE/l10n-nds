#: main.cpp:49
msgid "Run Plasma widgets in their own window"
msgstr "Plasma-Lüttprogrammen in ehr egen Finster utföhren"

#: main.cpp:100
msgid "No description available"
msgstr "Keen Beschrieven verföögbor"

#: main.cpp:117
msgid "Plasma Widget Viewer"
msgstr "Plasma-Lüttprogrammkieker"

#: main.cpp:119
msgid "2007-2008, Frerich Raabe"
msgstr "2007-2008, Frerich Raabe"

#: main.cpp:121
msgid "Frerich Raabe"
msgstr "Frerich Raabe"

#: main.cpp:122
msgid "Original author"
msgstr "Orginaalautor"

#: main.cpp:129
msgid "Name of the containment plugin"
msgstr "Naam vun't Gelaatsmoduul"

#: main.cpp:131
msgctxt "Do not translate horizontal, vertical, mediacenter nor planar"
msgid "The formfactor to use (horizontal, vertical, mediacenter or planar)"
msgstr ""
"De Form, de Du bruken wullt: horizontal (kimmrecht), vertical (pielrecht), "
"mediacenter (merrnmiddel) oder planar (plaatliek)"

#: main.cpp:132
msgid "Displays a list of known applets"
msgstr "Wiest en List mit begäng Lüttprogrammen"

#: main.cpp:133
msgid "Displays a list of known wallpapers"
msgstr "Wiest en List mit begäng Achtergrundbiller"

#: main.cpp:134
msgid "Displays a list of known containments"
msgstr "Wiest en List mit begäng Gelaatsen"

#: main.cpp:136
msgctxt ""
"Do not translate floating, desktop, fullscreen, top, bottom, left nor right"
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, top, bottom, left, right)"
msgstr ""
"De Steedbeding för't Gelaats: floating (sweven), desktop (Schriefdisch), "
"fullscreen (Heelschirm), top (baven), bottom (nerrn), left (links), right "
"(rechts)"

#: main.cpp:138
msgid "The size in KB to set the pixmap cache to"
msgstr "De Grött in kB, op de de Pixelbild-Twischenspieker sett warrt"

#: main.cpp:140
msgid "Desktop SVG theme to use"
msgstr "SVG-Schriefdischmuster, dat Du bruken wullt"

#: main.cpp:142
msgid ""
"Name of the wallpaper plugin. Requires a containment plugin to be specified."
msgstr "Naam vun't Achtergrundbild-Moduul. Du muttst en Gelaats-Moduul bruken."

#: main.cpp:143
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""
"Naam vun dat Lüttprogramm, dat Du ankieken wullt. Mag en Moduul oder en "
"(afsoluut oder relatiev) Padd na en Paket wesen. Wenn nich angeven, warrt "
"binnen den aktuellen Orner na en Paket söcht."

#: main.cpp:146
msgid "Optional arguments of the applet to add"
msgstr "Anner Argumenten för't Lüttprogramm, dat Du tofögen wullt"

#: main.cpp:147
msgid "List zeroconf announced remote widgets"
msgstr "Över Zeroconf apenmaakt Lüttprogrammen oplisten"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

