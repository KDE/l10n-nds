#: devicewrapper.cpp:125
msgid "Mount the device"
msgstr "De Reedschap inhangen"

#: devicewrapper.cpp:127
msgid "Unmount the device"
msgstr "De Reedschap afhangen"

#: devicewrapper.cpp:130
msgid "Eject medium"
msgstr "Schiev rutfohren"

#: devicewrapper.cpp:213
msgid ""
"Could not unmount the device.\n"
"One or more files on this device are open within an application."
msgstr ""
"Reedschap lett sik nich afhangen.\n"
"En Programm hölltt dor noch een oder mehr Dateien op opmaakt."

#: devicewrapper.cpp:218
msgid ""
"Could not eject the disc.\n"
"One or more files on this disc are open within an application."
msgstr ""
"De Schiev lett sik nich rutfohren.\n"
"En Programm hett dor noch een oder mehr Dateien op apen."

#: devicewrapper.cpp:223
msgid "Could not mount the disc."
msgstr "De Schiev lett sik nich inhangen."

#: solidrunner.cpp:48
msgid "Finds devices whose name match :q:"
msgstr "Na Reedschappen söken, de ehr Naam op :q: passt."

#: solidrunner.cpp:50 solidrunner.cpp:131
msgctxt "Note this is a KRunner keyword"
msgid "device"
msgstr "Reedschap"

#: solidrunner.cpp:51
msgid "Lists all devices and allows them to be mounted, unmounted or ejected."
msgstr ""
"List all Reedschappen op un lett Di se inhangen, afhangen un rutfohren."

#: solidrunner.cpp:52 solidrunner.cpp:137
msgctxt "Note this is a KRunner keyword"
msgid "mount"
msgstr "Inhangen"

#: solidrunner.cpp:53
msgid "Lists all devices which can be mounted, and allows them to be mounted."
msgstr "List all inhangbor Reedschappen op un lett se Di ok inhangen."

#: solidrunner.cpp:54 solidrunner.cpp:141
msgctxt "Note this is a KRunner keyword"
msgid "unmount"
msgstr "Afhangen"

#: solidrunner.cpp:55
msgid ""
"Lists all devices which can be unmounted, and allows them to be unmounted."
msgstr "List all afhangbor Reedschappen op un lett se Di ok afhangen."

#: solidrunner.cpp:56
msgctxt "Note this is a KRunner keyword"
msgid "eject"
msgstr "Rutfohren"

#: solidrunner.cpp:57
msgid "Lists all devices which can be ejected, and allows them to be ejected."
msgstr "List all rutfohrbor Reedschappen op un lett se Di ok rutfohren."
