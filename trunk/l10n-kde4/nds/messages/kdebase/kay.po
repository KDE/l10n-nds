#: medianotifier.cpp:173
#, qt-format
msgid ""
"An autorun file as been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr ""
"En sülvststarten Datei is op Dien \"%1\". Wullt Du ehr utföhren? Dat\n"
"Utföhren vun en Datei op en Medium kann de Systeemsekerheit in Fraag stellen."

#: medianotifier.cpp:177
#, qt-format
msgid "Autorun - %1"
msgstr "Sülvststart - %1"

#: medianotifier.cpp:246
#, qt-format
msgid ""
"An autoopen file as been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr ""
"En sülvstopmaken Datei is op Dien \"%1\". Wullt Du \"%2\" opmaken?\n"
"Dat Opmaken vun en Datei op en Medium kann de Systeemsekerheit in Fraag "
"stellen."

#: medianotifier.cpp:250
#, qt-format
msgid "Autoopen - %1"
msgstr "Sülvstopmaken - %1"

