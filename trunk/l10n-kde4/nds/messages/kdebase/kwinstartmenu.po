#: main.cpp:42
msgid "kwinstartmenu"
msgstr "kwinstartmenu"

#: main.cpp:43
msgid "An application to create/update or remove Windows Start Menu entries"
msgstr ""
"En Programm, dat Windows-Startmenüindrääg opstellt, opfrischt oder wegmaakt"

#: main.cpp:45
msgid "(C) 2008-2011 Ralf Habacker"
msgstr "© 2008-2011: Ralf Habacker"

#: main.cpp:49
msgid "remove installed start menu entries"
msgstr "Installeert Startmenüindrääg wegmaken"

#: main.cpp:50
msgid "install start menu entries"
msgstr "Startmenüindrääg installeren"

#: main.cpp:51
msgid "update start menu entries"
msgstr "Startmenüindrääg opfrischen"

#: main.cpp:52
msgid "remove start menu entries from unused kde installation"
msgstr "Startmenüindrääg vun nich bruukt KDE-Installatschoon wegmaken."

#: main.cpp:54
msgid "query root path of start menu entries"
msgstr "Wörtelpadd vun Startmenüindrääg affragen"

#: main.cpp:56
msgid "use categories for start menu entries (default)"
msgstr "Kategorien för Startmenüindrääg bruken (Standard)"

#: main.cpp:57
msgid "don't use categories for start menu entries"
msgstr "Keen Kategorien för Startmenüindrääg bruken"

#: main.cpp:58
msgid "query current value of categories in start menu"
msgstr "Aktuellen Weert vun Startmenükategorien affragen"

#: main.cpp:60
msgid "set custom string for root start menu entry"
msgstr "Egen Text för Hööftstartmenüindrag tofögen"

#: main.cpp:63
msgid "remove custom string from root start menu entry"
msgstr "Egen Text för Hööftstartmenüindrag wegmaken"

#: main.cpp:64
msgid "query current value of root start menu entry custom string"
msgstr "Aktuellen Weert vun egen Text för Hööftstartmenüindrag affragen"

