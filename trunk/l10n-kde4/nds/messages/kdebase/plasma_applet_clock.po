#: clock.cpp:124
msgctxt "@title:window"
msgid "Configure Clock"
msgstr "Klock instellen"

#. i18n: tag string
#. i18n: file clockConfig.ui line 64
#: rc.cpp:3
msgid "Area"
msgstr "Rebeet"

#. i18n: tag string
#. i18n: file clockConfig.ui line 69
#: rc.cpp:6
msgid "Region"
msgstr "Regioon"

#. i18n: tag string
#. i18n: file clockConfig.ui line 74
#: rc.cpp:9
msgid "Comment"
msgstr "Kommentar"

#. i18n: tag string
#. i18n: file clockConfig.ui line 82
#: rc.cpp:12
msgid "Display the second hand"
msgstr "Sekunnenwieser"

#. i18n: tag string
#. i18n: file clockConfig.ui line 85
#: rc.cpp:15
msgid ""
"Check this if you want to display the second hand in order to see the "
"seconds."
msgstr "Maak dit an, wenn Du denn Sekunnenwieser bruken wullt."

#. i18n: tag string
#. i18n: file clockConfig.ui line 88
#: rc.cpp:18
msgid "Display seconds"
msgstr "Sekunnen wiesen"

#. i18n: tag string
#. i18n: file clockConfig.ui line 95
#: rc.cpp:21
msgid "Display the time as a string"
msgstr "De Tiet as Text wiesen"

#. i18n: tag string
#. i18n: file clockConfig.ui line 98
#: rc.cpp:24
msgid ""
"Check this if you want to display the time as a string within the clock."
msgstr "Maak dit an, wenn Du de Tiet as Text binnen de Klock wiesen wullt."

#. i18n: tag string
#. i18n: file clockConfig.ui line 101
#: rc.cpp:27
msgid "Also display the time in text"
msgstr "De Tiet ok as Text wiesen"

#. i18n: tag string
#. i18n: file clockConfig.ui line 125
#: rc.cpp:30
msgid "Size of the clock:"
msgstr "De Klock ehr Grött:"

#. i18n: tag string
#. i18n: file clockConfig.ui line 132
#: rc.cpp:33
msgid "Change clock size"
msgstr "Klockgrött ännern"

#. i18n: tag string
#. i18n: file clockConfig.ui line 135
#: rc.cpp:36
msgid ""
"Set a new size for the clock between 0 and 500. The size is the square side "
"that contains the clock."
msgstr ""
"Hier kannst Du en nieg Grött för de Klock fastleggen, twischen 0 un 500. De "
"Tall is de Kantlängde vun dat Quadraat, dat de Klock bargt."

