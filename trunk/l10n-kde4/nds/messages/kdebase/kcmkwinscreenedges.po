#: rc.cpp:27 rc.cpp:78
msgid "Disabled"
msgstr "Utmaakt"

#. i18n: file: main.ui:109
#. i18n: ectx: property (text), item, widget (QComboBox, desktopSwitchCombo)
#: rc.cpp:30 rc.cpp:81
msgid "Only When Moving Windows"
msgstr "Bloots bi't Verschuven vun Finstern"

#. i18n: file: main.ui:114
