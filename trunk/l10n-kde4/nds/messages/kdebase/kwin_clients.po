#: rc.cpp:47
msgid ""
"When enabled, this option increases the visibility of the window titlebar by "
"showing stripes"
msgstr ""
"Wenn anmaakt, maakt disse Optschoon den Finster-Titelbalken mit Striepen "
"beter sichtbor."

#. i18n: file: oxygen/config/oxygenconfig.ui:59
#. i18n: ectx: property (text), widget (QCheckBox, showStripes)
#: rc.cpp:50
msgid "Show stripes next to the title"
msgstr "Striepen blang Titel wiesen"

#. i18n: file: oxygen/config/oxygenconfig.ui:66
