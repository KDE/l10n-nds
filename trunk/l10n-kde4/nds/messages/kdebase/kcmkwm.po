msgctxt "Focus Stealing Prevention Level"
msgid "None"
msgstr "Keen"

#: windows.cpp:121
msgctxt "Focus Stealing Prevention Level"
msgid "Low"
msgstr "Siet"

#: windows.cpp:122
msgctxt "Focus Stealing Prevention Level"
