#. i18n: file: ReniceDlgUi.ui:406
#. i18n: ectx: property (text), widget (QLabel, lblCpuHigh)
#. i18n: file: ReniceDlgUi.ui:471
#. i18n: ectx: property (text), widget (QLabel, lblIOHigh)
#. i18n: file: ReniceDlgUi.ui:406
