#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - maakt Dateien op anner Reekners op, luurt op Ännern, fraagt ehr "
"hoochlaadt warrt"

#: main.cpp:50
msgid "Treat URLs as local files and delete them afterwards"
msgstr ""
"Adressen (URLs) as Dateien op Dien Rekner behanneln un achteran wegsmieten"

#: main.cpp:51
msgid "Suggested file name for the downloaded file"
msgstr "Vörslaan Dateinaam för daallaadt Datei"

#: main.cpp:52
msgid "Command to execute"
msgstr "Befehl för't Utföhren"

#: main.cpp:53
msgid "URL(s) or local file(s) used for 'command'"
msgstr "URL(s) oder lokale Datei(en) för \"command\""

#: main.cpp:62
msgid "'command' expected.\n"
msgstr "\"command\" verwacht.\n"

#: main.cpp:91
#, qt-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"De URL %1\n"
"gellt nich"

#: main.cpp:93
#, qt-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"URL %1\n"
"op anner Reekner dörv nich mit --tempfile bruukt warrn"

#: main.cpp:222
#, qt-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"De sachens temporere Datei\n"
"%1\n"
"wöör ännert.\n"
"Wullt Du ehr liekers wegdoon?"

#: main.cpp:223 main.cpp:230
msgid "File Changed"
msgstr "Datei ännert"

#: main.cpp:223
msgid "Do Not Delete"
msgstr "Nich wegdoon"

#: main.cpp:229
#, qt-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"De Datei\n"
"%1\n"
"wöör ännert.\n"
"Wullt du de Ännern hoochladen?"

#: main.cpp:230
msgid "Upload"
msgstr "Hoochladen"

#: main.cpp:230
msgid "Do Not Upload"
msgstr "Nich hoochladen"

#: main.cpp:258
msgid "KIOExec"
msgstr "KIOExec"

