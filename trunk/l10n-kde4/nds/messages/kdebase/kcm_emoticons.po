#: emoticonslist.cpp:107
msgid "Emoticons"
msgstr "Snuten"

#: emoticonslist.cpp:245
msgid "Drag or Type Emoticon Theme URL"
msgstr "Snutensett-URL herhen trecken oder ingeven"

#: emoticonslist.cpp:250
msgid "Emoticon themes must be installed from local files."
msgstr "Snutensetten laat sikk bloots ut lokaal Dateien installeren."

#: emoticonslist.cpp:251
msgid "Could Not Install Emoticon Theme"
msgstr "Snutensett lett sik nich installeren"

#: emoticonslist.cpp:269
#, kde-format
msgid "Do you want to remove %1 too?"
msgstr "Wullt Du \"%1\" ok wegmaken?"

#: emoticonslist.cpp:269
msgid "Delete emoticon"
msgstr "Snuut wegdoon"

#: emoticonslist.cpp:285
msgid "Add emoticon"
msgstr "Snuut tofögen"

#: emoticonslist.cpp:309
msgid "Edit emoticon"
msgstr "Snuut bewerken"

#: emoticonslist.cpp:351 emoticonslist.cpp:374
msgid "New Emoticon Theme"
msgstr "Nieg Snutensett"

#: emoticonslist.cpp:351
msgid "Enter the name of the new emoticon theme"
msgstr "Giff bitte den Naam vun den niegen Snutensett in"

#: emoticonslist.cpp:357
#, kde-format
msgid "%1 theme already exists"
msgstr "Dat gifft den Sett »%1« al"

#: emoticonslist.cpp:374
msgid "Choose the type of emoticon theme to create"
msgstr ""
"Söök bitte den Typ vun den niegen Snutensett ut, den Du opstellen wullt"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 13
#: rc.cpp:3
msgid "Emoticons Manager"
msgstr "Snutenpleger"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 47
#: rc.cpp:6
msgid "Create a new emoticon"
msgstr "En nieg Snuut opstellen"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 50
#: rc.cpp:9
msgid "Create a new emoticon by assigning it an icon and some text"
msgstr ""
"Du kannst en nieg Snuut opstellen, wenn Du ehr en Lüttbild un wat Text "
"towiest."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 53
#: rc.cpp:12
msgid "Add..."
msgstr "Tofögen..."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 60
#: rc.cpp:15
msgid "Modify the selected emoticon icon or text "
msgstr "Dat utsöchte Snuut-Lüttbild oder sien Text ännern "

#. i18n: tag string
#. i18n: file emoticonslist.ui line 63
#: rc.cpp:18
msgid "Edit the selected emoticon to change its icon or its text"
msgstr ""
"Du kannst de utsöchte Snuut bewerken, wenn Du ehr Lüttbild oder Text ännern "
"wullt"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 66
#: rc.cpp:21
msgid "Edit..."
msgstr "Bewerken..."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 73
#: rc.cpp:24
msgid "Remove the selected emoticon"
msgstr "De utsöchte Snuut wegdoon"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 76
#: rc.cpp:27
msgid "Remove the selected emoticon from your disk"
msgstr "De utsöchte Snuut vun Dien Fastplaat wegmaken"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 79
#: rc.cpp:30
msgid "Remove"
msgstr "Wegmaken"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 103
#: rc.cpp:33
msgid "Require spaces around emoticons"
msgstr "Freetekens blang Snuten verdwingen"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 110
#: rc.cpp:36
msgid "Design a new emoticon theme"
msgstr "En nieg Snutensett opstellen"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 113
#: rc.cpp:39
msgid ""
"Start a new theme by assigning it a name. Then use the Add button on the "
"right to add emoticons to this theme."
msgstr ""
"Du fangst en nieg Sett an, wenn Du em en Naam giffst. Achteran kannst Du em "
"mit den Knoop \"Tofögen\" rechterhand Snuten tofögen."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 116
#: rc.cpp:42
msgid "New Theme..."
msgstr "Nieg Sett..."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 123
#: rc.cpp:45
msgid "Get new themes from the Internet"
msgstr "Nieg Setten ut dat Internet daalladen"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 126
#: rc.cpp:48
msgid ""
"You need to be connected to the Internet to use this action. A dialog will "
"display a list of emoticon themes from the http://www.kde.org website. "
"Clicking the Install button associated with a theme will install this theme "
"locally."
msgstr ""
"Du muttst na't Internet tokoppelt wesen, wenn Du disse Funkschoon bruken "
"wullt. En Dialoog wiest en List vun Setten, de dat op http://www.kde.org "
"gifft. Klickst Du op en Sett sien Installeren-Knoop, warrt he lokaal "
"installeert."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 129
#: rc.cpp:51
msgid "Get New Themes..."
msgstr "Nieg Setten halen..."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 136
#: rc.cpp:54
msgid "Install a theme archive file you already have locally"
msgstr "En Sett-Archievdatei installeren, de Du al op Dien Reekner hest"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 139
#: rc.cpp:57
msgid ""
"If you already have an emoticon theme archive locally, this button will "
"unpack it and make it available for KDE applications"
msgstr ""
"Wenn Du al en Snutensett-Archiev op Dien Reekner hest, kannst Du dat mit "
"dissen Knoop utpacken un för KDE-Programmen verföögbor maken"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 142
#: rc.cpp:60
msgid "Install Theme File..."
msgstr "Settdatei installeren..."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 149
#: rc.cpp:63
msgid "Remove the selected theme from your disk"
msgstr "Den utsöchten Sett vun Dien Fastplaat wegmaken"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 152
#: rc.cpp:66
msgid "This will remove the selected theme from your disk."
msgstr "Disse Akschoon maakt den utsöchten Sett vun Dien Fastplaat weg."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 155
#: rc.cpp:69
msgid "Remove Theme"
msgstr "Sett wegdoon"

#: rc.cpp:70
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#: rc.cpp:71
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

