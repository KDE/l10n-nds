#: ui/applet.cpp:155
msgid "No notifications and no jobs"
msgstr "Keen Bescheden un keen Opgaven"

#: ui/applet.cpp:328
msgid "Visible icons:"
msgstr "Sichtbor Lüttbiller:"

#: ui/applet.cpp:329
msgid "Hidden icons:"
msgstr "Versteken Lüttbiller:"

#: ui/applet.cpp:335
msgid ""
"Select the types of application feedback that should be integrated with the "
"system tray:"
msgstr ""
"De Typen vun Programmmellen fastleggen, de Du na den Systeemafsnitt inbetten "
"wullt:"

#: ui/applet.cpp:338
msgid "Jobs, such as file transfers"
msgstr "Opgaven as a.B. Dateiöverdregen"

#: ui/applet.cpp:340
msgid "Notifications, such as chat requests"
msgstr "Bescheden, as a:B. Klöönsnackanfragen"

#: ui/applet.cpp:353
msgid "Auto Hide"
msgstr "Automaatsch versteken"

#: ui/applet.cpp:354
msgid "Notifications"
msgstr "Bescheden"

#: ui/extendertask.cpp:82
msgid "Show or hide notifications and jobs"
msgstr "Bescheden un Opgaven wiesen oder versteken"

#: ui/extendertask.cpp:109
msgid "Toggle visibility of notifications and jobs"
msgstr "Sichtborkeit vun Bescheden un Opgaven an- oder utmaken"

#: ui/jobwidget.cpp:96
msgid "Pause job"
msgstr "Opgaav anhollen"

#: ui/jobwidget.cpp:106
msgid "Resume job"
msgstr "Opgaav wiedermaken"

#: ui/jobwidget.cpp:116
msgid "Cancel job"
msgstr "Opgaav afbreken"

#: ui/jobwidget.cpp:180
#, kde-format
msgctxt ""
"%1 is the name of the job, can be things like Copying, deleting, moving"
msgid "(paused) %1"
msgstr "%1 (anhollen)"

#: ui/jobwidget.cpp:184
#, kde-format
msgctxt ""
"%1 is the name of the job, can be things like Copying, deleting, moving"
msgid "(finished) %1"
msgstr "%1 (afslaten)"

#: ui/jobwidget.cpp:210
#, kde-format
msgid "%2 / 1 folder"
msgid_plural "%2 / %1 folders"
msgstr[0] ""
msgstr[1] ""

#: ui/jobwidget.cpp:216
#, kde-format
msgid "%2 / 1 file"
msgid_plural "%2 / %1 files"
msgstr[0] ""
msgstr[1] ""

#: ui/notificationwidget.cpp:137
#, kde-format
msgid "Notification from %1"
msgstr "Narichten vun %1"

#~ msgid "Show Jobs"
#~ msgstr "Opgaven wiesen"

#~ msgid "Show Notifications"
#~ msgstr "Bescheden wiesen"

