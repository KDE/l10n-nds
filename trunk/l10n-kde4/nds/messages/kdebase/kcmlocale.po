msgstr "JEDEC-Eenheiten (KB, MB, usw.)"

#: kcmlocale.cpp:3077
msgctxt "Unit of binary measurement"
msgid "Metric Units (kB, MB, etc)"
msgstr "Metersch Eenheiten (kB, MB, usw.)"

