#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 23
#: rc.cpp:3
msgid "&Bell"
msgstr "&Pingel"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 29
#: rc.cpp:6
msgid "&Audible Bell"
msgstr "&Toonpingel"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 33
#: rc.cpp:9
msgid ""
"This is the configuration of the Audible Bell.<br>\n"
"It could be the system bell and/or a custom bell."
msgstr ""
"Hier kannst Du de Toonpingel instellen.<br>\n"
"Dat kann de Systeempingel un / oder en egen Pingel wesen."

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 39
#: rc.cpp:13
msgid "Use &system bell"
msgstr "&Systeempingel bruken"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 43
#: rc.cpp:16
msgid ""
"If this option is checked, the default system bell will be used. See the "
"\"System Bell\" control module for how to customize the system bell.<br>\n"
"Normally, this is just a \"beep\"."
msgstr ""
"Wenn anmaakt, warrt de Standard-Systeempingel bruukt. Kiek in dat "
"\"Systeempingel\"-Kuntrullmoduul, wenn Du ehr instellen wullt.<br>\n"
"Normalerwies is dat bloots en \"Piep\"."

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 50
#: rc.cpp:20
msgid "Use &customized bell"
msgstr "&Egen Pingel bruken"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 54
#: rc.cpp:23
msgid ""
"Check this option if you want to use a customized bell, playing a sound "
"file. If you do this, you will probably want to turn off the system bell."
"<br>\n"
"Please note that on slow machines this may cause a \"lag\" between the event "
"causing the bell and the sound being played."
msgstr ""
"Wenn anmaakt, warrt en Klangdatei as Pingel afspeelt, un Du schullst denn de "
"Systeempingel utmaken.<br>\n"
"Bitte beacht, dat op langsame Reekners en lütt Tiet twischen dat Begeefnis "
"un den Klang liggen kann."

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 82
#: rc.cpp:27
msgid "Sound &to play:"
msgstr "&Klang för't Afspelen:"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 88
#: rc.cpp:30
msgid ""
"If the option \"Use customized bell\" is enabled, you can choose a sound "
"file here."
msgstr ""
"Wenn \"Egen Pingel bruken\" aktiveert is, kannst Du hier en Klangdatei "
"utsöken."

