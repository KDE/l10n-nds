#: fileprops.cpp:231
msgid "kfile"
msgstr "kfile"

#: fileprops.cpp:232
msgid "A commandline tool to read and modify metadata of files."
msgstr "En Konsoolprogramm för't Lesen un Bewerken vun Dateien ehr Metadaten"

#: fileprops.cpp:233
msgid "(c) 2002, Carsten Pfeiffer"
msgstr "(c) 2002, Carsten Pfeiffer"

#: fileprops.cpp:237
msgid "Carsten Pfeiffer"
msgstr "Carsten Pfeiffer"

#: fileprops.cpp:246
msgid "Do not print the mimetype of the given file(s)"
msgstr "Den MIME-Typ vun de angeven Datei(en) nich utgeven"

#: fileprops.cpp:248
msgid "List all supported metadata keys."
msgstr "All begäng Metadatenslötels oplisten"

#: fileprops.cpp:250
msgid "List all metadata keys which have a value in the given file(s)."
msgstr "All Metadatenslötels oplisten, de binnen de angeven Datei(en) en Weert hebbt."

#: fileprops.cpp:253
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr "Nich wohrschoen, wenn mehr Dateien angeven sünd un se nich all den sülven MIME-Typ hebbt."

#: fileprops.cpp:256
msgid "Prints all metadata values, available in the given file(s)."
msgstr "All Metadatenweerten utgeven, de dat binnen de angeven Datei(en) gifft"

#: fileprops.cpp:258
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr ""
"Den KDE-Egenschappendialoog opmaken, mit den sik de Metadaten vun de angeven "
"Datei(en) ankieken un bewerken laat"

#: fileprops.cpp:260
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr ""
"Gifft den Weert för \"Slötel\" binnen de angeven Datei(en) ut. \"Slötel\" kann ok en "
"List vun Slötels wesen, trennt mit Kommas."

#: fileprops.cpp:262
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr "Versöcht dat un sett all Metadaten \"Slötel\" vun de angeven Datei(en) op \"Weert\"."

#: fileprops.cpp:264
msgid "The file (or a number of files) to operate on."
msgstr "De Datei(en), för de Du de Akschoon utföhren wullt"

#: fileprops.cpp:278
msgid "No files specified"
msgstr "Keen Dateien angeven"

#: fileprops.cpp:298
msgid "Cannot determine metadata"
msgstr "Metadaten laat sik nich fastslaan"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

