#: main.cpp:50
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"De KDE-Törnpleger op den Verlaat is, de ok dat Standard-X11R6-\n"
"Törnpleegprotokoll (\"XSMP\") snackt."

#: main.cpp:197
msgid "The KDE Session Manager"
msgstr "De KDE-Törnpleger"

#: main.cpp:199
msgid "(C) 2000, The KDE Developers"
msgstr "(C) 2000, De KDE-Schrievers"

#: main.cpp:200
msgid "Matthias Ettrich"
msgstr "Matthias Ettrich"

#: main.cpp:201
msgid "Luboš Luňák"
msgstr "Luboš Luňák"

#: main.cpp:201
msgid "Maintainer"
msgstr "Pleger"

#: main.cpp:207
msgid "Restores the saved user session if available"
msgstr "Stellt den sekerten Brukertörn wedder her (wenn mööglich)"

#: main.cpp:209
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Start \"wm\", wenn keen anner Finsterpleger an\n"
"den Törn Andeel hett. Standard is \"kwin\""

#: main.cpp:210
msgid "Also allow remote connections"
msgstr "Ok Verbinnen mit anner Reekners tolaten"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

#: shutdown.cpp:354
#, kde-format
msgid "Logout canceled by '%1'"
msgstr "\"%1\" hett dat Afmellen afbraken"

#: shutdowndlg.cpp:361
#, kde-format
msgid "End Session for %1"
msgstr "Törn vun \"%1\" beennen"

#: shutdowndlg.cpp:363
#, kde-format
msgid "End Session for %1 (%2)"
msgstr "Törn vun \"%1\" (%2) beennen"

#: shutdowndlg.cpp:380
msgid "Logout"
msgstr "Afmellen"

#: shutdowndlg.cpp:388
msgid "Turn Off Computer"
msgstr "Reekner utmaken"

#: shutdowndlg.cpp:400
msgid "Standby"
msgstr "Praatschap"

#: shutdowndlg.cpp:402
msgid "Suspend to RAM"
msgstr "Utsetten (RAM)"

#: shutdowndlg.cpp:404
msgid "Suspend to Disk"
msgstr "Infreren (op Fastplaat)"

#: shutdowndlg.cpp:407
msgid "Restart Computer"
msgstr "Reekner nieg starten"

#: shutdowndlg.cpp:429
msgctxt "current option in boot loader"
msgid " (current)"
msgstr " (dit)"

#: shutdowndlg.cpp:438
msgid "Cancel"
msgstr "Afbreken"
