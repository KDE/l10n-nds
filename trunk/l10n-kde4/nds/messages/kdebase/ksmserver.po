#: main.cpp:52
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"De KDE-Törnpleger op den Verlaat is, de ok dat Standard-X11R6-\n"
"Törnpleegprotokoll (\"XSMP\") snackt."

#: main.cpp:240
msgid "The KDE Session Manager"
msgstr "De KDE-Törnpleger"

#: main.cpp:242
msgid "(C) 2000, The KDE Developers"
msgstr "(C) 2000, De KDE-Schrievers"

#: main.cpp:243
msgid "Matthias Ettrich"
msgstr "Matthias Ettrich"

#: main.cpp:244
msgid "Luboš Luňák"
msgstr "Luboš Luňák"

#: main.cpp:244
msgid "Maintainer"
msgstr "Pleger"

#: main.cpp:252
msgid "Restores the saved user session if available"
msgstr "Stellt den sekerten Brukertörn wedder her (wenn mööglich)"

#: main.cpp:254
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Start \"wm\", wenn keen anner Finsterpleger an\n"
"den Törn Andeel hett. Standard is \"kwin\""

#: main.cpp:255
msgid "Also allow remote connections"
msgstr "Ok Verbinnen mit anner Reekners tolaten"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

#: shutdown.cpp:350
#, kde-format
msgid "Logout canceled by '%1'"
msgstr "\"%1\" hett dat Afmellen afbraken"

#: shutdowndlg.cpp:380
msgid "&Logout"
msgstr "A&fmellen"

#: shutdowndlg.cpp:388
msgid "&Turn Off Computer"
msgstr "Reekner &utmaken"

#: shutdowndlg.cpp:401
msgid "&Standby"
msgstr "&Praatschap"

#: shutdowndlg.cpp:405
msgid "Suspend to &RAM"
msgstr "Utsetten (&RAM)"

#: shutdowndlg.cpp:409
msgid "Suspend to &Disk"
msgstr "&Infreren (op Fastplaat)"

#: shutdowndlg.cpp:415
msgid "&Restart Computer"
msgstr "Reekner &nieg starten"

#: shutdowndlg.cpp:439
msgctxt "current option in boot loader"
msgid " (current)"
msgstr " (dit)"

#: shutdowndlg.cpp:446
msgid "&Cancel"
msgstr "&Afbreken"

#: shutdowndlg.cpp:479
#, kde-format
msgid "Log out in 1 second."
msgid_plural "Log out in %1 seconds."
msgstr[0] "Afmellen in 1 Sekunn."
msgstr[1] "Afmellen in %1 Sekunnen."

#: shutdowndlg.cpp:482
#, kde-format
msgid "Turn off computer in 1 second."
msgid_plural "Turn off computer in %1 seconds."
msgstr[0] "Reekner in 1 Sekunn utmaken"
msgstr[1] "Reekner in %1 Sekunnen utmaken"

#: shutdowndlg.cpp:485
#, kde-format
msgid "Reboot computer in 1 second."
msgid_plural "Reboot computer in %1 seconds."
msgstr[0] "Reekner in 1 Sekunn nieg starten"
msgstr[1] "Reekner in %1 Sekunnen nieg starten"

