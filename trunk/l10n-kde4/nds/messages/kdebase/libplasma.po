#: appletbrowser.cpp:360
msgid ""
"<qt>When clicking <b>Close</b>, this dialog will be closed with no further "
"action taken.</qt>"
msgstr ""
"<qt>Wenn Du op <b>Tomaken</b> klickst, warrt disse Dialoog tomaakt un nix "
"wieder daan.</qt>"

#: appletbrowser.cpp:361
