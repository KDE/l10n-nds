#: kioclient.cpp:42
msgid "KIO Client"
msgstr "KIO-Client"

#: kioclient.cpp:43
msgid "Command-line tool for network-transparent operations"
msgstr "Konsoolwarktüüch för Akschonen över't Nettwark"

#: kioclient.cpp:54
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Syntax:\n"

#: kioclient.cpp:55
msgid ""
"  kioclient openProperties 'url'\n"
"            # Opens a properties menu\n"
"\n"
msgstr ""
"  kioclient openProperties \"URL\"\n"
"            # Maakt en Egenschappenmenü op\n"
"\n"

#: kioclient.cpp:57
msgid ""
"  kioclient exec 'url' ['mimetype']\n"
"            # Tries to open the document pointed to by 'url', in the "
"application\n"
"            #   associated with it in KDE. You may omit 'mimetype'.\n"
"            #   In this case the mimetype is determined\n"
"            #   automatically. Of course URL may be the URL of a\n"
"            #   document, or it may be a *.desktop file.\n"
msgstr ""
"  kioclient exec 'URL' ['MIME-Typ']\n"
"            # Versöcht dat un maakt dat Dokment bi \"URL\" mit dat Programm\n"
"            #   op, dat dor in KDE tohöört. Giffst Du keen MIME-Typ an, "
"warrt\n"
"            #   he automaatsch opdeckt. \"URL\" kann op en Dokment, man ok\n"
"            #   op en .desktop-Datei wiesen.\n"

#: kioclient.cpp:63
msgid ""
"  kioclient move 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kioclient move \"Born\" \"Teel\"\n"
"            # Verschufft \"Born\" na \"Teel\".\n"
"            #   \"Born\" dörv en List vun URLs wesen.\n"

#: kioclient.cpp:68
msgid ""
"  kioclient download ['src']\n"
"            # Copies the URL 'src' to a user specified location'.\n"
"            #   'src' may be a list of URLs, if not present then\n"
"            #   a URL will be requested.\n"
"\n"
msgstr ""
"  kioclient download [\"Born\"]\n"
"            # Kopeert dat Dokment bi \"Born\" na en fastleggt\n"
"            #   Steed. \"Born\" dörv en List vun URLs wesen. Is\n"
"            #   keen angeven, warrt na en fraagt.\n"
"\n"

#: kioclient.cpp:72
msgid ""
"  kioclient copy 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"\n"
msgstr ""
"  kioclient copy \"Born\" \"Teel\"'\n"
"            # Kopeert \"Born\" na \"Teel\".\n"
"            #   \"Born\" dörv en List vun URLs wesen.\n"
"\n"

#: kioclient.cpp:75
#| msgid ""
#| "  kioclient openProperties 'url'\n"
#| "            # Opens a properties menu\n"
#| "\n"
msgid ""
"  kioclient cat 'url'\n"
"            # Writes out the contents of 'url' to stdout\n"
"\n"
msgstr ""
"  kioclient cat \"URL\"\n"
"            # Gifft den Inholt vun \"URL\" na de Standardutgaav ut\n"
"\n"

#: kioclient.cpp:78
msgid ""
"*** Examples:\n"
"  kioclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // Mounts the CD-ROM\n"
"\n"
msgstr ""
"*** Bispelen:\n"
"  kioclient exec file:/root/Schriefdisch/cdrom.desktop \"Mount default\"\n"
"            // Hangt de CD-ROM in\n"
"\n"

#: kioclient.cpp:81
msgid ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with default binding\n"
"\n"
msgstr ""
"  kioclient exec file:/home/witt/daten/test.html\n"
"             // Maakt de Datei mit dat Standardprogramm op.\n"
"\n"

#: kioclient.cpp:83
msgid ""
"  kioclient exec file:/home/weis/data/test.html Netscape\n"
"             // Opens the file with netscape\n"
"\n"
msgstr ""
"  kioclient exec file:/home/witt/daten/test.html Netscape\n"
"             // Maakt de Datei mit Netscape op\n"
"\n"

#: kioclient.cpp:85
msgid ""
"  kioclient exec ftp://localhost/\n"
"             // Opens new window with URL\n"
"\n"
msgstr ""
"  kioclient exec ftp://localhost/\n"
"             // Maakt för de angeven URL en nieg Finster op\n"
"\n"

#: kioclient.cpp:87
msgid ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Schriefdisch/emacs.desktop\n"
"             // Röppt Emacs op\n"
"\n"

#: kioclient.cpp:89
msgid ""
"  kioclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Opens the CD-ROM's mount directory\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Schriefdisch/cdrom.desktop\n"
"             // Maakt den Inhangorner vun de CD-ROM op\n"
"\n"

#: kioclient.cpp:91
msgid ""
"  kioclient exec .\n"
"             // Opens the current directory. Very convenient.\n"
"\n"
msgstr ""
"  kioclient exec .\n"
"             // Maakt den aktuellen Orner op. Bannig kommood.\n"
"\n"

#: kioclient.cpp:102
msgid "Non interactive use: no message boxes"
msgstr "Stummbedrief: keen Mellendialogen"

#: kioclient.cpp:104
msgid "url or urls"
msgstr "URL oder URLs"

#: kioclient.cpp:106 kioclient.cpp:109
msgid "Source url or urls"
msgstr "Born-URL oder -URLs"

#: kioclient.cpp:107 kioclient.cpp:110
msgid "Destination url"
msgstr "Teel-URL"

#: kioclient.cpp:112
msgid "Show available commands"
msgstr "Verföögbor Befehlen wiesen"

#: kioclient.cpp:113
msgid "Command (see --commands)"
msgstr "Befehl (kiek bi --commands)"

#: kioclient.cpp:114
msgid "Arguments for command"
msgstr "Argumenten för Befehl"

#: kioclient.cpp:149
msgid "Syntax Error: Not enough arguments\n"
msgstr "Syntax-Fehler: Nich noog Argumenten\n"

#: kioclient.cpp:154
msgid "Syntax Error: Too many arguments\n"
msgstr "Syntax-Fehler: To vele Argumenten\n"

#: kioclient.cpp:284
msgid "Unable to download from an invalid URL."
msgstr "Vun en leeg URL lett sik nix daalladen."

#: kioclient.cpp:322
#, kde-format
msgid "Syntax Error: Unknown command '%1'\n"
msgstr "Syntax-Fehler: Befehl \"%1\" nich begäng\n"

