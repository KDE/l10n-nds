#: main.cpp:60
msgid "solidshell"
msgstr "solidshell"

#: main.cpp:62
msgid ""
"KDE tool for querying and controlling your hardware from the command line"
msgstr "KDE-Konsoolprogramm för't Affragen un Stüern vun Dien Hardware"

#: main.cpp:281
msgid "Syntax Error: Not enough arguments"
msgstr "Syntaxfehler: Nich noog Argumenten"

#: main.cpp:287
msgid "Syntax Error: Too many arguments"
msgstr "Syntaxfehler: To vele Argumenten"

#: main.cpp:299
msgid "Show available commands by domains"
msgstr "Verföögbor Befehlen na Kategorie wiesen"

#: main.cpp:301
msgid "Domain (see --commands)"
msgstr "Kategorie (kiek bi --commands)"

#: main.cpp:303
msgid "Command (see --commands)"
msgstr "Befehl (kiek bi --commands)"

#: main.cpp:305
msgid "Arguments for command"
msgstr "Argumenten för Befehl"

#: main.cpp:317
msgid "Syntax:"
msgstr "Syntax:"

#: main.cpp:320
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # De verföögbore Hardware oplisten\n"
"             # - Is de Optschoon \"nonportableinfo\"             #   "
"angeven, warrt de Reedschapegenschappen\n"
"             #   oplist (beacht: denn hangt de Egenschap-\n"
"             #   naams vun't Hülpprogramm af)\n"
"             # - Is \"details\" angeven, warrt de Reedschap-\n"
"             #   koppelsteden un ehr Egenschappen in en Oort\n"
"             #   oplist, de nich vun't Systeem afhangt.             # - "
"Anners warrt bloots de Reedschap-UDIs oplist.\n"

#: main.cpp:330
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # All Koppelsteden un Egenschappen vun de Reedschap wiesen,\n"
"             # de \"UDI\" tohöört, op en Wies, de nich vun't Systeem "
"afhangt.\n"

#: main.cpp:334
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # All Egenschappen vun de Reedschap wiesen, de \"UDI\" tohöört\n"
"             # (Wohrschau: De Egenschapnaams hangt denn vun dat Hülpprogramm "
"af.)\n"

#: main.cpp:338
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""
"             # De UDI vun de Reedschappen wiesen, op de \"predicate\" passt\n"
"             # - Is \"parentUdi\" angeven, warrt bloots binnen den Telg vun\n"
"             #   de tohören Reedschap söcht, anners warrt all Reedschappen\n"
"             #   dörkeken.\n"

#: main.cpp:344
msgid ""
"             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr ""
"             # Wenn mööglich, de Reedschap inhangen, de \"UDI\" tohöört\n"

#: main.cpp:347
msgid ""
"             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr ""
"             # Wenn mööglich, de Reedschap afhangen, de \"UDI\" tohöört\n"

#: main.cpp:350
msgid ""
"             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr ""
"             # Wenn mööglich, de Reedschap rutfohren, de \"UDI\" tohöört\n"

#: main.cpp:357
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # method supported by the system\n"
"             # - If the 'scheme' option is specified, give the list of\n"
"             # supported power management schemes by this system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policy\n"
msgstr ""
"             # En besünner Sett vun Informatschonen över de Stroomkuntrull "
"wiesen\n"
"             # - Mit \"suspend\" as Optschoon: De List vun dat Systeem sien "
"begäng\n"
"             #   Utsett-Metoden wiesen             # - Mit \"scheme\": De "
"List vun begäng Stroomkuntrull-Profilen wiesen\n"
"             # - Mit \"cpufreq\": De List vun begäng Regeln för de "
"Perzesserfrequenz wiesen\n"

#: main.cpp:366
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'scheme' option is specified, the power management\n"
"             # scheme set corresponds to 'value'\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # Optschonen för de Stroomkuntrull fastleggen\n"
"             # - Mit \"scheme\": Dat Stroomkuntrullprofil anmaken, dat "
"\"value\" tohöört\n"
"             # - Mit \"cpufreq\": De Perzesserfrequenzregel anmaken, de "
"\"value\" tohöört\n"

#: main.cpp:373
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # Den Reekner mit de angeven Metood utsetten laten\n"

#: main.cpp:378
msgid "             # List the network devices present.\n"
msgstr "             # De vörhannen Nettwarkreedschappen oplisten\n"

#: main.cpp:381
msgid ""
"             # List the networks known to the device specified by 'uni'.\n"
msgstr ""
"             # De Nettwarken oplisten, de bi de vun \"UNI\" angeven "
"Reedschap künnig sünd\n"

#: main.cpp:384
msgid ""
"             # Query whether networking features are active or not.\n"
"             # - If the 'status' option is given, return whether\n"
"             # networking is enabled for the system\n"
"             # - If the 'wireless' option is is given, return whether\n"
"             # wireless is enabled for the system\n"
"             # - If the 'interface' option is given, print the\n"
"             # properties of the network interface that 'uni' refers to.\n"
"             # - If the 'network' option is given, print the\n"
"             # properties of the network on 'device-uni' that 'network-uni' "
"refers to.\n"
msgstr ""
"             # Anfragen, wat Nettwarkfunkschonen anmaakt sünd\n"
"             # - Mit \"status\": Utgeven, wat de Nettwarkfunkschonen\n"
"             #   op't Systeem anmaakt sünd\n"
"             # - Mit \"wireless\": Utgeven, wat en Dratloos-Nettwark\n"
"             #   för't Systeem anmaakt is\n"
"             # - Mit \"interface\": De Egenschappen vun de vun \"UNI\"\n"
"             #   angeven Nettwark-Reedschap utgeven\n"
"             # - Mit \"network\": De Egenschappen vun't Nettwark\n"
"             #   \"network-uni\" bi de Reedschap \"device-uni\" utgeven\n"

#: main.cpp:395 main.cpp:398
msgid "             # Enable or disable networking on this system.\n"
msgstr "             # De Nettwarkfunkschonen op't Systeem an- oder utmaken\n"

#: main.cpp:401
#, fuzzy
#| msgid ""
#| "             # Activate the network 'network-uni' on 'device-uni'.\n"
#| "             # Optionally, use WEP128, open-system encryption with hex "
#| "key 'key'. (Hardcoded)             # Where 'authentication' is one of:\n"
#| "             # wep hex64|ascii64|hex128|ascii128|passphrase64|"
#| "passphrase128 'key' [open|shared]\n"
#| "             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
#| "             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
msgid ""
"             # Activate the network 'network-uni' on 'device-uni'.\n"
"             # Optionally, use WEP128, open-system encryption with hex key "
"'key'. (Hardcoded)\n"
"             # Where 'authentication' is one of:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
msgstr ""
"             # Dat Nettwark \"network-uni\" op Reedschap \"device-uni\" "
"anmaken\n"
"             # Du kannst WEP128 bruken, en Apensysteem-Verslöteln mit den "
"Hexadezamaalslötel \"key\" (fast inbuut).             # För de "
"Identiteetprööv (\"authentication\") lett sik een vun disse Weerten bruken:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # \"wpaeap\" is för \"solidshell\" nich begäng\n"

#: main.cpp:411
msgid "             # List bluetooth adapters/interfaces\n"
msgstr "             # Bluetooth-Koorten/-Koppelsteden oplisten\n"

#: main.cpp:414
msgid "             # List bluetooth default adapter/interface\n"
msgstr "             # Standard-Bluetoothkoort/-koppelsteed oplisten\n"

#: main.cpp:417
msgid ""
"             # Query information about the bluetooth adapter/interface with "
"'ubi'\n"
msgstr ""
"             # Informatschonen över de Bluetooth-Koort oder de -Koppelsteed "
"\"UBI\" affragen\n"

#: main.cpp:420
msgid ""
"             # Set the bluetooth adapter name.\n"
"             # Set the bluetooth adapter mode. Where 'value' is one of:\n"
"             # off|connectable|discoverable\n"
msgstr ""
"             # Den Naam för de Bluetooth-Koort fastleggen\n"
"             # De Bedriefoort för de Bluetooth-Koort fastleggen. För \"value"
"\" kannst Du bruken:\n"
"             # \"off\", \"connectable\" oder \"discoverable\"\n"

#: main.cpp:425
msgid "             # Scan for bluetooth remote devices.\n"
msgstr "             # Na feern Bluetooth-Reedschappen kieken\n"

#: main.cpp:428
msgid "             # List configured input deviceses.\n"
msgstr "             # Instellte Ingaavreedschappen oplisten\n"

#: main.cpp:431
msgid ""
"             # Setup bluetooth input device.\n"
"             # Remove configuration of remote input device.\n"
"             # Connect or disconnect bluetooth input device.\n"
msgstr ""
"             # Bluetooth-Ingaavreedschap inrichten\n"
"             # Instellen för feern Ingaavreedschap wegmaken\n"
"             # Bluetooth-Ingaavreedschap to- oder afkoppeln\n"

#: main.cpp:436
msgid ""
"             # Create bonding (pairing) with bluetooth remote device.\n"
"             # Remove bonding of bluetooth remote device.\n"
"             # Check for bonding of bluetooth remote device.\n"
msgstr ""
"             # En feern Bluetooth-Reedschap anbinnen\n"
"             # Anbinnen vun en feern Bluetooth-Reedschap opheven\n"
"             # Anbinnen vun en feern Bluetooth-Reedschap pröven\n"

