#: kdesu.cpp:85
msgid "KDE su"
msgstr "su för KDE"

#: kdesu.cpp:86
msgid "Runs a program with elevated privileges."
msgstr "Föhrt en Programm mit verwiederte Rechten ut."

#: kdesu.cpp:88
msgid "Copyright (c) 1998-2000 Geert Jansen, Pietro Iglio"
msgstr "Copyright (c) 1998-2000 Geert Jansen, Pietro Iglio"

#: kdesu.cpp:89
msgid "Geert Jansen"
msgstr "Geert Jansen"

#: kdesu.cpp:89
msgid "Maintainer"
msgstr "Pleger"

#: kdesu.cpp:91
msgid "Pietro Iglio"
msgstr "Pietro Iglio"

#: kdesu.cpp:91
msgid "Original author"
msgstr "Orginaalautor"

#: kdesu.cpp:99 kdesu.cpp:100
msgid "Specifies the command to run"
msgstr "Befehl, de utföhrt warrn schall"

#: kdesu.cpp:101
msgid "Run command under target uid if <file> is not writable"
msgstr "Befehl ünner disse UID utföhren, wenn <file> sik nich schrieven lett"

#: kdesu.cpp:102
msgid "Specifies the target uid"
msgstr "Gifft de Teel-UID an"

#: kdesu.cpp:103
msgid "Do not keep password"
msgstr "Passwoort nich wohren"

#: kdesu.cpp:104
msgid "Stop the daemon (forgets all passwords)"
msgstr "Den Dämoon anhollen (smitt all Passwöör weg)"

#: kdesu.cpp:105
msgid "Enable terminal output (no password keeping)"
msgstr "Utgaav na't Terminal anmaken (Passwöör nich wohren)"

#: kdesu.cpp:106
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest"
msgstr "Prioriteet fastleggen: 0<= Weert <= 100, 0 is sietst"

#: kdesu.cpp:107
msgid "Use realtime scheduling"
msgstr "Echttietplanen bruken"

#: kdesu.cpp:108
msgid "Let command use existing dcopserver"
msgstr "Befehl schall vörhannen DCOP-Server bruken"

#: kdesu.cpp:110
msgid "Do not display ignore button"
msgstr "\"Övergahn\"-Knoop nich wiesen"

#: kdesu.cpp:111
msgid "Specify icon to use in the password dialog"
msgstr "Lüttbild för Passwoort-Dialoog angeven"

#: kdesu.cpp:112
msgid "Do not show the command to be run in the dialog"
msgstr "Den Befehl nich wiesen, de in den Dialoog utföhrt warrn schall"

#: kdesu.cpp:135
#, kde-format
msgid "Command '%1' not found."
msgstr "Befehl \"%1\" lett sik nich finnen."

#: kdesu.cpp:210
#, kde-format
msgid "Illegal priority: %1"
msgstr "Leeg Prioriteet: %1"

#: kdesu.cpp:241
msgid "No command specified."
msgstr "Keen Befehl utsöcht."

#: kdesu.cpp:343
msgid "Su returned with an error.\n"
msgstr "\"su\" hett en Fehler torüchgeven.\n"

#: kdesu.cpp:366
msgid "Command:"
msgstr "Befehl:"

#: kdesu.cpp:374
msgid "realtime: "
msgstr "Echttiet: "

#: kdesu.cpp:377
msgid "Priority:"
msgstr "Prioriteet:"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

#: sudlg.cpp:23
msgid "Ignore"
msgstr "Övergahn"

#: sudlg.cpp:30
#, kde-format
msgid "Run as %1"
msgstr "As %1 utföhren"

#: sudlg.cpp:34
msgid "Please enter your password below."
msgstr "Giff bitte nerrn Dien Passwoort in."

#: sudlg.cpp:37
msgid ""
"The action you requested needs <b>root privileges</b>. Please enter "
"<b>root's</b> password below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Dien Akschoon bruukt <b>Systeempleger-Rechten</b>. Bitte giff dat "
"<b>Systeempleger</b>-Passwoort nerrn in, oder klick op \"Övergahn\", wenn Du "
"mit Dien aktuelle Rechten wiedermaken wullt."

#: sudlg.cpp:41
#, kde-format
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for <b>%1</b> below or click Ignore to continue with your current "
"privileges."
msgstr ""
"De Akschoon bruukt mehr Rechten. Bitte giff dat Passwoort för <b>%1</b> "
"nerrn in, oder klick op \"Övergahn\", wenn Du mit Dien aktuelle Rechten "
"wiedermaken wullt."

#: sudlg.cpp:50
msgid "&Ignore"
msgstr "Över&gahn"

#: sudlg.cpp:67
msgid "Conversation with su failed."
msgstr "Kommunikatschoon mit \"su\" fehlslaan."

#: sudlg.cpp:74
msgid ""
"The program 'su' could not be found.<br />Ensure your PATH is set correctly."
msgstr ""
"Dat Programm \"su\" lett sik nich finnen.<br />Prööv bitte, wat Dien PATH-"
"Variabel richtig instellt is."

#: sudlg.cpp:85
msgid "Incorrect password, please try again."
msgstr "Dat Passwoort gellt nich, versöök dat man nochmaal."

#: sudlg.cpp:89
msgid "Internal error: illegal return from SuProcess::checkInstall()"
msgstr "Intern Fehler: Leeg Utgaav vun \"SuProcess::checkInstall()\""
