"dh2 = modp1024\n"
"dh5 = modp1536\n"
"d14 = modp2048 (racoon only)\n"
"dh15= modp3072 (racoon only)\n"
"dh16 = modp4096 (racoon only)\n"
"dh17 = modp6144 (racoon only)\n"
