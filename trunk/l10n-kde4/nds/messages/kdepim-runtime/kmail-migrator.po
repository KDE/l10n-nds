#: kmailmigrator.cpp:588
msgctxt "@info"
msgid ""
"<para>Cached IMAP accounts have a local copy of the server's data.</"
"para><para>These copies can either be kept in local folders, or be deleted "
"after import.</para><note>Mail that was not imported will always be kept in "
"local folders.</note>"
msgstr ""
"<para>Twischenspiekert IMAP-Kontos hebbt en lokaal Kopie vun de Serverdaten."
"</para><para>Disse Kopien laat sik in lokaal Ornern wohren oder na't "
"Importeren wegmaken.</para><note>Nich importeert Nettbreven warrt jümmers in "
"lokaal Ornern wohrt.</note>"

