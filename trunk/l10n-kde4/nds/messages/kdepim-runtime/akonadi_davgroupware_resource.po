#: setupwizard.cpp:137
msgid "DAV groupware configuration wizard"
msgstr "Instellenhölper för DAV-Arbeitkoppel"

#: setupwizard.cpp:203
msgid "Login Credentials"
msgstr "Togangdaten"

#: setupwizard.cpp:204
msgid "Enter your credentials to login to the groupware server"
msgstr ""
"Giff hier Dien Togangdaten för't Anmellen op den Arbeitkoppel-Server in"

#: setupwizard.cpp:209
msgid "User"
msgstr "Bruker"

#: setupwizard.cpp:214
msgid "Password"
msgstr "Passwoort"

#: setupwizard.cpp:243
msgid "Predefined provider found"
msgstr "Vörinstellt Anbeder funnen"

#: setupwizard.cpp:244
msgid "Select if you want to use the auto-detected provider"
msgstr "Maak dit an, wenn Du den automaatsch opdeckt Anbeder bruken wullt."

#: setupwizard.cpp:259
msgid "No, choose another server"
msgstr "Nee, en annern Server bruken"

#: setupwizard.cpp:266
#, kde-format
msgid ""
"Based on the email address you used as a login, this wizard\n"
"can configure automatically an account for %1 services.\n"
"Do you wish to do so?"
msgstr ""
"Disse Hölper kann mit de Nettpostadress, mit de Du Di anmeldt\n"
"hest, automaatsch en Konto för %1 inrichten.\n"
"Wullt Du dat doon?"

#: setupwizard.cpp:270
#, kde-format
msgid "Yes, use %1 as provider"
msgstr "Jo, %1 as Anbeder bruken"

#: setupwizard.cpp:297
msgid "Groupware Server"
msgstr "Arbeitkoppel-Server"

#: setupwizard.cpp:298
msgid "Select the groupware server the resource shall be configured for"
msgstr ""
"Söök den Arbeitkoppel-Server ut, för den Du de Ressource instellen wullt."

#: setupwizard.cpp:324
msgid "Use one of those servers:"
msgstr "Een vun disse Servers bruken:"

#: setupwizard.cpp:334
msgid "Configure the resource manually"
msgstr "De Ressource vun Hand instellen"

#: setupwizard.cpp:370
msgid "Connection"
msgstr "Verbinnen"

#: setupwizard.cpp:371
msgid "Enter the connection information for the groupware server"
msgstr "Giff hier de Tokoppeldaten för den Arbeitkoppel-Server in."

#: setupwizard.cpp:379
msgid "Host"
msgstr "Reekner"

#: setupwizard.cpp:382
msgid "Installation path"
msgstr "Installatschoonpadd"

#: setupwizard.cpp:385
msgid "Use secure connection"
msgstr "Seker Verbinnen bruken"

#: setupwizard.cpp:411
msgid "Final URL (CalDav)"
msgstr "Redig Adress (CalDav)"

#: setupwizard.cpp:416
msgid "Final URL (CardDav)"
msgstr "Redig Adress (CardDav)"

#: setupwizard.cpp:421
msgid "Final URL (GroupDav)"
msgstr "Redig Adress (GroupDav)"

#: setupwizard.cpp:478 setupwizard.cpp:484
msgid "Test Connection"
msgstr "Verbinnen utproberen"

#: setupwizard.cpp:479
msgid ""
"You can test now whether the groupware server can be accessed with the "
"current configuration"
msgstr ""
"Hier kannst Du utproberen, wat Du mit disse Instellen Togriep op den Server "
"hest."

#: setupwizard.cpp:525
msgid "An error occurred: "
msgstr "Dat geev en Fehler: "

#: setupwizard.cpp:528
msgid "Connected successfully"
msgstr "Mit Spood tokoppelt"

