#. i18n: file: effects/frei0r_lightgraffiti.xml:4
#. i18n: file: effects/frei0r_lightgraffiti.xml:77
#: rc.cpp:783 rc.cpp:852
msgid "Light Graffiti"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:7
#. i18n: file: effects/frei0r_lightgraffiti.xml:80
#: rc.cpp:785 rc.cpp:854
msgid ""
"Light Graffiti effect.\n"
"        <full><![CDATA[This effect allows to do Light Painting (i.e. "
"painting with light sources on a photo by keeping the shutter\n"
"        opened for a while), but for video.]]></full>"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:10
#. i18n: file: effects/frei0r_lightgraffiti.xml:83
#: rc.cpp:789 rc.cpp:858
msgid "Brightness Threshold"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:12
#. i18n: file: effects/frei0r_lightgraffiti.xml:85
#: rc.cpp:791 rc.cpp:860
msgid ""
"<![CDATA[How bright (<code>R+G+B</code>) does a pixel need to be in order to "
"be recognized as a light source?<br/>\n"
"            Increasing this threshold requires brighter light sources (i.e. "
"more white or less color, respectively) but prevents some «false alarms» "
"where semi-bright parts, e.g. hands where colors can change quite a lot "
"compared to the background, are incorrectly recognized as light source.]]>"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:15
#. i18n: file: effects/frei0r_lightgraffiti.xml:88
#: rc.cpp:794 rc.cpp:863
msgid "Difference Threshold"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:17
#. i18n: file: effects/frei0r_lightgraffiti.xml:90
#: rc.cpp:796 rc.cpp:865
msgid ""
"<![CDATA[How much does the strongest color channel of a pixel have to "
"change, compared to the background image (<code>max(dR, dG, dB)</code>), in "
"order to be recognized as light source? <br/>\n"
"            Increasing this threshold makes it harder for light sources to "
"be accepted on bright backgrounds, but decreases the danger of noise or "
"generally bright spots counting as light source.]]>"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:20
#. i18n: file: effects/frei0r_lightgraffiti.xml:93
#: rc.cpp:799 rc.cpp:868
msgid "Difference Sum Threshold"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:22
#. i18n: file: effects/frei0r_lightgraffiti.xml:95
#: rc.cpp:801 rc.cpp:870
msgid ""
"<![CDATA[How much does the sum of all color channels <em>relative to the "
"background image</em> (<code>dR + dG + dB</code>) have to change until a "
"pixel is recognized as a light source?<br/>\n"
"            Raising this value might, in some cases, avoid that some light "
"objects lit by the light source are added to the light mask.]]>"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:25
#. i18n: file: effects/frei0r_lightgraffiti.xml:98
#: rc.cpp:804 rc.cpp:873
msgid "Sensitivity"
msgstr "Föhlsamkeit"

#. i18n: file: effects/frei0r_lightgraffiti.xml:27
#. i18n: file: effects/frei0r_lightgraffiti.xml:100
#: rc.cpp:806 rc.cpp:875
msgid ""
"<![CDATA[Light sensitivity.<br/>\n"
"            For slowly moving light source try to use a lower sensitivity to "
"obtain a better exposure.]]>"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:30
#. i18n: file: effects/frei0r_lightgraffiti.xml:103
#: rc.cpp:809 rc.cpp:878
msgid "Lower Overexposure"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:32
#. i18n: file: effects/frei0r_lightgraffiti.xml:105
#: rc.cpp:811 rc.cpp:880
msgid ""
"<![CDATA[Lowers overexposure.<br/>\n"
"            The light mask does not get white immediately when the light "
"source is moving slowly or staying steady.]]>"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:35
#. i18n: file: effects/frei0r_lightgraffiti.xml:108
#: rc.cpp:814 rc.cpp:883
msgid "Dimming"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:36
#. i18n: file: effects/frei0r_lightgraffiti.xml:109
#: rc.cpp:816 rc.cpp:885
msgid ""
"Dims the light mask. Lights will leave a fainting trail if it is set to a "
"value > 0."
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:39
#. i18n: file: effects/frei0r_lightgraffiti.xml:112
#: rc.cpp:818 rc.cpp:887
msgid "Background Weight"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:40
#. i18n: file: effects/frei0r_lightgraffiti.xml:113
#: rc.cpp:820 rc.cpp:889
msgid ""
"Strength of the (calculated) background image. Setting it to 100 paints the "
"light mask directly over the background, without the painting person in the "
"image if the video starts with a «clean» background image. (See the α "
"parameter.)"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:43
#. i18n: file: effects/frei0r_lightgraffiti.xml:116
#: rc.cpp:822 rc.cpp:891
msgid "α"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:45
#. i18n: file: effects/frei0r_lightgraffiti.xml:118
#: rc.cpp:824 rc.cpp:893
msgid ""
"<![CDATA[Determines how the effect tries to adapt to background changes. <br/"
">\n"
"            The Light Graffiti effect remembers the first frame of the clip "
"it is applied to, so the clip should <em>always</em> start with the painter "
"outside of the video. If the background constantly changes, e.g. on a "
"street, try to set α > 0 to calculate an average background image.]]>"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:48
#. i18n: file: effects/frei0r_lightgraffiti.xml:121
#. i18n: file: effects/frei0r_saturat0r.xml:3
#. i18n: file: effects/frei0r_saturat0r.xml:7
#: rc.cpp:827 rc.cpp:896 rc.cpp:1043 rc.cpp:1047
