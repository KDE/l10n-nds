#. i18n: file: effects/frei0r_lightgraffiti.xml:49
#. i18n: file: effects/frei0r_lightgraffiti.xml:122
#: rc.cpp:829 rc.cpp:898
msgid "Increases the saturation of lights."
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:52
#. i18n: file: effects/frei0r_lightgraffiti.xml:125
#: rc.cpp:831 rc.cpp:900
msgid "Show brightness statistics"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:54
#. i18n: file: effects/frei0r_lightgraffiti.xml:127
#: rc.cpp:833 rc.cpp:902
msgid ""
"<![CDATA[The stats switches allow easy and accurate adjustment of the "
"threshold parameters.<br/>\n"
"            Example: To adjust the brightness threshold, check this box and "
"adjust the threshold until the whole light source is highlighted. Repeat the "
"same with the other parameters. Only parts that are highlighted in <em>all</"
"em> thresholds will count as light source.]]>"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:57
#. i18n: file: effects/frei0r_lightgraffiti.xml:130
#: rc.cpp:836 rc.cpp:905
