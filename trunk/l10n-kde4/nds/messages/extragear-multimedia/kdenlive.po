#. i18n: file: effects/frei0r_lightgraffiti.xml:67
#. i18n: file: effects/frei0r_lightgraffiti.xml:140
#: rc.cpp:844 rc.cpp:913
msgid "Nonlinear dimming"
msgstr ""

#. i18n: file: effects/frei0r_lightgraffiti.xml:68
#. i18n: file: effects/frei0r_lightgraffiti.xml:141
#: rc.cpp:846 rc.cpp:915
