msgid "Adds a URL to the selected folder"
msgstr "Föögt en URL na den utsöchten Orner to"

#: kplayernodeview.cpp:3319
msgid ""
"Add URL command displays the standard Open URL dialog and lets you type or "
"paste in a URL to add to the selected folder."
msgstr ""
"De Befehl \"URL tofögen\" wiest den normalen \"URL opmaken\"-Dialoog. Dor "
"kannst Du en URL ingeven oder infögen, de Du den utsöchten Orner tofögen "
"wullt."

#: kplayernodeview.cpp:3329
msgid "&New Playlist..."
msgstr "&Nieg Afspeellist..."

