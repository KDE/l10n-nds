msgstr ""
"De Befehl \"Grött op 200%\" sett dat Wiesrebeet sien Grött op dat Dubbelte "
"vun dat Video sien Orginaalgrött."

#: kplayerengine.cpp:706
msgid "Zoom &to 250%"
msgstr "Grött &op 250%"

#: kplayerengine.cpp:708
#, no-c-format
msgid "Scales video to 250% of the original size"
msgstr "Passt dat Video op 250% vun de Orginaalgrött to."

#: kplayerengine.cpp:710
#, no-c-format
