msgid "Adds selected items to the collection"
msgstr "Föögt utsöcht Stücken na de Sammeln to"

#: kplayernodeview.cpp:3347
msgid ""
"Add to collection command adds the selected items to the multimedia "
"collection."
msgstr ""
"De Befehl \"Na Sammeln tofögen\" föögt de utsöchten Stücken na de Multimedia-"
"Sammeln to."

#: kplayernodeview.cpp:3351
msgid "&Rename"
msgstr "Ü&mnömen"

#: kplayernodeview.cpp:3353
msgid "Lets you rename the selected item"
msgstr "Utsöcht Stück ümnömen"

