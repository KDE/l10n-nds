#: kplayerengine.cpp:2112
msgid ""
"*|All files\n"
"*.avi *.AVI|AVI files\n"
"*.mpg *.mpeg *.MPG *.MPEG|MPEG files\n"
"*.ogg *.OGG|OGG files\n"
"*.mp3 *.MP3|MP3 files"
msgstr ""
"*|All Dateien\n"
"*.avi *.AVI|AVI-Dateien\n"
