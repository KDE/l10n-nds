msgstr "De Befehl \"Afspelen\" speelt de utsöchten Stücken af."

#: kplayernodeview.cpp:3293
msgid "Play &Next"
msgstr "&Achteran afspelen"

#: kplayernodeview.cpp:3294
msgid "Plays the selected items after the currently played item"
msgstr "Utsöchte Stücken achteran dat opstunns speelte Stück afspelen"

#: kplayernodeview.cpp:3295
msgid ""
"Play next command plays the selected items after the currently played item "
"finishes playing."
msgstr ""
"De Befehl \"Achteran afspelen\" speelt de utsöchten Stücken achteran dat "
"opstunns speelte Stück af."

#: kplayernodeview.cpp:3299
msgid "&Queue"
msgstr "&Inregen"

#: kplayernodeview.cpp:3300
msgid "Queues the selected items"
msgstr "Utsöchte Stücken inregen"

#: kplayernodeview.cpp:3301
msgid "Queue command queues the selected items for playing."
msgstr "De Befehl \"Inregen\" reegt de utsöchten Stücken na de Töövreeg in."

#: kplayernodeview.cpp:3305
msgid "Queue Ne&xt"
msgstr "A&chteran inregen"

#: kplayernodeview.cpp:3306
msgid "Queues the selected items for playing after the currently played item"
msgstr ""
"Reegt de utsöchten Stücken för't Afspelen achteran dat opstunns speelte "
"Stück in."

#: kplayernodeview.cpp:3307
msgid ""
"Queue next command queues the selected items for playing after the currently "
"played item finishes playing."
msgstr ""
"De Befehl \"Achteran inregen\" reegt de utsöchten Stücken för't Afspelen dor "
"achter in, dat opstunns speelte Stück is afslaten."

