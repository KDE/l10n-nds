#: kplayerengine.cpp:697
msgid "Zoom to &200%"
msgstr "Grött op &200%"

#: kplayerengine.cpp:699
#, no-c-format
msgid "Scales video to 200% of the original size"
msgstr "Passt dat Video op 200% vun de Orginaalgrött to."

#: kplayerengine.cpp:701
#, no-c-format
