#: appletbrowser.cpp:351
msgid ""
"<qt>When clicking <b>Close</b>, this dialog will be closed with no further "
"action taken.</qt>"
msgstr ""
"<qt>Klickst Du op <b>Tomaken</b>, warrt bloots disse Dialoog tomaakt, man "
"nix anners daan.</qt>"

