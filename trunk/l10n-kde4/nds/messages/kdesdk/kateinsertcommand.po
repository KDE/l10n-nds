msgid "&Tools"
msgstr ""

#~ msgid "Insert Command..."
#~ msgstr "Befehl infögen..."

#~ msgid ""
#~ "You are not allowed to execute arbitrary external applications. If you "
#~ "want to be able to do this, contact your system administrator."
#~ msgstr ""
#~ "Du muttst keen externe Programmen utföhren. Wenn Du dit liekers wullt, "
#~ "snack dor bitte Dien Systeempleger op an."

#~ msgid "Access Restrictions"
#~ msgstr "Togriep-Grenzen"

#~ msgid "A process is currently being executed."
#~ msgstr "En Perzess löppt al."

#~ msgid "Could not kill command."
#~ msgstr "Befehl lett sik nich afscheten."

#~ msgid "Kill Failed"
#~ msgstr "Afscheten fehlslaan"

#~ msgid ""
#~ "Executing command:\n"
#~ "%1\n"
#~ "\n"
#~ "Press 'Cancel' to abort."
#~ msgstr ""
#~ "Befehl warrt utföhrt:\n"
#~ "%1\n"
#~ "\n"
#~ "För't Afbreken klick op \"Afbreken\"."

#~ msgid "Command exited with status %1"
#~ msgstr "Befehl mit Status %1 beendt"

#~ msgid "Oops!"
#~ msgstr "Oh-ha!"

#~ msgid "Insert Command"
#~ msgstr "Befehl infögen"

#~ msgid "Enter &command:"
#~ msgstr "&Befehl ingeven:"

#~ msgid "Choose &working folder:"
#~ msgstr "&Arbeitorner utsöken:"

#~ msgid "Insert Std&Err messages"
#~ msgstr "\"Std&Err\"-Mellen infögen"

#~ msgid "&Print command name"
#~ msgstr "Befehl &utgeven"

#~ msgid ""
#~ "Enter the shell command, the output of which you want inserted into your "
#~ "document. Feel free to use a pipe or two if you wish."
#~ msgstr ""
#~ "Giff den Konsoolbefehl in, den sien Utgaav na Dien Dokment inföögt warrn "
#~ "schall. Wenn nödig, bruuk ok en Wiederledden oder twee."

#~ msgid ""
#~ "Sets the working folder of the command. The command executed is 'cd <dir> "
#~ "&& <command>'"
#~ msgstr ""
#~ "Leggt den Arbeitorner vun den Befehl fast. De utföhrte Befehl is \"cd "
#~ "<dir> && <command>\""

#~ msgid ""
#~ "Check this if you want the error output from <command> inserted as well.\n"
#~ "Some commands, such as locate, print everything to STDERR"
#~ msgstr ""
#~ "Maak dit an, wenn Du ok de Fehlerutgaven vun <command> infögen wullt.\n"
#~ "En poor Befehlen, as t.B. \"locate\", geevt allens na \"STDERR\" ut."

#~ msgid ""
#~ "If you check this, the command string will be printed followed by a "
#~ "newline before the output."
#~ msgstr "Wenn Du dit anmaakst, warrt de Befehl vöran sien Utgaav wiest."

#~ msgid "Remember"
#~ msgstr "Wohren"

#~ msgid "Co&mmands"
#~ msgstr "Be&fehlen"

#~ msgid "Start In"
#~ msgstr "Starten in"

#~ msgid "Application &working folder"
#~ msgstr "Programm-&Arbeitorner"

#~ msgid "&Document folder"
#~ msgstr "&Dokmentenorner"

#~ msgid "&Latest used working folder"
#~ msgstr "&Tolest bruukt Arbeitorner"

#~ msgid ""
#~ "Sets the number of commands to remember. The command history is saved "
#~ "over sessions."
#~ msgstr ""
#~ "Leggt de Tall vun Befehlen fast, de wohrt warrn schöölt. De Befehl-"
#~ "Vörgeschicht warrt över Törns wohrt."

#~ msgid ""
#~ "<qt><p>Decides what is suggested as <em>working folder</em> for the "
#~ "command.</p><p><strong>Application Working Folder (default):</strong> The "
#~ "folder from which you launched the application hosting the plugin, "
#~ "usually your home folder.</p><p><strong>Document Folder:</strong> The "
#~ "folder of the document. Used only for local documents.</"
#~ "p><p><strong>Latest Working Folder:</strong> The folder used last time "
#~ "you used this plugin.</p></qt>"
#~ msgstr ""
#~ "<qt><p>Gifft an, wat as <em>Arbeitorner</em> för den Befehl vörslaan "
#~ "warrt.</p><p><strong>Programm-Arbeitorner (Standard):</strong> De Orner, "
#~ "vun den ut Du dat Programm mit dit Moduul opmaakt hest, normaal Dien "
#~ "Tohuus-Orner.</p><p><strong>Dokment-Orner:</strong> De Orner vun dat "
#~ "Dokment. Bloots för lokaal Dokmenten bruukt.</p><p><strong>Tolest bruukt "
#~ "Arbeitorner:</strong> De Orner, den Du tolest mit dit Moduul bruukt hest."
#~ "</p></qt>"

#~ msgid "Configure Insert Command Plugin"
#~ msgstr "Instellen för dat Moduul \"Befehl infögen\""

#~ msgid "Please Wait"
#~ msgstr "Bitte töven"
