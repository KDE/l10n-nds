#: completionmodel.cpp:79 completionmodel.cpp:116
#, kde-format
msgid ""
"<qt>The error <b>%4</b><br /> has been detected in the file %1 at %2/%3</qt>"
msgstr ""
"<qt>De Fehler <b>%4</b><br /> is binnen de Datei %1 bi Positschoon %2/%3 "
"opdukt.</qt>"

#: completionmodel.cpp:84 completionmodel.cpp:121
#, kde-format
msgid "Unable to open %1"
msgstr "%1 lett sik nich opmaken."

#: completionmodel.cpp:89 completionmodel.cpp:126
#, kde-format
msgid "Not a valid snippet file: %1"
msgstr "%1 is keen gellen Snippels-Datei"

#: completionmodel.cpp:199
msgid "Snippets"
msgstr "Snippels"

#: completionmodel.cpp:324
msgid ""
"You have edited a data file not located in your personal data directory, but "
"a suitable filename could not be generated for storing a clone of the file "
"within your personal data directory."
msgstr ""
"Du hest en Datendatei bewerkt, de nich binnen Dien persöönlich Datenorner "
"liggt, man för en Kloonkopie vun de Orginaaldatei na Dien persöönlich "
"Datenorner lett sik keen bruukbor Dateinaam opstellen."

#: completionmodel.cpp:326
msgid ""
"You have edited a data file not located in your personal data directory; as "
"such, a renamed clone of the original data file has been created within your "
"personal data directory."
msgstr ""
"Du hest en Datendatei bewerkt, de nich binnen Dien persöönlich Datenorner "
"liggt. Dorwegen wöör vun de Orginaaldatei binnen Dien persöönlich Datenorner "
"en Kloonkopie mit den sülven Naam opstellt."

#: completionmodel.cpp:332 completionmodel.cpp:368
#, kde-format
msgid "Output file '%1' could not be opened for writing"
msgstr "Utgaavdatei »%1« lett sik nich schrieven."

#: completionmodel.cpp:362
msgid ""
"It was not possible to create a unique file name for the given snippet "
"collection name"
msgstr ""
"För den angeven Snippels-Sammeln-Naam leet sik keen eenkennig Dateinaam "
"opstellen."

#: completionmodel.cpp:486
msgid "New Snippet"
msgstr "Nieg Snippel"

#. i18n: file: snippet_repository.ui:17
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:3
msgid "Snippet Repository:"
msgstr "Snippels-Archiev:"

#. i18n: file: snippet_repository.ui:27
#. i18n: ectx: property (text), widget (KPushButton, btnNew)
#: rc.cpp:6
msgid "New Snippet File..."
msgstr "Nieg Snippels-Datei..."

#. i18n: file: snippet_repository.ui:34
#. i18n: ectx: property (text), widget (KPushButton, btnGHNS)
#: rc.cpp:9
msgid "Get New Snippets..."
msgstr "Niege Snippels halen..."

#. i18n: file: snippet_repository.ui:46
#. i18n: ectx: property (text), widget (KPushButton, btnCopy)
#: rc.cpp:12
msgid "Copy to repository"
msgstr "Na't Archiv koperen"

#: repository.cpp:160
#, kde-format
msgid ""
"%1 (%2)\n"
"license: %3, authors: %4"
msgstr ""
"%1 (%2)\n"
"Verlööfnis: %3, Schrievers: %4"

#: repository.cpp:290
#, kde-format
msgid ""
"Do you really want to delete the file '%1' from the repository? This action "
"is irreversible."
msgstr ""
"Wullt Du de Datei »%1« redig ut dat Archiev wegdoon? - Disse Akschoon lett "
"sik nich torüchdreihen."

#: repository.cpp:291
msgid "Deleting snippet file"
msgstr "Snippels-Datei warrt wegdaan"

#: repository.cpp:300
#, kde-format
msgid ""
"Editor application for file '%1' with mimetype 'application/x-"
"katesnippets_tng' could not be started"
msgstr ""
"För de Datei \"%1\" mit den MIME-Typ »application/x-katesnippets_tng« lett "
"sik keen Editor opmaken."

#: repository.cpp:313
msgid ""
"Editor application for new file with mimetype 'application/x-"
"katesnippets_tng' could not be started"
msgstr ""
"För de niege Datei mit den MIME-Typ »application/x-katesnippets_tng« lett "
"sik keen Editor opmaken."

#: repository.cpp:322
msgid "No file specified"
msgstr "Keen Datei angeven."

#: repository.cpp:341
msgid "It was not possible to create a unique file name for the imported file"
msgstr "För de importeert Datei leet sik keen eenkennig Dateinaam opstellen."

#: repository.cpp:344
msgid "Imported file has been renamed because of a name conflict"
msgstr "Importeert Datei wöör vunwegen en Naamkonflikt ümnöömt."

#: repository.cpp:351
msgid "File could not be copied to repository"
msgstr "Datei lett sik nich na dat Archiev koperen."
