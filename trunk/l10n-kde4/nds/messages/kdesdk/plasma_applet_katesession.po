#: katesessionapplet.cpp:98
msgid "Start Kate (no arguments)"
msgstr "Kate opropen (keen Argumenten)"

#: katesessionapplet.cpp:104
msgid "New Kate Session"
msgstr "Nieg Kate-Törn"

#: katesessionapplet.cpp:110
msgid "New Anonymous Session"
msgstr "Nieg anonüm Törn"

#: katesessionapplet.cpp:141
msgid "Session Name"
msgstr "Törnnaam"

#: katesessionapplet.cpp:142
msgid "Please enter a name for the new session"
msgstr "Bitte en Naam för den niegen Törn ingeven"

#: katesessionapplet.cpp:149
msgid ""
"An unnamed session will not be saved automatically. Do you want to create "
"such a session?"
msgstr ""
"En Törn ahn Naam warrt nich automaatsch sekert. Wullt Du so en Törn "
"opstellen?"

#: katesessionapplet.cpp:151
msgid "Create anonymous session?"
msgstr "Anonüm Törn opstellen?"

#: katesessionapplet.cpp:158
#, kde-format
msgid "You already have a session named %1. Do you want to open that session?"
msgstr "Du hest al en Törn mit den Naam \"%1\". Wullt Du den opmaken?"

#: katesessionapplet.cpp:159
msgid "Session exists"
msgstr "Gifft Törn al"
