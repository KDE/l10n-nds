#. i18n: file: welcomepage.ui:26
#. i18n: ectx: property (text), widget (QLabel, firstLabel)
#: rc.cpp:78
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-size:10pt;\">With this "
"dialog you are going to magically package your new  creation.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-size:10pt;\">You can "
"create the package just choosing the elements to be inserted in.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-size:10pt;\">If you are "
"going to use a custom license, please</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-size:10pt;\">remember "
"to add a file called '<span style=\" font-weight:600;\">COPYING</span>'  in "
"the top level of the directory you are going to package.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-size:10pt;\">Choose now "
"if you want to <span style=\" font-style:italic;\">upload</span> or just "
"<span style=\" font-style:italic;\">create</span> it!</p></body></html>"
msgstr ""

