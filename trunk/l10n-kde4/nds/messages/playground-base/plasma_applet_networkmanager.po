#: networkmanager.cpp:77
msgid ""
"The Network Manager data engine could not be loaded.  Please check to ensure "
"it is installed."
msgstr ""
"De Nettwarkpleger-Datenkarn lett sik nich laden. Bitte stell seker, dat de "
"installeert is."

#: networkmanager.cpp:83
msgid ""
"Solid could not determine your connection status.  Ensure that you have a "
"network backend installed."
msgstr ""
"\"Solid\" kann Dien Tokoppelstatus nich rutfinnen. Bitte prööv, wat Du en "
"Nettwark-Böversiet installeert hest."

#: networkmanager.cpp:89
msgid ""
"Network Manager could not determine your connection status.  Check that the "
"networkmanager data engine is installed."
msgstr ""
"De Nettwarkpleger kann Dien Tokoppelstatus nich rutfinnen. Bitte prööv, wat "
"de Nettwarkpleger-Datenkarn installeert is."

