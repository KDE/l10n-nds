#: javascriptcompletionmodel.cpp:159
msgctxt "@info The description for the 'helper' object"
msgid "The <emphasis>helper</emphasis> object contains some useful functions."
msgstr ""

#: javascriptcompletionmodel.cpp:164
msgctxt "@info The description for the 'timetableData' object"
msgid ""
"The <emphasis>timetableData</emphasis> object is used to put parsed "
"timetable data into it.<nl/><note>Once all data is stored inside "
"<emphasis>timetableData</emphasis> you can call <emphasis>result.addData()</"
"emphasis>.</note>"
msgstr ""

#: javascriptcompletionmodel.cpp:171
msgctxt "@info The description for the 'result' object"
msgid ""
"The result object is used to store all parsed departure/arrival/journey "
"items. Call <emphasis>result.addData( timetableData )</emphasis> to add the "
"current item to the result set."
msgstr ""

#: javascriptcompletionmodel.cpp:218
msgctxt "@info The description for the 'usedTimetableInformations' function"
msgid ""
"Should be implemented to tell which features the script supports.<nl/>This "
"function is called by the data engine."
msgstr ""

#: javascriptcompletionmodel.cpp:236
msgctxt "@info The description for the 'parseTimetable' function"
msgid ""
"Parses departure/arrival documents.<nl/>This function is called by the data "
"engine. The parameter contains the contents of the document body. Found "
"departures/arrivals can be handed over to the data engine like this:<nl/"
"><icode>  // First clear the old data</icode><nl/><icode>  timetableData."
"clear();</icode><nl/><icode>  // Then set all read values</icode><nl/"
"><icode>  timetableData.set( 'TransportLine', '603' );</icode><nl/><icode>  "
"timetableData.set( 'TypeOfVehicle', 'bus' );</icode><nl/><icode>  "
"timetableData.set( 'Target', 'Samplestreet' );</icode><nl/><icode>  "
"timetableData.set( 'DepartureHour', 10 );</icode><nl/><icode>  timetableData."
"set( 'DepartureMinute', 23 );</icode><nl/><icode>  timetableData.set( "
"'Delay', 4 );</icode><nl/><icode>  // Add timetable data to the result set</"
"icode><nl/><icode>  result.addData( timetableData );</icode><nl/><nl/"
"><note>You <emphasis>can</emphasis> return a string array with keywords that "
"affect all departures/arrivals. Currently only one such keyword is "
"supported: <emphasis>'no delays'</emphasis>, used to indicate that there is "
"no delay information for the given stop. The data engine can then use a "
"higher timeout for the next data update. When delay information is available "
"updates are done more often, because delays may change.</note>"
msgstr ""

#: javascriptcompletionmodel.cpp:295
msgctxt "@info The description for the 'parseJourneys' function"
msgid ""
"Parses journey documents.<nl/>This function is called by the data engine. "
"The parameter contains the contents of the document body. Found journeys can "
"be handed over to the data engine like this:<nl/><icode>  // First clear the "
"old data</icode><nl/><icode>  timetableData.clear();</icode><nl/><icode>  // "
"Then set all read values</icode><nl/><icode>  timetableData.set( "
"'StartStopName', 'A' );</icode><nl/><icode>  timetableData.set( "
"'TargetStopName', 'B' );</icode><nl/><icode>  timetableData.set( "
"'DepartureHour', 10 );</icode><nl/><icode>  timetableData.set( "
"'DepartureMinute', 23 );</icode><nl/><icode>  timetableData.set( "
"'ArrivalHour', 11 );</icode><nl/><icode>  timetableData.set( "
"'ArrivalMinute', 05 );</icode><nl/><icode>  timetableData.set( 'Changes', 3 "
");</icode><nl/><icode>  timetableData.set( 'Pricing', '2,30 €' );</icode><nl/"
"><icode>  // Add timetable data to the result set</icode><nl/><icode>  "
"result.addData( timetableData );</icode>"
msgstr ""

#: javascriptcompletionmodel.cpp:324
msgctxt "@info The description for the 'parsePossibleStops' function"
msgid ""
"Parses stop suggestion documents.<nl/>This function is called by the data "
"engine. The parameter contains the contents of the document body. Found stop "
"data can be handed over to the data engine like this:<nl/><icode>  // First "
"clear the old data</icode><nl/><icode>  timetableData.clear();</icode><nl/"
"><icode>  // Then set all read values</icode><nl/><icode>  timetableData.set"
"( 'StopName', 'Bremen Hbf' );</icode><nl/><icode>  // Add timetable data to "
"the result set</icode><nl/><icode>  result.addData( timetableData );</icode>"
msgstr ""

#: javascriptcompletionmodel.cpp:346
msgctxt "@info The description for the 'getUrlForLaterJourneyResults' function"
msgid ""
"Parses a journey document for a link to a journey document containing later "
"journeys.<nl/>This function is called by the data engine. The parameter "
"contains the contents of the document body. The found link can be simply "
"returned. If no link could be found, return null."
msgstr ""

#: javascriptcompletionmodel.cpp:362
msgctxt ""
"@info The description for the 'getUrlForDetailedJourneyResults' function"
msgid ""
"Parses a journey document for a link to another journey document containing "
"more details about journeys.<nl/>This function is called by the data engine. "
"The parameter contains the contents of the document body. The found link can "
"be simply returned. If no link could be found, return null."
msgstr ""

#: javascriptcompletionmodel.cpp:380
msgctxt "@info The description for the 'extractBlock' function"
msgid ""
"Extracts the first block in the given string, that begins with "
"<placeholder>begin</placeholder> and ends with <placeholder>end</"
"placeholder>. Returns the found block or an empty string if the block "
"couldn't be found."
msgstr ""

#: javascriptcompletionmodel.cpp:387
msgctxt "@info The description for the 'stripTags' function"
msgid "Strips all tags from a given string and returns the result."
msgstr ""

#: javascriptcompletionmodel.cpp:391
msgctxt "@info The description for the 'trim' function"
msgid "Trims a string and returns the result."
msgstr ""

#: javascriptcompletionmodel.cpp:396
msgctxt "@info The description for the 'matchTime' function"
msgid ""
"Searches for a time with the given <emphasis>format</emphasis> in the given "
"<emphasis>time</emphasis> string. Returns an integer array with two "
"integers: The first one is the hour part, the second one the minute part."
msgstr ""

#: javascriptcompletionmodel.cpp:404
msgctxt "@info The description for the 'matchDate' function"
msgid ""
"Searches for a date with the given <emphasis>format</emphasis> in the given "
"<emphasis>date</emphasis> string. Returns an integer array with three "
"integers: The first one is the year part, the second one the month part and "
"the third one the day part."
msgstr ""

#: javascriptcompletionmodel.cpp:412
msgctxt "@info The description for the 'formatTime' function"
msgid ""
"Formats a time given by it's <emphasis>hour</emphasis> and <emphasis>minute</"
"emphasis> using the given <emphasis>format</emphasis>."
msgstr ""

#: javascriptcompletionmodel.cpp:418
msgctxt "@info The description for the 'duration' function"
msgid ""
"Computes the duration in minutes between the two times, given as strings. "
"The time strings are parsed using the given <emphasis>format</emphasis>."
msgstr ""

#: javascriptcompletionmodel.cpp:424
msgctxt "@info The description for the 'addMinsToTime' function"
msgid ""
"Adds <emphasis>minsToAdd</emphasis> minutes to the <emphasis>time</emphasis> "
"given as a string. The time string is parsed using the given "
"<emphasis>format</emphasis>. Returns a time string formatted using the given "
"<emphasis>format</emphasis>"
msgstr ""

#: javascriptcompletionmodel.cpp:432
msgctxt "@info The description for the 'addDaysToDate' function"
msgid ""
"Adds <emphasis>daysToAdd</emphasis> days to the <emphasis>date</emphasis> "
"given as an integer array (with three integers: year, month, day). Returns "
"an integer array with the new values"
msgstr ""

#: javascriptcompletionmodel.cpp:439
msgctxt "@info The description for the 'splitSkipEmptyParts' function"
msgid ""
"Splits the given <emphasis>string</emphasis> using the given "
"<emphasis>separator</emphasis>. Returns an array of strings."
msgstr ""

#: javascriptcompletionmodel.cpp:445
msgctxt "@info The description for the 'error' function"
msgid ""
"Logs the error message with the given data string, eg. the HTML code where "
"parsing failed. The message gets also send to stdout with a short version of "
"the data."
msgstr ""

