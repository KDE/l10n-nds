msgstr ""

#: javascriptcompletionmodel.cpp:462
msgctxt "@info The description for the 'RouteStops' info"
msgid ""
"A list of stops of the departure/arrival to it's destination stop or a list "
"of stops of the journey from it's start to it's destination stop.<nl/>If "
"<emphasis>RouteStops</emphasis> and <emphasis>RouteTimes</emphasis> are both "
"set, they should contain the same number of elements. And elements with "
"equal indices should be associated (the times at which the vehicle is at the "
"stops).<nl/><note>For journeys <emphasis>RouteTimesDeparture</emphasis> and "
"<emphasis>RouteTimesArrival</emphasis> should be used instead of "
"<emphasis>RouteTimes</emphasis>.</note>"
msgstr ""

#: javascriptcompletionmodel.cpp:474
msgctxt "@info The description for the 'RouteTimes' info"
msgid ""
"A list of times of the departure/arrival to it's destination stop.<nl/>If "
"<emphasis>RouteStops</emphasis> and <emphasis>RouteTimes</emphasis> are both "
"set, they should contain the same number of elements. And elements with "
"equal indices should be associated (the times at which the vehicle is at the "
"stops)."
msgstr ""

#: javascriptcompletionmodel.cpp:485
msgctxt "@info The description for the 'RouteTimesDeparture' info"
msgid ""
"A list of departure times of the journey.<nl/>If <emphasis>RouteStops</"
"emphasis> and <emphasis>RouteTimesDeparture</emphasis> are both set, the "
"latter should contain one element less (because the last stop has no "
"departure, only an arrival time). Elements with equal indices should be "
"associated (the times at which the vehicle departs from the stops)."
msgstr ""

#: javascriptcompletionmodel.cpp:494
msgctxt "@info The description for the 'RouteTimesArrival' info"
msgid ""
"A list of arrival times of the journey.<nl/>If <emphasis>RouteStops</"
"emphasis> and <emphasis>RouteTimesArrival</emphasis> are both set, the "
"latter should contain one element less (because the first stop has no "
"arrival, only a departure time). Elements with equal indices should be "
"associated (the times at which the vehicle arrives at the stops)."
msgstr ""

#: javascriptcompletionmodel.cpp:502
msgctxt "@info The description for the 'RouteExactStops' info"
msgid ""
"The number of exact route stops.<nl/>The route stop list in "
"<emphasis>RouteStops</emphasis> is not complete from the last exact route "
"stop."
msgstr ""

#: javascriptcompletionmodel.cpp:508
msgctxt "@info The description for the 'RouteTypesOfVehicles' info"
msgid "The types of vehicles used for each 'sub-journey' of a journey."
msgstr ""

#: javascriptcompletionmodel.cpp:513
msgctxt "@info The description for the 'RouteTransportLines' info"
msgid "The transport lines used for each 'sub-journey' of a journey."
msgstr ""

#: javascriptcompletionmodel.cpp:518
msgctxt "@info The description for the 'RoutePlatformsDeparture' info"
msgid ""
"The platforms of departures used for each 'sub-journey' of a journey.<nl/>If "
"<emphasis>RouteStops</emphasis> and <emphasis>RoutePlatformsDeparture</"
"emphasis> are both set, the latter should contain one element less (because "
"the last stop has no departure, only an arrival platform). Elements with "
"equal indices should be associated (the platforms from which the vehicle "
"departs from the stops)."
msgstr ""

#: javascriptcompletionmodel.cpp:528
msgctxt "@info The description for the 'RoutePlatformsArrival' info"
msgid ""
"The platforms of arrivals used for each 'sub-journey' of a journey.<nl/>If "
"<emphasis>RouteStops</emphasis> and <emphasis>RoutePlatformsArrival</"
"emphasis> are both set, the latter should contain one element less (because "
"the first stop has no arrival, only a departure platform). Elements with "
"equal indices should be associated (the platforms at which the vehicle "
"arrives at the stops)"
msgstr ""

#: javascriptcompletionmodel.cpp:538
msgctxt "@info The description for the 'RouteTimesDepartureDelay' info"
msgid ""
"A list of delays in minutes for each departure time of a route (see "
"<emphasis>RouteTimesDeparture</emphasis>).<nl/>If set it should contain the "
"same number of elements as 'RouteTimesDeparture'."
msgstr ""

#: javascriptcompletionmodel.cpp:545
msgctxt "@info The description for the 'RouteTimesArrivalDelay' info"
msgid ""
"A list of delays in minutes for each arrival time of a route (see "
"<emphasis>RouteTimesArrival</emphasis>).<nl/>If set it should contain the "
"same number of elements as 'RouteTimesArrival'."
msgstr ""

