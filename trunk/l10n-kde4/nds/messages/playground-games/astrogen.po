#. i18n: file: designer.ui:13
#. i18n: ectx: property (windowTitle), widget (QWidget, Designer)
#: rc.cpp:3
msgid "Asteroid Designer"
msgstr "Asteroiden-Smeed"

#. i18n: file: designer.ui:49
#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: rc.cpp:6
msgid "General Options"
msgstr "Allmeen Optschonen"

#. i18n: file: designer.ui:55
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:9
msgid "Detail level:"
msgstr "Enkelheitenstoop:"

#. i18n: file: designer.ui:69
#. i18n: ectx: property (text), widget (QLabel, label_5)
#: rc.cpp:12
msgid "Random seed:"
msgstr "Tofälligkeit-Spraat:"

#. i18n: file: designer.ui:89
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: rc.cpp:15
msgid "Randomization"
msgstr "Vertofälligen"

#. i18n: file: designer.ui:95
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:18
msgid "Initial randomness:"
msgstr "Eerst Tofälligkeit:"

#. i18n: file: designer.ui:103
#. i18n: ectx: property (toolTip), widget (QDoubleSpinBox, randomInitial)
#: rc.cpp:21
msgid ""
"How much to initially randomize asteroid's shape.\n"
"This determines how distorted asteroids general shape will be."
msgstr ""
"Gifft an, wo veel Tofälligkeit bi't Opstellen vun den Asteroiden bruukt "
"warrt.\n"
"Leggt fast, wo dull verdreiht de Asteroiden utseht."

#. i18n: file: designer.ui:119
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:25
msgid "Damping:"
msgstr "Dämpen:"

#. i18n: file: designer.ui:127
#. i18n: ectx: property (toolTip), widget (QDoubleSpinBox, randomDamping)
#: rc.cpp:28
msgid ""
"How much to decrease randomization after each detailing pass.\n"
"Lower values lead to more \"noisy\" surface."
msgstr ""
"Leggt den Bedrag fast, üm den de Tofälligkeit bi elkeen Enkelheiten-Dörgang "
"daalsett warrt.\n"
"Sieter Weerten föhrt to en ruger Böversiet."

#. i18n: file: designer.ui:140
#. i18n: ectx: property (text), widget (QLabel, label_4)
#: rc.cpp:32
msgid "Post-randomness:"
msgstr "Na-Tofälligkeit:"

#. i18n: file: designer.ui:148
#. i18n: ectx: property (toolTip), widget (QDoubleSpinBox, randomPost)
#: rc.cpp:35
msgid ""
"Final randomization to apply after all vertices are created.\n"
"Use small non-zero values to apply some fine surface noise."
msgstr ""
"De Vertofälligen, de na't Opstellen vun all Öörd bruukt warrt.\n"
"Bruuk lütte Weerten dicht bi Null, wenn Du fien Böversietstrukturen hebben "
"wullt."

#. i18n: file: designer.ui:161
#. i18n: ectx: property (text), widget (QLabel, label_6)
#: rc.cpp:39
msgid "Starting value:"
msgstr "Anfangweert:"

#. i18n: file: designer.ui:168
#. i18n: ectx: property (text), widget (QLabel, label_7)
#: rc.cpp:42
msgid "Iterative randomization:"
msgstr "Wedderhaal-Vertofälligen:"

#. i18n: file: designer.ui:176
#. i18n: ectx: property (toolTip), widget (QDoubleSpinBox, randomIterative)
#: rc.cpp:45
msgid ""
"Initial randomization amount for detail passes.\n"
"Higher values will lead to more surface detail."
msgstr ""
"Eerst Vertofälligen bi Enkelheiten-Dörgäng.\n"
"Höger Weerten föhrt to mehr Böversiet-Enkelheiten."

#. i18n: file: designer.ui:195
#. i18n: ectx: property (text), widget (QPushButton, updateButton)
#: rc.cpp:49
msgid "Update model"
msgstr "Modell opfrischen"

#. i18n: file: designer.ui:221
#. i18n: ectx: property (text), widget (QPushButton, saveButton)
#: rc.cpp:52
msgid "Save"
msgstr "Sekern"
