#. i18n: tag string
#. i18n: file ./ktorrent/advancedpref.ui line 193
#: rc.cpp:983 rc.cpp:999
msgid " ms"
msgstr " ms"

#. i18n: tag string
#. i18n: file ./ktorrent/advancedpref.ui line 176
#: rc.cpp:986
msgid "Network sleep interval:"
msgstr "Nettwark-Slaaptiet:"

#. i18n: tag string
#. i18n: file ./ktorrent/advancedpref.ui line 190
#: rc.cpp:989
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-size:9pt;\">Amount of "
"time the network threads will sleep when they are speed limited. This has "
"absolutely no effect when there are no speed limits.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-"
"size:9pt;\"></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-size:9pt;\"><span style="
"\" font-weight:600;\">Note:</span> The lower this is the more CPU is used. "
"Setting it high can lead to lower speeds in high bandwith situations. </p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-"
"size:9pt;\"></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-size:9pt;\">For example "
"on an 100 Mbit LAN, if you set a limit of 3000 KB/s, you might not actually "
"reach this speed when this value is too high. Without a limit you can easily "
"get above 3000 KB/s on a LAN.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">De Tiet, wo lang de "
"Nettwark-Opgaven slaapt, wenn dat en Gauheitgrenz gifft. Gifft dat keen, "
"deit disse Instellen rein weg nix.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Henwies:</span> De sieter disse Weert is, de grötter is de CPU-"
"Last. Settst Du em hooch, mag dat Dien Gauheit daaldrieven, wenn veel "
"Bandbreed praatsteiht.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Bi en LAN mit 100 MBit un "
"en Grenz vun 3000 kB/s langst Du villicht gor nich bi disse Gauheit an, wenn "
"disse Weert to hooch is. Hest Du keen Grenz instellt, kann de Gauheit binnen "
"dat LAN licht höger warrn as 3000 kB/s.</p></body></html>"

