#: kwlaninterface.cpp:97
#, kde-format
msgid ""
"Could not find wpa_supplicant binary. Without it, Kwlan cannot connect to "
"encrypted networks.\n"
"Please check your wpa_supplicant installation."
msgstr ""
"Dat Programm \"wpa_supplicant\" lett sik nich finnen. Ahn dit Programm kann "
