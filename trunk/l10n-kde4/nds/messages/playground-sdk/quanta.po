#: rc.cpp:764 rc.cpp:833
msgid "Comma-separated list of the area borders"
msgstr "Mit Kommas scheedt List vun Rebeetgrenzen"

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1142
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel20)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1257
#. i18n: ectx: property (whatsThis), widget (KLineEdit, areaBordersEdit)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1142
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel20)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1257
#. i18n: ectx: property (whatsThis), widget (KLineEdit, areaBordersEdit)
#: rc.cpp:768 rc.cpp:837
#, no-c-format
msgid ""
"Comma-separated list of the area borders encapsulating this pseudo DTEP. In "
"the case of PHP it is:<br>\n"
"<b>&lt;?&nbsp;?&gt;,&nbsp;&lt;*&nbsp;*&gt;,&nbsp;&lt;%&nbsp;%&gt;</b>"
msgstr ""
"Mit Kommas scheedt List vun Rebeetgrenzen, de dit Pseudo-DTBP insluten. Bi "
"PHP is dat:<br>\n"
"<b>&lt;?&nbsp;?&gt;,&nbsp;&lt;*&nbsp;*&gt;,&nbsp;&lt;%&nbsp;%&gt;</b>"

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1145
#. i18n: ectx: property (text), widget (QLabel, textLabel20)
#: rc.cpp:772
msgid "Area borders:"
msgstr "Rebeetgrenzen:"

