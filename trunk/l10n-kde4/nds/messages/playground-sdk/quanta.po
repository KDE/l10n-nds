#. i18n: ectx: property (toolTip), widget (QLabel, textLabel24)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1290
#. i18n: ectx: property (toolTip), widget (KLineEdit, structBeginEdit)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1187
#. i18n: ectx: property (toolTip), widget (QLabel, textLabel24)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1290
#. i18n: ectx: property (toolTip), widget (KLineEdit, structBeginEdit)
#: rc.cpp:793 rc.cpp:856
msgid "A string specifying the beginning of a structure"
msgstr "En Tekenkeed, de den Anfang vun en Struktuur angifft"

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1190
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel24)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1293
#. i18n: ectx: property (whatsThis), widget (KLineEdit, structBeginEdit)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1190
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel24)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1293
#. i18n: ectx: property (whatsThis), widget (KLineEdit, structBeginEdit)
#: rc.cpp:796 rc.cpp:859
msgid ""
"A string specifying the beginning of a structure, like <b>{</b> in many "
"cases."
msgstr ""
"En Tekenkeed, de den Anfang vun en Struktuur angifft, liek faken <b>{</b>."

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1193
#. i18n: ectx: property (text), widget (QLabel, textLabel24)
#: rc.cpp:799
msgid "Structure beginning:"
msgstr "Struktuur-Anfang:"

