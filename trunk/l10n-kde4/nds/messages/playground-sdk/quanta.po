#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:857
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel13)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1411
#. i18n: ectx: property (whatsThis), widget (KLineEdit, commentsEdit)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:857
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel13)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1411
#. i18n: ectx: property (whatsThis), widget (KLineEdit, commentsEdit)
#: rc.cpp:647 rc.cpp:916
msgid ""
"Comma-separated list of area borders for comments. <i>EOL</i> means end of "
"line, used for single line comments.<br>\n"
"Example: <b>//&nbsp;EOL,&nbsp;/*&nbsp;*/</b>"
msgstr ""
"Mit Kommas scheedt List vun Rebeetgrenzen för Kommentaren. <i>EOL</i> "
"bedüüdt Reeg-Enn, warrt för Enkelreegkommentaren bruukt.<br>\n"
"Bispill: <b>//&nbsp;EOL,&nbsp;/*&nbsp;*/</b>"

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:860
#. i18n: ectx: property (text), widget (QLabel, textLabel13)
#: rc.cpp:651
msgid "Comments:"
msgstr "Kommentaren:"

