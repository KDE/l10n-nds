msgid "Regular expression to find what belong to this group"
msgstr "Reguleer Utdruck, mit den söcht warrt, wat den Koppel tohöört"

#. i18n: file: UNPORTED/quantacore/dialogs/dtepstructureeditdlgs.ui:300
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel35)
#. i18n: file: UNPORTED/quantacore/dialogs/dtepstructureeditdlgs.ui:557
