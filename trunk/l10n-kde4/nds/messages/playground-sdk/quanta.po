#. i18n: ectx: property (toolTip), widget (QLabel, textLabel22)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1229
#. i18n: ectx: property (toolTip), widget (KLineEdit, structKeywordsEdit)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1155
#. i18n: ectx: property (toolTip), widget (QLabel, textLabel22)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1229
#. i18n: ectx: property (toolTip), widget (KLineEdit, structKeywordsEdit)
#: rc.cpp:775 rc.cpp:817
msgid "Comma-separated list of structure keywords"
msgstr "Mit Kommas scheedt List vun Struktuur-Slötelwöör"

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1158
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel22)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1232
#. i18n: ectx: property (whatsThis), widget (KLineEdit, structKeywordsEdit)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1158
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel22)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1232
#. i18n: ectx: property (whatsThis), widget (KLineEdit, structKeywordsEdit)
#: rc.cpp:778 rc.cpp:820
msgid ""
"Comma-separated list of structure keywords. The keywords used here are used "
"to create new node (nodes for structures) in the structure tree, like for a "
"function, class or if block."
msgstr ""
"Mit Kommas scheedt List vun Struktuur-Slötelwöör. Disse Slötelwöör warrt "
"hier för't Opstellen vun en nieg Knütt (Struktuurknütten) binnen den "
"Struktuurboom bruukt, a.B. för en Funkschoon, Klass oder \"IF\"-Block."

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1161
#. i18n: ectx: property (text), widget (QLabel, textLabel22)
#: rc.cpp:781
msgid "Structure keywords:"
msgstr "Struktuur-Slötelwöör:"

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1171
#. i18n: ectx: property (toolTip), widget (QLabel, textLabel26)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1374
#. i18n: ectx: property (toolTip), widget (KLineEdit, structRxEdit)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1171
#. i18n: ectx: property (toolTip), widget (QLabel, textLabel26)
