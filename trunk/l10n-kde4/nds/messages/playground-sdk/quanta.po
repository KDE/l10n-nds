#. i18n: ectx: property (toolTip), widget (KLineEdit, structRxEdit)
#: rc.cpp:784 rc.cpp:898
msgid "Regular expression that finds the beginning or end of a structure"
msgstr "Reguleer Utdruck, de Anfang un Enn vun en Struktuur söcht"

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1174
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel26)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1377
#. i18n: ectx: property (whatsThis), widget (KLineEdit, structRxEdit)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1174
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel26)
#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1377
#. i18n: ectx: property (whatsThis), widget (KLineEdit, structRxEdit)
#: rc.cpp:787 rc.cpp:901
msgid ""
"Regular expression that finds the beginning or end of a structure. This is "
"usually the combination of <b>Structure beginning</b> and <b>Structure end</"
"b>, like <b>\\\\{&nbsp;|&nbsp;\\\\}</b>"
msgstr ""
"Reguleer Utdruck, de Anfang un Enn vun en Struktuur söcht. Dit is "
"normalerwies en Mischen ut <b>Struktuuranfang</b> un <b>Strukturenn</b>, "
"liek <b>\\\\{&nbsp;|&nbsp;\\\\}</b>"

#. i18n: file: quantacore/dialogs/dtepeditdlgs.ui:1177
#. i18n: ectx: property (text), widget (QLabel, textLabel26)
#: rc.cpp:790
msgid "Structure delimiting:"
msgstr "Struktuur-Grenz:"

