#. i18n: file: editsnippet.ui:69
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:29 rc.cpp:79
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'DejaVu Sans'; font-size:8pt; font-"
"weight:400; font-style:normal;\">\n"
"<p align=\"justify\" style=\" margin-top:0px; margin-bottom:0px; margin-"
"left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">You can "
"use mark interesting areas with <span style=\" font-style:italic;\">$...$</"
"span>. When the snippet gets inserted, the first area will be selected. You "
"can navigate the areas with <span style=\" font-style:italic;\">Alt + Left/"
"Right</span>. To quit, press <span style=\" font-style:italic;\">ESC</span>."
"</p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/"
"css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'DejaVu Sans'; font-size:8pt; font-"
"weight:400; font-style:normal;\">\n"
"<p align=\"justify\" style=\" margin-top:0px; margin-bottom:0px; margin-"
"left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Du kannst "
"Rebeden vun besünner Vermaak mit <span style=\" font-style:italic;\">$...$</"
"span> markeren. Wenn de Snippel inföögt warrt, warrt dat vörste Rebeet "
"utsöcht. Du kannst twischen de Rebeden mit <span style=\" font-style:italic;"
"\">Alt + Links/Rechts</span> wesseln. Drück <span style=\" font-style:italic;"
"\">Esc</span>, wenn Du dat utmaken wullt.</p></body></html>"

