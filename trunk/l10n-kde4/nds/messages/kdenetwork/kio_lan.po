#: kio_lan.cpp:141
msgid ""
"<qt>The Lisa daemon does not appear to be running.<br /><br />In order to "
"use the LAN Browser the Lisa daemon must be installed and activated by the "
"system administrator.</qt>"
msgstr ""
"<qt>As't lett löppt de LISa-Dämoon nich.<br /><br />Wenn Du den LAN-Kieker "
"bruken wullt, mutt de Systeempleger den LISa-Dämoon installeren un anmaken.</"
"qt>\t"

