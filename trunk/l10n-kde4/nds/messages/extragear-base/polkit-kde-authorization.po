#: PkKBlockGrantAuth.cpp:65 rc.cpp:80 rc.cpp:126
msgid ""
"Select the beneficiary and, optionally, how to constrain the authorization "
"that you are about to grant."
msgstr ""
"Söök den Nüttnehmer ut, den Du de Verlööfnis geven wullt, un köörwies ok, "
"wodennig Du ehr ingrenzen wullt."

#: PkKBlockGrantAuth.cpp:69
msgid "Select the user that will receive the negative authorization."
msgstr "Den Bruker utsöken, den Du de negative Verlööfnis geven wullt"

