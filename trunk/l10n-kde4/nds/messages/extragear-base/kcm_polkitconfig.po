#: kcmpolkitconfig.cpp:41
#, kde-format
msgid ""
"From this module, you can configure system administrators and priorities for "
"the policies defined in the Actions module"
msgstr ""
"Mit dit Moduul laat sik Systeemplegers un Prioriteten för de Regeln ut dat "
"Akschonen-Moduul instellen."

#: kcmpolkitconfig.cpp:44
#, kde-format
msgid "Dario Freddi"
msgstr "Dario Freddi"

#: kcmpolkitconfig.cpp:44
#, kde-format
msgid "Maintainer"
