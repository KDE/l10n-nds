#. i18n: tag whatsthis
#. i18n: file mailtransport.kcfg line 106
#: rc.cpp:87
msgid ""
"\n"
"        Check this option to use a custom hostname when identifying to the "
"mail server.\n"
"        <p/>This is useful when your system's hostname may not be set "
"correctly or to mask your system's true hostname.\n"
"      "
msgstr ""
"\n"
"        Maak dit an, wenn Du bi't Anmellen för den Nettpostserver en "
"besünner Reeknernaam bruken wullt.\n"
"        <p/>Dat is denn goot, wenn Dien Reeknernaam nich propper instellt is "
"oder wenn Du den Naam vun Dien Reekner nich künnigmaken wullt.\n"
"        "

#. i18n: tag whatsthis
#. i18n: file mailtransport.kcfg line 111
#: rc.cpp:96
msgid "Enter the hostname that should be used when identifying to the server."
msgstr "Giff hier den Reeknernaam in, den Du bi't Anmellen angeven wullt."

