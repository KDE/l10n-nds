#: dirfilterplugin.cpp:146
msgid "View F&ilter"
msgstr "Ansichtf&ilter"

#: dirfilterplugin.cpp:150
msgid "Allow to filter the currently displayed items by filetype."
msgstr "Dat Filtern vun de aktuell wiest Elementen na Dateityp tolaten."

#: dirfilterplugin.cpp:168
msgid "Clear Filter Field"
msgstr "Filterfeld leddig maken"

#: dirfilterplugin.cpp:170
msgid "Clear filter field<p>Clears the content of the filter field."
msgstr "Filterfeld leddig maken<p>Deit den Inholt vun't Filterfeld weg."

#: dirfilterplugin.cpp:186
msgid ""
"Enter here a text which an item in the view must contain anywhere to be "
"shown."
msgstr ""
"Giff hier den Text in, wat en Indrag in de List bargen mutt, dormit he wiest "
"warrt."

#: dirfilterplugin.cpp:191
msgid "Filter Field"
msgstr "Filterfeld"

#: dirfilterplugin.cpp:231
msgid "Only Show Items of Type"
msgstr "Bloots Indrääg na Typ wiesen"

#: dirfilterplugin.cpp:292
msgid "Use Multiple Filters"
msgstr "Mehr Filtern bruken"

#: dirfilterplugin.cpp:297
msgid "Show Count"
msgstr "Tall(en) wiesen"

#: dirfilterplugin.cpp:301
msgid "Reset"
msgstr "Torüchsetten"

