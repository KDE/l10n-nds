#. i18n: tag string
#. i18n: file kadddevicedlg.ui line 324
#: rc.cpp:99
msgid ""
"<p>Using an dynamic IP address causes this device to get a free IP address "
"automatically.</p>\n"
"<p>The interface will try to contact an DHCP- or BOOTP-Server during the "
"boot process.</p>\n"
"<p>Rendevouz is not supported yet.</p>"
msgstr ""
"<p>Wenn en dünaamsch IP-Adress bruukt warrt, haalt sik de Reedschap vun "
"sülven en fre'e IP-Adress.</p>\n"
"<p>De Koppelsteed versöcht bi't Hoochfahren, en DHCP- oder BOOTP-Server to "
"finnen.</p>\n"
"<p>\"Rendevouz\"-Protokoll warrt noch nich ünnerstütt.</p>"

