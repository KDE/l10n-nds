#: rc.cpp:6
msgid "TCP/IP Address"
msgstr "TCP/IP-Adress"

#. i18n: tag string
#. i18n: file kadddevicedlg.ui line 98
#: rc.cpp:9
msgid "Netmask:"
msgstr "Nettmask:"

#. i18n: tag string
#. i18n: file kadddevicedlg.ui line 101
#. i18n: tag string
#. i18n: file kadddevicedlg.ui line 104
#: rc.cpp:12 rc.cpp:15
msgid ""
"The netmask defines a range of IP numbers which will build a subnet inside "
"the network."
msgstr ""
"De Nettmask gifft dat IP-Nummernrebeet an, wat en Ünnernett in'n Nettwark "
"opstellt."

#. i18n: tag string
#. i18n: file kadddevicedlg.ui line 114
#. i18n: tag string
#. i18n: file kadddnsserverdlg.ui line 53
#. i18n: tag string
