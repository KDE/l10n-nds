#. i18n: tag string
#. i18n: file kadddevicedlg.ui line 118
#: rc.cpp:13 rc.cpp:16
msgid ""
"The netmask defines a range of IP numbers which will build a subnet inside "
"the network."
msgstr ""
"De Nettmask gifft dat IP-Nummernrebeet an, wat en Ünnernett in'n Nettwark "
"opstellt."

#. i18n: tag string
