#: kthumb.cpp:94
#, kde-format
msgid ""
"             # Query for a standard path.\n"
"             # - base: the base directory of the local cache\n"
"             # - normal: the normal directory for thumbnails\n"
"             # - large: the directory for large thumbnails\n"
"             # - fail: the directory for information about failed thumbnail "
"generations\n"
msgstr ""
"             # Anfraag na en Standard-Padd.\n"
"             # - base: Grundverteken vun den lokalen Twischenspieker\n"
"             # - normal: Standardverteken för Vöransichten\n"
"             # - large: Verteken för groot Vöransichten\n"
"             # - fail: Verteken för Informatschonen över leeg opstellt "
"Vöransichten\n"

#: kthumb.cpp:107
#, kde-format
msgid ""
"kthumb: No command specified.\n"
"\n"
"Please see `kthumb --commands' for more information."
msgstr ""
"kthumb: Keen Befehl angeven.\n"
"\n"
"Mehr lett sik mit \"kthumb --commands\" opropen."
