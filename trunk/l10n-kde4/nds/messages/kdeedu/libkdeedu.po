#~ msgid "Greek 'hydro' and 'gennao' for 'forms water'"
#~ msgstr "Greeksch 'hydro' un 'gennao' bedüüdt 'maakt water'"

#~ msgid "The Greek word for the sun was 'helios'"
#~ msgstr "Dat greeksche Woort för de Sünn weer 'helios'"

#~ msgid "Greek 'lithos' means 'stone'"
#~ msgstr "Greeksch 'lithos' bedüüdt 'Steen'"

#~ msgid "Greek 'beryllos' for 'light-green stone'"
#~ msgstr "Greeksch 'beryllos' bedüüdt 'hellgröön Steen'"

#~ msgid ""
#~ "Boron means 'Bor(ax) + (carb)on'. It is found in borax and behaves a lot "
#~ "like carbon"
#~ msgstr ""
#~ "Afleddt vun latiensch <i>borax</i> för dat Mineraal \"Borax\", dat Bor "
#~ "bargt. Dat Woort keem vun persisch <i>bura<sup>h</sup></i>, wo ok Borax "
#~ "mit meent weer."

#~ msgid "Latin 'carboneum' for carbon"
#~ msgstr "Latiensch 'carboneum' för Kahl"

#~ msgid "Latin 'nitrogenium' ('forms saltpeter')"
#~ msgstr ""
#~ "Bedüüdt \"Stoff, de Flammen stickt\". Symbool <i>N</i> un engelsch Naam "
#~ "<i>Nitrogen</i> sünd vun greeksch-latiensch <i>nitrogenium</i> "
#~ "(\"Loogsoltmaker\") afleddt."

#~ msgid "Latin 'oxygenium' (forms acids)"
#~ msgstr "Latiensch 'oxygenium' (maakt Süren)"

#~ msgid "Latin 'fluere' ('floats')"
#~ msgstr "Latiensch 'fluere' ('fleten')"

#~ msgid "Greek 'neo'. meaning 'new'"
#~ msgstr "Greeksch 'neo'. bedüüdt 'nieg'"

#~ msgid "Arabic 'natrun' for 'soda'"
#~ msgstr "Araabsch 'natrun' bedüüdt 'soda'"

#~ msgid "Named after the city of Magnesia"
#~ msgstr "Nöömt na de Stadt Magnesia"

#~ msgid "Latin 'alumen'"
#~ msgstr "Latiensch 'alumen'"

#~ msgid "Latin 'silex'"
#~ msgstr "Latiensch 'silex'"

#~ msgid "Greek 'phosphoros' for 'carries light'"
#~ msgstr "Greeksch 'phosphoros' bedüüdt 'Lichtdreger'"

#~ msgid "In sanskrit 'sweb' means 'to sleep'"
#~ msgstr "'Sweb' bedüüdt op Sanskrit 'slapen'"

#~ msgid "Greek 'chloros' for 'yellow-green'"
#~ msgstr "Greeksch 'chloros' bedüüdt 'geel-gröön'"

#~ msgid "Greek 'aergon' for 'inactive'"
#~ msgstr "Greeksch 'argon' bedüüdt 'traach'"

#~ msgid "Arabic 'al qaliy' for potash"
#~ msgstr ""
#~ "Araabsch 'al-kali' bedüüdt \"Asch\", meent is Pottasch, de Kalium (engl. "
#~ "'Potassium') bargt"

#~ msgid "Latin 'calx' for 'lime'"
#~ msgstr "Latiensch 'calx' bedüüdt 'Kalk'"

#~ msgid "Named because it was found in Scandinavia"
#~ msgstr "So nöömt, wieldat dat in Skandinavien funnen wöör"

#~ msgid "The Titans were giants in Greek mythology"
#~ msgstr "De Titanen weern Resen in de greeksche Sagenwelt"

#~ msgid "'Vanadis' is another name for the Nordic goddess Freyja"
#~ msgstr "'Vanadis' is en anner Naam för de noordsche Göttin Freyja"

#~ msgid "Greek 'chroma' means 'color'"
#~ msgstr "Greeksch 'chroma' bedüüdt 'Klöör'"

#~ msgid ""
#~ "It was discovered near a town named Magnesia in a black earth. Thus. it "
#~ "was named 'magnesia nigra'. short: Manganese"
#~ msgstr ""
#~ "Worr in de Neegde vun de Stadt Magnesia binnen swatte Eer funnen. So worr "
#~ "dat 'magnesia nigra' nöömt, kort: Manganese"

#~ msgid "Latin 'ferrum'"
#~ msgstr "Latiensch 'ferrum'"

#~ msgid "Named after the German word 'Kobold' for 'goblin'"
#~ msgstr "Nöömt na't hoochdüütsche Woort 'Kobold' (Niss, Puuk, Klabautermann)"

#~ msgid "'Nickel' was the name of a mountain goblin"
#~ msgstr "'Nickel' weer de Naam vun en Bargpuuk"

#~ msgid "Greek 'cuprum' for Cypres"
#~ msgstr "Greeksch 'cuprum' för Zypern"

#~ msgid "German 'zinking' for 'rough'. because zinc ore is very rough"
#~ msgstr ""
#~ "Middelhoochdüütsch <i>Zinke</i>, oolthoochdüütsch <i>zinko</i> höört to "
#~ "ohd. <i>Zind</i>, wat \"Tahn, Tacken\" bedüüdt. Zink sett sik na't "
#~ "Smölten tackenwies binnen den Smöltaven af."

#~ msgid "'Gallia' is an old name for France"
#~ msgstr "'Gallia' is en oolt Naam för Frankriek"

#~ msgid "Latin 'germania' is an old name for Germany"
#~ msgstr "Latiensch 'germania' is en oolt Naam för Düütschland"

#~ msgid "Greek 'arsenikos' for 'male' or 'bold'"
#~ msgstr "Greeksch 'arsenikos' bedüüdt 'mannshaftig, driest'"

#~ msgid "Greek 'selena' for 'moon'"
#~ msgstr "Greeksch 'selena' för 'Maand'"

#~ msgid "Greek 'bromos' for 'smells badly'"
#~ msgstr "Greeksch 'bromos' bedüüdt 'rüükt asig'"

#~ msgid "Greek 'kryptos' for 'hidden'"
#~ msgstr "Greeksch 'kryptos' för 'versteekt'"

#~ msgid "Latin 'rubidus' for 'dark red'"
#~ msgstr "Latiensch 'rubidus' bedüüdt 'düüsterroot'"

#~ msgid "Named after the mineral Strontianit"
#~ msgstr "Nöömt na't Mineraal Strontianit"

#~ msgid ""
#~ "Named after the small town of Ytterby near Stockholm in Sweden. Terbium. "
#~ "Ytterbium and Gadolinium are also named after this town."
#~ msgstr ""
#~ "Nöömt na de lütte Stadt Ytterby in de Neegte vun Stockholm in Sweden. Ok "
#~ "Terbium is na disse Stadt nöömt."

#~ msgid "Named after the mineral zircon"
#~ msgstr "Nöömt na dat Mineraal Zirkon"

#~ msgid "Named after Niobe. the daughter of the Greek god Tantalus"
#~ msgstr "Nöömt na Niobe, de Dochter vun den Greekschen Gott Tantalus"

#~ msgid ""
#~ "This name has Greek roots. It means 'like Platinum' - it was difficult to "
#~ "distinguish Molybdenum from Platinum."
#~ msgstr ""
#~ "Greeksch <i>molybdos</i> bedüüdt \"Blee\". Se harrn dat lang Tiet swoor "
#~ "hatt mit den Verscheel twischen de Mineralen Bleegleem un Molybdeengleem."

#~ msgid "Greek 'technetos' for artificial"
#~ msgstr "Greeksch <i>technetos</i> bedüüdt \"minschenmaakt\""

#~ msgid "Ruthenia is the old name of Russia"
#~ msgstr "Ruthenia is de ole Naam vun Russland"

#~ msgid "Greek 'rhodeos' means 'red like a rose'"
#~ msgstr "Greeksch 'rhodeos' bedüüdt 'root as en Roos'"

#~ msgid "Named after the asteroid Pallas"
#~ msgstr "Na den Lüttplanet Pallas nöömt"

#~ msgid "Latin 'argentum' for silver"
#~ msgstr "Latiensch 'argentum' bedüüdt Sülver"

#~ msgid "Greek 'kadmia' ('Galmei' = Zinc carbonate)"
#~ msgstr "Greeksch 'kadmia'"

#~ msgid "Named after 'Indigo' because of its blue spectrum"
#~ msgstr "Na 'Indigo' nöömt, na sien blaue Spektrallien"

#~ msgid "Latin 'stannum' for tin"
#~ msgstr "Latiensch 'stannum' bedüüdt 'Tinn'"

#~ msgid "Arabic 'anthos ammonos' for 'blossom of the god Ammon'"
#~ msgstr "Araabsch 'anthos ammonos' för 'Bloom vun den Gott Ammon'"

#~ msgid "Latin 'tellus' or 'telluris' for 'Planet Earth'"
#~ msgstr "Latiensch 'tellus' oder 'telluris' för den 'Planet Eer'"

#~ msgid "Greek 'ioeides' for 'violett'"
#~ msgstr "Greeksch 'ioeides' bedüüdt'vigelett'"

#~ msgid "Greek 'xenos' for 'foreigner'"
#~ msgstr "Greeksch 'xenos' bedüüdt 'frömd'"

#~ msgid "Latin 'caesius' for 'heavenblue'"
#~ msgstr "Latiensch 'caesius' bedüüdt 'hevenblaag'"

#~ msgid "Greek 'barys' for 'heavy'"
#~ msgstr "Greeksch 'barys' bedüüdt 'swoor'"

#~ msgid ""
#~ "Greek 'lanthanein' for 'hidden'. The Lanthanoids are also called the "
#~ "'rare earth'"
#~ msgstr ""
#~ "Greeksch 'lanthanein' för 'versteekt'. De Lanthanoiden warrt ok 'Rore "
#~ "Eerden' nöömt"

#~ msgid "Named after the planetoid Ceres"
#~ msgstr "Nöömt na den Dwargplanet 'Ceres'"

#~ msgid "Greek 'prasinos didymos' for 'green twin'"
#~ msgstr "Greeksch 'prasinos didymos' bedüüdt 'Gröön Tweeschen'"

#~ msgid "Greek 'neos didymos' for 'new twin'"
#~ msgstr "Greeksch 'neos didymos' för den 'niegen Tweeschen'"

#~ msgid ""
#~ "Named after the greek Prometheus. Prometheus stole the fire from the gods "
#~ "and gave it to mankind"
#~ msgstr ""
#~ "Na den greekschen Prometheus nöömt. Prometheus hett dat Füer vun de "
#~ "Gödder stahlen un dat de Minschen geven"

#~ msgid "Named after the mineral Samarskit"
#~ msgstr "Na dat Mineral Samarskit nöömt"

#~ msgid "Named after Europe"
#~ msgstr "Na Europa nöömt"

#~ msgid "Named after the Finnish chemist Johan Gadolin"
#~ msgstr "Na den finnschen Chemiker Johan Gadolin nöömt"

#~ msgid "Named after the Swedish town of Ytterby"
#~ msgstr "Na de Sweedsche Stadt Ytterby nöömt"

#~ msgid "Greek 'dysprositor' for 'difficult to reach'"
#~ msgstr "Greeksch 'dysprositor' bedüüdt 'lett sik nich faatkriegen'"

#~ msgid "Latin 'holmia' for the old name of Stockholm"
#~ msgstr "Latin 'holmia', de ole Naam vun Stockholm"

#~ msgid ""
#~ "Named ofter the Swedish town of Ytterby. Terbium and Ytterbium are also "
#~ "named after this town."
#~ msgstr ""
#~ "Na de sweedsche Stadt Ytterby nöömt. Ok 'Terbium un Ytterbium sünd na "
#~ "disse Stadt nöömt."

#~ msgid "Named after the old name of Scandinavia. 'Thule'"
#~ msgstr "Na den olen Naam vun Skandinavien nöömt: 'Thule'"

#~ msgid ""
#~ "Like Terbium and Gadolinium. this is named after the Swedish town of "
#~ "Ytterby"
#~ msgstr ""
#~ "So as ok Terbium un Gadolinium is ok dit Element na de sweedsche Stadt "
#~ "Ytterby nöömt"

#~ msgid "Named after the Roman name 'Lutetia' for Paris"
#~ msgstr "Nöömt na den röömschen Naam för Paris: 'Lutetia'"

#~ msgid "'Hafnia' is the old name of Kopenhagen (Denmark)"
#~ msgstr "Nöömt na den latienschen Naam vun Kopenhagen, <i>Hafnia</i>"

#~ msgid "Named after the Greek myth of Tantalos"
#~ msgstr "Nöömt na de greeksche <i>Tantalos</i>-Saag."

#~ msgid ""
#~ "'tung sten' means 'heavy stone' in Swedish. The old name (and thus the "
#~ "symbol 'W') was Wolfram. named after a mineral"
#~ msgstr ""
#~ "Bi't Tinnkaken in Sachsen verschannel en Mineraal de Tinnsmölt, dat se "
#~ "hoochdüütsch <i>Wolfra(h)m</i> nöömt hebbt. <i>Ra(h)m</i> bedüüd do "
#~ "\"Schiet, Smeer\" un nich \"Rahm, Flott\". De engelsche un franzöösche "
#~ "Naam <i>Tungsten</i> is vun sweedsch <i>tung sten</i> (\"swoor Steen\") "
#~ "afleddt, wat de sweedsche Naam för Scheelit (Kalziumwulframaat) weer."

#~ msgid "Named after the German river Rhine (latin 'Rhenium')"
#~ msgstr "Nöömt na den düütschen Stroom Rhien (latiensch 'Rhenus')"

#~ msgid "Greek for 'smell'. Its oxides smell strongly like radishes"
#~ msgstr "Greeksch för 'Röök'. Dat rüükt bannig na Rettich"

#~ msgid "Greek 'iris' for 'rainbow'"
#~ msgstr "Greeksch 'iris' is de Regenbagen"

#~ msgid "Spanish 'platina' means 'small silver'"
#~ msgstr "Spaansch 'platina' bedüüdt 'lütt Sülver'"

#~ msgid "Latin 'aurum'. named after Aurora. the goddess of sunrise"
#~ msgstr "Latiensch 'aurum' bedüüdt 'Gold'."

#~ msgid "Graeco-Latin 'hydrargyrum' for 'liquid silver'"
#~ msgstr "Greeksch-latiesch 'hydrargyrum' bedüüdt 'fleten Sülver'"

#~ msgid "Greek 'tallos' for 'young twig'"
#~ msgstr "Greeksch 'tallos' bedüüdt 'jung (gröön)' Twieg."

#~ msgid "Latin 'plumbum' for Lead"
#~ msgstr "Latiensch 'plumbum' bedüüdt Blee"

#~ msgid "The old name of Bismuth is 'Wismut'. This stood for 'white mass'"
#~ msgstr ""
#~ "Dat Woort geiht wull torüch op de eerste Fundsteed, de Wischen (hd. <i> Wi"
#~ "(e)se</i>) an den Sneebarg in de Ertbargen. De tweet Woortdeel mhd. <i> "
#~ "muten</i>, <i>die Mutung</i> höört to \"Moot\" un bedüüd in't Middelöller "
#~ "so veel as \"üm Verlööf för den Afbuu fragen\". Dat Symbool <i>Bi</i> is "
#~ "vun de latienschmaakte Form <i>bismutum</i> afleddt."

#~ msgid "Named after Poland to honor Marie Curie"
