#: interpreter/translator.cpp:634
#, qt-format
msgctxt ""
"You are about to translate the 'arrow' EXAMPLE PROGRAM, examples have to be "
"translated in a speacial way.Please see http://edu.kde.org/kturtle/"
"translator.php to learn know how to properly translate it."
msgid ""
"# Example: %1\n"
"# This example draws an arrow...\n"
"@(reset)\n"
"\n"
"@(canvassize) 200@(,) 200\n"
"@(canvascolor) 0@(,) 0@(,) 0\n"
"@(pencolor) 255@(,) 0@(,) 0\n"
"@(penwidth) 5\n"
"@(clear)\n"
"\n"
"@(go) 20@(,)20\n"
"@(direction) 135\n"
"\n"
"@(forward) 200\n"
"@(turnleft) 135\n"
"@(forward) 100\n"
"@(turnleft) 135\n"
"@(forward) 141\n"
"@(turnleft) 135\n"
"@(forward) 100\n"
