#: interpreter/executer.cpp:268
#, kde-format
msgid "Internationalized string with an %1"
msgstr "Översett Tekenkeed mit en %1"

#: interpreter/executer.cpp:269
#, kde-format
msgid "The %1 command accepts no parameters."
msgstr "De Befehl \"%1\" nimmt keen Parameters an."

#: interpreter/executer.cpp:279
#, kde-format
msgid "The %2 command was called with %3 but needs 1 parameter."
msgid_plural "The %2 command was called with %3 but needs %1 parameters."
msgstr[0] "De Befehl \"%2\" wöör mit %3 opropen, man bruukt een Parameter."
msgstr[1] "De Befehl \"%2\" wöör mit %3 opropen, man bruukt %1 Parameters."

#: interpreter/executer.cpp:281
#, kde-format
msgid "The %2 command was called with %3 but only accepts 1 parameter."
msgid_plural ""
"The %2 command was called with %3 but only accepts %1 parameters."
msgstr[0] ""
"De Befehl \"%2\" wöör mit \"%3\" opropen, man nimmt bloots een Parameter an."
msgstr[1] ""
"De Befehl \"%2\" wöör mit \"%3\" opropen, man nimmt bloots %1 Parameters an."

#: interpreter/executer.cpp:299
#, kde-format
msgid "The %1 command only accepts a string as its parameter."
msgstr "De Befehl \"%1\" nimmt bloots en Tekenkeed as Parameter an."

#: interpreter/executer.cpp:301
#, kde-format
msgid "The %1 command only accepts strings as its parameters."
msgstr "De Befehl \"%1\" nimmt bloots Tekenkeden as Parameters an."

#: interpreter/executer.cpp:306
#, kde-format
msgid "The %1 command only accepts a number as its parameter."
msgstr "De Befehl \"%1\" nimmt bloots en Tall as Parameter an."

#: interpreter/executer.cpp:308
#, kde-format
msgid "The %1 command only accepts numbers as its parameters."
msgstr "De Befehl \"%1\" nimmt bloots Tallen as Parameters an."

#: interpreter/executer.cpp:313
#, kde-format
msgid "The %1 command only accepts an answer as its parameter."
msgstr "De Befehl \"%1\" nimmt bloots en Antwoort as Parameter an."

#: interpreter/executer.cpp:315
#, kde-format
msgid "The %1 command only accepts answers as its parameters."
msgstr "De Befehl \"%1\" nimmt bloots Antwoorden as Parameters an."

#: interpreter/executer.cpp:403
#, kde-format
msgid "The variable '%1' was used without first being assigned to a value"
msgstr ""
"Du hest de Variabel \"%1\" bruukt, man ehr nich toeerst en Weert towiest"

#: interpreter/executer.cpp:416
#, kde-format
msgid "An unknown function named '%1' was called"
msgstr "Du hest en nich begäng Funkschoon mit den Naam \"%1\" opropen"

#: interpreter/executer.cpp:433 interpreter/executer.cpp:434
#, kde-format
msgid "1 parameter"
msgid_plural "%1 parameters"
msgstr[0] "1 Parameter"
msgstr[1] "%1 Parameters"

#: interpreter/executer.cpp:431
#, kde-format
msgid "The function '%1' was called with %2, while it should be called with %3"
msgstr ""
"Du hest de Funkschoon \"%1\" mit %2 opropen, man se schull mit %3 opropen "
"warrn"

#: interpreter/executer.cpp:640
msgid "'And' needs two variables"
msgstr "\"Un\" bruukt twee Variabeln"

#: interpreter/executer.cpp:649
msgid "'Or' needs two variables"
msgstr "\"Oder\" bruukt twee Variabeln"

#: interpreter/executer.cpp:659
msgid "I need something to do a not on"
msgstr "Du muttst \"Nich\" op jichtenswat anwennen"

#: interpreter/executer.cpp:667
msgid "I cannot do a '==' without 2 variables"
msgstr "\"==\" bruukt twee Variabeln"

#: interpreter/executer.cpp:675
msgid "I cannot do a '!=' without 2 variables"
msgstr "\"!=\" bruukt twee Variabeln"

#: interpreter/executer.cpp:683
msgid "I cannot do a '>' without 2 variables"
msgstr "\">\" bruukt twee Variabeln"

#: interpreter/executer.cpp:691
msgid "I cannot do a '<' without 2 variables"
msgstr "\"<\" bruukt twee Variabeln"

#: interpreter/executer.cpp:699
msgid "I cannot do a '>=' without 2 variables"
msgstr "\">=\" bruukt twee Variabeln"

#: interpreter/executer.cpp:707
msgid "I cannot do a '<=' without 2 variables"
msgstr "\"<=\" bruukt twee Variabeln"

#: interpreter/executer.cpp:715
msgid "You need two numbers or string to do an addition"
msgstr "För en Tosamentellen bruukst Du 2 Tekenkeden oder Tallen"

#: interpreter/executer.cpp:727
msgid "You need two numbers to subtract"
msgstr "För't Aftrecken bruukst Du 2 Tallen"

#: interpreter/executer.cpp:734
#, kde-format
msgid "You tried to subtract from a non-number, '%1'"
msgstr "Du wullst wat vun en Nich-Tall (\"%1\") aftrecken"

#: interpreter/executer.cpp:736
#, kde-format
msgid "You tried to subtract a non-number, '%1'"
msgstr "Du wullst en Nich-Tall (\"%1\")aftrecken"

#: interpreter/executer.cpp:742
msgid "You need two numbers to multiplicate"
msgstr "För't Maalnehmen bruukst Du twee Tallen"

#: interpreter/executer.cpp:749
#, kde-format
msgid "You tried to multiplicate a non-number, '%1'"
msgstr "Du wullst en Nich-Tall (\"%1\") maalnehmen"

#: interpreter/executer.cpp:751
#, kde-format
msgid "You tried to multiplicate by a non-number, '%1'"
msgstr "Du wullst mit en Nich-Tall (\"%1\") maalnehmen"

#: interpreter/executer.cpp:757
msgid "You need two numbers to divide"
msgstr "För't Delen bruukst Du twee Tallen"

#: interpreter/executer.cpp:764
#, kde-format
msgid "You tried to divide a non-number, '%1'"
msgstr "Du wullst en Nich-Tall (\"%1\") delen"

#: interpreter/executer.cpp:766
#, kde-format
msgid "You tried to divide by a non-number, '%1'"
msgstr "Du wullst dör en Nich-Tall (\"%1\") delen"

#: interpreter/executer.cpp:772
msgid "You need two numbers to raise a power"
msgstr "För en Hoochmaal bruukst Du twee Tallen"

#: interpreter/executer.cpp:779
#, kde-format
msgid "You tried to raise a non-number to a power, '%1'"
msgstr "Du wullst en Nich-Tall (\"%1\") hoochmaalnehmen"

#: interpreter/executer.cpp:781
#, kde-format
msgid "You tried to raise the power of a non-number, '%1'"
msgstr "Du wullst mit en Nich-Tall (\"%1\") hoochmaalnehmen"

#: interpreter/executer.cpp:787
msgid "You need one variable and a value or variable to do a '='"
msgstr "\"=\" bruukt een Variabel un een Variabel oder Weert"

#: interpreter/executer.cpp:804
#, kde-format
msgid "The function '%1' is already defined!"
msgstr "Dat gifft de Funkschoon \"%1\" al!"

#: interpreter/parser.cpp:51
#, kde-format
msgid "Expected a command, instead got '%1'"
msgstr "Befehl verwacht, man \"%1\" funnen"

#: interpreter/parser.cpp:84
#, kde-format
msgid "Could not understand '%1'"
msgstr "\"%1\" lett sik nich verstahn"

#: interpreter/parser.cpp:119
msgid "A comma was expected here..."
msgstr "Hier wöör en Komma verwacht"

#: interpreter/parser.cpp:122
#, kde-format
msgid "Did not expect '%1', instead expected the line to end after %2"
msgstr "\"%1\" wöör nich verwacht - de Reeg schull achter \"%2\" ophollen"

#: interpreter/parser.cpp:128
#, kde-format
msgid "Expected an assignment, '=', after the variable '%1'"
msgstr "Na de Variabel \"%1\" wöör en Towiesen (\"=\") verwacht"

#: interpreter/parser.cpp:132
#, kde-format
msgid "Did not expect '%1', instead expected the a closing parenthesis, ')'"
msgstr ""
"\"%1\" wöör nich verwacht, ansteed schull dor en sluten Klemm \")\" stahn"

#: interpreter/parser.cpp:136
msgid "Expected 'to' after 'for'"
msgstr "Na \"vun\" wöör \"bet\" verwacht"

#: interpreter/parser.cpp:139
msgid "Expected a name for a command after 'learn' command"
msgstr "Na den Befehl \"lehr\" wöör en Naam för en Befehl verwacht"

#: interpreter/parser.cpp:244
#, kde-format
msgid "You cannot put '%1' here!"
msgstr "Du kannst \"%1\" hier nich bruken!"

#: interpreter/parser.cpp:280
msgid ""
"Text string was not properly closed, expected a double quote, ' \" ' to "
"close the string"
msgstr ""
"Texttekenkeed wöör nich propper afslaten, en Goosfööt-Teken »\"« wöör för't "
"Enn verwacht"

#: interpreter/parser.cpp:639
msgid "'for' was called wrongly"
msgstr "Leeg Oproop vun \"vun\""

#: interpreter/parser.cpp:701
msgid "Expected a scope after the 'learn' command"
msgstr "Na den Befehl \"lehr\" wöör en Tuun verwacht"

