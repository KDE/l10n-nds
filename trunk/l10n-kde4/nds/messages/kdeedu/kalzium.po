#~ "Elektronen."

#~ msgid "Emulsion"
#~ msgstr "Mischflaat"

#~ msgid "Heterogeneous mix of two liquids."
#~ msgstr "Unegaal Mischen vun twee Flaten."

#~ msgid "Extraction"
#~ msgstr "Extrakschoon"

#~ msgid "Processing a homogeneous or heterogeneous mix to get pure matter."
