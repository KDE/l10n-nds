#: rc.cpp:806
msgid "&On Startup:"
msgstr "&Bi't Starten:"

#. i18n: file: src/lib/MarbleNavigationSettingsWidget.ui:92
#. i18n: ectx: property (toolTip), widget (QComboBox, kcfg_onStartup)
#: rc.cpp:809
