#: main.cpp:53
msgid "Spelling and Language"
msgstr "Schriefwies un Spraak"

#: main.cpp:54
msgid "Cleaning and bugfixing code"
msgstr "Kode-Oprümen un Fehlerrichten"

#: main.cpp:55
msgid "SVG icon"
msgstr "SVG-Lüttbild"

