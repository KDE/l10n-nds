#, no-c-format
msgid ""
"The format for the displayed text for todos.\n"
"Substutions (again mostly self-explanatory) are:\n"
"%{dueDate}, %{dueTime} - due date and time, %{startDate}, %{startTime} - "
"start date and time,\n"
"%{summary} - summary, %{description} - description, %{percent} - finished "
"percent, %{location} - location,\n"
"%{resourceName} - the i18n name of the Akonadi resource,\n"
"%{mainCategory}, %{categories} - the first or all categories,\n"
"%{tab} - a tabulator"
