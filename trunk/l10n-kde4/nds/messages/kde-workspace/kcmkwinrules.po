msgid "None"
msgstr "Keen"

#. i18n: ectx: property (text), item, widget (KComboBox, fsplevel)
#: ruleswidgetbase.ui:2353
msgid "Low"
msgstr "Siet"

#. i18n: ectx: property (text), item, widget (KComboBox, fsplevel)
