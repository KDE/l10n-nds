msgid "Redemption"
msgstr "Inlösen"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 369
#: xml_doc.cpp:2282
msgid ""
"The DISC function returns the discount rate for a security. Basis is the "
"type of day counting you want to use: 0: US 30/360 (default), 1: real days, "
"2: real days/360, 3: real days/365 or 4: European 30/365."
msgstr ""
"De Funkschoon DISC gifft den Diskontsatz för en Weertpapeer torüch. . Basis "
"is de Oort, wodennig de Daag tellt warrt: 0 = amerikaansch 30/360 "
"(Standard), 1 = reaal Daag, 2 = reaal Daag/360, 3 = reaal Daag/365 oder 4 = "
"europääsch 30/365."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 370
#: xml_doc.cpp:2285
msgid "DISC(settlement; maturity; par; redemption [; basis ] )"
msgstr "DISC(Utbetahldatum; Afloopdatum; Nennweert; Inlösen [; Basis ] )"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 371
#: xml_doc.cpp:2288
msgid "DISC(\"2/28/2001\"; \"8/31/2001\"; 12; 14) returns 0.2841"
msgstr "DISC(\"2/28/2001\"; \"8/31/2001\"; 12; 14) gifft \"0.2841\" torüch"

#. i18n: tag Comment
#. i18n: file functions/financial.xml line 380
#: xml_doc.cpp:2291
msgid "Fractional Dollar"
msgstr "Braken Dollar"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 388
#: xml_doc.cpp:2297
msgid ""
"The DOLLARDE() function returns a dollar price expressed as a decimal "
"number. The fractional dollar is the number to be converted and the fraction "
"is the denominator of the fraction"
msgstr ""
"De Funkschoon DOLLARDE() gifft en Dollar-Pries as Dezimaaltall torüch. De "
"braken Dollar is de Tall de ümwannelt warrt un de Andeel is den Brook sien "
"Nenner"

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 389
#: xml_doc.cpp:2300
msgid "DOLLARDE(fractional dollar; fraction)"
msgstr "DOLLARDE(Braken Dollar; Andeel)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 390
#: xml_doc.cpp:2303
msgid "DOLLARDE(1.02; 16) - stands for 1 and 2/16 - returns 1.125"
msgstr "DOLLARDE(1.02; 16) - steiht för 1 un 2/16 - gifft \"1.125\" torüch"

#. i18n: tag Comment
#. i18n: file functions/financial.xml line 400
#: xml_doc.cpp:2306
msgid "Decimal Dollar"
msgstr "Dezimaal-Dollar"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 408
#: xml_doc.cpp:2312
msgid ""
"The DOLLARFR() function returns a dollar price expressed as a fraction. The "
"decimal dollar is the number to be converted and the fraction is the "
"denominator of the fraction"
msgstr ""
"De Funkschoon DOLLARFR() gifft en Dollar-Pries as Brook torüch. De "
"Dezimaaldollar is de Tall de ümwannelt warrt un de Andeel is den Brook sien "
"Nenner"

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 409
#: xml_doc.cpp:2315
msgid "DOLLARFR(fractional dollar; fraction)"
msgstr "DOLLARFR(Braken Dollar; Andeel)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 410
#: xml_doc.cpp:2318
msgid "DOLLARFR(1.125; 16) returns 1.02. (1 + 2/16)"
msgstr "DOLLARFR(1.125; 16) gifft 1.02. (1 + 2/16) torüch"

