msgstr "ISNUM(12) gifft \"wohr\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 107
#: xml_doc.cpp:3289
msgid "ISNUM(hello) returns False"
msgstr "ISNUM(Moin) gifft \"falsch\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 120
#: xml_doc.cpp:3295
msgid ""
"The ISTIME() function returns True if the parameter is a time value. "
"Otherwise it returns False."
msgstr ""
"De Funkschoon ISTIME() gifft \"wohr\" torüch, wenn de Parameter en Tietweert "
"is. Anners warrt \"falsch\" torüchgeven."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 121
#: xml_doc.cpp:3298
msgid "ISTIME(x)"
msgstr "ISTIME(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 122
#: xml_doc.cpp:3301
msgid "ISTIME(\"12:05\") returns True"
msgstr "ISTIME(\"12:05\") gifft \"wohr\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 123
#: xml_doc.cpp:3304
msgid "ISTIME(\"hello\") returns False"
msgstr "ISTIME(\"Moin\") gifft \"falsch\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 135
#: xml_doc.cpp:3310
msgid ""
"The ISDATE() function returns True if the parameter is a date value. "
"Otherwise it returns False"
msgstr ""
"De Funkschoon ISDATE() gifft \"wohr\" torüch, wenn de Parameter en "
"Datumweert is. Anners warrt \"falsch\" utgeven"

#. i18n: tag Syntax
