msgstr ""
"De Funkschoon MONTH gifft den Maand vun en Datum torüch. Wenn keen Parameter "
"fastleggt is, warrt de aktuell Maand torüchgeven."

#. i18n: file: functions/datetime.xml:151
#: xml_doc.cpp:452
msgid "MONTH(date)"
msgstr "MONTH(Datum)"

#. i18n: file: functions/datetime.xml:152
#: xml_doc.cpp:454
