"Returns the number of periods needed for an investment to retain a desired "
"value."
msgstr ""
"Gifft de Tall vun Perioden torüch, de en Geldanlaag bruukt, dormit se bi den "
"wünscht Weert anlangt."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 433
#: xml_doc.cpp:2333
msgid "DURATION(rate; pv; fv)"
msgstr "DURATION(Tins; PV; FV)"

