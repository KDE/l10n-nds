#: xml_doc.cpp:2113
#, no-c-format
msgid ""
"The COMPOUND() function returns the value of an investment, given the "
"principal, nominal interest rate, compounding frequency and time. For "
"example: $5000 at 12% interest compounded quarterly for 5 years will become "
"COMPOUND(5000;0.12;4;5) or $9030.56."
msgstr ""
"De Funkschoon COMPOUND() gifft den Weert vun en Geldanlaag torüch, fastleggt "
"dör Startbedrag, nominaal Tinssatz, Optinsperiood un Tiet. 5000 Dollar a.B., "
"de elk Viddeljohr för fief Johr mit 12% optinst warrt, maakt COMPOUND"
"(5000;0.12;4;5) oder 9030,56 Dollar."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 150
#: xml_doc.cpp:2116
msgid "COMPOUND(initial;interest;periods;periods_per_year)"
msgstr "COMPOUND(Startbedrag;Tins;Perioden;Perioden_per_Johr)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 151
#: xml_doc.cpp:2119
msgid "COMPOUND(5000;0.12;4;5) equals 9030.56"
msgstr "COMPOUND(5000;0,12;4;5) gifft \"9030,56\" torüch"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 171
#: xml_doc.cpp:2132
#, no-c-format
msgid ""
"The CONTINUOUS() function calculates the return on continuously compounded "
"interest, given the principal, nominal rate and time in years. For example: "
"$1000 earning 10% for 1 year becomes CONTINUOUS(1000;.1;1) or $1105.17."
msgstr ""
"De Funkschoon CONTINUOUS() gifft den Ennweert vun en fast optinst Bedrag "
"torüch, angeven dör Startbedrag, nominaal Tinssatz un Tiet in Johren. Ut "
"1000 Dollar mit 10% Tinsen för een Johr warrt a.B. CONTINUOUS(1000;.1;1) "
"oder 1105,17 Dollar."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 172
#: xml_doc.cpp:2135
msgid "CONTINOUS(principal;interest;years)"
msgstr "CONTINUOUS(Startbedrag;Tins;Johren)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 173
#: xml_doc.cpp:2138
msgid "CONTINUOUS(1000;0.1;1) equals 1105.17"
msgstr "CONTINUOUS(1000;0,1;1) gifft \"1105,17\" torüch"

