#. i18n: file: functions/financial.xml:786
#: xml_doc.cpp:1752
msgid "Reinvestment"
msgstr "Nieganlaag"

#. i18n: file: functions/financial.xml:790
#: xml_doc.cpp:1754
msgid ""
"The MIRR() function will calculate the modified internal rate of return "
"(IRR) of a series of periodic investments."
msgstr ""
"De Funkschoon MIRR() reekt de ännert intern Tinsfoot (IRR) vun en Reeg vun "
"perioodsch Anlagen ut."

#. i18n: file: functions/financial.xml:791
#: xml_doc.cpp:1756
msgid "MIRR(values; investment; reinvestment)"
msgstr "MIRR(Weerten, Anlaag, Nieganlaag)"

#. i18n: file: functions/financial.xml:792
#: xml_doc.cpp:1759
#, no-c-format
msgid "MIRR({100;200;-50;300;-200}, 5%, 6%) equals 34.2823387842%"
msgstr "MIRR({100;200;-50;300;-200}, 5%, 6%) is 34.2823387842%"

#. i18n: file: functions/financial.xml:801
#: xml_doc.cpp:1761
msgid "Effective interest rate"
msgstr "Effektiv Tins"

#. i18n: file: functions/financial.xml:809
#: xml_doc.cpp:1766
#, no-c-format
msgid ""
"The NOMINAL() function calculates the nominal (stated) interest rate for an "
"effective (annualized) interest rate compounded at given intervals. For "
"example: to earn 8% on an account compounded monthly, you need a return of "
"NOMINAL(.08;12) or 7.72%."
msgstr ""
"De Funkschoon NOMINAL() reekt den Nominaatinssatz (angeven) för en "
"Effektivtinssatz (op dat Johr ümreekt) för en angeven Tiet ut. Bispill: Wenn "
"Een 8% op sien Konto kriegen will, mutt Een NOMINAL(0,08;12) oder 7,72% "
"Nominaaltins kriegen."

#. i18n: file: functions/financial.xml:810
#: xml_doc.cpp:1768
msgid "NOMINAL(effective;periods)"
msgstr "NOMINAL(Effektivtins;Perioden)"

#. i18n: file: functions/financial.xml:811
#: xml_doc.cpp:1770
msgid "NOMINAL(0.08;12) equals 0.0772"
msgstr "NOMINAL(0,08;12) gifft \"0,0772\" torüch"

#. i18n: file: functions/financial.xml:824
#: xml_doc.cpp:1774
msgid "Payment"
msgstr "Utbetahlen"

#. i18n: file: functions/financial.xml:832
#. i18n: file: functions/financial.xml:980
#: xml_doc.cpp:1778 xml_doc.cpp:1857
msgid "Future value (FV - optional)"
msgstr "Tokamen Weert (FV - optschonaal)"

#. i18n: file: functions/financial.xml:840
#: xml_doc.cpp:1782
msgid "Returns the number of periods of an investment."
msgstr "Gifft de Tall vun Perioden vun en Geldanlaag torüch."

#. i18n: file: functions/financial.xml:841
#: xml_doc.cpp:1784
msgid "NPER(rate;payment;pv;fv;type)"
msgstr "NPER(Tins;Utbetahlen;PV;FV;Typ)"

#. i18n: file: functions/financial.xml:842
#: xml_doc.cpp:1786
msgid "NPER(0.1; -100; 1000) equals 11"
msgstr "NPER(0.1; -100; 1000) gifft \"11\" torüch"

#. i18n: file: functions/financial.xml:843
#: xml_doc.cpp:1788
msgid "NPER(0.06; 0; -10000; 20000 ;0) returns 11.906"
msgstr "NPER(0.06; 0; -10000; 20000 ;0) gifft \"11.906\" torüch"

#. i18n: file: functions/financial.xml:859
#: xml_doc.cpp:1792
msgid "Values (array)"
msgstr "Weerten (Feld)"

#. i18n: file: functions/financial.xml:863
#: xml_doc.cpp:1794
msgid "The net present value (NPV) for a series of periodic cash flows."
msgstr "De Kapitaalweert (NPV) för en Reeg vun perioodsch Geldfleten"

#. i18n: file: functions/financial.xml:866
#: xml_doc.cpp:1796
msgid ""
"Computes the net present value for a series of periodic cash flows with the\n"
"                discount rate Rate. Values should be positive if they are "
"received as income, and\n"
"                negative if the amounts are paid as outgo."
msgstr ""
"Reekt den Kapitaalweert för en Reeg vun perioodsch Geldfleten mit\n"
"den Diskontsatztins ut. Weerten mööt positiv wesen, wenn se as\n"
"Inkamen rinkaamt, un negativ, wenn se as Utgaven rutgaht."

#. i18n: file: functions/financial.xml:867
#: xml_doc.cpp:1800
msgid "NPV(Rate; Values)"
msgstr "NPV(Tins;Weerten)"

#. i18n: file: functions/financial.xml:868
#: xml_doc.cpp:1803
#, no-c-format
msgid "NPV(100%;4;5;7) = 4.125"
msgstr "NPV(100%;4;5;7) = 4,125"

#. i18n: file: functions/financial.xml:889
#. i18n: file: functions/financial.xml:932
#: xml_doc.cpp:1809 xml_doc.cpp:1832 part/View.cpp:410
msgid "Last"
msgstr "Lest"

#. i18n: file: functions/financial.xml:897
