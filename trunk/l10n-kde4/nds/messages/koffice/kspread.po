msgstr "WORKDAY(Startdatum, Daag, Oorlööf)"

#. i18n: file: functions/datetime.xml:684
#: xml_doc.cpp:764
msgid ""
"WORKDAY(B9;2;D3:E4) B9 is \"01/01/2001\", D3 is \"01/03/2001\", D4 is "
"\"01/04/2003\" workday returns \"Fri Jan 5 2001\""
msgstr ""
"WORKDAY(B9;2;D3:E4) B9 is \"01/01/2001\", D3 is \"01/03/2001\", D4 is "
"\"01/04/2003\" workday gifft \"Fri Jan 5 2001\" torüch"

#. i18n: file: functions/datetime.xml:696
#: xml_doc.cpp:768
msgid "End date"
msgstr "Enndatum"

