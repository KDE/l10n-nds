#: xml_doc.cpp:2343
msgid ""
"The AND() function returns True if all the values are true. Otherwise it "
"returns False (unless any of the values in an error - then it returns an "
"error)."
msgstr ""
"De Funkschoon AND() gifft \"wohr\" torüch, wenn all Weerten wohr sünd. "
"Anners warrt \"falsch\" torüchgeven (man nich, wenn een vun de Weerten en "
"Fehler is. Denn warrt en Fehler torüchgeven)."

#. i18n: file: functions/logic.xml:52
#: xml_doc.cpp:2345
msgid "AND(value;value;...)"
msgstr "AND(Weert;Weert;...)"

#. i18n: file: functions/logic.xml:53
#: xml_doc.cpp:2347
msgid "AND(true;true;true) returns True"
msgstr "AND(wohr;wohr;wohr) gifft \"wohr\" torüch"

#. i18n: file: functions/logic.xml:54
#: xml_doc.cpp:2349
msgid "AND(true;false) returns False"
msgstr "AND(wohr;falsch) gifft \"falsch\" torüch"

#. i18n: file: functions/logic.xml:82
#: xml_doc.cpp:2361
msgid ""
"The OR() function returns True if at least one of the values is true. "
"Otherwise it returns False (unless any of the values is an error, then it "
"returns an error)."
msgstr ""
"De Funkschoon OR() gifft \"wohr\" torüch, wenn tominnst een Weert wohr is. "
"Anners warrt \"falsch\" torüchgeven (man nich, wenn een vun de Weerten en "
"Fehler is. Denn warrt en Fehler torüchgeven)."

#. i18n: file: functions/logic.xml:83
#: xml_doc.cpp:2363
msgid "OR(value;value;...)"
msgstr "OR(Weert;Weert;...)"

#. i18n: file: functions/logic.xml:84
#: xml_doc.cpp:2365
msgid "OR(false;false;false) returns False"
msgstr "OR(falsch;falsch;falsch) gifft \"falsch\" torüch"

#. i18n: file: functions/logic.xml:85
#: xml_doc.cpp:2367
msgid "OR(true;false) returns True"
msgstr "OR(wohr;falsch) gifft \"wohr\" torüch"

#. i18n: file: functions/logic.xml:113
#: xml_doc.cpp:2379
msgid ""
"The NAND() function returns True if at least one value is not true. "
"Otherwise it returns False."
msgstr ""
"De Funkschoon NAND() gifft \"wohr\" torüch, wenn tominnst een Weert nich "
"wohr is. Anners warrt \"falsch\" torüchgeven."

#. i18n: file: functions/logic.xml:114
#: xml_doc.cpp:2381
msgid "NAND(value;value;...)"
msgstr "NAND(Weert;Weert;...)"

#. i18n: file: functions/logic.xml:115
#: xml_doc.cpp:2383
msgid "NAND(true;false;false) returns True"
msgstr "NAND(wohr;falsch;falsch) gifft \"wohr\" torüch"

#. i18n: file: functions/logic.xml:116
#: xml_doc.cpp:2385
msgid "NAND(true;true) returns False"
msgstr "NAND(wohr;wohr) gifft \"falsch\" torüch"

#. i18n: file: functions/logic.xml:144
#: xml_doc.cpp:2397
msgid ""
"The NOR() function returns True if all the values given as parameters are of "
"boolean type and have the value false. Otherwise it returns False."
msgstr ""
"De Funkschoon NOR() gifft \"wohr\" torüch, wenn all as Parameters angeven "
"Weerten boolsch sünd un den Weert \"wohr\" hebbt. Anners warrt \"falsch\" "
"torüchgeven."

#. i18n: file: functions/logic.xml:145
#: xml_doc.cpp:2399
msgid "NOR(value;value;...)"
msgstr "NOR(Weert;Weert;...)"

#. i18n: file: functions/logic.xml:146
#: xml_doc.cpp:2401
msgid "NOR(true;false;false) returns False"
msgstr "NOR(wohr;falsch;falsch) gifft \"falsch\" torüch"

#. i18n: file: functions/logic.xml:147
#: xml_doc.cpp:2403
msgid "NOR(false;false) returns True"
msgstr "NOR(falsch;falsch) gifft \"wohr\" torüch"

#. i18n: file: functions/logic.xml:175
#: xml_doc.cpp:2415
msgid ""
"The XOR() function returns True if the number of True values is even. "
"Otherwise it returns False. It returns an error if any argument is an error."
msgstr ""
"De Funkschoon XOR() gifft \"wohr\" torüch, wenn de Tall vun wohr Weerten "
"even is. Anners warrt \"falsch\" torüchgeven. Wenn jichtenseen Argument en "
"Fehler is, warrt en Fehler torüchgeven."

#. i18n: file: functions/logic.xml:176
#: xml_doc.cpp:2417
msgid "XOR(value;value;...)"
msgstr "XOR(Weert;Weert;...)"

#. i18n: file: functions/logic.xml:177
#: xml_doc.cpp:2419
msgid "XOR(false;false;false) returns True"
msgstr "XOR(falsch;falsch;falsch) gifft \"wohr\" torüch"

#. i18n: file: functions/logic.xml:178
#: xml_doc.cpp:2421
msgid "XOR(true;false) returns False"
msgstr "XOR(wohr;falsch) gifft \"falsch\" torüch"

#. i18n: file: functions/logic.xml:186
#: xml_doc.cpp:2423
msgid "Boolean value"
msgstr "Boolsch Weert"

#. i18n: file: functions/logic.xml:190
#: xml_doc.cpp:2425
msgid ""
"The NOT() function returns True if the value is False and returns False if "
"the value is True. It returns an error if the input in an error."
msgstr ""
"De Funkschoon NOT() gifft \"wohr\" torüch, wenn de Weert falsch is, un gifft "
"\"falsch\" torüch, wenn de Weert wohr is. Wennde Ingaav en Fehler is, warrt "
"en Fehler torüchgeven."

#. i18n: file: functions/logic.xml:191
#: xml_doc.cpp:2427
msgid "NOT(bool)"
msgstr "NOT(Boolsch)"

#. i18n: file: functions/logic.xml:192
#: xml_doc.cpp:2429
msgid "NOT(false) returns True"
msgstr "NOT(falsch) gifft \"wohr\" torüch"

#. i18n: file: functions/logic.xml:193
#: xml_doc.cpp:2431
msgid "NOT(true) returns False"
msgstr "NOT(wohr) gifft \"falsch\" torüch"

#. i18n: file: functions/logic.xml:201
#: xml_doc.cpp:2433
msgid "Condition"
msgstr "Bedingen"

#. i18n: file: functions/logic.xml:205
#: xml_doc.cpp:2435
msgid "If true"
msgstr "Wenn wohr"

#. i18n: file: functions/logic.xml:209
#: xml_doc.cpp:2437
msgid "If false"
msgstr "Wenn falsch"

#. i18n: file: functions/logic.xml:213
#: xml_doc.cpp:2439
msgid ""
"The IF() function is a conditional function. This function returns the "
"second parameter if the condition is True. Otherwise it returns the third "
"parameter (which defaults to being false)."
msgstr ""
"De IF() Funkschoon is en bedingt Funkschoon. De Funkschoon gifft den "
"twetenParameter torüch, wenn de Bedingen wohr is. Anners warrt de drüdde "
"Parameter (de standardwies falsch is) torüchgeven."

#. i18n: file: functions/logic.xml:214
#: xml_doc.cpp:2441
msgid "IF(condition;if_true;if_false)"
msgstr "IF(Bedingen;Wenn_Wohr;Wenn_Falsch)"

#. i18n: file: functions/logic.xml:215
#: xml_doc.cpp:2443
msgid "A1=4;A2=6;IF(A1>A2;5;3) returns 3"
msgstr "A1=4;A2=6;IF(A1>A2;5;3) gifft \"3\" torüch"

#. i18n: file: functions/math.xml:5
#: xml_doc.cpp:2445
msgid "Math"
msgstr "Mathemaatsch"

#. i18n: file: functions/math.xml:11
#: xml_doc.cpp:2447 dialogs/FormulaDialog.cpp:65
msgid "Function"
msgstr "Funkschoon"

#. i18n: file: functions/math.xml:19
#: xml_doc.cpp:2451
msgid ""
"The SUBTOTAL() function returns a subtotal of a given list of arguments "
"ignoring other subtotal results in there. Function can be one of the "
"following numbers: 1 - Average, 2 - Count, 3 - CountA, 4 - Max, 5 - Min, 6 - "
"Product, 7 - StDev, 8 - StDevP, 9 - Sum, 10 - Var, 11 - VarP."
msgstr ""
"De Funkschoon SUBTOTAL() gifft en Twischensumm vun en angeven List vun "
"Argumenten torüch un övergeiht anner Twischensummresultaten. \"Funkschoon\" "
"kann een vun disse Tallen wesen: 1 - Average, 2 - Count, 3 - CountA, 4 - "
"Max, 5 - Min, 6 - Product, 7 - StDev, 8 - StDevP, 9 - Sum, 10 - Var, 11 - "
"VarP."

#. i18n: file: functions/math.xml:20
#: xml_doc.cpp:2453
msgid "SUBTOTAL(function; value)"
msgstr "SUBTOTAL(Funkschoon; Weert)"

#. i18n: file: functions/math.xml:21
#: xml_doc.cpp:2455
msgid "If A1:A5 contains 7, 24, 23, 56 and 9:"
msgstr "Wenn A1:A5 7, 24, 23, 56 un 9 bargt:"

#. i18n: file: functions/math.xml:22
#: xml_doc.cpp:2457
msgid "SUBTOTAL(1; A1:A5) returns 23.8"
msgstr "SUBTOTAL(1; A1:A5) gifft \"23.8\" torüch"

#. i18n: file: functions/math.xml:23
#: xml_doc.cpp:2459
msgid "SUBTOTAL(4; A1:A5) returns 56"
msgstr "SUBTOTAL(4; A1:A5) gifft \"56\" torüch"

#. i18n: file: functions/math.xml:24
#: xml_doc.cpp:2461
msgid "SUBTOTAL(9; A1:A5) returns 119"
msgstr "SUBTOTAL(9; A1:A5) gifft \"119\" torüch"

#. i18n: file: functions/math.xml:25
#: xml_doc.cpp:2463
msgid "SUBTOTAL(11; A1:A5) returns 307.76"
msgstr "SUBTOTAL(11; A1:A5) gifft \"307.76\" torüch"

#. i18n: file: functions/math.xml:44
#: xml_doc.cpp:2465
msgid "X the independent variable of the power series"
msgstr "X - de nich afhängig Variabel vun de Potenzreeg"

#. i18n: file: functions/math.xml:48
#: xml_doc.cpp:2467
msgid "N the initial power to which X is to be raised"
msgstr "N - de Startpotenz, na de X potenzeert warrt"

#. i18n: file: functions/math.xml:52
#: xml_doc.cpp:2469
msgid "M the increment by which to increase N for each term in the series"
msgstr "M - de Towass, den N för elk Term in de Reeg grötter maakt warrt"

#. i18n: file: functions/math.xml:56
#: xml_doc.cpp:2471
msgid ""
"Coefficients a set of coefficients by which each sccessive power of the "
"variable X is multiplied"
msgstr ""
"Koeffizienten - en Sett vun Koeffizienten, mit den elk nakamen Potenz vun de "
"Variabel X maalnahmen warrt"

#. i18n: file: functions/math.xml:60
#: xml_doc.cpp:2473
msgid "The SERIESSUM() function returns the sum of a power series."
msgstr "De Funkschoon SERIESSUM() gifft de Summ vun en Potenzreeg torüch."

#. i18n: file: functions/math.xml:61
#: xml_doc.cpp:2475
msgid "SERIESSUM( X; N; M; Coefficients)"
msgstr "SERIESSUM( X; N; M; Koeffizienten)"

#. i18n: file: functions/math.xml:62
#: xml_doc.cpp:2477
msgid "SERIESSUM(2;0;2;{1;2}) return 9"
msgstr "SERIESSUM(2;0;2;{1;2}) gifft 9 torüch"

#. i18n: file: functions/math.xml:79
#: xml_doc.cpp:2483
msgid ""
"The LCM() function returns the least common multiple for two or more float "
"values"
msgstr ""
"De Funkschoon LCM() gifft dat lüttst gemeen Veelfache vun twee oder mehr "
"Fleetkommaweerten torüch"

#. i18n: file: functions/math.xml:80
#: xml_doc.cpp:2485
msgid "LCM(value; value)"
msgstr "LCM(Weert;Weert)"

#. i18n: file: functions/math.xml:81
#: xml_doc.cpp:2487
msgid "LCM(6;4) returns 12"
msgstr "LCM(6;4) gifft \"12\" torüch"

#. i18n: file: functions/math.xml:82
#: xml_doc.cpp:2489
msgid "LCM(1.5;2.25) returns 4.5"
msgstr "LCM(1,5;2,25) gifft \"4,5\" torüch"

#. i18n: file: functions/math.xml:83
#: xml_doc.cpp:2491
msgid "LCM(2;3;4) returns 12"
msgstr "LCM(2;3;4) gifft \"12\" torüch"

#. i18n: file: functions/math.xml:100
#: xml_doc.cpp:2497
msgid "Third number"
msgstr "Drütt Tall"

#. i18n: file: functions/math.xml:104
#: xml_doc.cpp:2499
msgid ""
"The GCD() function returns the greatest common denominator for two or more "
"integer values."
msgstr ""
"De Funkschoon GCD() gifft den gröttsten gemeen Nenner vun twee oder mehr "
"Heeltallweerten torüch."

#. i18n: file: functions/math.xml:105
#: xml_doc.cpp:2501
msgid "GCD(value; value)"
msgstr "GCD(Weert;Weert)"

#. i18n: file: functions/math.xml:106
#: xml_doc.cpp:2503
msgid "GCD(6;4) returns 2"
msgstr "GCD(6;4) gifft \"2\" torüch"

#. i18n: file: functions/math.xml:107
#: xml_doc.cpp:2505
msgid "GCD(10;20) returns 10"
msgstr "GCD(10;20) gifft \"10\" torüch"

#. i18n: file: functions/math.xml:108
#: xml_doc.cpp:2507
msgid "GCD(20;15;10) returns 5"
msgstr "GCD(20;15;10) gifft \"5\" torüch"

#. i18n: file: functions/math.xml:117
#: xml_doc.cpp:2509
msgid ""
"EPS() returns the machine epsilon; this is the difference between 1 and the "
"next largest floating-point number. Because computers use a finite number of "
"digits, roundoff error is inherent (but usually insignificant) in all "
"calculations."
msgstr ""
"De Funkschoon EPS() gifft dat Reekner-Epsilon torüch. Dat is de Verscheel "
"twischen 1 un de nakamen gröttst Fleetkommatall. Wiel Reekners en ennen Tall "
"vun Nakommasteden bruukt, gifft dat bi't Reken jümmers Runnfehlers "
"(normalerwies ahn Utwarken)."

#. i18n: file: functions/math.xml:118
#: xml_doc.cpp:2511
msgid "EPS()"
msgstr "EPS()"

#. i18n: file: functions/math.xml:119
#: xml_doc.cpp:2513
msgid "On most systems, this returns 2^-52=2.2204460492503131e-16"
msgstr "Op de mehrsten Systemen gifft dit 2^-52=2.2204460492503131e-16 torüch"

#. i18n: file: functions/math.xml:120
#: xml_doc.cpp:2515
msgid ""
"0.5*EPS() returns the \"unit round\"; this value is interesting because it "
"is the largest number x where (1+x)-1=0 (due to roundoff errors)."
msgstr ""
"0.5*EPS() gifft de Maschiennauigkeit \"unit round\" torüch. Disse Weert is "
"intressant, wiel dat de gröttste Tall x is, för de (1+x)-1=0 is (dör "
"Runnfehlers)."

#. i18n: file: functions/math.xml:121
#: xml_doc.cpp:2517
msgid "EPS() is so small that KSpread displays 1+eps() as 1"
msgstr "EPS() is so lütt, dat KSpread 1+eps() as 1 dorstellt"

#. i18n: file: functions/math.xml:122
#: xml_doc.cpp:2519
msgid ""
"Pick a number x between 0 and EPS(). Observe that 1+x rounds x to either 0 "
"or EPS() by using the equation (1+x)-1"
msgstr ""
"Söök en Tall x twischen 0 un EPS() ut. Beacht, dat x bi 1+x dör de Glieken (1"
"+x)-1 na 0 oder EPS() rundt warrt"

#. i18n: file: functions/math.xml:138
#: xml_doc.cpp:2525
msgid ""
"The POWER(x;y) function returns the value of x raised to the power of y."
msgstr "De Funkschoon POWER(x;y) gifft den Weert vun x hooch y torüch."

#. i18n: file: functions/math.xml:139
#: xml_doc.cpp:2527
msgid "POWER(value;value)"
msgstr "POWER(Weert;Weert)"

#. i18n: file: functions/math.xml:140
#: xml_doc.cpp:2529
msgid "POWER(1.2;3.4) equals 1.8572"
msgstr "POWER(1.2;3.4) gifft \"1.8572\" torüch"

#. i18n: file: functions/math.xml:141
#: xml_doc.cpp:2531
msgid "POWER(2;3) equals 8"
msgstr "POWER(2;3) gifft \"8\" torüch"

#. i18n: file: functions/math.xml:158
#: xml_doc.cpp:2537
msgid ""
"The POW(x;y) function returns the value of x raised to the power of y. It's "
"the same as POWER."
msgstr ""
"De Funkschoon POW(x;y) gifft den Weert vun x hooch y torüch. Dat is dat "
"Sülvige as de Funkschoon \"POWER\"."

#. i18n: file: functions/math.xml:159
#: xml_doc.cpp:2539
msgid "POW(value;value)"
msgstr "POW(Weert;Weert)"

#. i18n: file: functions/math.xml:160
#: xml_doc.cpp:2541
msgid "POW(1.2;3.4) equals 1.8572"
msgstr "POW(1.2;3.4) gifft \"1.8572\" torüch"

#. i18n: file: functions/math.xml:161
#: xml_doc.cpp:2543
msgid "POW(2;3) equals 8"
msgstr "POW(2;3) gifft \"8\" torüch"

#. i18n: file: functions/math.xml:174
#: xml_doc.cpp:2547
msgid ""
"The EVEN() function returns the number rounded up to the nearest even "
"integer."
msgstr ""
"De Funkschoon EVEN() gifft de Tall oprundt na de dichtst bi liggen even "
"Heeltall torüch."

#. i18n: file: functions/math.xml:175
#: xml_doc.cpp:2549
msgid "EVEN(value)"
msgstr "EVEN(Weert)"

#. i18n: file: functions/math.xml:176
#: xml_doc.cpp:2551
msgid "EVEN(1.2) returns 2"
msgstr "EVEN(1,2) gifft \"2\" torüch"

#. i18n: file: functions/math.xml:177
#: xml_doc.cpp:2553
msgid "EVEN(2) returns 2"
msgstr "EVEN(2) gifft \"2\" torüch"

#. i18n: file: functions/math.xml:190
#: xml_doc.cpp:2557
msgid "Precision"
msgstr "Nauigkeit"

#. i18n: file: functions/math.xml:194
#: xml_doc.cpp:2559
msgid ""
"The TRUNC() function truncates a numeric value to a certain precision. If "
"the precision is omitted 0 is assumed."
msgstr ""
"De Funkschoon TRUNC() sniedt en numeersch Weert na en angeven Nauigkeit af. "
"Wenn keen Nauigkeit angeven is, warrt \"0\" vermoodt."

#. i18n: file: functions/math.xml:195
#: xml_doc.cpp:2561
msgid "TRUNC(value; precision)"
msgstr "TRUNC(Weert; Nauigkeit)"

#. i18n: file: functions/math.xml:196
#: xml_doc.cpp:2563
msgid "TRUNC(1.2) returns 1"
msgstr "TRUNC(1.2) gifft \"1\" torüch"

#. i18n: file: functions/math.xml:197
#: xml_doc.cpp:2565
msgid "TRUNC(213.232; 2) returns 213.23"
msgstr "TRUNC(213.232; 2) gifft \"213.23\" torüch"

#. i18n: file: functions/math.xml:212
#: xml_doc.cpp:2569
msgid ""
"The ODD() function returns the number rounded up (or down, for negative "
"values) to the nearest odd integer. By definition, ODD(0) is 1."
msgstr ""
"De Funkschoon ODD() gifft de Tall oprundt (oder för negativ Weerten afrundt) "
"na de dichtst bi liggen uneven Tall torüch. ODD(0) is na Definitschoon 1."

#. i18n: file: functions/math.xml:213
#: xml_doc.cpp:2571
msgid "ODD(value)"
msgstr "ODD(Weert)"

#. i18n: file: functions/math.xml:214
#: xml_doc.cpp:2573
msgid "ODD(1.2) returns 3"
msgstr "ODD(1,2) gifft \"3\" torüch"

#. i18n: file: functions/math.xml:215
#: xml_doc.cpp:2575
msgid "ODD(2) returns 3"
msgstr "ODD(2) gifft \"3\" torüch"

#. i18n: file: functions/math.xml:216
#: xml_doc.cpp:2577
msgid "ODD(-2) returns -3"
msgstr "ODD(-2) gifft \"-3\" torüch"

#. i18n: file: functions/math.xml:229
#: xml_doc.cpp:2581
msgid "The GAMMA() function returns the gamma function value."
msgstr "De Funkschoon GAMMA() gifft den Gammafunkschoonweert torüch."

#. i18n: file: functions/math.xml:230
#: xml_doc.cpp:2583
msgid "GAMMA(value)"
msgstr "GAMMA(Weert)"

#. i18n: file: functions/math.xml:231
#: xml_doc.cpp:2585
msgid "GAMMA(1) returns 1"
msgstr "GAMMA(1) gifft \"1\" torüch"

#. i18n: file: functions/math.xml:248
#: xml_doc.cpp:2591
msgid ""
"The MOD() function returns the remainder after division. If the second "
"parameter is null the function returns #DIV/0."
msgstr ""
"De Funkschoon MOD() gifft den Rest na en Divischoon torüch. Wenn de twete "
"Parameter Null is, warrt #DIV/0 torüchgeven."

#. i18n: file: functions/math.xml:249
#: xml_doc.cpp:2593
msgid "MOD(value;value)"
msgstr "MOD(Weert;Weert)"

#. i18n: file: functions/math.xml:250
#: xml_doc.cpp:2595
msgid "MOD(12;5) returns 2"
msgstr "MOD(12;5) gifft \"2\" torüch"

#. i18n: file: functions/math.xml:251
#: xml_doc.cpp:2597
msgid "MOD(5;5) returns 0"
msgstr "MOD(5;5) gifft \"0\" torüch"

#. i18n: file: functions/math.xml:264
#: xml_doc.cpp:2601
msgid ""
"This function returns -1 if the number is negative, 0 if the number is null "
"and 1 if the number is positive."
msgstr ""
"Disse Funkschoon gifft -1 ut, wenn de Tall negativ is, 0, wenn de Tall Null "
"is, un 1, wenn de Tall positiv is."

#. i18n: file: functions/math.xml:265
#: xml_doc.cpp:2603
msgid "SIGN(value)"
msgstr "SIGN(Weert)"

#. i18n: file: functions/math.xml:266
#: xml_doc.cpp:2605
msgid "SIGN(5) equals 1"
msgstr "SIGN(5) gifft \"1\" torüch"

#. i18n: file: functions/math.xml:267
#: xml_doc.cpp:2607
msgid "SIGN(0) equals 0"
msgstr "SIGN(0) gifft \"0\" torüch"

#. i18n: file: functions/math.xml:268
#: xml_doc.cpp:2609
msgid "SIGN(-5) equals -1"
msgstr "SIGN(-5) gifft \"-1\" torüch"

#. i18n: file: functions/math.xml:280
#: xml_doc.cpp:2613
msgid "This function multiplies each value by -1."
msgstr "Disse Funkschoon nimmt elk Weert mit -1 maal."

#. i18n: file: functions/math.xml:281
#: xml_doc.cpp:2615
msgid "INV(value)"
msgstr "INV(Weert)"

#. i18n: file: functions/math.xml:282
#: xml_doc.cpp:2617
msgid "INV(-5) equals 5"
msgstr "INV(-5) gifft \"5\" torüch"

#. i18n: file: functions/math.xml:283
#: xml_doc.cpp:2619
msgid "INV(5) equals -5"
msgstr "INV(5) gifft \"-5\" torüch"

#. i18n: file: functions/math.xml:284
#: xml_doc.cpp:2621
msgid "INV(0) equals 0"
msgstr "INV(0) gifft \"0\" torüch"

#. i18n: file: functions/math.xml:296
#: xml_doc.cpp:2625
msgid ""
"This function returns the count of integer or floating arguments passed. You "
"can count using a range: COUNT(A1:B5) or using a list of values like COUNT"
"(12;5;12.5)."
msgstr ""
"Disse Funkschoon gifft de Tall vun övergeven Heeltallen oder "
"Fleetkommaargumenten torüch. COUNT lett sik för en Rebeet bruken, as t.B. "
"COUNTA(A1:B5) oder för en List vun Weerten liek COUNT(12;5;12.5)."

#. i18n: file: functions/math.xml:297
#: xml_doc.cpp:2627
msgid "COUNT(value;value;value...)"
msgstr "COUNT(Weert;Weert;...)"

#. i18n: file: functions/math.xml:298
#: xml_doc.cpp:2629
msgid "COUNT(-5;\"KSpread\";2) returns 2"
msgstr "COUNT(-5;\"KSpread\";2) gifft \"2\" torüch"

#. i18n: file: functions/math.xml:299
#: xml_doc.cpp:2631
msgid "COUNT(5) returns 1"
msgstr "COUNT(5) gifft \"1\" torüch"

#. i18n: file: functions/math.xml:314
#: xml_doc.cpp:2635
msgid ""
"This function returns the count of all non empty arguments passed. You can "
"count using a range: COUNTA(A1:B5) or using a list of values like COUNTA"
"(12;5;12.5)."
msgstr ""
"Disse Funkschoon gifft de Tall vun all nich-leddig övergeven Argumenten "
"torüch. COUNT lett sik för en Rebeet bruken, as t.B. COUNTA(A1:B5) oder för "
"en List vun Weerten liek COUNT(12;5;12.5)."

#. i18n: file: functions/math.xml:315
#: xml_doc.cpp:2637
msgid "COUNTA(value;value;value...)"
msgstr "COUNTA(Weert;Weert;Weert...)"

#. i18n: file: functions/math.xml:316
#: xml_doc.cpp:2639
msgid "COUNTA(-5;\"KSpread\";2) returns 3"
msgstr "COUNTA(-5;\"KSpread\";2) gifft \"3\" torüch"

#. i18n: file: functions/math.xml:317
#: xml_doc.cpp:2641
msgid "COUNTA(5) returns 1"
msgstr "COUNTA(5) gifft \"1\" torüch"

#. i18n: file: functions/math.xml:327
#: xml_doc.cpp:2643
msgid "Cell range"
msgstr "Zellrebeet"

#. i18n: file: functions/math.xml:331
#: xml_doc.cpp:2645
msgid "This function returns the count of all empty cells within the range."
msgstr ""
"Disse Funkschoon gifft de Tall vun leddig Zellen binnen dat Rebeet torüch."

#. i18n: file: functions/math.xml:332
#: xml_doc.cpp:2647
msgid "COUNTBLANK(range)"
msgstr "COUNTBLANK(Zellrebeet)"

#. i18n: file: functions/math.xml:333
#: xml_doc.cpp:2649
msgid "COUNTBLANK(A1:B5)"
msgstr "COUNTBLANK(A1:B5)"

#. i18n: file: functions/math.xml:344
#. i18n: file: functions/math.xml:1201
#: xml_doc.cpp:2651 xml_doc.cpp:3148
msgid "Range"
msgstr "Rebeet"

#. i18n: file: functions/math.xml:348
#. i18n: file: functions/math.xml:433
#: xml_doc.cpp:2653 xml_doc.cpp:2703
msgid "Criteria"
msgstr "Markmalen"

#. i18n: file: functions/math.xml:352
#: xml_doc.cpp:2655
msgid ""
"The COUNTIF() function returns the number of cells in the given range that "
"meet the given criteria."
msgstr ""
"De Funkschoon COUNTIF() gifft de Tall vun Zellen mit de angeven Markmalen "
"binnen dat angeven Rebeet torüch."

#. i18n: file: functions/math.xml:353
#: xml_doc.cpp:2657
msgid "COUNTIF(range;criteria)"
msgstr "COUNTIF(Rebeet;Markmalen)"

#. i18n: file: functions/math.xml:354
#: xml_doc.cpp:2659
msgid "COUNTIF(A2:A3;\"14\") returns 1 if A1 is -4 and A2 is 14"
msgstr "COUNTIF(A2:A3;\"14\") gifft \"1\" torüch, wenn A1 = -4 un A2 = 14 sünd"

#. i18n: file: functions/math.xml:364
#. i18n: file: functions/math.xml:379
#. i18n: file: functions/math.xml:654
#. i18n: file: functions/math.xml:670
#. i18n: file: functions/math.xml:684
#. i18n: file: functions/math.xml:702
#. i18n: file: functions/math.xml:725
#. i18n: file: functions/math.xml:744
#. i18n: file: functions/math.xml:797
#. i18n: file: functions/math.xml:816
#. i18n: file: functions/math.xml:832
#. i18n: file: functions/math.xml:849
#. i18n: file: functions/math.xml:871
#. i18n: file: functions/math.xml:904
#. i18n: file: functions/math.xml:919
#. i18n: file: functions/math.xml:967
#. i18n: file: functions/math.xml:1026
