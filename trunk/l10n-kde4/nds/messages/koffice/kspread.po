#. i18n: file: functions/statistical.xml:733
#: xml_doc.cpp:3770 xml_doc.cpp:3782
msgid "Mean value of the standard logarithmic distribution"
msgstr "Middelweert vun de logaritmisch Standardverdelen"

#. i18n: file: functions/statistical.xml:715
#. i18n: file: functions/statistical.xml:737
#: xml_doc.cpp:3772 xml_doc.cpp:3784
msgid "Standard deviation of the standard logarithmic distribution"
msgstr "Standardverscheel vun de logaritmisch Standardverdelen"

#. i18n: file: functions/statistical.xml:719
