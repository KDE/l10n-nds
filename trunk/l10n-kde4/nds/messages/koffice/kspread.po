#: xml_doc.cpp:978
msgid ""
"The DAYNAME() function returns the name of the day of the week (1..7). In "
"some countries the first day of the week is Monday, while in others the "
"first day of the week is Sunday."
msgstr ""
"De Funkschoon DAYNAME() gifft den Naam vun en Wekendag (1-7) torüch. In en "
"poor Länner is de eerste Wekendag en Maandag, anners Sünndag."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 494
#: xml_doc.cpp:981
msgid "DAYNAME(weekday)"
msgstr "DAYNAME(Wekendag)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 495
#: xml_doc.cpp:984
msgid "DAYNAME(1) returns Monday (if the week starts on Monday)"
msgstr ""
"DAYNAME(1) gifft \"Maandag\"\" torüch (wenn de Week mit en Maandag anfangt)"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 504
#: xml_doc.cpp:987
