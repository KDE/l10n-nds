#. i18n: file: functions/datetime.xml:345
#. i18n: file: functions/datetime.xml:419
#. i18n: file: functions/financial.xml:301
#: xml_doc.cpp:552 xml_doc.cpp:566 xml_doc.cpp:610 xml_doc.cpp:1486
msgid "Month"
msgstr "Maand"

