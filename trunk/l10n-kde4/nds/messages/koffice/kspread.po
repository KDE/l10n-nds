#. i18n: file functions/datetime.xml line 510
#: xml_doc.cpp:996
msgid "MONTHNAME(5) returns May"
msgstr "MONTHNAME(5) gifft \"Mai\" torüch"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 518
#: xml_doc.cpp:999
msgid ""
"The CURRENTDATE() function returns the current date. It is equivalent to the "
"TODAY function."
msgstr ""
"De Funkschoon CURRENTDATE() gifft dat aktuelle Datum in't lokaal "
"Schrievformaat torüch. Dat is dat Sülve as de Funkschoon TODAY."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 519
#: xml_doc.cpp:1002
msgid "CURRENTDATE()"
msgstr "CURRENTDATE()"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 520
#: xml_doc.cpp:1005
msgid "CURRENTDATE() returns \"Saturday 13 April 2002\""
msgstr ""
"CURRENTDATE() gifft dat aktuelle Datum in de Form \"Saturday 13 April 2002\" "
"torüch"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 530
#: xml_doc.cpp:1008
msgid "The TODAY() function returns the current date."
msgstr "De Funkschoon TODAY() gifft dat aktuelle Datum torüch."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 531
#: xml_doc.cpp:1011
msgid "TODAY()"
msgstr "TODAY()"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 532
#: xml_doc.cpp:1014
msgid "TODAY() returns \"Saturday 13 April 2002\""
msgstr ""
"TODAY() gifft dat aktuelle Datum in de Form \"Saturday 13 April 2002\" torüch"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 542
#: xml_doc.cpp:1017
msgid ""
"The NOW() function returns the current date and time. It is identical with "
"CURRENTDATETIME and provided for compatibility with other applications."
msgstr ""
"De Funkschoon NOW() gifft dat aktuelle Datum un de Klock in't lokaal "
"Schrievformaat torüch. Dat is dat sülve as de Funkschoon CURRENTDATETIME un "
"warrt ut Kompatibiliteetgrünn mit anner Programmen praatstellt."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 543
#: xml_doc.cpp:1020
msgid "NOW()"
msgstr "NOW()"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 544
#: xml_doc.cpp:1023
msgid "NOW() returns \"Saturday 13 April 2002 19:12:01\""
msgstr "NOW() gifft t.B. \"Saturday 13 April 2002 19:12:01\" torüch"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 554
#: xml_doc.cpp:1026
msgid "The CURRENTDATETIME() function returns the current date and time."
msgstr ""
"De Funkschoon CURRENTDATETIME() gifft dat aktuelle Datum un de Klock torüch."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 555
#: xml_doc.cpp:1029
msgid "CURRENTDATETIME()"
msgstr "CURRENTDATETIME()"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 556
#: xml_doc.cpp:1032
msgid "CURRENTDATETIME() returns \"Saturday 13 April 2002 19:12:01\""
msgstr ""
"CURRENTDATETIME() gifft dat aktuelle Datum in de Form \"Sünnavend 13 April "
"2002\" torüch"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 564
#: xml_doc.cpp:1035
msgid ""
"The CURRENTTIME() function returns the current time formatted with local "
"parameters."
msgstr ""
"De Funkschoon CURRENTTIME() gifft de aktuelle Tiet in't lokaal Tietformaat "
"torüch."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 565
#: xml_doc.cpp:1038
msgid "CURRENTTIME()"
msgstr "CURRENTTIME()"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 566
#: xml_doc.cpp:1041
msgid "CURRENTTIME() returns \"19:12:01\""
msgstr "CURRENTTIME() gifft de aktuelle Tiet in de Form \"19:12:01\" torüch"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 578
#: xml_doc.cpp:1047
msgid ""
"The EASTERSUNDAY() function returns the date which corresponds to Easter "
"Sunday in the year given as the parameter."
msgstr ""
"De Funkschoon EASTERSUNDAY() gifft dat tohören Datum vun'n Oostersünndag "
"vun't ingeven Johr torüch."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 579
#: xml_doc.cpp:1050
msgid "EASTERSUNDAY(year)"
msgstr "EASTERSUNDAY(Johr)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 580
#: xml_doc.cpp:1053
msgid "EASTERSUNDAY(2003) returns \"20th April 2003\""
msgstr "EASTERSUNDAY(2003) gifft \"20th April 2003\" torüch"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 592
#: xml_doc.cpp:1059
msgid ""
"The ISOWEEKNUM() function returns number of the week which the date falls "
"into. Note that this function is compliant with the ISO8601 standard: a week "
"always begins on a Monday, and ends on a Sunday. The first week of a year is "
"that week which contains the first Thursday of the year."
msgstr ""
"De Funkschoon ISOWEEKNUM() gifft de Weeknummer vun en Datum torüch. Beacht, "
"dat disse Funkschoon den Standard \"ISO8601\" topasst is: En Week fangt "
"jümmers mit en Maandag an un endt mit enn Sünndag. De eerste Week vun en "
"Johr is de Week mit den eersten Dunnersdag in't Johr."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 593
#: xml_doc.cpp:1062
msgid "ISOWEEKNUM(date)"
msgstr "ISOWEEKNUM(Datum)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 594
#: xml_doc.cpp:1065
msgid "ISOWEEKNUM(A1) returns 51 when A1 is \"21st of Dec\"."
msgstr "ISOWEEKNUM(A1) gifft \"51\" torüch, wenn A1 \"21st of Dec\" is."

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 611
#: xml_doc.cpp:1074
msgid ""
"The WEEKNUM() function returns the non-ISO week number in which the date "
"falls into."
msgstr ""
"De Funkschoon WEEKNUM() gifft de \"nich-ISO\"-Weeknummer torüch, in de dat "
"Datum liggt."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 612
#: xml_doc.cpp:1077
msgid "WEEKNUM(date; method)"
msgstr "WEEKNUM(Datum; Utrekenmetood)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 613
#: xml_doc.cpp:1080
msgid ""
"WEEKNUM(A1; 1) returns 11 when A1 is \"9th of March 2008\". Number of the "
"week in the year, with a week beginning on Sunday (11)"
msgstr ""
"WEEKNUM(A1; 1) gifft 11 torüch, wenn A1 \"9th of March 2008\" is. De "
"Wekennummer in't Johr, wenn en Week mit en Sünndag anfangt (11)."

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 614
#: xml_doc.cpp:1083
msgid ""
"WEEKNUM(A1; 2) returns 10 when A1 is \"9th of March 2008\". Number of the "
"week in the year, with a week beginning on Monday (10)"
msgstr ""
"WEEKNUM(A1; 2) gifft 10 torüch, wenn A1 \"9th of March 2008\" is. De "
"Wekennummer in't Johr, wenn en Week mit en Maandag anfangt (10)."

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 623
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 647
#: xml_doc.cpp:1086 xml_doc.cpp:1110
msgid "First date"
msgstr "Eerst Datum"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 627
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 651
#: xml_doc.cpp:1089 xml_doc.cpp:1113
msgid "Second date"
msgstr "Tweet Datum"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 631
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 655
#: xml_doc.cpp:1092 xml_doc.cpp:1116
msgid "interval"
msgstr "Twischentiet"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 635
#: xml_doc.cpp:1095
msgid "The DATEDIF() function returns the difference between two dates."
msgstr ""
"De Funkschoon DATEDIF() gifft den Verscheel twischen twee Daten torüch."

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 636
#: xml_doc.cpp:1098
msgid ""
"Interval must be one of the following: \"m\": month; \"d\": days; \"y\": "
"complete years; \"ym\": month excluding years; \"yd\": days excluding years; "
"\"md\": days excluding months and years"
msgstr ""
"Twischentiet mutt een vun de nakamen wesen: \"m\": Maand; \"d\": Daag; \"y"
"\": heel Johren; \"ym\": Maand ahn Johren; \"yd\": Daag ahn Johren; \"md\": "
"Daag ahn Maanden un ok ahn Johren"

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 637
#: xml_doc.cpp:1101
msgid "DATEDIF(first date; second date; interval)"
msgstr "DATEDIF(Eerst Datum, tweet Datum, Twischentiet)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 638
#: xml_doc.cpp:1104
msgid ""
"DATEDIF(A1;A2;\"d\") A1 is \"1st of January 1995\" and A2 is \"15th of June "
"1999\" returns number of days 1626"
msgstr ""
"DATEDIF(A1;A2;\"d\") A1 is \"1st of January 1995\" un A2 is \"15th of June "
"1999\" gifft de Tall vun Daag torüch: 1626"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 639
#: xml_doc.cpp:1107
msgid ""
"DATEDIF(A1;A2;\"m\") A1 is \"1st of January 1995\" and A2 is \"15th of June "
"1999\" returns number of weeks 53"
msgstr ""
"DATEDIF(A1;A2;\"m\") A1 is \"1st of January 1995\" un A2 is \"15th of June "
"1999\" gifft de Tall vun Weken torüch: 53"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 659
#: xml_doc.cpp:1119
msgid ""
"The YEARFRAC() function returns the number of full days between start date "
"and end date according to the basis."
msgstr ""
"De Funkschoon YEARFRAC() gifft de Tall vun heel Daag twischen Start- un "
"Enndatum torüch, afhängig vun de Basis."

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 660
#: xml_doc.cpp:1122
msgid ""
"Basis must be one of the following: 0 = 30/360 US, 1 = Actual/actual, 2 = "
"Actual/360, 3 = Actual/365, 4 = European 30/360"
msgstr ""
"Basis mutt een vun de nakamen wesen: 0 = 30/360 US, 1 = Redig/redig, 2 = "
"Redig/360, 3 = Redig/365, 4 = Europääsch 30/360"

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 661
#: xml_doc.cpp:1125
msgid "YEARFRAC(start date; endd date; basis)"
msgstr "YEARFRAC(Startdatum, Enndatum, Basis)"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 669
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 692
#: xml_doc.cpp:1128 xml_doc.cpp:1149
msgid "Start date"
msgstr "Startdatum"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 673
#: xml_doc.cpp:1131
msgid "Working days"
msgstr "Arbeitdaag"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 677
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 700
#: xml_doc.cpp:1134 xml_doc.cpp:1155
msgid "Holidays"
msgstr "Oorlööf"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 681
#: xml_doc.cpp:1137
msgid ""
"The WORKDAY() function returns the date which is working days from the start "
"date."
msgstr ""
"De Funkschoon WORKDAY() gifft de Daten vun Arbeitdaag af Startdatum ut."

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 682
#. i18n: tag Text
#. i18n: file functions/datetime.xml line 705
#: xml_doc.cpp:1140 xml_doc.cpp:1161
msgid ""
"Holidays must be one of the following: number = days to add, a single date "
"or an array of dates."
msgstr ""
"Oorlööf mutt een vun de Nakamen wesen: Tall = Daag för't Tofögen, en "
"Enkeldatum oder en Datenfeld."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 683
#: xml_doc.cpp:1143
msgid "WORKDAY(start date; days; holidays)"
msgstr "WORKDAY(Startdatum, Daag, Oorlööf)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 684
#: xml_doc.cpp:1146
msgid ""
"WORKDAY(B9;2;D3:E4) B9 is \"01/01/2001\", D3 is \"01/03/2001\", D4 is "
"\"01/04/2003\" workday returns \"Fri Jan 5 2001\""
msgstr ""
"WORKDAY(B9;2;D3:E4) B9 is \"01/01/2001\", D3 is \"01/03/2001\", D4 is "
"\"01/04/2003\" workday gifft \"Fri Jan 5 2001\" torüch"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 696
#: xml_doc.cpp:1152
msgid "End date"
msgstr "Enndatum"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 704
#: xml_doc.cpp:1158
msgid ""
"The NETWORKDAY() function returns the number of working days between "
"startdate and enddate."
msgstr ""
"De Funkschoon NETWORKDAY() gifft de Tall vun Arbeitdaag twischen Start- un "
"Enndatum torüch."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 706
#: xml_doc.cpp:1164
msgid "NETWORKDAY(start date; end date; holidays)"
msgstr "NETWORKDAY(Startdatum, Enndatum, Oorlööf)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 707
#: xml_doc.cpp:1167
msgid "NETWORKDAY(\"01/01/2001\";\"01/08/2001\") returns 5 workdays"
msgstr "NETWORKDAY(\"01/01/2001\";\"01/08/2001\") gifft 5 Wekendaag torüch"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 708
#: xml_doc.cpp:1170
msgid "NETWORKDAY(\"01/01/2001\";\"01/08/2001\";2) returns 3 workdays"
msgstr "NETWORKDAY(\"01/01/2001\";\"01/08/2001\";2) gifft 3 Wekendaag torüch"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 720
#: xml_doc.cpp:1176
msgid "DATE2UNIX() function converts a date and time value to unix time."
msgstr ""
"De Funkschoon DATE2UNIX() wannelt en Datum- un Tietweert na en Unixdatum üm."

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 721
#. i18n: tag Text
#. i18n: file functions/datetime.xml line 736
#: xml_doc.cpp:1179 xml_doc.cpp:1194
msgid "A unix time is the number of seconds after midnight January 1st, 1970."
msgstr "En Unixtiet is de Tall vun Sekunnen af Mittnacht vun'n 1. Januor 1970."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 722
#: xml_doc.cpp:1182
msgid "DATE2UNIX(date)"
msgstr "DATE2UNIX(Datum)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 723
#: xml_doc.cpp:1185
msgid "DATE2UNIX(\"01/01/2000\") returns 946,681,200"
msgstr "DATE2UNIX(\"01/01/2000\") gifft 946,681,200 torüch"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 731
#: xml_doc.cpp:1188
msgid "Unixtime"
msgstr "Unixtiet"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 735
#: xml_doc.cpp:1191
msgid "UNIX2DATE() function converts unix time to a date and time value."
msgstr ""
"De Funkschoon UNIX2DATE() wannelt de Unixtiet na en Datum un Tietweert üm."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 737
#: xml_doc.cpp:1197
msgid "UNIX2DATE(unixtime)"
msgstr "UNIX2DATE(Unixtiet)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 738
#: xml_doc.cpp:1200
msgid "UNIX2DATE(0) returns 1970-01-01"
msgstr "UNIX2DATE(0) gifft 1970-01-01 torüch"

#. i18n: tag GroupName
#. i18n: file functions/engineering.xml line 5
#: xml_doc.cpp:1203
msgid "Engineering"
msgstr "Technik"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 15
#. i18n: tag Comment
#. i18n: file functions/math.xml line 706
#: xml_doc.cpp:1209 xml_doc.cpp:4279
msgid "Base"
msgstr "Basis"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 19
#: xml_doc.cpp:1212
msgid "MinLength"
msgstr "Minimaallängde"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 23
#: xml_doc.cpp:1215
msgid ""
"The BASE() function converts a number from base-10 to a string value in a "
"target base from 2 to 36."
msgstr ""
"De Funkschoon BASE() wannelt en Tall to Basis 10 na en Tekenkeedweert in en "
"Teelbasis twischen 2 bet 36 üm."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 24
#: xml_doc.cpp:1218
msgid "BASE(number;base;prec)"
msgstr "BASE(Tall;Basis;Nauigkeit)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 25
#: xml_doc.cpp:1221
msgid "BASE(128;8) returns \"200\""
msgstr "BASE(128;8) gifft \"200\" torüch"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 33
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 54
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 75
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 96
#: xml_doc.cpp:1224 xml_doc.cpp:1239 xml_doc.cpp:1254 xml_doc.cpp:1269
msgid "Where the function is evaluated"
msgstr "Woneem utreekt warrn schall"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 37
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 58
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 79
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 100
#: xml_doc.cpp:1227 xml_doc.cpp:1242 xml_doc.cpp:1257 xml_doc.cpp:1272
msgid "Order of the function"
msgstr "Funkschoonreeg"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 41
#: xml_doc.cpp:1230
msgid "The BESSELI() function returns the modified Bessel function In(x)."
msgstr ""
"De Funkschoon BESSELI() gifft de ännert \"Bessel\"-Funkschoon ln(x) torüch."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 42
#: xml_doc.cpp:1233
msgid "BESSELI(X;N)"
msgstr "BESSELI(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 43
#: xml_doc.cpp:1236
msgid "BESSELI(0.7;3) returns 0.007367374"
msgstr "BESSELI(0.7;3) gifft \"0.007367374\" torüch"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 62
#: xml_doc.cpp:1245
msgid "The BESSELJ() function returns the Bessel function."
msgstr "De Funkschoon BESSELJ() gifft de \"Bessel\"-Funkschoon torüch."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 63
#: xml_doc.cpp:1248
msgid "BESSELJ(X;N)"
msgstr "BESSELJ(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 64
#: xml_doc.cpp:1251
msgid "BESSELJ(0.89;3) returns 0.013974004"
msgstr "BESSELJ(0.89;3) gifft \"0.013974004\" torüch"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 83
#: xml_doc.cpp:1260
msgid ""
"The BESSELK() function returns the modified Bessel function, which is "
"equivalent to the Bessel function evaluated for purely imaginary arguments."
msgstr ""
"De Funkschoon BESSELK() gifft de ännert \"Bessel\"-Funkschoon torüch, de "
"liek de utreekt \"Bessel\"-Funkschoon för imagineer Argumenten is."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 84
#: xml_doc.cpp:1263
msgid "BESSELK(X;N)"
msgstr "BESSELK(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 85
#: xml_doc.cpp:1266
msgid "BESSELK(3;9) returns 397.95880"
msgstr "BESSELK(3;9) gifft \"397.95880\" torüch"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 104
#: xml_doc.cpp:1275
msgid ""
"The BESSELY() function returns the Bessel function, which is also called the "
"Weber function or the Neumann function."
msgstr ""
"De Funkschoon BESSELY() gifft de \"Bessel\"-Funkschoon torüch, ok nöömt "
"\"Weber\"- oder \"Neumann\"-Funkschoon."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 105
#: xml_doc.cpp:1278
msgid "BESSELY(X;N)"
msgstr "BESSELY(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 106
#: xml_doc.cpp:1281
msgid "BESSELY(4;2) equals 0.215903595"
msgstr "BESSELY(4;2) gifft \"0.215903595\" torüch"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 121
#: xml_doc.cpp:1287
msgid "From unit"
msgstr "Vun Eenheit"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 125
#: xml_doc.cpp:1290
msgid "To unit"
msgstr "Bet Eenheit"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 129
#: xml_doc.cpp:1293
msgid ""
"The CONVERT() function returns a conversion from one measurement system to "
"another."
msgstr ""
"De Funkschoon CONVERT() gifft en Ümwanneln vun en Maatsysteem na en anner ut."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 130
#: xml_doc.cpp:1296
msgid ""
"Supported mass units: g (gram), sg (pieces), lbm (pound), u (atomic mass), "
"ozm (ounce), stone, ton, grain, pweight (pennyweight), hweight "
"(hundredweight), bron (gross registered ton)."
msgstr ""
"Ünnerstütt Masseenheiten: g (Gramm), sg (Stück), lbm (Pund), u (Atoommass), "
"ozm (Unz), stone, ton (Tünn), grain, pweight (pennyweight), hweight "
"(Zentner), bron (Bruttoregistertünn)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 131
#: xml_doc.cpp:1299
msgid ""
"Supported distance units: m (meter), in (inch), ft (feet), mi (mile), Nmi "
"(nautical mile), ang (Angstrom), parsec, lightyear."
msgstr ""
"Ünnerstütt Längdeneenheiten: m (Meter), in (Toll), ft (Foot), mi (Miel), Nmi "
"(Nautisch Miel), ang (Angström), parsec, lightyear (Lichtjohr)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 132
#: xml_doc.cpp:1302
msgid ""
"Supported pressure units: Pa (Pascal), atm (atmosphere), mmHg (mm of "
"Mercury), psi, Torr."
msgstr ""
"Ünnerstütt Druckeenheiten: Pa (Pascal), atm (Atmosfeer), mmHg (mm "
"Quicksilver), psi, Torr."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 133
#: xml_doc.cpp:1305
msgid "Supported force units: N (Newton), dyn, pound."
msgstr "Ünnerstütt Knööveenheiten: N (Newton), dyn, pound."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 134
#: xml_doc.cpp:1308
msgid ""
"Supported energy units: J (Joule), e (erg), c (Thermodynamic calorie), cal "
"(IT calorie), eV (electronvolt), HPh (Horsepower-hour), Wh (Watt-hour), flb "
"(foot-pound), BTU."
msgstr ""
"Ünnerstütt Energie-Eenheiten: J (Joule), e (erg), c (Thermodünaamsch "
"Kalorie), cal (IT Kalorie), eV (Elektronenvolt), HPh (Peerstärk-Stunn), Wh "
"(Wattstunn), flb (Foot-Pund), BTU."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 135
#: xml_doc.cpp:1311
msgid "Supported power units: W (Watt), HP (horsepower), PS (Pferdestaerke)."
msgstr "Ünnerstütt Knööveenheiten: W (Watt), HP (Horsepower), PS (Peerstärk)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 136
#: xml_doc.cpp:1314
msgid "Supported magnetism units: T (Tesla), ga (Gauss)."
msgstr "Ünnerstütt magneetsch Eenheiten: T (Tesla), ga (Gauss)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 137
#: xml_doc.cpp:1317
msgid "Supported temperature units: C (Celsius), F (Fahrenheit), K (Kelvin)."
msgstr ""
"Ünnerstütt Temperatuur-Eenheiten: C (Celsius), F (Fahrenheit), K (Kelvin)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 138
#: xml_doc.cpp:1320
msgid ""
"Supported volume units: l (liter), tsp (teaspoon), tbs (tablespoon), oz "
"(ounce liquid), cup, pt (pint), qt (quart), gal (gallone), barrel, m3 (cubic "
"meter), mi3 (cubic mile), Nmi3 (cubic Nautical mile), in3 (cubic inch), ft3 "
"(cubic foot), yd3 (cubic yard)."
msgstr ""
"Ünnerstütt Mengdeneenheiten: l (Liter), tsp (Teelöpel), tbs (Esslöpel), oz "
"(Fletig-Unz), cup (Tass), pt (Pint), qt (Quart), gal (Galloon), barrel, m3 "
"(Kubikmeter), mi3 (Kubikmiel), Nmi3 (nautisch Kubikmiel), in3 (Kubiktoll), "
"ft3 (Kubikfoot), yd3 (Kubik-Yard)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 139
#: xml_doc.cpp:1323
msgid ""
"Supported area units: m2 (square meter), mi2 (square mile), Nmi2 (square "
"Nautical mile), in2 (square inch), ft2 (square foot), yd2 (square yard), "
"acre, ha (hectare)."
msgstr ""
"Ünnerstütte Rebeeteenheiten: m2 (Quadraatmeter), mi2 (Quadraatmiel), Nmi "
"(Quadraat nautisch Miel), in2 (Quadraattoll), ft2 (Quadraatfoot), yd2 "
"(Quadraat-Yard), acre, ha (Hektar)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 140
#: xml_doc.cpp:1326
msgid ""
"Supported speed units: m/s (meters per second), m/h (meters per hour), mph "
"(miles per hour), kn (knot)."
msgstr ""
"Ünnerstütt Gauheit-Eenheiten: m/s (Meter per Sekunn), m/h (Meter per Stunn), "
"mph (Mielen per Stunn), kn (Knütt)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 141
#: xml_doc.cpp:1329
msgid ""
"For metric units any of the following prefixes can be used: E (exa, 1E+18), "
"P (peta, 1E+15), T (tera, 1E+12), G (giga, 1E+09), M (mega, 1E+06), k (kilo, "
"1E+03), h (hecto, 1E+02), e (dekao, 1E+01), d (deci, 1E-01), c (centi, 1E-"
"02), m (milli, 1E-03), u (micro, 1E-06), n (nano, 1E-09), p (pico, 1E-12), f "
"(femto, 1E-15), a (atto, 1E-18)."
msgstr ""
"För metersch Eenheiten laat sik de nakamen Prefixen bruken: E (exa, 1E+18), "
"P (peta, 1E+15), T (tera, 1E+12), G (giga, 1E+09), M (mega, 1E+06), k (kilo, "
"1E+03), h (hekto, 1E+02), e (deka, 1E+01), d (dezi, 1E-01), c (zenti, 1E-"
"02), m (milli, 1E-03), u (mikro, 1E-06), n (nano, 1E-09), p (piko, 1E-12), f "
"(femto, 1E-15), a (atto, 1E-18)."

