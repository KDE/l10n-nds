#. i18n: tag Text
#. i18n: file functions/information.xml line 58
#: xml_doc.cpp:3235
msgid ""
"The ISLOGICAL() function returns True if the parameter is a boolean value. "
"Otherwise it returns False."
msgstr ""
"De Funkschoon ISLOGICAL() gifft \"wohr\" torüch, wenn de Parameter en "
"boolsch Weert is. Anners warrt \"falsch\" torüchgeven."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 59
#: xml_doc.cpp:3238
msgid "ISLOGICAL(x)"
msgstr "ISLOGICAL(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 60
#: xml_doc.cpp:3241
msgid "ISLOGICAL(A1>A2) returns True"
msgstr "ISLOGICAL(A1>A2) gifft \"wohr\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 61
#: xml_doc.cpp:3244
msgid "ISLOGICAL(12) returns False"
msgstr "ISLOGICAL(12) gifft \"falsch\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 73
#: xml_doc.cpp:3250
msgid ""
"The ISBLANK() function returns True if the parameter is empty. Otherwise it "
"returns False."
msgstr ""
"De Funkschoon ISBLANK() gifft \"wohr\" torüch, wenn de Parameter leddig is. "
"Anners warrt \"falsch\" torüchgeven."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 74
#: xml_doc.cpp:3253
msgid "ISBLANK(x)"
msgstr "ISBLANK(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 75
#: xml_doc.cpp:3256
msgid "ISBLANK(A1) returns True if A1 is empty"
msgstr "ISBLANK(A1) gifft \"wohr\" torüch, wenn A1 leddig is"

#. i18n: tag Example
#. i18n: file functions/information.xml line 76
#: xml_doc.cpp:3259
msgid "ISBLANK(A1) returns False if A1 holds a value"
msgstr "ISBLANK(A1) gifft \"falsch\" torüch, wenn A1 en Weert bargt"

#. i18n: tag Text
#. i18n: file functions/information.xml line 88
#: xml_doc.cpp:3265
msgid ""
"The ISNUMBER() function returns True if the parameter is a numerical value. "
"Otherwise it returns False. It's the same as ISNUM."
msgstr ""
"De Funkschoon ISNUMBER() gifft \"wohr\" torüch, wenn de Parameter en "
"numeersch Weert is. Anners warrt \"falsch\" torüchgeven. Dat is dat Sülvige "
"as \"ISNUM\"."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 89
#: xml_doc.cpp:3268
msgid "ISNUMBER(x)"
msgstr "ISNUMBER(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 90
#: xml_doc.cpp:3271
msgid "ISNUMBER(12) returns True"
msgstr "ISNUMBER(12) gifft \"wohr\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 91
#: xml_doc.cpp:3274
msgid "ISNUMBER(hello) returns False"
msgstr "ISNUMBER(Moin) gifft \"falsch\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 104
#: xml_doc.cpp:3280
msgid ""
"The ISNUM() function returns True if the parameter is a numerical value. "
"Otherwise it returns False. It's the same as ISNUMBER."
msgstr ""
"De Funkschoon ISNUM() gifft \"wohr\" torüch, wenn de Parameter en numeersch "
"Weert is. Anners warrt \"falsch\" torüchgeven. Dat is dat Sülvige as "
"\"ISNUMBER\"."

#. i18n: tag Syntax
