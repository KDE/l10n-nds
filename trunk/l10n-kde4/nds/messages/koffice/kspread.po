#. i18n: file: functions/bitops.xml:5
#: xml_doc.cpp:2
msgid "Bit Operations"
msgstr "Bit-Akschonen"

#. i18n: file: functions/bitops.xml:11
#. i18n: file: functions/bitops.xml:30
#. i18n: file: functions/bitops.xml:48
#. i18n: file: functions/bitops.xml:66
#. i18n: file: functions/bitops.xml:85
#. i18n: file: functions/math.xml:71
#. i18n: file: functions/math.xml:92
#: xml_doc.cpp:4 xml_doc.cpp:14 xml_doc.cpp:22 xml_doc.cpp:30 xml_doc.cpp:40
#: xml_doc.cpp:2479 xml_doc.cpp:2493
msgid "First number"
msgstr "Eerst Tall"

#. i18n: file: functions/bitops.xml:15
#. i18n: file: functions/bitops.xml:70
#. i18n: file: functions/bitops.xml:89
#. i18n: file: functions/math.xml:75
#. i18n: file: functions/math.xml:96
#: xml_doc.cpp:6 xml_doc.cpp:32 xml_doc.cpp:42 xml_doc.cpp:2481
#: xml_doc.cpp:2495
msgid "Second number"
msgstr "Tweet Tall"

#. i18n: file: functions/bitops.xml:19
#: xml_doc.cpp:8
msgid ""
"The BITAND() function performs a bit-wise AND operation for the two integer "
"parameters."
msgstr ""
"De Funkschoon BITAND() föhrt en bitwies AND-Operatschoon för de twee "
"Heeltall-Parameters ut."

#. i18n: file: functions/bitops.xml:20
#: xml_doc.cpp:10
msgid "BITAND(value; value)"
msgstr "BITAND(Weert; Weert)"

#. i18n: file: functions/bitops.xml:21
#: xml_doc.cpp:12
msgid ""
"BITAND(12;10) returns 8 (because decimal 12 is binary 1100, and decimal 10 "
"is binary 1010; and 1100 \"anded\" with 1010 is 1000, which is integer 8)."
msgstr ""
"BITAND(12;10) gifft 8 torüch (wiel dezimaal 12 bineer 1100 is, un dezimaal "
"10 bineer 1010 is. 1100 AND 1010 is 1000, un dat is de Heeltall 8)."

#. i18n: file: functions/bitops.xml:34
#: xml_doc.cpp:16
msgid "Amount to left shift by"
msgstr "Tall vun Versatzsteden na links"

#. i18n: file: functions/bitops.xml:38
#: xml_doc.cpp:18
msgid ""
"The BITLSHIFT() function performs a bit-wise left shift operation of the "
"first parameter. The number of bits to shift by is specified by the second "
"parameter. Note that a negative number of bits to left shift by becomes a "
"right shift. "
msgstr ""
"De Funkschoon BITLSHIFT() verschufft den eersten Parameter bitwies na links. "
"De Bitversatzsteden warrt dör den tweten Parameter angeven. Beacht, dat en "
"negativ Bitverschuven-Weert na links en Bitverschuven na rechts bedüüdt. "

#. i18n: file: functions/bitops.xml:39
#: xml_doc.cpp:20
msgid "BITLSHIFT(value; shift size)"
msgstr "BITLSHIFT(Weert, Versatzgrött)"

#. i18n: file: functions/bitops.xml:52
#: xml_doc.cpp:24
msgid "Amount to right shift by"
msgstr "Tall vun Versatzsteden na rechts"

#. i18n: file: functions/bitops.xml:56
#: xml_doc.cpp:26
msgid ""
"The BITRSHIFT() function performs a bit-wise right shift operation of the "
"first parameter. The number of bits to shift by is specified by the second "
"parameter. Note that a negative number of bits to right shift by becomes a "
"left shift. "
msgstr ""
"De Funkschoon BITRSHIFT() verschufft den eersten Parameter bitwies na "
"rechts. De Bitversatzsteden warrt dör den tweten Parameter angeven. Beacht, "
"dat en negativ Bitverschuven-Weert na rechts en Bitverschuven na links "
"bedüüdt. "

#. i18n: file: functions/bitops.xml:57
#: xml_doc.cpp:28
msgid "BITRSHIFT(value; shift size)"
msgstr "BITRSHIFT(Weert, Versatzgrött)"

#. i18n: file: functions/bitops.xml:74
#: xml_doc.cpp:34
msgid ""
"The BITOR() function performs a bit-wise OR operation for the two integer "
"parameters. "
msgstr ""
"De Funkschoon BITOR() föhrt en bitwies OR-Operatschoon för de twee Heeltall-"
"Parameters ut. "

#. i18n: file: functions/bitops.xml:75
#: xml_doc.cpp:36
msgid "BITOR(value; value)"
msgstr "BITOR(Weert; Weert)"

#. i18n: file: functions/bitops.xml:76
#: xml_doc.cpp:38
msgid ""
"BITOR(12;10) returns 14 (because decimal 12 is binary 1100, and decimal 10 "
"is binary 1010; and 1100 \"ored\" with 1010 is 1110, which is integer 14)."
msgstr ""
"BITOR(12;10) gifft 14 torüch (wiel dezimaal 12 bineer 1100 is, un dezimaal "
"10 bineer 1010 is. 1100 OR 1010 is 1100, un dat is de Heeltall 14)."

#. i18n: file: functions/bitops.xml:93
#: xml_doc.cpp:44
msgid ""
"The BITXOR() function performs a bit-wise exclusive-OR operation for the two "
"integer parameters. "
msgstr ""
"De Funkschoon BITXOR() föhrt en bitwies XOR-Operatschoon för de twee "
"Heeltall-Parameters ut. "

#. i18n: file: functions/bitops.xml:94
#: xml_doc.cpp:46
msgid "BITXOR(value; value)"
msgstr "BITXOR(Weert; Weert)"

#. i18n: file: functions/bitops.xml:95
#: xml_doc.cpp:48
msgid ""
"BITXOR(12;10) returns 6 (because decimal 12 is binary 1100, and decimal 10 "
"is binary 1010; and 1100 \"xored\" with 1010 is 0110, which is integer 6)."
msgstr ""
"BITXOR(12;10) gifft 6 torüch (wiel dezimaal 12 bineer 1100 is, un dezimaal "
"10 bineer 1010 is. 1100 XOR 1010 is 0110, un dat is de Heeltall 6)."

#. i18n: file: functions/conversion.xml:5
#: xml_doc.cpp:50
msgid "Conversion"
msgstr "Ümwanneln"

#. i18n: file: functions/conversion.xml:11
#. i18n: file: functions/conversion.xml:44
#: xml_doc.cpp:52 xml_doc.cpp:76
msgid "Bool value to convert"
msgstr "Boolsch Weert, de ümwannelt warrn schall"

#. i18n: file: functions/conversion.xml:15
#: xml_doc.cpp:54
msgid ""
"The BOOL2STRING() function returns a string value for a given boolean value. "
"This method is intended for using a boolean in methods which require a string"
msgstr ""
"De Funkschoon BOOL2STRING() gifft en Tekenkeed för en angeven boolsch Weert "
"torüch. Dit is goot för den Bruuk vun boolsch Weerten in Metoden, de en "
"Tekenkeed verwacht"

#. i18n: file: functions/conversion.xml:16
#: xml_doc.cpp:56
msgid "BOOL2STRING(value)"
msgstr "BOOL2STRING(Weert)"

#. i18n: file: functions/conversion.xml:17
#: xml_doc.cpp:58
msgid "BOOL2STRING(true) returns \"True\""
msgstr "BOOL2STRING(wohr) gifft \"wohr\" torüch"

#. i18n: file: functions/conversion.xml:18
#: xml_doc.cpp:60
msgid "BOOL2STRING(false) returns \"False\""
msgstr "BOOL2STRING(falsch) gifft \"falsch\" torüch"

#. i18n: file: functions/conversion.xml:19
#: xml_doc.cpp:62
msgid "upper(BOOL2STRING(find(\"nan\";\"banana\"))) returns TRUE"
msgstr "upper(BOOL2STRING(find(\"naa\";\"Banaan\"))) gifft \"wohr\" torüch"

#. i18n: file: functions/conversion.xml:27
#: xml_doc.cpp:64
msgid "Integer value to convert"
msgstr "Heeltallweert, de ümwannelt warrn schall"

#. i18n: file: functions/conversion.xml:31
#: xml_doc.cpp:66
msgid ""
"The INT2BOOL() function returns a boolean value for a given integer number. "
"This method is intended for using an integer in methods which require a "
"boolean. It only accepts 0 or 1. If any other value is given, false is "
"returned."
msgstr ""
"De Funkschoon INT2BOOL() gifft en boolsch Weert för en angeven Heeltall "
"torüch. Dit is goot för den Bruuk vun Heeltallen in Metoden, de en boolsch "
"Weert verwacht. Tolaten is bloots \"0\" oder \"1\". För anner Weerten warrt "
"\"falsch\" torüchgeven."

#. i18n: file: functions/conversion.xml:32
#: xml_doc.cpp:68
msgid "INT2BOOL(value)"
msgstr "INT2BOOL(Weert)"

#. i18n: file: functions/conversion.xml:33
#: xml_doc.cpp:70
msgid "INT2BOOL(1) returns true"
msgstr "INT2BOOL(1) gifft \"wohr\" torüch"

#. i18n: file: functions/conversion.xml:34
#: xml_doc.cpp:72
msgid "INT2BOOL(0) returns false"
msgstr "INT2BOOL(0) gifft \"falsch\" torüch"

#. i18n: file: functions/conversion.xml:35
#: xml_doc.cpp:74
msgid "OR(INT2BOOL(1); false) returns true"
msgstr "OR(INT2BOOL(1); falsch) gifft \"wohr\" torüch"

#. i18n: file: functions/conversion.xml:48
#: xml_doc.cpp:78
msgid ""
"The BOOL2INT() function returns an integer value for a given boolean value. "
"This method is intended for using a boolean value in methods which require "
"an integer."
msgstr ""
"De Funkschoon BOOL2INT() gifft en Heeltall för en angeven boolsch Weert "
"torüch. Dit is goot för den Bruuk vun boolsch Weerten in Metoden, de en "
"Heeltall verwacht."

#. i18n: file: functions/conversion.xml:49
#: xml_doc.cpp:80
msgid "BOOL2INT(value)"
msgstr "BOOL2INT(Weert)"

#. i18n: file: functions/conversion.xml:50
#: xml_doc.cpp:82
msgid "BOOL2INT(True) returns 1"
msgstr "BOOL2INT(wohr) gifft \"1\" torüch"

#. i18n: file: functions/conversion.xml:51
#: xml_doc.cpp:84
msgid "BOOL2INT(False) returns 0"
msgstr "BOOL2INT(falsch) gifft \"0\" torüch"

#. i18n: file: functions/conversion.xml:60
#. i18n: file: functions/conversion.xml:77
#: xml_doc.cpp:86 xml_doc.cpp:98
msgid "Number to convert into string"
msgstr "Tall, de na en Tekenkeed ümwannelt warrn schall"

#. i18n: file: functions/conversion.xml:64
#: xml_doc.cpp:88
msgid ""
"The NUM2STRING() function returns a string value for a given number. Note "
"that KSpread can auto-covert numbers to strings if needed, so this function "
"should rarely be needed."
msgstr ""
"De Funkschoon NUM2STRING() gifft en Tekenkeed för en angeven Tall torüch. "
"Beacht, dat KSpread Tallen automaatsch na Tekenkeden ümwanneln kann, wenn "
"dat nödig deit, so dat disse Funkschoon normalerwies wull nich bruukt warrt."

#. i18n: file: functions/conversion.xml:65
#: xml_doc.cpp:90
msgid "NUM2STRING(value)"
msgstr "NUM2STRING(Weert)"

#. i18n: file: functions/conversion.xml:66
#: xml_doc.cpp:92
msgid "NUM2STRING(10) returns \"10\""
msgstr "NUM2STRING(10) gifft \"10\" torüch"

#. i18n: file: functions/conversion.xml:67
#: xml_doc.cpp:94
msgid "NUM2STRING(2.05) returns \"2.05\""
msgstr "NUM2STRING(2,05) gifft \"2,05\" torüch"

#. i18n: file: functions/conversion.xml:68
#: xml_doc.cpp:96
msgid "=find(\"101\";NUM2STRING(A1)) (A1 = 2.010102) returns True"
msgstr "=find(\"101\";NUM2STRING(A1)) (A1 = 2,010102) gifft \"wohr\" torüch"

#. i18n: file: functions/conversion.xml:81
#: xml_doc.cpp:100
msgid ""
"The STRING() function returns a string value for a given number. It is the "
"same as the NUM2STRING function."
msgstr ""
"De Funkschoon STRING() gifft en Tekenkeedweert för en angeven Tall torüch. "
"Dat is dat sülve as de Funkschoon NUM2STRING."

#. i18n: file: functions/conversion.xml:90
#: xml_doc.cpp:102
msgid "A one character string to convert"
msgstr "En Tekenkeed ut een Bookstaav, de ümwannelt warrn schall"

#. i18n: file: functions/conversion.xml:94
#: xml_doc.cpp:104
msgid ""
"The CHARTOASCII() function returns the ASCII code for the given character."
msgstr ""
"De Funkschoon CHARTOASCII() gifft den ASCII-Kode vun en angeven Teken torüch."

#. i18n: file: functions/conversion.xml:95
#: xml_doc.cpp:106
msgid "CHARTOASCII(value)"
msgstr "CHARTOASCII(Weert)"

#. i18n: file: functions/conversion.xml:96
#: xml_doc.cpp:108
msgid "CHARTOASCII(\"v\") returns 118"
msgstr "CHARTOASCII(\"v\") gifft \"118\" torüch"

#. i18n: file: functions/conversion.xml:97
#: xml_doc.cpp:110
msgid "CHARTOASCII(r) is an error. The character must be in quotes."
msgstr "CHARTOASCII(r) is en Fehler. Dat Teken mutt in Goosfööt angeven warrn."

#. i18n: file: functions/conversion.xml:105
#: xml_doc.cpp:112
msgid "The ASCII values to convert"
msgstr "De ASCII-Weerten, de ümwannelt warrn schöölt"

#. i18n: file: functions/conversion.xml:109
#: xml_doc.cpp:114
msgid ""
"The ASCIITOCHAR() function returns the character for each given ASCII code"
msgstr ""
"De Funkschoon ASCIITOCHAR() giff dat Teken för elk angeven ASCII-Kode torüch"

#. i18n: file: functions/conversion.xml:110
#: xml_doc.cpp:116
msgid "ASCIITOCHAR(value)"
msgstr "ASCIITOCHAR(Weert)"

#. i18n: file: functions/conversion.xml:111
#: xml_doc.cpp:118
msgid "ASCIITOCHAR(118) returns \"v\""
msgstr "ASCIITOCHAR(118) gifft \"v\" torüch"

#. i18n: file: functions/conversion.xml:112
#: xml_doc.cpp:120
msgid "ASCIITOCHAR(75; 68; 69) returns \"KDE\""
msgstr "ASCIITOCHAR(75; 68; 69) gifft \"KDE\" torüch"

#. i18n: file: functions/conversion.xml:120
#. i18n: file: functions/conversion.xml:142
#: xml_doc.cpp:122 xml_doc.cpp:134
msgid "Value in X"
msgstr "Weert in X"

#. i18n: file: functions/conversion.xml:124
#. i18n: file: functions/conversion.xml:146
#: xml_doc.cpp:124 xml_doc.cpp:136
msgid "Value in Y"
msgstr "Weert in Y"

#. i18n: file: functions/conversion.xml:128
#: xml_doc.cpp:126
msgid ""
"The POLR() function returns the radius corresponding to the position of a "
"point in a cartesian landmark."
msgstr ""
"De Funkschoon POLR() gifft dat tohören Halfmaat för en Punkt sien "
"Positschoon binnen en kartees'sch Koordinatensysteem torüch."

#. i18n: file: functions/conversion.xml:129
#: xml_doc.cpp:128
msgid "POLR(X;Y)"
msgstr "POLR(X;Y)"

#. i18n: file: functions/conversion.xml:130
#: xml_doc.cpp:130
msgid "POLR(12;12) returns 16.9705"
msgstr "POLR(12;12) gifft \"16,9705\" torüch"

#. i18n: file: functions/conversion.xml:131
#: xml_doc.cpp:132
msgid "POLR(12;0) returns 12"
msgstr "POLR(12;0) gifft \"12\" torüch"

#. i18n: file: functions/conversion.xml:150
#: xml_doc.cpp:138
msgid ""
"The POLA() function returns the angle (in radians) corresponding to the "
"position of a point in a cartesian landmark."
msgstr ""
"De Funkschoon POLA() gifft den Winkel (in Bagenmaat) för en Punkt sien "
"Positschoon binnen en kartees'sch Koordinatensysteem torüch."

#. i18n: file: functions/conversion.xml:151
#: xml_doc.cpp:140
msgid "POLA(X;Y)"
msgstr "POLA(X;Y)"

#. i18n: file: functions/conversion.xml:152
#: xml_doc.cpp:142
msgid "POLA(12;12) returns 0.78539816"
msgstr "POLA(12;12) gifft \"0,78539816\" torüch"

#. i18n: file: functions/conversion.xml:153
#: xml_doc.cpp:144
msgid "POLA(12;0) returns 0"
msgstr "POLA(12;0) gifft \"0\" torüch"

#. i18n: file: functions/conversion.xml:154
#: xml_doc.cpp:146
msgid "POLA(0;12) returns 1.5707"
msgstr "POLA(0;12) gifft \"1,5707\" torüch"

#. i18n: file: functions/conversion.xml:165
#. i18n: file: functions/conversion.xml:225
