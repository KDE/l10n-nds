#: xml_doc.cpp:2501 xml_doc.cpp:2666 xml_doc.cpp:2782 xml_doc.cpp:2809
msgid "Type (optional)"
msgstr "Typ (optschonaal)"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 658
#: xml_doc.cpp:2504
msgid ""
"IPMT calculates the amount of a payment of an annuity going towards interest."
msgstr "PPMT reekt den Utbetahlbedrag för en Rent vun en Tinstahlen ut."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 659
#. i18n: tag Text
#. i18n: file functions/financial.xml line 695
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1027
#: xml_doc.cpp:2507 xml_doc.cpp:2549 xml_doc.cpp:2815
msgid "Rate is the periodic interest rate."
msgstr "Tins is de perioodsch Tinssatz."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 660
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1028
#: xml_doc.cpp:2510 xml_doc.cpp:2818
msgid ""
"Period is the amortizement period. 1 for the first and NPER for the last "
"period."
msgstr ""
"Periood is de Tilgenperiood. \"1\" för de eerste un \"NPER\" för de leste "
"Periood."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 661
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1029
#: xml_doc.cpp:2513 xml_doc.cpp:2821
msgid "NPER is the total number of periods during which annuity is paid."
msgstr "NPER sünd all Perioden wielt de en Rent betahlt warrt."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 662
#. i18n: tag Text
#. i18n: file functions/financial.xml line 698
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1030
#: xml_doc.cpp:2516 xml_doc.cpp:2558 xml_doc.cpp:2824
msgid "PV is the present value in the sequence of payments."
msgstr "PV is de aktuell Weert binnen en Reeg vun Betahlen."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 663
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1031
#: xml_doc.cpp:2519 xml_doc.cpp:2827
msgid "FV (optional) is the desired (future) value.  default: 0."
msgstr "FV (optschonaal) is de verwacht (tokamen) Weert. Standard: 0."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 664
#. i18n: tag Text
#. i18n: file functions/financial.xml line 1032
#: xml_doc.cpp:2522 xml_doc.cpp:2830
msgid ""
"Type (optional) defines the due date. 1 for payment at the beginning of a "
"period and 0 (default) for payment at the end of a period."
msgstr ""
"Typ (optschonaal) leggt de Duer fast: 1 för Betahlen an'n Anfang vun en "
"Periood, un 0 (Standard) för Betahlen an't Enn vun de Periood."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 665
#: xml_doc.cpp:2525
msgid ""
"The example shows the interest to pay in the last year of a three year loan. "
"The interest rate is 10 percent."
msgstr ""
"Dat Bispill wiest de Tinsen, de in't leste Johr för en Kredit mit dree "
"Johren Looptiet betahlt warrn mööt. De Tinssatz is 10 Perzent."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 666
#: xml_doc.cpp:2528
msgid "IPMT(Rate; Period; NPer; PV; FV; Type)"
msgstr "IPMT(Tins; Periood; NPer; PV; FV; Typ)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 667
#: xml_doc.cpp:2531
msgid "IPMT(0.1;3;3;8000) equals -292.45"
msgstr "IPMT(0.1;3;3;8000) gifft \"-292.45\" torüch"

#. i18n: tag Comment
#. i18n: file functions/financial.xml line 690
#: xml_doc.cpp:2543
msgid "Present values (PV)"
msgstr "Aktuell Weerten (PV)"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 694
#: xml_doc.cpp:2546
msgid "Calculates the interest paid on a given period of an investment."
msgstr "Reekt den binnen en angeven Periood betahlt Tins vun en Geldanlaag ut."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 696
#: xml_doc.cpp:2552
msgid ""
"Period is the amortizement period. 1 for the first and NPer for the last "
"period."
msgstr ""
"Periood is de Tilgenperiood. \"1\" för de eerste un \"NPER\" för de leste "
"Periood."

#. i18n: tag Text
#. i18n: file functions/financial.xml line 697
#: xml_doc.cpp:2555
msgid "NPer is the total number of periods during which annuity is paid."
msgstr "NPer sünd all Perioden wielt de en Rent betahlt warrt."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 699
#: xml_doc.cpp:2561
msgid "ISPMT(Rate; Period; NPer; PV)"
msgstr "ISPMT(Tins; Periood; NPer; PV)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 700
#: xml_doc.cpp:2564
msgid "ISPMT(0.1; 1; 3; 8000000) equals -533333"
msgstr "ISPMT(0.1; 1; 3; 8000000) gifft \"-533333\" torüch"

#. i18n: tag Comment
#. i18n: file functions/financial.xml line 713
#. i18n: tag Comment
#. i18n: file functions/financial.xml line 1455
#: xml_doc.cpp:2567 xml_doc.cpp:3171
msgid "Face value"
msgstr "Nennweert"

#. i18n: tag Comment
#. i18n: file functions/financial.xml line 717
#: xml_doc.cpp:2570
msgid "Coupon rate"
msgstr "Anlehntins"

#. i18n: tag Comment
#. i18n: file functions/financial.xml line 721
#: xml_doc.cpp:2573
msgid "Coupons per year"
msgstr "Anlehnen per Johr"

#. i18n: tag Comment
#. i18n: file functions/financial.xml line 729
#: xml_doc.cpp:2579
msgid "Market interest rate"
msgstr "Markttinssatz"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 733
#: xml_doc.cpp:2583
#, no-c-format
msgid ""
"The LEVEL_COUPON() function calculates the value of a level-coupon bond. For "
"example: if the interest rate is 10%, a $1000 bond with semi-annual coupons "
"at a rate of 13% that matures in 4 years is worth LEVEL_COUPON"
"(1000;.13;2;4;.1) or $1096.95."
msgstr ""
"De Funkschoon LEVEL_COUPON() reekt den Weert vun en Kuponanlehn ut. Bispill: "
"Bi en Tinssatz vun 10% is en Anlehn för 1000 Dollar mit halfjohrig Kupons "
"mit en Tins vun13% un veer Johren Looptiet LEVEL_COUPON(1000;.13;2;4;0,1) "
"oder 1096.95 Dollar weert."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 734
#: xml_doc.cpp:2586
msgid "LEVEL_COUPON(face value;coupon rate;coupons per year;years;market rate)"
msgstr "LEVEL_COUPON(Nennweert;Anlehntins;Kupons per Johr:Johren:Markttins)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 735
#: xml_doc.cpp:2589
msgid "LEVEL_COUPON(1000;.13;2;4;.1) equals 1096.95"
msgstr "LEVEL_COUPON(1000;0,13;2;4;0,1) gifft \"1096,95\" torüch"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 767
#: xml_doc.cpp:2610
msgid ""
"The MDURATION() function will calculate the modified Macauley duration of a "
"fixed interest security in years."
msgstr ""
"De Funkschoon MDURATION() reekt de ännert Macauley-Duer vun en "
"fastvertinslich Weertpapeer in Johren ut."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 768
#: xml_doc.cpp:2613
msgid "MDURATION( Settlement; Maturity; Coupon; Yield; Frequency; [ Basis=0 ])"
msgstr ""
"MDURATION( Utbetahldatum; Afloopdatum; Kupon, Winn, Periood; [ Basis=0 ])"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 769
#: xml_doc.cpp:2616
msgid ""
"MDURATION(\"2004-02-01\"; \"2004-05-31\"; 0.08; 0.09; 2; 0) returns "
"0.316321106"
msgstr ""
"MDURATION(\"2004-02-01\"; \"2004-05-31\"; 0.08; 0.09; 2; 0) gifft "
"0.316321106 torüch"

#. i18n: tag Comment
