#: xml_doc.cpp:78 xml_doc.cpp:114
msgid "Bool value to convert"
msgstr "Boolsch Weert, de ümwannelt warrn schall"

#. i18n: tag Text
#. i18n: file functions/conversion.xml line 15
#: xml_doc.cpp:81
msgid ""
"The BOOL2STRING() function returns a string value for a given boolean value. "
"This method is intended for using a boolean in methods which require a string"
msgstr ""
"De Funkschoon BOOL2STRING() gifft en Tekenkeed för en angeven boolsch Weert "
"torüch. Dit is goot för den Bruuk vun boolsch Weerten in Metoden, de en "
"Tekenkeed verwacht"

#. i18n: tag Syntax
#. i18n: file functions/conversion.xml line 16
#: xml_doc.cpp:84
msgid "BOOL2STRING(value)"
msgstr "BOOL2STRING(Weert)"

#. i18n: tag Example
#. i18n: file functions/conversion.xml line 17
#: xml_doc.cpp:87
msgid "BOOL2STRING(true) returns \"True\""
msgstr "BOOL2STRING(wohr) gifft \"wohr\" torüch"

#. i18n: tag Example
#. i18n: file functions/conversion.xml line 18
#: xml_doc.cpp:90
msgid "BOOL2STRING(false) returns \"False\""
msgstr "BOOL2STRING(falsch) gifft \"falsch\" torüch"

#. i18n: tag Example
#. i18n: file functions/conversion.xml line 19
#: xml_doc.cpp:93
msgid "upper(BOOL2STRING(find(\"nan\";\"banana\"))) returns TRUE"
msgstr "upper(BOOL2STRING(find(\"naa\";\"Banaan\"))) gifft \"wohr\" torüch"

#. i18n: tag Comment
#. i18n: file functions/conversion.xml line 27
#: xml_doc.cpp:96
msgid "Integer value to convert"
msgstr "Heeltallweert, de ümwannelt warrn schall"

#. i18n: tag Text
#. i18n: file functions/conversion.xml line 31
#: xml_doc.cpp:99
msgid ""
"The INT2BOOL() function returns a boolean value for a given integer number. "
"This method is intended for using an integer in methods which require a "
"boolean. It only accepts 0 or 1. If any other value is given, false is "
"returned."
msgstr ""
"De Funkschoon INT2BOOL() gifft en boolsch Weert för en angeven Heeltall "
"torüch. Dit is goot för den Bruuk vun Heeltallen in Metoden, de en boolsch "
"Weert verwacht. Tolaten is bloots \"0\" oder \"1\". För anner Weerten warrt "
"\"falsch\" torüchgeven."

#. i18n: tag Syntax
#. i18n: file functions/conversion.xml line 32
#: xml_doc.cpp:102
msgid "INT2BOOL(value)"
msgstr "INT2BOOL(Weert)"

#. i18n: tag Example
#. i18n: file functions/conversion.xml line 33
#: xml_doc.cpp:105
msgid "INT2BOOL(1) returns true"
msgstr "INT2BOOL(1) gifft \"wohr\" torüch"

#. i18n: tag Example
#. i18n: file functions/conversion.xml line 34
#: xml_doc.cpp:108
msgid "INT2BOOL(0) returns false"
msgstr "INT2BOOL(0) gifft \"falsch\" torüch"

#. i18n: tag Example
#. i18n: file functions/conversion.xml line 35
#: xml_doc.cpp:111
msgid "OR(INT2BOOL(1); false) returns true"
msgstr "OR(INT2BOOL(1); falsch) gifft \"wohr\" torüch"

#. i18n: tag Text
#. i18n: file functions/conversion.xml line 48
#: xml_doc.cpp:117
msgid ""
"The BOOL2INT() function returns an integer value for a given boolean value. "
"This method is intended for using a boolean value in methods which require "
"an integer."
msgstr ""
"De Funkschoon BOOL2INT() gifft en Heeltall för en angeven boolsch Weert "
"torüch. Dit is goot för den Bruuk vun boolsch Weerten in Metoden, de en "
"Heeltall verwacht."

#. i18n: tag Syntax
#. i18n: file functions/conversion.xml line 49
#: xml_doc.cpp:120
msgid "BOOL2INT(value)"
msgstr "BOOL2INT(Weert)"

#. i18n: tag Example
#. i18n: file functions/conversion.xml line 50
#: xml_doc.cpp:123
msgid "BOOL2INT(True) returns 1"
msgstr "BOOL2INT(wohr) gifft \"1\" torüch"

#. i18n: tag Example
#. i18n: file functions/conversion.xml line 51
#: xml_doc.cpp:126
msgid "BOOL2INT(False) returns 0"
msgstr "BOOL2INT(falsch) gifft \"0\" torüch"

#. i18n: tag Comment
#. i18n: file functions/conversion.xml line 60
#. i18n: tag Comment
#. i18n: file functions/conversion.xml line 77
#: xml_doc.cpp:129 xml_doc.cpp:147
msgid "Number to convert into string"
msgstr "Tall, de na en Tekenkeed ümwannelt warrn schall"

#. i18n: tag Text
#. i18n: file functions/conversion.xml line 64
#: xml_doc.cpp:132
msgid ""
"The NUM2STRING() function returns a string value for a given number. Note "
"that KSpread can auto-covert numbers to strings if needed, so this function "
"should rarely be needed."
msgstr ""
"De Funkschoon NUM2STRING() gifft en Tekenkeed för en angeven Tall torüch. "
"Beacht, dat KSpread Tallen automaatsch na Tekenkeden ümwanneln kann, wenn "
"dat nödig deit, so dat disse Funkschoon normalerwies wull nich bruukt warrt."

#. i18n: tag Syntax
#. i18n: file functions/conversion.xml line 65
#: xml_doc.cpp:135
msgid "NUM2STRING(value)"
msgstr "NUM2STRING(Weert)"

#. i18n: tag Example
#. i18n: file functions/conversion.xml line 66
#: xml_doc.cpp:138
msgid "NUM2STRING(10) returns \"10\""
msgstr "NUM2STRING(10) gifft \"10\" torüch"

#. i18n: tag Example
#. i18n: file functions/conversion.xml line 67
#: xml_doc.cpp:141
msgid "NUM2STRING(2.05) returns \"2.05\""
msgstr "NUM2STRING(2,05) gifft \"2,05\" torüch"

