#. i18n: tag Example
#. i18n: file functions/information.xml line 138
#: xml_doc.cpp:3319
msgid "ISDATE(\"hello\") returns False"
msgstr "ISDATE(\"Moin\") gifft \"falsch\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 150
#: xml_doc.cpp:3325
msgid ""
"The ISREF() function returns True if the parameter refers to a reference. "
"Otherwise it returns False"
msgstr ""
"De Funkschoon ISREF() gifft \"wohr\" torüch, wenn de Parameter na en Betog "
"verwiest. Anners warrt \"falsch\" torüchgeven"

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 151
#: xml_doc.cpp:3328
msgid "ISREF(x)"
msgstr "ISREF(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 152
#: xml_doc.cpp:3331
msgid "ISREF(A12) returns true"
msgstr "ISREF(A12) gifft \"wohr\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 153
#: xml_doc.cpp:3334
msgid "ISREF(\"hello\") returns false"
msgstr "ISREF(\"Moin\") gifft \"falsch\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 165
#: xml_doc.cpp:3340
msgid ""
"The ISTEXT() function returns True if the parameter is a string. Otherwise "
"it returns False"
msgstr ""
"De Funkschoon ISTEXT() gifft \"wohr\" torüch, wenn de Parameter en Tekenkeed "
"is. Anners warrt \"falsch\" torüchgeven"

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 166
#: xml_doc.cpp:3343
msgid "ISTEXT(x)"
msgstr "ISTEXT(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 167
#: xml_doc.cpp:3346
msgid "ISTEXT(12) returns False"
msgstr "ISTEXT(12) gifft \"falsch\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 168
#: xml_doc.cpp:3349
msgid "ISTEXT(\"hello\") returns True"
msgstr "ISTEXT(\"Moin\") gifft \"wohr\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 180
#: xml_doc.cpp:3355
msgid ""
"The ISNONTEXT() function returns True if the parameter is not a string. "
"Otherwise it returns False. It's the same as ISNOTTEXT."
msgstr ""
"De Funkschoon ISNONTEXT() gifft \"wohr\" torüch, wenn de Parameter keen "
"Tekenkeed is. Anners warrt \"falsch\" torüchgeven. Dat is dat Sülvige as "
"\"ISNOTTEXT\"."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 181
#: xml_doc.cpp:3358
msgid "ISNONTEXT(x)"
msgstr "ISNONTEXT(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 182
#: xml_doc.cpp:3361
msgid "ISNONTEXT(12) returns True"
msgstr "ISNONTEXT(12) gifft \"wohr\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 183
#: xml_doc.cpp:3364
msgid "ISNONTEXT(\"hello\") returns False"
msgstr "ISNONTEXT(\"Moin\") gifft \"falsch\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 196
#: xml_doc.cpp:3370
msgid ""
"The ISNOTTEXT() function returns True if the parameter is not a string. "
"Otherwise it returns False. It's the same as ISNONTEXT."
msgstr ""
"De Funkschoon ISNOTTEXT() gifft \"wohr\" torüch, wenn de Parameter keen "
"Tekenkeed is. Anners warrt \"falsch\" torüchgeven. Dat is dat Sülvige as "
"\"ISNONEXT\"."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 197
#: xml_doc.cpp:3373
msgid "ISNOTTEXT(x)"
msgstr "ISNOTTEXT(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 198
#: xml_doc.cpp:3376
msgid "ISNOTTEXT(12) returns True"
msgstr "ISNOTTEXT(12) gifft \"wohr\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 199
#: xml_doc.cpp:3379
msgid "ISNOTTEXT(\"hello\") returns False"
msgstr "ISNOTTEXT(\"Moin\") gifft \"falsch\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 212
#: xml_doc.cpp:3385
msgid ""
"The ISODD() function returns True if the number is odd. Otherwise returns "
"False."
msgstr ""
"De Funkschoon ISODD() gifft \"wohr\" ut, wenn de Tall uneven is. Anners "
"warrt \"falsch\" utgeven."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 213
#: xml_doc.cpp:3388
msgid "ISODD(x)"
msgstr "ISODD(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 214
#: xml_doc.cpp:3391
msgid "ISODD(12) returns False"
msgstr "ISODD(12) gifft \"falsch\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 215
#: xml_doc.cpp:3394
msgid "ISODD(-7) returns True"
msgstr "ISODD(-7) gifft \"wohr\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 227
#: xml_doc.cpp:3400
msgid ""
"The ISEVEN() function returns True if the number is even. Otherwise returns "
"False."
msgstr ""
"De Funkschoon ISEVEN() gifft \"wohr\" ut, wenn de Tall even is. Anners warrt "
"\"falsch\" utgeven."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 228
#: xml_doc.cpp:3403
msgid "ISEVEN(x)"
msgstr "ISEVEN(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 229
#: xml_doc.cpp:3406
msgid "ISEVEN(12) returns True"
msgstr "ISEVEN(12) gifft \"wohr\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 230
#: xml_doc.cpp:3409
msgid "ISEVEN(-7) returns False"
msgstr "ISEVEN(-7) gifft \"falsch\" torüch"

#. i18n: tag Text
#. i18n: file functions/information.xml line 242
#: xml_doc.cpp:3415
msgid ""
"The ISERR() function returns True if its parameter is an error other than N/"
"A. Otherwise, it returns False. Use ISERROR() if you want to include the N/A "
"error as well."
msgstr ""
"De Funkschoon ISERR() gifft \"wohr\" torüch, wenn de Parameter en anner "
"Fehler as \"k.A.\" is. Anners warrt \"falsch\" torüchgeven. Bruuk \"ISERROR()"
"\", wenn ok de Fehler \"k.A.\" inslaten warrn schall."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 243
#: xml_doc.cpp:3418
msgid "ISERR(x)"
msgstr "ISERR(x)"

#. i18n: tag Text
#. i18n: file functions/information.xml line 257
#: xml_doc.cpp:3424
msgid ""
"The ISERROR() function returns True if its parameter is an error of any "
"type. Otherwise, it returns False."
msgstr ""
"De Funkschoon ISERROR() gifft \"wohr\" torüch, wenn de Parameter jichtenseen "
"Fehler is. Anners warrt \"falsch\" torüchgeven."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 258
#: xml_doc.cpp:3427
msgid "ISERROR(x)"
msgstr "ISERROR(x)"

#. i18n: tag Text
#. i18n: file functions/information.xml line 272
#: xml_doc.cpp:3433
msgid ""
"The ISNA() function returns True if its parameter is a N/A error. In all "
"other cases, it returns False."
msgstr ""
"De Funkschoon ISNA() gifft \"wohr\" torüch, wenn de Parameter en \"k.A.\"-"
"Fehler is. Anners warrt \"falsch\" torüchgeven."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 273
#: xml_doc.cpp:3436
msgid "ISNA(x)"
msgstr "ISNA(x)"

#. i18n: tag Text
#. i18n: file functions/information.xml line 283
#: xml_doc.cpp:3439
msgid "The NA() function returns the constant error value, N/A."
msgstr "De Funkschoon NA() gifft den fasten Fehlerweert \"n.v.\" torüch."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 284
#: xml_doc.cpp:3442
msgid "NA()"
msgstr "NA()"

#. i18n: tag Text
#. i18n: file functions/information.xml line 299
#: xml_doc.cpp:3448
msgid ""
"The TYPE() function returns 1 if the value is a number, 2 if it is text, 4 "
"if the value is a logical value, 16 if it is an error value or 64 if the "
"value is an array. If the cell the value represents contains a formula you "
"get its return type."
msgstr ""
"De Funkschoon TYPE() gifft \"1\" torüch, wenn de Weert en Tall is, \"2\" för "
"en Text, un \"4\", wenn de Weert en Logikweert is, \"16\" för en Fehlerweert "
"un \"64\" wenn de Weert en Feld is. Wenn de Zell, op de sik de Weert "
"betreckt, en Formel bargt, warrt ehr Torüchgaav-Weert utgeven."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 300
#: xml_doc.cpp:3451
msgid "TYPE(x)"
msgstr "TYPE(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 301
#: xml_doc.cpp:3454
msgid "TYPE(A1) returns 2, if A1 contains \"Text\""
msgstr "TYPE(A1) gifft \"2\" torüch, wenn A1 \"Text\" bargt"

#. i18n: tag Example
#. i18n: file functions/information.xml line 302
#: xml_doc.cpp:3457
msgid "TYPE(-7) returns 1"
msgstr "TYPE(-7) gifft \"1\" torüch"

#. i18n: tag Example
#. i18n: file functions/information.xml line 303
#: xml_doc.cpp:3460
msgid "TYPE(A2) returns 1, if A2 contains \"=CURRENTDATE()\""
msgstr "TYPE(A2) gifft \"1\" torüch, wenn A2 \"=CURRENTDATE()\" bargt"

#. i18n: tag Text
#. i18n: file functions/information.xml line 311
#: xml_doc.cpp:3463
msgid ""
"Returns the current filename. If the current document is not saved, an empty "
"string is returned."
msgstr ""
"Gifft den aktuellen Dateinaam ut. Wenn dat aktuelle Dokment nich sekert is, "
"warrt en leddig Tekenkeed torüchgeven."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 312
#: xml_doc.cpp:3466
msgid "FILENAME()"
msgstr "FILENAME()"

