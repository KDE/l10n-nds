msgstr ""
"De Funkschoon DATE2UNIX() wannelt en Datum- un Tietweert na en Unixdatum üm."

#. i18n: file: functions/datetime.xml:721
#. i18n: file: functions/datetime.xml:736
#: xml_doc.cpp:786 xml_doc.cpp:796
msgid "A unix time is the number of seconds after midnight January 1st, 1970."
msgstr "En Unixtiet is de Tall vun Sekunnen af Mittnacht vun'n 1. Januor 1970."

#. i18n: file: functions/datetime.xml:722
#: xml_doc.cpp:788
msgid "DATE2UNIX(date)"
msgstr "DATE2UNIX(Datum)"

#. i18n: file: functions/datetime.xml:723
#: xml_doc.cpp:790
msgid "DATE2UNIX(\"01/01/2000\") returns 946,681,200"
msgstr "DATE2UNIX(\"01/01/2000\") gifft 946,681,200 torüch"

#. i18n: file: functions/datetime.xml:731
#: xml_doc.cpp:792
msgid "Unixtime"
msgstr "Unixtiet"

#. i18n: file: functions/datetime.xml:735
#: xml_doc.cpp:794
