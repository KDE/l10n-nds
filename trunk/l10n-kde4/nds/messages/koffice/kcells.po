"database specified by a set of conditions."
msgstr ""
"Tellt de Zellen mit numeersch oder alphanumeersch Weerten binnen en "
"Datenbankstriep na en angeven Sett vun Bedingen."

#: functions/database.xml:91
msgid "DCOUNTA(Database; \"Header\"; Conditions)"
msgstr "DCOUNTA(Datenbank; \"Överschrift\"; Bedingen)"

#: functions/database.xml:92
