msgstr "De Verdelen ehr Standardverscheel"

#: functions/statistical.xml:847
msgid "The NORMDIST() function returns the normal cumulative distribution."
msgstr "De Funkschoon NORMDIST() gifft de kumulativ Normaalverdelen torüch."

#: functions/statistical.xml:848
msgid ""
"Number is the value of the distribution based on which the normal "
"distribution is to be calculated."
msgstr ""
"\"Tall\" is de Weert vun de Verdelen, op den dat Utreken för de "
"Normaalverdelen opbuut."

#: functions/statistical.xml:849
msgid "MV is the linear middle of the distribution."
msgstr "MV is de Verdelen ehr lineaar Middelweert."

#: functions/statistical.xml:850
msgid "STD is the standard deviation of the distribution."
msgstr "STD is de Verdelen ehr Standardverscheel."

#: functions/statistical.xml:851
msgid ""
"K = 0 calculates the density function; K = 1 calculates the distribution."
msgstr "K = 0 reekt de Dichtfunkschoon ut, K = 1 de Verdelen."

#: functions/statistical.xml:852
msgid "NORMDIST(Number;MV;STD;K)"
msgstr "NORMDIST(Tall;MV;STD;K)"

#: functions/statistical.xml:853
msgid "NORMDIST(0.859;0.6;0.258;0) equals 0.934236"
msgstr "NORMDIST(0,859;0,6;0,258;0) gifft \"0,934236\" torüch"

