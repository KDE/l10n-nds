msgid "ABS(12.5) equals 12.5"
msgstr "ABS(12,5) gifft \"12,5\" torüch"

#: functions/math.xml:911
msgid "ABS(-12.5) equals 12.5"
msgstr "ABS(-12,5) gifft \"12,5\" torüch"

#: functions/math.xml:923
msgid "The INT() function returns the integer part of the value."
msgstr "De Funkschoon INT() gifft den Weert sien Heeltalldeel torüch."

#: functions/math.xml:924
msgid "INT(x)"
msgstr "INT(x)"

#: functions/math.xml:925
msgid "INT(12.55) equals 12"
msgstr "INT(12,55) gifft \"12\" torüch"

#: functions/math.xml:926
msgid "INT(15) equals 15"
msgstr "INT(15) gifft \"15\" torüch"

#: functions/math.xml:936
msgid "The RAND() function returns a pseudo-random number between 0 and 1."
msgstr ""
"De Funkschoon RAND() gifft en pseudo-tofällig Tall twischen 0 un 1 torüch."

