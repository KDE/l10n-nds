msgstr "DGET(Datenbank; \"Överschrift\"; Bedingen)"

#: functions/database.xml:115
msgid "DGET(A1:C5; \"Salary\"; A9:A11)"
msgstr "DGET(A1:C5; \"Lohn\"; A9:A11)"

