msgstr "DSTDEV(Datenbank; \"Överschrift\"; Bedingen)"

#: functions/database.xml:205
msgid "DSTDEV(A1:C5; \"Salary\"; A9:A11)"
msgstr "DSTDEV(A1:C5; \"Lohn\"; A9:A11)"

#: functions/database.xml:226
