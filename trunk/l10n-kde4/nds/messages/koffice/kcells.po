msgstr ""
"De Funkschoon GAUSS() gifft de Integraalweerten för de kumulativ "
"Standardnormaalverdelen torüch."

#: functions/statistical.xml:487
msgid "GAUSS(value)"
msgstr "GAUSS(Weert)"

#: functions/statistical.xml:488
