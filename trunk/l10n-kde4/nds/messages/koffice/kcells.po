msgstr "De Funkschoon LOG2() gifft den Logaritmus to Basis 2 vun x torüch."

#: functions/math.xml:802
msgid "LOG2(x)"
msgstr "LOG2(x)"

#: functions/math.xml:803
msgid "LOG2(0.8) equals -0.32192809"
msgstr "LOG2(0,8) gifft \"-0,32192809\" torüch"

#: functions/math.xml:804
msgid "LOG2(0) equals -inf."
msgstr "LOG2(0) is \"-ahn Enn\"."

#: functions/math.xml:820
msgid ""
"The EXP() function returns the value of e (the base of natural logarithms) "
"raised to the power of x."
msgstr ""
"De Funkschoon EXP() gifft den Weert vun e (den natürlichen Logaritmus sien "
"Basis) hooch x torüch."

#: functions/math.xml:821
msgid "EXP(x)"
msgstr "EXP(x)"

