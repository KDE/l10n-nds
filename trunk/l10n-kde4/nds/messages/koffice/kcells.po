msgstr "POISSON(60;50;0) gifft \"0,020105\" torüch"

#: functions/statistical.xml:1000
msgid "POISSON(60;50;1) equals 0.927840"
msgstr "POISSON(60;50;1) gifft \"0,927840\" torüch"

