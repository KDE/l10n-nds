msgstr "De Funkschoon LEGACYFDIST() gifft de f-Verdelen torüch."

#: functions/statistical.xml:698
msgid "LEGACYFDIST(number;degrees_freedom_1;degrees_freedom_2)"
msgstr "LEGACYFDIST(Tall;Freeheitgraad_1;Freeheitgraad_2)"

