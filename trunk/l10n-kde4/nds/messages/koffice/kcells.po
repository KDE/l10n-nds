#~ msgid ""
#~ "The WEEKS() function returns the difference between two dates in weeks."
#~ "The third parameter indicates the calculation mode: if the mode is 0, "
#~ "WEEKS() returns the maximal possible number of weeks between those days. "
#~ "If the mode is 1, it only returns the number of whole weeks in between."
#~ msgstr ""
#~ "De Funkschoon WEEKS() gifft den Verscheel twischen twee Daag in Weken "
#~ "torüch. De drüdde Parameter gifft de Rekenmetood an: Metood 0 gifft de "
#~ "tohööchst mööglich Tall vun Weken twischen twee Daag torüch. Metood 1 "
#~ "gifft bloots de Tall vun heel Weken torüch."

#~ msgid "WEEKS(date2; date1; mode)"
#~ msgstr "WEEKS(Datum1; Datum2; Metood)"

#~ msgid ""
#~ "WEEKS(\"2002-02-18\"; \"2002-02-26\"; 0) returns 1, because there is one "
#~ "week and 1 day in between"
#~ msgstr ""
#~ "WEEKS(\"18.02.2002\"; \"26.02.2002\"; 0) gifft \"1\" torüch, wiel dor een "
#~ "Week un een Dag twischen liggt."

#~ msgid ""
#~ "WEEKS(\"2002-19-02\"; \"2002-19-02\"; 1) returns 0, because there is not "
#~ "a whole week in between, starting at the first day of the week (monday or "
#~ "sunday, depending on your local settings)"
#~ msgstr ""
#~ "WEEKS(\"19.02.2002\"; \"26.02.2002\"; 0) gifft \"0\" torüch, wiel dor "
#~ "keen heel Week twischen liggt, wenn Een an'n eersten Dag vun de Week "
#~ "(Maandag oder Sünndag, afhängig vun de Regiooninstellen) anfangt."

#~ msgid ""
#~ "The MONTHS() function returns the difference between two dates in months."
#~ "The third parameter indicates the calculation mode: if the mode is 0, "
#~ "MONTHS() returns the maximal possible number of months between those "
#~ "days. If the mode is 1, it only returns the number of complete months in "
#~ "between."
#~ msgstr ""
#~ "De Funkschoon MONTHS() gifft den Verscheel twischen twee Daag in Maanden "
#~ "torüch. De drüdde Parameter gifft de Rekenmetood an: Metood 0 gifft de "
#~ "tohööchst mööglich Tall vun Maanden twischen twee Daag torüch. Metood 1 "
#~ "gifft bloots de Tall vun heel Maanden torüch."

