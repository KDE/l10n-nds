msgstr "Middelweert binnen de Normaalverdelen"

#: functions/statistical.xml:870
msgid "Standard deviation of the normal distribution"
msgstr "Standardverscheel vun de Normaalverdelen"

#: functions/statistical.xml:874
msgid ""
"The NORMINV() function returns the inverse of the normal cumulative "
"distribution. The number must be between 0 and 1 (non-inclusive) and STD "
"must be positive."
msgstr ""
"De Funkschoon NORMINV() gifft de Inverschoon (Ümdreihen) vun de kumulativ "
"Normaalverdelen torüch. De Tall mutt twischen 0 un 1 wesen (nich-inklusiv) "
"un STD mutt positiv wesen."

#: functions/statistical.xml:875
msgid "NORMINV(number;MV;STD)"
msgstr "NORMINV(Tall;MV;STD)"

#: functions/statistical.xml:876
msgid "NORMINV(0.9;63;5) equals 69.41"
msgstr "NORMINV(0,9;63;5) gifft \"69,41\" torüch"

#: functions/statistical.xml:884
msgid "Value to which the standard normal distribution is calculated"
msgstr "Weert, för den de Standard-Normaalverdelen utreekt warrt"

#: functions/statistical.xml:888
msgid "The NORMSDIST() function returns the standard normal distribution."
msgstr "De Funkschoon NORMSDIST() gifft de Standard-Normaalverdelen torüch."

#: functions/statistical.xml:889
msgid "NORMSDIST(Number)"
msgstr "NORMSDIST(Tall)"

#: functions/statistical.xml:890
msgid "NORMSDIST(1) equals 0.84"
msgstr "NORMSDIST(1) gifft \"0,84\" torüch"

