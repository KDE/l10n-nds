#: guidance-power-manager.py:1036
msgid "About"
msgstr "Över"

#: guidance-power-manager.py:1052 guidance-power-manager.py:1124 ui.py:3
msgid "Guidance Power Manager"
msgstr "\"Guidance\"-Stroompleger"

#: guidance-power-manager.py:1126
msgid "Applet for battery info and setting brightness"
msgstr "Lüttprogramm för Batterie-Info un Helligkeit-Instellen"

#: guidance-power-manager.py:1128
