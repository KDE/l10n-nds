#: rc.cpp:152
msgctxt "@info:whatsthis"
msgid "Width of the application window as a percentage of the screen."
msgstr "Breed vun't Programmfinster as Perzentandeel vun den Schirm"

#. i18n: file: app/config/yakuake.kcfg:21
