#: krusader/Synchronizer/synchronizergui.cpp:1217
msgid "Follow symlinks"
msgstr "Symboolsch Links nagahn"

#: krusader/Synchronizer/synchronizergui.cpp:1221
msgid "Follow symbolic links during the compare process."
msgstr "Bi't Verglieken symboolsch Links nagahn"

#: krusader/Synchronizer/synchronizergui.cpp:1222
msgid "Compare by content"
msgstr "Na Inholt verglieken"

#: krusader/Synchronizer/synchronizergui.cpp:1225
msgid "Compare duplicated files with same size by content."
msgstr "Dubbelt Dateien mit de sülve Grött na Inholt verglieken"

#: krusader/Synchronizer/synchronizergui.cpp:1226
msgid "Ignore Date"
msgstr "Datum övergahn"

#: krusader/Synchronizer/synchronizergui.cpp:1229
msgid ""
"<p>Ignore date information during the compare process.</p><p><b>Note</b>: "
"useful if the files are located on network filesystems or in archives.</p>"
msgstr ""
"<p>Bi't Verglieken dat Datum utlaten</p><p><b>Tipp</b>: Goot, wenn de "
"Dateien op Nettwark-Dateisystemen oder binnen Archiven liggt.</p>"

#: krusader/Synchronizer/synchronizergui.cpp:1230
msgid "Asymmetric"
msgstr "Asymmetersch"

#: krusader/Synchronizer/synchronizergui.cpp:1233
msgid ""
"<p><b>Asymmetric mode</b></p><p>The left side is the destination, the right "
"is the source directory. Files existing only in the left directory will be "
"deleted, the other differing ones will be copied from right to left.</"
"p><p><b>Note</b>: useful when updating a directory from a file server.</p>"
msgstr ""
"<p><b>Asymmetersch Bedrief</b></p><p>De linke Siet is de Teel-, de rechte de "
"Bornorner. Dateien, de dat bloots binnen den linken Orner gifft, warrt "
"wegdaan. Anner verscheden Dateien warrt vun rechts na links kopeert.</"
"p><p><b>Tipp</b>: Goot bi't Opfrischen vun en Orner vun en Datei-Server.</p>"

#: krusader/Synchronizer/synchronizergui.cpp:1234
msgid "Ignore Case"
msgstr "Nich op Groot- un Lüttschrieven kieken"

#: krusader/Synchronizer/synchronizergui.cpp:1237
msgid ""
"<p>Case insensitive filename compare.</p><p><b>Note</b>: useful when "
"synchronizing Windows filesystems.</p>"
msgstr ""
"<p>Dateinaams ahn Grootschrievverscheel verglieken</p><p><b>Tipp</b>: Goot, "
"wenn Du Windows-Dateisystemen synkroniseren wullt.</p>"

