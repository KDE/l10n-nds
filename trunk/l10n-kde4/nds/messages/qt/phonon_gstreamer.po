#: mediaobject.cpp:94
msgid ""
"Cannot start playback. \n"
"\n"
"Check your Gstreamer installation and make sure you \n"
"have libgstreamer-plugins-base installed."
msgstr ""
"Afspelen lett sik nich starten. \n"
"\n"
"Prööv bitte Dien GStreamer-Installatschoon un beseker, \n"
"Du hest \"libgstreamer-plugins-base\" installeert."

#: mediaobject.cpp:223
msgid "Missing codec helper script assistant."
msgstr "Kodek-Skripthölper fehlt."

#: mediaobject.cpp:225
#, qt-format
msgid "Plugin codec installation failed for codec: %0"
msgstr "Installeren vun't Kodekmoduul is för den Kodek \"%0\" fehlslaan"

#: mediaobject.cpp:236
#, qt-format
msgid ""
"A required codec is missing. You need to install the following codec(s) to "
"play this content: %0"
msgstr ""
"Di fehlt en Kodek, de noot deit. Du muttst disse Kodeks installeren, wenn Du "
"dissen Inholt afspelen wullt: %0"

#: mediaobject.cpp:955 mediaobject.cpp:963 mediaobject.cpp:978
#: mediaobject.cpp:1004 mediaobject.cpp:1010 mediaobject.cpp:1029
#: mediaobject.cpp:1460 mediaobject.cpp:1484
msgid "Could not open media source."
msgstr "Stückborn lett sik nich opmaken."

#: mediaobject.cpp:968
msgid "Invalid source type."
msgstr "Leeg Borntyp."

#: mediaobject.cpp:1458
msgid "Could not locate media source."
msgstr "Stückborn lett sik nich finnen."

#: mediaobject.cpp:1468
msgid "Could not open audio device. The device is already in use."
msgstr "Klangreedschap lett sik nich opmaken. De Reedschap is al in Bruuk."

#: mediaobject.cpp:1481
msgid "Could not decode media source."
msgstr "Stückborn lett sik nich dekoderen.."

#: backend.cpp:182
msgid ""
"Warning: You do not seem to have the package gstreamer0.10-plugins-good "
"installed.\n"
"          Some video features have been disabled."
msgstr ""
"Wohrschoen. As't lett hest Du dat Paket \"gstreamer0.10-plugins-good\" nich "
"installeert.\n"
"          En Reeg Video-Funkschonen wöörn utmaakt."

#: backend.cpp:187
msgid ""
"Warning: You do not seem to have the base GStreamer plugins installed.\n"
"          All audio and video support has been disabled"
msgstr ""
"Wohrschoen. As't lett hest Du \"base\"-GStreamer-Modulen nich installeert.\n"
"          De hele Ünnerstütten för Klang un Video wöör utmaakt."
