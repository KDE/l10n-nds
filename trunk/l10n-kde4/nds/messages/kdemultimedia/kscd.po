#. i18n: file kscd.kcfg line 29
#: rc.cpp:33 rc.cpp:127
msgid ""
"When this option is selected the CD will start playing automatically upon "
"being inserted into the CD-ROM."
msgstr ""
"Wenn disse Optschoon anmaakt is, warrt CDs na't Inleggen automaatsch "
"afspeelt."

#. i18n: tag string
#. i18n: file configWidgetUI.ui line 160
#: rc.cpp:36
msgid "Auto&play when CD inserted"
msgstr "CD na't Inleggen automaatsch &afspelen"

#. i18n: tag string
#. i18n: file configWidgetUI.ui line 167
#. i18n: tag whatsthis
#. i18n: file kscd.kcfg line 39
#: rc.cpp:39 rc.cpp:139
msgid ""
"When this option is selected the CD will automatically eject when it is "
"finished."
msgstr ""
"Wenn disse Optschoon anmaakt is, warrt de CD automaatsch an't Enn rutfohrt."

#. i18n: tag string
#. i18n: file configWidgetUI.ui line 170
#: rc.cpp:42
msgid "&Eject CD when finished playing"
msgstr "&CD na't Afspelen rutfohren"

#. i18n: tag string
#. i18n: file configWidgetUI.ui line 177
#. i18n: tag whatsthis
#. i18n: file kscd.kcfg line 34
#: rc.cpp:45 rc.cpp:133
msgid ""
"When this option is selected the CD will automatically stop playing when "
"quitting KsCD."
msgstr ""
"Wenn disse Optschoon anmaakt is, warrt de Weddergaav bi't Beennen vun KsCD "
"automaatsch anhollen."

#. i18n: tag string
#. i18n: file configWidgetUI.ui line 180
#: rc.cpp:48
msgid "Stop playing CD on e&xit"
msgstr "Afspelen bi't &Beennen anhollen"

