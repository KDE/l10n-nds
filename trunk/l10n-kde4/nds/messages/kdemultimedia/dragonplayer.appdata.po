#. (itstool) path: component/name
#: dragonplayer.appdata.xml:6
msgid "Dragon Player"
msgstr "Drakenspeler"

#. (itstool) path: description/p
#: dragonplayer.appdata.xml:8
msgid ""
"Dragon Player is a multimedia player where the focus is on simplicity, "
"instead of features. Dragon Player does one thing, and only one thing, which "
"is playing multimedia files. It's simple interface is designed not to get in "
"your way and instead empower you to simply play multimedia files."
msgstr ""
"Drakenspeler is en Multimedia-Afspeler, bi den de Eenfachheit in'n Vörgrund "
"steiht un nich de velen Funkschonen bito. Drakenspeler deit nau een Saak, un "
"dat is dat Afspelen vun Multimedia-Dateien. De Brukerböversiet schall Di "
"nich in de Mööt kamen, man Di bi't Bruken vun Multimedia-Inholden "
"ünnerstütten."

#. (itstool) path: description/p
#: dragonplayer.appdata.xml:13
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#: dragonplayer.appdata.xml:15
msgid "Simple Interface"
msgstr "Eenfach Böversiet"

#. (itstool) path: ul/li
#: dragonplayer.appdata.xml:16
msgid ""
"Resuming videos: Starts playing a video where you were watching it last time"
msgstr ""
"Videos wiederspelen: En Video dor wieder afspelen, woneem Du vördem ophollen "
"hest"

#. (itstool) path: ul/li
#: dragonplayer.appdata.xml:17
msgid ""
"Support for subtitles: Automatically loads subtitles with the matching name"
msgstr "Ünnerstütt Ünnertitel: Laadt Ünnertitel mit passen Naam automaatsch"

#. (itstool) path: ul/li
#: dragonplayer.appdata.xml:18
msgid "Video display settings (brightness, contrast)"
msgstr "Video-Afspeelinstellen (Helligkeit, Kontrast)"

#. (itstool) path: ul/li
#: dragonplayer.appdata.xml:19
msgid ""
"Due to using Solid and Phonon DragonPlayer is independent of any multimedia "
"framework or hardware abstraction layer"
msgstr ""
"Drakenspeler bruukt Solid un Phonon un anners keen Multimedia-Rahmenwark "
"oder Hardware-Afstraktschoonlaag"

#. (itstool) path: ul/li
#: dragonplayer.appdata.xml:20
msgid "Supports playing CDs and DVDs"
msgstr "Ünnerstütt dat Afspelen vun CDs un DVDs"
