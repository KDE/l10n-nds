#: imageplugins/channelmixer/channelmixertool.cpp:233
#: imageplugins/whitebalance/whitebalancetool.cpp:338
msgid "Green:"
msgstr "Gröön:"

#: imageplugins/channelmixer/channelmixertool.cpp:238
msgid "Select the green color gain, as a percentage, for the current channel."
msgstr ""
"Hier kannst Du de gröne Klöörverstärken för den aktuellen Kanaal in Perzent "
"utsöken."

#: imageplugins/channelmixer/channelmixertool.cpp:241
msgid "Blue:"
msgstr "Blaag:"

#: imageplugins/channelmixer/channelmixertool.cpp:246
msgid "Select the blue color gain, as a percentage, for the current channel."
msgstr ""
"Hier kannst Du de blage Klöörverstärken för den aktuellen Kanaal in Perzent "
"utsöken."

#: imageplugins/channelmixer/channelmixertool.cpp:251
msgid ""
"Reset color channels' gains settings from the currently selected channel."
msgstr "Verstärken för den aktuell utsöchten Kanaal torüchsetten"

#: imageplugins/channelmixer/channelmixertool.cpp:256
msgid "Monochrome"
msgstr "Swattwitt"

#: imageplugins/channelmixer/channelmixertool.cpp:257
msgid ""
"Enable this option if you want the image rendered in monochrome mode. In "
"this mode, the histogram will display only luminosity values."
msgstr ""
"Bruuk disse Optschoon, wenn Du dat Bild in swattwitt dorstellen wullt. In "
"dissen Bedrief wiest dat Histogramm bloots Helligkeit-Weerten."

#: imageplugins/channelmixer/channelmixertool.cpp:261
msgid "Preserve luminosity"
msgstr "Helligkeit wohren"

#: imageplugins/channelmixer/channelmixertool.cpp:262
msgid "Enable this option is you want preserve the image luminosity."
msgstr ""
"Bruuk disse Optschoon, wenn Du de Helligkeit vun dat Bild wohren wullt."

#: imageplugins/channelmixer/channelmixertool.cpp:644
msgid "Select Gimp Gains Mixer File to Load"
msgstr "Gimp-Verstärkenmischerdatei för't Laden utsöken"

#: imageplugins/channelmixer/channelmixertool.cpp:718
msgid "Cannot load settings from the Gains Mixer text file."
msgstr "Instellen laat sik nich ut de Verstärkenmischer-Textdatei laden."

#: imageplugins/channelmixer/channelmixertool.cpp:731
