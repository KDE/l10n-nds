#: libs/greycstoration/greycstorationwidget.cpp:135
#: utilities/queuemanager/queuemgrwindow.cpp:703
#: utilities/lighttable/lighttablewindow.cpp:1485
#: utilities/cameragui/cameraui.cpp:2145
msgid "General"
msgstr "Allmeen"

#: libs/greycstoration/greycstorationwidget.cpp:137
msgid "Detail preservation:"
msgstr "Enkelheiten wohren:"

#: libs/greycstoration/greycstorationwidget.cpp:141
msgid ""
"Preservation of details to set the sharpening level of the small features in "
"the target image. Higher values leave details sharp."
msgstr ""
"\"Enkelheiten wohren\" leggt de Scharpteek-Stoop för lütte Objekten binnen "
"dat Teelbild fast. Grötter Weerten maakt disse Enkelheiten scharp."

#: libs/greycstoration/greycstorationwidget.cpp:145
msgid "Anisotropy:"
msgstr "Richtenafhangigkeit:"

#: libs/greycstoration/greycstorationwidget.cpp:149
msgid ""
"Anisotropic (directional) modifier of the details. Keep it small for "
"Gaussian noise."
msgstr ""
"Richtenafhangen Modifikator för Enkelheiten. Laat em lütt, vun wegen dat "
"Gauß'sche Rusen."

#: libs/greycstoration/greycstorationwidget.cpp:152
msgid "Smoothing:"
msgstr "Weekheit:"

#: libs/greycstoration/greycstorationwidget.cpp:156
msgid ""
"Total smoothing power: if the Detail Factor sets the relative smoothing and "
"the Anisotropy Factor the direction, the Smoothing Factor sets the overall "
"effect."
msgstr ""
"Heel Weekmaak-Stärk: De Enkelheiten-Fakter leggt dat relative Weekmaken "
"fast, de Richtafhangigkeit de Richt, un de Weekmaak-Faktor den Heeleffekt."

#: libs/greycstoration/greycstorationwidget.cpp:160
msgid "Regularity:"
msgstr "Evenheit:"

#: libs/greycstoration/greycstorationwidget.cpp:164
msgid ""
"This value controls the evenness of smoothing to the image. Do not use a "
"high value here, or the target image will be completely blurred."
msgstr ""
"Disse Weert stüert de Weekmaak-Evenheit vun dat Bild. Bruuk hier keen hogen "
"Weert, anners warrt dat Teelbild heel verwischt."

#: libs/greycstoration/greycstorationwidget.cpp:168
msgid "Iterations:"
msgstr "Wedderhalen:"

#: libs/greycstoration/greycstorationwidget.cpp:172
msgid "Sets the number of times the filter is applied to the image."
msgstr "Leggt fast, wo faken de Filter för dat Bild bruukt warrt."

#: libs/greycstoration/greycstorationwidget.cpp:174
msgid "Noise:"
msgstr "Rusen:"

#: libs/greycstoration/greycstorationwidget.cpp:178
msgid "Sets the noise scale."
msgstr "Leggt den Ruusweert fast."

#: libs/greycstoration/greycstorationwidget.cpp:200
#: imageplugins/contentawareresizing/contentawareresizetool.cpp:449
#: utilities/setup/setupicc.cpp:467
msgid "Advanced Settings"
msgstr "Verwiedert Instellen"

#: libs/greycstoration/greycstorationwidget.cpp:202
msgid "Angular step:"
msgstr "Winkelschritt:"

#: libs/greycstoration/greycstorationwidget.cpp:206
msgid ""
"Set here the angular integration step (in degrees) analogous to anisotropy."
msgstr ""
"Leggt den Integreer-Winkelschritt in Graad fast, liek as bi de "
"Richtafhangigkeit."

#: libs/greycstoration/greycstorationwidget.cpp:209
msgid "Integral step:"
msgstr "Integraalschritt:"

#: libs/greycstoration/greycstorationwidget.cpp:213
msgid "Set here the spatial integral step."
msgstr "Leggt den Ruum-Integraalschritt fast."

#: libs/greycstoration/greycstorationwidget.cpp:215
msgid "Gaussian:"
msgstr "Gauß-Weert:"

#: libs/greycstoration/greycstorationwidget.cpp:219
msgid "Set here the precision of the Gaussian function."
msgstr "Leggt de Nauigkeit vun de Gauss'sche Funkschoon fast."

#: libs/greycstoration/greycstorationwidget.cpp:221
msgid "Tile size:"
msgstr "Kachelgrött:"

#: libs/greycstoration/greycstorationwidget.cpp:225
msgid "Sets the tile size."
msgstr "Leggt de Kachelgrött fast."

#: libs/greycstoration/greycstorationwidget.cpp:227
msgid "Tile border:"
msgstr "Kachelrand:"

#: libs/greycstoration/greycstorationwidget.cpp:231
msgid "Sets the size of each tile border."
msgstr "Leggt de Grött vun de Kachelrahmens fast."

#: libs/greycstoration/greycstorationwidget.cpp:233
msgid "Interpolation:"
msgstr "Estemeren:"

#: libs/greycstoration/greycstorationwidget.cpp:235
msgid "Nearest Neighbor"
msgstr "Neegst Naver"

#: libs/greycstoration/greycstorationwidget.cpp:236
#: imageplugins/localcontrast/localcontrasttool.cpp:212
#: utilities/timeline/timelineview.cpp:153
msgid "Linear"
msgstr "Lineaar"

#: libs/greycstoration/greycstorationwidget.cpp:237
msgid "Runge-Kutta"
msgstr "Runge-Kutta"

#: libs/greycstoration/greycstorationwidget.cpp:238
msgid "Select the right interpolation method for the desired image quality."
msgstr "Hier kannst Du de Estemeermetood utsöken, se leggt de Bildgööd fast."

