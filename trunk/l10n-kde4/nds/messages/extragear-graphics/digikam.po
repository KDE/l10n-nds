#: libs/widgets/common/histogrambox.cpp:92
msgid ""
"<p>Select the histogram scale.</p><p>If the image's maximal counts are "
"small, you can use the <b>linear</b> scale.</p><p><b>Logarithmic</b> scale "
"can be used when the maximal counts are big; if it is used, all values "
"(small and large) will be visible on the graph.</p>"
msgstr ""
"<p>Hier kannst Du de Histogramm-Skala utsöken.</p><p>Wenn de Hööchstweert "
"vun dat Bild siet is, kannst Du de <b>lineare</b> Skala bruken.</p><p>De "
"<b>logaritmische</b> Skala lett sik bi grote Hööchstweerten bruken. So warrt "
"all Weerten (siete un hoge) in de Grafik wiest.</p>"

#: libs/widgets/common/histogrambox.cpp:98
msgctxt "linear histogram scaling mode"
msgid "Linear"
msgstr "Lineaar"

#: libs/widgets/common/histogrambox.cpp:104
msgctxt "logarithmic histogram scaling mode"
msgid "Logarithmic"
msgstr "Logaritmisch"

#: libs/widgets/common/histogrambox.cpp:121
msgid ""
"Here you can see the target preview image histogram drawing of the selected "
"image channel. This one is re-computed at any settings changes."
msgstr ""
"Dit is de Vöransicht vun dat Teelbild sien Histogramm för den utsöchten "
"Bildkanaal. Se warrt nieg utreekt, wenn Du de Instellen ännerst."

#: libs/widgets/common/histogrambox.cpp:265
msgid "<p>Select the histogram channel to display:</p>"
msgstr "<p>Bitte den Histogrammkanaal utsöken, den Du ankieken wullt:</p>"

#: libs/widgets/common/histogrambox.cpp:270
msgctxt "The luminosity channel"
msgid "Luminosity"
msgstr "Bildhelligkeit"

#: libs/widgets/common/histogrambox.cpp:271
msgid "<b>Luminosity</b>: display the image's luminosity values."
msgstr "<b>Bildhelligkeit</b>: Wiest de Bildhelligkeit-Weerten."

#: libs/widgets/common/histogrambox.cpp:273
msgctxt "The red channel"
msgid "Red"
msgstr "Root"

#: libs/widgets/common/histogrambox.cpp:274
msgid "<b>Red</b>: display the red image-channel values."
msgstr "<b>Root</b>: wiest de Rootkanaal-Weerten vun dat Bild."

#: libs/widgets/common/histogrambox.cpp:276
msgctxt "The green channel"
msgid "Green"
msgstr "Gröön"

#: libs/widgets/common/histogrambox.cpp:277
msgid "<b>Green</b>: display the green image-channel values."
msgstr "<b>Gröön</b>: wiest de Gröönkanaal-Weerten vun dat Bild."

#: libs/widgets/common/histogrambox.cpp:279
msgctxt "The blue channel"
msgid "Blue"
msgstr "Blaag"

#: libs/widgets/common/histogrambox.cpp:280
msgid "<b>Blue</b>: display the blue image-channel values."
msgstr "<b>Blaag</b>: wiest de Blaagkanaal-Weerten vun dat Bild."

#: libs/widgets/common/histogrambox.cpp:282
msgctxt "The colors channel"
msgid "Colors"
msgstr "Klören"

#: libs/widgets/common/histogrambox.cpp:283
msgid "<b>Colors</b>: Display all color channel values at the same time."
msgstr "<b>Klören</b>: wiest all Klöörkanaalweerten tosamen."

#: libs/widgets/common/histogrambox.cpp:285
msgctxt "The alpha channel"
msgid "Alpha"
msgstr "Alpha"

#: libs/widgets/common/histogrambox.cpp:286
msgid ""
"<b>Alpha</b>: display the alpha image-channel values. This channel "
"corresponds to the transparency value and is supported by some image "
"formats, such as PNG or TIF."
msgstr ""
"<b>Alpha</b>: wiest de Alphakanaal-Weerten vun dat Bild. Dit is de "
"Transparenz-Weert un warrt vun en Reeg vun Bildformaten ünnerstütt, a.B. "
"\"PNG\" oder \"TIF\"."

