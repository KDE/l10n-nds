#: libs/widgets/common/histogrambox.cpp:130
msgid ""
"<p>Select the main color displayed with Colors Channel mode here:</"
"p><p><b>Red</b>: Draw the red image channel in the foreground.<br/><b>Green</"
"b>: Draw the green image channel in the foreground.<br/><b>Blue</b>: Draw "
"the blue image channel in the foreground.</p>"
msgstr ""
"<p>Hier kannst Du de Hööftklöör för den Klöörkanaal-Bedrief utsöken:</"
"p><p><b>Root</b>: wiest den roden Bildkanaal in den Vörgrund.<br/><b>Gröön</"
"b>: wiest den grönen Bildkanaal in den Vörgrund.<br/><b>Blaag</b>: Wiest den "
"blagen Bildkanaal in den Vörgrund.</p>"

#: libs/widgets/common/histogrambox.cpp:141
msgid ""
"Here you can see the target preview image histogram drawing of the selected "
"image channel. This one is re-computed at any settings changes."
msgstr ""
"Dit is de Vöransicht vun dat Teelbild sien Histogramm för den utsöchten "
"Bildkanaal. Se warrt nieg utreekt, wenn Du de Instellen ännerst."

#: libs/widgets/common/histogrambox.cpp:336
msgid "<p>Select the histogram channel to display:</p>"
msgstr "<p>Bitte den Histogrammkanaal utsöken, den Du ankieken wullt:</p>"

#: libs/widgets/common/histogrambox.cpp:341
msgctxt "The luminosity channel"
msgid "Luminosity"
msgstr "Bildhelligkeit"

#: libs/widgets/common/histogrambox.cpp:342
msgid "<b>Luminosity</b>: display the image's luminosity values."
msgstr "<b>Bildhelligkeit</b>: Wiest de Bildhelligkeit-Weerten."

#: libs/widgets/common/histogrambox.cpp:344
msgctxt "The red channel"
msgid "Red"
msgstr "Root"

#: libs/widgets/common/histogrambox.cpp:345
msgid "<b>Red</b>: display the red image-channel values."
msgstr "<b>Root</b>: wiest de Rootkanaal-Weerten vun dat Bild."

#: libs/widgets/common/histogrambox.cpp:347
msgctxt "The green channel"
msgid "Green"
msgstr "Gröön"

#: libs/widgets/common/histogrambox.cpp:348
msgid "<b>Green</b>: display the green image-channel values."
msgstr "<b>Gröön</b>: wiest de Gröönkanaal-Weerten vun dat Bild."

#: libs/widgets/common/histogrambox.cpp:350
msgctxt "The blue channel"
msgid "Blue"
msgstr "Blaag"

#: libs/widgets/common/histogrambox.cpp:351
msgid "<b>Blue</b>: display the blue image-channel values."
msgstr "<b>Blaag</b>: wiest de Blaagkanaal-Weerten vun dat Bild."

#: libs/widgets/common/histogrambox.cpp:353
msgctxt "The colors channel"
msgid "Colors"
msgstr "Klören"

#: libs/widgets/common/histogrambox.cpp:354
msgid "<b>Colors</b>: Display all color channel values at the same time."
msgstr "<b>Klören</b>: wiest all Klöörkanaalweerten tosamen."

#: libs/widgets/common/histogrambox.cpp:356
msgctxt "The alpha channel"
msgid "Alpha"
msgstr "Alpha"

#: libs/widgets/common/histogrambox.cpp:357
msgid ""
"<b>Alpha</b>: display the alpha image-channel values. This channel "
"corresponds to the transparency value and is supported by some image "
"formats, such as PNG or TIF."
msgstr ""
"<b>Alpha</b>: wiest de Alphakanaal-Weerten vun dat Bild. Dit is de "
"Transparenz-Weert un warrt vun en Reeg vun Bildformaten ünnerstütt, a.B. "
"\"PNG\" oder \"TIF\"."

#: libs/widgets/common/curvesbox.cpp:140
