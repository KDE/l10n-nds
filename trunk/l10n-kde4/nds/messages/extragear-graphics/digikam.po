msgstr "Ruusminner-Instellen sekern"

#: imageplugins/noisereduction/noisereductiontool.cpp:529
msgid "Cannot save settings to the Photograph Noise Reduction text file."
msgstr "Instellen laat sik nich na Ruusminner-Textdatei sekern."

#: imageplugins/channelmixer/imageplugin_channelmixer.cpp:51
