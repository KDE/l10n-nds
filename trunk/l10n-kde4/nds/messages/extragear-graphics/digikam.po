#: imageplugins/coreplugin/bwsepiatool.cpp:306
msgid "Green Filter"
msgstr "Gröönfilter"

#: imageplugins/coreplugin/bwsepiatool.cpp:307
msgid ""
"<b>Black & White with Green Filter</b>:<p>Simulate black and white film "
"exposure using a green filter. This is useful for all scenic shoots, "
"especially portraits photographed against the sky.</p>"
msgstr ""
"<b>Swattwitt mit Gröönfilter</b>:<p>Simuleert en Swattwittopnahm mit "
"Gröönfilter. Dit beedt allgemeen Verbetern för all Opnahmen, sünnerlich för "
"Porträts, de gegen den Heven maakt wöörn.</p>"

#: imageplugins/coreplugin/bwsepiatool.cpp:313
msgid "Orange Filter"
msgstr "Orangefilter"

#: imageplugins/coreplugin/bwsepiatool.cpp:314
msgid ""
"<b>Black & White with Orange Filter</b>:<p>Simulate black and white film "
"exposure using an orange filter. This will enhance landscapes, marine scenes "
"and aerial photography.</p>"
msgstr ""
