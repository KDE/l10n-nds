#: imageplugins/coreplugin/bwsepiatool.cpp:454
msgid ""
"<b>Black & White with Yellow-Green Filter</b>:<p>Simulate black and white "
"film exposure using a yellow-green filter. A yellow-green filter is highly "
"effective for outdoor portraits because red is rendered dark while green "
"appears lighter. Great for correcting skin tones, bringing out facial "
"expressions in close-ups and emphasizing the feeling of liveliness. This "
"filter is highly effective for indoor portraits under tungsten lighting.</p>"
msgstr ""

#: imageplugins/coreplugin/bwsepiatool.cpp:462
#, fuzzy
#| msgid "Red Filter"
msgid "Blue Filter"
msgstr "Rootfilter"

#: imageplugins/coreplugin/bwsepiatool.cpp:463
#, fuzzy
#| msgid ""
#| "<b>Black & White with Red Filter</b>:<p>Simulate black and white film "
#| "exposure using a red filter. This creates dramatic sky effects, and "
#| "simulates moonlight scenes in the daytime.</p>"
msgid ""
"<b>Black & White with Blue Filter</b>:<p>Simulate black and white film "
"exposure using a blue filter. This accentuates haze and fog. Used for dye "
"transfer and contrast effects.</p>"
msgstr ""
"<b>Swattwitt mit Rootfilter</b>:<p>Simuleert en Swattwittopnahm mit "
"Rootfilter. De Bruuk vun dissen Filter stellt dramaatsche Heven-Effekten op "
"un simuleert Maandlicht över Dag.</p>"

#: imageplugins/coreplugin/bwsepiatool.cpp:468
msgid "Strength:"
msgstr "Stärk:"

#: imageplugins/coreplugin/bwsepiatool.cpp:472
msgid "Here, set the strength adjustment of the lens filter."
msgstr "Hier kannst Du de Stärk vun den Glasfilter topassen."

#: imageplugins/coreplugin/bwsepiatool.cpp:481
msgid "No Tone Filter"
msgstr "Keen Toonfilter"

#: imageplugins/coreplugin/bwsepiatool.cpp:482
msgid "<b>No Tone Filter</b>:<p>Do not apply a tone filter to the image.</p>"
msgstr "<b>Keen Toonfilter</b>:<p>Keen Toonfilter op dat Bild anwennen</p>"

#: imageplugins/coreplugin/bwsepiatool.cpp:486
msgid "Sepia Tone"
msgstr "Sepia-Klöörtoon"

#: imageplugins/coreplugin/bwsepiatool.cpp:487
msgid ""
"<b>Black & White with Sepia Tone</b>:<p>Gives a warm highlight and mid-tone "
"while adding a bit of coolness to the shadows - very similar to the process "
"of bleaching a print and re-developing in a sepia toner.</p>"
msgstr ""
"<b>Swattwitt mit Sepia-Klöörtoon</b>:<p>Föögt Gleemlichters un Middeltöön "
"wat Warms to, un en beten Küll na de Schaddens. Dat is meist as dat Utbleken "
"un niege Utwickeln in en Sepia-Toner.</p>"

#: imageplugins/coreplugin/bwsepiatool.cpp:493
msgid "Brown Tone"
msgstr "Bruun Klöörtoon"

#: imageplugins/coreplugin/bwsepiatool.cpp:494
msgid ""
"<b>Black & White with Brown Tone</b>:<p>This filter is more neutral than the "
"Sepia Tone filter.</p>"
msgstr ""
"<b>Swattwitt mit bruun Klöörtoon</b>:<p>Wat neutraler as de Sepia-"
"Klöörtoonfilter.</p>"

#: imageplugins/coreplugin/bwsepiatool.cpp:499
msgid "Cold Tone"
msgstr "Koolt Klöörtoon"

#: imageplugins/coreplugin/bwsepiatool.cpp:500
msgid ""
"<b>Black & White with Cold Tone</b>:<p>Start subtly and replicate printing "
"on a cold tone black and white paper such as a bromide enlarging paper.</p>"
msgstr ""
"<b>Swattwitt mit koolt Klöörtoon</b>:<p>Mit de Fieneheiten anfangen un den "
"Utdruck vun en koolt Swattwitt-Papeer namaken, so as bi Bromid-Fotopapeer.</"
"p>"

#: imageplugins/coreplugin/bwsepiatool.cpp:506
msgid "Selenium Tone"
msgstr "Seleen-Klöörtoon"

#: imageplugins/coreplugin/bwsepiatool.cpp:507
msgid ""
"<b>Black & White with Selenium Tone</b>:<p>This effect replicates "
"traditional selenium chemical toning done in the darkroom.</p>"
msgstr ""
"<b>Swattwitt mit Seleen-Klöörtoon</b>:<p>Effekt, de dat traditschonelle "
"cheemsche Tofögen vun en Seleen-Toon in de Dusterkamer nabillen deit.</p>"

#: imageplugins/coreplugin/bwsepiatool.cpp:512
msgid "Platinum Tone"
msgstr "Platin-Klöörtoon"

#: imageplugins/coreplugin/bwsepiatool.cpp:513
msgid ""
"<b>Black & White with Platinum Tone</b>:<p>This effect replicates "
"traditional platinum chemical toning done in the darkroom.</p>"
msgstr ""
"<b>Swattwitt mit Platin-Klöörtoon</b>:<p>Effekt, de dat traditschonelle "
"cheemsche Tofögen vun en Platin-Toon in de Dusterkamer nabillen deit.</p>"

#: imageplugins/coreplugin/bwsepiatool.cpp:518
msgid "Green Tone"
msgstr "Grööntoon"

#: imageplugins/coreplugin/bwsepiatool.cpp:519
msgid ""
"<b>Black & White with greenish tint</b>:<p>This effect is also known as "
"Verdante.</p>"
msgstr ""
"<b>Swattwitt mit gröön Klöörtoon</b>:<p>Disse Effekt warrt ok »Verdante« "
"nöömt.</p>"

