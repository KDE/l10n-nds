"IPTC tags."
msgstr ""
"Maak dit an, wenn Du dat Datum un de Tiet vun't Bild binnen de EXIF-, XMP- "
"un IPTC-Feller wohren wullt."

#: utilities/setup/setupmetadata.cpp:146
msgid "&Save image rating as tags"
msgstr "Bildbeweerten as Slötelwöör &sekern"

#: utilities/setup/setupmetadata.cpp:147
