#. i18n: file: kmsettings.ui:675
#. i18n: ectx: property (text), item, widget (QComboBox, combo_RENDERING_INTENT)
#: rc.cpp:224 rc.cpp:263
msgid "Absolute Colorimetric"
msgstr ""

