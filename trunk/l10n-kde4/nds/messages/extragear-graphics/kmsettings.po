#. i18n: ectx: property (text), widget (QCheckBox, check_PROOF_HARD)
#: rc.cpp:236
msgid "Hard Proof"
msgstr ""

#. i18n: file: kmsettings.ui:639
#. i18n: ectx: property (toolTip), widget (QGroupBox, box_GROUP_BEHAVIOUR_RENDERING)
#: rc.cpp:239
msgid ""
"<p><b>Rendering Settings</b> allows you to change the global rendering "
"intent.</p>"
msgstr ""

#. i18n: file: kmsettings.ui:642
#. i18n: ectx: property (title), widget (QGroupBox, box_GROUP_BEHAVIOUR_RENDERING)
#: rc.cpp:242
msgid "Rendering Intent"
msgstr ""

#. i18n: file: kmsettings.ui:656
#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_RENDERING_INTENT)
#: rc.cpp:245
msgid ""
"<ul>\n"
"<li><b>Perceptual:</b> Preserves relationship between out-of-gamut colors.</"
"li>\n"
"<li><b>Relative Colorimetric:</b> The white point of the colorspace source "
"is changed to the destination.</li>\n"
"<li><b>Saturation:</b> Preserves accurate saturation, while modifying color "
"hues.</li>\n"
"<li><b>Absolute Colorimetric:</b> The white point of the destination "
"colorspace will become the white point of the source.</li>\n"
"</ul>\n"
msgstr ""

