#. i18n: file: kmsettings.ui:469
#. i18n: ectx: property (text), widget (QLabel, label_MIXED_MOD_DOCUMENTS_SCREEN)
#: rc.cpp:154
msgid "For Screen"
msgstr ""

#. i18n: file: kmsettings.ui:484
#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_SCREEN)
#: rc.cpp:157
msgid ""
"<ul>\n"
"<li><b>Preserve Numbers:</b> Leave the non-RGB color space as is (no "
"conversion).</li>\n"
"<li><b>Convert to Editing RGB Space:</b> Convert the non-RGB color space "
"into the assigned editing color space.</li>\n"
"<li><b>Convert to Web:</b> Convert the non-RGB color space into the web-"
"appropriate sRGB color space.</li>\n"
"<li><b>Prompt User:</b> Allow the user to select the appropriate color space "
"conversion method.</li>\n"
"</ul>"
msgstr ""

#. i18n: file: kmsettings.ui:493
#. i18n: ectx: property (text), item, widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_SCREEN)
#: rc.cpp:168
