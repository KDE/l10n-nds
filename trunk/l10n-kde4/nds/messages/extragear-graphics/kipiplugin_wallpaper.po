#: plugin_wallpaper.cpp:195
#, fuzzy
#| msgid ""
#| "<qt><p>You selected a remote image. It needs to be saved to your local "
#| "disk to be used as a wallpaper.</p><p>You will now be asked where to save "
#| "the image.</p></qt>"
msgid ""
"<p>You selected a remote image. It needs to be saved to your local disk to "
"be used as a wallpaper.</p><p>You will now be asked where to save the image."
"</p>"
msgstr ""
"<qt><p>Du hest en feern Bild köört. Wenn Du dat as Achtergrundbild bruken "
"wullt, mutt dat na Dien Fastplaat sekert warrn.</p><p>Du warrst nu fraagt, "
"wo dat Bild hen sekert warrn schall.</p></qt>"

