#: plugin_smugmug.cpp:65
msgid "Export to SmugMug..."
msgstr "Na SmugMug exporteren..."

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

#: smugmugalbum.cpp:50
msgid "SmugMug New Album"
msgstr "Nieg SmugMug-Album"

#: smugmugalbum.cpp:63 smugmugwidget.cpp:101
msgid "Album"
msgstr "Album"

#: smugmugalbum.cpp:65
msgid "These are basic settings for new SmugMug album."
msgstr "Dit sünd de eenfachen Instellen för't niege SmugMug-Album."

#: smugmugalbum.cpp:68
msgid "Title:"
msgstr "Titel:"

#: smugmugalbum.cpp:71 smugmugalbum.cpp:73
msgid "Title of the album that will be created (required)."
msgstr "De Titel vun't Album, dat Du opstellen wullt (deit noot)"

#: smugmugalbum.cpp:75
msgid "Category:"
msgstr "Kategorie:"

#: smugmugalbum.cpp:79 smugmugalbum.cpp:81
msgid "Category of the album that will be created (required)."
msgstr "De Kategorie för't Album, dat Du opstellen wullt (deit noot)"

#: smugmugalbum.cpp:83
msgid "Subcategory:"
msgstr "Ünnerkategorie:"

#: smugmugalbum.cpp:87 smugmugalbum.cpp:89
msgid "Subcategory of the album that will be created (optional)."
msgstr "De Ünnerkategorie för't Album, dat Du opstellen wullt (köörwies)"

#: smugmugalbum.cpp:91
msgid "Description:"
msgstr "Beschrieven:"

#: smugmugalbum.cpp:94 smugmugalbum.cpp:96
msgid "Description of the album that will be created (optional)."
msgstr "De Beschrieven för't Album, dat Du opstellen wullt (köörwies)"

#: smugmugalbum.cpp:110
msgid "Security && Privacy"
msgstr "Sekerheit un Privaatrebeet"

#: smugmugalbum.cpp:112
msgid "These are security and privacy settings for new SmugMug album."
msgstr ""
"Dit sünd Sekerheit- un Privaatrebeet-Instellen för't niege SmugMug-Album."

#: smugmugalbum.cpp:115
msgid "Privacy:"
msgstr "Privaat:"

#: smugmugalbum.cpp:117
msgid "Privacy of the new SmugMug album (required)."
msgstr "Wat dat niege SmugMug-Album privaat wesen schall (deit noot)."

#: smugmugalbum.cpp:118
msgid "Public"
msgstr "Apen"

#: smugmugalbum.cpp:121
msgid "Public album is listed on your public SmugMug page."
msgstr "En apen Album warrt op Dien apen SmugMug-Siet oplist."

#: smugmugalbum.cpp:122
msgid "Unlisted"
msgstr "Nich oplist"

#: smugmugalbum.cpp:124
msgid "Unlisted album is only accessible via URL."
msgstr "Op en nich oplist kenn Een bloots över sien URL togriepen."

#: smugmugalbum.cpp:126
msgid "Password:"
msgstr "Passwoort:"

#: smugmugalbum.cpp:129 smugmugalbum.cpp:131
msgid "Require password to access the album (optional)."
msgstr "Passwoort för't Togriepen op't Album nödig maken (köörwies)"

#: smugmugalbum.cpp:133
msgid "Password Hint:"
msgstr "Passwoort-Tipp:"

#: smugmugalbum.cpp:136 smugmugalbum.cpp:138
msgid "Password hint to present to users on the password prompt (optional)."
msgstr ""
"Passwoort-Tipp, de Brukers bi de Passwoort-Ingaav wiest warrt (köörwies)"

#: smugmugtalker.cpp:110
msgid "Logging to SmugMug service..."
msgstr "An't Tokoppeln na den SmugMug-Deenst..."

#: smugmugtalker.cpp:345
msgid "Login failed"
msgstr "Anmellen fehlslaan"

#: smugmugtalker.cpp:348
msgid "Invalid API key"
msgstr "Leeg Api-Slötel"

#: smugmugwidget.cpp:65
msgid "This is the list of images to upload on your SmugMug account."
msgstr ""
"Dit is de List mit Biller, de Du na Dien SmugMug-Konto hoochladen wullt."

#: smugmugwidget.cpp:72
msgid "This is clickable link to open SmugMug home page in web browser."
msgstr ""
"Mit dissen Link kannst Du de SmugMug-Tohuussiet mit Dien Nettkieker opmaken."

#: smugmugwidget.cpp:78
msgid "Account"
msgstr "Konto"

#: smugmugwidget.cpp:80
msgid "This is the SmugMug account that will be used for upload."
msgstr "Dit is dat SmugMug-Konto, na dat Du hoochlaaden wullt."

#: smugmugwidget.cpp:83
msgid "Name: "
msgstr "Naam:"

#: smugmugwidget.cpp:85
msgid "E-mail: "
msgstr "Nettpost: "

#: smugmugwidget.cpp:88
msgid "Change Account"
msgstr "Konto ännern"

#: smugmugwidget.cpp:103
msgid "This is the SmugMug album where selected photos will be uploaded."
msgstr "Dit is dat SmugMug-Album, na dat Du hoochladen wullt."

#: smugmugwidget.cpp:109
msgid "New Album"
msgstr "Nieg Album"

#: smugmugwidget.cpp:112
msgid "Reload"
msgstr "Nieg laden"

#: smugmugwidget.cpp:121
msgid "Options"
msgstr "Optschonen"

#: smugmugwidget.cpp:123
msgid "These are options that will be applied to photos before upload."
msgstr "Disse Optschonen warrt för de Fotos bruukt, ehr se hoochlaadt warrt."

#: smugmugwidget.cpp:127
msgid "Resize photos before uploading"
msgstr "Fotogrött ehr't Hoochladen ännern"

#: smugmugwidget.cpp:137
msgid "Maximum dimension:"
msgstr "Hööchstafmeten:"

#: smugmugwidget.cpp:145
msgid "JPEG quality:"
msgstr "JPEG-Gööd:"

#: smugmugwindow.cpp:79
msgid "Export to SmugMug Web Service"
msgstr "Na SmugMug-Nettdeenst exporteren"

#: smugmugwindow.cpp:91
msgid "Start Upload"
msgstr "Hoochladen starten"

#: smugmugwindow.cpp:114
msgid "SmugMug Export"
msgstr "SmugMug-Export"

#: smugmugwindow.cpp:116
msgid "A Kipi plugin to export image collection to SmugMug web service."
msgstr ""
"En KIPI-Moduul, dat Billersammeln na den SmugMug-Nettdeenst hoochladen deit."

