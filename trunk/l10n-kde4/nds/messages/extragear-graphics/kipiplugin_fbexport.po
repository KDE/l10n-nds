msgid "Facebook Call Failed: %1\n"
msgstr "Facebook-Anroop fehlslaan: %1\n"

#: fbwindow.cpp:529 fbwindow.cpp:546
msgid "Cannot open file"
msgstr "Datei lett sik nich opmaken"

#: fbwindow.cpp:550
#, kde-format
msgid "Uploading file %1"
msgstr "Datei %1 warrt hoochlaadt"

#: fbwindow.cpp:578
#, kde-format
msgid ""
"Failed to upload photo into Facebook: %1\n"
"Do you want to continue?"
msgstr ""
"Foto lett sik nich na Facebook hoochladen. %1\n"
"Wullt Du wiedermaken?"

