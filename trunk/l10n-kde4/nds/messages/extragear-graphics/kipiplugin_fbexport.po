#: fbalbum.cpp:45
msgid "Facebook New Album"
msgstr "Facebook - Nieg Album"

#: fbalbum.cpp:59
msgid "Title of the album that will be created (required)."
msgstr "De Titel vun't Album, dat Du opstellen wullt (deit noot)"

#: fbalbum.cpp:63
msgid "Location of the album that will be created (optional)."
msgstr "De Steed för't Album, dat Du opstellen wullt (köörwies)"

#: fbalbum.cpp:67
msgid "Description of the album that will be created (optional)."
msgstr "De Beschrieven för't Album, dat Du opstellen wullt (köörwies)"

#: fbalbum.cpp:72
msgid "Privacy setting of the album that will be created (required)."
msgstr ""
"De Privatrebeet-Instellen vun't Album, dat Du opstellen wullt (deit noot)"

#: fbalbum.cpp:74
msgid "Only Friends"
msgstr "Bloots Frünnen"

#: fbalbum.cpp:76
msgid "Friends of Friends"
msgstr "Frünnen ehr Frünnen"

#: fbalbum.cpp:78
msgid "My Networks and Friends"
msgstr "Mien Nettwarken un Frünnen"

#: fbalbum.cpp:80
msgid "Everyone"
msgstr "Elkeen"

#: fbalbum.cpp:82
msgid "Title:"
msgstr "Titel:"

#: fbalbum.cpp:83
msgid "Location:"
msgstr "Steed: "

#: fbalbum.cpp:84
msgid "Description:"
msgstr "Beschrieven:"

#: fbalbum.cpp:85
msgid "Privacy:"
msgstr "Privaatrebeet:"

#: fbtalker.cpp:154
msgid "Validate previous session..."
msgstr "Verleden Törn pröven..."

#: fbtalker.cpp:178
msgid "Logging to Facebook service..."
msgstr "An't Tokoppeln na den Facebook-Deenst..."

#: fbtalker.cpp:363
msgid ""
"Please follow the instructions in the browser window. Press \"OK\" when done."
msgstr ""
"Bitte holl Di to de Anwiesen in't Nettkiekerfinster. Klick op \"OK\", wenn "
"Du sowiet büst."

#: fbtalker.cpp:365
msgid "Facebook Application Authorization"
msgstr "Programmidentiteetprööv vun den Facebook-Deenst"

#: fbtalker.cpp:573
msgid "The service is not available at this time."
msgstr "De Deenst is opstunns nich verföögbor."

#: fbtalker.cpp:576
msgid "The application has reached maximum number of requests allowed."
msgstr "Dat Programm is be de tohööcht tolaten Tall vun Anfragen anlangt."

#: fbtalker.cpp:579
msgid "Invalid session key or session expired. Try to log in again."
msgstr "Leeg Törnslötel oder Törn aflopen. Bitte nieg anmellen."

#: fbtalker.cpp:582
msgid "Invalid album ID."
msgstr "Leeg Album-ID."

#: fbtalker.cpp:585
msgid "Album is full."
msgstr "Album is vull."

#: fbtalker.cpp:588
msgid "Missing or invalid file."
msgstr "Fehlen oder leeg Datei."

#: fbtalker.cpp:591
msgid "Too many unapproved photos pending."
msgstr "To vele nich tolaten Fotos staht an."

#: fbtalker.cpp:728
msgid ""
"Please follow the instructions in the browser window. Press \"Yes\" if you "
"have authenticated and \"No\" if you failed."
msgstr ""
"Bitte holl Di to de Anwiesen in't Nettkiekerfinster. Klick op \"Jo\", wenn "
"de Identiteetprööv Spood harr un op \"Nee\", wenn se fehlslaan is."

#: fbtalker.cpp:730
msgid "Facebook Service Web Authorization"
msgstr "Nettidentiteetprööv vun den Facebook-Deenst"

#: fbtalker.cpp:739
msgid "Canceled by user."
msgstr "Vun Bruker afbraken."

#: fbwidget.cpp:64
msgid "This is the list of images to upload on your Facebook account."
msgstr ""
"Dit is de List vun Biller, de Du na Dien Facebook-Konto hoochladen wullt."

#: fbwidget.cpp:71
msgid "This is a clickable link to open Facebook home page in web browser."
msgstr ""
"Mit dissen Link kannst Du de Facebook-Tohuussiet mit Dien Nettkieker opmaken."

#: fbwidget.cpp:77
msgid "Account"
msgstr "Konto"

#: fbwidget.cpp:79
msgid "This is the Facebook account that will be used for upload."
msgstr "Dit is dat Facebook-Konto, na dat Du hoochlaaden wullt."

#: fbwidget.cpp:82
msgid "Name:"
msgstr "Naam:"

#: fbwidget.cpp:84
msgid "Permission:"
msgstr "Verlöven:"

#: fbwidget.cpp:86
msgid ""
"Permission of KIPI Plugin application to upload photos directly. If not, "
"user will need to manually approve uploaded photos in Facebook."
msgstr ""
"Verlöven vun't Kipi-Moduulprogramm för't Direkthoochladen. Wenn nich, mutt "
"de Bruker de hoochlaadt Biller op Facebook vun Hand tolaten."

#: fbwidget.cpp:89
msgid "Change Account"
msgstr "Konto ännern"

#: fbwidget.cpp:90
msgid "Logout and change Facebook Account used for upload"
msgstr "Afmellen un Facebook-Konto för't Hoochladen ännern."

#: fbwidget.cpp:93
msgid "Change Permission"
msgstr "Verlöven ännern"

#: fbwidget.cpp:94
msgid "Change permission for KIPI application for photo upload"
msgstr "Verlöven vun't Kipi-Programm för't Hoochladen ännern"

#: fbwidget.cpp:108
msgid "Album"
msgstr "Album"

#: fbwidget.cpp:110
msgid "This is the Facebook album where selected photos will be uploaded."
msgstr "Dit is dat Facebook-Album, na dat Du hoochladen wullt."

#: fbwidget.cpp:116
msgid "New Album"
msgstr "Nieg Album"

#: fbwidget.cpp:117
msgid "Create new Facebook album"
msgstr "Nieg Facebook-Album opstellen"

#: fbwidget.cpp:119
msgid "Reload"
msgstr "Nieg laden"

#: fbwidget.cpp:120
msgid "Reload album list"
msgstr "Albumlist nieg laden"

#: fbwidget.cpp:128
msgid "Options"
msgstr "Optschonen"

#: fbwidget.cpp:130
msgid "These are options that will be applied to photos before upload."
msgstr "Disse Optschonen warrt för de Fotos bruukt, ehr se hoochlaadt warrt."

#: fbwidget.cpp:134
msgid "Resize photos before uploading"
msgstr "Fotogrött ehr't Hoochladen ännern"

#: fbwidget.cpp:144
msgid "Maximum dimension:"
msgstr "Hööchstafmeten:"

#: fbwidget.cpp:152
msgid "JPEG quality:"
msgstr "JPEG-Gööd:"

#: fbwidget.cpp:209
msgid "Direct upload"
msgstr "Direktemang hoochladen"

#: fbwidget.cpp:211
msgid "Uploaded photos will not need manual approval by user."
msgstr "Hoochlaadt Fotos bruukt keen Prööv vun Hand vun den Bruker."

#: fbwidget.cpp:215
msgid "Manual upload approval"
msgstr "Hoochladenprööv vun Hand"

#: fbwidget.cpp:217
msgid ""
"Uploaded photos will wait in pending state until manually approved by user."
msgstr ""
"Hoochlaadt Fotos warrt torüchhollen, bet de Bruker se vun Hand tolaten hett."

#: fbwindow.cpp:75
msgid "Export to Facebook Web Service"
msgstr "Na Facebook-Nettdeenst exporteren"

#: fbwindow.cpp:87
msgid "Start Upload"
msgstr "Hoochladen starten"

#: fbwindow.cpp:88
msgid "Start upload to Facebook web service"
msgstr "Hoochladen na Facebook-Nettdeenst starten"

#: fbwindow.cpp:115
msgid "Fb Export"
msgstr "Facebook-Exporteren"

#: fbwindow.cpp:117
msgid "A Kipi plugin to export image collection to Facebook web service."
msgstr ""
"En KIPI-Moduul för't Exporteren vun Billersammeln na den Facebook-Nettdeenst."

