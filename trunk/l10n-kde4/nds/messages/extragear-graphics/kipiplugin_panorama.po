#: importwizard/itemspage.cpp:70
msgid "<b>Set Panorama Images</b>"
msgstr "<b>Biller för den Rundblick fastleggen</b>"

#: importwizard/itemspage.cpp:76
msgid ""
"<qt><p>Set here the list of your images to blend into a panorama. Please "
"follow these conditions:</p><ul><li>Images are taken from the same point of "
"view.</li><li>Images are taken with the same camera (and lens).</li><li>Do "
"not mix images with different color depth.</li></ul><p>Note that, in the "
"case of a 360° panorama, the first image in the list will be the image that "
"will be in the center of the panorama.</p></qt>"
msgstr ""

#: importwizard/lastpage.cpp:65
msgid "<b>Panorama Stitched</b>"
msgstr "<b>Rundblick wöör tosamensett</b>"

#: importwizard/lastpage.cpp:80
msgid "Save Settings"
msgstr "Instellen sekern"

#: importwizard/lastpage.cpp:84
msgid "File name template:"
msgstr "Dateinaam-Vörlaag:"

#: importwizard/lastpage.cpp:88
msgid "Name of the panorama file (without its extension)."
msgstr "Naam vun de Rundblick-Datei (ahn Verwiedern)"

#: importwizard/lastpage.cpp:89
msgid ""
"<b>File name template</b>: Set here the base name of the files that will be "
"saved. For example, if your template is <i>panorama</i> and if you chose a "
"JPEG output, then your panorama will be saved with the name <i>panorama.jpg</"
"i>. If you choose to save also the project file, it will have the name "
"<i>panorama.pto</i>."
msgstr ""

#: importwizard/lastpage.cpp:95
msgid "Save project file"
msgstr "Projektdatei sekern"

#: importwizard/lastpage.cpp:97
msgid "Save the project file for further processing within Hugin GUI."
msgstr ""

#: importwizard/lastpage.cpp:98
msgid ""
"<b>Save project file</b>: You can keep the project file generated to stitch "
"your panorama for further tweaking within <a href=\"http://hugin.sourceforge."
"net/\">Hugin</a> by checking this. This is useful if you want a different "
"projection, modify the horizon or the center of the panorama, or modify the "
"control points to get better results."
msgstr ""

#: importwizard/lastpage.cpp:191
#, kde-format
msgid ""
"<qt><p><h1><b>Panorama Stitching is Done</b></h1></p><p>Congratulations. "
"Your images are stitched into a panorama.</p><p>Your panorama will be "
"created to the directory</p><p><b>%1</b></p><p>once you press the <i>Finish</"
"i> button, with the name set below.</p><p>If you choose to save the project "
"file, and if your images were raw images then the converted images used "
"during the stitching process will be copied at the same time (those are TIFF "
"files that can be big).</p></qt>"
msgstr ""

#: importwizard/preprocessingpage.cpp:91
msgid "<b>Pre-Processing Images</b>"
msgstr "<b>Biller warrt torechtmaakt</b>"

#: importwizard/preprocessingpage.cpp:104
msgid "Detect moving skies"
msgstr ""

#: importwizard/preprocessingpage.cpp:106
msgid ""
"Automatic detection of clouds to prevent wrong keypoints matching between "
"images due to moving clouds."
msgstr ""

#: importwizard/preprocessingpage.cpp:108
msgid ""
"<b>Detect moving skies</b>: During the control points selection and "
"matching, this option discards any points that are associated to a possible "
"cloud. This is useful to prevent moving clouds from altering the control "
"points matching process."
msgstr ""

#: importwizard/preprocessingpage.cpp:116 importwizard/optimizepage.cpp:113
#: importwizard/previewpage.cpp:78
msgid "Details..."
msgstr "Enkelheiten..."

#: importwizard/preprocessingpage.cpp:161
msgid ""
"<qt><p>Pre-processing is under progress, please wait.</p><p>This can take a "
"while...</p></qt>"
msgstr ""

#: importwizard/preprocessingpage.cpp:211
#: importwizard/preprocessingpage.cpp:213 importwizard/optimizepage.cpp:262
#: importwizard/optimizepage.cpp:264
msgid "Pre-Processing Messages"
msgstr ""

#: importwizard/preprocessingpage.cpp:230
msgid ""
"<qt><p>Pre-processing has failed.</p><p>Press \"Details\" to show processing "
"messages.</p></qt>"
msgstr ""

#: importwizard/preprocessingpage.cpp:273
#, kde-format
msgid ""
"<qt><p>Now, we will pre-process images before stitching them.</p><p>Pre-"
"processing operations include Raw demosaicing. Raw images will be converted "
"to 16-bit sRGB images with auto-gamma.</p><p>Pre-processing also include a "
"calculation of some control points to match overlaps between images. For "
"that purpose, the <b>%1</b> program from the <a href='%2'>%3</a> project "
"will be used.</p><p>Press \"Next\" to start pre-processing.</p></qt>"
msgstr ""

#: importwizard/optimizepage.cpp:83
msgid "<b>Optimization</b>"
msgstr "<b>Verbetern</b>"

#: importwizard/optimizepage.cpp:96
msgid "Level horizon"
msgstr ""

#: importwizard/optimizepage.cpp:98
msgid "Detect the horizon and adapt the project to make it horizontal."
msgstr ""

#: importwizard/optimizepage.cpp:99
msgid ""
"<b>Level horizon</b>: Detect the horizon and adapt the projection so that "
"the detected horizon is an horizontal line in the final panorama"
msgstr ""

#: importwizard/optimizepage.cpp:101
msgid "Automatic projection and crop"
msgstr "Automaatsch afbillen un tosnieden"

#: importwizard/optimizepage.cpp:103
msgid ""
"Adapt the projection of the panorama and the cropping on the resulting "
"projection so that every photo fits in the resulting panorama."
msgstr ""

#: importwizard/optimizepage.cpp:105
msgid ""
"<b>Automatic projection and crop</b>: Automatically adapt the projection and "
"the crop of the panorama to get every photos into the panorama."
msgstr ""

#: importwizard/optimizepage.cpp:161
msgid ""
"<qt><p>Optimization is under progress, please wait.</p><p>This can take a "
"while...</p></qt>"
msgstr ""

#: importwizard/optimizepage.cpp:218
msgid ""
"<qt><p>Optimization has failed.</p><p>Press \"Details\" to show processing "
"messages.</p></qt>"
msgstr ""

#: importwizard/optimizepage.cpp:271
#, kde-format
msgid ""
"<qt><p><h1><b>Images Pre-Processing is Done</b></h1></p><p>The optimization "
"step according to your settings is ready to be performed.</p><p>This step "
"can include an automatic leveling of the horizon, and also an automatic "
"projection selection and size</p><p>To perform this operation, the <b>%1</b> "
"program from the <a href='%2'>%3</a> project will be used.</p><p>Press the "
"\"Next\" button to run the optimization.</p></qt>"
msgstr ""

#: importwizard/previewpage.cpp:69
msgid "<b>Preview and Post-Processing</b>"
msgstr "<b>Vöransicht un Nabearbeiden</b>"

#: importwizard/previewpage.cpp:111
msgid "Preview Processing Cancelled."
msgstr ""

#: importwizard/previewpage.cpp:117
msgid "Processing Panorama Preview..."
msgstr "Rundblick-Vöransicht warrt bearbeidt…"

#: importwizard/previewpage.cpp:134
msgid "<qt><p><h1>Panorama Post-Processing</h1></p></qt>"
msgstr "<qt><p><h1>Rundblick warrt nabearbeidt</h1></p></qt>"

#: importwizard/previewpage.cpp:153
msgid ""
"<qt><p><h1>Panorama Preview</h1></p><p>Pressing the <i>Next</i> button "
"launches the final stitching process.</p></qt>"
msgstr ""

#: importwizard/importwizarddlg.cpp:84
msgid "Panorama Creator Wizard"
msgstr ""

#: importwizard/importwizarddlg.cpp:89
msgid ""
"Hugin's tools have been detected. However, the version detected is not a "
"stable one. Be advised that it may lead to undefined behavior and we "
"strongly encourage you to switch to a stable one."
msgstr ""

#: importwizard/importwizarddlg.cpp:92
msgid "Development version of Hugin"
msgstr ""

#: importwizard/importwizarddlg.cpp:112
msgid "Handbook"
msgstr "Handbook"

#: importwizard/intropage.cpp:61
msgid "<b>Welcome to Panorama Tool</b>"
msgstr ""

#: importwizard/intropage.cpp:67
msgid ""
"<qt><p><h1><b>Welcome to Panorama tool</b></h1></p><p>This tool stitches "
"several images together to create a panorama, making the seam between images "
"not visible.</p><p>This assistant will help you to configure how to import "
"images before stitching them into a panorama.</p><p>Images must be taken "
"from the same point of view.</p><p>For more information, please take a look "
"at <a href='http://hugin.sourceforge.net/tutorials/overview/en.shtml'>this "
"page</a></p></qt>"
msgstr ""

#: importwizard/intropage.cpp:82
msgid "Panorama Settings:"
msgstr "Panorama-Instellen:"

#: importwizard/intropage.cpp:84
msgid "HDR output"
msgstr "HDR-Utgaav"

#: importwizard/intropage.cpp:85
msgid ""
"When checked, the panorama will be stitched into an High Dynamic Range (HDR) "
"image, that can be processed further with a dedicated software."
msgstr ""

#: importwizard/intropage.cpp:87
msgid ""
"<b>HDR output</b>: Output in High Dynamic Range, meaning that every piece of "
"information contained in the original photos are preserved. Note that you "
"need another software to process the resulting panorama, like <a href="
"\"http://qtpfsgui.sourceforge.net/\">Luminance HDR</a>"
msgstr ""

#: importwizard/intropage.cpp:93
msgid "File Format"
msgstr "Dateiformaat"

#: importwizard/intropage.cpp:98
msgid "JPEG output"
msgstr "JPEG-Utgaav"

#: importwizard/intropage.cpp:100
#, no-c-format
msgid ""
"Selects a JPEG output with 90% compression rate (lossy compression, smaller "
"size)."
msgstr ""

#: importwizard/intropage.cpp:102
msgid ""
"<b>JPEG output</b>: Using JPEG output, the panorama file will be smaller at "
"the cost of information loss during compression. This is the easiest way to "
"share the result, or print it online or in a shop."
msgstr ""

#: importwizard/intropage.cpp:107
msgid "TIFF output"
msgstr "TIFF-Utgaav"

#: importwizard/intropage.cpp:108
msgid ""
"Selects a TIFF output compressed using the LZW algorithm (lossless "
"compression, bigger size)."
msgstr ""

#: importwizard/intropage.cpp:110
msgid ""
"<b>TIFF output</b>: Using TIFF output, you get the same color depth than "
"your original photos using RAW images at the cost of a bigger panorama file."
msgstr ""

