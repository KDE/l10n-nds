#: flickrtalker.cpp:165
msgid "Getting the Frob"
msgstr "Frob warrt haalt"

#: flickrtalker.cpp:200
msgid "Checking if previous token is still valid"
msgstr "An't Pröven, wat de verleden Beglövenslötel noch gellt"

#: flickrtalker.cpp:226
msgid ""
"Please Follow through the instructions in the browser window and return back "
"to press ok if you are authenticated or press No"
msgstr ""
"Bitte holl Di an de Anwiesen in't Nettkiekerfinster, kumm denn torüch un "
"klick na de Identiteetprööv op \"OK\", oder klick op \"Nee\"."

#: flickrtalker.cpp:228
msgid "Flickr Service Web Authorization"
msgstr "Flickr-Nettidentiteetprööv"

#: flickrtalker.cpp:233
msgid "Authenticating the User on web"
msgstr "Bruker-Identiteet warrt pröövt"

#: flickrtalker.cpp:274
msgid "Getting the Token from the server"
msgstr "Beglövenslötel warrt vun den Server haalt"

#: flickrtalker.cpp:518
msgid "No photo specified"
msgstr "Keen Foto angeven"

#: flickrtalker.cpp:521
msgid "General upload failure"
msgstr "Allgemeen Hoochlaadfehler"

#: flickrtalker.cpp:524
msgid "Filesize was zero"
msgstr "Dateigrött weer Null"

#: flickrtalker.cpp:527
msgid "Filetype was not recognized"
msgstr "Dateityp nich begäng"

#: flickrtalker.cpp:530
msgid "User exceeded upload limit"
msgstr "Bi Bruker-Hoochlaadgrenz anlangt"

#: flickrtalker.cpp:533
msgid "Invalid signature"
msgstr "Ünnerschrift is leeg"

#: flickrtalker.cpp:536
msgid "Missing signature"
msgstr "Ünnerschrift fehlt"

#: flickrtalker.cpp:539
msgid "Login Failed / Invalid auth token"
msgstr "Anmellen fehlslaan / Leeg Beglövenslötel"

#: flickrtalker.cpp:542
msgid "Invalid API Key"
msgstr "Leeg Api-Slötel"

#: flickrtalker.cpp:545
msgid "Service currently unavailable"
msgstr "Deenst opstunns nich verföögbor"

#: flickrtalker.cpp:548
msgid "Invalid Frob"
msgstr "Leeg Frob"

#: flickrtalker.cpp:551
msgid "Format \"xxx\" not found"
msgstr "Formaat  \"xxx\" lett sik nich finnen"

#: flickrtalker.cpp:554
msgid "Method \"xxx\" not found"
msgstr "Metood  \"xxx\" lett sik nich finnen"

#: flickrtalker.cpp:557
msgid "Invalid SOAP envelope"
msgstr "Leeg SOAP-Envelope"

#: flickrtalker.cpp:560
msgid "Invalid XML-RPC Method Call"
msgstr "Leeg \"XML-RPC\"-Metodenoproop"

#: flickrtalker.cpp:563
msgid "The POST method is now required for all setters"
msgstr "De POST-Metood deit nu för all Instellers noot"

#: flickrtalker.cpp:566
msgid "Unknown error"
msgstr "Nich begäng Fehler"

#: flickrtalker.cpp:571
#, kde-format
msgid ""
"Error Occurred: %1\n"
" We can not proceed further"
msgstr ""
"Dat geev en Fehler: %1\n"
"Wiedermaken nich mööglich."

#: flickrtalker.cpp:718
msgctxt "As in the persmission to"
msgid "write"
msgstr "Schrieven"

#: flickrtalker.cpp:720
msgctxt "As in the permission to"
msgid "read"
msgstr "Lesen"

#: flickrtalker.cpp:722
msgctxt "As in the permission to"
msgid "delete"
msgstr "Wegdoon"

#: flickrtalker.cpp:752
msgid "Your token is invalid. Would you like to get a new token to proceed ?\n"
msgstr ""
"Dien Beglövenslötel is leeg. Wullt Du en niegen Beglövenslötel halen, dormit "
"Du wiedermaken kannst?\n"

#: flickrtalker.cpp:928
msgid "Failed to fetch photoSets List"
msgstr "Fotosetten-List lett sik nich halen"

#: flickrtalker.cpp:998
msgid "Failed to upload photo"
msgstr "Foto lett sik nich hoochladen"

#: flickrtalker.cpp:1044
msgid "Failed to query photo information"
msgstr "Fotoinformatschonen laat sik nich affragen"

#: flickrwidget.cpp:73
msgid ""
"<b><h2><a href='http://www.flickr.com'><font color=\"#0065DE\">flick</"
"font><font color=\"#FF0084\">r</font></a> Export</h2></b>"
msgstr ""
"<b><h2><a href='http://www.flickr.com'><font color=\"#0065DE\">flick</"
"font><font color=\"#FF0084\">r</font></a>-Exporteren</h2></b>"

#: flickrwidget.cpp:84
msgid "This is the list of images to upload on your Flickr account."
msgstr ""
"Dit is de List vun Biller, de Du na Dien Flickr-Konto hoochladen wullt."

#: flickrwidget.cpp:94
msgid "Added Tags: "
msgstr "Toföögt Betekers: "

#: flickrwidget.cpp:97
msgid "Use Host Application Tags"
msgstr "Reeknerprogrammbetekers bruken"

#: flickrwidget.cpp:99
msgid "Strip Space From Host Application Tags"
msgstr "Freeteken ut de Reeknerprogrammbetekers wegmaken"

#: flickrwidget.cpp:100
msgid "Enter here new tags separated by space."
msgstr "Giff hier niege Betekers in, optrennt dör Freetekens."

#: flickrwidget.cpp:109
msgid "Override Default Options"
msgstr "Standardoptschonen övergahn"

#: flickrwidget.cpp:113
msgctxt "As in accessible for people"
msgid "Public (anyone can see them)"
msgstr "Apen (kann elkeen ankieken)"

#: flickrwidget.cpp:116
msgid "Visible to Family"
msgstr "Kann de Familie ankieken"

#: flickrwidget.cpp:119
msgid "Visible to Friends"
msgstr "Köönt Frünnen ankieken"

#: flickrwidget.cpp:122
msgid "Resize photos before uploading"
msgstr "Fotogrött ehr't Hoochladen ännern"

#: flickrwidget.cpp:133
msgid "Maximum dimension (pixels):"
msgstr "Hööchstafmeten in Pixels:"

#: flickrwidget.cpp:143
msgid "JPEG Image Quality (higher is better):"
msgstr "JPEG-Bildgööd (höger is beter):"

