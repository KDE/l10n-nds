msgid "Account"
msgstr "Konto"

#: flickrwidget.cpp:163
msgid "User Name: "
msgstr "Brukernaam: "

#: flickrwidget.cpp:166
msgid "Use a different account"
msgstr "En anner Konto bruken"

#: flickrwidget.cpp:191
msgid "Files List"
msgstr "Dateilist"

#: flickrwidget.cpp:192
msgid "Upload Options"
msgstr "Hoochlaad-Optschonen"

#: flickrwindow.cpp:78
msgid "Export to Flickr Web Service"
msgstr "Na Flickr-Nettdeenst exporteren"

#: flickrwindow.cpp:104
msgid "Start Uploading"
msgstr "Hoochladen starten"

#: flickrwindow.cpp:118
msgid "Flickr Export"
msgstr "Flickr-Export"

#: flickrwindow.cpp:121
msgid "A Kipi plugin to export image collection to Flickr web service."
msgstr ""
"En KIPI-Moduul för't Exporteren vun Billersammeln na den Flickr-Nettdeenst."

