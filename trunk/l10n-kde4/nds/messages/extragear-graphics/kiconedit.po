msgstr "Krink"

#: kiconedit.cpp:428
#, kde-format
msgid ""
"Circle\n"
"\n"
"Draw a circle"
msgstr ""
"Krink\n"
"\n"
"Krink teken"

#: kiconedit.cpp:432
#, kde-format
msgid "Filled Circle"
msgstr "Vullmaakt Krink"

#: kiconedit.cpp:436
#, kde-format
msgid ""
"Filled circle\n"
"\n"
"Draw a filled circle"
msgstr ""
"Vullmaakt Krink\n"
"\n"
"Vullmaakt Krink teken"

#: kiconedit.cpp:440
#, kde-format
msgid "Ellipse"
msgstr "Ellips"

#: kiconedit.cpp:444
#, kde-format
msgid ""
"Ellipse\n"
"\n"
"Draw an ellipse"
msgstr ""
"Ellips\n"
"\n"
"Ellips teken"

#: kiconedit.cpp:448
#, kde-format
msgid "Filled Ellipse"
msgstr "Vullmaakt Ellips"

#: kiconedit.cpp:452
#, kde-format
msgid ""
"Filled ellipse\n"
"\n"
"Draw a filled ellipse"
msgstr ""
"Vullmaakt Ellips\n"
"\n"
"Vullmaakt Ellips teken"

#: kiconedit.cpp:456
#, kde-format
msgid "Spray"
msgstr "Spröhen"

#: kiconedit.cpp:460
#, kde-format
msgid ""
"Spray\n"
"\n"
"Draw scattered pixels in the current color"
msgstr ""
"Spröhen\n"
"\n"
"Verdeelte Pixels vun de aktuelle Klöör teken"

#: kiconedit.cpp:465
#, kde-format
msgid "Flood Fill"
msgstr "Vullmaken"

#: kiconedit.cpp:469
#, kde-format
msgid ""
"Flood fill\n"
"\n"
"Fill adjoining pixels with the same color with the current color"
msgstr ""
"Vullmaken\n"
"\n"
"Tosamenhangen liekklöörte Pixels mit de aktuelle Klöör infarven"

#: kiconedit.cpp:474
#, kde-format
msgid "Line"
msgstr "Lien"

#: kiconedit.cpp:478
#, kde-format
msgid ""
"Line\n"
"\n"
"Draw a straight line vertically, horizontally or at 45 deg. angles"
msgstr ""
"Lien\n"
"\n"
"En graad Lien pielrecht, kimmrecht oder in Winkels vun 45 Graad teken"

#: kiconedit.cpp:483
#, kde-format
msgid "Eraser (Transparent)"
msgstr "Radeergummi (dörsichtig)"

#: kiconedit.cpp:487
#, kde-format
msgid ""
"Erase\n"
"\n"
"Erase pixels. Set the pixels to be transparent\n"
"\n"
"(Tip: If you want to draw transparency with a different tool, first click on "
"\"Erase\" then on the tool you want to use)"
msgstr ""
"Raderen\n"
"\n"
"Maakt Pixels weg (dörsichtig)\n"
"\n"
"(Tipp: Wenn Du mit en anner Warktüüch wat dörsichtig teken wullt, klick "
"toeerst op \"Raderen\" un denn op dat Warktüüch, dat Du bruken wullt)"

#: kiconedit.cpp:494
#, kde-format
msgid "Rectangular Selection"
msgstr "Rechteck-Köör"

#: kiconedit.cpp:498
#, kde-format
msgid ""
"Select\n"
"\n"
"Select a rectangular section of the icon using the mouse."
msgstr ""
"Utsöken\n"
"\n"
"Markeer mit de Muus en rechteckig Rebeet vun't Lüttbild."

#: kiconedit.cpp:503
#, kde-format
msgid "Circular Selection"
msgstr "Krink-Köör"

#: kiconedit.cpp:507
#, kde-format
msgid ""
"Select\n"
"\n"
"Select a circular section of the icon using the mouse."
msgstr ""
"Utsöken\n"
"\n"
"Markeer mit de Muus en rund Rebeet vun't Lüttbild."

#: kiconedit.cpp:535
#, kde-format
msgid ""
"Statusbar\n"
"\n"
"The statusbar gives information on the status of the current icon. The "
"fields are:\n"
"\n"
"\t- Application messages\n"
"\t- Cursor position\n"
"\t- Size\n"
"\t- Zoom factor\n"
"\t- Number of colors"
msgstr ""
"Statusbalken\n"
"\n"
"De Statusbalken bargt Informatschonen över dat aktuelle Lüttbild. De Feller "
"sünd:\n"
"\n"
"\t- Programm-Mellen\n"
"\t- Blinkerpositschoon\n"
"\t- Grött\n"
"\t- Ansichtgrött\n"
"\t- Tall vun Klören"

