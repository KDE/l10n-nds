#. i18n: ectx: property (text), widget (QLabel, textLabel1)
#: src/mainwindow.ui:100
msgid "Status:"
msgstr "Status:"

#. i18n: ectx: property (whatsThis), widget (KComboBox, m_statusCombo)
#: src/mainwindow.ui:122
msgid ""
"<qt>The status of the current alternative:\n"
"<ul>\n"
"<li>Automatic: the alternative system will always choose the alternative "
"with the highest priority, updating it (if necessary) when an alternative is "
"installed or removed</li>\n"
"<li>Manual: the choice is done manually, updated by the alternative system "
"only when it is uninstalled</li>\n"
"</ul>\n"
"</qt>\n"
msgstr ""
"<qt>De Status vun de aktuelle Alternatiev:\n"
"<ul>\n"
"<li>Automaatsch: Dat Alternativen-Systeem söcht jümmers de Alternatiev mit "
"de hööchste Prioriteet ut un frischt ehr op (wenn't noot deit), wenn en "
"Alternatiev installeert oder wegmaakt warrt.</li>\n"
"<li>Vun Hand: De Köör warrt vun Hand maakt un bloots vun't Alternativen-"
"Systeem opfrischt, wenn de utsöchte Alternatiev wegmaakt warrt.</li>\n"
"</ul>\n"
"</qt>\n"

