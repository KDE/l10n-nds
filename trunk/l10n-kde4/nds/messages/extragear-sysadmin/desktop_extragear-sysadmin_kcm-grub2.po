#: other/kcm_grub2.desktop:12
msgctxt "Name"
msgid "GRUB2 Bootloader"
msgstr "Systeemstarter Grub2"

#: other/kcm_grub2.desktop:46
msgctxt "Comment"
msgid "Customize the GRUB2 bootloader"
msgstr "Systeemstarter Grub2 topassen"

#: other/kcm_grub2.desktop:78
msgctxt "X-KDE-Keywords"
msgid ""
"grub,boot,menu,entries,default,timeout,password,color,splash,image,bootloader"
msgstr ""

#: src/helper/kcmgrub2.actions:2
msgctxt "Name"
msgid "GRUB2 Bootloader Control Module"
msgstr "Kuntrullmoduul för den Systeemstarter Grub2"

#: src/helper/kcmgrub2.actions:39
msgctxt "Name"
msgid "Restore the default GRUB2 Bootloader settings"
msgstr "De Standard-Instellen för den Systeemstarter Grub2 wedderherstellen"

#: src/helper/kcmgrub2.actions:73
msgctxt "Description"
msgid ""
"Administrator authorization is required to restore the default GRUB2 "
"Bootloader settings"
msgstr ""
"De Standard-Instellen för den Systeemstarter Grub2 laat sik bloots mit "
"Systeempleger-Verlööf wedderherstellen."

#: src/helper/kcmgrub2.actions:110
msgctxt "Name"
msgid "Install the GRUB2 Bootloader"
msgstr "Systeemstarter Grub2 installeren"

#: src/helper/kcmgrub2.actions:144
msgctxt "Description"
msgid "Administrator authorization is required to install the GRUB2 Bootloader"
msgstr ""
"De Systeemstarter Grub2 lett sik bloots mit Systeempleger-Verlööf installeren"

#: src/helper/kcmgrub2.actions:182
msgctxt "Name"
msgid "Load the GRUB2 Bootloader settings"
msgstr "De Instellen för den Systeemstarter Grub2 laden"

#: src/helper/kcmgrub2.actions:216
msgctxt "Description"
msgid ""
"Administrator authorization is required to load the GRUB2 Bootloader settings"
msgstr ""
"De Instellen för den Systeemstarter Grub2 laat sik bloots mit Systeempleger-"
"Verlööf laden."

#: src/helper/kcmgrub2.actions:254
msgctxt "Name"
msgid "Probe devices for their GRUB2 names"
msgstr "De Reedschappen ehr Grub2-Naams opdecken"

#: src/helper/kcmgrub2.actions:287
msgctxt "Description"
msgid ""
"Administrator authorization is required to probe devices for their GRUB2 "
"names"
msgstr ""
"De Reedschappen ehr Grub2-Naams laat sik bloots mit Systeempleger-Verlööf "
"opdecken."

#: src/helper/kcmgrub2.actions:323
msgctxt "Name"
msgid "Probe VESA BIOS Extensions"
msgstr "VESA-BIOS-Verwiedern opdecken"

#: src/helper/kcmgrub2.actions:356
msgctxt "Description"
msgid "Administrator authorization is required to probe VESA BIOS Extensions"
msgstr ""
"De VESA-BIOS-Verwiedern laat sik bloots mit Systeempleger-Verlööf opdecken."

#: src/helper/kcmgrub2.actions:392
msgctxt "Name"
msgid "Save the GRUB2 Bootloader settings"
msgstr "De Instellen för den Systeemstarter Grub2 sekern"

#: src/helper/kcmgrub2.actions:426
msgctxt "Description"
msgid ""
"Administrator authorization is required to save the GRUB2 Bootloader settings"
msgstr ""
"De Instellen för den Systeemstarter Grub2 laat sik bloots mit Systeempleger-"
"Verlööf sekern."
