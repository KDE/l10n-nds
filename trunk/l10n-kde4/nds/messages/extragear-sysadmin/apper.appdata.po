#. (itstool) path: component/name
#: apper.appdata.xml:6
msgid "Apper"
msgstr "Apper"

#. (itstool) path: component/summary
#: apper.appdata.xml:7
msgid "KDE application and package management tool"
msgstr "KDE sien Programm- un Paketpleeg-Warktüüch"

#. (itstool) path: description/p
#: apper.appdata.xml:9
msgid ""
"Apper is a graphical management tool for packages and applications provided "
"by a Linux distribution."
msgstr ""
"Apper is en graafsch Pleegwarktüüch för de Paketen un Programmen, de en "
"Distributschoon praastellt."

#. (itstool) path: description/p
#: apper.appdata.xml:13
msgid ""
"It allows installing new software as well as keeping the system up to date "
"by installing updates."
msgstr ""
"Du kannst dor nieg Paketen mit installeren un Opfrischen för't Systeem "
"inspelen."

#. (itstool) path: description/p
#: apper.appdata.xml:17
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#: apper.appdata.xml:19
msgid "Distribution-agnostic management of software packages"
msgstr "Distributschoon-Unafhängig Pleeg vun Software-Paketen"

#. (itstool) path: ul/li
#: apper.appdata.xml:20
msgid "Application management for users unexperienced with packages"
msgstr "Programmpleeg för Brukers, de nich veel vun Paketen af weet."

#. (itstool) path: ul/li
#: apper.appdata.xml:21
msgid "Editor for software sources and PackageKit settings"
msgstr "Editor för Software-Borns un PackageKit-Instellen"

#. (itstool) path: ul/li
#: apper.appdata.xml:22
msgid "System software updates notifier and installer"
msgstr "Gifft Bescheed över Software-Opfrischen un installeert de ok"

#. (itstool) path: ul/li
#: apper.appdata.xml:23
msgid "Close integration with the KDE Plasma desktop"
msgstr "Drang Integreren mit den KDE-Plasma-Schriefdisch"
