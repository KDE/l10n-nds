msgstr "De Funkschoon BESSELJ() gifft de \"Bessel\"-Funkschoon torüch."

#: functions/engineering.xml:63
msgid "BESSELJ(X;N)"
msgstr "BESSELJ(X;N)"

#: functions/engineering.xml:64
