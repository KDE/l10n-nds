msgstr "EXPONDIST(3;0,5;0) gifft \"0,111565\" torüch"

#: functions/statistical.xml:325
msgid "EXPONDIST(3;0.5;1) equals 0.776870"
msgstr "EXPONDIST(3;0,5;1) gifft \"0,776870\" torüch"

