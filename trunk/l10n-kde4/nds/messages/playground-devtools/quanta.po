#~ msgid "Show tooltips for the items."
#~ msgstr "Kortinfos för de Indrääg wiesen"

#~ msgid ""
#~ "If this option is true the tree will display tooltips with additional "
#~ "information about the files and folders of the filesystem."
#~ msgstr ""
#~ "Wenn dit \"Wohr\" is, warrt Kortinfos mit mehr Informatschonen över de "
#~ "Dateien un Ornern vun't Dateisysteem wiest."

#~ msgid "Remember the status of the tree."
#~ msgstr "Den Boom sien Status wohren"

#~ msgid ""
#~ "If this option is true the tree will save the status and try to open all "
#~ "folders again and resize the columns."
#~ msgstr ""
#~ "Wenn dit \"Wohr\" is, wohrt de Boom sien Status, he maakt Ornern wedder "
#~ "op ok de Striep warrt wedder herstellt."

#~ msgid "Always show the Root and Home items."
#~ msgstr "Jümmers Tohuus- un Wörtelornerindrääg wiesen"

#~ msgid ""
#~ "If this option is true the tree will show two entries for Root and the "
#~ "Home folder which can not be removed."
#~ msgstr ""
#~ "Is dit \"Wohr\", wiest de Boom Indrääg för de Wörtel un den Tohuusorner, "
#~ "de sik nich wegmaken laat."

#~ msgid "Show hidden files and folder in the tree."
#~ msgstr "Versteken Dateien un Ornern binnen den Boom wiesen"

#~ msgid ""
#~ "If this option is true the tree will display entries for hidden files and "
#~ "folders of the filesystem."
#~ msgstr ""
#~ "Wenn dit \"Wohr\" is, warrt versteken Dateien un Ornern binnen den "
#~ "Dateisysteemboom wiest."

#~ msgid "Show whitespace areas and empty groups in the trees"
#~ msgstr "Freetekenrebeden un leddig Koppeln binnen Bööm wiesen"

#~ msgid ""
#~ "If this option is true the tree will display entries for areas with "
#~ "whitespaces in between tags. All defined groups of the document will also "
#~ "be shown even if no element was found in the document."
#~ msgstr ""
#~ "Is disse Optschoon \"Wohr\", wiest de Boom Indrääg för Freeruum twischen "
#~ "Betekers. Dat Dokment sien fastleggt Koppeln warrt ok all wiest, ok wenn "
#~ "se keen Elementen bargt."

#~ msgid "Show closing tags in the tree"
#~ msgstr "Ennbetekers binnen den Boom wiesen"

#~ msgid ""
#~ "If this option is true the tree will display entries for closing tags."
#~ msgstr "Is disse Optschoon \"Wohr\", wiest de Boom Indrääg för Ennbetekers."

#~ msgid "Adjust the Structure Tree to the cursor position"
#~ msgstr "Struktuurboom na de Blinkersteed topassen"

#~ msgid ""
#~ "If this option is true the tree will scroll to the item that belongs to "
#~ "the current cursor position in the document."
#~ msgstr ""
#~ "Is disse Optschoon \"Wohr\", rullt de Boom na dat Element, binnen dat de "
#~ "Blinker opstunns binnen dat Dokment steiht."

#~ msgid "Enable auto-completion"
#~ msgstr "Autom. Kompletteren bruken"

#~ msgid ""
#~ "If true, the completion hints are shown automatically as the user types. "
#~ "If false, the completion hints can still be invoked manually."
#~ msgstr ""
#~ "Wenn anmaakt, warrt de mööglichen Kompletteren automaatsch wiest, wen de "
#~ "Bruker wat ingifft. Wenn utmaakt, laat sik de Kompletteren jümmers noch "
#~ "vun Hand opropen."

#~ msgid "Auto-close non single and non optional tags"
#~ msgstr "Normaal Betekers automaatsch afsluten"

#~ msgid ""
#~ "If true, when the closing char for a non single and non optional tag is "
#~ "entered, the corresponding closing tag is automatically inserted."
#~ msgstr ""
#~ "Wenn anmaakt, warrt de Ennbeteker automaatsch inföögt, wenn dat "
#~ "Tomaakteken för en normaal Beteker ingeven warrt."

#~ msgid ""
#~ "If true, when the closing char for a tag is entered, and the closing tag "
#~ "for this tag is optional, the corresponding closing tag is automatically "
#~ "inserted."
#~ msgstr ""
#~ "Wenn anmaakt, warrt de tohören Ennbeteker automaatsch inföögt, wenn dat "
#~ "Tomaakteken för en Beteker ingeven warrt un de Ennbeteker köörfree is."

#~ msgid "Update opening/closing tags automatically"
#~ msgstr "Start- un Ennbetekers automaatsch opfrischen"

#~ msgid ""
#~ "When this option is true the closing pair of a tag is automatically "
#~ "updated when the opening tag is changed and vice-versa."
#~ msgstr ""
#~ "Wenn disse Optschoon \"Wohr\" is, warrt de tohören Ennbeteker automaatsch "
#~ "opfrischt, wenn Een den Startbeteker ännert, un annersrüm."

#~ msgid ""
#~ "If activated, the accented characters will be automatically replaced on "
#~ "typing with their corresponding XML enitities."
