#: text_calendar.cpp:278
#, kde-format
msgid "No attachment named \"%1\" found in the invitation."
msgstr "Keen Bilaag mit den Naam \"%1\" binnen de Inladen funnen"

#: text_calendar.cpp:286
#, kde-format
msgid ""
"The invitation attachment \"%1\" is a web link that is inaccessible from "
"this computer. Please ask the event organizer to resend the invitation with "
"this attachment stored inline instead of a link."
msgstr ""
"De Inladen-Bilaag \"%1\" is en Nettlink, op den sik vun dissen Reekner nich "
"togriepen lett. Fraag bitte den Utrichter vun't Begeefnis, wat he de Inladen "
"nochmaal mit de Bilaag binnenreegs ansteed as Link loosstüern kann."

#: text_calendar.cpp:333
msgid ""
"<qt>None of your identities match the receiver of this message,<br />please "
"choose which of the following addresses is yours, if any, or select one of "
"your identities to use in the reply:</qt>"
msgstr ""
"<qt>De Adressaat vun disse Naricht passt op keen vun Dien Identiteten<br /"
">söök bitte de Adress ut, de Dien is, oder söök een vun Dien Identiteten för "
"de Antwoort ut:</qt>"

#: text_calendar.cpp:340
msgid ""
"<qt>Several of your identities match the receiver of this message,<br /"
">please choose which of the following addresses is yours:</qt>"
msgstr ""
"<qt>De Adressaat vun disse Naricht passt op mehr vun Dien Identiteten,<br /"
">giff bitte de Adress an, de Dien is:</qt>"

#: text_calendar.cpp:355
msgid "Select Address"
msgstr "Adress utsöken"

#: text_calendar.cpp:412
msgid "Answer: "
msgstr "Antwoort: "

#: text_calendar.cpp:414
#, kde-format
msgctxt "Not able to attend."
msgid "Declined: %1"
msgstr "Afwiest: %1"

#: text_calendar.cpp:416
#, kde-format
msgctxt "Unsure if it is possible to attend."
msgid "Tentative: %1"
msgstr "Vörlöpig: %1"

#: text_calendar.cpp:418
#, kde-format
msgctxt "Accepted the invitation."
msgid "Accepted: %1"
msgstr "Annahmen: %1"

#: text_calendar.cpp:549
msgid "Incidence with no summary"
msgstr "Begeefnis ahn Tosamenfaten"

#: text_calendar.cpp:553
#, kde-format
msgid "Answer: %1"
msgstr "Antwoort: %1"

#: text_calendar.cpp:556
#, kde-format
msgid "Delegated: %1"
msgstr "Afgeven: %1"

#: text_calendar.cpp:559
#, kde-format
msgid "Forwarded: %1"
msgstr "Wiederleddt: %1"

#: text_calendar.cpp:562
#, kde-format
msgid "Declined Counter Proposal: %1"
msgstr "Afwiest Gegenvörslag: %1"

#: text_calendar.cpp:627
msgid "Reaction to Invitation"
msgstr "Antwoort op Inladen"

#: text_calendar.cpp:628 text_calendar.cpp:857
msgid "Comment:"
msgstr "Kommentar:"

#: text_calendar.cpp:662
msgid "Delegation to organizer is not possible."
msgstr "Afgeven na den Utrichter is nich mööglich"

#: text_calendar.cpp:788
msgid "Save Invitation Attachment"
msgstr "Inladen-Bilaag sekern"

#: text_calendar.cpp:795
#, kde-format
msgctxt "@info"
msgid "File <filename>%1</filename> exists.<nl/> Do you want to replace it?"
msgstr ""
"Dat gifft de Datei <filename>%1</filename> al.<nl/> Wullt Du ehr "
"överschrieven?"

#: text_calendar.cpp:856
msgid "Decline Counter Proposal"
msgstr "Gegenvörslag afwiesen"

#: text_calendar.cpp:889
msgid ""
"You have no writable calendar folders for invitations, so storing or saving "
"a response will not be possible.\n"
"Please create at least 1 writable events calendar and re-sync."
msgstr ""
"Dien Kalenner bargt keen schriefbor Ornern för Inladen, dat heet, Sekern "
"oder spiekern vun Antwoorden geiht nich.\n"
"Bitte stell tominnst een schriefbor Begeefniskalenner op un synkroniseer "
"nieg."

#: text_calendar.cpp:959
msgctxt "@info"
msgid ""
"The organizer is not expecting a reply to this invitation but you can send "
"them an email message if you desire.\n"
"\n"
"Would you like to send the organizer a message regarding this invitation?\n"
"Press the [Cancel] button to cancel the recording operation."
msgstr ""
"De Utrichter verwacht keen Antwoort op de Inladen, man Du kannst em liekers "
"een tostüern.\n"
"\n"
"Wullt Du em wegen de Inladen en Naricht tostüern?\n"
"Klick op \"Afbreken\", wenn Du afbreken wullt."

#: text_calendar.cpp:963
msgctxt "@title:window"
msgid "Send Email to Organizer"
msgstr "Den Utrichter en Nettbreef tostüern"

#: text_calendar.cpp:964
msgid "Do Not Send"
msgstr "Nich loosstüern"

#: text_calendar.cpp:965
msgid "Send EMail"
msgstr "Nettbreef loosstüern"

#: text_calendar.cpp:973
#, kde-format
msgid "Re: %1"
msgstr "Antwoort: %1"

#: text_calendar.cpp:1037
msgid "Open Attachment"
msgstr "Bilaag opmaken"

#: text_calendar.cpp:1039
msgid "Save Attachment As..."
msgstr "Bilaag sekern as..."

#: text_calendar.cpp:1056
msgid "Accept invitation"
msgstr "Inladen annehmen"

#: text_calendar.cpp:1058
msgid "Accept invitation conditionally"
msgstr "Inladen mit Beding annehmen"

#: text_calendar.cpp:1060
msgid "Accept counter proposal"
msgstr "Gegenvörslag annehmen"

#: text_calendar.cpp:1062
msgid "Create a counter proposal..."
msgstr "En Gegenvörslag opstellen..."

#: text_calendar.cpp:1064
msgid "Throw mail away"
msgstr "Naricht wegsmieten"

#: text_calendar.cpp:1066
msgid "Decline invitation"
msgstr "Inladen afwiesen"

#: text_calendar.cpp:1068
msgid "Decline counter proposal"
msgstr "Gegenvörslag afwiesen"

#: text_calendar.cpp:1070
msgid "Check my calendar..."
msgstr "In Kalenner nakieken..."

#: text_calendar.cpp:1072
msgid "Record response into my calendar"
msgstr "Anter binnen Kalenner opteken..."

#: text_calendar.cpp:1074
msgid "Record invitation into my calendar"
msgstr "Inladen den Kalenner tofögen"

#: text_calendar.cpp:1076
msgid "Move this invitation to my trash folder"
msgstr "Inladen na den Affallorner verschuven"

#: text_calendar.cpp:1078
msgid "Delegate invitation"
msgstr "Inladen afgeven"

#: text_calendar.cpp:1080
msgid "Forward invitation"
msgstr "Inladen wiederledden"

#: text_calendar.cpp:1082
msgid "Remove invitation from my calendar"
msgstr "Inladen ut Kalenner wegmaken"

#: text_calendar.cpp:1085
#, kde-format
msgid "Open attachment \"%1\""
msgstr "Bilaag \"%1\" opmaken"

#: attendeeselector.cpp:31
msgid "Select Attendees"
msgstr "Deelnehmers utsöken"

#: attendeeselector.cpp:41
msgid "Click to add a new attendee"
msgstr "Klick hier, wenn Du en nieg Deelnehmer tofögen wullt"

#: delegateselector.cpp:34
msgid "Select delegate"
msgstr "Viez utsöken"

#: delegateselector.cpp:41
msgid "Delegate:"
msgstr "Afgeven:"

#: delegateselector.cpp:44
msgid "Keep me informed about status changes of this incidence."
msgstr "Mi över Ännern för dit Begeefnis op Stand hollen"

