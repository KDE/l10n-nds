#: jobs.cpp:240
msgid "Unable to create POP3 slave, aborting mail check."
msgstr ""
"POP3-Moduul lett sik nich opstellen, Kieken na Nettpost warrt afbraken."

#: pop3resource.cpp:92
msgid "Mail check aborted."
msgstr "Kieken na Nettpost afbraken."

#: pop3resource.cpp:98
msgid "Mail check was canceled manually."
msgstr "Kieken na Nettpost wöör vun Hand afbraken."

#: pop3resource.cpp:132
#, kde-format
msgid "Please enter the username and password for account '%1'."
msgstr "Giff bitte Brukernaam un Passwoort för dat Konto \"%1\" in."

#: pop3resource.cpp:158
msgid ""
"You are asked here because the password could not be loaded from the wallet."
msgstr ""
"Disse Affraag dukt op, wiel dat Passwoort sik nich ut de Knipp laden lett."

#: pop3resource.cpp:195
msgid "Account:"
msgstr "Konto:"

#: pop3resource.cpp:197
msgid "No username and password supplied."
msgstr "Keen Brukernaam un Passwoort angeven."

#: pop3resource.cpp:234
#, kde-format
msgid "Preparing transmission from \"%1\"."
msgstr "Överdregen vun \"%1\" warrt torechtmaakt."

#: pop3resource.cpp:261
msgid "Executing precommand."
msgstr "Vörwegbefehl warrt utföhrt."

#: pop3resource.cpp:292
msgid "You are asked here because the previous login was not successful."
msgstr "Disse Affraag dukt op, wiel dat verleden Anmellen fehlslaan is."

#: pop3resource.cpp:294
msgid "You are asked here because the username you supplied is empty."
msgstr "Disse Affraag dukt op, wiel keen Brukernaam angeven is."

#: pop3resource.cpp:296
msgid ""
"You are asked here because you choose to not store the password in the "
"wallet."
msgstr ""
"Disse Affraag dukt op, wiel Du dat Passwoort nich binnen de Knipp wohren "
"wullt."

#: pop3resource.cpp:330
msgid "Fetching mail listing."
msgstr "Nettpostlist warrt haalt."

#: pop3resource.cpp:389
msgid "Saving downloaded messages."
msgstr "Daallaadt Narichten warrt sekert."

#: pop3resource.cpp:404
msgid "Deleting messages from the server."
msgstr "Narichten warrt op den Server wegmaakt."

#: pop3resource.cpp:432
msgid "Saving password to the wallet."
msgstr "Passwoort warrt binnen de Knipp sekert."

#: pop3resource.cpp:447
msgid "Error while trying to get the local inbox folder, aborting mail check."
msgstr ""
"Lokaal Postingangorner lett sik nich halen, Kieken na Nettpost warrt "
"afbraken."

#: pop3resource.cpp:453
#, kde-format
msgid ""
"<qt>The folder you deleted was associated with the account <b>%1</b> which "
"delivered mail into it. The folder the account delivers new mail into was "
"reset to the main Inbox folder.</qt>"
msgstr ""
"<qt>De Orner, den Du wegdaan hest, höör dat Konto <b>%1</b> to, för dat de "
"Nettpost dor binnen afleggt wöör. För dit Konto wöör de Orner för't Aflevern "
"vun Nettpost op den Hööft-Postingang torüchsett.</qt>"

#: pop3resource.cpp:473
msgid ""
"Error while trying to get the folder for incoming mail, aborting mail check."
msgstr ""
"Postingangorner lett sik nich halen. Kieken na Nettpost warrt afbraken."

#: pop3resource.cpp:486
msgid "Could not find folder for incoming mail, aborting mail check."
msgstr ""
"Postingangorner lett sik nich finnen. Kieken na Nettpost warrt afbraken."

#: pop3resource.cpp:498
msgid "Error while executing precommand."
msgstr "Fehler bi't Utföhren vun den Vörwegbefehl."

#: pop3resource.cpp:512
#, kde-format
msgid "Unable to login to the server %1."
msgstr "Anmellen bi Server \"%1\" nich mööglich."

#: pop3resource.cpp:523
msgid "Error while getting the list of messages on the server."
msgstr "Narichtenlist lett sik nich vun den Server halen."

#: pop3resource.cpp:538
msgid "Error while getting list of unique mail identifiers from the server."
msgstr "List mit eenkennig Narichtenkennen lett sik nich vun den Server halen."

#: pop3resource.cpp:551
#, kde-format
msgid ""
"Your POP3 server (Account: %1) does not support the UIDL command: this "
"command is required to determine, in a reliable way, which of the mails on "
"the server KMail has already seen before;\n"
"the feature to leave the mails on the server will therefore not work "
"properly."
msgstr ""
"De POP3-Server för dat Konto \"%1\" ünnerstütt den Befehl \"UIDL\" nich. "
"Disse Befehl warrt bruukt, wenn KMail faststellen schall, welk vun de "
"Nettbreven op den Server KMail al sehn hett.\n"
"De Funkschoon, de Nettbreven op den Server to laten, warrt nich richtig "
"arbeiden."

#: pop3resource.cpp:565
msgid "Error while fetching mails from the server."
msgstr "Fehler bi't Halen vun de Nettbreven vun den Server."

#: pop3resource.cpp:621
#, kde-format
msgid ""
"Fetching message %1 of %2 (%3 of %4 KB) for %5 (%6 KB remain on the server)."
msgstr ""
"Naricht %1 vun %2 (%3 vun %4 kB) warrt för %5 haalt (%6kB blievt op den "
"Server)."

#: pop3resource.cpp:629
#, kde-format
msgid "Fetching message %1 of %2 (%3 of %4 KB) for %5"
msgstr "Naricht %1 vun %2 (%3 vun %4 kB) warrt för %5 haalt."

#: pop3resource.cpp:650
msgid "Unable to store downloaded mails."
msgstr "Daallaadt Narichten laat sik nich sekern."

#: pop3resource.cpp:781
msgid "Failed to delete the messages from the server."
msgstr "Narichten laat sik nich op den Server wegmaken."

#: pop3resource.cpp:821
msgid "Finished mail check, no message downloaded."
msgstr "Kieken na Nettpost afslaten, keen Naricht daallaadt."

#: pop3resource.cpp:823
#, kde-format
msgid "Finished mail check, 1 message downloaded."
msgid_plural "Finished mail check, %1 messages downloaded."
msgstr[0] "Kieken na Nettpost afslaten, een Naricht daallaadt."
msgstr[1] "Kieken na Nettpost afslaten, %1 Narichten daallaadt."

#: pop3resource.cpp:833
msgid "Unable to complete the mail fetch."
msgstr "Kieken na Nettpost lett sik nich afsluten."

#: pop3resource.cpp:971
msgid "Mail check already in progress, unable to start a second check."
msgstr "Kieken na Nettpost löppt al un lett sik nich nochmaal starten."

