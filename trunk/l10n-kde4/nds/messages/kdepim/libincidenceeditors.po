#: editorfreebusy.cpp:268 incidenceeditor-ng/editorfreebusy.cpp:374
msgctxt "@info:whatsthis"
msgid ""
"Select the Gantt chart zoom level from one of the following:<nl/>'Hour' "
"shows a range of several hours,<nl/>'Day' shows a range of a few days,<nl/"
">'Week' shows a range of a few months,<nl/>and 'Month' shows a range of a "
"few years,<nl/>while 'Automatic' selects the range most appropriate for the "
"current event or to-do."
msgstr ""
"Leggt de Ansichtgrött för't Gantt-Diagramm fast:<nl/>\"Stünnen\" wiest en "
"Rebeet vun Stünnen,<nl/>\"Daag\" en vun en poor Daag,<nl/>\"Weken\" wiest en "
"poor Maanden un<nl/>\"Maanden\" wiest en poor Johr.<nl/>\"Automaatsch\" "
"leggt dat Tietrebeet na den aktuellen Indrag fast."

