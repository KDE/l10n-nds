#: recurrenceedit.cpp:133
msgctxt "@info:whatsthis"
msgid ""
"<para>Trigger the alarm at the specified date/time and at every login until "
"then.</para><para>Note that it will also be triggered any time "
"<application>KAlarm</application> is restarted.</para>"
msgstr ""
"<para>Den Alarm bet to de angeven Tiet jümmers bi't Anmellen un denn "
"nochmaal utlösen.</para><para>He warrt ok utlööst, wenn Du den Alarmdämoon "
"nieg opröppst.</para>"

