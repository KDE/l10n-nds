#: prefdlg.cpp:309
msgctxt "@info:whatsthis"
msgid ""
"<para>Check to run <application>KAlarm</application> only when required.</"
"para><para><note label='Notes'></note></para><para><list><item>Alarms are "
"displayed even when <application>KAlarm</application> is not running, since "
"alarm monitoring is done by the alarm daemon.</item><item>With this option "
"selected, the system tray icon can be displayed or hidden independently of "
"<application>KAlarm</application>.</item></list></para>"
msgstr ""
"<para>Maak dit an, wenn <application>KAlarm</application> bloots lopen "
"schall, wenn dat nödig is.</para><para><note label='Beacht bitte:'></note></"
"para><para><list><item>Alarms warrt ok wiest, wenn <application>KAlarm</"
"application> nich löppt, dor waakt de Alarmdämoon över.</item><item>Wenn "
"anmaakt, kannst Du dat Systeemafsnitt-Lüttbild wiesen oder versteken, dat "
"hangt nich vun <application>KAlarm</application> af.</item></list></para>"

#: prefdlg.cpp:317
msgctxt "@option:radio"
msgid "Run continuously in system tray"
msgstr "Jümmer binnen Systeemafsnitt lopen"

#. i18n: tag whatsthis
#. i18n: file kalarmconfig.kcfg line 83
#. i18n: tag whatsthis
#. i18n: file ./kalarmconfig.kcfg line 83
#: prefdlg.cpp:321 rc.cpp:36 rc.cpp:419
msgctxt "@info:whatsthis"
msgid ""
"<para>Check to run <application>KAlarm</application> continuously in the KDE "
"system tray.</para><para><note label='Notes'></note></"
"para><para><list><item>With this option selected, closing the system tray "
"icon will quit <application>KAlarm</application>.</item><item>You do not "
"need to select this option in order for alarms to be displayed, since alarm "
"monitoring is done by the alarm daemon. Running in the system tray simply "
"provides easy access and a status indication.</item></list></para>"
msgstr ""
"<para>Maak dit an, wenn Du <application>KAlarm</application> jümmers binnen "
"den KDE-Systeemafsnitt hebben wullt.</para><para><note label='Beacht "
"bitte:'></note></para><para><list><item>Wenn anmaakt, warrt bi't Tomaken "
"vun't Systeemafsnitt-Programm ok <application>KAlarm</application> utmaakt.</"
"item><item>Alarms warrt ok ahn disse Optschoon wiest, dor waakt de "
"Alarmdämoon över. Dat Systeemafsnitt-Lüttbild maakt dat Togriepen eenfacher "
"un gifft Di Informatschonen över de tokamen Alarms.</item></list></para>"

#: prefdlg.cpp:329
msgctxt "@option:check"
msgid "Disable alarms while not running"
msgstr "Alarms utmaken, wenn dat nich löppt"

