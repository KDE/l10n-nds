#: editdlgtypes.cpp:156
#, qt-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Select what the alarm should display:<list><item><interface>%1</"
"interface>: the alarm will display the text message you type in.</"
"item><item><interface>%2</interface>: the alarm will display the contents of "
"a text or image file.</item><item><interface>%3</interface>: the alarm will "
"display the output from a command.</item></list></para>"
msgstr ""
"<para>Hier kannst Du utsöken, wat de Alarm wiesen schall:"
"<list><item><interface>%1</interface>: De Alarm wiest den Bescheed, den Du "
"ingiffst.</item><item><interface>%2</interface>: De Alarm wiest den Inholt "
"vun en Text- oder Bilddatei.</item><item><interface>%3</interface>: De Alarm "
"wiest de Utgaav vun en Befehl</item></list></para>"

#: editdlgtypes.cpp:167
msgctxt "@info:whatsthis"
msgid "Enter the text of the alarm message. It may be multi-line."
msgstr ""
"Giff den Text för de Alarmnaricht in, he dörv ok mehr as een Reeg lang wesen."

