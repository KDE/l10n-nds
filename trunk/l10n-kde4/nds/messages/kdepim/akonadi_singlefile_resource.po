#: singlefileresourcebase.cpp:230
#, kde-format
msgid ""
"The file '%1' was changed on disk while there were still pending changes in "
"Akonadi. To avoid data loss, a backup of the internal changes has been "
"created at '%2'."
msgstr ""
"De Datei \"%1\" wöör op de Fastplaat ännert, bides stunnen binnen Akonadi ok "
"noch Ännern ut. Dormit keen Daten wegkaamt, hett Akonadi en Kopie mit sien "
"intern Ännern as \"%2\" sekert."

#: singlefileresourcebase.cpp:252
#, kde-format
msgid "Could not load file '%1'."
msgstr "Datei \"%1\" lett sik nich laden."

#: singlefileresourcebase.cpp:260 singlefileresourcebase.cpp:272
#: singlefileresource.h:94 singlefileresource.h:114 singlefileresource.h:182
