#: shared/resourcescalixbase.cpp:115
#, kde-format
msgid ""
"This is a Scalix Groupware object.\n"
"To view this object you will need an email client that can understand the "
"Scalix Groupware format.\n"
"For a list of such email clients please visit\n"
"%1"
msgstr ""
"Dit is en Scalix-Arbeitkoppelobjekt.\n"
"Wenn Du dat ankieken wullt, bruukst Du en Nettpostprogramm, wat dat Scalix-"
"Formaat versteiht.\n"
"En List mit disse Programmen gifft dat op\n"
"%1"

#: shared/resourcescalixbase.cpp:145
msgid "Internal kolab data: Do not delete this mail."
msgstr "Intern Kolab-Daten. Dissen Nettbreef nich wegdoon!"

