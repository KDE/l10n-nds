msgstr "Dat Tietmeten anhollen un torüchdreihen op de Tiet bi %1"

#: idletimedetector.cpp:122
msgid "Continue timing."
msgstr "De Tiet wiedermeten"

#: idletimedetector.cpp:123
msgid "Revert timing"
msgstr "Tietmeten torüchdreihen"

