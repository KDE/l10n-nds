#: imapaccount.cpp:199
#, kde-format
msgid ""
"You requested TLS/SSL to connect to %1, but your system does not seem to be "
"set up for that."
msgstr ""
"Du wullt TLS/SSL för't Tokoppeln na %1 bruken, man as't lett ünnerstütt Dien "
"Systeem dat nich."

#: imapaccount.cpp:243 imapresource.cpp:996
#, kde-format
msgid "Could not connect to the IMAP-server %1."
msgstr "Tokoppeln na IMAP-Server %1 nich mööglich."

#: imapaccount.cpp:252
#, kde-format
msgid "Could not test the capabilities supported by the IMAP server %1."
msgstr "Affragen vun't Könen vun den IMAP-Server %1 nich mööglich."

#: imapaccount.cpp:276
#, kde-format
msgid ""
"Cannot use the IMAP server %1, some mandatory capabilities are missing: %2. "
"Please ask your sysadmin to upgrade the server."
msgstr ""
"De IMAP-Server %1 lett sik nich bruken, he kann nich allens, wat noot deit: %"
"2. Snack bitte den Systeempleger dor op an, dat he den Server opfrischen "
"schull."

#: imapresource.cpp:131 imapresource.cpp:542 imapresource.cpp:681
msgid "There is currently no connection to the IMAP server."
msgstr "Opstunns gifft dat keen Verbinnen na den IMAP-Server."

#: imapresource.cpp:191
msgid "No message retrieved, server reply was empty."
msgstr "Keen Naricht kregen, de Server-Antwoort weer leddig."

#: imapresource.cpp:221
msgid "No server configured yet."
msgstr "Noch keen Server fastleggt."

#: imapresource.cpp:229
#, fuzzy
#| msgid "Autentication failed."
msgid "Authentication failed."
msgstr "Identiteetprööv fehlslaan"

#: imapresource.cpp:421
msgid "Cannot move message, it does not exist on the server."
msgstr "De Naricht lett sik nich verschuven, dat gifft ehr op den Server nich."

#: imapresource.cpp:427
#, kde-format
msgid "Cannot move message out of '%1', '%1' does not exist on the server."
msgstr ""
"De Naricht lett sik nich ut \"%1\" rutschuven, dat gifft \"%1\" op den "
"Server nich."

#: imapresource.cpp:434
#, kde-format
msgid "Cannot move message to '%1', '%1' does not exist on the server."
msgstr ""
"De Naricht lett sik nich na \"%1\" verschuven, dat gifft \"%1\" op den "
"Server nich."

#: imapresource.cpp:478
#, kde-format
msgid ""
"Failed to move message out of '%1' on the IMAP server. Couldn't select '%1'."
msgstr ""
"De Naricht lett sik op den IMAP-Server nich ut \"%1\" rutschuven, \"%1\" "
"lett sik nich utsöken."

#: imapresource.cpp:514
#, kde-format
msgid ""
"Failed to move message to '%1' on the IMAP server. Couldn't copy into '%1'."
msgstr ""
"De Naricht lett sik op den Server nich na \"%1\" verschuven, koperen na \"%1"
"\" nich mööglich."

#: imapresource.cpp:527
#, kde-format
msgid ""
"Failed to mark the message from '%1' for deletion on the IMAP server. It "
"will reappear on next sync."
msgstr ""
"De Naricht ut \"%1\" lett sik op den IMAP-Server nich för't Wegdoon "
"markeren. Se dukt bi de nakamen Synkroniseren wedder op."

#: imapresource.cpp:628
msgid "Inbox"
msgstr "Postingang"

#: imapresource.cpp:645
msgid "Shared Folders"
msgstr "Freegeven Ornern"

#: imapresource.cpp:796
#, kde-format
msgid "Cannot add IMAP folder '%1' for a non-existing parent folder '%2'."
msgstr ""
"IMAP-Orner \"%1\" lett sik nich na en Böverorner \"%2\" tofögen, den dat "
"nich gifft."

#: imapresource.cpp:825
#, kde-format
msgid "Failed to create folder '%1' on the IMAP server."
msgstr "De Orner \"%1\" lett sik op den IMAP-Server nich opstellen."

#: imapresource.cpp:833
#, kde-format
msgid "Cannot modify IMAP folder '%1', it does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich ännern, dat gifft em op den Server nich."

#: imapresource.cpp:872
msgid "Failed to rename the folder, restoring folder list."
msgstr "De Orner lett sik nich ümnömen, Ornerlist warrt wedderherstellt."

#: imapresource.cpp:895
msgid "Failed to delete the folder, restoring folder list."
msgstr "De Orner lett sik nich wegmaken, Ornerlist warrt wedderherstellt."

#: imapresource.cpp:905
#, kde-format
msgid "Cannot move IMAP folder '%1', it does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich verschuven, dat gifft em op den Server "
"nich."

#: imapresource.cpp:912
#, kde-format
msgid ""
"Cannot move IMAP folder '%1' out of '%2', '%2' does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich ut \"%2\" rutschuven, dat gifft \"%2\" op "
"den Server nich."

#: imapresource.cpp:920
#, kde-format
msgid ""
"Cannot move IMAP folder '%1' to '%2', '%2' does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich na \"%2\" verschuven, dat gifft \"%2\" op "
"den Server nich."

#: imapresource.cpp:957
#, kde-format
msgid "Failed to move folder '%1' out of '%2' on the IMAP server."
msgstr "De Orner \"%1\" lett sik op den IMAP-Server nich ut \"%2\" rutschuven."

#: imapresource.cpp:967
#, kde-format
msgid "Failed to subcribe to the newly moved folder '%1' on the IMAP server."
msgstr ""
"De jüst op den IMAP-Server verschaven Orner \"%1\" lett sik nich bestellen."

#: imapresource.cpp:981
msgid ""
"The server refused the supplied username and password. Do you want to go to "
"the settings, have another attempt at logging in, or do nothing?"
msgstr ""
"De Server hett den Brukernaam un dat Passwoort torüchwiest. Wullt Du na de "
"Instellen kieken, dat Tokoppeln nochmaal versöken oder nix doon?"

#: imapresource.cpp:984
msgid "Could Not Authenticate"
msgstr "Identiteet lett sik nich pröven"

#: imapresource.cpp:985
msgid "Settings"
msgstr "Instellen"

#: imapresource.cpp:986
msgctxt "Input username/password manually and not store them"
msgid "Single Input"
msgstr "Eenmaal-Ingaav"

#: imapresource.cpp:1009
msgid "Connection established."
msgstr "Tokoppelt."

#: imapresource.cpp:1329
#, kde-format
msgid ""
"Could not find a valid password for user '%1' on IMAP server '%2', please "
"enter it here."
msgstr ""
"För Bruker »%1« lett sik op IMAP-Server »%2« keen gellen Passwoort finnen. "
"Bitte giff dat hier in."

