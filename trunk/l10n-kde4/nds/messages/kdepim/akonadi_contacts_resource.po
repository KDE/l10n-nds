#: contactsresource.cpp:104
msgid "Personal Contacts"
msgstr "Persöönlich Kontakten"

#: contactsresource.cpp:120
#, kde-format
msgid "Directory '%1' does not exists"
msgstr "Den Orner \"%1\" gifft dat nich."

#: contactsresource.cpp:142 contactsresource.cpp:186
#, kde-format
msgid "Found file of unknown format: '%1'"
msgstr "Datei mit nich begäng Formaat funnen: %1"

#: contactsresource.cpp:160
#, kde-format
msgid "Unable to open file '%1'"
msgstr "Datei \"%1\" lett sik nich opmaken."

#: contactsresource.cpp:170
#, kde-format
msgid "Found invalid contact in file '%1'"
msgstr "Leeg Kontakt binnen Datei \"%1\" funnen."

#: contactsresource.cpp:180
#, kde-format
msgid "Found invalid contact contact group in file '%1': %2"
msgstr "Leeg Kontaktenkoppel binnen Datei \"%1\" funnen: %2"

#: contactsresource.cpp:200 contactsresource.cpp:321 contactsresource.cpp:342
#: contactsresource.cpp:374
#, kde-format
msgid "Trying to write to a read-only directory: '%1'"
msgstr "Schrieven binnen bloots leesbor Orner nich mööglich: %1"

#: contactsresource.cpp:218 contactsresource.cpp:234 contactsresource.cpp:270
#: contactsresource.cpp:283
#, kde-format
msgid "Unable to write to file '%1': %2"
msgstr "Schrieven na Datei \"%1\" nich mööglich: %2"

#: contactsresource.cpp:254 contactsresource.cpp:304
#, kde-format
msgid "Trying to write to a read-only file: '%1'"
msgstr "Schrieven na bloots-leesbor Datei nich mööglich: %1"

#: contactsresource.cpp:294
#, kde-format
msgid "Received item with unknown payload %1"
msgstr "Indrag mit nich begäng Bruukinholt funnen: %1"

#: contactsresource.cpp:311
#, kde-format
msgid "Unable to remove file '%1'"
msgstr "Datei \"%1\" lett sik nich wegmaken"

#: contactsresource.cpp:328
#, kde-format
msgid "Unable to create folder '%1'."
msgstr "Orner \"%1\" lett sik nich opstellen."

#: contactsresource.cpp:362
#, kde-format
msgid "Unable to rename folder '%1'."
msgstr "Orner \"%1\" lett sik nich ümnömen."

#: contactsresource.cpp:379
#, kde-format
msgid "Unable to delete folder '%1'."
msgstr "Orner \"%1\" lett sik nich wegdoon."

#. i18n: file: contactsresource.kcfg:9
#. i18n: ectx: label, entry (Path), group (General)
#: rc.cpp:3
msgid "Path to contacts directory"
msgstr "Padd na den Kontaktenorner"

#. i18n: file: contactsresource.kcfg:13
#. i18n: ectx: label, entry (AutosaveInterval), group (General)
#: rc.cpp:6
msgid "Autosave interval time (in minutes)."
msgstr "Töövtiet för't automaatsche Sekern (in Minuten)"

#. i18n: file: contactsresource.kcfg:17
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:9
msgid "Do not change the actual backend data."
msgstr "De Hülpprogramm-Daten nich ännern"

#. i18n: file: settingsdialog.ui:17
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: rc.cpp:12 rc.cpp:30
msgid "Directory Name"
msgstr "Ornernaam"

#. i18n: file: settingsdialog.ui:25
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:15 rc.cpp:33
msgid "&Directory:"
msgstr "&Orner:"

#. i18n: file: settingsdialog.ui:40
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:18 rc.cpp:36
msgid ""
"Select the directory whose contents should be represented by this resource. "
"If the directory does not exist, it will be created."
msgstr ""
"Den Orner utsöken, den sien Inholt disse Ressource weddergeven schall. Gifft "
"em dat nich, warrt he opstellt."

#. i18n: file: settingsdialog.ui:53
#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: rc.cpp:21 rc.cpp:39
msgid "Access Rights"
msgstr "Togriepverlöven"

#. i18n: file: settingsdialog.ui:59
#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#: rc.cpp:24 rc.cpp:42
msgid "Read only"
msgstr "Bloots leesbor"

#. i18n: file: settingsdialog.ui:66
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:27 rc.cpp:45
msgid ""
"If read-only mode is enabled, no changes will be written to the directory "
"selected above. Read-only mode will be automatically enabled if you do not "
"have write access to the directory."
msgstr ""
"Is de Bloots-lesen-Bedrief anmaakt, warrt keen Ännern binnen den baven "
"utsöchten Orner redig sekert. De Bloots-lesen-Bedrief warrt automaatsch "
"anmaakt, wenn Du keen Schriefverlöven för den Orner hest."
