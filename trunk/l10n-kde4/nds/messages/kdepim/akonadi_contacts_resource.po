#. i18n: file: settingsdialog.ui:17
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: rc.cpp:3
msgid "Directory Name"
msgstr "Ornernaam"

#. i18n: file: settingsdialog.ui:25
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:6
msgid "&Directory:"
msgstr "&Orner:"

#. i18n: file: settingsdialog.ui:40
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:9
msgid ""
"Select the directory whose contents should be represented by this resource. "
"If the directory does not exist, it will be created."
msgstr ""
"Den Orner utsöken, den sien Inholt disse Ressource weddergeven schall. Gifft "
"em dat nich, warrt he opstellt."

#. i18n: file: settingsdialog.ui:53
#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: rc.cpp:12
msgid "Access Rights"
msgstr "Togriepverlöven"

#. i18n: file: settingsdialog.ui:59
#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#: rc.cpp:15
msgid "Read only"
msgstr "Bloots leesbor"

#. i18n: file: settingsdialog.ui:66
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:18
msgid ""
"If read-only mode is enabled, no changes will be written to the directory "
"selected above. Read-only mode will be automatically enabled if you do not "
"have write access to the directory."
msgstr ""
"Is de Bloots-lesen-Bedrief anmaakt, warrt keen Ännern binnen den baven "
"utsöchten Orner redig sekert. De Bloots-lesen-Bedrief warrt automaatsch "
"anmaakt, wenn Du keen Schriefverlöven för den Orner hest."

#. i18n: file: contactsresource.kcfg:10
#. i18n: ectx: label, entry (Path), group (General)
#: rc.cpp:21
msgid "Path to contacts directory"
msgstr "Padd na den Kontaktenorner"

#. i18n: file: contactsresource.kcfg:14
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:24
msgid "Do not change the actual backend data."
msgstr "De Hülpprogramm-Daten nich ännern"

