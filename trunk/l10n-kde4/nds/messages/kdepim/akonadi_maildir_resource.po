#: configdialog.cpp:58
msgid "The selected path contains valid Maildir folders."
msgstr "De utsöchte Padd bargt gellen Nettpostornern."

#: configdialog.cpp:65
msgid "The selected path is a valid Maildir."
msgstr "De utsöchte Padd is en gellen Nettpostorner."

#: configdialog.cpp:71
msgid "The selected path does not exist yet, a new Maildir will be created."
msgstr ""
"Den utsöchten Padd gifft dat noch nich, en nieg Nettpostorner warrt opstellt."

#: configdialog.cpp:74
msgid "The selected path does not exist."
msgstr "Den utsöchten Padd gifft dat nich."

#: maildirresource.cpp:95
#, kde-format
msgid "Unable to fetch item: The maildir folder \"%1\" is not valid."
msgstr "Element lett sik nich halen. De Nettpostorner \"%1\" gellt nich."

#: maildirresource.cpp:139 maildirresource.cpp:164
msgid "Only email messages can be added to the Maildir resource."
msgstr "Na en Nettpostorner laat sik bloots Nettbreven tofögen"

#: maildirresource.cpp:182
#, kde-format
msgid "Source folder is invalid: '%1'."
msgstr "Bornorner is leeg: %1"

#: maildirresource.cpp:188
#, kde-format
msgid "Destination folder is invalid: '%1'."
msgstr "Teelorner is leeg: %1"

#: maildirresource.cpp:194
#, kde-format
msgid "Could not move message '%1'."
msgstr "Naricht \"%1\" lett sik nich verschuven."

#: maildirresource.cpp:210
#, kde-format
msgid "Failed to delete message: %1"
msgstr "Naricht lett sik nich wegdoon: %1"

#: maildirresource.cpp:269
#, kde-format
msgid "Maildir '%1' for collection '%2' is invalid."
msgstr "Nettpostorner \"%1\" för Sammeln \"%2\" is leeg."

#: maildirresource.cpp:329
#, kde-format
msgid "Unable to rename maildir folder '%1'."
msgstr "Nettpostorner \" %1\" lett sik nich ümnömen."

#: maildirresource.cpp:342
#, kde-format
msgid "Cannot move root maildir folder '%1'."
msgstr "Wörtel-Nettpostorner \"%1\" lett sik nich verschuven."

#: maildirresource.cpp:357
#, kde-format
msgid "Unable to move maildir folder '%1' from '%2' to '%3'."
msgstr "Nettpostorner \"%1\" lett sik nich vun \"%2\" na \"%3\" verschuven."

#: maildirresource.cpp:367
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "Böverst Nettpostorner \"%1\" lett sik nich wegmaken."

#: maildirresource.cpp:376
#, kde-format
msgid "Failed to delete sub-folder '%1'."
msgstr "Ünnerorner \"%1\" lett sik nich wegdoon."

#: maildirresource.cpp:385
#, kde-format
msgid "Unable to create maildir '%1'."
msgstr "Nettpostorner \"%1\" lett sik nich opstellen."

#. i18n: file: maildirresource.kcfg:9
#. i18n: ectx: label, entry (Path), group (General)
#: rc.cpp:3
msgid "Path to maildir"
msgstr "Padd na Nettpostorner"

#. i18n: file: maildirresource.kcfg:13
#. i18n: ectx: label, entry (TopLevelIsContainer), group (General)
#: rc.cpp:6
msgid ""
"Path points to a folder containing Maildirs instead of to a maildir itself."
msgstr ""
"De Padd wiest op en Orner, de Nettpostornern bargt, ansteed op en "
"Nettpostorner."

#. i18n: file: maildirresource.kcfg:17
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:9
msgid "Do not change the actual backend data."
msgstr "Bitte de aktuellen Hülpprogramm-Daten nich ännern."

#. i18n: file: settings.ui:15
