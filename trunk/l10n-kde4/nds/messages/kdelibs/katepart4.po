#: document/katedocument.cpp:152 document/katedocument.cpp:3495
#: document/katedocument.cpp:3509 document/katedocument.cpp:3515
#: document/katedocument.cpp:3526
msgid "Save Nevertheless"
msgstr "Liekers sekern"

#: document/katedocument.cpp:3438 document/katedocument.cpp:3443
#, kde-format
msgid ""
"The file %1 could not be loaded, as it was not possible to read from it.\n"
"\n"
"Check if you have read access to this file."
msgstr ""
"De Datei %1 lett sik nich laden, dat is nich mööglich, ehr to lesen.\n"
"\n"
"Bitte prööv, wat Du Leesrechten för ehr hest."

#: document/katedocument.cpp:3454 document/katedocument.cpp:3459
#: document/katedocument.cpp:3493
#, kde-format
msgid "The file %1 is a binary, saving it will result in a corrupt file."
msgstr ""
"De Datei %1 is bineer, ehr to sekern warrt to en schaadhaftige Datei föhren."

#: document/katedocument.cpp:3455
msgid "Binary File Opened"
msgstr "Binere Datei opmaakt"

#: document/katedocument.cpp:3470 document/katedocument.cpp:3476
#, kde-format
msgid ""
"The file %1 was opened with UTF-8 encoding but contained invalid characters. "
"It is set to read-only mode, as saving might destroy it's content. Either "
"reopen the file with the correct encoding chosen or enable the read-write "
"mode again in the menu to be able to edit it."
msgstr ""
"De Datei \"%1\" wöör mit de Koderen UTF-8 opmaakt, man barg leeg Tekens. Se "
"wöör nu op \"Bloots leesbor\" sett, anners mag en Sekern ehren Inholt "
"tweimaken. Du kannst de Datei nu mit de richtige Koderen nochmaal opmaken, "
"oder ehr över dat Menü wedder op \"Lees- un schriefbor\" setten un denn "
"bewerken."

#: document/katedocument.cpp:3473
msgid "Broken UTF-8 File Opened"
msgstr "Schaadhaftig UTF-8-Datei opmaakt"

#: document/katedocument.cpp:3494
msgid "Trying to Save Binary File"
msgstr "Versöök, binere Datei to sekern"

#: document/katedocument.cpp:3509
msgid ""
"Do you really want to save this unmodified file? You could overwrite changed "
"data in the file on disk."
msgstr ""
"Wullt Du disse nich ännerte Datei redig sekern? Du kunnst ännerte Daten "
"binnen de Datei op de Fastplaat överschrieven."

#: document/katedocument.cpp:3509
msgid "Trying to Save Unmodified File"
msgstr "Versöök, nich ännerte Datei to sekern"

#: document/katedocument.cpp:3515
msgid ""
"Do you really want to save this file? Both your open file and the file on "
"disk were changed. There could be some data lost."
msgstr ""
"Wullt Du disse Datei redig sekern? Dien apen Dokment un ok de Datei op de "
"Fastplaat wöörn ännert. Dat kunn so licht to Datenverlust kamen."

#: document/katedocument.cpp:3515 document/katedocument.cpp:3526
#: document/katedocument.cpp:3760
msgid "Possible Data Loss"
msgstr "Datenverlust mööglich"

#: document/katedocument.cpp:3526
msgid ""
"The selected encoding cannot encode every unicode character in this "
"document. Do you really want to save it? There could be some data lost."
msgstr ""
"De utsöchte Koderen kann nich all Unicodetekens vun dit Dokment koderen. "
"Wullt Du dat redig sekern? Dat kunn so licht to Datenverlust kamen."

#: document/katedocument.cpp:3590
#, kde-format
msgid ""
"For file %1 no backup copy could be created before saving. If an error "
"occurs while saving, you might lose the data of this file. A reason could be "
"that the media you write to is full or the directory of the file is read-"
"only for you."
msgstr ""
"För de Datei \"%1\" lett sik ehr't Sekern keen Sekerheitkopie opstellen. "
"Wenn dat bi't Sekern en Fehler gifft, möögt Di ehr Daten wegkamen. Villicht "
"is dat Medium, na dat Du schrieven wullt, al vull; oder villicht hest Du "
"keen Schriefverlöven för de Datei ehren Orner."

#: document/katedocument.cpp:3593
msgid "Failed to create backup copy."
msgstr "Sekerheitkopie lett sik nich opstellen"

#: document/katedocument.cpp:3594
msgid "Try to Save Nevertheless"
msgstr "Liekers sekern"

#: document/katedocument.cpp:3625
#, kde-format
msgid ""
"The document could not be saved, as it was not possible to write to %1.\n"
"\n"
"Check that you have write access to this file or that enough disk space is "
"available."
msgstr ""
"Dat Dokment lett sik nich sekern, dat is nich mööglich, na %1 to schrieven.\n"
"\n"
"Bitte prööv, wat Du Schriefverlöven för de Datei hest un wat dat noog fre'en "
"Platz op de Fastplaat gifft."

#: document/katedocument.cpp:3759
msgid "Do you really want to continue to close this file? Data loss may occur."
msgstr ""
"Wullt Du disse Datei redig tomaken? Dat kunn licht to Datenverlust kamen."

#: document/katedocument.cpp:3760
msgid "Close Nevertheless"
msgstr "Liekers tomaken"

#: document/katedocument.cpp:5142 document/katedocument.cpp:5298
#: document/katedocument.cpp:5887
msgid "Save File"
msgstr "Datei sekern"

#: document/katedocument.cpp:5151
msgid "Save failed"
msgstr "Sekern fehlslaan"

#: document/katedocument.cpp:5219
msgid "File Was Changed on Disk"
msgstr "Datei op Fastplaat ännert"

#: document/katedocument.cpp:5219
msgid "&Ignore Changes"
msgstr "Ännern över&gahn"

#: document/katedocument.cpp:5801
#, kde-format
msgid "The file '%1' was modified by another program."
msgstr "En anner Programm hett de Datei \"%1\" ännert."

#: document/katedocument.cpp:5804
