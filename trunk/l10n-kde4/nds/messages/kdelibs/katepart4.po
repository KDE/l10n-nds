msgid "Export File as HTML"
msgstr "Datei na HTML exporteren"

#: dialogs/katedialogs.cpp:364
msgid "Nowhere"
msgstr "Narms"

#: dialogs/katedialogs.cpp:365
msgid "Selection Only"
msgstr "Bloots Markeren"

