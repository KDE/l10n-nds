#: tests/test_regression.cpp:361
msgid "Directory containing tests, basedir and output directories."
msgstr "Orner mit Tests, den Basisorner un de Utgaavornern."

#: tests/test_regression.cpp:362
msgid ""
"Compare failures of this testrun against snapshot <snapshot>. Defaults to "
"the most recently captured failure snapshot or none if none exists."
msgstr ""
"Verglieken vun dissen Testloop mit Snappschööt <snapshot>. As Vörinstellen "
"warrt de niegste sekerte Snappschööt bruukt oder keen, wenn dat keen gifft."

#: tests/test_regression.cpp:364
msgid "Do not suppress debug output"
msgstr "Fehlersöök-Utgaav wiesen"

#: tests/test_regression.cpp:366
msgid "Regenerate baseline (instead of checking)"
msgstr "Grundtostand wedderherstellen (ansteed vun en Prööv)"

#: tests/test_regression.cpp:367
msgid "Keep output files even on success"
msgstr "Utgaavdateien ok bi Spood wohren"

#: tests/test_regression.cpp:368
msgid "Save failures of this testrun as failure snapshot <snapshot>"
msgstr "Fehlers vun dissen Testloop as Snappschööt <snapshot> sekern"

#: tests/test_regression.cpp:370
msgid "Show the window while running tests"
msgstr "Dat Finster wiesen, wielt de Tests loopt"

#: tests/test_regression.cpp:372
msgid "Only run a single test. Multiple options allowed."
msgstr "Bloots en enkel Test opropen. Lett sik mehr as eenmaal bruken."

#: tests/test_regression.cpp:374
msgid "Put output in <directory> instead of <base_dir>/output"
msgstr "Utgaav na <directory> ansteed vun <base_dir>/output sekern"

#: tests/test_regression.cpp:375
msgid "Run each test case in a separate process."
msgstr "Elk Test as egen Perzess utföhren"

#: tests/test_regression.cpp:376
msgid ""
"Directory containing tests, basedir and output directories. Only regarded if "
"-b is not specified."
msgstr ""
"Orner mit Tests, den Basisorner un de Utgaavornern. Warrt bloots denn "
"bruukt, wenn Du \"-b\" nich angeven hest."

#: tests/test_regression.cpp:377
msgid ""
"Relative path to testcase, or directory of testcases to be run (equivalent "
"to -t)."
msgstr ""
"Relativ Padd na den opsett Test, oder Orner mit opsett Tests, de Du utföhren "
"wullt (liek as \"-t\")"

