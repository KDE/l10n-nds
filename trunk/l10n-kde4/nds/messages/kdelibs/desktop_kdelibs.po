#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:18
msgctxt "Name"
msgid "Insert File"
msgstr "Datei infögen"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:46
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Jichtenseen leesbore Datei bi'n Blinker infögen"

