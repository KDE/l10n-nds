#: interfaces/kimproxy/interface/dbusinstantmessenger.desktop:5
msgctxt "Comment"
msgid "Instant Messenger with a D-Bus interface"
msgstr "Kortnarichten-Maker mit en D-Bus-Koppelsteed"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:1
msgctxt "Name"
msgid "Instant Messenger"
msgstr "Kortnarichten-Maker"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:60
msgctxt "Comment"
msgid ""
"The instant messenger allows two-way chat between individuals and groups."
msgstr ""
"Mit den Kortnarichten-Maker köönt enkelte Minschen oder Gruppen ünnerenanner "
"snacken."

#: interfaces/kspeech/dbustexttospeech.desktop:5
msgctxt "Comment"
msgid "Text-to-Speech Service with a D-Bus interface"
msgstr "Vörleesdeenst mit en DBUS-Koppelsteed"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgctxt "Name"
msgid "Embedded Text Editor"
msgstr "Inbett Texteditor"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:68
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"De Texteditor-Deenst föögt Programmen en Textwieser un -editor to. KDE-"
"Programmen, mit de Texten bewerkt warrt, schöölt em bruken."

#: interfaces/ktexteditor/ktexteditor.desktop:6
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr "Inbettbor Texteditor-Komponent (mit Dokment/Ansicht-Trennen)"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:6
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "KTextEditor-Plugin"

#: kate/data/katepart.desktop:3
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Inbett verwiedert Texteditor"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:17
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Leestekensetter"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:43
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
