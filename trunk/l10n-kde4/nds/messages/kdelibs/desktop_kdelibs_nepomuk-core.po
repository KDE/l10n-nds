#: server/nepomukserver.desktop:8
msgctxt "Name"
msgid "Nepomuk Server"
msgstr "Nepomuk-Server"

#: server/nepomukserver.desktop:22
msgctxt "Comment"
msgid "The Nepomuk Server providing Storage services and strigi controlling"
msgstr "De Nepomuk-Server, stellt Spiekerdeensten un Strigi-Kuntrull praat"

#: server/nepomukservice.desktop:4
msgctxt "Comment"
msgid "Nepomuk Service"
msgstr "Nepomuk-Deenst"

#: services/backupsync/gui/nepomukbackup.desktop:2
msgctxt "Name"
msgid "Nepomuk Backup"
msgstr "Nepomuk-Sekerheitkopie"

#: services/backupsync/service/nepomukbackupsync.desktop:8
msgctxt "Name"
msgid "Nepomuk Backup and Sync"
msgstr "Nepomuk-Sekerheitkopie un Synkroniseren"

#: services/backupsync/service/nepomukbackupsync.desktop:21
msgctxt "Comment"
msgid "Nepomuk Service which handles backup and sync."
msgstr "Nepomuk-Deenst för Sekerheitkopien un Synkroniseren."

#: services/fileindexer/nepomukfileindexer.desktop:7
msgctxt "Name"
msgid "File Indexer Service"
msgstr "Dateiindizeren"

#: services/fileindexer/nepomukfileindexer.desktop:20
msgctxt "Comment"
msgid "Nepomuk Service which indexes files on the desktop"
msgstr "Nepomuk-Deenst, de Dateien op den Schriefdisch indizeert"

#: services/fileindexer/nepomukfileindexer.notifyrc:3
msgctxt "Comment"
msgid "Desktop Search"
msgstr "Schriefdischsöök"

#: services/fileindexer/nepomukfileindexer.notifyrc:18
msgctxt "Name"
msgid "Initial Indexing started"
msgstr "Eerst Indizeren anfungen"

#: services/fileindexer/nepomukfileindexer.notifyrc:31
msgctxt "Comment"
msgid "Indexing of local files for fast searches has started."
msgstr "Dat Indizeren vun lokaal Dateien för gau Söken hett anfungen"

#: services/fileindexer/nepomukfileindexer.notifyrc:47
msgctxt "Name"
msgid "Initial Indexing finished"
msgstr "Eerst Indizeren afslaten"

#: services/fileindexer/nepomukfileindexer.notifyrc:60
msgctxt "Comment"
msgid ""
"The initial indexing of local files for fast desktop searches has completed."
msgstr ""
"Dat eerste Indizeren vun lokaal Dateien för gau Schriefdisch-Söken is "
"afslaten."

#: services/fileindexer/nepomukfileindexer.notifyrc:76
msgctxt "Name"
msgid "Indexing suspended"
msgstr "Indizeren anhollen"

#: services/fileindexer/nepomukfileindexer.notifyrc:89
msgctxt "Comment"
msgid "File indexing has been suspended by the search service."
msgstr "De Söökdeenst hett dat Indizeren vun Dateien utsett."

#: services/fileindexer/nepomukfileindexer.notifyrc:105
msgctxt "Name"
msgid "Indexing resumed"
msgstr "Indizeren geiht wieder"

#: services/fileindexer/nepomukfileindexer.notifyrc:118
msgctxt "Comment"
msgid "File indexing has been resumed by the search service."
msgstr "De Söökdeenst maakt mit dat Indizeren vun Dateien wieder."

#: services/filewatch/nepomukfilewatch.desktop:7
msgctxt "Name"
msgid "NepomukFileWatch"
msgstr "Nepomuk-Dateibeluern"

#: services/filewatch/nepomukfilewatch.desktop:20
msgctxt "Comment"
msgid "The Nepomuk file watch service for monitoring file changes"
msgstr "Nepomuk sien Dateibeluurdeenst, de Ännern an Dateien vermeldt"

#: services/filewatch/nepomukfilewatch.notifyrc:3
msgctxt "Comment"
msgid "Nepomuk file watch service"
msgstr "Nepomuk-Dateibeluurdeenst"

#: services/filewatch/nepomukfilewatch.notifyrc:18
msgctxt "Name"
msgid "New Removable Device"
msgstr "Niege tuuschbore Reedschappen"

#: services/filewatch/nepomukfilewatch.notifyrc:31
msgctxt "Comment"
msgid "A new unknown removable device has been mounted"
msgstr "En nieg nich begäng tuuschbor Reedschap wöör inhangt"

#: services/queryservice/nepomukqueryservice.desktop:7
msgctxt "Name"
msgid "NepomukQueryService"
msgstr "Nepomuk-Affraagdeenst"

#: services/queryservice/nepomukqueryservice.desktop:20
msgctxt "Comment"
msgid ""
"The Nepomuk Query Service provides an interface for persistent query folders"
msgstr ""
"De Nepomuk-Affraagdeenst stellt en Koppelsteed to duerhaftig Affraagornern "
"praat"

#: services/storage/nepomukstorage.desktop:7
msgctxt "Name"
msgid "Nepomuk Data Storage"
msgstr "Nepomuk-Datenaflaag"

#: services/storage/nepomukstorage.desktop:21
msgctxt "Comment"
msgid "The Core Nepomuk data storage service"
msgstr "De Karn vun den Nepomuk-Datenaflaagdeenst"

#: services/storage/nepomukstorage.notifyrc:3
msgctxt "Name"
msgid "Semantic Data Storage"
msgstr "Semantsch Datenaflaag"

#: services/storage/nepomukstorage.notifyrc:16
msgctxt "Comment"
msgid "Semantic Desktop"
msgstr "Schriefdischbeslöteln"

#: services/storage/nepomukstorage.notifyrc:31
msgctxt "Name"
msgid "Failed to start Nepomuk"
msgstr "Nepomuk lett sik nich starten."

#: services/storage/nepomukstorage.notifyrc:44
msgctxt "Comment"
msgid "The Nepomuk Semantic Desktop system could not be started"
msgstr "Dat Schriefdischbeslötel-Systeem Nepomuk lett sik nich starten"

#: services/storage/nepomukstorage.notifyrc:60
msgctxt "Name"
msgid "Converting Nepomuk data"
msgstr "Nepomuk-Daten warrt wannelt"

#: services/storage/nepomukstorage.notifyrc:73
msgctxt "Comment"
msgid "All Nepomuk data is converted to a new storage backend"
msgstr "All Nepomuk-Daten warrt för en nieg Hülpprogramm ümwannelt"

#: services/storage/nepomukstorage.notifyrc:89
msgctxt "Name"
msgid "Converting Nepomuk data failed"
msgstr "Ümwanneln vun Nepomuk-Daten fehlslaan"

#: services/storage/nepomukstorage.notifyrc:102
msgctxt "Comment"
msgid "Converting Nepomuk data to a new backend failed"
msgstr "Ümwanneln vun Nepomuk-Daten för en nieg Hülpprogramm fehlslaan"

#: services/storage/nepomukstorage.notifyrc:118
msgctxt "Name"
msgid "Converting Nepomuk data done"
msgstr "Ümwanneln vun Nepomuk-Daten afslaten"

#: services/storage/nepomukstorage.notifyrc:131
msgctxt "Comment"
msgid "Successfully converted Nepomuk data to new backend"
msgstr "Nepomuk-Daten mit Spood för nieg Hülpprogramm ümwannelt"
