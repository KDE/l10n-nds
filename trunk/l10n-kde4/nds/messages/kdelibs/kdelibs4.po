#: kdecore/services/kmimetyperepository.cpp:614
msgid ""
"No mime types installed. Check that shared-mime-info is installed, and that "
"XDG_DATA_DIRS is not set, or includes /usr/share."
msgstr ""
"De MIME-Typen sünd nich installeert. Beseker bitte, dat \"shared-mime-info\" "
"installeert is un de Variabel \"XDG_DATA_DIRS\" nich sett is oder \"/usr/"
"share\" dor mit binnen steiht."

