#: duchain/builders/declarationbuilder.cpp:301
#, kde-format
msgid "Access type for interface method %1 must be omitted."
msgstr "Togrieptyp för Koppelsteed-Metood %1 mutt utlaten warrn."

#: duchain/builders/declarationbuilder.cpp:305
#, kde-format
msgid "Interface function %1 cannot contain body."
msgstr "Koppelsteed-Funkschoon %1 mutt keen Hööftdeel bargen."

#: duchain/builders/declarationbuilder.cpp:317
#, kde-format
msgid ""
"Class %1 contains abstract method %2 and must therefore be declared abstract "
"or implement the method."
msgstr ""
"Klass %1 bargt afstrakt Metood %2 un mutt dorwegen afstrakt angeven warrn "
"oder de Metood ümsetten."

#: duchain/builders/declarationbuilder.cpp:323
#, kde-format
msgid "Abstract function %1 cannot contain body."
msgstr "Afstrakt Funkschoon %1 mutt keen Hööftdeel bargen."

#: duchain/builders/declarationbuilder.cpp:326
msgid "Cannot use the final modifier on an abstract class member."
msgstr "Finaal Modifikater lett sik nich för afstrakt Klass-Liddmaat bruken."

#: duchain/builders/declarationbuilder.cpp:336
#, kde-format
msgid "Non-abstract method %1 must contain body."
msgstr "Nich-afstrakt Metood %1 mutt en Hööftdeel bargen."

#: duchain/builders/declarationbuilder.cpp:350
msgid "Properties cannot be declared final."
msgstr "Egenschappen laat sik nich finaal angeven."

#: duchain/builders/declarationbuilder.cpp:353
msgid "Properties cannot be declared abstract."
msgstr "Egenschappen laat sik nich afstrakt angeven."

#: duchain/builders/declarationbuilder.cpp:452
#, kde-format
msgid "Cannot redeclare private property %1 from this context."
msgstr ""
"Privaat Egenschap %1 lett sik ut dissen Kontext nich nochmaal verkloren."

#: duchain/builders/declarationbuilder.cpp:458
#, kde-format
msgid "Cannot redeclare protected property %1 from this context."
msgstr ""
"Schuult Egenschap %1 lett sik ut dissen Kontext nich nochmaal verkloren."

#: duchain/builders/declarationbuilder.cpp:520
msgid ""
"Only booleans, ints, floats and strings are allowed for class constants."
msgstr ""
"För Klass-Konstanten sünd bloots Heeltall-, Fleetkomma-, boolsch Weerten un "
"Tekenkeden tolaten."

#: duchain/builders/declarationbuilder.cpp:533
msgid "Default value for parameters with a class type hint can only be NULL."
msgstr ""
"Standardweerten för Parameters mit en Klassentyp-Henwies köönt bloots NULL "
"wesen."

#: duchain/builders/declarationbuilder.cpp:536
msgid "Following parameters must have a default value assigned."
msgstr "För disse Parameters deit towiest Standardweerten noot."

#: duchain/builders/declarationbuilder.cpp:600
#, kde-format
msgid "Cannot redeclare PHP internal %1."
msgstr "PHP-Internal %1 lett sik nich nochmaal angeven."

#: duchain/builders/declarationbuilder.cpp:604
#, kde-format
msgid "Cannot redeclare %1, already declared in %2 on line %3."
msgstr ""
"%1 lett sik nich nochmaal verkloren, dat wöör al in %2, Reeg %3 verkloort."

#: duchain/builders/declarationbuilder.cpp:666
msgid "Cannot re-assign $this."
msgstr "\"$this\" lett sik nich nochmaal towiesen."

#: duchain/builders/declarationbuilder.cpp:1108
#, kde-format
msgid "The use statement with non-compound name '%1' has no effect."
msgstr ""

