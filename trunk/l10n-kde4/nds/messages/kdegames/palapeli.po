msgid "&Import from file..."
msgstr "Ut Datei &importeren..."

#: src/window/collectionwidget.cpp:51
msgid "Import a new puzzle from a file into your collection"
msgstr "En nieg Radel ut en Datei na Dien Sammeln importeren"

