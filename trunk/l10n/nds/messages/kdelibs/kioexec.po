#: main.cpp:50
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - maakt Dateien vun buten op, kiekt för Ännern, fraagt bi't Opladen"

#: main.cpp:54
msgid "Treat URLs as local files and delete them afterwards"
msgstr "Adressen (URLs) as Dateien op dien Rekner sehn un achterna wegsmieten"

#: main.cpp:55
msgid "Command to execute"
msgstr "Befehlt för't Utföhren"

#: main.cpp:56
msgid "URL(s) or local file(s) used for 'command'"
msgstr "URL(en) oder lokale Datei(en) för't 'command'"

#: main.cpp:72
msgid ""
"'command' expected.\n"
msgstr ""
"'command' weer ik vermoden.\n"

#: main.cpp:97
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"De URL %1\n"
"süht nich goot ut"

#: main.cpp:99
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"URL %1 vun buten\n"
"dörv nich mit --tempfile bruukt warrn"

#: main.cpp:226
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"De Datei %1\n"
"de temporär wesen schall\n"
"worr ännert.\n"
"Wullt Du de jümmers noch löschen?"

#: main.cpp:227 main.cpp:234
msgid "File Changed"
msgstr "Datei ännert"

#: main.cpp:233
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"De Datei\n"
"%1\n"
"worr ännert.\n"
"Wullt du de Ännern opladen?"

#: main.cpp:261
msgid "KIOExec"
msgstr "KIOExec"

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Kai F. Lahmann"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "kfl@3dots.de"
