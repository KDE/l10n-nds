"Swattwitt-Papeer na, as t.B. Bromid-Fotopapeer.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:335
msgid "Selenium Tone"
msgstr "Seleen-Klöörtoon"

#: imageplugins/imageeffect_bwsepia.cpp:336
msgid ""
