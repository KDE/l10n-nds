"<tr>"
"<td>%c</td>"
"<td>Verwiedert Titelinformatschoon</td>"
"<td>%{c} oder %{comment}</td></tr>"
"<tr>"
"<td>%g</td>"
"<td>Musikoort</td>"
"<td>%{g} oder %{genre}</td></tr>"
"<tr>"
"<td>%A</td>"
"<td>Album-Künstler</td>"
"<td>%{A} oder %{albumartist}</td></tr>"
"<tr>"
"<td>%T</td>"
"<td>Album-Titel</td>"
"<td>%{T} oder %{albumtitle}</td></tr>"
