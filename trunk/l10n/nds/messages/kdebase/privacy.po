#. i18n: file kprivacysettings.ui line 101
#: rc.cpp:37
#, no-c-format
msgid ""
"Warn me when I visit a site that uses my financial or purchase information:"
msgstr ""
"Wohrschoo mi wenn ik en Nettsiet besöök, de mien Finanz- oder "
"Kööpsinformatschonen bruken will:"

#. i18n: file kprivacysettings.ui line 109
#: rc.cpp:40 rc.cpp:52
#, no-c-format
msgid "For marketing or advertising purposes"
msgstr "För Vermarktens- oder Warvens-Grünnen"

#. i18n: file kprivacysettings.ui line 117
#: rc.cpp:43 rc.cpp:55 rc.cpp:67
#, no-c-format
msgid "To share with other companies"
msgstr "Tosamen mit annere Bedrieven bruken"

#. i18n: file kprivacysettings.ui line 127
#: rc.cpp:46
#, no-c-format
msgid "Health Information"
msgstr "Sundheits-Informatschoon"

#. i18n: file kprivacysettings.ui line 138
#: rc.cpp:49
#, no-c-format
msgid ""
"Warn me when I visit a site that uses my health or medical information: "
msgstr ""
"Wohrschoo mi wenn ik en Siet besöök, de mien Sundheits- oder medizinsche "
"Informatschonen bruken will: "

#. i18n: file kprivacysettings.ui line 164
#: rc.cpp:58
#, no-c-format
msgid "Demographics"
msgstr "Demografie"

#. i18n: file kprivacysettings.ui line 175
#: rc.cpp:61
#, no-c-format
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr ""
"Wohrschoo mi wenn ik'n Siet besöök, de Informatschonen bruken will, de nich "
"mi persöönlich totoornen sünd:"

#. i18n: file kprivacysettings.ui line 183
#: rc.cpp:64
#, no-c-format
msgid "To determine my interests, habits or general behavior"
msgstr "To't Faststellen vun Interessen, Wahnen oder allgemeen Verhollen"

#. i18n: file kprivacysettings.ui line 201
#: rc.cpp:70
#, no-c-format
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr ""
"Wohrschoo mi wenn ik en Siet besöök, de mien persöönliche Informatschonen "
"mit annere Bedrieven deelt"

#. i18n: file kprivacysettings.ui line 209
#: rc.cpp:73
#, no-c-format
msgid ""
"Warn me when I visit a site that does not let me know what information they "
"have about me"
msgstr ""
"Wohrschoo mi wenn ik en Siet besöök, vun de de Eegner mi nich weten laten "
"will, wat he över mi weet"

#. i18n: file kprivacysettings.ui line 217
#: rc.cpp:76
#, no-c-format
msgid "Personal Information"
msgstr "Persöönliche Informatschoon"

#. i18n: file kprivacysettings.ui line 228
#: rc.cpp:79
#, no-c-format
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"Wohrschoo mi wenn ik en Siet besöök, de mi villicht wegen annere Produkten "
"kontakteert:"

#. i18n: file kprivacysettings.ui line 236
#: rc.cpp:82
#, no-c-format
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr ""
"Wohrschoo mi wenn ik en Siet besöök, de mien persöönliche Informatschonen "
"villicht bruukt, üm:"

#. i18n: file kprivacysettings.ui line 244
#: rc.cpp:85
#, no-c-format
msgid "Determine my habits, interests or general behavior"
msgstr "Mien Interessen, Wahnen oder allgemeen Verhollen fasttostellen"

#. i18n: file kprivacysettings.ui line 260
#: rc.cpp:88
#, no-c-format
msgid "Via telephone"
msgstr "Över't Telefon"

#. i18n: file kprivacysettings.ui line 268
#: rc.cpp:91
#, no-c-format
msgid "Via mail"
msgstr "Över Post"

#. i18n: file kprivacysettings.ui line 286
#: rc.cpp:94
#, no-c-format
msgid "Via email"
msgstr "Över Nettpost"

#. i18n: file kprivacysettings.ui line 294
#: rc.cpp:97
#, no-c-format
msgid "And do not allow me to remove my contact information"
msgstr "Un nich verlöövt, de egen Kontaktdaten to löschen"
