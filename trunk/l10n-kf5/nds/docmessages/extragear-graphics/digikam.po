msgstr ""

#. Tag: entry
#: index.docbook:1202
#, no-c-format
msgid "<entry>78%</entry>"
msgstr ""

#. Tag: entry
#: index.docbook:1203
#, no-c-format
msgid "<entry>56%</entry>"
msgstr ""

#. Tag: entry
#: index.docbook:1206
#, no-c-format
msgid "Human error"
msgstr ""

#. Tag: entry
#: index.docbook:1207
#, no-c-format
