#, no-c-format
msgid "<link linkend=\"setup-mimetype\">Mime Type Settings</link>"
msgstr ""

#. Tag: link
#: index.docbook:1775
#, no-c-format
msgid "<link linkend=\"setup-lighttable\">Light Table Settings</link>"
msgstr ""

#. Tag: link
#: index.docbook:1776
#, no-c-format
msgid "<link linkend=\"setup-editor\">Image Editor Settings</link>"
msgstr ""

#. Tag: link
#: index.docbook:1777
#, no-c-format
