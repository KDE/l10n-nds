#. Tag: menuchoice
#: plugins.docbook:1075
#, no-c-format
msgid ""
"<guimenu>Debug</guimenu><guimenuitem>Kill / Stop Debugging</guimenuitem>"
msgstr ""

#. Tag: para
#: plugins.docbook:1078
#, no-c-format
msgid "Stops &gdb;."
