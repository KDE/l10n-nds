#: main.cpp:37 oxygenconfigdialog.cpp:55 oxygenconfigdialog.cpp:158
msgid "Oxygen Settings"
msgstr "Oxygen-Instellen"

#: oxygenanimationconfigwidget.cpp:50
msgid "Focus, mouseover and widget state transition"
msgstr "Fokus, Anrögen mit de Muus un Knoopstatusännern"

#: oxygenanimationconfigwidget.cpp:51
msgid ""
"Configure widgets' focus and mouseover highlight animation, as well as "
"widget enabled/disabled state transition"
msgstr ""
"Fokus un animeert Rutheven vun Stüerelementen bi't Anrögen mit de Muus "
"instellen, un Knoopstatusännern an- oder utmaken"

#: oxygenanimationconfigwidget.cpp:54
msgid "Toolbar highlight"
msgstr "Warktüüchbalken-Rutheven"

#: oxygenanimationconfigwidget.cpp:55
msgid "Configure toolbars' mouseover highlight animation"
