#: oxygenconfigdialog.cpp:75
msgid "Widget Style"
msgstr "Knoopstil"

#: oxygenconfigdialog.cpp:76
msgid "Modify the appearance of widgets"
msgstr "Dat Utsehn vun de Stüerelementen ännern"

#: oxygenconfigdialog.cpp:94
msgid "Window Decorations"
