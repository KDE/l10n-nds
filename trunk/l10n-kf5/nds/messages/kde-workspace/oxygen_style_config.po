#: oxygenanimationconfigwidget.cpp:74
msgid "Label transitions"
msgstr "Betekerännern"

#: oxygenanimationconfigwidget.cpp:74
msgid "Configure fading transition when a label's text is changed"
msgstr "Överblendt Övergang för ännert Betekertext instellen"

#: oxygenanimationconfigwidget.cpp:77
msgid "Text editor transitions"
msgstr "Texteditor-Ännern"

#: oxygenanimationconfigwidget.cpp:77
msgid "Configure fading transition when an editor's text is changed"
msgstr "Överblendt Övergang för ännert Editortext instellen"

#: oxygenanimationconfigwidget.cpp:80
msgid "Combo box transitions"
msgstr "Utsöökfeld-Ännern"

#: oxygenanimationconfigwidget.cpp:80
msgid ""
"Configure fading transition when a combo box's selected choice is changed"
msgstr "Överblendt Övergang för ännert Ankrüüz-Köör instellen"

#: oxygenanimationconfigwidget.cpp:90
msgid "Busy indicator steps"
msgstr "Utlastenwieser-Schreed"

#: oxygenanimationconfigwidget.cpp:91
msgid "Configure progress bars' busy indicator animation"
