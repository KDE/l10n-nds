#: main.cpp:51
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"De KDE-Törnpleger op den Verlaat is, de ok dat Standard-X11R6-\n"
"Törnpleegprotokoll (\"XSMP\") snackt."

#: main.cpp:139
msgid "$HOME not set!"
msgstr "$HOME nich fastleggt!"

#: main.cpp:144 main.cpp:151
#, kde-format
msgid "$HOME directory (%1) does not exist."
msgstr "Dat gifft den $HOME-Orner (%1) nich."

#: main.cpp:146
#, kde-format
msgid "No write access to $HOME directory (%1)."
msgstr "Du hest binnen den $HOME-Orner (%1) keen Schriefverlööf."

#: main.cpp:153
#, kde-format
msgid "No read access to $HOME directory (%1)."
msgstr "Du hest binnen den $HOME-Orner (%1) keen Leesverlööf."

#: main.cpp:158
#, kde-format
msgid "$HOME directory (%1) is out of disk space."
msgstr ""
"Dat gifft binne den $HOME-Orner (%1) keen free Ruum op de Fastplaat mehr."

#: main.cpp:160
#, kde-format
msgid "Writing to the $HOME directory (%2) failed with the error '%1'"
msgstr "Schrieven na den $HOME-Orner (%2) is fehlslaan mit den Fehler „%1“."

#: main.cpp:173 main.cpp:207
#, kde-format
msgid "No write access to '%1'."
msgstr "Keen Schrieftogriep op „%1“."

#: main.cpp:175 main.cpp:209
#, kde-format
msgid "No read access to '%1'."
msgstr "Keen Leestogriep op „%1“."

#: main.cpp:185 main.cpp:197
#, kde-format
msgid "Temp directory (%1) is out of disk space."
msgstr ""
"Dat gifft binne den Temporeerorner (%1) keen free Ruum op de Fastplaat mehr."

#: main.cpp:187 main.cpp:199
#, kde-format
msgid ""
"Writing to the temp directory (%2) failed with\n"
"    the error '%1'"
msgstr ""
"Schrieven na den Temporeerorner (%2) is fehlslaan\n"
"   mit den Fehler „%1“."

#: main.cpp:214
msgid ""
"The following installation problem was detected\n"
"while trying to start KDE:"
msgstr "Bi't Starten vun KDE wöör en Problem funnen:"

#: main.cpp:217
msgid ""
"\n"
"\n"
"KDE is unable to start.\n"
msgstr ""
"\n"
"\n"
"KDE lett sik nich starten.\n"

#: main.cpp:224
msgid "Plasma Workspace installation problem!"
msgstr "Problem mit de Plasma-Arbeitrebeet-Installeren!"

#: main.cpp:264
msgid "Restores the saved user session if available"
msgstr "Stellt den sekerten Brukertörn wedder her (wenn mööglich)"

#: main.cpp:268
msgid ""
"Starts <wm> in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Start <wm>, wenn keen anner Finsterpleger an\n"
"den Törn Andeel hett. Standard is \"kwin\""

#: main.cpp:269
msgid "wm"
msgstr "wm"

#: main.cpp:273
msgid "Also allow remote connections"
msgstr "Ok Verbinnen mit anner Reekners tolaten"

#: main.cpp:277
msgid "Starts the session in locked mode"
msgstr "Start den Törn afslaten"

#: main.cpp:281
msgid ""
"Starts without lock screen support. Only needed if other component provides "
"the lock screen."
msgstr ""

#: server.cpp:1047
msgid "Log Out"
msgstr "Afmellen"

#: server.cpp:1052
msgid "Log Out Without Confirmation"
msgstr "Ahn Nafraag afmellen"

#: server.cpp:1057
msgid "Halt Without Confirmation"
msgstr "Ahn Nafraag utmaken"

#: server.cpp:1062
msgid "Reboot Without Confirmation"
