"<TABLE>\n"
"<TR>\n"
"<TD>Bispillen:\n"
"<PRE>\n"
"    http://reeknernaam:631/ipp/\n"
"    http://reeknernaam:631/ipp/port1\n"
"\n"
"    ipp://reeknernaam/ipp/\n"
"    ipp://reeknernaam/ipp/port1\n"
"\n"
"    lpd://reeknernaam/töövreeg\n"
"\n"
"    socket://reeknernaam\n"
"    socket://reeknernaam:9100\n"
