#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "Plasma Workspace"
msgstr "Plasma-Arbeitrebeet"

#: plasma_workspace.notifyrc:41
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Affalltünn leddig maakt"

#: plasma_workspace.notifyrc:77
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "De Affalltünn wöör leddig maakt"

#: plasma_workspace.notifyrc:117
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Textkompletteren: Dreihen"

#: plasma_workspace.notifyrc:151
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Bi't Enn vun list mit Drepers anlangt"

#: plasma_workspace.notifyrc:189
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Textkompletteren: keen Dreper"

#: plasma_workspace.notifyrc:223
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Dor findt sik keen passen Kompletteren"

#: plasma_workspace.notifyrc:261
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Textkompletteren: Deeldreper"

#: plasma_workspace.notifyrc:295
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Dat gifft mehr as een mööglichen Dreper"

#: plasma_workspace.notifyrc:333
msgctxt "Name"
msgid "Fatal Error"
msgstr "Swoor Fehler"

#: plasma_workspace.notifyrc:368
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Dat geev en swoor Fehler, dat Programm is utstegen"

#: plasma_workspace.notifyrc:408
msgctxt "Name"
msgid "Notification"
msgstr "Bescheed"

#: plasma_workspace.notifyrc:444
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Dat geev en afsünnerlich Begeefnis binnen dat Programm"

#: plasma_workspace.notifyrc:483
msgctxt "Name"
msgid "Warning"
msgstr "Wohrschoen"

#: plasma_workspace.notifyrc:519
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr ""
"Dat geev en Fehler binnen dat Programm, villicht suert dor Problemen bi rut"

#: plasma_workspace.notifyrc:558
msgctxt "Name"
msgid "Catastrophe"
msgstr "Groot Malöör"

#: plasma_workspace.notifyrc:593
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "Dat geev en groot Malöör, tominnst dat Programm is utstegen"

#: plasma_workspace.notifyrc:632
msgctxt "Name"
msgid "Login"
msgstr "Anmellen"

#: plasma_workspace.notifyrc:668
msgctxt "Comment"
msgid "A new session is starting"
msgstr "En nieg Törn fangt an"

#: plasma_workspace.notifyrc:707
msgctxt "Name"
msgid "Logout"
msgstr "Afmellen"

#: plasma_workspace.notifyrc:743
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Törn warrt utmaakt"

#: plasma_workspace.notifyrc:783
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Afmellen afbraken"

#: plasma_workspace.notifyrc:819
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Afmellen vun Plasma wöör afbraken"

#: plasma_workspace.notifyrc:858
msgctxt "Name"
msgid "Print Error"
msgstr "Druckfehler"

#: plasma_workspace.notifyrc:894
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Dat geev en Fehler bi't Drucken"

#: plasma_workspace.notifyrc:933
msgctxt "Name"
msgid "Information Message"
msgstr "Informatschoon"

#: plasma_workspace.notifyrc:969
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "En Informatschoon warrt wiest"

#: plasma_workspace.notifyrc:1008
msgctxt "Name"
msgid "Warning Message"
msgstr "Wohrschoen"

#: plasma_workspace.notifyrc:1044
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "En Wohrschoen warrt wiest"

#: plasma_workspace.notifyrc:1083
msgctxt "Name"
msgid "Critical Message"
msgstr "Eernst Mellen"

#: plasma_workspace.notifyrc:1119
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "En eernst Mellen warrt wiest"

#: plasma_workspace.notifyrc:1158
msgctxt "Name"
msgid "Question"
msgstr "Fraag"

#: plasma_workspace.notifyrc:1194
msgctxt "Comment"
msgid "A question is being asked"
msgstr "En Fraag warrt wiest"

#: plasma_workspace.notifyrc:1234
msgctxt "Name"
msgid "Beep"
msgstr "Tüüt"

#: plasma_workspace.notifyrc:1270
msgctxt "Comment"
msgid "Sound bell"
msgstr "Klangpingel"
