#: ktorrent/ktorrent.notifyrc:3
msgctxt "Comment"
msgid "KTorrent"
msgstr "KTorrent"

#: ktorrent/ktorrent.notifyrc:60
msgctxt "Name"
msgid "Torrent silently opened"
msgstr "Torrent still opmaakt"

#: ktorrent/ktorrent.notifyrc:104
msgctxt "Name"
msgid "Torrent stopped by error"
msgstr "Torrent na Fehler anhollen"

#: ktorrent/ktorrent.notifyrc:157
msgctxt "Name"
msgid "Torrent has finished downloading"
msgstr "Torrent hett Daalladen afslaten"

#: ktorrent/ktorrent.notifyrc:210
msgctxt "Name"
msgid "Maximum share ratio reached"
msgstr "Bi hööchst Deelrelatschoon anlangt"

#: ktorrent/ktorrent.notifyrc:263
msgctxt "Name"
msgid "Maximum seed time reached"
msgstr "Bi hööchst Verdeeltiet anlangt"

#: ktorrent/ktorrent.notifyrc:316
msgctxt "Name"
msgid "Disk space is running low"
msgstr "Fastplaatruum geiht to Enn"

#: ktorrent/ktorrent.notifyrc:369
msgctxt "Name"
msgid "Corrupted data has been found"
msgstr "Schaadhaftig Daten funnen"

#: ktorrent/ktorrent.notifyrc:423
msgctxt "Name"
msgid "Torrent cannot be enqueued"
msgstr "Torrent lett sik nich inregen"

#: ktorrent/ktorrent.notifyrc:476
msgctxt "Name"
msgid "Torrent cannot be started"
msgstr "Torrent lett sik nich starten"

#: ktorrent/ktorrent.notifyrc:529
msgctxt "Name"
msgid "Torrent cannot be loaded silently"
msgstr "Torrent lett sik nich still laden"

#: ktorrent/ktorrent.notifyrc:582
msgctxt "Name"
msgid "DHT is not enabled"
msgstr "VPT is nich anmaakt"

#: ktorrent/ktorrent.notifyrc:631
msgctxt "Name"
msgid "Event generated by plugin"
msgstr "Vun Moduul opstellt Begeefnis"

#: ktorrent/ktorrent.notifyrc:677
msgctxt "Name"
msgid "Magnet link download started"
msgstr "Daalladen vun en Magnetlink anfungen"

#: ktorrent/org.kde.ktorrent.desktop:2
#: plasma/applet/plasma-applet-ktorrent.desktop:3
#: plasma/dataengine/plasma-dataengine-ktorrent.desktop:2
msgctxt "Name"
msgid "KTorrent"
msgstr "KTorrent"

#: ktorrent/org.kde.ktorrent.desktop:60
msgctxt "GenericName"
msgid "BitTorrent Client"
msgstr "BitTorrent-Client"

#: ktorrent/org.kde.ktorrent.desktop:125
msgctxt "Comment"
msgid "A BitTorrent program for KDE"
msgstr "En BitTorrent-Programm för KDE"

#: plasma/applet/plasma-applet-ktorrent.desktop:62
msgctxt "Comment"
msgid "Plasma widget to keep track of a single torrent"
msgstr "Plasma-Lüttprogramm, dat op een Enkeltorrent kiekt"

#: plasma/dataengine/plasma-dataengine-ktorrent.desktop:60
msgctxt "Comment"
msgid "KTorrent data engine, for getting information from KTorrent"
msgstr "KTorrent-Datenkarn. Hoolt Informatschonen vun KTorrent."

#: plugins/bwscheduler/ktorrent_bwscheduler.desktop:2
msgctxt "Name"
msgid "Scheduler"
msgstr "Planer"

#: plugins/bwscheduler/ktorrent_bwscheduler.desktop:49
msgctxt "Comment"
msgid "Schedule upload and download limits over a period of a week"
msgstr "Grenzen för't Hooch- un Daalladen över en Week planen"

#: plugins/downloadorder/ktorrent_downloadorder.desktop:2
msgctxt "Name"
msgid "Download Order"
msgstr "Daallaadreeg"

#: plugins/downloadorder/ktorrent_downloadorder.desktop:52
msgctxt "Comment"
msgid "Specify the download order of a multi-file torrent"
msgstr "Daallaadreeg bi en Mehrdateien-Torrent fastleggen"

#: plugins/infowidget/ktorrent_infowidget.desktop:2
msgctxt "Name"
msgid "Information Widget"
msgstr "Informatschonen-Element"

#: plugins/infowidget/ktorrent_infowidget.desktop:52
msgctxt "Comment"
msgid "Displays general information about a torrent in several tabs"
msgstr "Wiest Informatschonen över en Torrent binnen en Reeg Paneels"

#: plugins/ipfilter/ktipfilterplugin.desktop:2
msgctxt "Name"
msgid "IP Filter"
msgstr "IP-Filter"

#: plugins/ipfilter/ktipfilterplugin.desktop:54
msgctxt "Comment"
msgid "Filter IP addresses through a blocklist"
msgstr "IP-Adressen över en Blockeerlist filtern"

#: plugins/logviewer/ktorrent_logviewer.desktop:2
msgctxt "Name"
msgid "Log Viewer"
msgstr "Logbookkieker"

#: plugins/logviewer/ktorrent_logviewer.desktop:55
msgctxt "Comment"
msgid "Displays the logging output"
msgstr "Wiest de Logbook-Utgaven"

#: plugins/magnetgenerator/ktorrent_magnetgenerator.desktop:2
msgctxt "Name"
msgid "Magnet Generator"
msgstr "Magnetmaker"

#: plugins/magnetgenerator/ktorrent_magnetgenerator.desktop:47
msgctxt "Comment"
msgid "Generates magnet links"
msgstr "Stellt Magnetlinks op"

#: plugins/mediaplayer/ktorrent_mediaplayer.desktop:2
msgctxt "Name"
msgid "Media Player"
msgstr "Afspeler"

#: plugins/mediaplayer/ktorrent_mediaplayer.desktop:56
msgctxt "Comment"
msgid "Phonon-based media player"
msgstr "Op Phonon opbuut Afspeler"

#: plugins/scanfolder/ktscanfolderplugin.desktop:2
msgctxt "Name"
msgid "Scan Folder"
msgstr "Ornern dörkieken"

#: plugins/scanfolder/ktscanfolderplugin.desktop:54
msgctxt "Comment"
msgid "Scan folders for torrent files and load them"
msgstr "Ornern op Torrent-Dateien dörkieken un de denn laden"

#: plugins/scripting/ktscriptingplugin.desktop:2
msgctxt "Name"
msgid "Scripting"
msgstr "Skripten"

#: plugins/scripting/ktscriptingplugin.desktop:53
msgctxt "Comment"
msgid "Enables Kross scripting support"
msgstr "Ünnerstütten för Kross-Skripten"

#: plugins/scripting/scripts/auto_remove/auto_remove.desktop:2
msgctxt "Name"
msgid "Automatic Remove"
msgstr "Automaatsch wegmaken"

#: plugins/scripting/scripts/auto_remove/auto_remove.desktop:52
msgctxt "Comment"
msgid ""
"Script to automatically remove torrents when they finish downloading or "
"seeding"
msgstr ""
"Dat Skript maakt Torrents automaatsch weg, wenn ehr Daalladen oder Verdelen "
"afslaten is."

#: plugins/scripting/scripts/auto_resume/auto_resume.desktop:2
msgctxt "Name"
msgid "Automatic Resume"
msgstr "Automaatsch Wiedermaken"

#: plugins/scripting/scripts/auto_resume/auto_resume.desktop:53
msgctxt "Comment"
msgid ""
"Script to automatically resume after some time, when the suspended state is "
"enabled"
msgstr ""
"Dat Skript maakt automaatsch na en wiss Tiet wieder, wenn de Anhollen-Status "
"anmaakt is."

#: plugins/scripting/scripts/email_notifications/email_notifications.desktop:2
msgctxt "Name"
msgid "E-Mail Notifications"
msgstr "Nettpost-Narichten"

#: plugins/scripting/scripts/email_notifications/email_notifications.desktop:53
msgctxt "Comment"
msgid "Script to notify you of events via e-mail"
msgstr "Skript, dat Di en Nettbreef över Begeefnissen tostüert"

#: plugins/scripting/scripts/tracker_groups/tracker_groups.desktop:2
msgctxt "Name"
msgid "Tracker Grouping"
msgstr "Tracker-Koppeln"

#: plugins/scripting/scripts/tracker_groups/tracker_groups.desktop:52
msgctxt "Comment"
msgid "Script to create automatic groups based upon tracker URLs"
msgstr "Skript, dat ut de Tracker-URLs automaatsch Koppeln opstellt"

#: plugins/search/ktorrent_search.desktop:2
msgctxt "Name"
msgid "Search"
msgstr "Söken"

#: plugins/search/ktorrent_search.desktop:55
msgctxt "Comment"
msgid "Search for torrents"
msgstr "Na Torrents söken"

#: plugins/shutdown/ktorrent_shutdown.desktop:2
msgctxt "Name"
msgid "Shutdown"
msgstr "Utmaken"

#: plugins/shutdown/ktorrent_shutdown.desktop:56
msgctxt "Comment"
msgid "Allows you to shutdown your computer when torrents finish"
msgstr "Maakt den Reekner ut, wenn de Torrents afslaten sünd."

#: plugins/stats/ktorrent_stats.desktop:3
msgctxt "Name"
msgid "Statistics"
msgstr "Statistik"

#: plugins/stats/ktorrent_stats.desktop:57
msgctxt "Comment"
msgid "Shows statistics about torrents in several graphs"
msgstr "Statistiken över Torrents binnen Diagrammen wiesen"

#: plugins/syndication/ktsyndicationplugin.desktop:2
msgctxt "Name"
msgid "Syndication"
msgstr "Strööm"

#: plugins/syndication/ktsyndicationplugin.desktop:51
msgctxt "Comment"
msgid "Syndication plugin for KTorrent, supporting RSS and Atom feeds"
msgstr "Ströömmoduul för KTorrent, ünnerstütt RSS- un Atom-Strööm"

#: plugins/upnp/ktorrent_upnp.desktop:2
msgctxt "Name"
msgid "UPnP"
msgstr "UPnP"

#: plugins/upnp/ktorrent_upnp.desktop:55
msgctxt "Comment"
msgid "Forward ports using UPnP"
msgstr "Porten över UPnP wiederledden"

#: plugins/webinterface/ktwebinterfaceplugin.desktop:2
msgctxt "Name"
msgid "Web Interface"
msgstr "Nett-Koppelsteed"

#: plugins/webinterface/ktwebinterfaceplugin.desktop:56
msgctxt "Comment"
msgid "Allows control of KTorrent via a web interface"
msgstr "KTorrent över en Nettkieker stüern"

#: plugins/zeroconf/ktorrent_zeroconf.desktop:2
msgctxt "Name"
msgid "Zeroconf"
msgstr "Zeroconf"

#: plugins/zeroconf/ktorrent_zeroconf.desktop:54
msgctxt "Comment"
msgid "Discover peers on the local network using the Zeroconf protocol"
msgstr "Partners in't lokale Nett över't zeroconf-Protokoll opdecken"

