#: smb4k.appdata.xml:16
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#: smb4k.appdata.xml:20
msgid "Scanning for (active) workgroups, hosts, and shares"
msgstr "Kieken na (aktiev) Arbeitkoppeln, Reekners un Freegaven"

#. (itstool) path: ul/li
#: smb4k.appdata.xml:21
msgid "Support of the CIFS (Linux) and SMBFS (FreeBSD) file system"
msgstr "Ünnerstütt dat CIFS- (op Linux) un SMBFS-Dateisysteem (op FreeBSD)"

#. (itstool) path: ul/li
