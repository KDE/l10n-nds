#: freebusymanager.cpp:459
#, kde-format
msgid ""
"<qt><p>The software could not upload your free/busy list to the URL '%1'. "
"There might be a problem with the access rights, or you specified an "
"incorrect URL. The system said: <em>%2</em>.</p><p>Please check the URL or "
"contact your system administrator.</p></qt>"
msgstr ""
"<qt> <p>Dat Programm kunn Dien Free-/Bunnen-Daten nich na de URL \"%1\" "
"hoochladen. Dat mag en Problem mit de Togriepverlöven geven, oder Du hest "
"villicht en leeg URL angeven. Dat Systeem seeg: <em>%2</em>.</p> <p>Prööv "
"bitte de URL oder snack Dien Systeempleger dor op an.</p> </qt>"

#: freebusymanager.cpp:666
msgid "The free/busy information was successfully sent."
msgstr "De Free-/Bunnen-Daten wöörn mit Spood loosstüert."

#: freebusymanager.cpp:667 itiphandler_p.cpp:166
msgid "Sending Free/Busy"
msgstr "Free-/Bunnen-Daten warrt loosstüert"

#: freebusymanager.cpp:671
#, kde-format
msgid "Unable to publish the free/busy data: %1"
msgstr "De Free-/Bunnen-Daten laat sik nich apenmaken: %1"

#: freebusymanager.cpp:804
msgid ""
"<qt><p>No URL configured for uploading your free/busy list. Please set it in "
"KOrganizer's configuration dialog, on the \"Free/Busy\" page.</p><p>Contact "
"your system administrator for the exact URL and the account details.</p></qt>"
msgstr ""
"<qt> <p>Keen URK instellt för't Hoochladen vun Dien Free-/Bunnen-Daten. Legg "
"ehr bitte binnen KOrganizer sien Instellen fast, op de \"Free-/Bunnen\"-Siet."
"</p> <p>Snack Dien Systeeempleger op de naue URL un de Anmelldaten an.</p> </"
"qt>"

