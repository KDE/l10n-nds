#: editexternalscript.cpp:44
#, kde-format
msgid ""
"<p>Defines the command that should be executed when this script is run. "
"Basic shell features of your platform should be available.</p>\n"
"<p>There are a few placeholders you can use in the command:</p>\n"
"<dl>\n"
"  <dt><code>%u</code></dt>\n"
"  <dd>Gets replaced by the URL of the active document.</dd>\n"
"  <dt><code>%f</code></dt>\n"
"  <dd>Gets replaced by the local filepath to the active document.</dd>\n"
"  <dt><code>%n</code></dt>\n"
"  <dd>Gets replaced by the name of the active document, including its "
"extension.</dd>\n"
"  <dt><code>%b</code></dt>\n"
"  <dd>Gets replaced by the name of the active document without its extension."
"</dd>\n"
"  <dt><code>%d</code></dt>\n"
"  <dd>Gets replaced by the path to the directory of the active document.</"
"dd>\n"
"  <dt><code>%p</code></dt>\n"
"  <dd>Gets replaced by the URL to the project of the active document.</dd>\n"
"  <dt><code>%s</code></dt>\n"
"  <dd>Gets replaced with the shell escaped contents of the selection in the "
"active document.</dd>\n"
"  <dt><code>%i</code></dt>\n"
"  <dd>Gets replaced with the PID of the currently running KDevelop process.</"
"dd>\n"
"</dl>\n"
"<p><b>NOTE:</b>  It is your responsibility to prevent running hazardous "
"commands that could lead to data loss.</p>\n"
msgstr ""
"<p>Leggt den Befehl fast, de bi't Opropen vun dat Skript utföhrt warrt. Op "
"Dien Systeem mööt eenfach Konsoolmööglichkeiten verföögbor wesen.</p>\n"
"<p>De Befehl lett sik mit en Reeg vun Platzhollers bruken:</p>\n"
"<dl>\n"
"  <dt><code>%u</code></dt>\n"
"  <dd>Warrt mit de URL vun't aktive Dokment utwesselt.</dd>\n"
"  <dt><code>%f</code></dt>\n"
"  <dd>Warrt mit den lokaal Dateipadd vun't aktive Dokment utwesselt (mit "
"Verwiedern).</dd>\n"
"  <dt><code>%n</code></dt>\n"
"  <dd>Warrt mit den Naam vun't aktive Dokment utwesselt (mit Verwiedern).</"
"dd>\n"
"  <dt><code>%b</code></dt>\n"
"  <dd>Warrt mit den Naam vun't aktive Dokment utwesselt (ahn Verwiedern).</"
"dd>\n"
"  <dt><code>%d</code></dt>\n"
"  <dd>Warrt mit den Padd na den Orner vun't aktive Dokment utwesselt.</dd>\n"
"  <dt><code>%p</code></dt>\n"
"  <dd>Warrt mit de URL vun dat Projekt vun't aktive Dokment utwesselt.</dd>\n"
"  <dt><code>%s</code></dt>\n"
"  <dd>Warrt mit den Konsoolinholt (mit Goosfööt) vun de Köör ut dat aktive "
"Dokment utwesselt.</dd>\n"
"  <dt><code>%i</code></dt>\n"
"  <dd>Warrt mit de PID vun den opstunns lopen KDevelop-Perzess utwesselt.</"
"dd>\n"
"</dl>\n"
"<p><b>Beacht:</b> Dat is Dien Saak, dat keen riskant Befehlen utföhrt warrt, "
"de to Datenverlust föhren köönt.</p>\n"

#: editexternalscript.cpp:70
#, kde-format
msgid ""
"<p>Defines what the external script should get as input (via <code>STDIN</"
"code>).</p>"
msgstr ""
"<p>Leggt de Ingaav för dat extern Skript fast (över <code>STDIN</code>).</p>"

#: editexternalscript.cpp:76
#, kde-format
msgid ""
"<p>Defines what should be done with the output (i.e. <code>STDOUT</code>) of "
"the script.</p>"
msgstr ""
"<p>Leggt fast, wodennig mit de Skriptutgaav (a.B. <code>STDOUT</code>) "
"ümgahn warrt.</p>"

#: editexternalscript.cpp:82
#, kde-format
msgid ""
"<p>Defines what should be done with the errors (i.e. <code>STDERR</code>) of "
"the script.</p><p>Note: if the action is the same as that chosen for the "
"output, the channels will be merged and handled together.</p>"
msgstr ""
"<p>Leggt fast, wodennig mit Skriptfehlers (a.B. <code>STDERR</code>) ümgahn "
"warrt.</p><p>Beacht: Is disse Akschoon de sülvige as för de Utgaav, warrt de "
"Kanaals tosamenföhrt un tohoop behannelt.</p>"

#: editexternalscript.cpp:90
#, kde-format
msgid "<p>Defines the name of the script. Just for displaying purposes.</p>"
msgstr "<p>Leggt den Skriptnaam fast. Warrt bloots för't Wiesen bruukt.</p>"

#: editexternalscript.cpp:96
#, kde-format
msgid ""
"<p>Defines the shortcut(s) you can use to execute this external script.</p>"
msgstr ""
"<p>Leggt Tastkombinatschonen fast, mit de sik dit extern Skript utföhren "
"lett.</p>"

#: editexternalscript.cpp:102
#, kde-format
msgid ""
"<p>Defines whether documents should be saved before the script gets executed."
"</p>"
msgstr ""
"<p>Leggt fast, wat Dokmenten sekert warrt, ehr dat Skript utföhrt warrt.</p>"

#: editexternalscript.cpp:108
#, fuzzy, kde-format
#| msgid ""
#| "<p>Defines whether the output of the script should be shown in a toolview."
#| "</p>"
msgid ""
"<p>Defines whether the output of the script should be shown in a tool view.</"
"p>"
msgstr ""
"<p>Leggt fast, wat de Skriptutgaav as Warktüüchansicht wiest warrt.</p>"

#: editexternalscript.cpp:112
#, kde-format
msgid ""
"<p>Defines what type of filtering should be applied to the output. E.g. to "
"indicate errors by red text.</p>"
msgstr ""

