#: app/main/digikam.desktop:9
msgctxt "Name"
msgid "digiKam"
msgstr "digiKam"

#: app/main/digikam.desktop:66
msgctxt "GenericName"
msgid "Photo Management Program"
msgstr "Fotopleeg-Programm"

#: app/main/digikam.desktop:118 showfoto/main/showfoto.desktop:103
msgctxt "Comment"
msgid ""
"Manage your photographs like a professional with the power of open source"
msgstr "Pleeg Dien Fotos as'n Fachmann. - Mit de Knööv vun Apenborn."

#: app/main/digikam.notifyrc:3
msgctxt "Comment"
msgid "digiKam"
msgstr "digiKam"

#: app/main/digikam.notifyrc:55
msgctxt "Name"
msgid "Download complete"
msgstr "Daalladen afslaten"

#: app/main/digikam.notifyrc:102
msgctxt "Comment"
msgid "A download from a camera or other device has finished."
msgstr "Daalladen vun en Kamera oder anner Reedschap is afslaten"

#: app/main/digikam.notifyrc:150
msgctxt "Name"
msgid "Save file complete"
msgstr "Dateisekern afslaten"

#: app/main/digikam.notifyrc:191
msgctxt "Comment"
msgid "A file from image editor is saved."
msgstr "En Bild ut den Bildeditor wöör sekert."

#: app/main/digikam.notifyrc:235
msgctxt "Name"
msgid "Batch queue completed"
msgstr "Opgavenreeg afslaten"

#: app/main/digikam.notifyrc:277
msgctxt "Comment"
msgid "A queue in the batch queue manager has been completed."
msgstr "En Opgavenreeg binnen den Stapelregenpleger wöör afslaten."

#: app/main/digikam.notifyrc:321
msgctxt "Name"
msgid "Update of fingerprint database complete"
msgstr "Fingerafdruck-Datenbank opfrischt"

#: app/main/digikam.notifyrc:364
msgctxt "Comment"
msgid "The update of the fingerprint database has been completed."
msgstr "De Fingerafdruck-Datenbank wöör opfrischt."

#: app/main/digikam.notifyrc:410
msgctxt "Name"
msgid "Update of thumbnails database complete"
msgstr "Vöransicht-Datenbank opfrischt."

#: app/main/digikam.notifyrc:453
msgctxt "Comment"
msgid "The update of the thumbnails database has been completed."
msgstr "De Vöransicht-Datenbank wöör opfrischt."

#: app/main/digikam.notifyrc:499
msgctxt "Name"
msgid "Synchronization of images' metadata with database completed"
msgstr "Bildmetadaten mit Datenbank synkroniseert"

#: app/main/digikam.notifyrc:541
msgctxt "Comment"
msgid ""
"The synchronization of the images' metadata with the database has been "
"completed."
msgstr "De Synkroniseren vun de Bildmetadaten mit Datenbank wöör afslaten."

#: app/main/digikam.notifyrc:586
msgctxt "Name"
msgid "Update of detected faces database complete"
msgstr "Opdeckt-Gesichter-Datenbank opfrischt"

#: app/main/digikam.notifyrc:625
msgctxt "Comment"
msgid "The update of the detected faces database has completed."
msgstr ""
"Dat Opfrischen vun de Datenbank mit de opdeckten Gesichter wöör afslaten."

#: app/main/digikam.notifyrc:667
msgctxt "Name"
msgid "Update of duplicates items in database complete"
msgstr "Dubbelindrääg binnen Datenbank opfrischt"

#: app/main/digikam.notifyrc:705
msgctxt "Comment"
msgid "The update of the duplicates items in database has completed."
msgstr "Dat Opfrischen vun Dubbelindrääg binnen Datenbank wöör afslaten."

#: app/main/digikam.notifyrc:746
msgctxt "Name"
msgid "Find of new items in database complete"
msgstr "Nieg Indrääg binnen Datenbank söcht"

#: app/main/digikam.notifyrc:784
msgctxt "Comment"
msgid "The scan of the new items in database has completed."
msgstr "Dat Dörkieken vun de Datenbank op nieg Indrääg wöör afslaten."

