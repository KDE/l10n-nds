msgstr "&FSView-Handbook"

#: fsview_part.cpp:143
msgid "Show FSView manual"
msgstr "FSView-Handbook wiesen"

#: fsview_part.cpp:144
msgid "Opens the help browser with the FSView documentation"
msgstr "Maakt den Hülp-Kieker mit de FSView-Dokmentatschoon op"

