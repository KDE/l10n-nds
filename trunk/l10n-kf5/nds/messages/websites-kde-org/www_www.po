#: content/announcements/plasma/5/5.6.95.md:20
#: content/announcements/plasma/5/5.7.0.md:11
msgid "Jump List Actions in KRunner "
msgstr ""

#. type: shortcode parameter
#: content/announcements/plasma/5/5.6.95.md:20
#: content/announcements/plasma/5/5.7.0.md:11
