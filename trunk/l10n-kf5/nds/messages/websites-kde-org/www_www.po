#. type: shortcode parameter
#: content/announcements/plasma/5/5.0.95.md:23
#: content/announcements/plasma/5/5.1.0.md:17
msgid "Breeze Theme for Qt 4"
msgstr ""

#. type: Plain Text
#: content/announcements/plasma/5/5.0.95.md:25
#: content/announcements/plasma/5/5.1.0.md:19
msgid ""
"A new Breeze widget theme for Qt 4 lets applications written with KDE "
