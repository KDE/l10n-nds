"Plastik window decoration now supports global menu. <a href=\"https://"
"commits.kde.org/kwin/3e0ddba683ca68cb50b403cb3893fa2fc9d2d737\">Commit.</a> "
"See bug <a href=\"https://bugs.kde.org/375862\">#375862</a>. Phabricator "
"Code review <a href=\"https://phabricator.kde.org/D5131\">D5131</a>"
msgstr ""

#. type: List item
#: content/announcements/plasma/5/5.9.5.md:6
