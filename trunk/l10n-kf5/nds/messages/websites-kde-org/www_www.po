#. type: shortcode parameter
#: content/announcements/plasma/5/5.0.95.md:19
#: content/announcements/plasma/5/5.1.0.md:27
msgid "Icons-only Task Manager"
msgstr ""

#. type: shortcode parameter
#: content/announcements/plasma/5/5.0.95.md:21
