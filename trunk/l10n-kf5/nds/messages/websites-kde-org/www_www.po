"f61f9d8c100fe94471b1a8f23ac905e9311b7436\">Commit.</a> Phabricator Code "
"review <a href=\"https://phabricator.kde.org/D5006\">D5006</a>"
msgstr ""

#. type: List item
#: content/announcements/plasma/5/5.9.5.md:5
