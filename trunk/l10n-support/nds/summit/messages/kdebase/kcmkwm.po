#: windows.cpp:598
msgid "Smart"
msgstr "Plietsch"

#. +> trunk stable
#: windows.cpp:599
msgid "Maximizing"
msgstr "Maximeren"

#. +> trunk stable
#: windows.cpp:600
msgid "Cascade"
msgstr "Treppwies"

