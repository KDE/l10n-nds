#. +> trunk
#: composite.cpp:490
#, kde-format
msgid ""
"Compositing was too slow and has been suspended.\n"
"If this was only a temporary problem, you can resume using the '%1' shortcut.\n"
"You can also disable functionality checks in advanced compositing settings."
msgstr ""
"Dat Tosamensetten weer to langsam un wöör utsett.\n"
"Weer dat en Problem, dat wedder weggeiht, kannst Du dat mit \"%1\" wedder anmaken.\n"
"Du kannst de Funkschoonpröven binnen de verwiederten Tosamensett-Instellen utmaken."

#. +> trunk stable
#: compositingprefs.cpp:87
msgid "Required X extensions (XComposite and XDamage) are not available."
msgstr "Nödig X-Server-Verwiedern (XComposite un XDamage) laat sik nich finnen."

#. +> trunk stable
#: compositingprefs.cpp:91
msgid "GLX/OpenGL are not available and only OpenGL support is compiled."
msgstr "GLX/OpenGL sünd nich verföögbor, un inbuut is bloots Ünnerstütten för OpenGL."

#. +> trunk stable
#: compositingprefs.cpp:94
msgid "XRender/XFixes extensions are not available and only XRender support is compiled."
msgstr "XRender-/XFixes-Verwiedern sünd nich verföögbor, un inbuut is bloots Ünnerstütten för XRender."

#. +> trunk stable
#: compositingprefs.cpp:100
msgid "GLX/OpenGL and XRender/XFixes are not available."
msgstr "GLX-/OpenGL- un XRender-/XFixes-Verwiedern sünd nich verföögbor."

#. +> trunk stable
#: compositingprefs.cpp:105
msgid ""
"Compositing was disabled at compile time.\n"
"It is likely Xorg development headers were not installed."
msgstr ""
"Tosamensetten weer bi't Kompileren utmaakt.\n"
"Dat geev wull de X.Org-Koppdateien nich."

