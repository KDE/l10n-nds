#. +> trunk stable
#: main.cpp:52
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"De KDE-Törnpleger op den Verlaat is, de ok dat Standard-X11R6-\n"
"Törnpleegprotokoll (\"XSMP\") snackt."

#. +> trunk stable
#: main.cpp:244
msgid "The KDE Session Manager"
msgstr "De KDE-Törnpleger"

#. +> trunk stable
#: main.cpp:246
msgid "(C) 2000, The KDE Developers"
msgstr "(C) 2000, De KDE-Schrievers"

#. +> trunk stable
#: main.cpp:247
msgid "Matthias Ettrich"
msgstr "Matthias Ettrich"

#. +> trunk stable
#: main.cpp:248
msgid "Luboš Luňák"
msgstr "Luboš Luňák"

#. +> trunk stable
#: main.cpp:248
msgid "Maintainer"
msgstr "Pleger"

#. +> trunk stable
#: main.cpp:256
msgid "Restores the saved user session if available"
msgstr "Stellt den sekerten Brukertörn wedder her (wenn mööglich)"

#. +> trunk stable
#: main.cpp:258
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Start \"wm\", wenn keen anner Finsterpleger an\n"
"den Törn Andeel hett. Standard is \"kwin\""

#. +> trunk stable
#: main.cpp:259
msgid "Also allow remote connections"
msgstr "Ok Verbinnen mit anner Reekners tolaten"

