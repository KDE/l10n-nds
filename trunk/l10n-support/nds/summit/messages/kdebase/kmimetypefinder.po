#. +> trunk stable
#: kmimetypefinder.cpp:32
msgid "MimeType Finder"
msgstr "Söker för MIME-Typen"

#. +> trunk stable
#: kmimetypefinder.cpp:32
msgid "Gives the mimetype for a given file"
msgstr "Gifft den MIME-Typ vun en angeven Datei ut"

#. +> stable
#: kmimetypefinder.cpp:34
msgid "The filename to test"
msgstr "De Datei, över de Du wat weten wullt"

#. +> trunk
#: kmimetypefinder.cpp:37
msgid "Use only the file content for determining the mimetype."
msgstr "Den MIME-Typ bloots över den Dateiinholt faststellen"

#. +> trunk
#: kmimetypefinder.cpp:38
msgid "Whether use the file name only for determining the mimetype. Not used if -c is specified."
msgstr "Leggt fast, wat bloots de MIME-Typ bloots över den Dateinaam faststellt warrt. Warrt nich bruukt, wenn -c angeven is."

#. +> trunk
#: kmimetypefinder.cpp:39
msgid "The filename to test. '-' to read from stdin."
msgstr "De Datei, över de Du wat weten wullt. Mit \"-\" warrt vun de Standardingaav leest."

#~ msgid "the filename to test"
#~ msgstr "De Datei, över de Du wat weten wullt"
