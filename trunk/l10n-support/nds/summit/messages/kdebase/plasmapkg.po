#: main.cpp:39
msgid "Install, list, remove Plasma packages"
msgstr "Plasmapaketen installeren, oplisten un wegmaken"

#. +> trunk
#: main.cpp:78
msgid "Package types that are installable with this tool:"
msgstr "Pakettypen, de sik mit dit Warktüüch installeren laat:"

#. +> trunk
#: main.cpp:79
msgid "Built in:"
msgstr "Inbuut:"

#. +> trunk
#: main.cpp:80
msgid "    dataengine: Plasma DataEngine plugin"
msgstr "    Datenkarn: Datenkarn-Moduul för Plasma"

#. +> trunk
#: main.cpp:81
msgid "    layout-template: Plasma containment and widget layout script"
msgstr "    Anornen-Vörlaag: Plasma-Gelaats un Anornen-Skript för Lüttprogrammen"

#. +> trunk
#: main.cpp:82
msgid "    plasmoid: Plasma widget"
msgstr "    Plasmoid: Plasma-Lüttprogramm"

#. +> trunk
#: main.cpp:83
msgid "    runner: Search plugin (KRunner, etc)"
msgstr "    Dreger: Söökmoduul (KRunner usw.)"

#. +> trunk
#: main.cpp:84
msgid "    theme: Plasma SVG theme"
msgstr "    Muster: SVG-Muster för Plasma"

#. +> trunk
#: main.cpp:85
msgid "    wallpaper: Image pack for use with wallpaper backgrounds"
msgstr "    Achtergrundbild: Bildpaket för den Bruuk as Achtergrundbiller"

#. +> trunk
#: main.cpp:86
msgid "    wallpaperplugin: Wallpaper plugin"
msgstr "    Achtergrundbild-Moduul: Achtergrundbild-Moduul"

#. +> trunk
#: main.cpp:91
msgid "Provided by plugins:"
msgstr "Vun Modulen praatstellt:"

#. +> trunk
#: main.cpp:95 main.cpp:110
#, kde-format
msgctxt "Plugin name and the kind of Plasma related content it provides, both from the plugin's desktop file"
msgid "    %1: %2"
msgstr "    %1: %2"

#. +> trunk
#: main.cpp:101
msgid "Provided by .desktop files:"
msgstr "Vun \".desktop\"-Dateien praatstellt:"

#. +> trunk stable
#: main.cpp:117
msgid "Plasma Package Manager"
msgstr "Pleger för Plasma-Paketen"

#. +> trunk stable
#: main.cpp:119
msgid "(C) 2008, Aaron Seigo"
msgstr "© 2008: Aaron Seigo"

#. +> trunk stable
#: main.cpp:120
msgid "Aaron Seigo"
msgstr "Aaron Seigo"

#. +> trunk stable
#: main.cpp:121
msgid "Original author"
msgstr "Orginaalautor"

#. +> trunk stable
#: main.cpp:130
msgid "For install or remove, operates on packages installed for all users."
msgstr "Bi't Installeren un Wegmaken gellt dat för Paketen, de för all Brukers installeert sünd"

#. +> trunk stable
#: main.cpp:136
msgctxt "theme, wallpaper, etc. are keywords, but they may be translated, as both versions are recognized by the application (if translated, should be same as messages with 'package type' context below)"
msgid "The type of package, e.g. theme, wallpaper, plasmoid, dataengine, runner, layout-template, etc."
msgstr "De Typ vun't Paket, a.B. Muster, Achtergrundbild, Plasma-Lüttprogramm, Datenkarn, Dreger, Anornen-Vörlaag usw."

#. +> trunk stable
#: main.cpp:140
msgctxt "Do not translate <path>"
msgid "Install the package at <path>"
msgstr "Dat Paket ünner den Padd <path> installeren"

#. +> trunk stable
#: main.cpp:142
msgctxt "Do not translate <path>"
msgid "Upgrade the package at <path>"
msgstr "Dat Paket ünner den Padd <path> opfrischen"

#. +> trunk stable
#: main.cpp:144
msgid "List installed packages"
msgstr "Installeert Paketen oplisten"

#. +> trunk
#: main.cpp:145
msgid "lists all known Package types that can be installed"
msgstr "Wiest all begäng Pakettypen, de sik installeren laat."

#. +> trunk stable
#: main.cpp:147
msgctxt "Do not translate <name>"
msgid "Remove the package named <name>"
msgstr "Dat Paket mit den Naam <name> wegmaken"

#. +> trunk stable
#: main.cpp:149
msgid "Absolute path to the package root. If not supplied, then the standard data directories for this KDE session will be searched instead."
msgstr "Afsoluut Padd na de Paketwörtel. Wenn nich angeven, warrt de Standard-Datenornern för dissen KDE-Törn dörkeken."

