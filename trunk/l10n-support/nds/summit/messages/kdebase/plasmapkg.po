#: main.cpp:300
#, kde-format
msgid "Successfully removed %1"
msgstr "%1 mit Spood wegmaakt"

#. +> trunk stable
#: main.cpp:302
#, kde-format
msgid "Removal of %1 failed."
msgstr "Wegmaken vun \"%1\" is fehlslaan."

