#: rc.cpp:12
msgid ""
"<b>Use default stylesheet</b>"
"<p>Select this option to use the default stylesheet.</p>"
msgstr ""
"<b>Standardstilvörlaag bruken</b>"
"<p>Wenn anmaakt, warrt de Standardstilvörlaag bruukt.</p>"

