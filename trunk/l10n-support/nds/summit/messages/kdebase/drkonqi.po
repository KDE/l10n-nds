#. +> trunk stable
#: ui/assistantpage_bugzilla_information.ui:17
msgctxt "@info/rich"
msgid ""
"Complete the bug report fields: <nl />"
"<note>Use English.</note>"
msgstr ""
"Bitte de Feller binnen den Fehlerbericht utfüllen:<nl />"
"<note>Bitte Engelsch bruken</note>"

