#. +> trunk stable
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#. +> trunk stable
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

#. +> trunk stable
#: kdesu.cpp:85
msgid "KDE su"
msgstr "KDE su"

#. +> trunk stable
#: kdesu.cpp:86
msgid "Runs a program with elevated privileges."
msgstr "Föhrt en Programm mit verwiedert Verlöven ut."

#. +> trunk stable
#: kdesu.cpp:88
msgid "Copyright (c) 1998-2000 Geert Jansen, Pietro Iglio"
msgstr "Copyright (c) 1998-2000 Geert Jansen, Pietro Iglio"

#. +> trunk stable
#: kdesu.cpp:89
msgid "Geert Jansen"
msgstr "Geert Jansen"

#. +> trunk stable
#: kdesu.cpp:89
msgid "Maintainer"
msgstr "Pleger"

#. +> trunk stable
#: kdesu.cpp:91
msgid "Pietro Iglio"
msgstr "Pietro Iglio"

#. +> trunk stable
#: kdesu.cpp:91
msgid "Original author"
msgstr "Orginaalautor"

#. +> trunk stable
#: kdesu.cpp:100 kdesu.cpp:101
msgid "Specifies the command to run"
msgstr "Befehl, de utföhrt warrn schall"

#. +> trunk stable
#: kdesu.cpp:102
msgid "Run command under target uid if <file> is not writable"
msgstr "Befehl ünner disse UID utföhren, wenn <file> sik nich schrieven lett"

#. +> trunk stable
#: kdesu.cpp:103
msgid "Specifies the target uid"
msgstr "Gifft de Teel-UID an"

#. +> trunk stable
#: kdesu.cpp:104
msgid "Do not keep password"
msgstr "Passwoort nich wohren"

#. +> trunk stable
#: kdesu.cpp:105
msgid "Stop the daemon (forgets all passwords)"
msgstr "Den Dämoon anhollen (smitt all Passwöör weg)"

#. +> trunk stable
#: kdesu.cpp:106
msgid "Enable terminal output (no password keeping)"
msgstr "Utgaav na't Terminal anmaken (Passwöör nich wohren)"

#. +> trunk stable
#: kdesu.cpp:107
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest"
msgstr "Prioriteet fastleggen: 0<= Weert <= 100, 0 is sietst"

#. +> trunk stable
#: kdesu.cpp:108
msgid "Use realtime scheduling"
msgstr "Echttietplanen bruken"

#. +> trunk stable
#: kdesu.cpp:109
msgid "Do not display ignore button"
msgstr "\"Övergahn\"-Knoop nich wiesen"

#. +> stable
#: kdesu.cpp:109
msgid "Let command use existing dcopserver"
msgstr "Befehl schall vörhannen DCOP-Server bruken"

#. +> trunk stable
#: kdesu.cpp:110
msgid "Specify icon to use in the password dialog"
msgstr "Lüttbild för Passwoort-Dialoog angeven"

#. +> trunk stable
#: kdesu.cpp:111
msgid "Do not show the command to be run in the dialog"
msgstr "Den Befehl nich wiesen, de in den Dialoog utföhrt warrn schall"

#. +> trunk
#: kdesu.cpp:115
msgctxt "Transient means that the kdesu app will be attached to the app specified by the winid so that its like a dialog box rather than some separate program"
msgid "Makes the dialog transient for an X app specified by winid"
msgstr "Röppt den Dialoog as Deel vun't X-Programm op, dat vun \"winid\" angeven warrt"

#. +> trunk stable
#: kdesu.cpp:140
#, kde-format
msgid "Command '%1' not found."
msgstr "Befehl \"%1\" lett sik nich finnen."

#. +> trunk stable
#: kdesu.cpp:215
#, kde-format
msgid "Illegal priority: %1"
msgstr "Leeg Prioriteet: %1"

#. +> trunk stable
#: kdesu.cpp:246
msgid "No command specified."
msgstr "Keen Befehl utsöcht."

#. +> trunk stable
#: kdesu.cpp:363
msgid "Su returned with an error.\n"
msgstr "\"su\" hett en Fehler torüchgeven.\n"

#. +> trunk stable
#: kdesu.cpp:386
msgid "Command:"
msgstr "Befehl:"

#. +> trunk stable
#: kdesu.cpp:394
msgid "realtime: "
msgstr "Echttiet: "

#. +> trunk stable
#: kdesu.cpp:397
msgid "Priority:"
msgstr "Prioriteet:"

#. +> trunk stable
#: sudlg.cpp:23
msgid "Ignore"
msgstr "Övergahn"

#. +> trunk stable
#: sudlg.cpp:30
#, kde-format
msgid "Run as %1"
msgstr "As %1 utföhren"

#. +> trunk stable
#: sudlg.cpp:34
msgid "Please enter your password below."
msgstr "Giff bitte nerrn Dien Passwoort in."

#. +> trunk stable
#: sudlg.cpp:38
msgid "The action you requested needs <b>root privileges</b>. Please enter <b>root's</b> password below or click Ignore to continue with your current privileges."
msgstr "Dien Akschoon bruukt <b>Systeempleger-Verlöven</b>. Bitte giff dat <b>Systeempleger</b>-Passwoort nerrn in, oder klick op \"Övergahn\", wenn Du mit Dien aktuelle Verlöven wiedermaken wullt."

#. +> trunk
#: sudlg.cpp:42
msgid "The action you requested needs <b>root privileges</b>. Please enter <b>root's</b> password below."
msgstr "Dien Akschoon bruukt <b>Systeempleger-Verlöven</b>. Bitte giff nerrn den <b>Systeempleger</b> sien Passwoort in."

#. +> trunk stable
#: sudlg.cpp:46
#, kde-format
msgid "The action you requested needs additional privileges. Please enter the password for <b>%1</b> below or click Ignore to continue with your current privileges."
msgstr "De Akschoon bruukt mehr Verlöven. Bitte giff dat Passwoort för <b>%1</b> nerrn in, oder klick op \"Övergahn\", wenn Du mit Dien aktuelle Verlöven wiedermaken wullt."

#. +> trunk
#: sudlg.cpp:51
#, kde-format
msgid "The action you requested needs additional privileges. Please enter the password for <b>%1</b> below."
msgstr "Dien Akschoon bruukt mehr Verlöven. Bitte giff nerrn dat Passwoort vun <b>%1</b> in."

#. +> trunk stable
#: sudlg.cpp:60
msgid "&Ignore"
msgstr "Över&gahn"

#. +> trunk stable
#: sudlg.cpp:77
msgid "Conversation with su failed."
msgstr "Kommunikatschoon mit \"su\" fehlslaan."

#. +> trunk stable
#: sudlg.cpp:84
msgid ""
"The program 'su' could not be found.<br />"
"Ensure your PATH is set correctly."
msgstr ""
"Dat Programm \"su\" lett sik nich finnen.<br />"
"Prööv bitte, wat Dien PATH-Variabel richtig instellt is."

#. +> trunk stable
#: sudlg.cpp:95
msgid "Incorrect password, please try again."
msgstr "Dat Passwoort gellt nich, versöök dat man nochmaal."

#. +> trunk stable
#: sudlg.cpp:99
msgid "Internal error: illegal return from SuProcess::checkInstall()"
msgstr "Intern Fehler: Leeg Utgaav vun \"SuProcess::checkInstall()\""

