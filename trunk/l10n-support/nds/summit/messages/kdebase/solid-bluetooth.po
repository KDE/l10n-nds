#: solid-bluetooth.cpp:200
msgid "Syntax:"
msgstr "Syntax:"

#. +> trunk stable
#: solid-bluetooth.cpp:203
msgid "             # List bluetooth adapters/interfaces\n"
msgstr "             # Bluetooth-Koorten/-Koppelsteden oplisten\n"

#. +> trunk stable
#: solid-bluetooth.cpp:206
msgid "             # List bluetooth default adapter/interface\n"
msgstr "             # Standard-Bluetoothkoort/-koppelsteed oplisten\n"

#. +> trunk stable
#: solid-bluetooth.cpp:209
msgid "             # Request to create a remote bluetooth device on the bus\n"
msgstr "             # Anfraag för't Opstellen vun en feern Bluetooth-Reedschap op den Bus\n"

#. +> trunk stable
#: solid-bluetooth.cpp:212
msgid "             # Request to remove the remote bluetooth device from the bus\n"
msgstr "             # Anfraag för't Wegmaken vun en feern Bluetooth-Reedschap vun den Bus\n"

#. +> trunk stable
#: solid-bluetooth.cpp:215
msgid "             # Request the properties from the bluetooth adapter\n"
msgstr "             # De Bluetooth-Koort ehr Egenschappen affragen\n"

#. +> trunk stable
#: solid-bluetooth.cpp:407
