#~ msgstr "WPA-Verslöteln \"%1\" nich begäng"

#~ msgid "Unimplemented auth scheme '%1'"
#~ msgstr "ID-Pröövschema \"%1\" nich inbuut"

#~ msgid "Syntax Error: Unknown object '%1'"
#~ msgstr "Syntaxfehler: Objekt \"%1\" is nich begäng."

#~ msgid "Syntax Error: Unknown command group '%1'"
#~ msgstr "Syntaxfehler: Befehlkoppel \"%1\" is nich begäng"

#~ msgid "Error: %1 does not have the interface StorageAccess."
#~ msgstr "Fehler: \"%1\" hett keen Koppelsteed \"StorageAccess\"."

#~ msgid "Error: %1 does not have the interface OpticalDrive."
#~ msgstr "Fehler: \"%1\" hett keen Koppelsteed \"OpticalDrive\"."

#~ msgid "Unsupported suspend method: %1"
#~ msgstr "Utsettmetood \"%1\" nich ünnerstütt"

#~ msgid "Unsupported scheme: %1"
#~ msgstr "Profil \"%1\" nich begäng"

#~ msgid "Unsupported cpufreq policy: %1"
#~ msgstr "Perzesserfrequenz-Regel \"%1\" nich ünnerstütt"

#~ msgid "networking: is enabled"
#~ msgstr "Nettwarkfunkschonen: anmaakt"

#~ msgid "networking: is not enabled"
#~ msgstr "Nettwarkfunkschonen: nich anmaakt"

#~ msgid "wireless: is enabled"
#~ msgstr "Funknettwark: anmaakt"

#~ msgid "wireless: is not enabled"
#~ msgstr "Funknettwark: nich anmaakt"

