#: solid-bluetooth.cpp:728
#, kde-format
msgid "Info: %1"
msgstr "Info: %1"

#~ msgid "             # Query the name from the remote device 'remote-mac' with 'ubi'\n"
#~ msgstr "             # Den Naam vun de Reedschap \"remote-mac\" mit \"UBI\" affragen\n"

#~ msgid "             # Query information about the bluetooth adapter/interface with 'ubi'\n"
#~ msgstr "             # Informatschonen över de Bluetooth-Koort oder de -Koppelsteed \"UBI\" affragen\n"

#~ msgid ""
#~ "             # Set the bluetooth adapter name.\n"
#~ "             # Set the bluetooth adapter mode. Where 'value' is one of:\n"
#~ "             # off|connectable|discoverable\n"
#~ msgstr ""
#~ "             # Den Naam för de Bluetooth-Koort fastleggen\n"
#~ "             # De Bedriefoort för de Bluetooth-Koort fastleggen. För \"value\" kannst Du bruken:\n"
#~ "             # \"off\", \"connectable\" oder \"discoverable\"\n"

#~ msgid "             # Scan for bluetooth remote devices.\n"
#~ msgstr "             # Na feern Bluetooth-Reedschappen kieken\n"

#~ msgid "             # List configured input devices.\n"
#~ msgstr "             # Instellte Ingaavreedschappen oplisten\n"

#~ msgid ""
#~ "             # Setup bluetooth input device.\n"
#~ "             # Remove configuration of remote input device.\n"
#~ "             # Connect or disconnect bluetooth input device.\n"
#~ msgstr ""
#~ "             # Bluetooth-Ingaavreedschap inrichten\n"
#~ "             # Instellen för feern Ingaavreedschap wegmaken\n"
#~ "             # Bluetooth-Ingaavreedschap to- oder afkoppeln\n"

#~ msgid ""
#~ "             # Create bonding (pairing) with bluetooth remote device.\n"
#~ "             # Remove bonding of bluetooth remote device.\n"
#~ "             # Check for bonding of bluetooth remote device.\n"
#~ msgstr ""
#~ "             # En feern Bluetooth-Reedschap anbinnen\n"
#~ "             # Anbinnen vun en feern Bluetooth-Reedschap opheven\n"
#~ "             # Anbinnen vun en feern Bluetooth-Reedschap pröven\n"

#~ msgid "Domain (see --commands)"
#~ msgstr "Kategorie (kiek bi --commands)"

#~ msgid ""
#~ "             # List the hardware available in the system.\n"
#~ "             # - If the 'nonportableinfo' option is specified, the device\n"
#~ "             # properties are listed (be careful, in this case property names\n"
#~ "             # are backend dependent),\n"
#~ "             # - If the 'details' option is specified, the device interfaces\n"
#~ "             # and the corresponding properties are listed in a platform\n"
#~ "             # neutral fashion,\n"
#~ "             # - Otherwise only device UDIs are listed.\n"
#~ msgstr ""
#~ "             # Verföögbor Systeem-Hardware oplisten\n"
#~ "             # - Is de Optschoon \"nonportableinfo\" angeven, warrt de\n"
#~ "             #   Reedschap-Egenschappen wiest (bacht: denn hangt de\n"
#~ "             #   Egenschapnaams vun't Hülpprogramm af!).\n"
#~ "             # - Bi \"details\" warrt de Reedschap-Koppelsteden un ehr\n"
#~ "             #   tohören Egenschappen op en Wies oplist, de nich\n"
#~ "             #   vun't Systeem afhangt.\n"
#~ "             # - Anners warrt bloots de Reedschap-UDIs oplist.\n"

#~ msgid ""
#~ "             # Display all the interfaces and properties of the device\n"
#~ "             # corresponding to 'udi' in a platform neutral fashion.\n"
#~ msgstr ""
#~ "             # All Koppelsteden un Egenschappen vun de Reedschap wiesen,\n"
#~ "             # de \"UDI\" tohöört, op en Wies, de nich vun't Systeem afhangt\n"

#~ msgid ""
#~ "             # Display all the properties of the device corresponding to 'udi'\n"
#~ "             # (be careful, in this case property names are backend dependent).\n"
#~ msgstr ""
#~ "             # All Koppelsteden un Egenschappen vun de Reedschap\n"
#~ "             # wiesen, de \"UDI\" tohöört (Wohrschoen: hier hangt de\n"
#~ "             # Egenschapnaams vun't Hülpprogramm af!)\n"

#~ msgid ""
#~ "             # List the UDI of devices corresponding to 'predicate'.\n"
#~ "             # - If 'parentUdi' is specified, the search is restricted to the\n"
#~ "             # branch of the corresponding device,\n"
#~ "             # - Otherwise the search is done on all the devices.\n"
#~ msgstr ""
#~ "             # De UDI vun Reedschappen wiesen, op de \"predicate\" passt\n"
#~ "             # - Is \"parentUdi\" angeven, warrt bloots de tohören\n"
#~ "             #   Reedschap-Telg dörkeken, anners all Reedschappen.\n"

#~ msgid "             # If applicable, mount the device corresponding to 'udi'.\n"
#~ msgstr "             # Wenn mööglich, de Reedschap inhangen, de \"UDI\" tohöört.\n"

#~ msgid "             # If applicable, unmount the device corresponding to 'udi'.\n"
#~ msgstr "             # Wenn mööglich, de Reedschap afhangen, de \"UDI\" tohöört.\n"

#~ msgid "             # If applicable, eject the device corresponding to 'udi'.\n"
#~ msgstr "             # Wenn mööglich, de Reedschap rutfohren, de \"UDI\" tohöört.\n"

#~ msgid ""
#~ "             # List a particular set of information regarding power management.\n"
#~ "             # - If the 'suspend' option is specified, give the list of suspend\n"
#~ "             # method supported by the system\n"
#~ "             # - If the 'scheme' option is specified, give the list of\n"
#~ "             # supported power management schemes by this system\n"
#~ "             # - If the 'cpufreq' option is specified, give the list of\n"
#~ "             # supported CPU frequency policy\n"
#~ msgstr ""
#~ "             # En Sett vun Informatschonen över de Stroomkuntrull wiesen\n"
#~ "             # - Mit \"suspend\" as Optschoon: De List vun't Systeem sien ünnerstütt\n"
#~ "             #   Utsett-Metoden\n"
#~ "             # - Mit \"scheme\": De List vun begäng Stroomkuntrull-Profilen\n"
#~ "             # - Mit \"cpufreq\": De List vun ünnerstütt Regeln för de Perzesserfrequenz\n"

#~ msgid ""
#~ "             # Set power management options of the system.\n"
#~ "             # - If the 'scheme' option is specified, the power management\n"
#~ "             # scheme set corresponds to 'value'\n"
#~ "             # - If the 'cpufreq' option is specified, the CPU frequency policy\n"
#~ "             # set corresponds to 'value'\n"
#~ msgstr ""
#~ "             # Optschonen för de Stroomkuntrull fastleggen\n"
#~ "             # - Mit \"scheme\": Dat Stroomkuntrullprofil anmaken, dat\n"
#~ "             #   \"value\" tohöört\n"
#~ "             # - Mit \"cpufreq\": De Perzesserfrequenzregel anmaken,\n"
#~ "             #   de \"value\" tohöört\n"

#~ msgid "             # Suspend the computer using the given 'method'.\n"
#~ msgstr "             # Den Reekner mit de angeven Metood utsetten laten\n"

#~ msgid "             # List the network devices present.\n"
#~ msgstr "             # De vörhannen Nettwarkreedschappen oplisten\n"

#~ msgid "             # List the networks known to the device specified by 'uni'.\n"
#~ msgstr "             # De Nettwarken oplisten, de de vun \"UNI\" angeven Reedschap kennt\n"

#~ msgid ""
#~ "             # Query whether networking features are active or not.\n"
#~ "             # - If the 'status' option is given, return whether\n"
#~ "             # networking is enabled for the system\n"
#~ "             # - If the 'wireless' option is is given, return whether\n"
#~ "             # wireless is enabled for the system\n"
#~ "             # - If the 'interface' option is given, print the\n"
#~ "             # properties of the network interface that 'uni' refers to.\n"
#~ "             # - If the 'network' option is given, print the\n"
#~ "             # properties of the network on 'device-uni' that 'network-uni' refers to.\n"
#~ msgstr ""
#~ "             # Anfragen, wat Nettwarkfunkschonen anmaakt sünd\n"
#~ "             # - Mit \"status\": Utgeven, wat de Nettwarkfunkschonen\n"
#~ "             #   op't Systeem anmaakt sünd\n"
#~ "             # - Mit \"wireless\": Utgeven, wat en Dratloos-Nettwark\n"
#~ "             #   för't Systeem anmaakt is\n"
#~ "             # - Mit \"interface\": De Egenschappen vun de vun \"UNI\"\n"
#~ "             #   angeven Nettwark-Reedschap utgeven\n"
#~ "             # - Mit \"network\": De Egenschappen vun't Nettwark\n"
#~ "             #   \"network-uni\" bi de Reedschap \"device-uni\" utgeven\n"

#~ msgid "             # Enable or disable networking on this system.\n"
#~ msgstr "             # De Nettwarkfunkschonen op't Systeem an- oder utmaken\n"

#~ msgid ""
#~ "             # Activate the network 'network-uni' on 'device-uni'.\n"
#~ "             # Optionally, use WEP128, open-system encryption with hex key 'key'. (Hardcoded)\n"
#~ "             # Where 'authentication' is one of:\n"
#~ "             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 'key' [open|shared]\n"
#~ "             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
#~ "             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
#~ msgstr ""
#~ "             # Nettwark \"network-uni\" op Reedschap \"device-uni\" anmaken\n"
#~ "             # Köörwies kannst Du WEP128 bruken, en Apensysteem-Verslöteln mit den Hexadezimaalslötel \"key\" (fast inbuut).\n"
#~ "             # För \"authentication\" (Identiteetprööv) laat sik disse Weerten bruken:\n"
#~ "             # - wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 'Slötel' [open|shared]\n"
#~ "             # - wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
#~ "             # \"wpaeap\" is NICH INBUUT na \"solidshell\".\n"

