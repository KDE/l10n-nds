#. +> trunk stable
#: kstart.cpp:300
msgid "KStart"
msgstr "KStart"

#. +> trunk stable
#: kstart.cpp:301
msgid ""
"Utility to launch applications with special window properties \n"
"such as iconified, maximized, a certain virtual desktop, a special decoration\n"
"and so on."
msgstr ""
"Warktüüch för dat Starten vun Programmfinstern mit besünner\n"
"Egenschappen, as minimeert, maximeert, op fastleggten Schriefdisch,\n"
"mit besünner Muster, usw."

#. +> trunk stable
#: kstart.cpp:306
msgid "(C) 1997-2000 Matthias Ettrich (ettrich@kde.org)"
msgstr "(C) 1997-2000 Matthias Ettrich (ettrich@kde.org)"

#. +> trunk stable
#: kstart.cpp:308
msgid "Matthias Ettrich"
msgstr "Matthias Ettrich"

#. +> trunk stable
#: kstart.cpp:309
msgid "David Faure"
msgstr "David Faure"

#. +> trunk stable
#: kstart.cpp:310
msgid "Richard J. Moore"
msgstr "Richard J. Moore"

#. +> trunk stable
#: kstart.cpp:317
msgid "Command to execute"
msgstr "Befehl, den Du opropen wullt"

#. +> trunk
#: kstart.cpp:318
#| msgid "Alternative to <command>: desktop file to start. DBUS service will be printed to stdout"
msgid "Alternative to <command>: desktop file to start. D-Bus service will be printed to stdout"
msgstr "Ansteed vun <command>: Schriefdischdatei, de Du opropen wullt. De D-Bus-Deenst warrt na de Standardutgaav utgeven"

#. +> trunk
#: kstart.cpp:319
msgid "Optional URL to pass <desktopfile>, when using --service"
msgstr "Köörfree: URL, de na <desktopfile> wiedergeven warrt, wenn Du \"--service\" bruukst"

#. +> trunk stable
#: kstart.cpp:321
msgid "A regular expression matching the window title"
msgstr "Reguleer Utdruck, de op den Finstertitel passt"

#. +> trunk stable
#: kstart.cpp:322
msgid ""
"A string matching the window class (WM_CLASS property)\n"
"The window class can be found out by running\n"
"'xprop | grep WM_CLASS' and clicking on a window\n"
"(use either both parts separated by a space or only the right part).\n"
"NOTE: If you specify neither window title nor window class,\n"
"then the very first window to appear will be taken;\n"
"omitting both options is NOT recommended."
msgstr ""
"En Tekenkeed, de op de Finsterklass (WM_CLASS-Egenschap) passt\n"
"Du kannst de Finsterklass rutfinnen, wenn Du \"xprop | grep WM_CLASS\"\n"
"utföhrst un op en Finster klickst (bruuk beed Delen, trennt vun en Freeteken,\n"
"oder bloots den rechten Deel).\n"
"Beacht: Wenn Du keen Finstertitel oder Finsterklass angiffst, warrt dat eerste\n"
"Finster nahmen, dat opdukt. Dat is also nich anraadt, dat Een keen Optschoon angifft."

#. +> trunk stable
#: kstart.cpp:329
msgid "Desktop on which to make the window appear"
msgstr "Schriefdisch, op den dat Finster opduken schall"

#. +> trunk stable
#: kstart.cpp:330
msgid ""
"Make the window appear on the desktop that was active\n"
"when starting the application"
msgstr ""
"Finster op den Schriefdisch opduken laten, de bi den\n"
"Programmstart anamaakt weer."

#. +> trunk stable
#: kstart.cpp:331
msgid "Make the window appear on all desktops"
msgstr "Finster op all Schriefdischen opduken laten"

#. +> trunk stable
#: kstart.cpp:332
msgid "Iconify the window"
msgstr "Finster minimeren"

#. +> trunk stable
#: kstart.cpp:333
msgid "Maximize the window"
msgstr "Finster maximeren"

#. +> trunk stable
#: kstart.cpp:334
msgid "Maximize the window vertically"
msgstr "Finster piel maximeren"

#. +> trunk stable
#: kstart.cpp:335
msgid "Maximize the window horizontally"
msgstr "Finster kimmig maximeren"

#. +> trunk stable
#: kstart.cpp:336
msgid "Show window fullscreen"
msgstr "Heelschirm-Bedrief"

#. +> trunk stable
#: kstart.cpp:337
msgid ""
"The window type: Normal, Desktop, Dock, Toolbar, \n"
"Menu, Dialog, TopMenu or Override"
msgstr ""
"De Finstertyp: \"Normal\", \"Desktop\" (Schriefdisch), \"Dock\" (andockt),\n"
"\"Toolbar\" (Warktüüchbalken), \"Menu\" (Menü), \"Dialog\" (Dialoog),\n"
"\"TopMenu\" (Menü baven) oder \"Override\" (Fastleggen)"

#. +> trunk stable
#: kstart.cpp:338
msgid ""
"Jump to the window even if it is started on a \n"
"different virtual desktop"
msgstr ""
"Na dat Finster jumpen, ok wenn dat op en anner\n"
"Schriefdisch opdukt"

#. +> trunk stable
#: kstart.cpp:341
msgid "Try to keep the window above other windows"
msgstr "Finster vörn hollen, wenn mööglich"

#. +> trunk stable
#: kstart.cpp:343
msgid "Try to keep the window below other windows"
msgstr "Finster achtern hollen, wenn mööglich"

#. +> trunk stable
#: kstart.cpp:344
msgid "The window does not get an entry in the taskbar"
msgstr "Finster kriggt keen Indrag op den Programmbalken"

#. +> trunk stable
#: kstart.cpp:345
msgid "The window does not get an entry on the pager"
msgstr "Finster kriggt keen Indrag op de Schriefdisch-Översicht"

#. +> trunk stable
#: kstart.cpp:346
msgid "The window is sent to the system tray in Kicker"
msgstr "Finster dukt in den Systeemafsnitt vun't Paneel op"

#. +> trunk stable
#: kstart.cpp:359
msgid "No command specified"
msgstr "Keen Befehl angeven"

