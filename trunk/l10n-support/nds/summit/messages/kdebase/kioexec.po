#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KIO Exec - maakt Dateien op anner Reekners op, luurt op Ännern, fraagt ehr hoochlaadt warrt"

#. +> trunk stable
#: main.cpp:54
msgid "'command' expected.\n"
msgstr "\"command\" verwacht.\n"

#. +> trunk stable
#: main.cpp:83
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"De URL %1\n"
"gellt nich"

#. +> trunk stable
#: main.cpp:85
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"URL %1\n"
"op anner Reekner dörv nich mit --tempfile bruukt warrn"

#. +> trunk stable
#: main.cpp:218
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"De sachens temporere Datei\n"
"%1\n"
"wöör ännert.\n"
"Wullt Du ehr liekers wegdoon?"

