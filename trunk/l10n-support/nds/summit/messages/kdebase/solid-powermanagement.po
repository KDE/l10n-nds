msgid "solid-powermanagement"
msgstr "solid-powermanagement"

#. +> trunk stable
#: solid-powermanagement.cpp:51
msgid "KDE tool for querying and controlling your power management options from the command line"
msgstr "KDE-Konsoolprogramm för't Affragen un Stüern vun Dien Stroomkuntrull-Funkschonen"

#. +> trunk stable
#: solid-powermanagement.cpp:163
msgid "Syntax Error: Not enough arguments"
msgstr "Syntaxfehler: Nich noog Argumenten"

#. +> trunk stable
#: solid-powermanagement.cpp:169
msgid "Syntax Error: Too many arguments"
msgstr "Syntaxfehler: To vele Argumenten"

#. +> trunk stable
#: solid-powermanagement.cpp:181
msgid "Show available commands"
msgstr "Verföögbor Befehlen wiesen"

#. +> trunk stable
#: solid-powermanagement.cpp:183
msgid "Command (see --commands)"
msgstr "Befehl (kiek bi --commands)"

#. +> trunk stable
#: solid-powermanagement.cpp:185
msgid "Arguments for command"
msgstr "Argumenten för Befehl"

#. +> trunk stable
#: solid-powermanagement.cpp:197
msgid "Syntax:"
msgstr "Syntax:"

#. +> trunk stable
#: solid-powermanagement.cpp:200
msgid ""
"             # List a particular set of information regarding power management.\n"
"             # - If the 'suspend' option is specified, give the list of suspend\n"
"             # method supported by the system\n"
"             # - If the 'scheme' option is specified, give the list of\n"
"             # supported power management schemes by this system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policy\n"
msgstr ""
"             # En besünner Sett vun Informatschonen över de Stroomkuntrull wiesen\n"
"             # - Mit \"suspend\" as Optschoon: De List vun dat Systeem sien begäng\n"
"             #   Utsett-Metoden wiesen             # - Mit \"scheme\": De List vun begäng Stroomkuntrull-Profilen wiesen\n"
"             # - Mit \"cpufreq\": De List vun begäng Regeln för de Perzesserfrequenz wiesen\n"

#. +> trunk stable
#: solid-powermanagement.cpp:209
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'scheme' option is specified, the power management\n"
"             # scheme set corresponds to 'value'\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # Optschonen för de Stroomkuntrull fastleggen\n"
"             # - Mit \"scheme\": Dat Stroomkuntrullprofil anmaken, dat \"value\" tohöört\n"
"             # - Mit \"cpufreq\": De Perzesserfrequenzregel anmaken, de \"value\" tohöört\n"

#. +> trunk stable
#: solid-powermanagement.cpp:216
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # Den Reekner mit de angeven Metood utsetten laten\n"

#. +> trunk stable
#: solid-powermanagement.cpp:219
msgid ""
"             # Set and get brightness options of the system.\n"
"             # - If the 'set' option is specified, the brightness is\n"
"             # set to 'value' (as a percentage)\n"
"             # - If the 'get' option is specified, the current brightness\n"
"             # is returned (as a percentage)'\n"
msgstr ""
"             # De Systeem-Helligkeitoptschonen affragen un fastleggen.\n"
"             # - Mit de \"set\"-Optschoon warrt de Helligkeit\n"
"             # op \"value\" fastleggt (Perzentweert) \n"
"             # - Mit de \"get\"-Optschoon warrt de aktuelle Helligkeit-\n"
"             # weert torüchgeven (Perzentweert) \n"

