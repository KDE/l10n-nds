#. +> trunk
#: windowsrunner.cpp:36
msgid "Finds windows whose name, window class or window role match :q:. It is possible to interact with the windows by using one of the following keywords: activate, close, min(imize), max(imize), fullscreen, shade, keep above and keep below."
msgstr "Söcht na Finstern, bi de :q: op ehr Naam, Finsterklass oder Finsterrull passen deit. Du kannst de Finstern ok Befehlen tostüern: »active«, »close«, »min(imize)«, »max(imize)«, »fullscreen«, »shade«, »keep above« un »keep below«."

#. +> trunk
#: windowsrunner.cpp:39
msgid "Finds windows which are on desktop named :q:It is possible to interact with the windows by using one of the following keywords: activate, close, min(imize), max(imize), fullscreen, shade, keep above and keep below."
msgstr "Söcht na Finstern, de op den Schriefdisch :q: liggt. Du kannst de Finstern ok Befehlen tostüern: »active«, »close«, »min(imize)«, »max(imize)«, »fullscreen«, »shade«, »keep above« un »keep below«."

#. +> trunk
#: windowsrunner.cpp:42
msgid "Switch to desktop named :q:"
msgstr "Na den Schriefdisch :q: wesseln"

#. +> trunk
#: windowsrunner.cpp:43 windowsrunner.cpp:139
msgctxt "Note this is a KRunner keyword"
msgid "window"
msgstr "Finster"

#. +> trunk
#: windowsrunner.cpp:44
msgid "Lists all windows and allows to activate them. With name=, class=, role= and desktop= the list can be reduced to windows matching these restrictions. It is possible to interact with the windows by using one of the following keywords: activate, close, min(imize), max(imize), fullscreen, shade, keep above and keep below."
msgstr "List all Finstern op, un Du kannst de denn ok bewerken. Mit »name=«, »class=«, »role=« un »desktop« kannst Du de List op de Finstern ingrenzen, op de de Bedingen passt. Du kannst de Finstern ok Befehlen tostüern: »active«, »close«, »min(imize)«, »max(imize)«, »fullscreen«, »shade«, »keep above« un »keep below«."

#. +> trunk
#: windowsrunner.cpp:49 windowsrunner.cpp:155 windowsrunner.cpp:217
msgctxt "Note this is a KRunner keyword"
msgid "desktop"
msgstr "Schriefdisch"

#. +> trunk
#: windowsrunner.cpp:50
msgid "Lists all other desktops and allows to switch to them."
msgstr "List all anner Schriefdischen op un lett Di dor ok hengahn."

