#. i18n: ectx: property (text), item, widget (QComboBox, filterType)
#. +> trunk
#: folderviewFilterConfig.ui:39
msgid "Hide Files Matching"
msgstr "Passen Dateien versteken"

#. i18n: ectx: property (text), widget (QPushButton, selectAll)
#. +> trunk
#: folderviewFilterConfig.ui:126
msgid "Select All"
msgstr "All utsöken"

#. i18n: ectx: property (text), widget (QPushButton, deselectAll)
#. +> trunk
#: folderviewFilterConfig.ui:133
msgid "Deselect All"
msgstr "Köör opheven"

#. i18n: ectx: property (clickMessage), widget (KLineEdit, searchMimetype)
#. +> trunk
#: folderviewFilterConfig.ui:157
msgid "Search file type"
msgstr "Dateityp söken"

#. i18n: ectx: property (text), widget (QLabel, fileTypesLabel)
#. +> trunk
#: folderviewFilterConfig.ui:167
msgid "File types:"
msgstr "Dateitypen:"

#. i18n: ectx: property (text), widget (QLabel, fileNameLabel)
#. +> trunk
#: folderviewFilterConfig.ui:174
msgid "File name pattern:"
msgstr "Dateinaam-Muster:"

#. i18n: ectx: property (toolTip), widget (KLineEdit, filterFilesPattern)
#. +> trunk
#: folderviewFilterConfig.ui:187
msgid "Space-separated list of extensions, e.g. *.txt *.od*"
msgstr "Mit Freetekens trennte List vun Verwiedern, a.B. »*.txt *.od*«"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, filterFilesPattern)
#. +> trunk
#: folderviewFilterConfig.ui:190
msgid "Space-separated list of extensions, e.g. *.txt *.od* to display only office- and text-files"
msgstr "Mit Freetekens trennte List vun Verwiedern, a.B. »*.txt *.od*«, wenn Du bloots OpenOffice- un Textdateien wiesen wullt"

#. i18n: ectx: property (clickMessage), widget (KLineEdit, filterFilesPattern)
#. +> trunk
#: folderviewFilterConfig.ui:199
msgid "Pattern filter"
msgstr "Musterfilter"

#. i18n: ectx: property (text), widget (QRadioButton, showDesktopFolder)
#. +> trunk
#: folderviewLocationConfig.ui:16
msgid "Show the Desktop folder"
msgstr "Den Schriefdischorner wiesen"

#. i18n: ectx: property (text), widget (QLabel, warningLabel)
#. +> trunk
#: folderviewLocationConfig.ui:41
msgid ""
"<html><body><b>Note: The Desktop folder currently does not exist.<br />"
"If you select this option and click OK it will be created for you.</b></body></html>"
msgstr ""
"<html><body><b>Beacht: Opstunns gifft dat den Schriefdisch-Orner nich.<br />"
"Maakst Du dit an un klickst op \"OK\", warrt he för Di opstellt.</b></body></html>"

#. i18n: ectx: property (text), widget (QRadioButton, showPlace)
#. +> trunk
#: folderviewLocationConfig.ui:53
msgid "Show a Place:"
msgstr "En Steed wiesen:"

#. i18n: ectx: property (text), widget (QRadioButton, showCustomFolder)
#. +> trunk
#: folderviewLocationConfig.ui:83
msgid "Specify a folder:"
msgstr "En Orner angeven:"

#. i18n: ectx: property (clickMessage), widget (KUrlRequester, lineEdit)
#. +> trunk
#: folderviewLocationConfig.ui:114
msgid "Type a path or a URL here"
msgstr "Hier en Padd oder URL ingeven"

#. i18n: ectx: property (text), widget (QLabel, label)
#. +> trunk
#: folderviewPreviewConfig.ui:16
msgid "Check the file types you want icon previews for:"
msgstr "Söök de Dateitypen ut, för de Du Vöransichten hebben wullt:"

#. i18n: ectx: property (text), widget (QRadioButton, showDesktopFolder)
#. +> stable
#: folderviewConfig.ui:14
msgid "Show the desktop folder"
msgstr "Den Schriefdischorner wiesen"

#. i18n: ectx: property (text), widget (QRadioButton, showCustomFolder)
#. +> stable
#: folderviewConfig.ui:21
msgid "Show a custom folder"
msgstr "En egen Orner wiesen"

#. i18n: ectx: property (text), widget (QLabel, selectLabel)
#. +> stable
#: folderviewConfig.ui:50
msgid "Select:"
msgstr "Utsöken:"

#. i18n: ectx: property (text), widget (QLabel, filterLabel)
#. +> stable
#: folderviewConfig.ui:70
msgid "Filter"
msgstr "Filter"

#. i18n: ectx: property (toolTip), widget (KLineEdit, filterFiles)
#. +> stable
#: folderviewConfig.ui:93
msgid "Space-separated list of extensions, e.g. *.txt * .od*"
msgstr "Mit Freetekens trennte List vun Verwiedern, a.B. »*.txt *.od*«"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, filterFiles)
#. +> stable
#: folderviewConfig.ui:96
msgid "Space-separated list of extensions, e.g. *.txt * .od* to display only office- and text-files"
msgstr "Mit Freetekens trennte List vun Verwiedern, a.B. »*.txt *.od*«, wenn Du bloots OpenOffice- un Textdateien wiesen wullt"

