#: libavogadro-kalzium/src/tools/aligntool.cpp:56
msgid ""
"Align Molecules\n"
"\n"
"Left Mouse: \tSelect up to two atoms.\n"
"\tThe first atom is centered at the origin.\n"
"\tThe second atom is aligned to the selected axis.\n"
"Right Mouse: \tReset alignment."
msgstr ""
"Molekölen utrichten\n"
"\n"
"Linke Muustast: \tKöör bet to twee Atomen.\n"
"\tDat eerste Atom warrt bi den Oorsprung in de Merrn utricht.\n"
"\tDat twete Atom warrt na de köört Ass utricht.\n"
"Rechte Muustast: \tUtrichten torüchsetten."

