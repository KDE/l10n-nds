msgid "Osculating circle of this curve"
msgstr "Smiegkrink vun dissen Bagen"

#. +> trunk stable
msgid "Osculating circle at this point"
msgstr "Smiegkrink an dissen Punkt"

#. +> trunk stable
msgid "Select the point..."
msgstr "Söök den Punkt ut..."

