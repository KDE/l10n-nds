#. +> trunk stable
#: tools/astrocalc.cpp:48
msgid "<QT><H2>KStars Astrocalculator</H2><P>The KStars Astrocalculator contains several <B>modules</b> which perform a variety of astronomy-related calculations.  The modules are organized into several categories: <UL><LI><B>Time calculators: </B>Convert between time systems, and predict the timing of celestial events</LI><LI><B>Coordinate converters: </B>Convert between various coordinate systems</LI><LI><B>Solar system: </B>Predict the position of any planet, from a given location on Earth at a given time</LI></UL></QT>"
msgstr "<QT><H2>KStars-Astroreekner</H2><P>KStars sien Astroreekner bargt en Reeg <B>Modulen</b>, mit de sik verscheden astronoomsch Bereken utföhren laat: <UL><LI><B>Tietreekners: </B>Ümreken twischen Tietsystemen un de Tiet vun Hevenbegeefnissen vörutseggen</LI><LI><B>Koordinatenwanneln: </B>Ümreken twischen verscheden Koordinaten-Systemen</LI><LI><B>Sünnsysteem: </B>De Positschonen vun all Planeten vörutseggen, vun en angeven Steed op de Eer to en angeven Tiet</LI></UL></QT>"

#. +> trunk stable
#: tools/astrocalc.cpp:65
msgid "<QT>Section which includes algorithms for computing time ephemeris<UL><LI><B>Julian Day:</B> Julian Day/Calendar conversion</LI><LI><B>Sidereal Time:</B> Sidereal/Universal time conversion</LI><LI><B>Almanac:</B> Rise/Set/Transit timing and position data for the Sun and Moon</LI><LI><B>Equinoxes & Solstices:</B> Equinoxes, Solstices and duration of the seasons</LI></UL></QT>"
msgstr "<QT>Astronoomsch Bereken rund de Tiet<UL><LI><B>Juliaansch Daag:</B> Ümreken twischen Juliaansch Dag un Kalenner</LI><LI><B>Steerntiet:</B> Ümreken twischen Steerntiet un Universaaltiet</LI><LI><B>Dagduer:</B> Sünnopgang, Sünnneddergang, Middagtiet un de Positschonen för disse Begeefnissen</LI><LI><B>Liekdaag un Sünnwennen:</B> Vörjohr- un Harvstanfäng, Sünnwennen un de Duer vun de Johrstieden</LI></UL></QT>"

#. +> trunk stable
#: tools/astrocalc.cpp:80
msgid "<QT>Section with algorithms for the conversion of different astronomical systems of coordinates<UL><LI><B>Galactic:</B> Galactic/Equatorial coordinates conversion</LI><LI><B>Apparent:</B> Computation of current equatorial coordinates from a given epoch</LI><LI><B>Ecliptic:</B> Ecliptic/Equatorial coordinates conversion</LI><LI><B>Horizontal:</B> Computation of azimuth and elevation for a given source, time, and location on the Earth</LI><LI><B>Angular Distance:</B> Computation of angular distance between two objects whose positions are given in equatorial coordinates</LI><LI><B>Geodetic Coords:</B> Geodetic/XYZ coordinate conversion</LI><LI><B>LSR Velocity:</B> Computation of the heliocentric, geocentric and topocentric radial velocity of a source from its LSR velocity</LI></UL></QT>"
msgstr "<QT>Afsnitt mit Ümreken twischen verscheden astronoomsch Koordinatensystemen<UL><LI><B>Galaktsch:</B> Ümreken twischen galaktsch un Äquaterkoordinaten</LI><LI><B>Sichtbor:</B> Utreken vun aktuelle Äquaterkoordinaten ut en geven Epoch</LI><LI><B>Sünnbahn:</B> Ümreken twischen Sünnbahn- un Äquaterkoordinaten</LI><LI><B>Kimm:</B> Utreken vun Azimut un Hööchde bi geven Objekt, Tiet un Standoort op de Eer</LI><LI><B>Winkelafstand:</B> Utreken vun den Winkelafstand twischen twee Objekten, de ehr Positschonen in Äquaterkoordinaten angeven sünd</LI><LI><B>Geodäätsch:</B> Ümreken twischen geodäätsch un XYZ-Koordinaten</LI><LI><B>LRS-Gauheit:</B> Utreken vun en Objekt sien heliozentersch, geozentersch un topozentersch Radiaalgauheit ut sien LRS-Gauheit</LI></UL></QT>"

#. +> trunk stable
#: tools/astrocalc.cpp:104
msgid "<QT>Section with algorithms regarding information on solar system bodies coordinates and times<UL><LI><B>Planets Coords:</B> Coordinates for the planets, moon and sun at a given time and from a given position on Earth </LI></UL></QT>"
msgstr "<QT>Afsnitt mit Ümreken vun Koordinaten vun Sünnsysteem-Objekten un Tieden<UL><LI><B>Planetenkoordinaten:</B> Koordinaten för Planeten, Maand un Sünn bi geven Tiet un Standoort op de Eer</LI></UL></QT>"

