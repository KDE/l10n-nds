#. i18n: ectx: property (text), widget (QLabel, WelcomeTitle)
#. +> trunk stable
#: wizwelcome.ui:65
msgid "Welcome to the KStars Setup Wizard"
msgstr "Willkamen bi den Inrichthölper vun KStars"

#. i18n: ectx: property (text), widget (QLabel, WelcomeText)
#. +> trunk stable
#: wizwelcome.ui:88
msgid ""
"<html><head></head><body>"
"<p>This wizard will help you set up some basic options, such as your location on Earth.</p>"
"<p></p>"
"<p>To get started, press the <span style=\" font-weight:600;\">Next</span> button.</p>"
"</body></html>"
msgstr ""
"<html><head></head><body>"
"<p>Disse Hölper ünnerstütt Di bi't Fastleggen vun en Reeg Optschonen, so as Dien Standoort op de Eer.</p>"
"<p></p>"
"<p>Klick op <span style=\" font-weight:600;\">Nakamen</span>, wenn Du anfangen wullt.</p>"
"</body></html>"

