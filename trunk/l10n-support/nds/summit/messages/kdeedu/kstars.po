#. +> trunk stable
#: kstars.kcfg:956
msgid "The color of the background."
msgstr "De Klöör vun den Achtergrund"

#. i18n: ectx: label, entry (XplanetMagnitude), group (Xplanet)
#. +> trunk stable
#: kstars.kcfg:960
msgid "Base magnitude"
msgstr "Basis-Magnituud"

