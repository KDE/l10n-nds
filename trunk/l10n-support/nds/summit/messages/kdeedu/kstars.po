#. +> trunk stable
#: addcatdialog.cpp:86
msgid "1. Type identifier.  Must be one of: 0 (star), 3 (open cluster), 4 (globular cluster), 5 (gaseous nebula), 6 (planetary nebula), 7 (supernova remnant), or 8 (galaxy)"
msgstr "1. Typbeteker:  Mutt 0 (Steern), 3 (apen Hopen), 4 (Kugelhopen), 5 (Gasnevel), 6 (Planetennevel), 7 (Supernova-Nablievels) oder 8 (Galaxie) wesen"

