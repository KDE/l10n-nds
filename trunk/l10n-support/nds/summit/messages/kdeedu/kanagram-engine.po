#. i18n: ectx: label, entry (currentCategory), group (kanagram)
#. +> trunk stable
#: kanagram.kcfg:9
msgid "This setting stores the currently selected Category."
msgstr "Mit disse Instellen kannst Du de nu utsöchte Kategorie sekern.."

#. i18n: ectx: label, entry (hintHideTime), group (kanagram)
#. +> trunk stable
#: kanagram.kcfg:13
msgid ""
"This setting allows you to set in seconds how long Kanagram's hint bubble is "
"shown."
msgstr ""
"Mit disse Instellen kannst Du de Wiesduer (in Sekunnen) vun de Tipp-Blasen "
"fastleggen."

#. i18n: ectx: label, entry (resolveTime), group (kanagram)
#. +> trunk stable
#: kanagram.kcfg:17
msgid ""
"This setting allows you to set in seconds how much time is available for "
"resolving the anagram."
msgstr ""
"Mit disse Instellen kannst Du de Tiet fastleggen, de een för't Oplösen vun't "
"Anagramm hett."

#. i18n: ectx: label, entry (scoreTime), group (kanagram)
#. +> trunk
#: kanagram.kcfg:22
msgid ""
"This setting allows you to set in seconds the time interval of the score "
"timer."
msgstr ""
"Mit disse Instellen kannst Du in Sekunnen de Töövtiet vun den Tietgever "
"fastleggen."

#. i18n: ectx: label, entry (correctAnswerScore), group (kanagram)
#. +> trunk
#: kanagram.kcfg:26
#| msgid "This setting allows you to set in seconds the time interval of the score timer."
msgid ""
"This setting allows you to set the score associated with a correct answer."
msgstr ""
"Mit disse Instellen kannst Du in Pünkt fastleggen, de en richtig Antwoort "
"tohöört."

#. i18n: ectx: label, entry (incorrectAnswerScore), group (kanagram)
#. +> trunk
#: kanagram.kcfg:30
#| msgid "This setting allows you to set in seconds the time interval of the score timer."
msgid ""
"This setting allows you to set the score associated with an incorrect answer."
msgstr ""
"Mit disse Instellen kannst Du in Pünkt fastleggen, de en falsch Antwoort "
"tohöört."

#. i18n: ectx: label, entry (revealAnswerScore), group (kanagram)
#. +> trunk
#: kanagram.kcfg:34
#| msgid "This setting allows you to set in seconds the time interval of the score timer."
msgid "This setting allows you to set the score associated with reveal answer."
msgstr ""
"Mit disse Instellen kannst Du in Pünkt fastleggen, de en Opklappen"
"tohöört."

#. i18n: ectx: label, entry (skippedWordScore), group (kanagram)
#. +> trunk
#: kanagram.kcfg:38
#| msgid "This setting allows you to set in seconds the time interval of the score timer."
msgid ""
"This setting allows you to set the score associated with a skipped word."
msgstr ""
"Mit disse Instellen kannst Du in Pünkt fastleggen, de en utlaten Woort "
"tohöört."

#. i18n: ectx: label, entry (useSounds), group (kanagram)
#. +> trunk stable
#: kanagram.kcfg:42
msgid "Turns sounds on/off."
msgstr "Maakt de Kläng an/ut."

#. i18n: ectx: label, entry (uppercaseOnly), group (kanagram)
#. +> trunk stable
#: kanagram.kcfg:46
msgid "Use uppercase."
msgstr "Grootbookstaven"

#. i18n: ectx: label, entry (enablePronunciation), group (kanagram)
#. +> trunk
#: kanagram.kcfg:50
msgid "Turns pronunciations on/off."
msgstr "Maakt Utspraken an/ut."

#. i18n: ectx: label, entry (defaultVocabulary), group (kanagram)
#. +> trunk stable
#: kanagram.kcfg:54
msgid "Set the default vocabulary"
msgstr "Den Standard-Vokavelsett fastleggen"

#. i18n: ectx: label, entry (dataLanguage), group (kanagram)
#. +> trunk stable
#: kanagram.kcfg:58
msgid "Set the default translation"
msgstr "De Standard-Översetten fastleggen"

#. +> trunk stable
#: kanagramgame.cpp:223
msgid "No hint"
msgstr "Keen Tipp"

#. +> trunk stable
#: kanagramgame.cpp:316
msgctxt "@item:inlistbox no language for that locale"
msgid "None"
msgstr "Keen"

#~ msgid "This settings stores the currently selected Category"
#~ msgstr "Mit disse Instellen kannst Du de nu utsöchte Kategorie sekern."
