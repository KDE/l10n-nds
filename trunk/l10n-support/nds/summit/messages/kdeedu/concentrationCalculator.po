#. +> trunk
#: concentrationCalculator.cpp:1191
msgid "Density cannot be zero. Invalid! Please enter a valid value!"
msgstr "De Dicht mutt nich Null wesen. Bitte giff en gellen Weert in!"

#. +> trunk
#: concentrationCalculator.cpp:1194
msgid "mass cannot be zero! Please enter valid data to correct it!"
msgstr "De Mass mutt nich Null wesen. Bitte giff en gellen Weert in!"

#. +> trunk
#: concentrationCalculator.cpp:1197
msgid "volume cannot be zero! Please enter valid data to correct it!"
msgstr "De Mengde mutt nich Null wesen. Bitte giff en gellen Weert in!"

#. +> trunk
#: concentrationCalculator.cpp:1200
msgid "Number of moles cannot be zero! Please enter valid data to correct the error!"
msgstr "De Tall vun Molen mutt nich Null wesen. Bitte giff en gellen Weert in!"

#. +> trunk
#: concentrationCalculator.cpp:1203
msgid "Molar mass of solvent is zero! Please correct it!"
msgstr "De molar Mass vun de Lösen is Null. Bitte richt dat!"

#. +> trunk
#: concentrationCalculator.cpp:1206
msgid "Number of equivalents is zero. Cannot calculate equivalent mass!"
msgstr "De Tall vun Äquivalenten is Null. Äquivalentmass lett sik nich utreken."

#. +> trunk
#: concentrationCalculator.cpp:1209
msgid "Concentration is zero! Please correct it!"
msgstr "De Verdelendicht is Null. Bitte richt dat!"

#. +> trunk
#: concentrationCalculator.cpp:1212
msgid "Insufficient data! to calculate the required, please specify normality!"
msgstr "Leeg Daten! För't Utreken bitte de Äquivalentverdelendicht angeven."

#. +> trunk
#: concentrationCalculator.cpp:1215
msgid "Insufficient data, specify molarity / molefraction / molality to calculate!"
msgstr "Leeg Daten. För't Utreken warrt en Molariteet, Molenbrook oder Molaliteet bruukt."

#. +> trunk
#: concentrationCalculator.cpp:1218
msgid "amount specified in moles, cannot calculate molar/equivalent masses! Specify mass/volume"
msgstr "Mengde in Molen angeven. Molar-/Äquivalentmass lett sik nich utreken. Bitte Mass/Mengde angeven."

#. +> trunk
#: concentrationCalculator.cpp:1221
msgid "You can calculate the molar mass of solvent only if mole fraction is specified!"
msgstr "Molarmass vun Lösen lett sik bloots mit angeven Molenbrook (Mengdenandeel) utreken."

#. +> trunk
#: concentrationCalculator.cpp:1224
msgid "molar mass cannot be zero, please correct it!"
msgstr "De molare Mass mutt nich Null wesen. Bitte richt dat!"

#. +> trunk
#: concentrationCalculator.cpp:1227
msgid "Equivalent mass cannot be zero, please correct it!"
msgstr "De Äquivalentmass mutt nich Null wesen. Bitte richt dat!"
