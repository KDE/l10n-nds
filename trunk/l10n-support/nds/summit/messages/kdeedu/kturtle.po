msgstr "Na den Befehl \"lehr\" wöör en Naam för en Befehl verwacht"

#. +> trunk stable
#: interpreter/parser.cpp:244
#, kde-format
msgid "You cannot put '%1' here!"
msgstr "Du kannst \"%1\" hier nich bruken!"

#. +> trunk stable
#: interpreter/parser.cpp:280
msgid "Text string was not properly closed, expected a double quote, ' \" ' to close the string"
msgstr "Texttekenkeed wöör nich propper afslaten, en Goosfööt-Teken »\"« wöör för't Enn verwacht"

#. +> trunk stable
#: interpreter/parser.cpp:639
msgid "'for' was called wrongly"
msgstr "Leeg Oproop vun \"vun\""

#. +> trunk stable
#: interpreter/parser.cpp:701
