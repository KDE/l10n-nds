#. i18n: ectx: property (text), widget (QLabel, label_dragLocation)
#. +> trunk stable
#: src/lib/MarbleNavigationSettingsWidget.ui:33
msgid "&Drag location:"
msgstr "Steed &trecken:"

#. i18n: ectx: property (toolTip), widget (QComboBox, kcfg_dragLocation)
#. +> trunk stable
#: src/lib/MarbleNavigationSettingsWidget.ui:50
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">While dragging the mouse there are two standard behaviours when dealing with a virtual globe:</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The location below mouse pointer will follow the cursor exactly: As a result e.g. the north pole will not stay at the top which can lead to confusion. By default Marble makes sure that north is always up which results in a dragging behaviour where the location below the mouse pointer slightly \"detaches\" from the cursor. </p>"
"</body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Bi't Trecken mit de Muus gifft dat twee Standardbedregen för den Globus:</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">De Oort ünner den Muuswieser geiht den Wieser nipp un nau na. Dat bedüüdt a.B., dat de Noordpool nich baven blifft, wat Een villicht dörenannerbringen kann. Standardwies höllt Marble den Noordpool man jümmers baven. Dat bedüüdt bi't Trecken en lütten Verscheel twischen den Oort ünner den Muuswieser un den Wieser. </p>"
"</body></html>"

#. i18n: ectx: property (text), item, widget (QComboBox, kcfg_dragLocation)
#. +> trunk stable
#: src/lib/MarbleNavigationSettingsWidget.ui:54
msgid "Keep planet axis vertically"
msgstr "Planetenass pielrecht wohren"

#. i18n: ectx: property (text), item, widget (QComboBox, kcfg_dragLocation)
#. +> trunk stable
#: src/lib/MarbleNavigationSettingsWidget.ui:59
msgid "Follow mouse pointer"
msgstr "Muuswieser nagahn"

#. i18n: ectx: property (text), widget (QLabel, label_onStartup)
#. +> trunk stable
#: src/lib/MarbleNavigationSettingsWidget.ui:79
msgid "&On Startup:"
msgstr "&Bi't Starten:"

#. i18n: ectx: property (toolTip), widget (QComboBox, kcfg_onStartup)
#. +> trunk stable
#: src/lib/MarbleNavigationSettingsWidget.ui:92
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">By default Marble will display the home location immediately after the application has started. As an alternative it can also show the last position that was active when the user left the application. </p>"
"</body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Marble wiest na den Programmstart standardwies direktemang den Heimatoort. Een kann aver ok fastleggen, dat de Oort wiest warrt, de ehr't verleden Utmaken ankeken wöör. </p>"
"</body></html>"

#. i18n: ectx: property (text), item, widget (QComboBox, kcfg_onStartup)
#. +> trunk stable
#: src/lib/MarbleNavigationSettingsWidget.ui:96
msgid "Show Home Location"
msgstr "Heimatoort wiesen"

#. i18n: ectx: property (text), item, widget (QComboBox, kcfg_onStartup)
#. +> trunk stable
#: src/lib/MarbleNavigationSettingsWidget.ui:101
msgid "Return to last location visited"
msgstr "Na den tolest ankeken Oort torüchgahn"

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_animateTargetVoyage)
#. +> trunk stable
#: src/lib/MarbleNavigationSettingsWidget.ui:114
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">When searching for a location Marble can either move instantly to the new location or it can show a travel animation from the previous place to the new place.</p>"
"</body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Wielt de Öördsöök kann Marble den niegen Oort direktemang anstüern, oder en Teelflaag vun de verleden na de niege Steed wiesen .</p>"
"</body></html>"

