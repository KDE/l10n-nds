msgstr "Kaakpunkt"

#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 8
#. +> trunk stable
#: rc.cpp:994
msgid "Melting point"
msgstr "Smöltpunkt"

#. i18n: tag name
#. i18n: file data/knowledge.xml line 12
#. +> trunk stable
#: rc.cpp:997
msgid "Chemical Symbol"
msgstr "Cheemsch Symbool"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 13
#. +> trunk stable
#: rc.cpp:1000
msgid "One, two, or three letter abbreviation; set through international convention."
msgstr "Afkörten mit een, twee oder dree Bookstaven, warrt vun internatschonale Konventschonen fastleggt."

#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 15
#. i18n: tag name
#. i18n: file data/knowledge.xml line 27
#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 117
#. +> trunk stable
#: rc.cpp:1003 rc.cpp:1018 rc.cpp:1153
msgid "Element"
msgstr "Element"

#. i18n: tag name
#. i18n: file data/knowledge.xml line 19
#. +> trunk stable
#: rc.cpp:1006
msgid "Chromatography"
msgstr "Kromatografie"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 20
#. +> trunk stable
#: rc.cpp:1009
msgid "Matter separation in a moving medium (mobile phase) through differentiated absorption on a static medium (stationary phase)."
msgstr "Scheden vun Stoffen binnen en beweegt Medium (mobile Faas) dör verscheden Bedregen bi't Anlagern (Adsorptschoon) na en fast Medium (fast Faas)."

#. i18n: tag name
#. i18n: file data/knowledge.xml line 23
#. +> trunk stable
#: rc.cpp:1012
msgid "Distillation"
msgstr "Destillatschoon"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 24
#. +> trunk stable
#: rc.cpp:1015
msgid "Separation of a liquid solution (homogeneous mix) into its components through evaporation and condensation. In a fractionary distillation the process is repeated several times in a column."
msgstr "Optrennen vun en fleten Lösen (egale Mischen) in ehr Komponenten dör Verdampen un nakamen Kondenseren. Bi en frakschonell Destillatschoon wedderhaalt sik de Perzess binnen en Süül mehrfach."

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 28
#. +> trunk stable
#: rc.cpp:1021
msgid "Matter that cannot be broken down into simpler matter. Chemical elements are cornerstones of Materials. Elements consist of atoms that consist of a nucleus of positive protons, neutral neutrons, and a shell of electrons."
msgstr "Stoff, de sik nich na eenfacher Stoffen delen lett. All Stoffen sünd ut cheemsch Elementen un de Elementen wedder ut Atomen opbuut. Atomen bargt en Karn ut positiv Protonen un neutraal Neutronen un en Schell ut Elektronen."

#. i18n: tag name
#. i18n: file data/knowledge.xml line 31
#. +> trunk stable
#: rc.cpp:1024
msgid "Emulsion"
msgstr "Mischflaat"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 32
#. +> trunk stable
#: rc.cpp:1027
msgid "Heterogeneous mix of two liquids."
msgstr "Unegaal Mischen vun twee Flaten."

#. i18n: tag name
#. i18n: file data/knowledge.xml line 35
#. +> trunk stable
#: rc.cpp:1030
msgid "Extraction"
msgstr "Extrakschoon"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 36
#. +> trunk stable
#: rc.cpp:1033
msgid "Processing a homogeneous or heterogeneous mix to get pure matter."
msgstr "Bewerken vun en egale oder unegale Mischen, dormit dor en puur Stoff bi rutkummt."

#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 38
#. i18n: tag name
#. i18n: file data/knowledge.xml line 46
#. +> trunk stable
#: rc.cpp:1036 rc.cpp:1045
msgid "Mix"
msgstr "Mischen"

#. i18n: tag name
#. i18n: file data/knowledge.xml line 42
#. +> trunk stable
#: rc.cpp:1039
msgid "Filtering"
msgstr "Filtern"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 43
#. +> trunk stable
#: rc.cpp:1042
msgid "Separation of a solid matter from a liquid matter or gaseous matter with a filter (porous separation wall)."
msgstr "Scheden vun en fast Stoff ut en Flaat oder gasig Stoff mit Hülp vun en Filter (poröös Trennwand)."

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 47
#. +> trunk stable
#: rc.cpp:1048
msgid "Matter consisting of differentiated matter, combined in non-set ratios. [i]Homogeneous mixes[/i] have a coherent look, [i]heterogeneous mixes[/i] consist of multiple phases."
msgstr "Stoff, tosamensett ut verscheden, vun enanner afgrenzte anner Stoffen, in nich nau fastleggte Proportschonen. [i]Egale Mischen[/i] seht eenheitlich ut, [i]unegale Mischen[/i] sett sik ut verscheden Fasen tosamen."

#. i18n: tag name
#. i18n: file data/knowledge.xml line 50
#. +> trunk stable
#: rc.cpp:1051
msgid "Accuracy"
msgstr "Nauigkeit"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 51
#. +> trunk stable
#: rc.cpp:1054
msgid "Consisting of accidental and systematic errors."
msgstr "Besteiht ut tofällige un systemaatsche Fehlers."

#. i18n: tag name
#. i18n: file data/knowledge.xml line 54
#. +> trunk stable
#: rc.cpp:1057
msgid "Law of Conservation of Mass"
msgstr "Gesett över dat Wohren vun de Mass"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 55
#. +> trunk stable
#: rc.cpp:1060
msgid "During a chemical reaction mass is neither lost nor gained. The sum mass of the material going into the reaction equals the sum of the mass of the products of the reaction."
msgstr "Wielt en cheemsch Reakschoon kummt keen Mass weg oder dor opto. De Massensumm vun de Stoffen vör de Reakschoon is liek as de Massensumm vun de Produkten achteran."

#. i18n: tag name
#. i18n: file data/knowledge.xml line 58
#. +> trunk stable
#: rc.cpp:1063
msgid "Law of multiple proportions"
msgstr "Gesett vun de Proportschonen"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 59
#. +> trunk stable
#: rc.cpp:1066
msgid "An alloy always contains the same elements in the same mass ratio. Should two or more elements bind together then the mass ratio is constant."
msgstr "En Legeren bargt jümmers de sülven Elementen in de sülven Massandelen. Wenn sik twee oder mehr Elementen verbindt, blievt de Massandelen de sülve."

#. i18n: tag name
#. i18n: file data/knowledge.xml line 62
#. +> trunk stable
#: rc.cpp:1069
msgid "Crystallization"
msgstr "Kristallisatschoon"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 63
#. +> trunk stable
#: rc.cpp:1072
msgid "Separation of solid, crystalline matter from a solution, or the liquid or gaseous phases."
msgstr "Scheden vun fast, kristallig Stoff ut en Lösen oder ut sien fleten oder gasig Faas."

#. i18n: tag name
#. i18n: file data/knowledge.xml line 66
#. +> trunk stable
#: rc.cpp:1075
msgid "Solution"
msgstr "Lösen"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 67
