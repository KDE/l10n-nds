#. +> trunk stable
#: concentrationCalculator.cpp:1233
msgid "Density cannot be zero, please enter a valid value."
msgstr "De Dicht mutt nich Null wesen. Bitte giff en gellen Weert in."

#. +> trunk stable
#: concentrationCalculator.cpp:1236
msgid "Mass cannot be zero, please enter a valid value."
msgstr "De Mass mutt nich Null wesen. Bitte giff en gellen Weert in."

#. +> trunk stable
#: concentrationCalculator.cpp:1239
msgid "Volume cannot be zero, please enter a valid value."
msgstr "Dat Volumen mutt nich Null wesen. Bitte giff en gellen Weert in."

#. +> trunk stable
#: concentrationCalculator.cpp:1242
msgid "Number of moles cannot be zero, please enter a valid value."
msgstr "De Tall vun Molen mutt nich Null wesen. Bitte giff en gellen Weert in."

#. +> trunk stable
#: concentrationCalculator.cpp:1245
msgid "Molar mass of solvent is zero, please enter a valid value."
msgstr "De Molarmass vun't Löösmiddel is Null. Bitte giff en gellen Weert in."

#. +> trunk stable
#: concentrationCalculator.cpp:1248
msgid "Number of equivalents is zero - cannot calculate equivalent mass."
msgstr "De Tall vun Äquivalenten is Null. Äquivalentmass lett sik nich utreken."

#. +> trunk stable
#: concentrationCalculator.cpp:1251
msgid "Concentration is zero, please enter a valid value."
msgstr "De Konzentreren is Null. Bitte giff en gellen Weert in."

#. +> trunk stable
#: concentrationCalculator.cpp:1254
msgid "Insufficient data to calculate the required value, please specify normality."
msgstr "Nich noog Daten. För't Utreken vun den Weert bitte de Äquivalentkonzentreren („Normaliteet“) angeven."

#. +> trunk stable
#: concentrationCalculator.cpp:1257
msgid "Insufficient data, please specify molarity / mole fraction / molality to calculate."
msgstr "Nich noog Daten. För't Utreken bitte en Molariteet, Molenbrook oder Molaliteet angeven."

#. +> trunk stable
#: concentrationCalculator.cpp:1260
msgid "Amount is specified in moles, cannot calculate molar/equivalent masses. Please specify mass/volume."
msgstr "Mengde wöör in Molen angeven. Molar-/Äquivalentmassen laat sik nich utreken. Bitte Mass oder Volumen angeven."

#. +> trunk stable
#: concentrationCalculator.cpp:1263
msgid "You can only calculate the molar mass of a solvent if the mole fraction is specified."
msgstr "De Molarmass vun't Löösmiddel lett sik bloots bi angeven Molenbrook (Mengdenandeel) utreken."

#. +> trunk stable
#: concentrationCalculator.cpp:1266
msgid "Molar mass cannot be zero, please enter a valid value."
msgstr "De Molarmass mutt nich Null wesen. Bitte giff en gellen Weert in."

#. +> trunk stable
#: concentrationCalculator.cpp:1269
msgid "Equivalent mass cannot be zero, please enter a valid value."
msgstr "De Äquivalentmass mutt nich Null wesen. Bitte giff en gellen Weert in."

