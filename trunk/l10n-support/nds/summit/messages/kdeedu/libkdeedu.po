#~ msgid "Helium"
#~ msgstr "Helium"

#~ msgid "The Greek word for the sun was 'helios'"
#~ msgstr "Dat greeksche Woort för de Sünn weer \"helios\""

#~ msgid "Lithium"
#~ msgstr "Lithium"

