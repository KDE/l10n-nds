#: new-printer.ui:538
msgid "Provide PPD file"
msgstr "PPD-Datei praatstellen"

#. i18n: ectx: property (text), widget (QLabel, label_28)
#. +> trunk
#: new-printer.ui:545
msgid "<qt>PostScript Printer Description (PPD) files can often be found on the driver disk that comes with the printer. For PostScript printers they are often part of the Windows<sup>®</sup> driver.</qt>"
msgstr "<qt>PostScript-Druckerbeschrieven (PPD-Dateien) gifft dat faken op de Schiev mit Drievers, de mit den Drucker utlevert warrt. Bi PostScript-Druckers sünd se faken Deel vun den Windows<sup>®</sup>-Driever.</qt>"

