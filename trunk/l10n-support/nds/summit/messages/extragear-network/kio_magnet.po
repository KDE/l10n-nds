#. +> trunk stable
#: dbushandler.cpp:87
msgid "The Web share for magnet-links is disabled.         You can set it up at settings:/network-and-connectivity/sharing"
msgstr "De Nettfreegaav för Magnetlinks is utmaakt. Du kannst se ünner \"Instellen:/Nettwark un Verbinnen/Freegaav\" inrichten."

#. +> trunk stable
#: dbushandler.cpp:106
msgid "Cannot start process for KTorrent.                           This should not happen, even if KTorrent is not installed.                           Check your machines resources and limits."
msgstr "Perzess för KTorrent lett sik nich starten. Dit schull nich vörkamen, ok wenn KTorrent nich installeert is. Prööv de Reeknerleisten un Systeemvörutsetten."

#. +> trunk stable
#: dbushandler.cpp:133
#, kde-format
msgid "Could not connect to KTorrent via DBus                                     after %1 seconds. Is it broken?"
msgstr "KTorrent na %1 Sekunnen nich över DBus tokoppelt. Is dor wat schaadhaftig?"

#. +> trunk stable
#: dbushandler.cpp:151
msgid "Could not get the group list, do you have a compatible KTorrent version running?"
msgstr "De Koppellist lett sik nich halen. Löppt en kompatibel Verschoon vun KTorrent?"

#. +> trunk stable
#: dbushandler.cpp:278
#, kde-format
msgid "The link for %1 does not contain the required btih hash-parameter."
msgstr "De Link för \"%1\" bargt nich den nödige BTIH-Pröövsummkenngrött."

#. +> trunk
#: dbushandler.cpp:288
#, kde-format
msgid "The found value (%1) for the hash is neither 32 nor 40 chars long."
msgstr "De funnen Weert (%1) för de Pröövsumm is nich 32 un ok nich 40 Tekens lang."

#. +> stable
#: dbushandler.cpp:337
msgid "(no name given)"
msgstr "(Keen Naam angeven)"

#. +> stable
#: dbushandler.cpp:340
msgid "(no path given)"
msgstr "(Keen Padd angeven)"

#. +> stable
#: dbushandler.cpp:343
msgid "(magnet dht)"
msgstr "(Magnet-VPT)"

#. +> trunk stable
#: dbushandler.cpp:520
msgid "Torrent has been removed from KTorrent."
msgstr "De Torrent wöör ut KTorrent wegmaakt."

#. +> trunk stable
#: kio_magnet.cpp:235 kio_magnet.cpp:310 kio_magnet.cpp:336
#, kde-format
msgid "File exists in KTorrent, but cannot open it on disk at path \"%1\". Have you removed the file manually?"
msgstr "Dat gifft de Datei twaars binnen KTorrent, man över den Padd \"%1\" op de Fastplaat lett se sik nich opmaken. Hest Du de Datei villicht vun Hand wegmaakt?"

#. +> trunk
#: kio_magnet.cpp:295
msgid "You cannot write to magnet resources."
msgstr "Na Magnet-Ressource lett sik nich schrieven."

#. +> stable
#: kio_magnet.cpp:306
msgid "You cannot write to magnet ressources."
msgstr "Na Magnet-Ressourcen lett sik nich schrieven."

#. +> trunk stable
#: kio_magnet.cpp:316
#, kde-format
msgid "File \"%1\" is a directory. This should not happen. Please file a bug."
msgstr "Datei \"%1\" is en Orner. Dit schull nich vörkamen. Stüer bitte en Fehlerbericht loos."

