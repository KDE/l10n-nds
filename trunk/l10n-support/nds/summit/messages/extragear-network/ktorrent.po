#. i18n: ectx: property (title), widget (QGroupBox, groupBox_4)
#. +> trunk stable
#: ktorrent/pref/btpref.ui:90
msgid "Encryption"
msgstr "Verslöteln"

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_useEncryption)
#. +> trunk stable
#: ktorrent/pref/btpref.ui:100
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Protocol encryption is useful when your ISP is slowing down bittorrent connections. </p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The encryption will prevent your bittorrent traffic to be flagged as bittorrent traffic, and so the ISP will not slow it down.</p>"
"</body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap;font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; }\n"
"</style></head><body>\n"
"<p>Dat Verslöteln vun't Protokoll is denn goot, wenn Dien Internetanbeder Bittorrent-Verbinnen langsamer maakt.</p>"
"\n"
"<p>De Verslöteln verhöödt, dat Dien Internetanbeder Dien Bittorrent-Datenströöm as dit kennt, he warrt denn de Strööm ok nich langsamer maken.</p>"
"</body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_useEncryption)
#. i18n: ectx: label, entry (useEncryption), group (downloads)
#. +> trunk stable
#: ktorrent/pref/btpref.ui:103 libktcore/ktorrent.kcfg:144
msgid "Use protocol encryption"
msgstr "Protokollverslöteln bruken"

