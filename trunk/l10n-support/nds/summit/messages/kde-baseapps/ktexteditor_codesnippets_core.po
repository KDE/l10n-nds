#. +> trunk stable
#: completionmodel.cpp:137 completionmodel.cpp:259
#, kde-format
msgid ""
"<qt>The error <b>%4</b><br />"
" has been detected in the file %1 at %2/%3</qt>"
msgstr ""
"<qt>De Fehler <b>%4</b><br />"
" is binnen de Datei %1 bi Positschoon %2/%3 opdukt.</qt>"

#. +> trunk stable
#: completionmodel.cpp:142 completionmodel.cpp:264
#, kde-format
msgid "Unable to open %1"
msgstr "%1 lett sik nich opmaken."

#. +> trunk stable
#: completionmodel.cpp:147 completionmodel.cpp:269
#, kde-format
msgid "Not a valid snippet file: %1"
msgstr "%1 is keen gellen Snippels-Datei"

#. +> trunk stable
#: completionmodel.cpp:337 completionmodel.cpp:980
msgid "Snippets"
msgstr "Snippels"

#. +> trunk stable
#: completionmodel.cpp:552
msgid "You have edited a data file not located in your personal data directory, but a suitable filename could not be generated for storing a clone of the file within your personal data directory."
msgstr "Du hest en Datendatei bewerkt, de nich binnen Dien persöönlich Datenorner liggt, man för en Kloonkopie vun de Orginaaldatei na Dien persöönlich Datenorner lett sik keen bruukbor Dateinaam opstellen."

#. +> trunk stable
#: completionmodel.cpp:554
msgid "You have edited a data file not located in your personal data directory; as such, a renamed clone of the original data file has been created within your personal data directory."
msgstr "Du hest en Datendatei bewerkt, de nich binnen Dien persöönlich Datenorner liggt. Dorwegen wöör vun de Orginaaldatei binnen Dien persöönlich Datenorner en Kloonkopie mit den sülven Naam opstellt."

#. +> trunk stable
#: completionmodel.cpp:560 completionmodel.cpp:597
#, kde-format
msgid "Output file '%1' could not be opened for writing"
msgstr "Utgaavdatei »%1« lett sik nich schrieven."

#. +> trunk stable
#: completionmodel.cpp:591
msgid "It was not possible to create a unique file name for the given snippet collection name"
msgstr "För den angeven Snippels-Sammeln-Naam leet sik keen eenkennig Dateinaam opstellen."

#. +> trunk stable
#: completionmodel.cpp:750
msgid "New Snippet"
msgstr "Nieg Snippel"

#. +> trunk stable
#: repository.cpp:181
msgid "all file types"
msgstr "All Dateitypen"

#. +> trunk stable
#: repository.cpp:185
#, kde-format
msgid "!TAINTED!:%1"
msgstr "Leeg!: %1"

#. +> trunk stable
#: repository.cpp:195
#, kde-format
msgid ""
"%1 (%2)\n"
"content license: %3\n"
"repository license: %4 authors: %5"
msgstr ""
"%1 (%2)\n"
"Inholtverlööfnis: %3\n"
"Archiev-Verlööfnis: %4 Schrievers: %5"

#. +> trunk stable
#: repository.cpp:356
#, kde-format
msgid "Do you really want to delete the file '%1' from the repository? This action is irreversible."
msgstr "Wullt Du de Datei »%1« redig ut dat Archiev wegdoon? - Disse Akschoon lett sik nich torüchdreihen."

#. +> trunk stable
#: repository.cpp:357
msgid "Deleting snippet file"
msgstr "Snippels-Datei warrt wegdaan"

#. +> trunk stable
#: repository.cpp:367
#, kde-format
msgid "Editor application for file '%1' with mimetype 'application/x-ktesnippets' could not be started"
msgstr "För de Datei \"%1\" mit den MIME-Typ »application/x-ktesnippets« lett sik keen Editor opmaken."

#. +> trunk stable
#: repository.cpp:394 repository.cpp:401 repository.cpp:557 repository.cpp:585
msgid "Editor application for new file with mimetype 'application/x-ktesnippets' could not be started"
msgstr "För de niege Datei mit den MIME-Typ »application/x-ktesnippets« lett sik keen Editor opmaken."

#. +> trunk stable
#: repository.cpp:409
msgid "No file specified"
msgstr "Keen Datei angeven."

#. +> trunk stable
#: repository.cpp:423
msgid "It was not possible to create a unique file name for the imported file"
msgstr "För de importeert Datei leet sik keen eenkennig Dateinaam opstellen."

#. +> trunk stable
#: repository.cpp:426
msgid "Imported file has been renamed because of a name conflict"
msgstr "Importeert Datei wöör vunwegen en Naamkonflikt ümnöömt."

#. +> trunk stable
#: repository.cpp:433
msgid "File could not be copied to repository"
msgstr "Datei lett sik nich na dat Archiev koperen."

