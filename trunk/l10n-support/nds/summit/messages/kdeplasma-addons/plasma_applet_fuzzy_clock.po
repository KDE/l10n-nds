msgid "Font style:"
msgstr "Schriftstil:"

#. i18n: ectx: property (toolTip), widget (QCheckBox, fontTimeBold)
#. +> trunk stable
#: fuzzyClockConfig.ui:79
msgid "Check if you want the font in bold"
msgstr "Anmaken, wenn Du fetten Text hebben wullt"

