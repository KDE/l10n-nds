#. i18n: ectx: property (whatsThis), widget (KLineEdit, username)
#. +> stable
#: authenticate.ui:70
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Segoe UI'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Enter your Remember The Milk username here. If you do not have an account, visit <a href=\"http://www.rememberthemilk.com/signup/\"><span style=\" text-decoration: underline; color:#0000ff;\">http://www.rememberthemilk.com/signup/</span></a> to create one.</p>"
"</body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Segoe UI'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Giff hier Dien Brukernaam för \"Dor-An-Denken\" in. Wenn Du dor keen Konto för hest, kiek op <a href=\"http://www.rememberthemilk.com/signup/\"><span style=\" text-decoration: underline; color:#0000ff;\">http://www.rememberthemilk.com/signup/</span></a>, wenn Du een opstellen wullt.</p>"
"</body></html>"

