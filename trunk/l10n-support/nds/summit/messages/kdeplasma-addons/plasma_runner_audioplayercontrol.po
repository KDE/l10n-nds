#. +> trunk stable
#: audioplayercontrolrunner.cpp:356
msgid "Plays the selected song. If :q: is not empty it lists songs matching :q: to play them"
msgstr "Utsöcht Stück afspelen. Is :q: angeven, warrt all op :q: passen Stücken för't Afspelen oplist."

#. +> trunk stable
#: audioplayercontrolrunner.cpp:358
msgid "Displays songs matching :q: for appending the selected to the playlist"
msgstr "Stücken för't Anhangen na de Afspeellist wiesen, de op :q: passt."

#. +> trunk stable
#: audioplayercontrolrunner.cpp:360
msgid "Displays songs matching :q: for queueing them"
msgstr "Stücken för't Inregen wiesen, de op :q: passt."

#. +> trunk stable
#: audioplayercontrolrunner.cpp:363
msgid "Plays a song from playlist"
msgstr "En Stück ut de Afspeellist afspelen"

#. +> trunk stable
#: audioplayercontrolrunner.cpp:365
msgid "Pauses the playing"
msgstr "Dat Afspelen ünnerbreken"

#. +> trunk stable
#: audioplayercontrolrunner.cpp:366
msgid "Plays the next song in the playlist if one is available"
msgstr "Dat nakamen Stück binnen de Afspeellist afspelen, wenn vörhannen."

#. +> trunk stable
#: audioplayercontrolrunner.cpp:367
msgid "Mutes/unmutes the player"
msgstr "Den Afspeler still oder wedder luut maken"

#. +> trunk stable
#: audioplayercontrolrunner.cpp:369
msgid "Increases the volume by :q:. If :q: is empty it increases by the configured value"
msgstr "De Luutstärk üm :q: ropsetten. Is :q: leddig, warrt de instellt Weert bruukt."

#. +> trunk stable
#: audioplayercontrolrunner.cpp:371
msgid "Decreases the volume by :q:. If :q: is empty it decreases by the configured value"
msgstr "De Luutstärk üm :q: minnern. Is :q: leddig, warrt de instellt Weert bruukt."

#. +> trunk stable
#: audioplayercontrolrunner.cpp:372
msgid "Plays the previous song if one is available"
msgstr "Dat verleden Stück afspelen, wenn vörhannen."

#. +> trunk stable
#: audioplayercontrolrunner.cpp:373
msgid "Stops the playing"
msgstr "Dat Afspelen ophollen"

#. +> trunk stable
#: audioplayercontrolrunner.cpp:374
msgid "Sets the volume to :q:"
msgstr "De Luutstärk op :q: instellen"

#. +> trunk stable
#: audioplayercontrolrunner.cpp:375
msgid "Quits the player"
msgstr "Afspeler utmaken"

