#. +> trunk
#: core/operationstack.cpp:223
msgctxt "@info/plain"
msgid "Deleting a partition just copied: Removing the copy."
msgstr "En jüst kopeert Partitschoon warrt wegdaan: De Kopie warrt wegmaakt."

