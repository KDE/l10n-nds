#: boxplugin/boxplugin.cpp:88
msgid ""
"Box.com is a file hosting that offers cloud storage, file synchronization, "
"and client software."
msgstr ""
"Box.com is en Deenst de Aflaagruum in't Nett, Dateisynkroniseren un Client-"
"Software anbeden deit."

