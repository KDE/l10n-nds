#. +> trunk5
#: korganizer/plugins/datenums/datenums.desktop:3
msgctxt "Name"
msgid "Date Numbers Plugin for Calendars"
msgstr "Kalennerdag-Moduul för Kalenners"

#. +> trunk5
#: korganizer/plugins/datenums/datenums.desktop:16
msgctxt "Comment"
msgid ""
"For each day this plugin shows its daynumber of the year at the top of the "
"agenda view. For example, February 1 is day 32 of the year."
msgstr ""
"Dit Moduul wiest för elkeen Dag sien Nummer in't Johr baven de Dagansicht. "
"De 1. Februor is t.B. de 32. Dag vun't Johr."

#. +> trunk5
#: korganizer/plugins/hebrew/hebrew.desktop:3
msgctxt "Name"
msgid "Jewish Calendar Plugin"
msgstr "Moduul för jöödschen Kalenner"

#. +> trunk5
#: korganizer/plugins/hebrew/hebrew.desktop:16
msgctxt "Comment"
msgid "Shows all dates in KOrganizer also in the Jewish calendar system."
msgstr "Wiest all Daten vun KOrganizer ok in't jöödsche Kalennersysteem."

#. +> trunk5
#: korganizer/plugins/picoftheday/picoftheday.desktop:3
msgctxt "Name"
