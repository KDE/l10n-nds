#: openxchangeresource.cpp:791
msgid "The object was edited by another participant in the meantime. Please check."
msgstr "Een anner Deelnehmer hett dat Objekt in de Twischentiet bewerkt. Prööv dat bitte na."

#. +> future stable
#: openxchangeresource.cpp:792
msgid "Object not found. Maybe it was deleted by another participant in the meantime."
msgstr "Objekt lett sik nich finnen. Mag wesen, en anner Deelnehmer hett dat in de Twischentiet wegdaan."

#. +> future stable
#: openxchangeresource.cpp:793
msgid "You don't have the permission to perform this action on this object."
msgstr "Du kannst disse Akschoon nich mit dit Objekt utföhren, dor hest Du nich noog Verlöven för."

#. +> future stable
#: openxchangeresource.cpp:794
msgid "A conflict detected. Please check if there are other objects in conflict with this one."
msgstr "Konflikt opdeckt. Prööv bitte, wat dat twischen dit un anner Objekten en Konflikt gifft."

#. +> future stable
#: openxchangeresource.cpp:795
msgid "A mandatory data field is missing. Please check. Otherwise contact your administrator."
msgstr "En Datenfeld, dat noot deit, fehlt. Prööv dat bitte oder snack dor Dien Systeempleger op an."

#. +> future stable
#: openxchangeresource.cpp:796
msgid ""
"An appointment conflict detected.\n"
"Please check if there are other appointments in conflict with this one."
msgstr ""
"Terminkonflikt opdeckt.\n"
"Prööv bitte, wat dat twischen dit un anner Begeefnissen en Konflikt gifft."

#. +> future stable
#: openxchangeresource.cpp:797
msgid "Internal server error. Please contact your administrator."
msgstr "Intern Serverfehler. Bitte snack dor Dien Systeempleger op an."

