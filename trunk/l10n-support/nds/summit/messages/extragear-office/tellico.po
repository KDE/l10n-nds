#. +> trunk
#: src/collectionfieldsdialog.cpp:164
msgid "The type of the field determines what values may be used. "
msgstr "De Typ vun dat Feld leggt fast, wat för Weerten sik bruken laat. "

#. +> trunk
#: src/collectionfieldsdialog.cpp:165
msgid "<i>Simple Text</i> is used for most fields. "
msgstr "För de mehrsten Feller warrt <i>Eenfach Text</i> bruukt. "

#. +> trunk
#: src/collectionfieldsdialog.cpp:166
msgid "<i>Paragraph</i> is for large text blocks. "
msgstr "<i>Afsnitt</i> is för groot Textblöck. "

#. +> trunk
#: src/collectionfieldsdialog.cpp:167
msgid "<i>Choice</i> limits the field to certain values. "
msgstr "<i>Köör</i> grenzt dat Feld na fastleggt Weerten in. "

#. +> trunk
#: src/collectionfieldsdialog.cpp:168
msgid "<i>Checkbox</i> is for a simple yes/no value. "
msgstr "<i>Krüüzfeld</i> is för en eenfach \"Jo/Nee\"-Weert. "

#. +> trunk
#: src/collectionfieldsdialog.cpp:169
msgid "<i>Number</i> indicates that the field contains a numerical value. "
msgstr "<i>Tall</i> gifft an, dat dat Feld en numeersch Weert bargt. "

#. +> trunk
#: src/collectionfieldsdialog.cpp:170
msgid "<i>URL</i> is for fields which refer to URLs, including references to other files. "
msgstr "<i>URL</i> is för Feller, de na en URL oder na anner Dateien wiest. "

#. +> trunk
#: src/collectionfieldsdialog.cpp:171
msgid "A <i>Table</i> may hold one or more columns of values. "
msgstr "<i>Tabell</i> kann een oder mehr Striepen mit Weerten bargen. "

#. +> trunk
#: src/collectionfieldsdialog.cpp:172
msgid "An <i>Image</i> field holds a picture. "
msgstr "En <i>Bild</i>-Feld bargt en Bild. "

#. +> trunk
#: src/collectionfieldsdialog.cpp:173
msgid "A <i>Date</i> field can be used for values with a day, month, and year. "
msgstr "En <i>Datum</i>-Feld lett sik för Weerten bruken, de en Dag, Maand, oder Johr bargen. "

#. +> trunk
#: src/collectionfieldsdialog.cpp:174
msgid "A <i>Rating</i> field uses stars to show a rating number. "
msgstr "En <i>Beweerten</i>-Feld bargt Steerns för en Beweerten-Stoop. "

