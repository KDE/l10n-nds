#. +> trunk
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#. +> trunk
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

#. +> trunk
#: error.cpp:47
msgid "The XML response from the server could not be parsed"
msgstr "De XML-Antwoort vun den Server lett sik nich inlesen"

#. +> trunk
#: error.cpp:50
msgid "No error.  You can test for this using Error::isValid()"
msgstr "Keen Fehler. Du kannst dit mit \"Error:isValid()\" pröven"

#. +> trunk
#: error.cpp:53
msgid "An unknown error occurred. Please resubmit the request."
msgstr "Dat geev en nich begäng Fehler. Stüer de Anfraag bitte nochmaal loos."

#. +> trunk
#: error.cpp:56
msgid "The service is not available at this time."
msgstr "De Server is opstunns nich verföögbor."

#. +> trunk
#: error.cpp:59
msgid "The application has reached the maximum number of requests allowed. More requests are allowed once the time window has completed."
msgstr "De Programm is be de tohööcht tolaten Tall vun Anfragen anlangt. Mehr Anfragen warrt verlöövt, wenn dat Tietfinster afslaten is."

#. +> trunk
#: error.cpp:62
msgid "The request came from a remote address not allowed by this application."
msgstr "De Anfraag keem vun en feern Adress, de vun dit Programm nich tolaten warrt."

#. +> trunk
#: error.cpp:65
msgid "One of the parameters specified was missing or invalid."
msgstr "Een vun de nageven Parameters fehlt oder is leeg."

#. +> trunk
#: error.cpp:68
msgid "The api key submitted is not associated with any known application."
msgstr "De angeven API-Slötel höört keen begäng Programm to."

#. +> trunk
#: error.cpp:71
msgid "The session key was improperly submitted or has reached its timeout. Direct the user to log in again to obtain another key."
msgstr "De Törnslötel wöör leeg angeven oder sien Tiet is aflopen. Beed den Bruker, dat he sik nochmaal anmellen deit un en niegen Slötel haalt."

#. +> trunk
#: error.cpp:74
msgid "The submitted call_id was not greater than the previous call_id for this session."
msgstr "De angeven call_id weer nich grötter as de verleden call_id för dissen Törn."

#. +> trunk
#: error.cpp:77
msgid "Incorrect signature."
msgstr "Leeg Ünnerschrift."

#. +> trunk
#: error.cpp:80
msgid "Invalid user id."
msgstr "Leeg Bruker-ID."

#. +> trunk
#: error.cpp:83
msgid "Invalid photo id."
msgstr "Leeg Foto-ID."

#. +> trunk
#: error.cpp:86
msgid "The uid cannot be specified from a desktop application."
msgstr "De UID lett sik nich binnen en Schriefdischprogramm angeven"

#. +> trunk
#: error.cpp:89
msgid "Invalid photo tag subject."
msgstr "Leeg Foto-Slötelwoort."

#. +> trunk
#: error.cpp:92
msgid "Cannot tag photo already visible on Facebook."
msgstr "Fotos, de al op Facebook sichtbor sünd, laat sik keen Slötelwöör towiesen."

#. +> trunk
#: error.cpp:95
msgid "Too many photo tags pending."
msgstr "To vele Foto-Slötelwöör staht an."

#. +> trunk
#: error.cpp:98
msgid "The markup was invalid"
msgstr "De Schriftsatz weer leeg"

#. +> trunk
#: error.cpp:101
msgid "Error while parsing FQL statement."
msgstr "Fehler bi't Inlesen vun den FQL-Utdruck."

#. +> trunk
#: error.cpp:104
msgid "The field you requested does not exist."
msgstr "Dat vun Di anfraagte Feld gifft dat nich."

#. +> trunk
#: error.cpp:107
msgid "The table you requested does not exist."
msgstr "De vun Di anfraagte Tabell gifft dat nich."

#. +> trunk
#: error.cpp:110
msgid "Your statement is not indexable."
msgstr "Dien Utdruck lett sik nich indizeren."

#. +> trunk
#: error.cpp:113
msgid "The function you called down not exist."
msgstr "De Funkschoon, de Du daalropen hest, gifft dat nich."

#. +> trunk
#: error.cpp:116
msgid "Wrong number of arguments passed into the function."
msgstr "Leeg Tall vun Argumenten na Funkschoon övergeven."

#. +> trunk
#: error.cpp:119
msgid "ERROR Error: an unrecognized error was received from Facebook."
msgstr "Fehler: Nich begäng Fehler vun Facebook kregen."
