#. +> trunk
#: fetchfeedjob.cpp:275
msgid "File downloading/parsing was aborted."
msgstr "Daalladen/Inlesen vun Datei wöör afbraken."

#. +> trunk
#: fetchfeedjob.cpp:276
msgid "File download timed out."
msgstr "Tietafloop bi't Daalladen vun en Datei."

#. +> trunk
#: fetchfeedjob.cpp:277
msgid "The hostname couldn't get resolved to an IP address."
msgstr "De Reeknernaam lett sik nich to en IP-Adress oplösen."

#. +> trunk
#: fetchfeedjob.cpp:278
msgid "The host was contacted successfully, but reported a 404 error."
msgstr "De Reekner wöör mit Spood ansnackt, man hett en Fehler 404 torüchgeven."

#. +> trunk
#: fetchfeedjob.cpp:279
msgid "Retriever error not covered by the error codes above."
msgstr "Fehler bi't Halen nich vun de Fehlerkodes baven afdeckt."

#. +> trunk
#: fetchfeedjob.cpp:280
msgid "The XML is invalid."
msgstr "Dat XML is leeg."

#. +> trunk
#: fetchfeedjob.cpp:281
msgid "The source is valid XML, but no parser accepted it."
msgstr "De Born gellt as XML, man keen Inleser will em annehmen."

#. +> trunk
#: fetchfeedjob.cpp:282
msgid "The source was accepted by a parser, but the actual parsing failed."
msgstr "De Born wöör vun en Inleser annahmen, man dat Inlesen is fehlslaan."

#. +> trunk
#: rssresource.cpp:318
msgid "OPML Document (*.opml)"
msgstr "OPML-Dokment (*.opml)"

#. +> trunk
#: rssresource.cpp:319
msgid "Select an OPML Document"
msgstr "En OPML-Dokment utsöken"
