#. i18n: ectx: property (whatsThis), widget (QCheckBox, dontScanRemoteMounts)
#. +> trunk
#: src/part/dialog.ui:168
msgid "Prevents scanning of filesystems that are not on this computer, e.g. NFS or Samba mounts."
msgstr "Verhöödt dat Dörkieken vun feern Dateisystemen, a.B. NFS oder inhangt Samba-Partitschonen."

#. i18n: ectx: property (text), widget (QCheckBox, dontScanRemoteMounts)
#. +> trunk
#: src/part/dialog.ui:171
msgid "Exclude remote files&ystems"
msgstr "Feern Dateis&ystemen utsluten"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, scanAcrossMounts)
#. +> trunk
#: src/part/dialog.ui:178
msgid "Allows scans to enter directories that are part of other filesystems. For example, when unchecked, this will usually prevent the contents of <b>/mnt</b> from being scanned if you scan <b>/</b>."
msgstr "Mit disse Optschoon laat sik Ornern dörkieken, de op anner Dateisystemen liggt. Is dit utmaakt, warrt a.B. normalerwies de Inholt vun <b>/mnt</b> nich dörkeken."

#. i18n: ectx: property (text), widget (QCheckBox, scanAcrossMounts)
#. +> trunk
#: src/part/dialog.ui:181
msgid "Scan across filesystem &boundaries"
msgstr "Ok &anner Dateisystemen dörkieken"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, dontScanRemovableMedia)
#. +> trunk
#: src/part/dialog.ui:194
msgid "Prevents Filelight from scanning removable media (eg. CD-ROMs)."
msgstr "Verhöödt dat Dörkieken vun tuuschbor Medien (a.B. CD-ROMs)."

#. i18n: ectx: property (text), widget (QCheckBox, dontScanRemovableMedia)
#. +> trunk
#: src/part/dialog.ui:197
msgid "E&xclude removable media"
msgstr "Tuuschbore Medien &utsluten"

