#. +> trunk
#: powersaveConfig.ui:257 powersaveConfig.ui:479
msgid "Suspend"
msgstr "Utsetten"

#. i18n: ectx: property (toolTip), widget (QRadioButton, laptopClosedACHibernate)
#. i18n: ectx: property (toolTip), widget (QRadioButton, laptopClosedBatteryHibernate)
#. +> trunk
#: powersaveConfig.ui:264 powersaveConfig.ui:486
msgid "Suspend to Disk"
msgstr "Infreren (op Fastplaat)"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, laptopClosedACHibernate)
#. i18n: ectx: property (whatsThis), widget (QRadioButton, laptopClosedBatteryHibernate)
#. +> trunk
#: powersaveConfig.ui:267 powersaveConfig.ui:489
msgid "Hibernate or \"Suspend to Disk\" is a deep sleepstate, allowing the system to power off completely"
msgstr "\"Infreren (op Fastplaat)\" is en deep Slaaptostand, in den sik dat Systeem kumplett utmaken lett."

#. i18n: ectx: property (text), widget (QRadioButton, laptopClosedACHibernate)
