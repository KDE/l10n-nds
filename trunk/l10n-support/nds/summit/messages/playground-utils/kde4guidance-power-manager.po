#. i18n: ectx: property (toolTip), widget (QRadioButton, laptopClosedACSuspend)
#. i18n: ectx: property (toolTip), widget (QRadioButton, laptopClosedBatterySuspend)
#. +> trunk
#: powersaveConfig.ui:251 powersaveConfig.ui:473
msgid "Suspend to Memory"
msgstr "Utsetten (RAM)"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, laptopClosedACSuspend)
#. i18n: ectx: property (whatsThis), widget (QRadioButton, laptopClosedBatterySuspend)
#. +> trunk
#: powersaveConfig.ui:254 powersaveConfig.ui:476
msgid "Suspend is a sleep state, the system will consume only very little energy when suspended"
msgstr "\"Utsetten\" is en Slaaptostand, in den dat Systeem bi't Utsetten bloots bannig wenig Stroom bruukt."

#. i18n: ectx: property (text), widget (QRadioButton, laptopClosedACSuspend)
