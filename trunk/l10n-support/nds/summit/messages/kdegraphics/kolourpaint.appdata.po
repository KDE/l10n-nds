#: kolourpaint.appdata.xml:15
msgid "Support for drawing various shapes - lines, rectangles, rounded rectangles, ovals and polygons"
msgstr "Ünnerstütt dat Teken vun en Reeg vun Formen - Lienen, Rechtecks, afrundt Rechtecks, Ovalen un Veelecks"

#. (itstool) path: ul/li
#. +> trunk
#: kolourpaint.appdata.xml:16
