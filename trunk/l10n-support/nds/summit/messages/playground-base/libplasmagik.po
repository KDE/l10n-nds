#. i18n: ectx: property (text), widget (QLabel, label_8)
#. +> trunk
#: createpackage.ui:31 plasmagikdesigned.ui:369
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; font-style:italic;\">NOTE</span><span style=\" font-style:italic;\"> that the </span><span style=\" font-weight:600; font-style:italic;\">whole directory</span><span style=\" font-style:italic;\"> will be packaged!</span><br />"
"Please select the folder containing the content you want to <br />"
"have packaged:</p>"
"</body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; font-style:italic;\">Beacht bitte,</span><span style=\" font-style:italic;\"> de </span><span style=\" font-weight:600; font-style:italic;\">hele Orner</span><span style=\" font-style:italic;\"> warrt inpackt!</span><br />"
"Söök bitte den Orner ut, den Du inpackt hebben wullt:</p>"
"</body></html>"

#. i18n: ectx: property (toolTip), widget (QLabel, firstFileLabel)
#. +> trunk
#: createpackage.ui:50 plasmagikdesigned.ui:400
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The file you should select as \"main file\" differs a lot depending on what is the type of package you're making. </p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Here are a few exaples provided for helping you choose the right file.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The file to be selected should already have been told from the application (see manual, etc...), if not, please complain to the application maintainer.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Here are the examples:</p>"
"\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"> <span style=\" font-weight:600;\">* Wallpaper:</span> A wallpaper should probably select the image to be loaded for the wallpaper here.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-weight:600;\">* Script:<span style=\" font-weight:400;\"> In case your creation is a script, you should select the main file, that includes each other, the one the application should directly use.</span></p>"
"</body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\"> Witt\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">För de Datei, de Du as \"Hööftdatei\" utsöken muttst, kummt dat bannig op Typ vun't Paket an, dat Du opstellen wullt.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Hier en Reeg Bispelen, de Di dor bi hölpen schöölt, dat Du de richtige Datei utsöchst:</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Normalerwies schull dat Programm Di de Datei vertellen (a.B. in de Dokmentatschoon), wenn nich, snack dor dat Programm sien Pleger op an.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Hier sünd de Bispelen:</p>"
"\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">* Achtergrundbild:</span>Bi en Achtergrundbild is dat wull dat Bild, dat as Achtergrund laadt warrn schall.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-weight:600;\">* Skript:<span style=\" font-weight:400;\"> Stellst Du en Skriptpaket op, söök de Datei ut, de all anner Dateien insluten deit - dat is de, de dat Programm direktemang bruukt.</span></p>"
"</body></html>"

