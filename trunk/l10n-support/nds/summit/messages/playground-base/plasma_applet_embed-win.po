#. +> trunk
#: embed-win.cpp:88
msgid "Embed new application"
msgstr "Nieg Programm inbetten"

#. +> trunk
#: embed-win.cpp:89
msgid "Release embedded application"
msgstr "Inbett Programm rutsetten"

#. +> trunk
#: embed-win.cpp:156
msgid ""
"Click with the left mouse button on the window you want to embed.\n"
"Click anywhere with the right mouse button to cancel."
msgstr ""
"Klick mit den linken Muusknoop op't Finster, dat Du inbetten wullt.\n"
"Afbreken kannst Du dat mit den rechten Muuknoop."

#. +> trunk
#: embed-win.cpp:243
msgid "Sorry, can't embed this window."
msgstr "Deit mi leed, dit Finster lett sik nich inbetten."

#. +> trunk
#: embed-win.cpp:248
msgid "Embedding client..."
msgstr "Programm warrt inbett..."

#. +> trunk
#: embed-win.cpp:260
msgid "Error while embedding client"
msgstr "Fehler bi't Inbetten vun't Programm"

#. +> trunk
#: embed-win.cpp:273
msgid "Client is embedded. If you see this text please report a bug."
msgstr "Dat Programm is inbett. Kriggst Du dissen Text to sehn, stüer bitte en Fehlerbericht loos."

#. +> trunk
#: embed-win.cpp:285
msgid "Application have been closed"
msgstr "Programm wöör tomaakt"

#. +> trunk
#: embed-win.cpp:288
msgid "Application have been detached"
msgstr "Programm wöör aflööst"

