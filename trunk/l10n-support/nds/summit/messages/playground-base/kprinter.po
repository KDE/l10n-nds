#. +> trunk
#: main.cpp:29
msgid "KPrinter"
msgstr "KPrinter"

#. +> trunk
#: main.cpp:29
msgid "A printer tool for KDE"
msgstr "En Druckwarktüüch för KDE"

#. +> trunk
#: main.cpp:32
msgid "Make an internal copy of the files to print"
msgstr "Interne Kopie vun de druckte Datei maken"

#. +> trunk
#: main.cpp:34
msgid "Printer/destination to print on"
msgstr "Drucker / Teel för't Drucken"

#. +> trunk
#: main.cpp:36
msgid "Title/Name for the print job"
msgstr "Titel / Naam för de Opgaav"

#. +> trunk
#: main.cpp:38
msgid "Number of copies"
msgstr "Tall vun Kopien"

#. +> trunk
#: main.cpp:39
msgid "Printer option"
msgstr "Druckeroptschoon"

#. +> trunk
#: main.cpp:40
msgid "Job output mode (gui, console, none)"
msgstr "Opgaven-Utgaavtyp (GUI, Konsool, keen)"

#. +> trunk
#: main.cpp:41
msgid "Print system to use (lpd, cups)"
msgstr "Drucksysteem (LPD, CUPS)"

#. +> trunk
#: main.cpp:42
msgid "Allow printing from STDIN"
msgstr "Drucken vun STDIN tolaten"

#. +> trunk
#: main.cpp:43
msgid "Do not show the print dialog (print directly)"
msgstr "Den Druckdialoog nich wiesen (direktemang drucken)"

#. +> trunk
#: main.cpp:44
msgid "Files to load"
msgstr "Dateien för't Laden"

#. +> trunk
#: printwrapper.cpp:63
msgid "Print Information"
msgstr "Druckinformatschoon"

#. +> trunk
#: printwrapper.cpp:64
msgid "Print Warning"
msgstr "Druckwohrschoen"

#. +> trunk
#: printwrapper.cpp:65
msgid "Print Error"
msgstr "Druckfehler"

#. +> trunk
#: printwrapper.cpp:71
msgid "Print info"
msgstr "Druckinformatschoon"

#. +> trunk
#: printwrapper.cpp:71
msgid "Print warning"
msgstr "Druckwohrschoen"

#. +> trunk
#: printwrapper.cpp:71
msgid "Print error"
msgstr "Druckfehler"

#. +> trunk
#: printwrapper.cpp:187
msgid "A file has been specified on the command line. Printing from STDIN will be disabled."
msgstr "En Datei is op de Befehlsreeg angeven, Drucken vun STDIN warrt utmaakt."

#. +> trunk
#: printwrapper.cpp:193
msgid "When using '--nodialog', you must at least specify one file to print or use the '--stdin' flag."
msgstr "Wenn Du \"--nodialog\" angiffst, muttst Du tominnst een Datei angeven oder \"--stdin\" bruken."

#. +> trunk
#: printwrapper.cpp:242
msgid "The specified printer or the default printer could not be found."
msgstr "De angeven un de Standarddrucker laat sik nich finnen."

#. +> trunk
#: printwrapper.cpp:244
msgid "Operation aborted."
msgstr "Akschoon afbraken."

#. +> trunk
#: printwrapper.cpp:274
msgid "Unable to construct the print dialog."
msgstr "De Druckdialoog lett sik nich opstellen."

#. +> trunk
#: printwrapper.cpp:315
#, kde-format
msgid "Multiple files (%1)"
msgstr "Mehr Dateien (%1)"

#. +> trunk
#: printwrapper.cpp:322
msgid "Nothing to print."
msgstr "Nix to drucken."

#. +> trunk
#: printwrapper.cpp:347
msgid "Unable to open temporary file."
msgstr "Temporeer Datei lett sik nich opmaken."

#. +> trunk
#: printwrapper.cpp:362
msgid "Stdin is empty, no job sent."
msgstr "Stdin is leddig, keen Druckopgaav opstellt."

#. +> trunk
#: printwrapper.cpp:374
#, kde-format
msgid "Unable to copy file %1."
msgstr "Datei %1 lett sik nich koperen."

#. +> trunk
#: printwrapper.cpp:391
msgid "Error while printing files"
msgstr "Fehler bi't Drucken vun de Dateien"

