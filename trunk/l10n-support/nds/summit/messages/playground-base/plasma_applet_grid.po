#. +> trunk
#: grid.cpp:379
msgid "Note: The number of columns takes precedence."
msgstr "Beacht bitte: De Tall vun Striepen geiht vör."

#. +> trunk
#: grid.cpp:381
msgid "Note: The number of rows takes precedence."
msgstr "Beacht bitte: De Tall vun Regen geiht vör."

#. i18n: ectx: property (windowTitle), widget (QWidget, gridConfig)
#. i18n: ectx: property (accessibleName), widget (QWidget, gridConfig)
#. +> trunk
#: gridConfig.ui:19 gridConfig.ui:22
msgid "Configure Grid"
msgstr "Gadder instellen"

#. i18n: ectx: property (whatsThis), widget (QLabel, rowLabel)
#. +> trunk
#: gridConfig.ui:62
msgid "Here you can set the number of columns to be used. Note that in vertical panels, this means the maximum number of rows, so your grid will never be higher than that. It will expand horizontally instead, i.e. add more columns."
msgstr "Hier kannst Du de Tall vun Striepen fastleggen, de Du bruken wullt. In pielrecht Paneels is dat de Hööchsttall vun Regen, dat Gadder warrt nienich höger as disse Tall. Ansteed wasst dat kimmrecht, kriggt also mehr Striepen."

#. i18n: ectx: property (text), widget (QLabel, rowLabel)
#. +> trunk
#: gridConfig.ui:65
msgid "Number of rows"
msgstr "Tall vun Regen"

#. i18n: ectx: property (whatsThis), widget (QLabel, colLabel)
#. +> trunk
#: gridConfig.ui:78
msgid "Here you can set the number of columns to be used. Note that in vertical panels, this means the maximum number of columns, so your grid will never be wider than that. It will expand vertically instead, i.e. add more rows."
msgstr "Hier kannst Du de Tall vun Regen fastleggen, de Du bruken wullt. In kimmrecht Paneels is dat de Hööchsttall vun Striepen, dat Gadder warrt nienich breder as disse Tall. Ansteed wasst dat pielrecht, kriggt also mehr Regen."

#. i18n: ectx: property (text), widget (QLabel, colLabel)
#. +> trunk
#: gridConfig.ui:81
msgid "Number of columns"
msgstr "Tall vun Striepen"

#. i18n: ectx: property (text), widget (QLabel, note)
#. +> trunk
#: gridConfig.ui:96
msgid "Note about row/columns precedence"
msgstr "Gaht Regen oder Striepen vör?"
