msgstr ""

#. +> trunk
#: timetablemate.cpp:123
msgctxt "@info:whatsthis"
msgid ""
"<subtitle>Web View</subtitle>"
"<para>This is the web view. You can use it to check the URLs you have defined in the <interface>Accessor</interface> settings or to get information about the structure of the documents that get parsed by the script.</para>"
"<para><note>You can select a web element in the <emphasis>inspector</emphasis> using the context menu.</note></para>"
msgstr ""

#. +> trunk
#: timetablemate.cpp:205
msgctxt "@info:whatsthis"
msgid ""
"<subtitle>Accessor Source</subtitle>"
"<para>This shows the XML source of the accessor settings. Normally you will not need this, because you can setup everything in the <interface>Accessor</interface> settings.</para>"
"<para><note>Changes to <interface>Accessor</interface> and <interface>Accessor Source</interface> are synchronized automatically. Comments and unknown content in the source is removed when synchronizing.</note></para>"
msgstr ""

#. +> trunk
#: timetablemate.cpp:214
msgctxt "@info:whatsthis"
msgid ""
"<subtitle>Script File</subtitle>"
"<para>This shows the script source code. Syntax completion is available for all functions and strings used by the data engine.</para>"
"<para>To try out the script functions just click one of the <interface>Run '<placeholder>function</placeholder>'</interface> buttons.</para>"
msgstr ""

