#: javascriptcompletionmodel.cpp:434
msgctxt "@info The description for the 'RouteStops' info"
msgid ""
"A list of stops of the departure/arrival to it's destination stop or a list of stops of the journey from it's start to it's destination stop.<nl/>"
"If <emphasis>RouteStops</emphasis> and <emphasis>RouteTimes</emphasis> are both set, they should contain the same number of elements. And elements with equal indices should be associated (the times at which the vehicle is at the stops).<nl/>"
"<note>For journeys <emphasis>RouteTimesDeparture</emphasis> and <emphasis>RouteTimesArrival</emphasis> should be used instead of <emphasis>RouteTimes</emphasis>.</note>"
msgstr ""

#. +> trunk
#: javascriptcompletionmodel.cpp:446
msgctxt "@info The description for the 'RouteTimes' info"
msgid ""
"A list of times of the departure/arrival to it's destination stop.<nl/>"
"If <emphasis>RouteStops</emphasis> and <emphasis>RouteTimes</emphasis> are both set, they should contain the same number of elements. And elements with equal indices should be associated (the times at which the vehicle is at the stops)."
msgstr ""

#. +> trunk
#: javascriptcompletionmodel.cpp:457
msgctxt "@info The description for the 'RouteTimesDeparture' info"
msgid ""
"A list of departure times of the journey.<nl/>"
"If <emphasis>RouteStops</emphasis> and <emphasis>RouteTimesDeparture</emphasis> are both set, the latter should contain one element less (because the last stop has no departure, only an arrival time). Elements with equal indices should be associated (the times at which the vehicle departs from the stops)."
msgstr ""

#. +> trunk
#: javascriptcompletionmodel.cpp:466
msgctxt "@info The description for the 'RouteTimesArrival' info"
msgid ""
"A list of arrival times of the journey.<nl/>"
"If <emphasis>RouteStops</emphasis> and <emphasis>RouteTimesArrival</emphasis> are both set, the latter should contain one element less (because the first stop has no arrival, only a departure time). Elements with equal indices should be associated (the times at which the vehicle arrives at the stops)."
msgstr ""

#. +> trunk
#: javascriptcompletionmodel.cpp:474
msgctxt "@info The description for the 'RouteExactStops' info"
msgid ""
"The number of exact route stops.<nl/>"
"The route stop list in <emphasis>RouteStops</emphasis> is not complete from the last exact route stop."
msgstr ""

