#. +> trunk
#: contacts.cpp:172
msgid "Contact Selection"
msgstr "Kontakt-Köör"

#. +> trunk
#: contacts.cpp:173
msgid "Display Properties"
msgstr "Egenschappen wiesen"

#. +> trunk
#: contacts.cpp:283
msgid "You can add contacts in the settings dialog."
msgstr "Du kannst Kontakten binnen de Instellen tofögen"

#. i18n: ectx: property (availableLabel), widget (KActionSelector, contacts)
#. +> trunk
#: contactsConfig.ui:16
msgid "&Available contacts:"
msgstr "&Verföögbor Kontakten:"

#. i18n: ectx: property (selectedLabel), widget (KActionSelector, contacts)
#. +> trunk
#: contactsConfig.ui:19
msgid "&Plasmoid contacts:"
msgstr "&Plasmalüttprogramm-Kontakten:"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#. +> trunk
#: displayConfig.ui:16
msgid "Contacts"
msgstr "Kontakten"

#. i18n: ectx: property (toolTip), widget (QCheckBox, contactsShowWidget)
#. +> trunk
#: displayConfig.ui:22
msgid "Enable this to show contact properties like their name, email address or instant messaging status."
msgstr "Maak dit an, wenn Du Kontaktegenschappen as den Naam, de Nettpostadress oder den Kortnarichten-Status wiesen wullt."

#. i18n: ectx: property (whatsThis), widget (QCheckBox, contactsShowWidget)
#. +> trunk
#: displayConfig.ui:25
msgid "Enable this to show contact properties like their name, email address or instant messaging status. Which properties are shown in which order can be configured in the \"Contact Properties\" tab."
msgstr "Maak dit an, wenn Du Kontaktegenschappen as den Naam, de Nettpostadress oder den Kortnarichten-Status wiesen wullt. De Egenschappen, de wiest warrt, un ehr Reeg kannst Du op de \"Kontakt-Egenschappen\"-Paneelsiet fastleggen."

#. i18n: ectx: property (text), widget (QCheckBox, contactsShowWidget)
#. +> trunk
#: displayConfig.ui:28
msgid "Show contact properties"
msgstr "Kontakt-Egenschappen wiesen"

#. i18n: ectx: property (availableLabel), widget (KActionSelector, contactsSelection)
#. +> trunk
#: displayConfig.ui:38
msgid "&Available properties:"
msgstr "&Verföögbor Egenschappen:"

#. i18n: ectx: property (selectedLabel), widget (KActionSelector, contactsSelection)
#. +> trunk
#: displayConfig.ui:41
msgid "&Shown properties:"
msgstr "&Wiest Egenschappen:"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#. +> trunk
#: displayConfig.ui:51
msgid "Marble Map"
msgstr "\"Marble\"-Koort"

#. i18n: ectx: property (toolTip), widget (QCheckBox, marbleShowWidget)
#. i18n: ectx: property (whatsThis), widget (QCheckBox, marbleShowWidget)
#. +> trunk
#: displayConfig.ui:57 displayConfig.ui:60
msgid "Enable this and a map will be shown that displays the location of contacts (if known)."
msgstr "Maakst Du dit an, warrt en Koort mit de Kontakten ehr Steden wiest (wenn begäng)."

#. i18n: ectx: property (text), widget (QCheckBox, marbleShowWidget)
#. +> trunk
#: displayConfig.ui:63
msgid "Show a map of contacts"
msgstr "En Koort mit de Kontakten dor op wiesen"

#. i18n: ectx: property (toolTip), widget (QListView, marbleTheme)
#. i18n: ectx: property (whatsThis), widget (QListView, marbleTheme)
#. i18n: ectx: property (toolTip), widget (QLabel, label)
#. i18n: ectx: property (whatsThis), widget (QLabel, label)
#. +> trunk
#: displayConfig.ui:91 displayConfig.ui:94 displayConfig.ui:104
#: displayConfig.ui:107
msgid "Marble can display different maps (themes). Select one here."
msgstr "\"Marble\" kann verscheden Koorten (Mustern) bruken. Söök bitte hier een ut."

#. i18n: ectx: property (text), widget (QLabel, label)
#. +> trunk
#: displayConfig.ui:110
msgid "Marble Theme:"
msgstr "Muster för \"Marble\":"

#. i18n: ectx: property (toolTip), widget (QCheckBox, marbleRecenterOnLocationChange)
#. +> trunk
#: displayConfig.ui:120
msgid "The map center will be moved to a contact that has changed its location when this setting is enabled."
msgstr "Is dit anmaakt, warrt de Koort ehr Merrn na en Kontakt verschaven, de sien Steed ännert hett."

#. i18n: ectx: property (whatsThis), widget (QCheckBox, marbleRecenterOnLocationChange)
#. +> trunk
#: displayConfig.ui:123
msgid "The map center will be moved to a contact that has changed its location when this setting is enabled. If, for example, you are adding a new contact to be displayed, and the location of that contact is known, the map will show that new contact with this setting enabled. When disabled, the map will not move on its own, but stay at the point you moved it last."
msgstr "Is dit anmaakt, warrt de Koort ehr Merrn na en Kontakt verschaven, de sien Steed ännert hett. Föögst Du de Koort en nieg Kontakt to, un sien Steed is begäng, wiest de Koort de Steed, wenn dit anmaakt is. Is dit utmaakt, geiht de Koort narms hen, se blifft dor, wo Du ehr henschaven hest."

#. i18n: ectx: property (text), widget (QCheckBox, marbleRecenterOnLocationChange)
#. +> trunk
#: displayConfig.ui:126
msgid "Focus contacts that change location"
msgstr "Kontakten wiesen, de ehr Steed ännert hebbt"

#. +> trunk
#: eventcell.cpp:66
#, kde-format
msgid "<b>%1 unread messages:</b><br />"
msgstr "<b>%1 nich leest Narichten:</b><br />"

#. +> trunk
#: eventcell.cpp:89
#, kde-format
msgid "Today is %1 birthday"
msgstr "Vundaag hett %1 Geboortsdag"

#. +> trunk
#: eventcell.cpp:95
#, kde-format
msgid "Only %1 days left to %2 birthday"
msgstr "Bloots %1 Daag na bet to den Geboortsdag vun %2"

#. +> trunk
#: lineeditcell.cpp:61
msgid "Type a message and press return to send it"
msgstr "Giff en Naricht in un drück de Ingaavtast, wenn Du ehr loosstüern wullt"

#. +> trunk
#: lineeditcell.cpp:62
msgid "This contact cannot be reached at the moment."
msgstr "Disse Kontakt lett sik opstunns nich faatkriegen."
