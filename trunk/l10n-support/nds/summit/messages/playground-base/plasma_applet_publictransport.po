msgstr "%1 Minuten"

#. +> trunk
#: journeysearchparser.cpp:104
msgctxt "@info/plain This is a regular expression used to match a string after the 'in' keyword in the journey search line. The english version matches 'strings like '5 mins.', '1 minute', ... '\\d+' stands for at least 'one digit, '\\.' is just a point, a '?' after a character means that it's optional (eg. the 's' in 'mins?' is optional to match singular and plural forms). Normally you will only have to translate 'mins?' and 'minutes?'. The regexp must include one pair of matching 'parantheses, that match an int (the number of minutes from now). Note: '(?:...)' are non-matching parantheses."
msgid "(\\d+)\\s+(?:mins?\\.?|minutes?)"
msgstr ""

