#. +> trunk
#: lib/scribo-textmatchplugin.desktop:5
msgctxt "Comment"
msgid "Scribo text match plugin"
msgstr "Scribo-Textsöökmoduul"

#. +> trunk
#: plugins/datetime/scribo_datetimetextmatchplugin.desktop:2
msgctxt "Name"
msgid "Datetime text match plugin"
msgstr "Datum- un Tietsöökmoduul"

#. +> trunk
#: plugins/datetime/scribo_datetimetextmatchplugin.desktop:24
msgctxt "Comment"
msgid "Scribo text match plugin which extracts dates and times from the text and presents them as simple statements"
msgstr "Dat Scribo-Textsöökmoduul söcht Daten un Tieden binnen den Text un stellt de as eenfach Utsagen dor"

#. +> trunk
#: plugins/opencalais/kcm_kopencalais.desktop:5
msgctxt "Name"
msgid "Open Calais"
msgstr "OpenCalais"

#. +> trunk
#: plugins/opencalais/kcm_kopencalais.desktop:27
msgctxt "Comment"
msgid "Configure the Open Calais Scribo plugin"
msgstr "Dat Scribo-Moduul \"Open Calais\" instellen"

#. +> trunk
#: plugins/opencalais/scribo_opencalaistextmatchplugin.desktop:2
msgctxt "Name"
msgid "OpenCalais text match plugin"
msgstr "OpenCalais-Textsöökmoduul"

#. +> trunk
#: plugins/opencalais/scribo_opencalaistextmatchplugin.desktop:24
msgctxt "Comment"
msgid "Scribo text match plugin which uses the OpenCalais web service to analyse text and extract entities and statements"
msgstr "Dat Scribo-Textsöökmoduul, dat den Nettdeenst \"OpenCalais\" för't Ünnersöken vun Text un Ruttrecken vun Eenheiten un Utsagen bruukt."

#. +> trunk
#: plugins/pimo/scribo_pimotextmatchplugin.desktop:2
msgctxt "Name"
msgid "Pimo text match plugin"
msgstr "Pimo-Textsöökmoduul"

#. +> trunk
#: plugins/pimo/scribo_pimotextmatchplugin.desktop:24
msgctxt "Comment"
msgid "Scribo text match plugin which simply tries to match words in the text to Pimo things in Nepomuk"
msgstr "En Scribo-Textsöökmoduul, dat eenfach Wöör binnen den Text mit Pimo-Dinger binnen Nepomuk vergliekt."

#. +> trunk
#: service/nepomukscriboservice.desktop:7
#, fuzzy
msgctxt "Name"
msgid "Nepomuk Scribo Service"
msgstr "Nepomuk-Scribo-Deenst"

#. +> trunk
#: service/nepomukscriboservice.desktop:30
msgctxt "Comment"
msgid "The Nepomuk Scribo service offers a simple interface to Scribo's NLP facilities."
msgstr ""
