#. i18n: ectx: property (text), widget (QLabel, label)
#. +> trunk
#: settings.ui:21
msgid "Bookmarksync can sync your bookmark file to another location. For now it can only save and fetch, but maybe in the future it can actually merge."
msgstr "De Leesteken-Synkroniseren kann Dien Leestekens mit en anner Steed synkroniseren. Opstunns kann dat bloots Dateien halen un sekern, man later villicht ok redig tosamenföhren."

#. i18n: ectx: property (text), widget (QLabel, label_2)
#. +> trunk
#: settings.ui:33
msgid "Select the location where to store or fetch the bookmarks file to. Like sftp://some.server"
msgstr "De Steed utsöken, na de oder vun de Du de Leestekens sekern oder halen wullt, so as ftp://een.server.org."

#. i18n: ectx: property (text), widget (KPushButton, kpushbutton)
#. +> trunk
#: settings.ui:43
msgid "Select location"
msgstr "Steed utsöken"

#. i18n: ectx: property (text), widget (QCheckBox, AutoSave)
#. +> trunk
#: settings.ui:52
msgid "Save bookmark file automatically on change"
msgstr "Leestekendatei bi Ännern automaatsch sekern"

#. i18n: ectx: property (text), widget (QCheckBox, AutoFetch)
#. +> trunk
#: settings.ui:59
msgid "Fetch bookmark file automatically on startup when that file is newer"
msgstr "Leestekendatei automaatsch bi't Starten halen, wenn de Datei nieger is"
