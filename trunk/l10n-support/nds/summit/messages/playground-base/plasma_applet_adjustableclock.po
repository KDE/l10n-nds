#. i18n: ectx: property (text), widget (QLabel, placeholdersLabel)
#. +> trunk
#: ui/placeholders.ui:98
#, no-c-format
msgid ""
"<div style=\"white-space:pre;\">\n"
"<b>%H</b>\tthe hour in 24h format with two digits\n"
"<b>%k</b>\tthe hour in 24h format\n"
"<b>%I</b>\tthe hour in 12h format with two digits\n"
"<b>%l</b>\tthe hour in 12h format\n"
"<b>%M</b>\tthe minute number with two digits\n"
"<b>%S</b>\tthe seconds number with two digits\n"
"<b>%s</b>\tthe seconds number\n"
"<b>%p</b>\tpm or am string\n"
"<b>%Y</b>\tthe whole year\n"
"<b>%y</b>\tthe lower two digits of the year\n"
"<b>%n</b>\tthe month number\n"
"<b>%m</b>\tthe month number with two digits\n"
"<b>%e</b>\tthe day of the month number\n"
"<b>%d</b>\tthe day of the month number with two digits\n"
"<b>%b</b>\tthe short form of the month name\n"
"<b>%B</b>\tthe long form of the month name\n"
"<b>%a</b>\tthe short form of the weekday name\n"
"<b>%A</b>\tthe long form of the weekday name\n"
"<b>%g</b>\tthe timezone city string\n"
"<b>%z</b>\tthe timezone offset to UTC\n"
"<b>%Z</b>\tthe timezone abbreviation string\n"
"<b>%j</b>\tthe day of year number\n"
"<b>%w</b>\tthe week number\n"
"<b>%W</b>\tthe weekday number\n"
"<b>%c</b>\tthe short default date and time representation\n"
"<b>%C</b>\tthe long default date and time representation\n"
"<b>%x</b>\tthe long default date representation\n"
"<b>%X</b>\tthe long default time representation\n"
"<b>%f</b>\tthe short default date representation\n"
"<b>%F</b>\tthe short default time representation\n"
"<b>%t</b>\tthe UNIX timestamp\n"
"</div>"
msgstr ""

