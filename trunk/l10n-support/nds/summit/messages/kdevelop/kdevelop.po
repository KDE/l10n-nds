#. +> trunk
#: cppdebugger/debuggerplugin.cpp:313
msgid ""
"<b>Debugger viewers</b>"
"<p>Various information about application being executed. There are 4 views available:<br>"
"<b>Memory</b><br>"
"<b>Disassemble</b><br>"
"<b>Registers</b><br>"
"<b>Libraries</b>"
msgstr ""
"<b>De Fehlersöök-Ansichten</b>"
"<p>wiest verscheden Informatschonen över dat utföhrte Programm. Dat gifft veer verscheden Ansichten:<br>"
"<b>Spieker</b><br>"
"<b>Maschienkode</b><br>"
"<b>Registern</b><br>"
"<b>Bibliotheken</b>"

