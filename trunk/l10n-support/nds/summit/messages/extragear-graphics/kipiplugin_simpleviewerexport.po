#. +> trunk
#: generalpage.cpp:106
msgid "Resize Target Images"
msgstr "Teelbillergrött ännern"

#. +> trunk
#: generalpage.cpp:108
msgid "If you enable this option, all target images can be resized."
msgstr "Wenn Du dit anmaakst, kannst Du de Grött vun all Teelbiller ännern."

#. +> trunk
#: generalpage.cpp:112
msgid "Auto-Rotate/Flip Images"
msgstr "Biller automaatsch dreihen/spegeln"

#. +> trunk
#: generalpage.cpp:114
msgid "If you enable this option, the images orientation will be fixed accordingly with Exif information"
msgstr "Wenn Du dit anmaakst, warrt de Bildutrichten na de EXIF-Informatschoon fastsett"

#. +> trunk
#: generalpage.cpp:121
msgid "&Target Images Size:"
msgstr "&Teelbillergrött:"

#. +> trunk
#: generalpage.cpp:122
msgid "The new size of the exported images in pixels. SimpleViewer resizes the images as well, but this resizes your images before they are uploaded to your server"
msgstr "De niege Grött vun't exporteerte Bild in Pixels. SimpleViewer ännert twaars ok de Bildgrött, man dit ännert de Grött vun de Biller, ehr se na den Server hoochlaadt warrt."

#. +> trunk
#: generalpage.cpp:135
msgid "&Displayed Images Size:"
msgstr "Grött vun &wiest Biller:"

#. +> trunk
#: generalpage.cpp:136
msgid "scales the displayed images to this size. Largest height or width of your largest image (in pixels). Images will not be scaled up above this size, to ensure best image quality."
msgstr "Passt de wiest Biller na disse Grött to. Gröttst Hööchd oder Breed vun Dien gröttst Bild (in Pixels). De Biller warrt nich grötter topasst as hier angeven, so dat de Bildgööd wohrt blifft."

