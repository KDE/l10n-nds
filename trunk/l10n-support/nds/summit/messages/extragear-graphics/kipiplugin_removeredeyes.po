#. +> trunk
#: removeredeyeswindow.cpp:306
msgid ""
"<p>You choose the <b>'overwrite' correction mode</b>!<br/>Are you sure you "
"want to loose your original image files?</p>"
msgstr ""
"<p>Du hest den <b>Överschriev-Bedrief</b> för't Richten utsöcht!<br/>Wullt "
"Du dat redig, de Orginaaldateien kaamt Di weg?</p>"

#. +> trunk
#: removeredeyeswindow.cpp:309
msgid "Overwrite mode"
msgstr "Överschriev-Bedrief"

#. +> trunk
#: removeredeyeswindow.cpp:484
msgid ""
"<p>Some of the images could not be analyzed with the current settings or "
"they do not contain any red-eyes at all.</p><p><b>Would you like to remove "
"those images from the list?</b></p>"
msgstr ""
"<p>En Reeg Biller laat sik mit de aktuellen Instellen nich bekieken, oder se "
"bargt gor keen root Ogen.</p><p><b>Wullt Du disse Biller vun de List "
"wegmaken?</b></p>"

#. +> trunk
#: removeredeyeswindow.cpp:490
msgid "Remove unprocessed images?"
msgstr "Nich afarbeidt Biller wegmaken?"

#. +> trunk
#: removeredeyeswindow.cpp:522
msgid ""
"<p>You tried to add <b>RAW images</b> to the plugin,<br/>but those filetypes "
"are not supported.</p><p><b>They were automatically removed from the list.</"
"b></p>"
msgstr ""
"<p>Du wullt <b>Rohbiller</b> na't Moduul övergeven,<br/> man dat gifft keen "
"Ünnerstütten för disse Dateitypen.</p><p><b>Se wöörn automaatsch vun de List "
"wegmaakt.</b></p>"

#. +> trunk
#: removeredeyeswindow.cpp:526
msgid "RAW images found"
msgstr "Rohbiller funnen"

#. +> trunk
#: removeredeyeswindow.cpp:605
#, kde-format
msgid "<p>%1 image has been successfully processed.</p>"
msgid_plural "<p>%1 images have been successfully processed.</p>"
msgstr[0] "<p>%1 Bild wöör mit Spood afarbeidt.</p>"
msgstr[1] "<p>%1 Biller wöörn mit Spood afarbeidt.</p>"

#. +> trunk
#: removeredeyeswindow.cpp:608
msgid "<h2>Correction Complete!</h2>"
msgstr "<h2>Richten afslaten.</h2>"

