#~ msgid ""
#~ "<p>This widget will display a correction preview for the currently "
#~ "selected image</p><p><ul><li>Move the mouse <b>over</b> the preview to "
#~ "display the original image</li><li>Move the mouse <b>out of</b> the "
#~ "preview to display the corrected image</li><li><b>Click on</b> the "
#~ "preview to display the correction mask</li></ul></p><p>The zoom buttons "
#~ "and panning widget allow you to view certain parts of the image more "
#~ "closely.</p>"
#~ msgstr ""
#~ "<p>Dit is en Vöransicht vun't opstunns utsöchte Bild na't Richten</"
#~ "p><p><ul><li>Schuuv den Muuswieser <b>op</b> de Vöransicht, wenn du dat "
#~ "Orginaalbild wiesen wullt</li><li>Schuuv em dor vun <b>weg</b>, wenn Du "
#~ "dat richt Bild ankieken wullt.</li><li><b>Klick op</b> de Vöransicht, "
#~ "wenn Du de Richtmask wiesen wullt</li></ul></p><p>Mit de Ansichtgrött- un "
#~ "Verschuuv-Warktüüch kannst Du Bilddelen neger bekieken.</p>"

#~ msgid "<h2>generating preview...</h2>"
#~ msgstr "<h2>Vöransicht warrt opstellt...</h2>"

#~ msgid "<p>Can not open preview image<br/>'%1'</p>."
#~ msgstr "<p>Vöransichtbild lett sik nich opmaken<br/>\"%1\"</p>"

#~ msgid "Error loading preview file"
#~ msgstr "Fehler bi't Laden vun de Vöransichtdatei"

#~ msgid "Original Image"
#~ msgstr "Orginaalbild"

#~ msgid "Corrected Image"
#~ msgstr "Richt Bild"

#~ msgid "Correction Mask"
#~ msgstr "Richtmask"

#~ msgid "No image selected!"
#~ msgstr "Keen Bild utsöcht."

#~ msgid "Advanced Mode"
#~ msgstr "Verwiedert Bedrief"

#~ msgid "Simple Mode"
#~ msgstr "Eenfach Bedrief"

#~ msgid ""
#~ "<p><b>Slow<br/>(low-res / slightly blurred images)</b></p><p>In this mode "
#~ "the automatic detection and correction of the red eyes is the most "
#~ "reliable. The drawback of the higher detection rate is a much slower "
#~ "computation.</p>"
#~ msgstr ""
#~ "<p><b>Langsam<br/>(Siet Oplösen / en beten verwischt Biller)</b></p><p> "
#~ "In disse Bedriefoort funkscheneert dat automaatsche Finnen un Richten vun "
#~ "root Ogen op't Best. Man allens hett sien Pries: Dat Utreken bruukt so "
#~ "sien Tiet.</p>"

#~ msgid ""
#~ "<p><b>Standard</b></p><p>This mode is adequate for most image "
#~ "resolutions. Always try this mode first.</p>"
#~ msgstr ""
#~ "<p><b>Standard</b></p><p>Disse Bedriefoort passt to de mehrsten "
#~ "Bildoplösen. Probeer ehr jümmers toeerst ut.</p>"

#~ msgid ""
#~ "<p><b>Fast<br/>(high-res images)</b></p><p>In this mode the automatic "
#~ "detection will be faster, but more false positives may occur. Use this "
#~ "mode only for very high-resolution and sharp images.</p>"
#~ msgstr ""
#~ "<p><b>Gau<br/>(hoge Oplösen)</b></p><p>In disse Bedriefoort funkscheneert "
#~ "dat Finnen gauer, man dat gifft ok mehr leeg Drepers. Bruuk de "
#~ "Bedriefoort bloots bi scharp Biller mit redig hooch Oplösen.</p>"

#~ msgid "Storage Settings"
#~ msgstr "Instellen för't Sekern"

#~ msgid ""
#~ "<p>These settings control the storage of the corrected images. There are "
#~ "three modes to choose from:</p><p><ul><li><b>Subfolder:</b> The corrected "
#~ "images will be saved in a subfolder under the current album path.</"
#~ "li><li><b>Suffix:</b> A custom suffix will be added to the corrected "
#~ "image.</li><li><b>Overwrite:</b> All original images will be replaced.</"
#~ "li></ul></p>"
#~ msgstr ""
#~ "<p>Disse Instellen stüert dat Sekern vun de richt Biller. Dat gifft dree "
#~ "Metoden:</p><p><ul><li><b>Ünnerorner:</b> De richt Biller warrt binnen en "
#~ "Ünnerorner vun den aktuellen Orner sekert.</li><li><b>Verwiedern:</b> En "
#~ "egen Verwiedern warrt dat richt Bild toföögt.</li><li><b>Överschrieven:</"
#~ "b> Do Orginaalbiller warrt överschreven.</li></ul></p>"

#~ msgid "Enter the name of the subfolder here."
#~ msgstr "Hier bitte den Naam vun den Ünnerorner ingeven"

#~ msgid "Save files in a subfolder"
#~ msgstr "Dateien binnen en Ünnerorner sekern"

#~ msgid ""
#~ "If checked, the corrected files will be saved in a subfolder under the "
#~ "current image album path."
#~ msgstr ""
#~ "Is dit anmaakt, warrt de afarbeidt Dateien binnen en Ünnerorner vun't "
#~ "aktuelle Bildalbum sekert."

#~ msgid "Add suffix to filename"
#~ msgstr "Suffix na Dateinaam tofögen"

#~ msgid "If checked, a custom suffix will be added to the corrected file."
#~ msgstr "Wenn anmaakt, warrt richt Dateien dat angeven Suffix anföögt."

#~ msgid "Overwrite original files"
#~ msgstr "Orginaaldateien överschrieven"

#~ msgid "If checked, all original images will be replaced."
#~ msgstr "Wenn anmaakt, warrt all Orginaaldateien utwesselt."

#~ msgid "Enter the name of the suffix here..."
#~ msgstr "Hier bitte den Naam för't Suffix ingeven..."

#~ msgid ""
#~ "<p><i>Note: At the moment this plugin will not keep any metadata (EXIF, "
#~ "IPTC).<br/>To prevent data loss, overwrite mode has been diabled for now."
#~ "</i></p>"
#~ msgstr ""
#~ "<p><i>Beacht bitte: Opstunns wohrt dit Moduul keen Metadaten (Exif, IPTC)."
#~ "<br/>Dormit keen Informatschonen wegkaamt, is de Överschrievbedrief "
#~ "eerstmaal utmaakt.</i></p>"

#~ msgid "Unprocessed Images Settings"
#~ msgstr "Instellen för nich afarbeidt Biller"

#~ msgid ""
#~ "<p>These settings control the handling of unprocessed images when running "
#~ "in testmode. To speed up the final correction, unprocessed images can be "
#~ "removed from the list, so that they don't get analyzed again. There are "
#~ "three modes to choose from:</p><p><ul><li><b>Ask the user:</b> A popup "
#~ "window will appear to ask for further actions.</li><li><b>Keep:</b> All "
#~ "unprocessed images will be kept in the list.</li><li><b>Remove:</b> All "
#~ "unprocessed images are removed after testrun.</li></ul></p>"
#~ msgstr ""
#~ "<p>Disse Instellen stüert, wat min nich afarbeidt Biller in den "
#~ "Testbedrief maakt warrt. Du kannst de Biller, de sik nich afarbeiden "
#~ "laat, vun de List wegmaken. De Biller bruukt denn nich nochmaal ankeken "
#~ "warrn un de hele Akschoon geiht gauer. Dat gifft dree Mööglichkeiten:</"
#~ "p><p><ul> <li><b>Bruker fragen:</b> En Opdukfinster fraagt na, wat de "
#~ "Bruker will.</li><li><b>Wohren:</b> De Biller blievt op de List.</"
#~ "li><li><b>Wegmaken:</b> All Biller, de sik nich afarbeiden laat, warrt na "
#~ "den Testloop vun de List wegmaakt.</li></ul></p>"

#~ msgid "Ask the user"
#~ msgstr "Bruker fragen"

#~ msgid ""
#~ "If checked, the user will be asked to keep or remove unprocessed images."
#~ msgstr ""
#~ "Wenn anmaakt, warrt de Bruker fraagt, wat he nich afarbeidt Biller wohren "
#~ "oder wegmaken will."

#~ msgid "Keep"
#~ msgstr "Wohren"

#~ msgid "If checked, unprocessed images will be kept after test-run."
#~ msgstr "Wenn anmaakt, warrt nich afarbeidt Biller na den Testloop wohrt."

#~ msgid "Remove"
#~ msgstr "Wegmaken"

#~ msgid ""
#~ "If checked, unprocessed images will be removed from the images list after "
#~ "test-run."
#~ msgstr ""
#~ "Wenn anmaakt, warrt nich afarbeidt Biller na den Testloop vun de "
#~ "Billerlist wegmaakt."

#~ msgid "Exit"
#~ msgstr "Utstiegen"

