msgid "Correct Photos"
msgstr "Fotos richten"

#. +> trunk
#: removeredeyeswindow.cpp:157
msgid "Start correcting the listed images"
msgstr "Mit dat Richten vun de oplist Biller anfangen"

#. +> trunk
#: removeredeyeswindow.cpp:161
msgid "Testrun"
msgstr "Testloop"

#. +> trunk
#: removeredeyeswindow.cpp:162
msgid "Simulate the correction process, without saving the results."
msgstr "Dat Richten simuleren, man de Resultaten nich sekern"

