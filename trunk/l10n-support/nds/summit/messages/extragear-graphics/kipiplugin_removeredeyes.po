#: storagesettingsbox.cpp:73
msgid "Save files in a subfolder"
msgstr "Dateien binnen en Ünnerorner sekern"

#. +> trunk
#: storagesettingsbox.cpp:74
msgid "If checked, the corrected files will be saved in a subfolder under the current image album path."
msgstr "Is dit anmaakt, warrt de afarbeidt Dateien binnen en Ünnerorner vun't aktuelle Bildalbum sekert."

#. +> trunk
#: storagesettingsbox.cpp:78
msgid "Add suffix to filename"
msgstr "Suffix na Dateinaam tofögen"

#. +> trunk
#: storagesettingsbox.cpp:79
msgid "If checked, a custom suffix will be added to the corrected file."
msgstr "Wenn anmaakt, warrt richt Dateien dat angeven Suffix anföögt."

#. +> trunk
#: storagesettingsbox.cpp:82
msgid "Overwrite original files"
msgstr "Orginaaldateien överschrieven"

#. +> trunk
#: storagesettingsbox.cpp:83
msgid "If checked, all original images will be replaced."
msgstr "Wenn anmaakt, warrt all Orginaaldateien utwesselt."

#. +> trunk
#: storagesettingsbox.cpp:87
msgid "Enter the name of the suffix here..."
msgstr "Hier bitte den Naam för't Suffix ingeven..."

#. +> trunk
#: unprocessedsettingsbox.cpp:60
msgid "Unprocessed Images Settings"
msgstr "Instellen för nich afarbeidt Biller"

#. +> trunk
#: unprocessedsettingsbox.cpp:64
msgid "Ask the user"
msgstr "Bruker fragen"

#. +> trunk
#: unprocessedsettingsbox.cpp:65
msgid "If checked, the user will be asked to keep or remove unprocessed images."
msgstr "Wenn anmaakt, warrt de Bruker fraagt, wat he nich afarbeidt Biller wohren oder wegmaken will."

#. +> trunk
#: unprocessedsettingsbox.cpp:69
msgid "Keep"
msgstr "Wohren"

#. +> trunk
#: unprocessedsettingsbox.cpp:70
msgid "If checked, unprocessed images will be kept after test-run."
msgstr "Wenn anmaakt, warrt nich afarbeidt Biller na den Testloop wohrt."

#. +> trunk
#: unprocessedsettingsbox.cpp:73
msgid "Remove"
msgstr "Wegmaken"

#. +> trunk
#: unprocessedsettingsbox.cpp:74
msgid "If checked, unprocessed images will be removed from the images list after test-run."
msgstr "Wenn anmaakt, warrt nich afarbeidt Biller na den Testloop vun de Billerlist wegmaakt."

