#. +> trunk
#: settingstab.cpp:165
msgid "Advanced Mode"
msgstr "Verwiedert Bedrief"

#. +> trunk
#: settingstab.cpp:171
msgid "Simple Mode"
msgstr "Eenfach Bedrief"

#. +> trunk
#: simplesettings.cpp:86
msgid ""
"<p><b>Slow<br/>"
"(low-res / slightly blurred images)</b></p>"
"<p>In this mode the automatic detection and correction of the red eyes is the most reliable. The drawback of the higher detection rate is a much slower computation.</p>"
msgstr ""
"<p><b>Langsam<br/>"
"(Siet Oplösen / en beten verwischt Biller)</b></p>"
"<p> In disse Bedriefoort funkscheneert dat automaatsche Finnen un Richten vun root Ogen op't Best. Man allens hett sien Pries: Dat Utreken bruukt so sien Tiet.</p>"

#. +> trunk
#: simplesettings.cpp:91
msgid ""
"<p><b>Standard</b></p>"
"<p>This mode is adequate for most image resolutions. Always try this mode first.</p>"
msgstr ""
"<p><b>Standard</b></p>"
"<p>Disse Bedriefoort passt to de mehrsten Bildoplösen. Probeer ehr jümmers toeerst ut.</p>"

#. +> trunk
#: simplesettings.cpp:95
msgid ""
"<p><b>Fast<br/>"
"(high-res images)</b></p>"
"<p>In this mode the automatic detection will be faster, but more false positives may occur. Use this mode only for very high-resolution and sharp images.</p>"
msgstr ""
"<p><b>Gau<br/>"
"(hoge Oplösen)</b></p>"
"<p>In disse Bedriefoort funkscheneert dat Finnen gauer, man dat gifft ok mehr leeg Drepers. Bruuk de Bedriefoort bloots bi scharp Biller mit redig hooch Oplösen.</p>"

