#. +> trunk
#: kexi/kexidb/drivers/mySQL/showimg_kexidb_mysqldriver.desktop:3
msgctxt "Name"
msgid "mySQL"
msgstr "mySQL"

#. +> trunk
#: kexi/kexidb/drivers/mySQL/showimg_kexidb_mysqldriver.desktop:10
msgctxt "Comment"
msgid ""
"mySQL is a fast database engine. It is used for personal purposes as well as "
"for huge databases in big companies and organizations. We recommend using "
"mySQL for projects shared in networks."
msgstr ""
"MySQL is en gau Datenbankdriever, de liek goot is för lütte persöönliche "
"Datenbanken as för Datenbanken vun groot Bedrieven un Organisatschonen. För "
"Projekten, de över en Nettwark deelt warrt, is MySQL anraadt."

#. +> trunk
