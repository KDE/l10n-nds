#. +> trunk
#: generalpage.cpp:154
msgid "Display Captions"
msgstr "Beschrieven wiesen"

#. +> trunk
#: generalpage.cpp:156
msgid "If this option is enabled, the images' captions will be shown."
msgstr "Is dit anmaakt, warrt de Bildtiteln wiest."

#. +> trunk
#: generalpage.cpp:159
msgid "Open Image with Right Click"
msgstr "Bild mit Rechtsklick opmaken"

#. +> trunk
#: generalpage.cpp:161
msgid "If this option is enabled, the user will be able to open the target image in a separate window using the right mouse button."
msgstr "Is dit anmaakt, kann de Bruker dat Teelbild mit de rechte Muustast in en anner Finster opmaken."

#. +> trunk
#: generalpage.cpp:165
msgid "Open gallery in Konqueror"
msgstr "Sammeln in Konqueror opmaken"

#. +> trunk
#: generalpage.cpp:167
msgid "If this option is enabled, the gallery will be opened in Konqueror automatically."
msgstr "Is dit anmaakt, warrt de Sammeln automaatsch in Konqueror opmaakt."

