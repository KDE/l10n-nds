#: generalpage.cpp:104
msgid "Image Properties"
msgstr "Bildegenschappen"

#. +> trunk
#: generalpage.cpp:106
msgid "Resize Target Images"
msgstr "Teelbillergrött ännern"

#. +> trunk
#: generalpage.cpp:108
msgid "If you enable this option, all target images can be resized."
msgstr "Wenn Du dit anmaakst, kannst Du de Grött vun all Teelbiller ännern."

#. +> trunk
#: generalpage.cpp:112
msgid "Auto-Rotate/Flip Images"
msgstr "Biller automaatsch dreihen/spegeln"

#. +> trunk
#: generalpage.cpp:114
msgid "If you enable this option, the images' orientations will be set according to their Exif information."
msgstr "Wenn Du dit anmaakst, warrt de Bildutrichten na de EXIF-Informatschonen fastleggt."

#. +> trunk
#: generalpage.cpp:121
msgid "&Target Images' Size:"
msgstr "Grött vun de &Teelbiller:"

#. +> trunk
#: generalpage.cpp:122
msgid "The new size of the exported images, in pixels. SimpleViewer resizes the images too, but this resizes the images before they are uploaded to your server."
msgstr "De niege Grött vun't exporteerte Bild in Pixels. SimpleViewer ännert ok de Bildgrött, man dit ännert de Grött vun de Biller, ehr se na den Server hoochlaadt warrt."

#. +> trunk
#: generalpage.cpp:135
msgid "&Displayed Images' Size:"
msgstr "Grött vun de &wiest Biller:"

#. +> trunk
#: generalpage.cpp:136
msgid "Scales the displayed images to this size. Normally, use the height or width of your largest image (in pixels). Images will not be scaled up above this size, to preserve image quality."
msgstr "Passt de wiest Biller na disse Grött to. Normalerwies warrt de gröttst Hööchd oder Breed vun Dien gröttst Bild (in Pixels) bruukt. De Biller warrt nich grötter topasst as hier angeven, so dat ehr Gööd wohrt blifft."

#. +> trunk
#: generalpage.cpp:151
msgid "Misc"
