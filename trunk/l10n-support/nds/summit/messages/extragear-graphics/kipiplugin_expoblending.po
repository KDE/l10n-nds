#. +> trunk
#: blendingdlg/enfusesettings.cpp:98
msgid "Set the number of levels for pyramid blending. A low number trades off quality of results for faster execution time and lower memory usage."
msgstr ""

#. +> trunk
#: blendingdlg/enfusesettings.cpp:102
msgid "Hard Mask"
msgstr ""

#. +> trunk
#: blendingdlg/enfusesettings.cpp:103
msgid "Force hard blend masks and no averaging on finest scale. This is especially useful for focus stacks with thin and high contrast features, improves sharpness at the expense of increased noise."
msgstr ""

#. +> trunk
#: blendingdlg/enfusesettings.cpp:108
msgctxt "enfuse settings"
msgid "Exposure:"
msgstr ""

#. +> trunk
#: blendingdlg/enfusesettings.cpp:113
msgid "Set the exposure contribution for the blending process. Higher values will favour well-exposed pixels."
msgstr ""

#. +> trunk
#: blendingdlg/enfusesettings.cpp:116
msgctxt "enfuse settings"
msgid "Saturation:"
msgstr ""

#. +> trunk
#: blendingdlg/enfusesettings.cpp:121
msgid "Increasing this value makes pixels with high saturation contribute more to the final output."
msgstr ""

#. +> trunk
#: blendingdlg/enfusesettings.cpp:124
msgctxt "enfuse settings"
msgid "Contrast:"
msgstr ""

#. +> trunk
#: blendingdlg/enfusesettings.cpp:129
msgid "Sets the relative weight of high-contrast pixels. Increasing this weight makes pixels with neighboring differently colored pixels contribute more to the final output. Particularly useful for focus stacks."
msgstr ""

#. +> trunk
#: blendingdlg/enfusesettings.cpp:133
msgid "Use Color Appearance Modelling"
msgstr ""

#. +> trunk
#: blendingdlg/enfusesettings.cpp:134
msgid "Use Color Appearance Modelling (CIECAM02) to render detailed colors. Your input files should have embedded ICC profiles. If no ICC profile is present, sRGB color space will be used instead. The difference between using this option and default color blending algorithm is very slight, and will be most noticeable when you need to blend areas of different primary colors together."
msgstr ""

