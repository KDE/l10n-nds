#: importwizard/intropage.cpp:112
msgid "HDR output"
msgstr "HDR-Utgaav"

#. +> trunk
#: importwizard/intropage.cpp:113
msgid "When checked, the panorama will be stitched into an High Dynamic Range (HDR) image, that can be processed further with a dedicated software."
msgstr ""

#. +> trunk
#: importwizard/intropage.cpp:115
msgid "<b>HDR output</b>: Output in High Dynamic Range, meaning that every piece of information contained in the original photos are preserved. Note that you need another software to process the resulting panorama, like <a href=\"http://qtpfsgui.sourceforge.net/\">Luminance HDR</a>"
msgstr ""

