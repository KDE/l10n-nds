#. +> trunk
#: imageplugins/coreplugin/sharpentool.cpp:160
#: utilities/queuemanager/basetools/enhance/sharpen.cpp:90
msgid "A sharpness of 0 has no effect, 1 and above determine the sharpen matrix radius that determines how much to sharpen the image."
msgstr "En Scharpde vun \"0\" hatt keen Effekt, \"1\" un höger gifft dat Halfmaat för de Scharpde-Matrix an, de fastleggt, wo stark dat Bild scharpt warrt."

#. +> trunk
#: imageplugins/coreplugin/sharpentool.cpp:177
#: imageplugins/lenscorrection/vignetting/antivignettingtool.cpp:153
#: imageplugins/noisereduction/noisereductiontool.cpp:133
#: utilities/queuemanager/basetools/enhance/sharpen.cpp:103
