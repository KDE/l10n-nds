#. +> trunk
#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:98
#: imageplugins/whitebalance/whitebalancetool.cpp:282
msgid "Main:"
msgstr "Allgemeen:"

#. +> trunk
#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:104
msgid "<p>This value controls the amount of distortion. Negative values correct lens barrel distortion, while positive values correct lens pincushion distortion."
