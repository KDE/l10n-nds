#. +> trunk
#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:110
msgid "Edge:"
msgstr "Kant:"

#. +> trunk
#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:116
msgid "<p>This value controls in the same manner as the Main control, but has more effect at the edges of the image than at the center."
msgstr "<p>Disse Weert stüert dat sülve Bedregen as de allgemeen Kuntrull, man hett mehr Effekt op de Bildkanten as op de Merrn."

#. +> trunk
#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:121
