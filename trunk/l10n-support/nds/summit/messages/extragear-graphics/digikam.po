#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:242
#: libs/dimg/filters/bw/bwsepiasettings.cpp:328
msgid "Green Filter"
msgstr "Gröönfilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:243
msgid ""
"<b>Black & White with Green Filter</b>:<p>Simulate black and white film "
"exposure using a green filter. This is useful for all scenic shoots, "
"especially portraits photographed against the sky.</p>"
msgstr ""
"<b>Swattwitt mit Gröönfilter</b>:<p>Simuleert en Swattwittopnahm mit "
"Gröönfilter. Dit beedt allgemeen Verbetern för all Opnahmen, sünnerlich för "
"Porträts, de gegen den Heven maakt wöörn.</p>"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:248
msgid "Orange Filter"
msgstr "Orangefilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:249
msgid ""
"<b>Black & White with Orange Filter</b>:<p>Simulate black and white film "
"exposure using an orange filter. This will enhance landscapes, marine scenes "
"and aerial photography.</p>"
msgstr ""
"<b>Swattwitt mit Orangefilter</b>:<p>Simuleert en Swattwittopnahm mit "
"Orangefilter. Dit verbetert Landschap-, Water- un Luftopnahmen.</p>"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:254
msgid "Red Filter"
msgstr "Rootfilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:255
msgid ""
"<b>Black & White with Red Filter</b>:<p>Simulate black and white film "
"exposure using a red filter. This creates dramatic sky effects, and "
"simulates moonlight scenes in the daytime.</p>"
msgstr ""
"<b>Swattwitt mit Rootfilter</b>:<p>Simuleert en Swattwittopnahm mit "
"Rootfilter. De Bruuk vun dissen Filter stellt dramaatsche Heven-Effekten op "
"un simuleert Maandlicht över Dag.</p>"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:260
msgid "Yellow Filter"
msgstr "Geelfilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:261
msgid ""
"<b>Black & White with Yellow Filter</b>:<p>Simulate black and white film "
"exposure using a yellow filter. This has the most natural tonal correction, "
"and improves contrast. Ideal for landscapes.</p>"
msgstr ""
"<b>Swattwitt mit Geelfilter</b>:<p>Simuleert en Swattwittopnahm mit "
"Geelfilter. Gifft natuur-lieke Töön un Kontrastverbetern. Ideaal för "
"Landschapbiller.</p>"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:266
msgid "Yellow-Green Filter"
msgstr "Geel-Gröönfilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:267
msgid ""
"<b>Black & White with Yellow-Green Filter</b>:<p>Simulate black and white "
"film exposure using a yellow-green filter. A yellow-green filter is highly "
"effective for outdoor portraits because red is rendered dark while green "
"appears lighter. Great for correcting skin tones, bringing out facial "
"expressions in close-ups and emphasizing the feeling of liveliness. This "
"filter is highly effective for indoor portraits under tungsten lighting.</p>"
msgstr ""

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:274
msgid "Blue Filter"
msgstr "Blaagfilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:275
#, fuzzy
msgid ""
"<b>Black & White with Blue Filter</b>:<p>Simulate black and white film "
"exposure using a blue filter. This accentuates haze and fog. Used for dye "
"transfer and contrast effects.</p>"
msgstr ""
"<b>Swattwitt mit Blaagfilter</b>:<p>Simuleert en Swattwittopnahm mit "
"Blaagfilter. De Bruuk vun dissen Filter stellt dramaatsche Heven-Effekten op "
"un simuleert Maandlicht över Dag.</p>"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:280
msgid "Strength:"
msgstr "Stärk:"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:286
msgid "Here, set the strength adjustment of the lens filter."
msgstr "Hier kannst Du de Stärk vun den Glasfilter topassen."

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:297
msgid "No Tone Filter"
msgstr "Keen Toonfilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:298
msgid "<b>No Tone Filter</b>:<p>Do not apply a tone filter to the image.</p>"
msgstr "<b>Keen Toonfilter</b>:<p>Keen Toonfilter op dat Bild anwennen</p>"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:301
msgid "Sepia Filter"
msgstr "Sepiafilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:302
msgid ""
"<b>Black & White with Sepia Tone</b>:<p>Gives a warm highlight and mid-tone "
"while adding a bit of coolness to the shadows - very similar to the process "
"of bleaching a print and re-developing in a sepia toner.</p>"
msgstr ""
"<b>Swattwitt mit Sepia-Klöörtoon</b>:<p>Föögt Gleemlichters un Middeltöön "
"wat Warms to, un en beten Küll na de Schaddens. Dat is meist as dat Utbleken "
"un niege Utwickeln in en Sepia-Toner.</p>"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:307
msgid "Brown Filter"
msgstr "Bruunfilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:308
msgid ""
"<b>Black & White with Brown Tone</b>:<p>This filter is more neutral than the "
"Sepia Tone filter.</p>"
msgstr ""
"<b>Swattwitt mit bruun Klöörtoon</b>:<p>Wat neutraler as de Sepia-"
"Klöörtoonfilter.</p>"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:312
#, fuzzy
msgid "Cold Filter"
msgstr "Rootfilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:313
msgid ""
"<b>Black & White with Cold Tone</b>:<p>Start subtly and replicate printing "
"on a cold tone black and white paper such as a bromide enlarging paper.</p>"
msgstr ""
"<b>Swattwitt mit koolt Klöörtoon</b>:<p>Mit de Fieneheiten anfangen un den "
"Utdruck vun en koolt Swattwitt-Papeer namaken, so as bi Bromid-Fotopapeer.</"
"p>"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:318
#, fuzzy
msgid "Selenium Filter"
msgstr "Gröönfilter"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:319
msgid ""
"<b>Black & White with Selenium Tone</b>:<p>This effect replicates "
"traditional selenium chemical toning done in the darkroom.</p>"
msgstr ""
"<b>Swattwitt mit Seleen-Klöörtoon</b>:<p>Effekt, de dat traditschonelle "
"cheemsche Tofögen vun en Seleen-Toon in de Dusterkamer nabillen deit.</p>"

#. +> trunk5
#: libs/dimg/filters/bw/bwsepiasettings.cpp:323
#, fuzzy
