#. +> trunk
#: libs/dimg/filters/transform/freerotationsettings.cpp:90
msgid "Main angle:"
msgstr "Hööftwinkel:"

#. +> trunk
#: libs/dimg/filters/transform/freerotationsettings.cpp:95
msgid "An angle in degrees by which to rotate the image. A positive angle rotates the image clockwise; a negative angle rotates it counter-clockwise."
msgstr "En in Graad angeven Winkel, üm den dat Bild dreiht warrt. En positiv Winkel dreiht dat Bild na rechts, en negativ Winkel na links."

#. +> trunk
#: libs/dimg/filters/transform/freerotationsettings.cpp:99
msgid "Fine angle:"
msgstr "Lüttwinkel:"

#. +> trunk
