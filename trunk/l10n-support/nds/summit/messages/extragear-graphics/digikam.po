msgstr "<p>Disse Weert passt de Bildgrött nieg to."

#. +> trunk
#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:131
msgid "Brighten:"
msgstr "Ophellen:"

#. +> trunk
#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:137
msgid "<p>This value adjusts the brightness in image corners."
msgstr "<p>Disse Weert passt de Helligkeit in de Bildecken to."

#. +> trunk
#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:75
#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:312
