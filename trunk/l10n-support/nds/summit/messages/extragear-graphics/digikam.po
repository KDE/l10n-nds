msgid ""
"<b>No Tone Filter</b>:"
"<p>Do not apply a tone filter to the image.</p>"
msgstr ""
"<b>Keen Toonfilter</b>:"
"<p>Keen Toonfilter op dat Bild anwennen</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:354
msgid "Sepia Tone"
