#. +> trunk
#: utilities/setup/cameraselection.cpp:128
msgid ""
"<p>Select the camera name that you want to use here. All default settings on the right panel will be set automatically.</p>"
"<p>This list has been generated using the gphoto2 library installed on your computer.</p>"
msgstr ""
"<p>Söök hier de Kamera ut, de Du bruken wullt. All Optschonen op de List rechterhand warrt automaatsch instellt.</p>"
"<p>Disse List wöör mit de Bibliotheek \"gphoto2\" opstellt, de op Dien Reekner installeert is.</p>"

#. +> trunk
#: utilities/setup/cameraselection.cpp:137
msgid "Camera Title"
msgstr "Kamera-Naam"

#. +> trunk
#: utilities/setup/cameraselection.cpp:140
msgid "<p>Set here the name used in digiKam interface to identify this camera.</p>"
msgstr "<p>Giff hier den Naam in, de vun de digiKam-Böversiet för de Kamera bruukt warrn schall.</p>"

#. +> trunk
#: utilities/setup/cameraselection.cpp:149
msgid "Camera Port Type"
msgstr "Koppelsteed-Typ vun de Kamera"

#. +> trunk
#: utilities/setup/cameraselection.cpp:154
msgid "USB"
msgstr "USB"

#. +> trunk
#: utilities/setup/cameraselection.cpp:155
msgid "<p>Select this option if your camera is connected to your computer using a USB cable.</p>"
msgstr "<p>Maak dit an, wenn Dien Kamera över en USB-Koppelsteed na Dien Reekner tokoppelt is.</p>"

#. +> trunk
#: utilities/setup/cameraselection.cpp:158
msgid "Serial"
msgstr "Seriell"

#. +> trunk
#: utilities/setup/cameraselection.cpp:159
msgid "<p>Select this option if your camera is connected to your computer using a serial cable.</p>"
msgstr "<p>Maak dit an, wenn Dien Kamera över en seriell Koppelsteed na Dien Reekner tokoppelt is.</p>"

#. +> trunk
#: utilities/setup/cameraselection.cpp:172
msgid "Camera Port Path"
msgstr "Kamerakoppelsteed-Padd"

#. +> trunk
#: utilities/setup/cameraselection.cpp:176
msgid "Note: only for serial port cameras."
msgstr "Beacht: Bloots för seriell tokoppelt Kameras"

#. +> trunk
#: utilities/setup/cameraselection.cpp:180
msgid "<p>Select the serial port to use on your computer here. This option is only required if you use a serial camera.</p>"
msgstr "<p>Söök hier de serielle Koppelsteed ut, de bruukt warrn schall. Dat deit bloots noot, wenn Du Dien Kamera seriell tokoppelst.</p>"

#. +> trunk
#: utilities/setup/cameraselection.cpp:190
msgid "Camera Mount Path"
msgstr "Kamera-Inhangpadd"

#. +> trunk
#: utilities/setup/cameraselection.cpp:194
msgid "Note: only for USB/IEEE mass storage cameras."
msgstr "Beacht: Bloots för USB-/IEEE-Bültspiekerkameras"

#. +> trunk
#: utilities/setup/cameraselection.cpp:198
msgid "<p>Set here the mount path to use on your computer. This option is only required if you use a <b>USB Mass Storage</b> camera.</p>"
msgstr "<p>Giff hier den Inhangoort op Dien Reekner an. Dat deit bloots noot, wenn Du en <b>USB-Bültspieker</b>kamera bruukst.</p>"

#. +> trunk
#: utilities/setup/cameraselection.cpp:217
#, kde-format
msgid ""
"<p>To set a <b>USB Mass Storage</b> camera<br/>"
"(which looks like a removable drive when mounted<br/>"
"on your desktop), please use<br/>"
"<a href=\"umscamera\">%1</a> from the camera list.</p>"
msgstr ""
"<p>Wenn Du en <b>USB-Bültspiekerkamera</b> bruken<br/>"
"wullt (dukt op den Schriefdisch as en tuuschbor Loopwark op,<br/>"
"wenn inhangt), bruuk bitte den Indrag<br/>"
"\"<a href=\"umscamera\">%1</a>\" binnen de Kameralist.</p>"

#. +> trunk
#: utilities/setup/cameraselection.cpp:224
#, kde-format
msgid ""
"<p>To set a <b>Generic PTP USB Device</b><br/>"
"(which uses Picture Transfer Protocol), please<br/>"
"use <a href=\"ptpcamera\">%1</a> from the camera list.</p>"
msgstr ""
"<p>Wenn Du en <b>allgemeen PTP-USB-Reedschap</b> inrichten wullt,<br/>"
"(bruukt dat \"Picture Transfer Protocol\"), bruuk bitte den<br/>"
"Indrag \"<a href=\"ptpcamera\">%1</a>\" op de Kameralist.</p>"

#. +> trunk
#: utilities/setup/cameraselection.cpp:231
msgid ""
"<p>A complete list of camera settings to use is<br/>"
"available at <a href='http://www.teaser.fr/~hfiguiere/linux/digicam.html'>this URL</a>.</p>"
msgstr ""
"<p>En List mit all möögliche Kamerainstellen findt sik op<br/>"
"<a href='http://www.teaser.fr/~hfiguiere/linux/digicam.html'>http://www.teaser.fr/~hfiguiere/linux/digicam.html</a>.</p>"

