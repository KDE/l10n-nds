#: imageplugins/coreplugin/bwsepiatool.cpp:303
msgid "No Lens Filter"
msgstr "Keen Glasfilter"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:304
msgid ""
"<b>No Lens Filter</b>:"
"<p>Do not apply a lens filter when rendering the image.</p>"
msgstr ""
"<b>Keen Glasfilter</b>:"
"<p>Keen Glasfilter bi't Wiesen vun't Bild bruken.</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:308
msgid "Green Filter"
msgstr "Gröönfilter"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:309
msgid ""
"<b>Black & White with Green Filter</b>:"
"<p>Simulate black and white film exposure using a green filter. This is useful for all scenic shoots, especially portraits photographed against the sky.</p>"
msgstr ""
"<b>Swattwitt mit Gröönfilter</b>:"
"<p>Simuleert en Swattwittopnahm mit Gröönfilter. Dit beedt allgemeen Verbetern för all Opnahmen, sünnerlich för Porträts, de gegen den Heven maakt wöörn.</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:315
msgid "Orange Filter"
msgstr "Orangefilter"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:316
msgid ""
"<b>Black & White with Orange Filter</b>:"
"<p>Simulate black and white film exposure using an orange filter. This will enhance landscapes, marine scenes and aerial photography.</p>"
msgstr ""
"<b>Swattwitt mit Orangefilter</b>:"
"<p>Simuleert en Swattwittopnahm mit Orangefilter. Dit verbetert Landschap-, Water- un Luftopnahmen.</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:322
msgid "Red Filter"
msgstr "Rootfilter"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:323
msgid ""
"<b>Black & White with Red Filter</b>:"
"<p>Simulate black and white film exposure using a red filter. This creates dramatic sky effects, and simulates moonlight scenes in the daytime.</p>"
msgstr ""
"<b>Swattwitt mit Rootfilter</b>:"
"<p>Simuleert en Swattwittopnahm mit Rootfilter. De Bruuk vun dissen Filter stellt dramaatsche Heven-Effekten op un simuleert Maandlicht över Dag.</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:329
msgid "Yellow Filter"
msgstr "Geelfilter"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:330
msgid ""
"<b>Black & White with Yellow Filter</b>:"
"<p>Simulate black and white film exposure using a yellow filter. This has the most natural tonal correction, and improves contrast. Ideal for landscapes.</p>"
msgstr ""
"<b>Swattwitt mit Geelfilter</b>:"
"<p>Simuleert en Swattwittopnahm mit Geelfilter. Gifft natuur-lieke Töön un Kontrastverbetern. Ideaal för Landschapbiller.</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:336
msgid "Strength:"
msgstr "Stärk:"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:340
msgid "Here, set the strength adjustment of the lens filter."
msgstr "Hier kannst Du de Stärk vun den Glasfilter topassen."

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:349
msgid "No Tone Filter"
msgstr "Keen Toonfilter"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:350
msgid ""
"<b>No Tone Filter</b>:"
"<p>Do not apply a tone filter to the image.</p>"
msgstr ""
"<b>Keen Toonfilter</b>:"
"<p>Keen Toonfilter op dat Bild anwennen</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:354
msgid "Sepia Tone"
msgstr "Sepia-Klöörtoon"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:355
msgid ""
"<b>Black & White with Sepia Tone</b>:"
"<p>Gives a warm highlight and mid-tone while adding a bit of coolness to the shadows - very similar to the process of bleaching a print and re-developing in a sepia toner.</p>"
msgstr ""
"<b>Swattwitt mit Sepia-Klöörtoon</b>:"
"<p>Föögt Gleemlichters un Middeltöön wat Warms to, un en beten Küll na de Schaddens. Dat is meist as dat Utbleken un niege Utwickeln in en Sepia-Toner.</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:361
msgid "Brown Tone"
msgstr "Bruun Klöörtoon"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:362
msgid ""
"<b>Black & White with Brown Tone</b>:"
"<p>This filter is more neutral than the Sepia Tone filter.</p>"
msgstr ""
"<b>Swattwitt mit bruun Klöörtoon</b>:"
"<p>Wat neutraler as de Sepia-Klöörtoonfilter.</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:367
msgid "Cold Tone"
msgstr "Koolt Klöörtoon"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:368
msgid ""
"<b>Black & White with Cold Tone</b>:"
"<p>Start subtly and replicate printing on a cold tone black and white paper such as a bromide enlarging paper.</p>"
msgstr ""
"<b>Swattwitt mit koolt Klöörtoon</b>:"
"<p>Mit de Fieneheiten anfangen un den Utdruck vun en koolt Swattwitt-Papeer namaken, so as bi Bromid-Fotopapeer.</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:374
msgid "Selenium Tone"
msgstr "Seleen-Klöörtoon"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:375
msgid ""
"<b>Black & White with Selenium Tone</b>:"
"<p>This effect replicates traditional selenium chemical toning done in the darkroom.</p>"
msgstr ""
"<b>Swattwitt mit Seleen-Klöörtoon</b>:"
"<p>Effekt, de dat traditschonelle cheemsche Tofögen vun en Seleen-Toon in de Dusterkamer nabillen deit.</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:380
msgid "Platinum Tone"
msgstr "Platin-Klöörtoon"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:381
msgid ""
"<b>Black & White with Platinum Tone</b>:"
"<p>This effect replicates traditional platinum chemical toning done in the darkroom.</p>"
msgstr ""
"<b>Swattwitt mit Platin-Klöörtoon</b>:"
"<p>Effekt, de dat traditschonelle cheemsche Tofögen vun en Platin-Toon in de Dusterkamer nabillen deit.</p>"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:386
msgid "Green Tone"
msgstr "Grööntoon"

#. +> trunk
#: imageplugins/coreplugin/bwsepiatool.cpp:387
msgid ""
"<b>Black & White with greenish tint</b>:"
"<p>This effect is also known as Verdante.</p>"
msgstr ""
"<b>Swattwitt mit gröön Klöörtoon</b>:"
"<p>Disse Effekt warrt ok »Verdante« nöömt.</p>"

