#. +> trunk
#: tips.cpp:35
msgid ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/kipi.png\">\n"
"</td>"
"\n"
"<td>\n"
"Did you know that Kipi library provide a scanner plugin that gives you direct access to your scanner?\n"
"</td>"
"\n"
"</tr>"
"\n"
"</table>"
"\n"
"</p>"
"\n"
msgstr ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/kipi.png\">\n"
"</td>"
"\n"
"<td>\n"
"Weetst Du al, dat de KIPI-Bibliotheek en Inlees-Moduul praatstellt, mit dat sik direktemang op den Inleser togriepen lett?\n"
"</td>"
"\n"
"</tr>"
"\n"
"</table>"
"\n"
"</p>"
"\n"

#. +> trunk
#: tips.cpp:51
msgid ""
