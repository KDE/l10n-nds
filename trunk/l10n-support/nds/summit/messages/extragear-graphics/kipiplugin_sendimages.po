#. +> trunk
#: emailpage.cpp:141
#, kde-format
msgid ""
"<p>Select here the images size to send:</p><p><b>%1</b>: use this if you "
"have a very slow internet connection or if the target mailbox size is very "
"limited.</p><p><b>%2</b>: use this if you have a slow internet connection "
"and if the target mailbox size is limited.</p><p><b>%3</b>: this is the "
"default value for a medium internet connection and a target mailbox size.</"
"p><p><b>%4</b>: use this if you have a high-speed internet connection and if "
"the target mailbox size is not limited.</p><p><b>%5</b>: use this if you "
"have no size or speed restrictions.</p><p><b>%6</b>: use this only for "
"printing purpose.</p>"
msgstr ""
"<p>Hier kannst Du de Grött fastleggen, mit de de Biller loosstüert warrt.</"
"p><p><b>%1</b>: Bruuk dit bi bannig langsam Internet-Verbinnen oder wenn dat "
"Teel-Postfach bannig lütt is.</p><p><b>%2</b>: För langsam Internet-"
"Verbinnen oder lütt Teel-Postfachen.</p><p><b>%3</b>: De Standard för "
"normaal Internet-Verbinnen un normaal Teel-Postfachen.</p><p><b>%4</b>: "
"Bruuk dit bi gaue Internet-Verbinnen un wenn dat Teel-Postfach keen "
"Gröttgrenz hett.</p><p><b>%5</b>: Bruuk dit, wenn Du Di nich an Gauheit oder "
"Grött kehren bruukst.</p><p><b>%6</b>: Bruuk dit bloots för't Drucken.</p>"

