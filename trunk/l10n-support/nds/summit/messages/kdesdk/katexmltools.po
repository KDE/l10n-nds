#. +> trunk stable
#: plugin_katexmltools.cpp:175
msgid "&Insert Element..."
msgstr "Element &infögen..."

#. +> trunk stable
#: plugin_katexmltools.cpp:177
msgid "&Close Element"
msgstr "Element &tomaken"

#. +> trunk stable
#: plugin_katexmltools.cpp:179
msgid "Assign Meta &DTD..."
msgstr "Meta-&DTD towiesen..."

#. +> trunk stable
#: plugin_katexmltools.cpp:485
msgid "Assign Meta DTD in XML Format"
msgstr "Meta-DTD in't XML-Formaat towiesen"

#. +> trunk stable
#: plugin_katexmltools.cpp:490
#, kde-format
msgid "The current file has been identified as a document of type \"%1\". The meta DTD for this document type will now be loaded."
msgstr "De aktuell Datei warrt as Dokmenttyp \"%1\" in de Künn kregen. De Meta-DTD för dissen Dokmenttyp warrt nu laadt."

#. +> trunk stable
#: plugin_katexmltools.cpp:493
msgid "Loading XML Meta DTD"
msgstr "XML-Meta-DTD warrt laadt"

#. +> trunk stable
#: plugin_katexmltools.cpp:528
#, kde-format
msgid "The file '%1' could not be opened. The server returned an error."
msgstr "De Datei \"%1\" lett sik nich opmaken. De Server hett en Fehler torüchgeven."

#. +> trunk stable
#: plugin_katexmltools.cpp:530 pseudo_dtd.cpp:50 pseudo_dtd.cpp:61
msgid "XML Plugin Error"
msgstr "Fehler vun dat XML-Moduul"

#. +> trunk stable
#: plugin_katexmltools.cpp:1128
msgid "Insert XML Element"
msgstr "XML-Element infögen"

#. +> trunk stable
#: plugin_katexmltools.cpp:1153
msgid "Enter XML tag name and attributes (\"<\", \">\" and closing tag will be supplied):"
msgstr "Giff den XML-Elementnaam un de Attributen in. (\"<\", \">\" un de Afsluut-Beteker warrt automaatsch inföögt):"

#. +> trunk stable
#: pseudo_dtd.cpp:48
#, kde-format
msgid "The file '%1' could not be parsed. Please check that the file is well-formed XML."
msgstr "De Datei \"%1\" lett sik nich inlesen. Bitte prööv, wat de Datei gootformt XML is."

#. +> trunk stable
#: pseudo_dtd.cpp:56
#, kde-format
msgid ""
"The file '%1' is not in the expected format. Please check that the file is of this type:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"You can produce such files with dtdparse. See the Kate Plugin documentation for more information."
msgstr ""
"De Datei \"%1\" hett nich dat verwacht Formaat. Bitte prööv, wat de Datei vun dissen Typ is:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"So'n Datei kannst Du mit \"dtdparse\" opstellen. In de Kate-Moduuldokmentatschoon laat sik mehr Informatschonen finnen."

#. +> trunk stable
#: pseudo_dtd.cpp:71
msgid "Analyzing meta DTD..."
msgstr "Meta-DTD warrt ünnersöcht..."

#. +> trunk stable
#: pseudo_dtd.cpp:71
msgid "Cancel"
msgstr "Afbreken"

