#. +> trunk stable
#: svn/ksvnd/ksvnd.desktop:3
msgctxt "Name"
msgid "KDED Subversion Module"
msgstr "KDED Subversion-Moduul"

#. +> trunk stable
#: svn/svn+file.protocol:15 svn/svn+http.protocol:15 svn/svn+https.protocol:15
#: svn/svn+ssh.protocol:15 svn/svn.protocol:15
msgctxt "Description"
msgid "Subversion ioslave"
msgstr "In-/Utgaavmoduul för Subversion"

#. +> trunk stable
#: svn/svnhelper/apply_patch.desktop:8
msgctxt "Name"
msgid "Apply Patch..."
msgstr "Kodeplaster inspelen..."

#. +> trunk stable
#: svn/svnhelper/apply_patch.desktop:66
msgctxt "Comment"
msgid "Apply the patch to another folder/file"
msgstr "Kodeplaster op en anner Orner/Datei anwennen"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion"
msgstr "Subversion"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:71
msgctxt "Name"
msgid "Add to Repository"
msgstr "Na't Archiv tofögen"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:131
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Ut Archiv wegdoon"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:190
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Lokaal Ännern torüchnehmen"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:245
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr "All lokaal Ännern wegdoon. Wohrschoen - Dit lett sik nich torüchnehmen."

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:296
msgctxt "Name"
msgid "Rename..."
msgstr "Ümnömen..."

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:359
msgctxt "Comment"
msgid "Rename a file locally and in the repository.  Use this rather than adding and deleting to rename a file."
msgstr "En Datei lokaal un in't Archiv ümnömen.  Bruuk beter dit, as \"Tofögen\" un \"Wegdoon\"."

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:410
msgctxt "Name"
msgid "Import Repository"
msgstr "Archiv importeren"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:467
msgctxt "Comment"
msgid "Put folder into an existing repository to put it under revision control."
msgstr "Verschufft en Orner na en vörhannen Archiv, so dat he ünner Verschoonkuntrull kummt"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:518
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Ut Archiv daalladen..."

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:572
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Laadt Dateien ut en vörhannen Archiv na dissen Orner daal."

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:623
msgctxt "Name"
msgid "Switch..."
msgstr "Telg wesseln..."

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:680
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Arbeitkopie na en annern Telg verschuven"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:733
msgctxt "Name"
msgid "Merge..."
msgstr "Tosamenföhren..."

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:792
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Ännern twischen dissen un en annern Telg tosamenföhren"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:844
msgctxt "Name"
msgid "Blame..."
msgstr "Naspören..."

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:898
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Wiest, wokeen wannehr welke Dateiregen ännert hett"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:950
msgctxt "Name"
msgid "Create Patch..."
msgstr "Kodeplaster opstellen..."

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:1010
msgctxt "Name"
msgid "Export..."
msgstr "Exporteren..."

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:1074
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr "En Boomkopie ahn Verschooninformatschoon ut en Archiv utlesen"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:1125
msgctxt "Name"
msgid "Diff (local)"
msgstr "Verscheel (lokaal)"

#. +> trunk stable
#: svn/svnhelper/subversion.desktop:1182
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Lokaal Ännern na de verleden Opfrischen wiesen"

#. +> trunk stable
#: svn/svnhelper/subversion_toplevel.desktop:11
msgctxt "Name"
msgid "SVN Update"
msgstr "SVN-Archiv opfrischen"

#. +> trunk stable
#: svn/svnhelper/subversion_toplevel.desktop:71
msgctxt "Name"
msgid "SVN Commit"
msgstr "Na SVN-Archiv inspelen"
