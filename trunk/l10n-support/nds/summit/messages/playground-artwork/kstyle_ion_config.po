#. i18n: ectx: property (windowTitle), widget (QWidget, StyleDialog)
#. +> trunk
#: styledialog.ui:16
msgid "Style Dialog"
msgstr "Stil-Dialoog"

#. i18n: ectx: property (title), widget (QGroupBox, stylebox)
#. +> trunk
#: styledialog.ui:22
msgid "Style Settings"
msgstr "Stil instellen"

#. i18n: ectx: property (text), widget (QCheckBox, embossed)
#. +> trunk
#: styledialog.ui:28
msgid "&Emboss"
msgstr "&Ingraven"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, embossed)
#. +> trunk
#: styledialog.ui:31
msgid "This option will enable an embossed effect for many widgets"
msgstr "Disse Instellen stellt för vele Lüttprogrammen en Ingraav-Effekt praat."

#. i18n: ectx: property (text), widget (QCheckBox, gradients)
#. +> trunk
#: styledialog.ui:38
msgid "Use &gradients"
msgstr "Klööröver&gäng bruken"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, gradients)
#. +> trunk
#: styledialog.ui:41
msgid "This option will draw buttons and several other widgets using a gradient texture"
msgstr "Disse Optschoon gifft Knööp un anner Bedeenelementen en Klöörövergang"

#. i18n: ectx: property (text), widget (QCheckBox, hlfocus)
#. +> trunk
#: styledialog.ui:48
msgid "Highlight widget with input &focus"
msgstr "Bedeenelement mit Ingaav&feld rutheven"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, hlfocus)
#. +> trunk
#: styledialog.ui:51
msgid "This option will highlight line edit and similar widgets when they have input focus"
msgstr "Disse Optschoon heevt aktive Elementen rut, a.B. Ingaavfeller."

#. i18n: ectx: property (text), widget (QLabel, hllabel)
#. +> trunk
#: styledialog.ui:60
msgid "&Highlight on mouse hover (width)"
msgstr "Bi't Anrögen mit de Muus &rutheven"

#. i18n: ectx: property (whatsThis), widget (QLabel, hllabel)
#. i18n: ectx: property (whatsThis), widget (QSpinBox, highlights)
#. +> trunk
#: styledialog.ui:66 styledialog.ui:79
msgid "This option will highlight buttons and several other widgets when the mouse cursor is over them (set to '0' to disable)"
msgstr "Disse Optschoon heevt Knööp un anner Bedeenelementen bi't Anrögen mit de Muus rut (warrt mit \"0\" utmaakt)"
