#. +> trunk stable
#: settings.ui:117
msgid "Easy"
msgstr "Eenfach"

#. i18n: ectx: property (text), widget (QLabel, textLabel3)
#. +> trunk stable
#: settings.ui:124
msgid "Hard"
msgstr "Swoor"

#. i18n: ectx: property (title), widget (QGroupBox, speed_groupBox)
#. +> trunk stable
#: settings.ui:137
msgid "Piece Removal Speed"
msgstr "Gauheit för't Steenwegdoon"

#. i18n: ectx: property (whatsThis), widget (QGroupBox, speed_groupBox)
#. +> trunk stable
#: settings.ui:140
msgid ""
"<b>Piece Removal Speed</b>"
"<p>Adjusting this slider alters the speed at which the pieces are removed from the screen after a match has been made.</p>"
msgstr ""
"<b>Gauheit för't Steenwegdoon</b>"
"<p>Disse Schuverinstellen ännert de Gauheit, mit de de Steen an't Speelenn vun den Schirm wegmaakt warrt.</p>"

#. i18n: ectx: property (text), widget (QLabel, textLabel6)
#. +> trunk stable
#: settings.ui:164
msgid "Fast"
msgstr "Gau"

#. i18n: ectx: property (text), widget (QLabel, textLabel4)
#. +> trunk stable
#: settings.ui:174
msgid "Slow"
msgstr "Langsam"

#. i18n: ectx: property (title), widget (QGroupBox, size_groupBox)
#. +> trunk stable
#: settings.ui:203
msgid "Tile Size"
msgstr "Steentall"

#. i18n: ectx: property (whatsThis), widget (QGroupBox, size_groupBox)
#. +> trunk stable
#: settings.ui:206
msgid ""
"<b>Tile Size</b>"
"<p>This slider allows you to change the number of tiles on the board. The more tiles you have, the harder (and longer) the game will be.</p>"
msgstr ""
"<b>Steentall</b>"
"<p>Mit dissen Schuver lett sik de Tall vun Steen ännern. Mit mehr Steen warrt dat Speel sworer un duert länger.</p>"

