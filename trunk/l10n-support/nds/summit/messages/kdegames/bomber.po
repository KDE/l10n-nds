msgid "Lives: %1"
msgstr "Leven: %1"

#. +> trunk stable
#: src/bomber.cpp:83
msgctxt "Menu item used to disable or enable sound"
msgid "&Play Sounds"
msgstr "Kläng &afspelen"

#. +> trunk stable
#: src/bomber.cpp:88
msgctxt "The name of the action used for dropping bombs"
msgid "&Drop bomb"
msgstr "Bomb &afsmieten"

#. +> trunk stable
#: src/bomber.cpp:89
msgctxt "The tool tip text for the action used to drop bombs"
msgid "Drop bomb"
msgstr "Bomb afsmieten"

#. +> trunk stable
#: src/bomber.cpp:91
msgctxt "Description of the action used to drop bombs"
msgid "Makes the plane drop a bomb while flying"
msgstr "Smitt bi't Flegen en Bomb af"

#. +> trunk stable
#: src/bomber.cpp:138
msgctxt "Message displayed when play tries to quit a game that is currently running"
msgid "Do you really want to close the running game?"
msgstr "Wullt Du dat lopen Speel redig utmaken?"

#. +> trunk stable
#: src/bomber.cpp:179
msgid "Theme"
msgstr "Muster"

#. +> trunk stable
#: src/bomber.cpp:231
#, kde-format
msgctxt "Game over messaged displayed in the status bar"
msgid "Game over. Press '%1' for a new game"
msgstr "Speel vörbi. Mit \"%1\" fangt en nieg Speel an"

