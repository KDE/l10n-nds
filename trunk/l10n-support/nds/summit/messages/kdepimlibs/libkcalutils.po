msgid ""
"An attendee was added to the incidence. Do you want to email the attendees an "
"update message?"
msgstr ""
"En Deelnehmer wöör dat Begeefnis toföögt. Wullt Du de Deelnehmers per "
"Nettpost en opfrischt Bescheed tostüern?"

#. +> trunk stable
#: scheduler.cpp:246
msgctxt "@info"
msgid ""
"<para>You accepted an invitation update, but an earlier version of the item "
"could not be found in your calendar.</para>"
"<para>This may have occurred because:"
"<list>"
"<item>the organizer did not include you in the original invitation</item>"
"<item>you did not accept the original invitation yet</item>"
"<item>you deleted the original invitation from your calendar</item>"
"<item>you no longer have access to the calendar containing the invitation<"
"/item>"
"</list>"
"</para>"
"<para>This is not a problem, but we thought you should know.</para>"
msgstr ""
"<para>Du wullt en Inladen opfrischen annahmen, man Dien Kalenner bargt dor "
"keen öller Verschoon vun.</para>"
"<para>Villicht…"
"<list>"
"<item>hett de Utrichter Di de Orginaal-Inladen nich tostüert</item>"
"<item>hest Du de Orginaal-Inladen noch nich annahmen</item>"
"<item>hest Du de Orginaal-Inladen ut Dien Kalenner wegmaakt</item>"
"<item>kannst Du nich mehr op den Kalenner togriepen, de de Inladen bargt<"
"/item>"
"</list>"
"</para>"
"<para>Dit is twaars allens keen Problem, man villicht wullt Du dat liekers "
"weten.</para>"

