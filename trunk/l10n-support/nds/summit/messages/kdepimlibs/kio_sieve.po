#. +> future stable
#: sieve.cpp:336
#, kde-format
msgid "Connecting to %1..."
msgstr "An't Tokoppeln na %1..."

#. +> future stable
#: sieve.cpp:339
msgid "The connection to the server was lost."
msgstr "De Verbinnen na den Server is afreten."

#. +> future stable
#: sieve.cpp:351
msgid "Server identification failed."
msgstr "Serveridentifikatschoon fehlslaan."

#. +> future stable
#: sieve.cpp:357
msgid "Can not use TLS since the underlying Qt library does not support it."
msgstr "TLS lett sik nich bruken, de bruukte Qt-Bibliotheek ünnerstütt dat nich."

#. +> future stable
#: sieve.cpp:364
msgid ""
"TLS encryption was requested, but your Sieve server does not advertise TLS in its capabilities.\n"
"You can choose to try to initiate TLS negotiations nonetheless, or cancel the operation."
msgstr ""
"Du wullt TLS bruken, man Dien Sieve-Server seggt nich, he kann TLS bruken.\n"
"Du kannst dat versöken un TLS uthanneln oder de Akschoon afbreken."

#. +> future stable
#: sieve.cpp:366
msgid "Server Does Not Advertise TLS"
msgstr "Server seggt nich, he kann TLS bruken"

#. +> future stable
#: sieve.cpp:366
msgid "&Start TLS nonetheless"
msgstr "&TLS liekers bruken"

#. +> future stable
#: sieve.cpp:366
msgid "&Cancel"
msgstr "&Afbreken"

#. +> future stable
#: sieve.cpp:367
msgid "TLS encryption requested, but not supported by server."
msgstr "TLS-Verslöteln anfraagt, man Server ünnerstütt dat nich."

#. +> future stable
#: sieve.cpp:388
msgid "Your Sieve server claims to support TLS, but negotiation was unsuccessful."
msgstr "Dien Sieve-Server gifft an, he ünnerstütt TLS, man dat Uthanneln harr keen Spood."

#. +> future stable
#: sieve.cpp:390
msgid "Connection Failed"
msgstr "Tokoppeln fehlslaan"

#. +> future stable
#: sieve.cpp:397
msgid "The server does not seem to support TLS. Disable TLS if you want to connect without encryption."
msgstr "As't lett ünnerstütt de Server TLS nich. Maak dat ut, wenn Du Di ahn Verslöteln tokoppeln wullt."

#. +> future stable
#: sieve.cpp:409
msgid "Authenticating user..."
msgstr "Identiteetprööv för Bruker..."

#. +> future stable
#: sieve.cpp:412
msgid "Authentication failed."
msgstr "Identiteetprööv fehlslaan."

#. +> future stable
#: sieve.cpp:476
msgctxt "special command completed"
msgid "Done."
msgstr "Afslaten."

#. +> future stable
#: sieve.cpp:489
msgid "Activating script..."
msgstr "Skript warrt anmaakt..."

#. +> future stable
#: sieve.cpp:506
msgid "There was an error activating the script."
msgstr "Bi't Aktiveren vun dat Skript geev dat en Fehler."

#. +> future stable
#: sieve.cpp:526
msgid "There was an error deactivating the script."
msgstr "Bi't Utdeenststellen vun dat Skript geev dat en Fehler."

#. +> future stable
#: sieve.cpp:558
msgid "Sending data..."
msgstr "Daten warrt sendt..."

#. +> future stable
#: sieve.cpp:575
msgid "KIO data supply error."
msgstr "KIO-Fehler bi't Praatstellen vun Daten."

#. +> future stable
#: sieve.cpp:626 sieve.cpp:1165
msgid "Network error."
msgstr "Nettwarkfehler"

#. +> future stable
#: sieve.cpp:638
msgid "Verifying upload completion..."
msgstr "Pröven, wat dat Hoochladen fardig is..."

#. +> future stable
#: sieve.cpp:662 sieve.cpp:669
#, kde-format
msgid ""
"The script did not upload successfully.\n"
"This is probably due to errors in the script.\n"
"The server responded:\n"
"%1"
msgstr ""
"Bi't Hoochladen vun dat Skript geev dat en Fehler,\n"
"wohrschienlich gifft dat Fehlers dor binnen.\n"
"De Server anter:\n"
"%1"

#. +> future stable
#: sieve.cpp:673 sieve.cpp:677
msgid ""
"The script did not upload successfully.\n"
"The script may contain errors."
msgstr ""
"Bi't Hoochladen vun dat Skript geev dat en Fehler,\n"
"villicht gifft dat Fehlers dor binnen."

#. +> future stable
#: sieve.cpp:685
msgctxt "data upload complete"
msgid "Done."
msgstr "Fardig."

#. +> future stable
#: sieve.cpp:717
msgid "Retrieving data..."
msgstr "Daten warrt haalt..."

#. +> future stable
#: sieve.cpp:767
msgid "Finishing up..."
msgstr "Fardig maken..."

#. +> future stable
#: sieve.cpp:776
msgid "A protocol error occurred while trying to negotiate script downloading."
msgstr "Bi't Uthanneln för dat Skript-Daalladen geev dat en Protokollfehler."

#. +> future stable
#: sieve.cpp:781
msgctxt "data retrival complete"
msgid "Done."
msgstr "Afslaten."

#. +> future stable
#: sieve.cpp:788
msgid "Folders are not supported."
msgstr "Ornern warrt nich ünnerstütt."

#. +> future stable
#: sieve.cpp:797
msgid "Deleting file..."
msgstr "Datei warrt wegdaan..."

#. +> future stable
#: sieve.cpp:813
msgid "The server would not delete the file."
msgstr "De Server will de Datei nich wegdoon."

#. +> future stable
#: sieve.cpp:817
msgctxt "file removal complete"
msgid "Done."
msgstr "Afslaten."

#. +> future stable
#: sieve.cpp:832
msgid "Cannot chmod to anything but 0700 (active) or 0600 (inactive script)."
msgstr "Du kannst de Rechten op nix anners as 0700 (aktiv Skript) oder 0600 (nich aktiv) setten."

#. +> future stable
#: sieve.cpp:998
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "Bi de Identiteetprööv geev dat en Fehler: %1"

#. +> future stable
#: sieve.cpp:1022
msgid "Sieve Authentication Details"
msgstr "Angaven för de Sieve-Identiteetprööv"

#. +> future stable
#: sieve.cpp:1023
msgid "Please enter your authentication details for your sieve account (usually the same as your email password):"
msgstr "Giff bitte de Identiteetprööv-Angaven för Dien Sieve-Konto in (normalerwies dat Sülve as Dien Nettpost-Passwoort):"

#. +> future stable
#: sieve.cpp:1096
#, kde-format
msgid ""
"A protocol error occurred during authentication.\n"
"Choose a different authentication method to %1."
msgstr ""
"Bi de Identiteetprööv geev dat en Protokollfehler.\n"
"Söök bitte en anner Identiteetpröövmetood för %1 ut."

#. +> future stable
#: sieve.cpp:1135
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded:\n"
"%1"
msgstr ""
"Identiteetprööv fehlslaan.\n"
"Wohrschienlich is dat Passwoort leeg.\n"
"De Server anter:\n"
"%1"

#. +> future stable
#: sieve.cpp:1220
msgid "A protocol error occurred."
msgstr "Dat geev en Protokollfehler."

#~ msgid "Quota exceeded"
#~ msgstr "Över Bruukgrenz"

#~ msgid "No authentication details supplied."
#~ msgstr "Keen Angaven för de Identiteetprööv praatstellt."
