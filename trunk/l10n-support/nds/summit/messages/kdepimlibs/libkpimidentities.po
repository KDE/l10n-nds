#. +> trunk stable
#: signature.cpp:98
#, kde-format
msgid ""
"<qt>Failed to execute signature script"
"<p><b>%1</b>:</p>"
"<p>%2</p>"
"</qt>"
msgstr ""
"<qt>Fehler bi't Utföhren vun't Signatuurskript"
"<p><b>%1</b>:</p>"
"<p>%2</p>"
"</qt>"

#. +> trunk stable
#: signatureconfigurator.cpp:82
msgid "&Enable signature"
msgstr "Signat&uur bruken"

#. +> trunk stable
#: signatureconfigurator.cpp:84
msgid "Check this box if you want KMail to append a signature to mails written with this identity."
msgstr "Maak dit an, wenn KMail de Narichten vun disse Identiteet en Signatuur anhangen schall."

#. +> trunk stable
#: signatureconfigurator.cpp:94
msgid "Click on the widgets below to obtain help on the input methods."
msgstr "Klick op de Elementen nerrn, wenn Du Hülp för de Ingaavmetoden hebben wullt."

#. +> trunk stable
#: signatureconfigurator.cpp:98
msgctxt "continuation of \"obtain signature text from\""
msgid "Input Field Below"
msgstr "dat Ingaavfeld nerrn"

#. +> trunk stable
#: signatureconfigurator.cpp:100
msgctxt "continuation of \"obtain signature text from\""
msgid "File"
msgstr "Datei"

#. +> trunk stable
#: signatureconfigurator.cpp:102
msgctxt "continuation of \"obtain signature text from\""
msgid "Output of Command"
msgstr "de Utgaav vun en Programm"

#. +> trunk stable
#: signatureconfigurator.cpp:104
msgid "Obtain signature &text from:"
msgstr "Signatuur&text bruken ut"

#. +> trunk stable
#: signatureconfigurator.cpp:146
msgid "Use this field to enter an arbitrary static signature."
msgstr "Hier kannst Du Dien faste Signatuur ingeven."

#. +> trunk stable
#: signatureconfigurator.cpp:185 signatureconfigurator.cpp:389
msgid "&Use HTML"
msgstr "HTML &bruken"

#. +> trunk stable
#: signatureconfigurator.cpp:204
msgid "Use this requester to specify a text file that contains your signature. It will be read every time you create a new mail or append a new signature."
msgstr "Bruuk dissen Knoop, wenn Du de Datei mit Dien Signatuur utsöken wullt. Se warrt jümmers leest, wenn Du en nieg Nettbreef opstellt oder Dien Signatuur anföögst."

#. +> trunk stable
#: signatureconfigurator.cpp:207
msgid "S&pecify file:"
msgstr "&Datei angeven:"

#. +> trunk stable
#: signatureconfigurator.cpp:214
msgid "Edit &File"
msgstr "Datei &bewerken"

#. +> trunk stable
#: signatureconfigurator.cpp:215
msgid "Opens the specified file in a text editor."
msgstr "Maakt de angeven Datei mit en Texteditor op."

#. +> trunk stable
#: signatureconfigurator.cpp:235
msgid "You can add an arbitrary command here, either with or without path depending on whether or not the command is in your Path. For every new mail, KMail will execute the command and use what it outputs (to standard output) as a signature. Usual commands for use with this mechanism are \"fortune\" or \"ksig -random\"."
msgstr "Hier kannst Du jichtenseen Befehl mit oder ahn sien Padd angeven, afhangen dor vun, wat sik de Befehl över Dien PATH-Variabel finnen lett. KMail röppt den Befehl jümmers op, wenn en Signatuur inföögt warrt, un bruukt em sien Utgaav (op de Standardutgaav) as Signatuurtext. Faken warrt hier de Befehlen \"fortune\" un \"ksig --random\" bruukt."

#. +> trunk stable
#: signatureconfigurator.cpp:240
msgid "S&pecify command:"
msgstr "&Befehl angeven:"

#. +> trunk stable
#: signatureconfigurator.cpp:398
msgid "&Use HTML (disabling removes formatting)"
msgstr "HTML &bruken (Utmaken maakt Formateren weg)"

