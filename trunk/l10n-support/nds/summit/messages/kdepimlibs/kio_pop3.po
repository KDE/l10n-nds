#. +> trunk stable
#: pop3.cpp:236
#, kde-format
msgid "The server said: \"%1\""
msgstr "Servermellen: \"%1\""

#. +> trunk stable
#: pop3.cpp:258
msgid "The server terminated the connection."
msgstr "De Server hatt de Verbinnen afbraken."

#. +> trunk stable
#: pop3.cpp:260
#, kde-format
msgid ""
"Invalid response from server:\n"
"\"%1\""
msgstr ""
"Serverantwoort gellt nich:\n"
"\"%1\""

#. +> trunk stable
#: pop3.cpp:297
msgid "Could not send to server.\n"
msgstr "Na Server sennen nich mööglich.\n"

#. +> trunk stable
#: pop3.cpp:350 pop3.cpp:408 pop3.cpp:597
msgid "No authentication details supplied."
msgstr "Keen Angaven för de Identiteetprööv praatstellt."

#. +> trunk stable
#: pop3.cpp:386
#, kde-format
msgid ""
"Login via APOP failed. The server %1 may not support APOP, although it claims to support it, or the password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Anmellen över APOP fehlslaan. De Server \"%1\" ünnerstütt dat villicht nich, ok wenn he dat angifft, oder villicht is ok dat Passwoort leeg.\n"
"\n"
"%2"

#. +> trunk stable
#: pop3.cpp:446
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "Bi de Identiteetprööv geev dat en Fehler: %1"

#. +> trunk stable
#: pop3.cpp:566
#, kde-format
msgid ""
"Login via SASL (%1) failed. The server may not support %2, or the password may be wrong.\n"
"\n"
"%3"
msgstr ""
"Anmellen över SASL (%1) fehlslaan. De Server ünnerstütt %2 villicht nich, oder villicht is ok dat Passwoort leeg.\n"
"\n"
"%3"

#. +> trunk stable
#: pop3.cpp:575
msgid ""
"Your POP3 server does not support SASL.\n"
"Choose a different authentication method."
msgstr ""
"Dien POP3-Server ünnerstütt SASL nich.\n"
"Söök en anner Anmellmetood ut."

#. +> trunk stable
#: pop3.cpp:583
msgid "SASL authentication is not compiled into kio_pop3."
msgstr "De Identiteetprööv över SASL is nich na kio_pop3 inkompileert."

#. +> trunk stable
#: pop3.cpp:615 pop3.cpp:664
#, kde-format
msgid ""
"Could not login to %1.\n"
"\n"
msgstr ""
"Anmellen bi \"%1\" nich mööglich.\n"
"\n"

#. +> trunk stable
#: pop3.cpp:629
#, kde-format
msgid ""
"Could not login to %1. The password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Anmellen bi \"%1\" nich mööglich. Villicht is dat Passwoort leeg.\n"
"\n"
"%2"

#. +> trunk stable
#: pop3.cpp:667
msgid "The server terminated the connection immediately."
msgstr "De Server hett de Verbinnen fuurts afbraken."

#. +> trunk stable
#: pop3.cpp:668
#, kde-format
msgid ""
"Server does not respond properly:\n"
"%1\n"
msgstr ""
"De Server antert nich op de richtige Oort:\n"
"%1\n"

#. +> trunk stable
#: pop3.cpp:696
msgid ""
"Your POP3 server does not support APOP.\n"
"Choose a different authentication method."
msgstr ""
"Dien POP3-Server ünnerstütt APOP nich.\n"
"Bitte söök en anner Anmellmetood ut."

#. +> trunk stable
#: pop3.cpp:714
msgid "Your POP3 server claims to support TLS but negotiation was unsuccessful. You can disable TLS in KDE using the crypto settings module."
msgstr "Dien POP3-Server gifft an, dat he TLS ünnerstütt, man dat Uthanneln is fehlslaan. Du kannst TLS in KDE över dat Kuntrullmoduul \"Verslöteln\" utmaken."

#. +> trunk stable
#: pop3.cpp:724
msgid "Your POP3 server does not support TLS. Disable TLS, if you want to connect without encryption."
msgstr "Dien POP3-Server ünnerstütt TLS nich. Maak dat ut, wenn Du Di ahn Verslöteln tokoppeln wullt."

#. +> trunk stable
#: pop3.cpp:733
msgid "Username and password for your POP3 account:"
msgstr "Brukernaam un Passwoort för Dien POP3-Konto:"

#. +> trunk stable
#: pop3.cpp:900 pop3.cpp:909 pop3.cpp:1044
msgid "Unexpected response from POP3 server."
msgstr "Nich verwacht Antwoort vun den POP3-Server."
