#. +> trunk stable
#: pop3.cpp:218
#, kde-format
msgid "The server said: \"%1\""
msgstr "Servermellen: \"%1\""

#. +> trunk stable
#: pop3.cpp:240
msgid "The server terminated the connection."
msgstr "De Server hett de Verbinnen afbraken."

#. +> trunk stable
#: pop3.cpp:242
#, kde-format
msgid ""
"Invalid response from server:\n"
"\"%1\""
msgstr ""
"Serverantwoort gellt nich:\n"
"\"%1\""

#. +> trunk stable
#: pop3.cpp:281
msgid "Could not send to server.\n"
msgstr "Na Server sennen nich mööglich.\n"

#. +> trunk stable
#: pop3.cpp:334 pop3.cpp:391 pop3.cpp:568
msgid "No authentication details supplied."
msgstr "Keen Angaven för de Identiteetprööv praatstellt."

#. +> trunk stable
#: pop3.cpp:370
#, kde-format
msgid ""
"Login via APOP failed. The server %1 may not support APOP, although it claims to support it, or the password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Anmellen över APOP fehlslaan. De Server \"%1\" ünnerstütt dat villicht nich, ok wenn he dat angifft, oder villicht is ok dat Passwoort leeg.\n"
"\n"
"%2"

#. +> trunk stable
#: pop3.cpp:426
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "Bi de Identiteetprööv geev dat en Fehler: %1"

#. +> trunk stable
#: pop3.cpp:545
#, kde-format
msgid ""
"Login via SASL (%1) failed. The server may not support %2, or the password may be wrong.\n"
"\n"
"%3"
msgstr ""
"Anmellen över SASL (%1) fehlslaan. De Server ünnerstütt %2 villicht nich, oder villicht is ok dat Passwoort leeg.\n"
"\n"
"%3"

#. +> trunk stable
#: pop3.cpp:554
#, kde-format
msgid ""
"Your POP3 server (%1) does not support SASL.\n"
"Choose a different authentication method."
msgstr ""
"Dien POP3-Server (%1) ünnerstütt SASL nich.\n"
"Söök en anner Anmellmetood ut."

#. +> trunk stable
#: pop3.cpp:586 pop3.cpp:635
#, kde-format
msgid ""
"Could not login to %1.\n"
"\n"
msgstr ""
"Anmellen bi \"%1\" nich mööglich.\n"
"\n"

#. +> trunk stable
#: pop3.cpp:600
#, kde-format
msgid ""
"Could not login to %1. The password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Anmellen bi \"%1\" nich mööglich. Villicht is dat Passwoort leeg.\n"
"\n"
"%2"

#. +> trunk stable
#: pop3.cpp:638
msgid "The server terminated the connection immediately."
msgstr "De Server hett de Verbinnen fuurts afbraken."

#. +> trunk stable
#: pop3.cpp:639
#, kde-format
msgid ""
"Server does not respond properly:\n"
"%1\n"
msgstr ""
"De Server antert nich op de richtige Oort:\n"
"%1\n"

#. +> trunk stable
#: pop3.cpp:668
#, kde-format
msgid ""
"Your POP3 server (%1) does not support APOP.\n"
"Choose a different authentication method."
msgstr ""
"Dien POP3-Server (%1) ünnerstütt APOP nich.\n"
"Bitte söök en anner Anmellmetood ut."

#. +> trunk stable
#: pop3.cpp:686
msgid ""
"Your POP3 server claims to support TLS but negotiation was unsuccessful.\n"
"You can disable TLS in the POP account settings dialog."
msgstr ""
"Dien POP3-Server gifft an, dat he TLS ünnerstütt, man dat Uthanneln is fehlslaan.\n"
"Du kannst TLS in de Instellen för dat POP-Konto utmaken."

#. +> trunk stable
#: pop3.cpp:695
#, kde-format
msgid "Your POP3 server (%1) does not support TLS. Disable TLS, if you want to connect without encryption."
msgstr "Dien POP3-Server (%1) ünnerstütt TLS nich. Maak dat ut, wenn Du Di ahn Verslöteln tokoppeln wullt."

#. +> trunk stable
#: pop3.cpp:704
msgid "Username and password for your POP3 account:"
msgstr "Brukernaam un Passwoort för Dien POP3-Konto:"

#. +> trunk stable
#: pop3.cpp:872 pop3.cpp:881 pop3.cpp:1023
msgid "Unexpected response from POP3 server."
msgstr "Nich verwacht Antwoort vun den POP3-Server."

#. +> trunk stable
#: pop3.cpp:886
#, kde-format
msgid "Error during communication with the POP3 server while trying to list mail: %1"
msgstr "Fehler bi't Snacken mit den POP3-Server bi't Oplisten vun Nettpost: %1"

#. +> trunk stable
#: pop3.cpp:988
#, kde-format
msgid "Error during communication with the POP3 server while trying to download mail: %1"
msgstr "Fehler bi't Snacken mit den POP3-Server bi't Daalladen vun Nettpost: %1"

#. +> trunk stable
#: pop3.cpp:1050
msgid "The POP3 command 'STAT' failed"
msgstr "De POP3-Befehl \"STAT\" is fehlslaan"

#. +> trunk stable
#: pop3.cpp:1056
msgid "Invalid POP3 response, should have at least one space."
msgstr "Leeg POP3-Anter, dor mutt tominnst een Freeteken wesen."

#. +> trunk stable
#: pop3.cpp:1064
msgid "Invalid POP3 STAT response."
msgstr "Leeg POP3-Anter op \"STAT\"."

