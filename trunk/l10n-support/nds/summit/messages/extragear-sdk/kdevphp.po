#. +> trunk stable
#: duchain/builders/declarationbuilder.cpp:448
#, kde-format
msgid "Cannot redeclare protected property %1 from this context."
msgstr "Schuult Egenschap %1 lett sik ut dissen Kontext nich nochmaal verkloren."

#. +> trunk stable
#: duchain/builders/declarationbuilder.cpp:510
msgid "Only booleans, ints, floats and strings are allowed for class constants."
msgstr "För Klass-Konstanten sünd bloots Heeltall-, Fleetkomma-, boolsch Weerten un Tekenkeden tolaten."

#. +> trunk stable
#: duchain/builders/declarationbuilder.cpp:523
msgid "Default value for parameters with a class type hint can only be NULL."
msgstr "Standardweerten för Parameters mit en Klassentyp-Henwies köönt bloots NULL wesen."

#. +> trunk stable
#: duchain/builders/declarationbuilder.cpp:526
msgid "Following parameters must have a default value assigned."
msgstr "För disse Parameters deit towiest Standardweerten noot."

#. +> trunk stable
#: duchain/builders/declarationbuilder.cpp:590
#, kde-format
