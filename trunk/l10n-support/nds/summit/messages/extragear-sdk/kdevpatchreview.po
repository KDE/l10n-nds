#: libdiff2/komparemodellist.cpp:378
#, kde-format
msgid "<qt>Could not upload the temporary file to the destination location <b>%1</b>. The temporary file is still available under: <b>%2</b>. You can manually copy it to the right place.</qt>"
msgstr "<qt>De Temporeerdatei lett sik nich na den Teeloort <b>%1</b> hoochladen. Dat gifft de Temporeerdatei noch ünner <b>%2</b>. Du kannst ehr vun Hand na de richtige Steed koperen.</qt>"

