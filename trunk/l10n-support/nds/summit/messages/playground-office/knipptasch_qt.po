"<tr>"
"<td>d</td>"
"<td>The day as a number without a leading zero (1 to 31)</td>"
"</tr>"
"<tr>"
"<td>dd</td>"
"<td>The day as a number with a leading zero (01 to 31)</td>"
"</tr>"
"<tr>"
"<td>ddd</td>"
"<td>The abbreviated localized day name (e.g. 'Mon' to 'Sun')</td>"
"</tr>"
"<tr>"
"<td>dddd</td>"
"<td>The long localized day name (e.g. 'Monday' to 'Sunday')</td>"
"</tr>"
"<tr>"
"<td>M</td>"
"<td>The month as a number without a leading zero (1 to 12)</td>"
"</tr>"
"<tr>"
"<td>MM</td>"
"<td>The month as a number with a leading zero (01 to 12)</td>"
"</tr>"
"<tr>"
"<td>MMM</td>"
"<td>The abbreviated localized month name (e.g. 'Jan' to 'Dec')</td>"
"</tr>"
