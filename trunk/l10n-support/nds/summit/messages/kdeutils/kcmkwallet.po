msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern, Manfred Wiese"

#. +> trunk stable
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de, m.j.wiese@web.de"

#. +> trunk stable
#: konfigurator.cpp:50
msgid "kcmkwallet"
msgstr "kcmkwallet"

#. +> trunk stable
#: konfigurator.cpp:51
msgid "KDE Wallet Control Module"
msgstr "Kuntrullmoduul för de KDE-Knippen"

#. +> trunk stable
#: konfigurator.cpp:53
msgid "(c) 2003 George Staikos"
msgstr "(c) 2003 George Staikos"

#. +> trunk stable
#: konfigurator.cpp:54
msgid "George Staikos"
msgstr "George Staikos"

#. +> trunk stable
#: konfigurator.cpp:118
msgid "New Wallet"
msgstr "Nieg Knipp"

#. +> trunk stable
#: konfigurator.cpp:119
msgid "Please choose a name for the new wallet:"
msgstr "Bitte giff en Naam för de niege Knipp an:"

#. +> trunk stable
#: konfigurator.cpp:213 konfigurator.cpp:261
msgid "Always Allow"
msgstr "Jümmers verlöven"

#. +> trunk stable
#: konfigurator.cpp:216 konfigurator.cpp:223 konfigurator.cpp:272
msgid "Always Deny"
msgstr "Jümmers torüchwiesen"

#. +> trunk stable
#: konfigurator.cpp:308
msgid "This configuration module allows you to configure the KDE wallet system."
msgstr "Mit dit Kuntrullmoduul kannst Du dat KDE-Knippensysteem instellen."

#. +> trunk stable
#: konfigurator.cpp:317
msgid "&Delete"
msgstr "&Wegdoon"

#. i18n: ectx: attribute (title), widget (QWidget, tab)
#. +> trunk stable
#: walletconfigwidget.ui:16
msgid "Wallet Preferences"
msgstr "Instellen för Knippen"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, _enabled)
#. +> trunk stable
#: walletconfigwidget.ui:22
msgid "<p>The wallet subsytem allows a convenient and secure way to manage all your passwords. You can decide if you want to use this system with this option.</p>"
msgstr "<p>Över dat Knippensysteem kannst Du all Dien Passwöör kommodig un seker plegen. Hier kannst Du utsöken, wat Du dat bruken wullt.</p>"

#. i18n: ectx: property (text), widget (QCheckBox, _enabled)
#. +> trunk stable
#: walletconfigwidget.ui:25
msgid "&Enable the KDE wallet subsystem"
msgstr "KDE-Knippensysteem &aktiveren"

#. i18n: ectx: property (whatsThis), widget (QGroupBox, groupBox2)
#. +> trunk stable
#: walletconfigwidget.ui:35
msgid "It is best to close your wallets when you are not using them to prevent others from viewing or using them."
msgstr "Dat is goot, wenn Du de Knippen tomaakst, wenn se nich bruukt warrt. Anner Lüüd köönt se denn nich ankieken oder bruken."

#. i18n: ectx: property (title), widget (QGroupBox, groupBox2)
#. +> trunk stable
#: walletconfigwidget.ui:38
msgid "Close Wallet"
msgstr "Knipp tomaken"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, _closeIdle)
#. i18n: ectx: property (whatsThis), widget (QSpinBox, _idleTime)
#. +> trunk stable
#: walletconfigwidget.ui:46 walletconfigwidget.ui:59
msgid ""
"<p><b>Close wallet after a period of inactivity.</b><br>"
"When a wallet is closed the password is needed to access it again.</p>"
msgstr ""
"<p><b>Na en Tiet, in de nix daan warrt, de Knipp tomaken</b><br>"
"Wenn en Knipp to is, warrt dat Passwoort bruukt, wenn se wedder opmaakt warrn schall.</p>"

#. i18n: ectx: property (text), widget (QCheckBox, _closeIdle)
#. +> trunk stable
#: walletconfigwidget.ui:49
msgid "Close when unused for:"
msgstr "Tomaken wenn nich bruukt över:"

#. i18n: ectx: property (suffix), widget (QSpinBox, _idleTime)
#. +> trunk stable
#: walletconfigwidget.ui:62
msgid " min"
msgstr " Min"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, _screensaverLock)
#. +> trunk stable
#: walletconfigwidget.ui:99
msgid ""
"<p><b>Close wallet as soon as the screensaver starts.</b><br>"
"When a wallet is closed the password is needed to access it again.</p>"
msgstr ""
"<p><b>De Knipp fuurts tomaken, wenn de Pausschirm start</b><br>"
"Wenn en Knipp to is, warrt dat Passwoort bruukt, wenn se wedder opmaakt warrn schall.</p>"

#. i18n: ectx: property (text), widget (QCheckBox, _screensaverLock)
#. +> trunk stable
#: walletconfigwidget.ui:102
msgid "Close when screensaver starts"
msgstr "Tomaken, wenn de Pausschirm start"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, _autoclose)
#. +> trunk stable
#: walletconfigwidget.ui:109
msgid ""
"<p><b>Close wallet as soon as applications that use it have stopped.</b><br>"
"Note that your wallets will only be closed when all applications that use it have stopped.<br>"
"When a wallet is closed the password is needed to access it again.</p>"
msgstr ""
"<p><b>De Knipp tomaken, wenn dat leste Programm beendt warrt, dat ehr bruukt hett.</b><br>"
"Beacht, dat de Knipp bloots tomaakt warrt, wenn all Programmen beendt sünd, de ehr bruukt hebbt.<br>"
"Wenn en Knipp to is, warrt dat Passwoort bruukt, wenn se wedder opmaakt warrn schall.</p>"

#. i18n: ectx: property (text), widget (QCheckBox, _autoclose)
#. +> trunk stable
#: walletconfigwidget.ui:112
msgid "Close when last application stops using it"
msgstr "Tomaken, wenn keen Programm ehr mehr bruukt"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox4)
#. +> trunk stable
#: walletconfigwidget.ui:122
msgid "Automatic Wallet Selection"
msgstr "Knipp automaatsch utsöken"

#. i18n: ectx: property (text), widget (QLabel, textLabel1_2)
#. +> trunk stable
#: walletconfigwidget.ui:128
msgid "Select wallet to use as default:"
msgstr "Standardknipp utsöken:"

#. i18n: ectx: property (text), widget (QPushButton, _newWallet)
#. i18n: ectx: property (text), widget (QPushButton, _newLocalWallet)
#. +> trunk stable
#: walletconfigwidget.ui:161 walletconfigwidget.ui:191
msgid "New..."
msgstr "Nieg..."

#. i18n: ectx: property (text), widget (QCheckBox, _localWalletSelected)
#. +> trunk stable
#: walletconfigwidget.ui:168
msgid "Different wallet for local passwords:"
msgstr "Anner Knipp för lokale Passwöör:"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox3)
#. +> trunk stable
#: walletconfigwidget.ui:201
msgid "Wallet Manager"
msgstr "Knippenpleger"

#. i18n: ectx: property (text), widget (QCheckBox, _launchManager)
#. +> trunk stable
#: walletconfigwidget.ui:207
msgid "Show manager in system tray"
msgstr "Pleger in Systeemafsnitt wiesen"

#. i18n: ectx: property (text), widget (QCheckBox, _autocloseManager)
#. +> trunk stable
#: walletconfigwidget.ui:235
msgid "Hide system tray icon when last wallet closes"
msgstr "Systeemafsnitt-Lüttbild versteken, wenn leste Knipp tomaakt warrt"

#. i18n: ectx: attribute (title), widget (QWidget, tab)
#. +> trunk stable
#: walletconfigwidget.ui:280
msgid "Access Control"
msgstr "Togriepkuntrull"

#. i18n: ectx: property (text), widget (QCheckBox, _openPrompt)
#. +> trunk stable
#: walletconfigwidget.ui:286
msgid "&Prompt when an application accesses an open wallet"
msgstr "&Nafragen, wenn en Programm op en apen Knipp togriepen will"

#. i18n: ectx: property (text), widget (Q3ListView, _accessList)
#. +> trunk stable
#: walletconfigwidget.ui:300
msgid "Wallet"
msgstr "Knipp"

#. i18n: ectx: property (text), widget (Q3ListView, _accessList)
#. +> trunk stable
#: walletconfigwidget.ui:311
msgid "Application"
msgstr "Programm"

#. i18n: ectx: property (text), widget (Q3ListView, _accessList)
#. +> trunk stable
#: walletconfigwidget.ui:322
msgid "Policy"
msgstr "Regel"

#. i18n: ectx: property (text), widget (QPushButton, _launch)
#. +> trunk stable
#: walletconfigwidget.ui:358
msgid "&Launch Wallet Manager"
msgstr "&Knippenpleger starten"

