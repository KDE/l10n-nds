#: konfigurator.cpp:50
msgid "kcmkwallet"
msgstr "kcmkwallet"

#. +> trunk stable
#: konfigurator.cpp:51
msgid "KDE Wallet Control Module"
msgstr "Kuntrullmoduul för de KDE-Knippen"

#. +> trunk stable
