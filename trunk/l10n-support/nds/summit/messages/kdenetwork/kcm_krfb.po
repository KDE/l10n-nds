#. +> trunk stable
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#. +> trunk stable
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

#. i18n: ectx: attribute (title), widget (QWidget)
#. +> trunk stable
#: configurationwidget.ui:37
msgid "Acc&ess"
msgstr "&Togriep"

#. i18n: ectx: property (title), widget (QGroupBox)
#. +> trunk stable
#: configurationwidget.ui:54
msgid "Invitations"
msgstr "Inladen"

#. i18n: ectx: property (text), widget (QLabel)
#. +> trunk stable
#: configurationwidget.ui:74
msgid "You have no open invitations."
msgstr "Dat gifft keen apen Inladen."

#. i18n: ectx: property (text), widget (QPushButton)
#. +> trunk stable
#: configurationwidget.ui:90
msgid "Create && &Manage Invitations..."
msgstr "Inladen opstellen && &plegen..."

#. i18n: ectx: property (whatsThis), widget (QPushButton)
#. +> trunk stable
#: configurationwidget.ui:93
msgid "Click to view or delete the open invitations."
msgstr "Klick hier, wenn Du de apen Inladen ankieken oder wegdoon wullt."

#. i18n: ectx: property (title), widget (QButtonGroup)
#. +> trunk stable
#: configurationwidget.ui:111
msgid "Uninvited Connections"
msgstr "Verbinnen ahn Inladen"

#. i18n: ectx: property (text), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:128
msgid "Allow &uninvited connections"
msgstr "Verbinnen &ahn Inladen verlöven"

#. i18n: ectx: property (whatsThis), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:134
msgid "Select this option to allow connecting without inviting. This is useful if you want to access your desktop remotely."
msgstr "Aktiveer dit, wenn Du dat Tokoppeln ahn en Inladen tolaten wullt. Dat is t.B. denn goot, wenn Du vun feern op Dien Schriefdisch togriepen wullt."

#. i18n: ectx: property (text), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:142
msgid "Announce service &on the network"
msgstr "&Deenst in't Nettwark künnig maken"

#. i18n: ectx: property (whatsThis), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:148
msgid "If you allow uninvited connections and enable this option, Desktop Sharing will announce the service and your identity on the local network, so people can find you and your computer."
msgstr "Wenn Du Tokoppeln ahn Inladen verlöövst un disse Optschoon anmaakst, warrt de Deenst un Dien Identiteet in't lokale Nettwark künnig maakt, so dat anner Lüüd Di un Dien Reekner finnen köönt."

#. i18n: ectx: property (text), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:156
msgid "Confirm uninvited connections &before accepting"
msgstr "Tokoppeln ahn Inladen &beglöven"

#. i18n: ectx: property (whatsThis), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:159
msgid "If enabled, a dialog will appear when somebody attempts to connect, asking you whether you want to accept the connection."
msgstr "Wenn anmaakt, dukt en Dialoog op, wenn een en Tokoppeln versöcht. Du warrst fraagt, wat Du de Verbinnen annehmen wullt."

#. i18n: ectx: property (text), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:167
msgid "A&llow uninvited connections to control the desktop"
msgstr "Verbinnen ahn Inladen dörvt Schriefdisch kuntru&lleren"

#. i18n: ectx: property (whatsThis), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:170
msgid "Enable this option to allow uninvited user to control your desktop (using mouse and keyboard)."
msgstr "Aktiveer dit, wenn Brukers ahn Inladen Dien Schriefdisch mit Muus un Tastatuur kuntrulleren könen schöölt."

#. i18n: ectx: property (text), widget (QLabel)
#. +> trunk stable
#: configurationwidget.ui:216
msgid "Pass&word:"
msgstr "Pass&woort:"

#. i18n: ectx: property (whatsThis), widget (QLineEdit)
#. +> trunk stable
#: configurationwidget.ui:233
msgid "If you allow uninvited connections, it is highly recommended to set a password in order to protect your computer from unauthorized access."
msgstr "Wenn Du Tokoppeln ahn Inladen verlöövst, is dat Fastleggen vun en Passwoort redig anraadt, so dat Dien Reekner vör Bruuk ahn Verlööf schuult is."

#. i18n: ectx: attribute (title), widget (QWidget)
#. +> trunk stable
#: configurationwidget.ui:264
msgid "&Session"
msgstr "&Törn"

#. i18n: ectx: property (title), widget (QGroupBox)
#. +> trunk stable
#: configurationwidget.ui:281
msgid "Session Preferences"
msgstr "Törninstellen"

#. i18n: ectx: property (text), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:298
msgid "Always disable &background image"
msgstr "Achtergrund&bild jümmers utmaken"

#. i18n: ectx: property (whatsThis), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:304
msgid "Check this option to always disable the background image during a remote session. Otherwise the client decides whether the background will be enabled or disabled."
msgstr "Aktiveer dit, wenn Du dat Achtergrundbild för feerne Törns jümmers utmaken wullt. Anners söcht de Client sik ut, wat dat Achtergrundbild wiest warrt."

#. i18n: ectx: attribute (title), widget (QWidget)
#. +> trunk stable
#: configurationwidget.ui:333
msgid "&Network"
msgstr "&Nettwark"

#. i18n: ectx: property (title), widget (QGroupBox)
#. +> trunk stable
#: configurationwidget.ui:350
msgid "Network Port"
msgstr "Nettwark-Port"

#. i18n: ectx: property (text), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:367
msgid "Assi&gn port automatically"
msgstr "Port auto&maatsch towiesen"

#. i18n: ectx: property (whatsThis), widget (QCheckBox)
#. +> trunk stable
#: configurationwidget.ui:373
msgid "Check this option to assign the network port automatically. This is recommended unless your network setup requires you to use a fixed port, for example because of a firewall."
msgstr "Aktiveer dit, wenn Du de Nettwark-Port automaatsch towiest hebben wullt. Dat is anraadt, wenn Dien Nettwark nich den Bruuk vun en faste Port nödig maakt, t.B. för en Nettdiek."

#. i18n: ectx: property (text), widget (QLabel)
#. +> trunk stable
#: configurationwidget.ui:404
msgid "P&ort:"
msgstr "P&ort:"

#. i18n: ectx: property (toolTip), widget (KIntNumInput)
#. +> trunk stable
#: configurationwidget.ui:424
msgid "Enter the TCP port number here"
msgstr "Giff hier de Nummer vun de TCP-Port in"

#. i18n: ectx: property (whatsThis), widget (KIntNumInput)
#. +> trunk stable
#: configurationwidget.ui:428
msgid ""
"Use this field to set a static port number for the desktop sharing service. Note that if the port is already in use the Desktop Sharing service will not be accessible until you free it. It is recommended to assign the port automatically unless you know what you are doing.\n"
"Most VNC clients use a display number instead of the actual port. This display number is the offset to port 5900, so port 5901 has the display number 1."
msgstr ""
"Bruuk dit Feld, wenn Du en faste Port för den Freegaven-Deenst fastleggen wullt. Beacht bitte, dat Du nich op den Deenst togriepen könen warrst, wenn de Port al bruukt warrt, ehr Du ehr nich freegeven hest. Laat de Port man automaatsch towiesen, wenn Du nich heel seker büst.\n"
"De mehrsten VNC-Clientprogrammen (\"Virtual Network Computing\", Reeknerbedenen över Nettwark) bruukt en Wiesnummer ansteed de Port. Disse Wiesnummer is de Afstand na Port 5900, Port 5901 hett also de Wiesnummer 1."

