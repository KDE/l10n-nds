#: kttsjobmgr/kttsjobmgr.cpp:231
msgid "&Refresh"
msgstr "&Opfrischen"

#. +> trunk stable
#: kttsjobmgr/kttsjobmgr.cpp:234
msgid "<p>Refresh the list of jobs.</p>"
