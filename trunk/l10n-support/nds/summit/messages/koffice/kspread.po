#~ msgid "Bit Operations"
#~ msgstr "Bit-Akschonen"

#~ msgid "First number"
#~ msgstr "Eerst Tall"

#~ msgid "Second number"
#~ msgstr "Tweet Tall"

#~ msgid "The BITAND() function performs a bit-wise AND operation for the two integer parameters."
#~ msgstr "De Funkschoon BITAND() föhrt en bitwies AND-Operatschoon för de twee Heeltall-Parameters ut."

#~ msgid "BITAND(value; value)"
#~ msgstr "BITAND(Weert; Weert)"

#~ msgid "BITAND(12;10) returns 8 (because decimal 12 is binary 1100, and decimal 10 is binary 1010; and 1100 \"anded\" with 1010 is 1000, which is integer 8)."
#~ msgstr "BITAND(12;10) gifft 8 torüch (wiel dezimaal 12 bineer 1100 is, un dezimaal 10 bineer 1010 is. 1100 AND 1010 is 1000, un dat is de Heeltall 8)."

#~ msgid "Amount to left shift by"
#~ msgstr "Tall vun Versatzsteden na links"

#~ msgid "The BITLSHIFT() function performs a bit-wise left shift operation of the first parameter. The number of bits to shift by is specified by the second parameter. Note that a negative number of bits to left shift by becomes a right shift. "
#~ msgstr "De Funkschoon BITLSHIFT() verschufft den eersten Parameter bitwies na links. De Bitversatzsteden warrt dör den tweten Parameter angeven. Beacht, dat en negativ Bitverschuven-Weert na links en Bitverschuven na rechts bedüüdt. "

#~ msgid "BITLSHIFT(value; shift size)"
#~ msgstr "BITLSHIFT(Weert, Versatzgrött)"

#~ msgid "Amount to right shift by"
#~ msgstr "Tall vun Versatzsteden na rechts"

#~ msgid "The BITRSHIFT() function performs a bit-wise right shift operation of the first parameter. The number of bits to shift by is specified by the second parameter. Note that a negative number of bits to right shift by becomes a left shift. "
#~ msgstr "De Funkschoon BITRSHIFT() verschufft den eersten Parameter bitwies na rechts. De Bitversatzsteden warrt dör den tweten Parameter angeven. Beacht, dat en negativ Bitverschuven-Weert na rechts en Bitverschuven na links bedüüdt. "

#~ msgid "BITRSHIFT(value; shift size)"
#~ msgstr "BITRSHIFT(Weert, Versatzgrött)"

#~ msgid "The BITOR() function performs a bit-wise OR operation for the two integer parameters. "
#~ msgstr "De Funkschoon BITOR() föhrt en bitwies OR-Operatschoon för de twee Heeltall-Parameters ut. "

#~ msgid "BITOR(value; value)"
#~ msgstr "BITOR(Weert; Weert)"

#~ msgid "BITOR(12;10) returns 14 (because decimal 12 is binary 1100, and decimal 10 is binary 1010; and 1100 \"ored\" with 1010 is 1110, which is integer 14)."
#~ msgstr "BITOR(12;10) gifft 14 torüch (wiel dezimaal 12 bineer 1100 is, un dezimaal 10 bineer 1010 is. 1100 OR 1010 is 1100, un dat is de Heeltall 14)."

#~ msgid "The BITXOR() function performs a bit-wise exclusive-OR operation for the two integer parameters. "
#~ msgstr "De Funkschoon BITXOR() föhrt en bitwies XOR-Operatschoon för de twee Heeltall-Parameters ut. "

#~ msgid "BITXOR(value; value)"
#~ msgstr "BITXOR(Weert; Weert)"

#~ msgid "BITXOR(12;10) returns 6 (because decimal 12 is binary 1100, and decimal 10 is binary 1010; and 1100 \"xored\" with 1010 is 0110, which is integer 6)."
#~ msgstr "BITXOR(12;10) gifft 6 torüch (wiel dezimaal 12 bineer 1100 is, un dezimaal 10 bineer 1010 is. 1100 XOR 1010 is 0110, un dat is de Heeltall 6)."

#~ msgid "Conversion"
#~ msgstr "Ümwanneln"

#~ msgid "Bool value to convert"
#~ msgstr "Boolsch Weert, de ümwannelt warrn schall"

#~ msgid "The BOOL2STRING() function returns a string value for a given boolean value. This method is intended for using a boolean in methods which require a string"
#~ msgstr "De Funkschoon BOOL2STRING() gifft en Tekenkeed för en angeven boolsch Weert torüch. Dit is goot för den Bruuk vun boolsch Weerten in Metoden, de en Tekenkeed verwacht"

#~ msgid "BOOL2STRING(value)"
#~ msgstr "BOOL2STRING(Weert)"

#~ msgid "BOOL2STRING(true) returns \"True\""
#~ msgstr "BOOL2STRING(wohr) gifft \"wohr\" torüch"

#~ msgid "BOOL2STRING(false) returns \"False\""
#~ msgstr "BOOL2STRING(falsch) gifft \"falsch\" torüch"

#~ msgid "upper(BOOL2STRING(find(\"nan\";\"banana\"))) returns TRUE"
#~ msgstr "upper(BOOL2STRING(find(\"naa\";\"Banaan\"))) gifft \"wohr\" torüch"

#~ msgid "Integer value to convert"
#~ msgstr "Heeltallweert, de ümwannelt warrn schall"

#~ msgid "The INT2BOOL() function returns a boolean value for a given integer number. This method is intended for using an integer in methods which require a boolean. It only accepts 0 or 1. If any other value is given, false is returned."
#~ msgstr "De Funkschoon INT2BOOL() gifft en boolsch Weert för en angeven Heeltall torüch. Dit is goot för den Bruuk vun Heeltallen in Metoden, de en boolsch Weert verwacht. Tolaten is bloots \"0\" oder \"1\". För anner Weerten warrt \"falsch\" torüchgeven."

#~ msgid "INT2BOOL(value)"
#~ msgstr "INT2BOOL(Weert)"

#~ msgid "INT2BOOL(1) returns true"
#~ msgstr "INT2BOOL(1) gifft \"wohr\" torüch"

#~ msgid "INT2BOOL(0) returns false"
#~ msgstr "INT2BOOL(0) gifft \"falsch\" torüch"

#~ msgid "OR(INT2BOOL(1); false) returns true"
#~ msgstr "OR(INT2BOOL(1); falsch) gifft \"wohr\" torüch"

#~ msgid "The BOOL2INT() function returns an integer value for a given boolean value. This method is intended for using a boolean value in methods which require an integer."
#~ msgstr "De Funkschoon BOOL2INT() gifft en Heeltall för en angeven boolsch Weert torüch. Dit is goot för den Bruuk vun boolsch Weerten in Metoden, de en Heeltall verwacht."

#~ msgid "BOOL2INT(value)"
#~ msgstr "BOOL2INT(Weert)"

#~ msgid "BOOL2INT(True) returns 1"
#~ msgstr "BOOL2INT(wohr) gifft \"1\" torüch"

#~ msgid "BOOL2INT(False) returns 0"
#~ msgstr "BOOL2INT(falsch) gifft \"0\" torüch"

#~ msgid "Number to convert into string"
#~ msgstr "Tall, de na en Tekenkeed ümwannelt warrn schall"

#~ msgid "The NUM2STRING() function returns a string value for a given number. Note that KSpread can auto-covert numbers to strings if needed, so this function should rarely be needed."
#~ msgstr "De Funkschoon NUM2STRING() gifft en Tekenkeed för en angeven Tall torüch. Beacht, dat KSpread Tallen automaatsch na Tekenkeden ümwanneln kann, wenn dat nödig deit, so dat disse Funkschoon normalerwies wull nich bruukt warrt."

#~ msgid "NUM2STRING(value)"
#~ msgstr "NUM2STRING(Weert)"

#~ msgid "NUM2STRING(10) returns \"10\""
#~ msgstr "NUM2STRING(10) gifft \"10\" torüch"

#~ msgid "NUM2STRING(2.05) returns \"2.05\""
#~ msgstr "NUM2STRING(2,05) gifft \"2,05\" torüch"

#~ msgid "=find(\"101\";NUM2STRING(A1)) (A1 = 2.010102) returns True"
#~ msgstr "=find(\"101\";NUM2STRING(A1)) (A1 = 2,010102) gifft \"wohr\" torüch"

#~ msgid "The STRING() function returns a string value for a given number. It is the same as the NUM2STRING function."
#~ msgstr "De Funkschoon STRING() gifft en Tekenkeedweert för en angeven Tall torüch. Dat is dat sülve as de Funkschoon NUM2STRING."

