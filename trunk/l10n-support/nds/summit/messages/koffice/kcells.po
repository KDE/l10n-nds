#. +> trunk stable
#: functions/text.xml:42 xml_doc.cpp:4583
msgid "The FIXED() function rounds a number to the specified number of decimals, formats the number in decimal format string, and returns the result as text. If decimals is negative, number is rounded to the left of the decimal point. If you omit decimals, it is assumed to be 2. If optional parameter no_commas is True, thousand separators will not show up."
msgstr "De Funkschoon FIXED() rundt en Tall na de angeven Tall vun Dezimaalsteden, formateert ehr as en Dezimaalformaat-Tekenkeed un gifft dat Resultaat as Text ut. Wenn \"Dezimaalsteden\" negativ is, warrt de Tall links den Dezimaalpunkt rundt. Ahn \"Dezimaalsteden\" warrt \"2\" vermoodt. Wenn de optschonaal Parameter \"keen_trenntekens\" wohr is, warrt de Dusennerkoppels ahn Trenntekens wiest."

#. +> trunk stable
#: functions/text.xml:43 xml_doc.cpp:4585
msgid "FIXED(number;decimals;no_commas)"
msgstr "FIXED(Tall;Dezimaalsteden;Keen_trenntekens)"

#. +> trunk stable
