msgid "The manifest file seems to be corrupted. The document could not be opened."
msgstr "As dat lett is de Manifestdatei schaadhaftig. Dat Dokment lett sik nich opmaken."

#. +> trunk stable
#: flake/odf/EncryptedStore.cpp:230
msgid "This document contains an unknown checksum. When you give a password it might not be verified."
msgstr "Dit Dokment bargt en nich begäng Pröövsumm. Wenn Du en Passwoort fastleggst, lett sik dat villicht nich överpröven."

#. +> trunk stable
#: flake/odf/EncryptedStore.cpp:256 flake/odf/EncryptedStore.cpp:273
msgid "This document contains an unknown encryption method. Some parts may be unreadable."
msgstr "Dit Dokment bargt en nich begäng Verslötelnmetood. En poor Delen sünd villicht nich leesbor."

#. +> trunk stable
#: flake/odf/EncryptedStore.cpp:288
msgid "This document contains incomplete encryption data. Some parts may be unreadable."
msgstr "Dit Dokment bargt nich komplett Verslöteldaten. En poor Delen köönt villicht nich leesbor wesen."

#. +> trunk stable
#: flake/odf/EncryptedStore.cpp:302
msgid "QCA has currently no support for SHA1 or PBKDF2 using SHA1. The document can not be opened."
msgstr "QCA stellt opstunns keen Ünnerstütten för SHA1 oder PBKDF2 mit SHA1 praat. Dat Dokment lett sik nich opmaken."

#. +> trunk stable
#: flake/odf/EncryptedStore.cpp:334
msgid "The manifest file seems to be corrupted. It cannot be modified and the document will remain unreadable. Please try and save the document again to prevent losing your work."
msgstr "As dat lett is de Manifestdatei schaadhaftig. Se lett sik nich ännern un dat Dokment warrt nich leesbor wesen. Bitte versöök, dat Du Dien Dokment nochmaal sekerst, dormit Dien Arbeit nich verlorengeiht."

#. +> trunk stable
#: flake/odf/EncryptedStore.cpp:432
msgid "The manifest file cannot be written. The document will remain unreadable. Please try and save the document again to prevent losing your work."
msgstr "De Manifestdatei lett sik nich schrieven. Bitte versöök, dat Du Dien Dokment nochmaal sekerst, dormit Dien Arbeit nich verlorengeiht."

#. +> trunk stable
#: flake/odf/EncryptedStore.cpp:542
msgid "Please enter the password to open this file."
msgstr "Bitte dat Passwoort för't Opmaken vun disse Datei ingeven."

#. +> trunk stable
#: flake/odf/EncryptedStore.cpp:719
msgid "Please enter the password to encrypt the document with."
msgstr "Bitte dat Passwoort ingeven, mit dat dat Dokment verslötelt warrn schall."

#. +> trunk stable
#: flake/odf/EncryptedStore.cpp:737
msgid "Do you want to save the password?"
msgstr "Wullt Du dat Passwoort sekern?"

