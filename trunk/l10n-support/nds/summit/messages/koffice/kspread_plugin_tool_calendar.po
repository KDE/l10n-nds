#. i18n: file: CalendarToolWidget.ui:13
#. i18n: ectx: property (windowTitle), widget (QWidget, CalendarToolWidget)
#. +> trunk
#: rc.cpp:3 CalendarToolFactory.cpp:37
msgid "Calendar Tool"
msgstr "Kalenner-Warktüüch"

#. i18n: file: CalendarToolWidget.ui:19
#. i18n: ectx: property (text), widget (QPushButton, m_insertButton)
#. +> trunk
#: rc.cpp:6
msgid "Insert"
msgstr "Infögen"

#. i18n: file: CalendarToolWidget.ui:26
#. i18n: ectx: property (text), widget (QLabel, label)
#. +> trunk
#: rc.cpp:9
msgid "Start date:"
msgstr "Anfangdatum:"

#. i18n: file: CalendarToolWidget.ui:56
#. i18n: ectx: property (text), widget (QLabel, label_2)
#. +> trunk
#: rc.cpp:12
msgid "End date:"
msgstr "Enndatum:"

#. +> trunk
#: CalendarTool.cpp:70
msgid "End date is before start date! Please make sure that end date comes after start date."
msgstr "Enndatum is fröher as dat Startdatum! Dat Enndatum mutt later as dat Startdatum wesen."

#. +> trunk
#: CalendarTool.cpp:70 CalendarTool.cpp:75
msgid "Error"
msgstr "Fehler"

#. +> trunk
#: CalendarTool.cpp:75
msgid "Calendars should not be longer than 10 years. If you really need such long periods you need to split them up."
msgstr "Kalenners schöölt nich länger as teihn Johren wesen. Wenn so lang Tietrüüm bruukt warrt, mööt se opdeelt warrn."

#. +> trunk
#: CalendarTool.cpp:80
msgid "Start and end dates are equal! Only one day will be inserted, do you want to continue?"
msgstr "Start- un Enndatum sünd liek! Bloots een Dag warrt inföögt. Wullt Du wiedermaken?"

#. +> trunk
#: CalendarTool.cpp:80 CalendarTool.cpp:85 CalendarTool.cpp:101
msgid "Warning"
msgstr "Wohrschoen"

#. +> trunk
#: CalendarTool.cpp:85
msgid "Creating a calendar for a longer period than a year can take up a lot of space, do you want to continue?"
msgstr "Dat Opstellen vun en Kalenner de länger as een Johr is, kann veel Spiekerplatz bruken. Wullt Du wiedermaken?"

#. +> trunk
#: CalendarTool.cpp:101
msgid "The area where the calendar is inserted is NOT empty, are you sure you want to continue, overwriting existing data? If you choose No the area that would be required for the desired calendar will be selected so you can see what data would be overwritten."
msgstr "Dat Rebeet, binnen dat de Kalenner inföögt warrn schall, is NICH leddig. Wullt Du redig wiedermaken un de al vörhannen Daten överschrieven? Wenn Du \"Nee\" anklickst, warrt dat för den Kalenner bruukt Rebeet markeert, so dat Du Di de Daten ankieken kannst, de överschreven wöörn."

#. +> trunk
#: CalendarTool.cpp:115
#, kde-format
msgid "Calendar from %1 to %2"
msgstr "Kalenner vun %1 bet %2"

#. +> trunk
#: CalendarTool.cpp:155
msgid "week"
msgstr "Week"
