#. i18n: ectx: property (whatsThis), widget (KComboBox, mLoopOnGotoUnread)
#. +> future stable
#: ui/miscpagemaintab.ui:67
msgctxt "what's this help"
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" "
"\"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">"
"\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; "
"font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">When jumping to the "
"next unread message, it may occur that no more unread messages are below the "
"current message.</p>"
"\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" "
"font-weight:600;\">Do not loop:</span> The search will stop at the last "
"message in the current folder.</p>"
"\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" "
"font-weight:600;\">Loop in current folder:</span> The search will continue at "
"the top of the message list, but not go to another folder.</p>"
"\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" "
"font-weight:600;\">Loop in all folders:</span> The search will continue at "
"the top of the message list. If no unread messages are found it will then "
"continue to the next folder.</p>"
"\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Similarly, when "
"searching for the previous unread message, the search will start from the "
"bottom of the message list and continue to the previous folder depending on "
"which option is selected.</p>"
"\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" "
"font-weight:600;\">Loop in all marked folders: </span>This is the same as "
"\"Loop in all folders\" except that only folders are taken into account which "
"have been marked with the folder property \"Act on new/unread mail in this "
"folder\".</p>"
"</body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" "
"\"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">"
"\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; "
"font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Bi't Jumpen na de "
"nakamen nich leeste Naricht mag dat vörkamen, dor gifft dat keen nich leest "
"Narichten mehr nerrn de aktuelle.</p>"
"\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" "
"font-weight:600;\">Keen Rundsöök:</span> De Söök höllt bi de leste Naricht "
"binnen den aktuellen Orner op.</p>"
"\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" "
"font-weight:600;\">Rundsöök binnen aktuell Orner:</span> De Söök fangt baven "
"binnen den aktuellen Orner wedder an, man wesselt nich na en anner Orner.</p>"
"\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" "
"font-weight:600;\">Rundsöök binnen all Ornern:</span> De Söök geiht baven "
"binnen de Narichtenlist wieder. Gifft dat keen nich leeste Narichten mehr, "
"kummt de nakamen Orner na de Reeg.</p>"
"\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Liek so is dat bi't "
"Söken achterut na de verledene nich leeste Naricht. De Söök fangt denn nerrn "
"binnen de Narichtenlist wedder an un geiht na den verleden Orner, afhangig "
"vun de utsöchte Optschoon.</p>"
"\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" "
"font-weight:600;\">Rundsöök binnen all markeert Ornern: </span>Dat sülve as "
"bi \"Rundsöök binnen all Ornern\", man mit een Verscheel: Dörkeken warrt "
"bloots Ornern, bi de de Optschoon \"Akschoon bi nieg/nich leest Nettbreven "
"binnen dissen Orner\" anmaakt is.</p>"
"</body></html>"

