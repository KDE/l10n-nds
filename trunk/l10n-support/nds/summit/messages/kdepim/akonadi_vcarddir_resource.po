#. i18n: ectx: attribute (title), widget (QWidget, tab)
#. +> trunk
#: settingsdialog.ui:20
msgid "Directory"
msgstr "Orner"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#. +> trunk
#: settingsdialog.ui:26
msgid "Directory Name"
msgstr "Ornernaam"

#. i18n: ectx: property (text), widget (QLabel, label)
#. +> trunk
#: settingsdialog.ui:34
msgid "&Directory:"
msgstr "&Orner:"

#. i18n: ectx: property (text), widget (QLabel, label_3)
#. +> trunk
#: settingsdialog.ui:49
msgid "Select the directory whose contents should be represented by this resource. If the directory does not exist, it will be created."
msgstr "Den Orner utsöken, den sien Inholt disse Ressource praatstellen schall. Gifft dat den Orner nich, warrt he opstellt."

#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#. +> trunk
#: settingsdialog.ui:62
msgid "Access Rights"
msgstr "Togriepverlöven"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#. +> trunk
#: settingsdialog.ui:68
msgid "Read only"
msgstr "Bloots leesbor"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#. +> trunk
#: settingsdialog.ui:75
msgid "If read-only mode is enabled, no changes will be written to the directory selected above. Read-only mode will be automatically enabled if you do not have write access to the directory."
msgstr "Is de Bloots-leesbor-Bedrief anmaakt, warrt keen Ännern na den baven utsöchten Orner schreven. Hest Du keen Schriefverlöven för den Orner, warrt de Bloots-leesbor-Bedrief automaatsch anmaakt."

#. i18n: ectx: attribute (title), widget (QWidget, tab_2)
#. +> trunk
#: settingsdialog.ui:102
msgid "Tuning"
msgstr "Fieninstellen"

#. i18n: ectx: property (text), widget (QLabel, label_4)
#. +> trunk
#: settingsdialog.ui:108
msgid "The options on this page allow you to change parameters that balance data safety and consistency against performance. In general you should be careful with changing anything here, the defaults are good enough in most cases."
msgstr "Mit de Optschonen op disse Siet kannst Du de Balangs twischen Datensekerheit un -konsistenz op de een un de Leisten op de anner Siet topassen. Wees man vörsichtig mit de Instellen op disse Siet, de Vörinstellen passt tomehrst."

#. i18n: ectx: property (text), widget (QLabel, autosaveLabel)
#. +> trunk
#: settingsdialog.ui:120
msgid "Autosave delay:"
msgstr "Töövtiet för't automaatsche Sekern:"

#. i18n: ectx: property (suffix), widget (KIntNumInput, kcfg_AutosaveInterval)
#. +> trunk
#: settingsdialog.ui:133
msgid "min"
msgstr "Min."

#. +> trunk
#: vcarddirresource.cpp:110 vcarddirresource.cpp:144 vcarddirresource.cpp:177
msgid "Trying to write to a read-only directory: '%1'"
msgstr "Schrieven na bloots-leesbor Orner \"%1\" nich mööglich."

#. i18n: ectx: label, entry (Path), group (General)
#. +> trunk
#: vcarddirresource.kcfg:9
msgid "Path to vCard directory"
msgstr "Padd na VCard-Verteken"

#. i18n: ectx: label, entry (AutosaveInterval), group (General)
#. +> trunk
#: vcarddirresource.kcfg:13
msgid "Autosave interval time (in minutes)."
msgstr "Tiet för't automaatsche Sekern (in Minuten)."

#. i18n: ectx: label, entry (ReadOnly), group (General)
#. +> trunk
#: vcarddirresource.kcfg:17
msgid "Do not change the actual backend data."
msgstr "Bitte de aktuellen Hülpprogramm-Daten nich ännern"
