#. (itstool) path: component/name
#. +> trunk
#: KMail2.appdata.xml:6
msgid "KMail"
msgstr "KMail"

#. (itstool) path: description/p
#. +> trunk
#: KMail2.appdata.xml:8
msgid ""
"KMail is the email component of Kontact, the integrated personal information "
"manager from KDE."
msgstr ""
"KMail is de Nettpostkomponent vun Kontact, KDE sien inbuut Pleger för "
"persöönlich Informatschonen"

#. (itstool) path: description/p
#. +> trunk
#: KMail2.appdata.xml:11
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:13
msgid "Supports the standard mail protocols IMAP, POP3 and SMTP."
msgstr "Ünnerstütt de Standard-Nettpostprotokollen IMAP, POP3 un SMTP."

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:14
msgid ""
"Supports authentication via NTLM (Microsoft Windows) and GSSAPI (Kerberos)"
msgstr ""
"Ünnerstütt de Identiteetprööv över NTLM (Windows) un GSSAPI (Kerberos)."

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:15
msgid "Supports plain text and secure logins, using SSL and TLS."
msgstr "Ünnerstütt dat Anmellen mit Eenfachtext un mit seker SSL un TLS."

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:16
msgid ""
"Integration of international character sets and spell-checking (as-you-type "
"and on demand)"
msgstr ""
"Inbuut internatschonaal Tekensetten un Schriefwiesprööv (bi't Tippen un op "
"Anföddern)"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:17
msgid "Native support for inline OpenPGP, PGP/MIME, and S/MIME."
msgstr "Inbuut Ünnerstütten för OpenPGP, PGP/MIME un S/MIME"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:18
msgid "Reading and writing of HTML mail."
msgstr "HTML-Nettbreven wiesen un schrieven."

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:19
msgid "Ability to display plain text only from an HTML mail."
msgstr "Kann HTML-Nettbreven as Eenfachtext wiesen."

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:20
msgid "Allows you to receive and accept invitations."
msgstr "Inladen laat sik dor mit kriegen un ok annehmen"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:21
msgid ""
"Integration with popular spam checkers, e.g. SpamAssassin, Bogofilter, etc."
msgstr ""
"Arbeidt mit faken bruukt Warven-Pröövprogrammen as SpamAssassin oder "
"Bogofilter tosamen."

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:22
msgid "An optional spam probability meter can be displayed"
msgstr ""
"Köörwies lett sik en Maat wiesen, wo wohrschienlich de Nettbreef Warven is"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:23
msgid "Powerful search and filter abilities"
msgstr "Deegte Söök un Filtern"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:24
msgid "Can import mail from many other clients"
msgstr "Kann Nettbreven ut en Barg anner Nettpostprogrammen importeren"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:25
msgid "Searching in IMAP folders fully supported"
msgstr "Söken binnen IMAP-Ornern warrt heel ünnerstütt"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:26
msgid "Highly integrated with other Kontact components"
msgstr "Arbeidt drang mit anner Kontact-Komponenten tosamen"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:27
msgid "Encrypted password saving in KWallet"
msgstr "Passwöör warrt verslötelt binnen KWallet wohrt"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:28
msgid ""
"Flagging and tagging of messages to aid sorting and recovery of information"
msgstr ""
"Narichten laat sik markeren un dor laat sik Slötelwöör na tofögen; de "
"Narichten laat sik denn beter sorteren un Informatschonen beter finnen"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:29
msgid "Supports mailing list management features"
msgstr "Funkschonen för't Plegen vun Nettpostlisten sünd al inbuut"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:30
msgid "Can replace text smilies with emoticons"
msgstr "Kann för Text-Snuten Biller insetten"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:31
msgid "Displays the sender's picture or avatar if present in the address book"
msgstr ""
"Wiest den Senner sien Bild oder Bildteken, wenn dat een binnen dat Adressbook "
"gifft"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:32
msgid "Supports X-Face (b/w pictures in messages)"
msgstr "Ünnerstütt X-Face (Swattwitt-Biller binnen Narichten)"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:33
msgid "Compression of attachments"
msgstr "Komprimeren vun Bilagen"

#. (itstool) path: ul/li
#. +> trunk
#: KMail2.appdata.xml:34
msgid "KMail supports Groupware functionality."
msgstr "KMail ünnerstütt Arbeitkoppel-Funkschonen."

