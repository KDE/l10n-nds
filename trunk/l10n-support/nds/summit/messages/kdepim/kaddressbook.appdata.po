#. (itstool) path: component/name
#. +> future
#: kaddressbook.appdata.xml:6
msgid "KAddressBook"
msgstr "KAdressbook"

#. (itstool) path: description/p
#. +> future
#: kaddressbook.appdata.xml:8
msgid "KAddressBook stores all the personal details of your family, friends and other contacts."
msgstr "KAdressbook wohrt all de persöönlichen Enkelheiten över Dien Familie, Dien Frünnen un anner Kontakten."

#. (itstool) path: description/p
#. +> future
#: kaddressbook.appdata.xml:9
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#. +> future
#: kaddressbook.appdata.xml:11
msgid "Imports and exports to nearly every address book standard"
msgstr "Importeren ut un Exporteren na meist all Adressbook-Standards."

#. (itstool) path: ul/li
#. +> future
#: kaddressbook.appdata.xml:12
msgid "Reads .vcf format files, and can import and export vCards and csv format files"
msgstr "Leest Dateien in't VCF-Formaat un kann Daten ut vCard- un CSV-Dateien importeren un dor ok hen exporteren."

#. (itstool) path: ul/li
#. +> future
#: kaddressbook.appdata.xml:13
msgid "Can use multiple LDAPservers"
msgstr "Kann en Reeg LDAP-Servers tosamen bruken"

#. (itstool) path: ul/li
#. +> future
#: kaddressbook.appdata.xml:14
msgid "Configurable filters and powerful search capabilities"
msgstr "Instellbor Filtern un en deegt Söök"

#. (itstool) path: ul/li
#. +> future
#: kaddressbook.appdata.xml:15
msgid "Integrates with other Kontact components, e.g. exporting Birthday reminders to KOrganizer"
msgstr "Arbeit mit anner Kontact-Komponenten tosamen, exporteert a.B. Geboortsdag-Vöranstööt na KOrganizer."

#. (itstool) path: ul/li
#. +> future
#: kaddressbook.appdata.xml:16
msgid "Capable of groupware integration"
msgstr "Arbeit mit Arbeitkoppelprogrammen tosamen"

#. (itstool) path: ul/li
#. +> future
#: kaddressbook.appdata.xml:17
msgid "Powered by Akonadi"
msgstr "Akonadi arbeidt in'n Achtergrund"
