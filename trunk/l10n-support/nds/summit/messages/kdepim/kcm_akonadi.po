#. i18n: ectx: property (whatsThis), widget (QCheckBox, startServer)
#. +> trunk
#: serverconfigmodule.ui:17
msgid "Choose if Akonadi will use a internal or external MySQL server"
msgstr "Angeven, wat Akonadi en intern oder en extern MySQL-Server bruukt"

#. i18n: ectx: property (text), widget (QCheckBox, startServer)
#. +> trunk stable
#: serverconfigmodule.ui:20
msgid "Use internal MySQL server"
msgstr "Intern MySQL-Server bruken"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#. +> trunk stable
#: serverconfigmodule.ui:30
msgid "Internal MySQL Server"
msgstr "Intern MySQL-Server"

#. i18n: ectx: property (text), widget (QLabel, label)
#. +> trunk stable
#: serverconfigmodule.ui:36
msgid "MySQL server executable:"
msgstr "MySQL-Serverprogramm:"

#. i18n: ectx: property (whatsThis), widget (KUrlRequester, serverPath)
#. +> trunk
#: serverconfigmodule.ui:46
msgid ""
"<p><b>MySQL server location</b></p>"
"<br>"
"Enter the location of your internal MySQL server or click on the Browse button."
msgstr ""
"<p><b>Steed vun den MySQL-Server</b></p>"
"<br>"
"Bitte de Steed vun Dien intern MySQL-Server ingeven oder mit den Utsöken-Knoop fastleggen"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#. +> trunk stable
#: serverconfigmodule.ui:59
msgid "External MySQL Server"
msgstr "Extern MySQL-Server"

#. i18n: ectx: property (text), widget (QLabel, label_6)
#. +> trunk stable
#: serverconfigmodule.ui:65
msgid "Database Name:"
msgstr "Datenbank Naam:"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, name)
#. +> trunk
#: serverconfigmodule.ui:75
msgid ""
"<p><b>Database Name</b></p>"
"<br>"
"Enter the name of your Akonadi database on your external MySQL server."
msgstr ""
"<p><b>Datenbanknaam</b></p>"
"<br>"
"Bitte den Naam vun Dien Akonadi-Datenbank op Dien extern MySQL-Server angeven"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#. +> trunk stable
#: serverconfigmodule.ui:82
msgid "Host:"
msgstr "Reekner:"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, host)
#. +> trunk
#: serverconfigmodule.ui:92
msgid ""
"<p><b>Host</b></p>"
"<br>"
"Enter the hostname or the IP address of the machine hosting your MySQL server."
msgstr ""
"<p><b>Reekner</b></p>"
"<br>"
"Bitte den Naam oder de IP-Adress vun den Reekner angeven, op den Dien MySQL-Server löppt"

#. i18n: ectx: property (text), widget (QLabel, label_3)
#. +> trunk stable
#: serverconfigmodule.ui:99
msgid "Username:"
msgstr "Brukernaam:"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, username)
#. +> trunk
#: serverconfigmodule.ui:109
msgid "Enter the username required to access your MySQL database."
msgstr "Bitte den Brukernaam för de MySQL-Datenbank angeven"

#. i18n: ectx: property (text), widget (QLabel, label_4)
#. +> trunk stable
#: serverconfigmodule.ui:116
msgid "Password:"
msgstr "Passwoort:"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, password)
#. +> trunk
#: serverconfigmodule.ui:126
msgid "Enter the password required to access your MySQL database."
msgstr "Bitte dat Passwoort för den MySQL-Server angeven"

#. i18n: ectx: property (text), widget (QLabel, label_5)
#. +> trunk stable
#: serverconfigmodule.ui:136
msgid "Options:"
msgstr "Optschonen:"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, options)
#. +> trunk
#: serverconfigmodule.ui:146
msgid ""
"<p><b>External MySQL server options</b></p>"
"<br>"
"If necessary, you may pass options to your MySQL server."
msgstr ""
"<p><b>Optschonen för den externen MySQL-Server</b></p>"
"<br>"
"Wenn't noot deit, kannst Du Dien MySQL-Server Optschonen tostüern"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#. +> trunk stable
#: serverconfigmodule.ui:156
msgid "Status"
msgstr "Status"

#. i18n: ectx: property (text), widget (QLabel, label_7)
#. +> trunk stable
#: serverconfigmodule.ui:169
msgid "Note: The changes made above will only take effect after the next server restart."
msgstr "Beacht bitte: De Ännern, de Du baven maakt hest, warrt eerst bi den nakamen Start vun den Server övernahmen."

