msgstr "<qt>De angeven Teel-URL \"%1\" is leeg.</qt>"

#. +> trunk
#: freebusymanager.cpp:253
msgid "Invalid URL"
msgstr "Leeg URL"

#. +> trunk
#: freebusymanager.cpp:342
#, kde-format
msgid ""
"<qt>"
"<p>The software could not upload your free/busy list to the URL '%1'. There might be a problem with the access rights, or you specified an incorrect URL. The system said: <em>%2</em>.</p>"
"<p>Please check the URL or contact your system administrator.</p>"
"</qt>"
msgstr ""
"<qt>"
"<p>Dien Free-/Bunnenlist lett sik nich na de URL \"%1\" hoochladen. Villicht gifft dat en Problem mit de Togriepverlöven, oder Du hest villicht en leeg URL angeven. Dat Systeem meldt: <em>%2</em>.</p>"
"<p>Prööv bitte de URL oder snack Dien Systeempleger op dat Problem an.</p>"
"</qt>"

