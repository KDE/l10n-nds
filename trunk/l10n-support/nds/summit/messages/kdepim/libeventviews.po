#. i18n: ectx: label, entry (DefaultEmailAttachMethod), group (Personal Settings)
#. +> trunk stable
#: eventviews.kcfg:16
msgid "Default Email Attachment Method"
msgstr "Standardmetood för Nettbreefbilagen"

#. i18n: ectx: label, entry (EmailControlCenter), group (Personal Settings)
#. +> stable
#: eventviews.kcfg:16
msgid "Use email settings from System Settings"
msgstr "Nettpostinstellen ut Systeeminstellen bruken"

#. i18n: ectx: whatsthis, entry (DefaultEmailAttachMethod), group (Personal Settings)
#. +> trunk stable
#: eventviews.kcfg:17
msgid "The default way of attaching dropped emails to an event"
msgstr "De Standardmetood för't Tofögen vun Nettbreven na Begeefnissen"

#. i18n: ectx: whatsthis, entry (EmailControlCenter), group (Personal Settings)
#. +> stable
#: eventviews.kcfg:17
msgid "Check this box to use the KDE-wide e-mail settings, which are defined using the System Settings \"About Me\" Module. Uncheck this box to be able to specify your full name and e-mail."
msgstr "Maak dit an, wenn Du de KDE-Instellen för Nettpost bruken wullt. De kannst Du in de Systeeminstellen binnen dat \"Över mi\"-Moduul\"topassen. Wenn Du dit nich anmaakst, kannst Du hier Dien Naam un Nettpostadress ingeven."

#. i18n: ectx: label, entry (DefaultEmailAttachMethod), group (Personal Settings)
#. i18n: ectx: label, entry (DefaultTodoAttachMethod), group (Hidden Options)
#. +> trunk stable
#: eventviews.kcfg:20 eventviews.kcfg:456
msgid "Always ask"
msgstr "Jümmers nafragen"

#. i18n: ectx: label, entry (DefaultEmailAttachMethod), group (Personal Settings)
#. i18n: ectx: label, entry (DefaultTodoAttachMethod), group (Hidden Options)
#. +> trunk stable
#: eventviews.kcfg:23 eventviews.kcfg:459
msgid "Only attach link to message"
msgstr "Bloots Link na de Naricht bileggen"

#. i18n: ectx: label, entry (DefaultEmailAttachMethod), group (Personal Settings)
#. i18n: ectx: label, entry (DefaultTodoAttachMethod), group (Hidden Options)
#. +> trunk stable
#: eventviews.kcfg:26 eventviews.kcfg:462
msgid "Attach complete message"
msgstr "Heel Naricht bileggen"

#. i18n: ectx: label, entry (DefaultEmailAttachMethod), group (Personal Settings)
#. +> trunk stable
#: eventviews.kcfg:29
msgid "Attach message without attachments"
msgstr "Naricht ahn Bilagen bileggen"

#. i18n: ectx: label, entry, group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:39
msgid "Export to HTML with every save"
msgstr "Bi't Sekern jümmers na HTML exporteren"

#. i18n: ectx: whatsthis, entry, group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:40
msgid "Check this box to export the calendar to a HTML-file every time you save it. By default, this file will be called calendar.html and placed in the user home folder."
msgstr "Maak dit an, wenn Du den Kalenner jümmers as en HTML-Datei sekern wullt. Standardwies warrt de Datei \"kalenner.html\" nöömt un steiht binnen Dien Tohuusorner."

#. i18n: ectx: label, entry, group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:45
msgid "Enable automatic saving of manually opened calendar files"
msgstr "Per Hand opmaakte Kalenners automaatsch sekern"

#. i18n: ectx: whatsthis, entry, group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:46
msgid "Check this box to save your calendar file automatically when you exit KOrganizer without asking and periodically, as you work. This setting does not affect the automatic saving of the standard calendar, which is automatically saved after each change."
msgstr "Maak dit an, wenn KOrganizer Dien Kalennerdatei automaatsch bi't Verlaten un perioodsch bi't Arbeiden sekern schall. Disse Optschoon bedröppt dat Sekern vun den Standardkalenner nich, de warrt na elk Ännern automaatsch sekert."

#. i18n: ectx: label, entry, group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:51
msgid "Save &interval in minutes"
msgstr "Se&kerafstand in Minuten"

#. i18n: ectx: whatsthis, entry, group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:52
msgid "Set the interval between automatic saving of calendar events in minutes here. This setting only applies to files that are opened manually. The standard KDE-wide calendar is automatically saved after each change."
msgstr "Hier kannst Du fastleggen, woveel Tiet twischen twee Sekern vun Kalennerindrääg liggen schall. Disse Optschoon bedröppt bloots Dateien, de Du per Hand opmaakt hest. De Standardkalenner vun KDE warrt automaatsch na elk Ännern sekert."

#. i18n: ectx: label, entry (Confirm), group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:58
msgid "Confirm deletes"
msgstr "Wegdoon beglöven"

#. i18n: ectx: whatsthis, entry (Confirm), group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:59
msgid "Check this box to display a confirmation dialog when deleting items."
msgstr "Maak dit an, wenn Du nochmaal fraagt warrn wullt, ehr Indrääg wegdaan warrt."

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:64
msgid "New Events, To-dos and Journal Entries Should"
msgstr "Niege Begeefnissen, Opgaven un Daagbookindrääg"

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:67
msgid "Be added to the standard calendar"
msgstr "Na den Standardkalenner tofögen"

#. i18n: ectx: whatsthis, entry (Destination), group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:68
msgid "Select this option to always record new events, to-dos and journal entries using the standard calendar."
msgstr "Maak dit an, wenn Du nieg Begeefnissen, Opgaven un Daagbookindrääg automaatsch binnen den Standardkalenner sekern wullt."

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:71
msgid "Be asked which calendar to use"
msgstr "Na Kalenner fragen"

#. i18n: ectx: whatsthis, entry (Destination), group (Save Settings)
#. +> trunk stable
#: eventviews.kcfg:72
msgid "Select this option to choose the calendar to be used to record the item each time you create a new event, to-do or journal entry. This choice is recommended if you intend to use the shared folders functionality of the Kolab server or have to manage multiple accounts using Kontact as a KDE Kolab client. "
msgstr "Wenn anmaakt, fraagt KOrganizer Di jümmers na den Kalenner, binnen den Du den niegen Indrag wohren wullt, wenn Du en nieg Opgaav, Begeefnis oder Daagbookindrag opstellst. Dit is anraadt, wenn Du de deelten Ornern op den Kolab-Server bruken wullt oder mit Kontact as KDE-Kolab-Client mehr as een Konto plegen muttst. "

#. i18n: ectx: label, entry, group (System Tray)
#. +> trunk stable
#: eventviews.kcfg:82
msgid "Show Reminder Daemon in the System Tray"
msgstr "Anstootdämoon binnen Systeemafsnitt wiesen"

#. i18n: ectx: whatsthis, entry, group (System Tray)
#. +> trunk stable
#: eventviews.kcfg:83
msgid "Check this box to show the KOrganizer reminder daemon in the system tray."
msgstr "Maak dit an, wenn Du den KOrganizer-Anstootdämoon binnen den Systeemafsnitt wiesen wullt."

#. i18n: ectx: whatsthis, entry (TimeZoneId), group (Time &amp; Date)
#. +> trunk stable
#: eventviews.kcfg:91
msgid "Select your timezone from the list of locations in this drop down box. If your city is not listed, select one which shares the same timezone. KOrganizer will automatically adjust for daylight savings."
msgstr "Söök Dien Oort op de List vun Öörd binnen de Köör ut. Wenn Dien Stadt nich oplist is, söök een binnen Dien Tietrebeet ut. KOrganizer stellt sik automaatsch op Sommer- un Wintertiet in."

#. i18n: ectx: label, entry (DayBegins), group (Time &amp; Date)
#. +> trunk stable
#: eventviews.kcfg:95
msgid "Day begins at"
msgstr "Daganfang"

#. i18n: ectx: whatsthis, entry (DayBegins), group (Time &amp; Date)
#. +> trunk stable
#: eventviews.kcfg:96
msgid "Enter the start time for events here. This time should be the earliest time that you use for events, as it will be displayed at the top."
msgstr "Giff hier de fröhste Tiet in, de Du normalerwies för Begeefnissen bruukst, se warrt baven an de Kant wiest."

#. i18n: ectx: label, entry (WorkingHoursStart), group (Time &amp; Date)
#. +> trunk stable
#: eventviews.kcfg:101
msgid "Daily starting hour"
msgstr "Arbeitanfang"

#. i18n: ectx: whatsthis, entry (WorkingHoursStart), group (Time &amp; Date)
#. +> trunk stable
#: eventviews.kcfg:102
msgid "Enter the start time for the working hours here. The working hours will be marked with color by KOrganizer."
msgstr "Giff hier Dien Arbeitanfang in. KOrganizer markeert de Arbeitstünnen mit en anner Achtergrundklöör."

#. i18n: ectx: label, entry (WorkingHoursEnd), group (Time &amp; Date)
#. +> trunk stable
#: eventviews.kcfg:107
msgid "Daily ending hour"
msgstr "Arbeitenn"

#. i18n: ectx: label, entry (Holidays), group (Time &amp; Date)
#. +> stable
#: eventviews.kcfg:107
msgid "Use holiday region:"
msgstr "Fierdagregioon bruken:"

#. i18n: ectx: whatsthis, entry (WorkingHoursEnd), group (Time &amp; Date)
#. +> trunk stable
#: eventviews.kcfg:108
msgid "Enter the ending time for the working hours here. The working hours will be marked with color by KOrganizer."
msgstr "Giff hier Dien Arbeitenn in. KOrganizer markeert de Arbeitstünnen mit en anner Achtergrundklöör."

#. i18n: ectx: whatsthis, entry (Holidays), group (Time &amp; Date)
#. +> stable
#: eventviews.kcfg:108
msgid "Select from which region you want to use the holidays here. Defined holidays are shown as non-working days in the date navigator, the agenda view, etc."
msgstr "Söök de Regioon ut, vun de Du de Fierdaag bruken wullt. Fastleggte Fierdaag warrt binnen de Datumnavigatschoon, de Dagansicht usw. as fre'e Daag wiest."

#. i18n: ectx: label, entry, group (General View)
#. +> trunk stable
#: eventviews.kcfg:117
msgid "Enable tooltips for displaying summaries"
msgstr "Tosamenfaten binnen Kortinfos wiesen"

#. i18n: ectx: whatsthis, entry, group (General View)
#. +> trunk stable
#: eventviews.kcfg:118
msgid "Check this box to display summary tooltips when hovering the mouse over an event or a to-do."
msgstr "Maak dit an, wenn Du binnen de KortInformatschoon en Tosamenfaten vun dat Begeefnis hebben wullt, op dat Du mit de Muus wiest."

#. i18n: ectx: label, entry, group (General View)
#. +> trunk stable
#: eventviews.kcfg:123
msgid "To-dos use category colors"
msgstr "Opgaven hebbt Kategorienklören"

#. i18n: ectx: whatsthis, entry, group (General View)
#. +> trunk stable
#: eventviews.kcfg:124
msgid "Check this box so that to-dos will use category colors and not colors specific to their due, due today or overdue state"
msgstr "Maakt dit an, wenn Du Opgaven mit de Kategorienklören un nich mit Klören för ehr Afloopdatum wiesen wullt"

#. i18n: ectx: label, entry, group (Time &amp; Date)
#. +> stable
#: eventviews.kcfg:124
msgid "Exclude holidays"
msgstr "Nich op Fierdaag"

#. i18n: ectx: whatsthis, entry, group (Time &amp; Date)
#. +> stable
#: eventviews.kcfg:125
msgid "Check this box to prevent KOrganizer from marking the working hours on holidays."
msgstr "Maak dit an, wenn KOrganizer de Arbeitstünnen op Fierdaag nich markeren schall."

#. i18n: ectx: label, entry, group (General View)
#. +> trunk stable
#: eventviews.kcfg:129
msgid "Next x days"
msgstr "Nakamen Daag"

#. i18n: ectx: label, entry (ExpiryUnit), group (Archive Dialog)
#. +> stable
#: eventviews.kcfg:585
msgid "In days"
msgstr "In Daag"

#. i18n: ectx: whatsthis, entry, group (General View)
#. +> trunk stable
#: eventviews.kcfg:130
msgid "Select the number of \"x\" days to be displayed in the next days view. To access the  the next \"x\" days view, choose the \"Next X Days\" menu item from the \"View\" menu."
msgstr "Hier kannst Du fastleggen, wo vele Daag binnen de \"Nakamen Daag\"-Ansicht wiest warrt. Du kannst ehr över \"Nakamen Daag\" binnen dat \"Ansicht\"-Menü opropen."

#. i18n: ectx: tooltip, entry, group (General View)
#. +> trunk stable
#: eventviews.kcfg:131
msgid "Show this many days at a time in the Next \"x\" days view"
msgstr "Disse Tall vun Daag binnen de \"Nakamen Daag\"-Ansicht wiesen"

#. i18n: ectx: whatsthis, entry (StartTime), group (Default Datetimes)
#. +> stable
#: eventviews.kcfg:134
msgid "Enter the default time for events here. The default is used if you do not supply a start time."
msgstr "Hier kannst Du de Standardtiet för Begeefnissen angeven. Wenn Du keen Anfangtiet angiffst, warrt de Standardtiet nahmen."

#. i18n: ectx: label, entry (DailyRecur), group (General View)
#. +> trunk stable
#: eventviews.kcfg:136
msgid "Show items that recur daily"
msgstr "Indrääg mit Dag-Wedderhalen wiesen"

#. i18n: ectx: whatsthis, entry (DailyRecur), group (General View)
#. +> trunk stable
#: eventviews.kcfg:137
msgid "Check this box to show the days containing daily recurring events in bold typeface in the Date Navigator, or uncheck it to give more prominence to other (non daily recurring) events."
msgstr "Wenn anmaakt, warrt Daag mit Begeefnissen, de sik dagbaseert wedderhaalt, binnen de Datumnavigatschoon mit fette Schrift markeert. Wenn Du dat utmaakst, stickt anner Begeefnissen (ahn Dag-Wedderhalen) mehr rut."

#. i18n: ectx: label, entry (DefaultDuration), group (Default Datetimes)
#. +> stable
#: eventviews.kcfg:139
msgid "Default duration of new appointment (HH:MM)"
msgstr "Standardduer för niege Terminen (hh:mm)"

#. i18n: ectx: whatsthis, entry (DefaultDuration), group (Default Datetimes)
#. +> stable
#: eventviews.kcfg:140
msgid "Enter default duration for events here. The default is used if you do not supply an end time."
msgstr "Hier kannst Du en Standardduer för Begeefnissen fastleggen. Se warrt bruukt, wenn Du keen Enntiet angiffst."

#. i18n: ectx: label, entry (WeeklyRecur), group (General View)
#. +> trunk stable
#: eventviews.kcfg:142
msgid "Show items that recur weekly"
msgstr "Indrääg mit Week-Wedderhalen wiesen"

#. i18n: ectx: whatsthis, entry (WeeklyRecur), group (General View)
#. +> trunk stable
#: eventviews.kcfg:143
msgid "Check this box to show the days containing weekly recurring events in bold typeface in the Date Navigator, or uncheck it to give more prominence to other (non weekly recurring) events."
msgstr "Wenn anmaakt, warrt Daag mit Begeefnissen, de sik wekenbaseert wedderhaalt, binnen de Datumnavigatschoon mit fette Schrift markeert. Wenn Du dat utmaakst, stickt anner Begeefnissen (ahn Week-Wedderhalen) mehr rut."

#. i18n: ectx: label, entry (defaultEventReminders), group (Default Datetimes)
#. +> stable
#: eventviews.kcfg:145
msgid "Enable reminders for new Events"
msgstr "Anstööt för nieg Begeefnissen anmaken"

#. i18n: ectx: whatsthis, entry (defaultEventReminders), group (Default Datetimes)
#. +> stable
#: eventviews.kcfg:146
msgid "Check this box if you want to enable reminders for all newly created Events. You can always turn-off the reminders in the Event editor dialog."
msgstr "Maak dit an, wenn Du Anstööt för all nieg opstellt Begeefnissen anmaken wullt. Du kannst de Anstööt jümmers binnen den Begeefnis-Bewerkendialoog utmaken."

#. i18n: ectx: tooltip, entry (defaultEventReminders), group (Default Datetimes)
#. +> stable
#: eventviews.kcfg:147
msgid "By default, enable reminders for new events"
msgstr "Standardwies Anstööt för nieg Begeefnissen anmaken"

#. i18n: ectx: label, entry (HighlightTodos), group (General View)
#. +> trunk stable
#: eventviews.kcfg:148
msgid "Show to-dos instead of events when in Todo View"
msgstr "Binnen de Opgaven-Ansicht Opgaven ansteed Begeefnissen wiesen"

#. i18n: ectx: whatsthis, entry (HighlightTodos), group (General View)
#. +> trunk stable
#: eventviews.kcfg:149
msgid "Check this box to show the days containing to-dos in bold typeface in the Date Navigator when in to-do view."
msgstr "Maak dit an, wenn Du binnen de Opgaven Ansicht Daag mit Opgaven mit fett Schrift binnen de Datumnavigatschoon wiesen wullt"

#. i18n: ectx: label, entry (defaultTodoReminders), group (Default Datetimes)
#. +> stable
#: eventviews.kcfg:152
msgid "Enable reminders for new To-dos"
msgstr "Anstööt för nieg Opgaven anmaken"

#. i18n: ectx: whatsthis, entry (defaultTodoReminders), group (Default Datetimes)
#. +> stable
#: eventviews.kcfg:153
msgid "Check this box if you want to enable reminders for all newly created To-dos. You can always turn-off the reminders in the To-do editor dialog."
msgstr "Maak dit an, wenn Du Anstööt för all nieg opstellt Opgaven anmaken wullt. Du kannst de Anstööt jümmers binnen den Opgaav-Bewerkendialoog utmaken."

#. i18n: ectx: label, entry (HighlightJournals), group (General View)
#. +> trunk stable
#: eventviews.kcfg:154
msgid "Show journals instead of events when in Journal View"
msgstr "Binnen de Daagbook-Ansicht Daagböker ansteed Begeefnissen wiesen"

#. i18n: ectx: tooltip, entry (defaultTodoReminders), group (Default Datetimes)
#. +> stable
#: eventviews.kcfg:154
msgid "By default, enable reminders for new to-dos"
msgstr "Standardwies Anstööt för nieg Opgaven anmaken"

#. i18n: ectx: whatsthis, entry (HighlightJournals), group (General View)
#. +> trunk stable
#: eventviews.kcfg:155
msgid "Check this box to show the days containing journals in bold typeface in the Date Navigator when in journal view."
msgstr "Maak dit an, wenn Du binnen de Daagbook-Ansicht Daag mit Daagbook-Indrääg mit fett Schrift binnen de Datumnavigatschoon wiesen wullt"

#. i18n: ectx: label, entry (WeekNumbersShowWork), group (General View)
#. +> trunk stable
#: eventviews.kcfg:160
msgid "Week numbers select a work week when in work week mode"
msgstr "Weeknummern söökt en Arbeitweek ut, wenn Du in de Arbeitweek-Ansicht büst."

#. i18n: ectx: label, entry (ReminderTime), group (Default Datetimes)
#. +> stable
#: eventviews.kcfg:160
msgid "Default reminder time"
msgstr "Standardalarmtiet"

#. i18n: ectx: whatsthis, entry (WeekNumbersShowWork), group (General View)
#. +> trunk stable
#: eventviews.kcfg:161
