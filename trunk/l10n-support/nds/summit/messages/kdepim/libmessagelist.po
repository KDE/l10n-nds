#. +> trunk stable
#: core/manager.cpp:292
msgid "Current Activity, Threaded"
msgstr "Aktuell Aktiviteet mit Klöönsnacks"

#. +> trunk stable
#: core/manager.cpp:293
msgid "This view uses smart date range groups. Messages are threaded. So for example, in \"Today\" you will find all the messages arrived today and all the threads that have been active today."
msgstr "Disse Ansicht bruukt plietsch Datumrebeet-Koppeln, Narichten warrt as Klöönsnacks wiest. Binnen \"Vundaag\" schallst Du also all niege Narichten finnen, un ok all Klöönsnacks, binnen de sik vundaag wat daan hett."

#. +> trunk stable
#: core/manager.cpp:310
msgid "Current Activity, Flat"
msgstr "Aktuell Aktiviteet, flach"

#. +> trunk stable
#: core/manager.cpp:311
msgid "This view uses smart date range groups. Messages are not threaded. So for example, in \"Today\" you will simply find all the messages arrived today."
msgstr "Disse Ansicht bruukt plietsch Datumrebeet-Koppeln, Narichten warrt nich as Klöönsnacks wiest. Binnen \"Vundaag\" schallst Du also all Narichten finnen, de vundaag ankamen sünd."

#. +> trunk stable
#: core/manager.cpp:327
msgid "Activity by Date, Threaded"
msgstr "Aktiviteet na Datum, mit Klöönsnacks"

#. +> trunk stable
#: core/manager.cpp:328
msgid "This view uses day-by-day groups. Messages are threaded. So for example, in \"Today\" you will find all the messages arrived today and all the threads that have been active today."
msgstr "Disse Ansicht bruukt Enkeldag-Koppeln, Narichten warrt as Klöönsnacks wiest. Binnen \"Vundaag\" schallst Du also all niege Narichten finnen, un ok all Klöönsnacks, binnen de sik vundaag wat daan hett."

#. +> trunk stable
#: core/manager.cpp:345
msgid "Activity by Date, Flat"
msgstr "Aktiviteet na Datum, flach"

#. +> trunk stable
#: core/manager.cpp:346
msgid "This view uses day-by-day groups. Messages are not threaded. So for example, in \"Today\" you will simply find all the messages arrived today."
msgstr "Disse Ansicht bruukt Enkeldag-Koppeln, Narichten warrt nich as Klöönsnacks wiest. Binnen \"Vundaag\" schallst Du also all Narichten finnen, de vundaag ankamen sünd."

#. +> trunk stable
#: core/manager.cpp:362
msgid "Standard Mailing List"
msgstr "Normaal Nettpostlist"

#. +> trunk stable
#: core/manager.cpp:363
msgid "This is a plain and old mailing list view: no groups and heavy threading."
msgstr "Dat is en eenfach, ooltbacksch Narichtenlist-Ansicht: keen Koppeln un vele Klöönsnacks."

#. +> trunk stable
#: core/manager.cpp:376
msgid "Flat Date View"
msgstr "Flach Datumansicht"

#. +> trunk stable
#: core/manager.cpp:377
msgid "This is a plain and old list of messages sorted by date: no groups and no threading."
msgstr "Dat is en eenfach, ooltbacksch Ansicht vun Narichten, sorteert na Datum: keen Koppeln un keen Klöönsnacks."

#. +> trunk stable
#: core/manager.cpp:392
msgid "Senders/Receivers, Flat"
msgstr "Senner un Adressaten, flach"

#. +> trunk stable
#: core/manager.cpp:393
msgid "This view groups the messages by senders or receivers (depending on the folder type). Messages are not threaded."
msgstr "Disse Ansicht koppelt de Narichten na Senners oder Adressaten tosamen (hangt vun den Ornertyp af) un dat gifft keen Klöönsnacks."

#. +> trunk stable
#: core/manager.cpp:409
msgid "Thread Starters"
msgstr "Klöönsnackanfäng"

#. +> trunk stable
#: core/manager.cpp:410
msgid "This view groups the messages in threads and then groups the threads by the starting user."
msgstr "Disse Ansicht koppelt de Narichten as Klöönsnacks tosamen, un de warrt wedder na de Brukers tohoopstellt, de mit de Klöönsnacks anfungen hebbt."

