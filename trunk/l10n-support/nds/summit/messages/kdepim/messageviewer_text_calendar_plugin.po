#. +> trunk stable
#: attendeeselector.cpp:32
msgid "Select Attendees"
msgstr "Deelnehmers utsöken"

#. +> trunk stable
#: attendeeselector.cpp:42
msgid "Click to add a new attendee"
msgstr "Klick hier, wenn Du en nieg Deelnehmer tofögen wullt"

#. +> trunk stable
#: delegateselector.cpp:35
msgid "Select delegate"
msgstr "Viez utsöken"

#. +> trunk stable
#: delegateselector.cpp:42
msgid "Delegate:"
msgstr "Afgeven:"

#. +> trunk stable
#: delegateselector.cpp:45
msgid "Keep me informed about status changes of this incidence."
msgstr "Mi över Ännern för dit Begeefnis op Stand hollen"

#. +> trunk stable
#: text_calendar.cpp:402
#, kde-format
msgid "No attachment named \"%1\" found in the invitation."
msgstr "Keen Bilaag mit den Naam \"%1\" binnen de Inladen funnen"

#. +> trunk stable
#: text_calendar.cpp:410
#, kde-format
msgid "The invitation attachment \"%1\" is a web link that is inaccessible from this computer. Please ask the event organizer to resend the invitation with this attachment stored inline instead of a link."
msgstr "De Inladen-Bilaag \"%1\" is en Nettlink, op den sik vun dissen Reekner nich togriepen lett. Fraag bitte den Utrichter vun't Begeefnis, wat he de Inladen nochmaal mit de Bilaag binnenreegs ansteed as Link loosstüern kann."

#. +> trunk stable
#: text_calendar.cpp:465
msgid ""
"<qt>None of your identities match the receiver of this message,<br/>"
"please choose which of the following addresses is yours, if any, or select one of your identities to use in the reply:</qt>"
msgstr ""
"<qt>De Adressaat vun disse Naricht passt op keen vun Dien Identiteten<br/>"
"söök bitte de Adress ut, de Dien is, oder söök een vun Dien Identiteten för de Antwoort ut:</qt>"

#. +> trunk stable
#: text_calendar.cpp:471
msgid ""
"<qt>Several of your identities match the receiver of this message,<br/>"
"please choose which of the following addresses is yours:</qt>"
msgstr ""
"<qt>De Adressaat vun disse Naricht passt op mehr vun Dien Identiteten,<br/>"
"giff bitte de Adress an, de Dien is:</qt>"

