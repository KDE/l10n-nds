msgstr "Afgeven: %1"

#. +> trunk stable
#: text_calendar.cpp:636
#, kde-format
msgid "Forwarded: %1"
msgstr "Wiederleddt: %1"

#. +> trunk stable
#: text_calendar.cpp:639
#, kde-format
msgid "Declined Counter Proposal: %1"
msgstr "Afwiest Gegenvörslag: %1"

#. +> trunk stable
#: text_calendar.cpp:710
msgid "Reaction to Invitation"
msgstr "Antwoort op Inladen"

#. +> trunk stable
#: text_calendar.cpp:711 text_calendar.cpp:932
msgid "Comment:"
msgstr "Kommentar:"

#. +> trunk stable
#: text_calendar.cpp:744
msgid "Delegation to organizer is not possible."
msgstr "Afgeven na den Utrichter is nich mööglich"

#. +> trunk stable
#: text_calendar.cpp:866
msgid "Save Invitation Attachment"
msgstr "Inladen-Bilaag sekern"

#. +> trunk stable
#: text_calendar.cpp:873
#, kde-format
msgctxt "@info"
msgid ""
"File <filename>%1</filename> exists.<nl/>"
" Do you want to replace it?"
msgstr ""
"Dat gifft de Datei <filename>%1</filename> al.<nl/>"
" Wullt Du ehr överschrieven?"

#. +> trunk stable
#: text_calendar.cpp:931
msgid "Decline Counter Proposal"
msgstr "Gegenvörslag afwiesen"

#. +> trunk stable
#: text_calendar.cpp:965
msgid ""
"You have no writable calendar folders for invitations, so storing or saving a response will not be possible.\n"
"Please create at least 1 writable events calendar and re-sync."
msgstr ""
"Dien Kalenner bargt keen schriefbor Ornern för Inladen, dat heet, Sekern oder spiekern vun Antwoorden geiht nich.\n"
"Bitte stell tominnst een schriefbor Begeefniskalenner op un synkroniseer nieg."

#. +> trunk stable
#: text_calendar.cpp:1032
msgctxt "@info"
msgid ""
"The organizer is not expecting a reply to this invitation but you can send them an email message if you desire.\n"
"\n"
"Would you like to send the organizer a message regarding this invitation?\n"
"Press the [Cancel] button to cancel the recording operation."
msgstr ""
"De Utrichter verwacht keen Antwoort op de Inladen, man Du kannst em liekers een tostüern.\n"
"\n"
"Wullt Du em wegen de Inladen en Naricht tostüern?\n"
"Klick op \"Afbreken\", wenn Du afbreken wullt."

#. +> trunk stable
#: text_calendar.cpp:1036
msgctxt "@title:window"
msgid "Send Email to Organizer"
msgstr "Den Utrichter en Nettbreef tostüern"

#. +> trunk stable
#: text_calendar.cpp:1037
msgid "Do Not Send"
msgstr "Nich loosstüern"

#. +> trunk stable
#: text_calendar.cpp:1038
