msgctxt "@info"
msgid ""
"<title>Please select the folder for storing newly created contacts.</title>"
"<note>If the folder list below is empty, you might have to add an addressbook source through <interface>%1</interface> <br>"
"or change which folders you are subscribed to through <interface>%2</interface></note>"
msgstr ""
"<title>Bitte den Orner för nieg opstellt Kontakten utsöken</title>"
"<note>Steiht nix binnen de Ornerlist nerrn, muttst Du wull en Adressbook-Born mit <interface>%1</interface> tofögen<br>"
" oder Dien bestellt Ornern mit <interface>%2</interface> topassen.</note>"

