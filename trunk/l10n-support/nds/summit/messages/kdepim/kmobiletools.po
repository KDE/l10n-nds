#, kde-format
msgid ""
"<qt>"
"<p>KMobileTools has found an old or invalid configuration file.</p>"
"<p>To work correctly, it needs to delete your configuration files. Your old files will be saved in <b>%1</b></p>"
"</qt>"
msgstr ""
"<qt>"
"<p>KMobileTools hett en oolt oder leeg Instellendatei funnen.</p>"
