#. (itstool) path: component/name
#. +> future
#: knotes.appdata.xml:6
msgid "KNotes"
msgstr "KNotes"

#. (itstool) path: description/p
#. +> future
#: knotes.appdata.xml:8
msgid "KNotes is a program that lets you write the computer equivalent of sticky notes. The notes are saved automatically when you exit the program, and they display when you open the program."
msgstr "Mit KNotes kannst Du so wat as Anback-Notizen för den Reekner maken. De Notizen warrt bi't Utmaken vun't Programm automaatsch sekert un wedder wiest, wenn Du dat Programm wedder opröppst."

#. (itstool) path: description/p
#. +> future
#: knotes.appdata.xml:12
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#. +> future
#: knotes.appdata.xml:14
msgid "Write notes in your choice of font and background color"
msgstr "De Notizen mit Dien Schriftoort un Achtergrundklöör schrieven"

#. (itstool) path: ul/li
#. +> future
#: knotes.appdata.xml:15
msgid "Use drag and drop to email your notes"
msgstr "Notizen över Trecken un Afleggen mit Nettpost loosstüern"

#. (itstool) path: ul/li
#. +> future
#: knotes.appdata.xml:16
msgid "Can be dragged into Calendar to book a time-slot"
msgstr "Laat sik na den Kalenner trecken, wat en Stoot Tiet reserveren deit"

#. (itstool) path: ul/li
#. +> future
#: knotes.appdata.xml:17
msgid "Notes can be printed"
msgstr "Notizen laat sik drucken"
