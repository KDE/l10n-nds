#. +> future stable
#: kwatchgnupgmainwin.cpp:153
msgid ""
"The watchgnupg logging process could not be started.\n"
"Please install watchgnupg somewhere in your $PATH.\n"
"This log window is unable to display any useful information."
msgstr ""
"De Logperzess \"watchgnupg\" lett sik nich starten.\n"
"Installeer \"watchgnupg\" bitte na en Steed, woneem\n"
"sik dat över Dien PATH-Variabel finnen lett.\n"
"Dit Logbookfinster kann keen Informatschonen wiesen."

#. +> future stable
#: kwatchgnupgmainwin.cpp:155
#, kde-format
msgid "[%1] Log started"
msgstr "[%1] Loggen anfungen"

#. +> future stable
#: kwatchgnupgmainwin.cpp:190
msgid "There are no components available that support logging."
msgstr "Keen Komponenten verföögbor, de dat Schrieven vun Logböker ünnerstütt."

#. +> future stable
#: kwatchgnupgmainwin.cpp:196
msgid ""
"The watchgnupg logging process died.\n"
"Do you want to try to restart it?"
msgstr ""
"De Logperzess \"watchgnupg\" bröök af.\n"
"Wullt Du em nieg starten?"

#. +> future stable
#: kwatchgnupgmainwin.cpp:196
msgid "Try Restart"
msgstr "Nieg starten"

#. +> future stable
#: kwatchgnupgmainwin.cpp:196
msgid "Do Not Try"
msgstr "Nich nieg starten"

#. +> future stable
#: kwatchgnupgmainwin.cpp:197
