#: wakedlg.cpp:56
msgctxt "@title:window"
msgid "Wake From Suspend"
msgstr "Wedderanmaken na Utsetten"

#. +> trunk stable
#: wakedlg.cpp:181
msgctxt "@info"
msgid "Cannot schedule wakeup time for a date-only alarm"
msgstr "Bi en reen Datumalarm lett sik keen Wedderanmaaktiet planen."

#. +> trunk stable
#: wakedlg.cpp:185
msgctxt "@info"
msgid ""
"<para>This wakeup will cancel any existing wakeup which has been set by KAlarm or any other application, because your computer can only schedule a single wakeup time.</para>"
"<para><b>Note:</b> Wake From Suspend is not supported at all on some computers, especially older ones, and some computers only support setting a wakeup time up to 24 hours ahead. You may wish to set up a test alarm to check your system's capability.</para>"
msgstr ""
"<para>Dit Wedderanmaken treckt all vun KAlarm oder anner Programmen instellt Wedderanmaakalarms af, wiel Dien Reekner bloots een enkelten Alarm üm kann.</para>"
"<para><b>Beacht:</b> Nich all Reekners ünnerstütt \"Wedderanmaken na Utsetten\", sünnerlich, wenn se wat öller sünd. Anner Reekners ünnerstütt bloots en Wedderanmaaktiet bet to 24 Stünnen. Op't best probeerst Du eerstmaal ut, wat Dien Systeem disse Alarms ok redig  ünnerstütten deit.</para>"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#. +> trunk stable
#: wakedlg.ui:17
msgid "Wake From Suspend Alarm"
msgstr "Alarm för't Wedderanmaken na Utsetten"

#. i18n: ectx: property (toolTip), widget (QPushButton, showWakeButton)
#. +> trunk stable
#: wakedlg.ui:38
msgid "Show current wake-from-suspend alarm"
msgstr "Aktuell Alarm för't Wedderanmaken na Utsetten wiesen"

#. i18n: ectx: property (whatsThis), widget (QPushButton, showWakeButton)
#. +> trunk stable
#: wakedlg.ui:41
msgid "Highlight the current wake-from-suspend alarm in the alarm list. This button is disabled if no wake-from-suspend alarm is configured."
msgstr "Aktuell Alarm för't Wedderanmaken na Utsetten in de Alarmlist markeren. Is  \"Alarm för't Wedderanmaken na Utsetten\" nich instellt, is disse Knoop ahn Funkschoon."

#. i18n: ectx: property (text), widget (QPushButton, showWakeButton)
#. +> trunk stable
#: wakedlg.ui:44
msgid "Show current alarm"
msgstr "Aktuell Alarm wiesen"

#. i18n: ectx: property (toolTip), widget (QPushButton, useWakeButton)
#. +> trunk stable
#: wakedlg.ui:51
msgid "Set highlighted alarm as the wake-from-suspend alarm"
msgstr "Markeert Alarm as Alarm för't Wedderanmaken na Utsetten fastleggen"

#. i18n: ectx: property (whatsThis), widget (QPushButton, useWakeButton)
#. +> trunk stable
#: wakedlg.ui:54
msgid "Set the alarm highlighted in the alarm list to wake-from-suspend. This replaces any existing wake-from-suspend alarm."
msgstr "Markeert Alarm in de Alarmlist as Alarm för't Wedderanmaken na Utsetten fastleggen. He warrt ansteed en vörhannen Alarm för't Wedderanmaken na Utsetten bruukt."

#. i18n: ectx: property (text), widget (QPushButton, useWakeButton)
#. +> trunk stable
#: wakedlg.ui:57
msgid "Use highlighted alarm"
msgstr "Utsöcht Alarm bruken"

#. i18n: ectx: property (toolTip), widget (QPushButton, cancelWakeButton)
#. +> trunk stable
#: wakedlg.ui:70
msgid "Cancel the current wake-from-suspend"
msgstr "Aktuell Wedderanmaken na Utsetten torüchtrecken"

#. i18n: ectx: property (whatsThis), widget (QPushButton, cancelWakeButton)
#. +> trunk stable
#: wakedlg.ui:73
msgid "Cancel the currently configured wake-from-suspend. Note that this does not cancel the alarm itself, which will still trigger in the normal way. This button is disabled if no wake-from-suspend alarm is configured."
msgstr "Aktuell fastleggt Wedderanmaken na Utsetten torüchtrecken. Beacht, dat dit nich den Alarm sülven afbreken deit, he warrt normaal utlööst. Is \"Alarm för't Wedderanmaken na Utsetten\" nich instellt, is disse Knoop ahn Funkschoon."

#. i18n: ectx: property (text), widget (QPushButton, cancelWakeButton)
#. +> trunk stable
#: wakedlg.ui:76
msgid "Cancel wake from suspend"
msgstr "Wedderanmaken na Utsetten torüchtrecken"

#. i18n: ectx: property (whatsThis), widget (QSpinBox, advanceWakeTime)
#. +> trunk stable
#: wakedlg.ui:109
msgid "Enter how many minutes before the alarm trigger time to wake the system from suspend. This can be used to ensure that the system is fully restored by the time the alarm triggers."
msgstr "Giff de Tall vun Minuten in, ehr de Alarm för de Wedderanmaaktiet na Utsetten utlööst warrt. Dat lett sik bruken, dormit dat Systeem heel wedderherstellt warrt, ehr de Alarm utlööst warrt."

#. i18n: ectx: property (text), widget (QLabel, label)
#. +> trunk stable
#: wakedlg.ui:119
msgid "Number of minutes before alarm to wake from suspend"
msgstr "Tall vun Minuten vör Alarm för't Wedderanmaken na Utsetten"

