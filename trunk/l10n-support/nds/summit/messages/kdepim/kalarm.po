msgstr "Vörgrundklöör:"

#. i18n: ectx: whatsthis, entry (DefaultFgColour), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:84
msgctxt "@info:whatsthis"
msgid "Default foreground color for alarm message windows."
msgstr "Standard-Vörgrundklöör för Alarmbescheden."

#. i18n: ectx: label, entry (DefaultBgColour), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:88
msgctxt "@label"
msgid "Background color"
msgstr "Achtergrundklöör"

#. i18n: ectx: whatsthis, entry (DefaultBgColour), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:89
msgctxt "@info:whatsthis"
msgid "Default background color for alarm message windows."
msgstr "Standard-Achtergrundklöör för Alarmbescheden."

#. i18n: ectx: label, entry (MessageFont), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:93
msgctxt "@label"
msgid "Message font"
msgstr "Bescheed-Schriftoort"

#. i18n: ectx: whatsthis, entry (MessageFont), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:94
msgctxt "@info:whatsthis"
msgid "Default font for displaying alarm messages."
msgstr "Standardschriftoort för Alarmbescheden"

#. i18n: ectx: label, entry (ShowInSystemTray), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:99
msgctxt "@label"
msgid "Show in system tray"
msgstr "In Systeemafsnitt wiesen"

#. i18n: ectx: whatsthis, entry (ShowInSystemTray), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:100 prefdlg.cpp:1610
msgctxt "@info:whatsthis"
msgid "<para>Check to show <application>KAlarm</application>'s icon in the system tray. Showing it in the system tray provides easy access and a status indication.</para>"
msgstr "<para>Maak dit an, wenn Du <application>KAlarm</application> sien Lüttbild binnen den Systeemafsnitt hebben wullt. Över dat Lüttbild is de Togriep eenfach, un dat stellt den Tostand dor.</para>"

#. i18n: ectx: label, entry (AutoHideSystemTray), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:105
msgctxt "@label"
msgid "Auto-hide in system tray if no alarms due within period"
msgstr ""

#. i18n: ectx: whatsthis, entry (AutoHideSystemTray), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:106
msgctxt "@info:whatsthis"
msgid ""
"<para>Enter -1 to auto-hide <application>KAlarm</application>'s icon in the system tray when there are no active alarms.</para>"
"<para>To auto-hide the system tray icon when there are no alarms due within a set period of time, enter the time period in minutes.</para>"
"<para>Enter 0 to always show the system tray icon.</para>"
msgstr ""

#. i18n: ectx: label, entry (AutoStart), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:111
msgctxt "@label"
msgid "Start at login"
msgstr "Bi't Anmellen starten"

#. i18n: ectx: whatsthis, entry (AutoStart), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:112 prefdlg.cpp:427
msgctxt "@info:whatsthis"
msgid ""
"<para>Automatically start <application>KAlarm</application> whenever you start KDE.</para>"
"<para>This option should always be checked unless you intend to discontinue use of <application>KAlarm</application>.</para>"
msgstr ""
"<para><application>KAlarm</application>jümmers automaatsch starten, wenn Du Di bi KDE anmeldst.</para>"
"<para>Disse Optschoon schull jümmers anmaakt wesen, wenn Du <application>KAlarm</application> ok wiederhen bruken wullt.</para>"

#. i18n: ectx: label, entry (NoAutoStart), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:116
msgctxt "@label"
msgid "Suppress autostart at login"
msgstr "Bi't Anmellen nich automaatsch starten"

#. i18n: ectx: label, entry (DefaultDeferTime), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:120
msgctxt "@label"
msgid "Default defer time interval"
msgstr "Standard-Tietverschuven"

#. i18n: ectx: whatsthis, entry (DefaultDeferTime), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:121
msgctxt "@info:whatsthis"
msgid "Enter the default time interval (in minutes) to defer alarms, used by the Defer Alarm dialog."
msgstr "Hier kannst Du de Standardtiet (in Minuten) för de Alarmverschuven ingeven, de vun den Alarmverschuven-Dialoog bruukt warrt."

#. i18n: ectx: label, entry (AskResource), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:125
msgctxt "@label"
msgid "Prompt for which calendar to store in"
msgstr "Na den Kalenner fragen, na den sekert warrt"

#. i18n: ectx: whatsthis, entry (AskResource), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:126 prefdlg.cpp:853
msgctxt "@info:whatsthis"
msgid ""
"<para>When saving a new alarm or alarm template, prompt for which calendar to store it in, if there is more than one active calendar.</para>"
"<para>Note that archived alarms are always stored in the default archived alarm calendar.</para>"
msgstr ""
"<para>Bi't Sekern vun en nieg Alarm oder Alarmvörlaag warrt na den Kalenner fraagt, na den Du sekern wullt, wenn mehr as een Kalenner anmaakt is.</para>"
"<para>Beacht bitte: Aflopen Alarms warrt jümmers binnen de Standardkalenner för aflopen Alarms wohrt.</para>"

#. i18n: ectx: label, entry (ModalMessages), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:131
msgctxt "@label"
msgid "Message windows have a title bar and take keyboard focus"
msgstr "Bescheden hebbt en Titelbalken un kriegt den Ingaavfokus"

#. i18n: ectx: whatsthis, entry (ModalMessages), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:132 prefdlg.cpp:1778
msgctxt "@info:whatsthis"
msgid ""
"<para>Specify the characteristics of alarm message windows:"
"<list>"
"<item>If checked, the window is a normal window with a title bar, which grabs keyboard input when it is displayed.</item>"
"<item>If unchecked, the window does not interfere with your typing when it is displayed, but it has no title bar and cannot be moved or resized.</item>"
"</list>"
"</para>"
msgstr ""
"<para>Hier kannst Du de Egenschappen vun Alarmbescheden fastleggen:"
"<list>"
"<item>Wenn anmaakt, is dat en normaal Finster mit en Titelbalken, dat bi't Opduken den Fokus för Tastatuuringaven kriggt.</item>"
"<item>Is dat nich anmaakt, stöört dat Finster Di nich bi't Tippen, wenn dat opdukt, man dat hett denn ok keen Titelbalken un Du kannst dat nich verschuven oder sien Grött topassen.</item>"
"</list>"
"</para>"

#. i18n: ectx: label, entry (MessageButtonDelay), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:136
msgctxt "@label"
msgid "Delay before message window buttons are enabled"
msgstr "Paus, ehr de Knööp binnen Bescheden anmaakt warrt"

#. i18n: ectx: whatsthis, entry (MessageButtonDelay), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:141
msgctxt "@info:whatsthis"
msgid ""
"<para>Specify the positioning of alarm message windows, and the delay in seconds after a window shows until its buttons are enabled.\n"
"        "
"<list>"
"<item>0 to position message windows as far from the cursor as possible with no enable delay.</item>"
"\n"
"        "
"<item>> 0 to position in center of screen and specify delay before enabling buttons.</item>"
"\n"
"        "
"<item>-1 for no special positioning and no enable delay.</item>"
"</list>"
"</para>"
"\n"
"      "
msgstr ""
"<para>Leggt de Steed för Bescheden fast un de Töövtiet in Sekunnen, ehr den Bescheed sien Knööp anmaakt warrt.\n"
"        "
"<list>"
"<item>\"0\" wiest den Bescheed so wiet as mööglich weg vun den Muuswieser, keen Töövtiet</item>"
"\n"
"        "
"<item>En Tall >0 wiest den Bescheed op de Schirmmerrn, de Tall gifft de Töövtiet för de Knööp an</item>"
"\n"
"        "
"<item>\"-1\" leggt keen besünner Steed fast, keen Töövtiet</item>"
"</list>"
"</para>"
"\n"
"      "

#. i18n: ectx: label, entry (TooltipAlarmCount), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:147
msgctxt "@label"
msgid "Number of alarms to show in system tray tooltip"
msgstr "Tall vun Alarms binnen de Systeemafsnitt-Kortinformatschoon"

#. i18n: ectx: whatsthis, entry (TooltipAlarmCount), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:152
msgctxt "@info:whatsthis"
msgid ""
"<para>How many alarms due in the next 24 hours to show in the system tray tooltip:\n"
"        "
"<list>"
"<item>0 to display none</item>"
"\n"
"        "
"<item>-1 to display all</item>"
"\n"
"        "
"<item>>0 to set a limit.</item>"
"</list>"
"</para>"
"\n"
"      "
msgstr ""
"<para>Leggt fast, wo vele vun de Alarms binnen de Systeemafsnitt-Kortinfo wiest warrt, de binnen de tokamen 24 Stünnen afloopt:\n"
"        "
"<list>"
"<item>\"0\" wiest keeneen</item>"
"\n"
"        "
"<item>\"-1\" wiest all</item>"
"\n"
"        "
"<item>En Tall >0 sett en Grenz fast</item>"
"</list>"
"</para>"
"\n"
"      "

#. i18n: ectx: label, entry (ShowTooltipAlarmTime), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:158
msgctxt "@label"
msgid "Show alarm times in system tray tooltip"
msgstr "Alarmtieden binnen Systeemafsnitt-Kortinformatschoon wiesen"

#. i18n: ectx: whatsthis, entry (ShowTooltipAlarmTime), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:159 prefdlg.cpp:1685
msgctxt "@info:whatsthis"
msgid "Specify whether to show in the system tray tooltip, the time at which each alarm is due."
msgstr "Hier kannst Du fastleggen, wat in de Systeemafsnitt-Kortinformatschoon de Alarmtieden wiest warrt."

#. i18n: ectx: label, entry (ShowTooltipTimeToAlarm), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:164
msgctxt "@label"
msgid "Show time to alarms in system tray tooltip"
msgstr "Alarm-Resttieden binnen Systeemafsnitt-Kortinformatschoon wiesen"

#. i18n: ectx: whatsthis, entry (ShowTooltipTimeToAlarm), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:165 prefdlg.cpp:1691
msgctxt "@info:whatsthis"
msgid "Specify whether to show in the system tray tooltip, how long until each alarm is due."
msgstr "Hier kannst Du fastleggen, wat in de Systeemafsnitt-Kortinformatschoon de Alarms ehr Resttieden wiest warrt."

#. i18n: ectx: label, entry (TooltipTimeToPrefix), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:170
msgctxt "@label"
msgid "Time-to-alarm prefix in system tray tooltip"
msgstr "Vöranstellen för Resttieden binnen Systeemafsnitt-Kortinformatschoon"

#. i18n: ectx: whatsthis, entry (TooltipTimeToPrefix), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:171 prefdlg.cpp:1700
msgctxt "@info:whatsthis"
msgid "Enter the text to be displayed in front of the time until the alarm, in the system tray tooltip."
msgstr "Hier kannst Du Text ingeven, de vöran de Alarms ehr Resttieden in de Systeemafsnitt-Kortinformatschoon wiest warrt."

#. i18n: ectx: label, entry (EmailClient), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:176
msgctxt "@label"
msgid "Email client"
msgstr "Nettpostprogramm"

#. i18n: ectx: whatsthis, entry (EmailClient), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:177
msgctxt "@info:whatsthis"
msgid ""
"<para>How to send email when an email alarm is triggered."
"<list>"
"<item>KMail: The email is sent automatically via <application>KMail</application>. <application>KMail</application> is started first if necessary.</item>"
"<item>Sendmail: The email is sent automatically. This option will only work if your system is configured to use <application>sendmail</application> or a sendmail compatible mail transport agent.</item>"
"</list>"
"</para>"
msgstr ""
"<para>Leggt fast, wodennig Nettbreven loosstüert warrt, wenn en Nettpostalarm utlööst warrt."
"<list>"
"<item>KMail: De Nettbreef warrt automaatsch mit <application>KMail</application> loosstüert. <application>KMail</application> warrt toeerst opropen, wenn't noot deit.</item>"
"<item>Sendmail: De Nettbreef warrt automaatsch loosstüert. Disse Optschoon funkscheneert bloots, wenn op Dien Systeem <application>sendmail</application> oder en kompatibel Programm inricht is.</item>"
"</list>"
"</para>"

#. i18n: ectx: label, entry (EmailClient), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:179
msgctxt "@option"
msgid "Sendmail"
msgstr "Sendmail"

#. i18n: ectx: label, entry (EmailClient), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:180
msgctxt "@option"
msgid "KMail"
msgstr "KMail"

#. i18n: ectx: label, entry (Base_EmailCopyToKMail), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:185
msgctxt "@label"
msgid "Whether to copy sent emails into KMail's Sent folder."
msgstr "Leggt fast, wat loosstüert Nettbreven na KMail sien Loosstüert-Orner kopeert warrt"

#. i18n: ectx: whatsthis, entry (Base_EmailCopyToKMail), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:186
msgctxt "@info:whatsthis"
msgid "Whether after sending an email to store a copy in KMail's sent-mail folder. Only applies when sendmail is selected as the email client."
msgstr "Leggt fast, wat Nettbreven na't Loosstüern as Kopie binnen KMail sien Orner för loosstüert Nettbreven wohrt warrt. Warrt bloots bruukt, wenn sendmail as Nettpostprogramm utsöcht is."

#. i18n: ectx: label, entry (Base_EmailFrom), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:190
msgctxt "@label"
msgid "'From' email address"
msgstr "De \"Vun\"-Nettpostadress"

#. i18n: ectx: whatsthis, entry (Base_EmailFrom), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:191
msgctxt "@info:whatsthis"
msgid "Your email address, used to identify you as the sender when sending email alarms. Enter \"@SystemSettings\" to use the email address set in System Settings, \"@KMail\" to allow choice of KMail identities, or enter the actual email address otherwise."
msgstr "De Nettpostadress, de vun Nettpostalarms na't \"Vun\"-Feld inföögt warrt. Mit \"@SystemSettings\" warrt de Adress ut de Systeeminstellen bruukt, bi \"@KMail\" laat sik de KMail-Identiteten utsöken, oder sünst en propper Nettpostadress."

#. i18n: ectx: label, entry (Base_EmailBccAddress), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:195
msgctxt "@label"
msgid "'Bcc' email address"
msgstr "Blindkopie-Nettpostadress"

#. i18n: ectx: whatsthis, entry (Base_EmailBccAddress), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:196
msgctxt "@info:whatsthis"
msgid "Your email address, used for blind copying email alarms to yourself. If you want blind copies to be sent to your account on the computer which KAlarm runs on, you can simply enter your user login name. Enter \"@SystemSettings\" to use the email address set in System Settings, or enter the actual email address otherwise."
msgstr "De Nettpostadress, de en Blindkopie vun de Alarmnettbreven tostüert warrt. Wenn Du Blindkopien Dien Konto op den Reekner tostüern wullt, op den ok KAlarm löppt, kannst Du eenfach Dien Brukernaam ingeven. Giff \"@SystemSettings\" in, wenn Du de Adress bruken wullt, de Du binnen de Systeeminstellen fastleggt hest, oder sünst en anner propper Nettpostadress."

#. i18n: ectx: label, entry (Base_CmdXTermCommand), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:200
msgctxt "@label"
msgid "Terminal for command alarms"
msgstr "Terminal för Befehlalarms"

#. i18n: ectx: whatsthis, entry (Base_CmdXTermCommand), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:201
msgctxt "@info:whatsthis"
msgid "Command line to execute command alarms in a terminal window, including special codes described in the KAlarm handbook."
msgstr "Befehlsreeg, de Befehlalarms binnen en Konsoolfinster utföhrt. Besünner Koden sünd binnen dat KAlarm-Handbook beschreven."

#. i18n: ectx: label, entry (Base_StartOfDay), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:204
msgctxt "@label"
msgid "Start of day for date-only alarms"
msgstr "Daganfang för reen Datumalarms"

#. i18n: ectx: whatsthis, entry (Base_StartOfDay), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:205
msgctxt "@info:whatsthis"
msgid "The earliest time of day at which a date-only alarm will be triggered."
msgstr "De fröhste Tiet, to de en reen Datumalarm (d.h. en Alarm, för den Du \"Jichtenseen Klock\" fastleggt hest) utlööst warrt."

#. i18n: ectx: label, entry (Base_WorkDayStart), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:210
msgctxt "@label"
msgid "Start time of working day"
msgstr "Arbeitdag-Anfangtiet"

#. i18n: ectx: whatsthis, entry (Base_WorkDayStart), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:211
msgctxt "@info:whatsthis"
msgid "The start time of the working day."
msgstr "De Anfangtiet vun den Arbeitdag"

#. i18n: ectx: label, entry (Base_WorkDayEnd), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:216
msgctxt "@label"
msgid "End time of working day"
msgstr "Arbeitdag-Enn"

#. i18n: ectx: whatsthis, entry (Base_WorkDayEnd), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:217
msgctxt "@info:whatsthis"
msgid "The end time of the working day."
msgstr "Dat Enn vun den Arbeitdag"

#. i18n: ectx: label, entry (Base_WorkDays), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:222
msgctxt "@label"
msgid "Working days"
msgstr "Warkdaag"

#. i18n: ectx: whatsthis, entry (Base_WorkDays), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:223
msgctxt "@info:whatsthis"
msgid "OR'ed bits indicating which days of the week are work days, 1 = Monday ... 64 = Sunday."
msgstr "Mit OR tosamenföögt Bits, se geevt de Warkdaag vun de Week an. 1=Maandag, ... , 64=Sünndag"

#. i18n: ectx: label, entry (DisabledColour), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:228
msgctxt "@label"
msgid "Disabled alarm color"
msgstr "Klöör för utmaakt Alarms"

#. i18n: ectx: whatsthis, entry (DisabledColour), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:229 prefdlg.cpp:1720
msgctxt "@info:whatsthis"
msgid "Choose the text color in the alarm list for disabled alarms."
msgstr "Hier kannst Du de Textklöör för utmaakte Alarms binnen de Alarmlist utsöken."

#. i18n: ectx: label, entry (ArchivedColour), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:234
msgctxt "@label"
msgid "Archived alarm color"
msgstr "Klöör för aflopen Alarms"

#. i18n: ectx: whatsthis, entry (ArchivedColour), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:235 prefdlg.cpp:1730
msgctxt "@info:whatsthis"
msgid "Choose the text color in the alarm list for archived alarms."
msgstr "Hier kannst Du de Textklöör för aflopen Alarms binnen de Alarmlist utsöken."

#. i18n: ectx: label, entry (ArchivedKeepDays), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:240
msgctxt "@label"
msgid "Days to keep expired alarms"
msgstr "Wohrtiet in Daag för aflopen Alarms"

#. i18n: ectx: whatsthis, entry (ArchivedKeepDays), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:245
msgctxt "@info:whatsthis"
msgid ""
"<para>Specify how many days to keep alarms after they expire or are deleted (except deleted alarms which were never triggered):\n"
"        "
"<list>"
"<item>0 to not keep</item>"
"\n"
"        "
"<item>-1 to keep indefinitely</item>"
"\n"
"        "
"<item>>0 number of days to keep.</item>"
"</list>"
"</para>"
"\n"
"      "
msgstr ""
"<para>Leggt fast, wo vele Daag Alarms ok na't Aflopen oder Wegdoon wohrt warrt (utbenahmen wegdaan Alarms, de nienich utlööst wöörn):\n"
"        "
"<list>"
"<item>\"0\" wohrt nix</item>"
"\n"
"        "
"<item>\"-1\" wohrt för all Tiet</item>"
"\n"
"        "
"<item>En Tall >0 gifft de Daag an, de Alarms wohrt warrt</item>"
"</list>"
"</para>"
"\n"
"      "

#. i18n: ectx: label, entry (KOrgEventDuration), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:251
msgctxt "@label"
msgid "KOrganizer event duration"
msgstr "KOrganizer-Begeefnisduer"

#. i18n: ectx: whatsthis, entry (KOrgEventDuration), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:252
msgctxt "@info:whatsthis"
msgid "Enter the event duration in minutes, for alarms which are copied to KOrganizer."
msgstr "Giff de Begeefnisduer in Minuten in, för Alarms, de na KOrganizer kopeert warrt."

#. i18n: ectx: label, entry (WakeFromSuspendAdvance), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:256
msgctxt "@label"
msgid "Number of minutes before alarm to wake from suspend"
msgstr "Tall vun Minuten vör Alarm för't Wedderanmaken na Utsetten"

#. i18n: ectx: whatsthis, entry (WakeFromSuspendAdvance), group (General)
#. +> trunk stable
#: kalarmconfig.kcfg:257
msgctxt "@info:whatsthis"
msgid "Enter how many minutes before the alarm trigger time to wake the system from suspend. This can be used to ensure that the system is fully restored by the time the alarm triggers."
msgstr "Giff de Tall vun Minuten in, ehr de Alarm för de Wedderanmaaktiet na Utsetten utlööst warrt. Dat lett sik bruken, dormit dat Systeem heel wedderherstellt warrt, ehr de Alarm utlööst warrt."

#. i18n: ectx: label, entry (DefaultLateCancel), group (Defaults)
#. +> trunk stable
#: kalarmconfig.kcfg:263
msgctxt "@label"
msgid "Cancel if late (minutes)"
msgstr "Övergahn, wenn al to laat (Minuten)"

#. i18n: ectx: whatsthis, entry (DefaultLateCancel), group (Defaults)
#. +> trunk stable
#: kalarmconfig.kcfg:264
msgctxt "@info:whatsthis"
msgid "Default value in the alarm edit dialog for late cancellation time (in minutes). 0 for no late cancellation, >0 how many minutes before cancelling."
msgstr "Standardtiet binnen den Bewerkdialoog för't Övergahn, wenn dat al to laat is (in Minuten). \"0\" övergeiht nix, en Tall >0 gifft de Tiet in Minuten an, ehr de Alarm övergahn warrt."

#. i18n: ectx: label, entry (DefaultAutoClose), group (Defaults)
#. +> trunk stable
#: kalarmconfig.kcfg:269
msgctxt "@label"
msgid "Auto-close window after late-cancellation time"
msgstr "Finster na To-laat-Tiet automaatsch tomaken"

#. i18n: ectx: whatsthis, entry (DefaultAutoClose), group (Defaults)
#. +> trunk stable
#: kalarmconfig.kcfg:270
msgctxt "@info:whatsthis"
msgid "Default setting in the alarm edit dialog for \"auto close if late\"."
msgstr "De Standardinstellen för \"Automaatsch Tomaken wenn al to laat\" in den Bewerkdialoog"

#. i18n: ectx: label, entry (DefaultConfirmAck), group (Defaults)
#. +> trunk stable
#: kalarmconfig.kcfg:274
msgctxt "@label"
msgid "Confirm acknowledgement"
msgstr "Nafraag bito"

#. i18n: ectx: whatsthis, entry (DefaultConfirmAck), group (Defaults)
#. +> trunk stable
