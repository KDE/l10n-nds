msgid "KOrganizer"
msgstr "KOrganizer"

#. (itstool) path: description/p
#. +> trunk
#: korganizer.appdata.xml:8
msgid ""
"KOrganizer is the calendar and scheduling component of the Kontact suite. You "
"can write journal entries, schedule appointments, events, and to-dos."
msgstr ""
"KOrganizer is de Plaan- un Kalennerkomponent binnen de Kontact-Sammeln. Du "
"kannst Daagbookindrääg schrieven un Möten, Begeefnissen un Opgaven planen."

