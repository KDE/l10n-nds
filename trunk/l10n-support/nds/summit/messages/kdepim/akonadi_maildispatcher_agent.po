#. +> trunk
#: maildispatcheragent.cpp:119 maildispatcheragent.cpp:243
#, kde-format
msgid "Sending messages (1 item in queue)..."
msgid_plural "Sending messages (%1 items in queue)..."
msgstr[0] "Narichten warrt loosstüert (1 Indrag binnen Reeg)..."
msgstr[1] "Narichten warrt loosstüert (%1 Indrääg binnen Reeg)..."

#. +> trunk
#: maildispatcheragent.cpp:130
msgid "Sending cancelled."
msgstr "Loosstüern afbraken."

#. +> trunk
#: maildispatcheragent.cpp:137
msgid "Finished sending messages."
msgstr "Loosstüern vun Narichten afslaten."

#. +> trunk
#: maildispatcheragent.cpp:140
msgid "No items in queue."
msgstr "Keen Indrääg binnen Reeg."

#. +> trunk
#: maildispatcheragent.cpp:184
msgid "Online, sending messages in queue."
msgstr "Tokoppelt, Narichten binnen Reeg warrt loosstüert."

#. +> trunk
#: maildispatcheragent.cpp:188
msgid "Offline, message sending suspended."
msgstr "Afkoppelt, Loosstüern vun Narichten utsett."

#. +> trunk
#: maildispatcheragent.cpp:276
msgid "Ready to dispatch messages."
msgstr "Praat för't Verdelen vun Narichten."

#. i18n: ectx: label, entry (Outbox), group (General)
#. +> trunk
#: maildispatcheragent.kcfg:10
msgid "Outbox collection id"
msgstr "ID vun de Postutgang-Sammeln"

#. i18n: ectx: label, entry (SentMail), group (General)
#. +> trunk
#: maildispatcheragent.kcfg:14
msgid "Sent Mail collection id"
msgstr "ID vun de Loosstüert-Sammeln"

#. +> trunk
#: sendjob.cpp:100 sendjob.cpp:101
msgid "Message sending aborted."
msgstr "Loosstüern vun Narichten afbraken."

#. +> trunk
#: sendjob.cpp:109
msgid "Could not initiate message transport. Possibly invalid transport."
msgstr ""
"Överdregen vun Narichten lett sik nich anstöten. Villicht is de "
"Överdreegmetood leeg?"

#. +> trunk
#: sendjob.cpp:133
#, kde-format
msgid "Failed to get D-Bus interface of resource %1."
msgstr "De D-Bus-Koppelsteed vun Ressource \"%1\" lett sik nich halen."

#. +> trunk
#: sendjob.cpp:146
#, kde-format
msgid "Invalid D-Bus reply from resource %1."
msgstr "Leeg D-Bus-Antwoort vun Ressource \"%1\"."

#. +> trunk
#: sendjob.cpp:232
msgid "Message transport aborted."
msgstr "Överdregen vun Narichten afbraken."

#. +> trunk
#: sendjob.cpp:234
msgid "Failed to transport message."
msgstr "Naricht lett sik nich överedregen."

#. +> trunk
#: sendjob.cpp:263
msgid "Invalid sent-mail folder. Keeping message in outbox."
msgstr "Leeg Loosstüerte-Orner. Naricht warrt binnen Postutgang wohrt."

#. +> trunk
#: sendjob.cpp:284
msgid "Sending succeeded, but failed to finalize message."
msgstr ""
"Dat Loosstüern harr Spood, man de Naricht lett sik nich to Enn "
"afarbeiden."

#. +> trunk
#: sendjob.cpp:309
msgid "Failed to store result in item."
msgstr "Resultaat lett sik nich binnen Indrag wohren."

