#: activitypage.cpp:56
msgid "Activities Power Management Configuration"
msgstr "Aktiviteten-Stroomkuntrullsysteem instellen"

#. +> trunk stable
#: activitypage.cpp:57
msgid "A per-activity configurator of KDE Power Management System"
msgstr "En Aktiviteten-Instellprogramm för dat KDE-Stroomkuntrullsysteem"

#. +> trunk stable
#: activitypage.cpp:58
msgid "(c), 2010 Dario Freddi"
msgstr "© 2010 Dario Freddi"

#. +> trunk stable
#: activitypage.cpp:59
msgid "From this module, you can fine tune power management settings for each of your activities."
msgstr "Mit dit Moduul laat sik verwiederte Stroomkuntrullinstellen för elk vun Dien Aktiviteten fastleggen."

#. +> trunk stable
#: activitypage.cpp:61
msgid "Dario Freddi"
msgstr "Dario Freddi"

#. +> trunk stable
#: activitypage.cpp:61
msgid "Maintainer"
msgstr "Pleger"

#. +> trunk stable
#: activitypage.cpp:94
msgid ""
"The activity service is running with bare functionalities.\n"
"Names and icons of the activities might not be available."
msgstr ""
"De Aktivitetendeenst löppt mit Grundfunkschonen.\n"
"Villicht warrt Naams oder Lüttbiller nich wiest."

#. +> trunk stable
#: activitypage.cpp:164
msgid ""
"The activity service is not running.\n"
"It is necessary to have the activity manager running to configure activity-specific power management behavior."
msgstr ""
"De Aktivitetendeenst löppt nich.\n"
"Ahn em laat sik keen aktivitetenbaseert Stroomkuntrull-Instellen fastleggen"

#. +> trunk stable
#: activitypage.cpp:215
msgid ""
"The Power Management Service appears not to be running.\n"
"This can be solved by starting or scheduling it inside \"Startup and Shutdown\""
msgstr ""
"As dat lett löppt dat Stroomkuntrullsysteem nich.\n"
"Dat lett sik över \"An- un Utmaken\" instellen."

