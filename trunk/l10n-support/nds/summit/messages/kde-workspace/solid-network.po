#. +> trunk stable
#: solid-network.cpp:399
msgid "Syntax:"
msgstr "Syntax:"

#. +> trunk stable
#: solid-network.cpp:402
msgid "             # List the network devices present.\n"
msgstr "             # De vörhannen Nettwarkreedschappen oplisten\n"

#. +> trunk stable
#: solid-network.cpp:405
msgid "             # List the networks known to the device specified by 'uni'.\n"
msgstr "             # De Nettwarken oplisten, de bi de vun \"UNI\" angeven Reedschap künnig sünd\n"

#. +> trunk stable
#: solid-network.cpp:408
msgid ""
"             # Query whether networking features are active or not.\n"
"             # - If the 'status' option is given, return whether\n"
"             # networking is enabled for the system\n"
"             # - If the 'wireless' option is given, return whether\n"
"             # wireless is enabled for the system\n"
"             # - If the 'wireless-hardware' option is given,\n"
"             #  return whether the wireless hardware is enabled\n"
"             # - If the 'interface' option is given, print the\n"
"             # properties of the network interface that 'uni' refers to.\n"
"             # - If the 'network' option is given, print the\n"
"             # properties of the network on 'device-uni' that 'network-uni' refers to.\n"
msgstr ""
"             # Nafragen, wat Nettwarkfunkschonen anmaakt sünd\n"
"             # - Mit \"status\": Utgeven, wat de Nettwarkfunkschonen\n"
"             #   op't Systeem anmaakt sünd\n"
"             # - Mit \"wireless\": Utgeven, wat en Funk-Nettwark op't\n"
"             #   Systeem anmaakt is\n"
"             # - Mit \"wireless-hardware\": Utgeven, wat de Funk-Hardware\n"
"             #   op't Systeem anmaakt is\n"
"             # - Mit \"interface\": De Egenschappen vun de vun \"UNI\"\n"
"             #   angeven Nettwark-Reedschap utgeven\n"
"             # - Mit \"network\": De Egenschappen vun't Nettwark\n"
"             #   \"network-uni\" bi de Reedschap \"device-uni\" utgeven\n"

#. +> trunk stable
#: solid-network.cpp:421 solid-network.cpp:424
msgid "             # Enable or disable networking on this system.\n"
msgstr "             # De Nettwarkfunkschonen op't Systeem an- oder utmaken\n"

#. +> trunk stable
#: solid-network.cpp:427
msgid ""
"             # Activate the network 'network-uni' on 'device-uni'.\n"
"             # Optionally, use WEP128, open-system encryption with hex key 'key'. (Hardcoded)\n"
"             # Where 'authentication' is one of:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
msgstr ""
"             # Dat Nettwark \"network-uni\" op Reedschap \"device-uni\" anmaken\n"
"             # Du kannst WEP128 bruken, en Apensysteem-Verslöteln mit den Hexadezimaalslötel \"key\" (fast inbuut).\n"
"             # För \"authentication\" (Identiteetprööv) laat sik disse Weerten bruken:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # \"wpaeap\" is na \"solidshell\" NICH INBUUT\n"

