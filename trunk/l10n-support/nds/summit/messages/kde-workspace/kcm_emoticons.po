msgid "Your names"
msgstr "Sönke Dibbern"

#. +> trunk future stable fustable
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

#. +> trunk future stable fustable
#: emoticonslist.cpp:67
msgid "Insert the string for the emoticon.  If you want multiple strings, separate them by spaces."
msgstr "De Tekenkeed för de Snut ingeven. Mit Freetekens scheden, wenn Du mehr as een Tekenkeed angeven wullt."

#. +> trunk future stable fustable
#: emoticonslist.cpp:108
msgid "Emoticons"
msgstr "Snuten"

#. +> trunk future stable fustable
#: emoticonslist.cpp:255
msgid "Drag or Type Emoticon Theme URL"
msgstr "Snutensett-URL herhen trecken oder ingeven"

#. +> trunk future stable fustable
#: emoticonslist.cpp:260
msgid "Emoticon themes must be installed from local files."
msgstr "Snutensetten laat sikk bloots ut lokaal Dateien installeren."

#. +> trunk future stable fustable
#: emoticonslist.cpp:261
msgid "Could Not Install Emoticon Theme"
msgstr "Snutensett lett sik nich installeren"

#. +> trunk future stable fustable
#: emoticonslist.cpp:279
#, kde-format
msgid "Do you want to remove %1 too?"
msgstr "Wullt Du \"%1\" ok wegmaken?"

#. +> trunk future stable fustable
#: emoticonslist.cpp:279
msgid "Delete emoticon"
msgstr "Snuut wegdoon"

#. +> trunk future stable fustable
#: emoticonslist.cpp:295
msgid "Add Emoticon"
msgstr "Snuut tofögen"

#. +> trunk future stable fustable
#: emoticonslist.cpp:319
msgid "Edit Emoticon"
msgstr "Snuut bewerken"

#. +> trunk future stable fustable
#: emoticonslist.cpp:365 emoticonslist.cpp:388
msgid "New Emoticon Theme"
msgstr "Nieg Snutensett"

#. +> trunk future stable fustable
#: emoticonslist.cpp:365
msgid "Enter the name of the new emoticon theme:"
msgstr "Bitte den Naam vun den niegen Snutensett ingeven:"

#. +> trunk future stable fustable
#: emoticonslist.cpp:371
#, kde-format
msgid "%1 theme already exists"
msgstr "Dat gifft den Sett »%1« al"

#. +> trunk future stable fustable
#: emoticonslist.cpp:388
msgid "Choose the type of emoticon theme to create"
msgstr "Söök bitte den Typ vun den niegen Snutensett ut, den Du opstellen wullt"

#. i18n: ectx: property (windowTitle), widget (QWidget, EmoticonsManager)
#. +> trunk future stable fustable
#: emoticonslist.ui:13
msgid "Emoticons Manager"
msgstr "Snutenpleger"

#. i18n: ectx: property (toolTip), widget (KPushButton, btAdd)
#. +> trunk future stable fustable
#: emoticonslist.ui:44
msgid "Create a new emoticon"
msgstr "En nieg Snuut opstellen"

#. i18n: ectx: property (whatsThis), widget (KPushButton, btAdd)
#. +> trunk future stable fustable
#: emoticonslist.ui:47
msgid "Create a new emoticon by assigning it an icon and some text"
msgstr "Du kannst en nieg Snuut opstellen, wenn Du ehr en Lüttbild un wat Text towiest."

#. i18n: ectx: property (text), widget (KPushButton, btAdd)
#. +> trunk future stable fustable
#: emoticonslist.ui:50
msgid "Add..."
msgstr "Tofögen..."

#. i18n: ectx: property (toolTip), widget (KPushButton, btEdit)
#. +> trunk future stable fustable
#: emoticonslist.ui:57
msgid "Modify the selected emoticon icon or text "
msgstr "Dat utsöchte Snuut-Lüttbild oder sien Text ännern "

#. i18n: ectx: property (whatsThis), widget (KPushButton, btEdit)
#. +> trunk future stable fustable
#: emoticonslist.ui:60
msgid "Edit the selected emoticon to change its icon or its text"
msgstr "Du kannst de utsöchte Snuut bewerken, wenn Du ehr Lüttbild oder Text ännern wullt"

#. i18n: ectx: property (text), widget (KPushButton, btEdit)
#. +> trunk future stable fustable
#: emoticonslist.ui:63
msgid "Edit..."
msgstr "Bewerken..."

#. i18n: ectx: property (toolTip), widget (KPushButton, btRemoveEmoticon)
#. +> trunk future stable fustable
#: emoticonslist.ui:70
msgid "Remove the selected emoticon"
msgstr "De utsöchte Snuut wegdoon"

#. i18n: ectx: property (whatsThis), widget (KPushButton, btRemoveEmoticon)
#. +> trunk future stable fustable
#: emoticonslist.ui:73
msgid "Remove the selected emoticon from your disk"
msgstr "De utsöchte Snuut vun Dien Fastplaat wegmaken"

#. i18n: ectx: property (text), widget (KPushButton, btRemoveEmoticon)
#. +> trunk future stable fustable
#: emoticonslist.ui:76
msgid "Remove"
msgstr "Wegmaken"

#. i18n: ectx: property (text), widget (QCheckBox, cbStrict)
#. +> trunk future stable fustable
#: emoticonslist.ui:100
msgid "Require spaces around emoticons"
msgstr "Freetekens blang Snuten verdwingen"

#. i18n: ectx: property (toolTip), widget (KPushButton, btNew)
#. +> trunk future stable fustable
#: emoticonslist.ui:107
msgid "Design a new emoticon theme"
msgstr "En nieg Snutensett opstellen"

#. i18n: ectx: property (whatsThis), widget (KPushButton, btNew)
#. +> trunk future stable fustable
#: emoticonslist.ui:110
msgid "Start a new theme by assigning it a name. Then use the Add button on the right to add emoticons to this theme."
msgstr "Du fangst en nieg Sett an, wenn Du em en Naam giffst. Achteran kannst Du em mit den Knoop \"Tofögen\" rechterhand Snuten tofögen."

#. i18n: ectx: property (text), widget (KPushButton, btNew)
#. +> trunk future stable fustable
#: emoticonslist.ui:113
msgid "New Theme..."
msgstr "Nieg Sett..."

#. i18n: ectx: property (toolTip), widget (KPushButton, btGetNew)
#. +> trunk future stable fustable
#: emoticonslist.ui:120
msgid "Get new icon themes from the Internet"
msgstr "Nieg Lüttbildsetten ut dat Internet daalladen"

#. i18n: ectx: property (whatsThis), widget (KPushButton, btGetNew)
#. +> trunk future stable fustable
#: emoticonslist.ui:123
msgid "You need to be connected to the Internet to use this action. A dialog will display a list of emoticon themes from the http://www.kde-look.org website. Clicking the Install button associated with a theme will install this theme locally."
msgstr "Du muttst na't Internet tokoppelt wesen, wenn Du disse Funkschoon bruken wullt. En Dialoog wiest en List vun Setten, de dat op http://www.kde-look.org gifft. Klickst Du op en Sett sien Installeren-Knoop, warrt he lokaal installeert."

#. i18n: ectx: property (text), widget (KPushButton, btGetNew)
#. +> trunk future stable fustable
#: emoticonslist.ui:126
msgid "Get New Icon Themes..."
msgstr "Nieg Lüttbildsetten halen..."

#. i18n: ectx: property (toolTip), widget (KPushButton, btInstall)
#. +> trunk future stable fustable
#: emoticonslist.ui:133
msgid "Install a theme archive file you already have locally"
msgstr "En Sett-Archievdatei installeren, de Du al op Dien Reekner hest"

#. i18n: ectx: property (whatsThis), widget (KPushButton, btInstall)
#. +> trunk future stable fustable
#: emoticonslist.ui:136
msgid "If you already have an emoticon theme archive locally, this button will unpack it and make it available for KDE applications"
msgstr "Wenn Du al en Snutensett-Archiev op Dien Reekner hest, kannst Du dat mit dissen Knoop utpacken un för KDE-Programmen verföögbor maken"

#. i18n: ectx: property (text), widget (KPushButton, btInstall)
#. +> trunk future stable fustable
#: emoticonslist.ui:139
msgid "Install Theme File..."
msgstr "Settdatei installeren..."

#. i18n: ectx: property (toolTip), widget (KPushButton, btRemoveTheme)
#. +> trunk future stable fustable
#: emoticonslist.ui:146
msgid "Remove the selected theme from your disk"
msgstr "Den utsöchten Sett vun Dien Fastplaat wegmaken"

#. i18n: ectx: property (whatsThis), widget (KPushButton, btRemoveTheme)
#. +> trunk future stable fustable
#: emoticonslist.ui:149
msgid "This will remove the selected theme from your disk."
msgstr "Disse Akschoon maakt den utsöchten Sett vun Dien Fastplaat weg."

#. i18n: ectx: property (text), widget (KPushButton, btRemoveTheme)
#. +> trunk future stable fustable
#: emoticonslist.ui:152
msgid "Remove Theme"
msgstr "Sett wegdoon"

