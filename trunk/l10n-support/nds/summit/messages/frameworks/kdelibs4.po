#. +> stable
#: kde3support/kdeui/k3spellui.ui:126 kdeui/sonnet/sonnetui.ui:212
msgid ""
"<qt>\n"
"<p>Click here to replace all occurrences of the unknown text with the text in "
"the edit box above (to the left).</p>"
"\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>Klick hier wenn Du wullt, dat för den nich begäng Text jümmers de Text "
"binnen dat Feld baven links insett warrt.</p>"
"\n"
"</qt>"

