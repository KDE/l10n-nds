msgstr "De angeven Orner lett sik nich opstellen, wiel dat al en Orner mit dissen Naam gifft."

#. +> trunk future stable
#: kio/global.cpp:682
msgid "Try moving the current folder out of the way first, and then try again."
msgstr "Versöök, den Orner toeerst to verschuven, un versöök dat denn nochmaal."

#. +> trunk future stable
#: kio/global.cpp:684
msgid "Delete the current folder and try again."
msgstr "Do den Orner weg un versöök dat denn nochmaal."

#. +> trunk future stable
#: kio/global.cpp:685
msgid "Choose an alternate name for the new folder."
msgstr "Söök en anner Naam för den niegen Orner ut."

#. +> trunk future stable
#: kio/global.cpp:689
msgid "Unknown Host"
msgstr "Reekner nich begäng"

#. +> trunk future stable
#: kio/global.cpp:690
#, kde-format
msgid "An unknown host error indicates that the server with the requested name, <strong>%1</strong>, could not be located on the Internet."
msgstr "Disse Fehler bedüüdt, dat dat nich mööglich weer, en Server mit den Naam <strong>%1</strong> in't Internet to finnen."

#. +> trunk future stable
#: kio/global.cpp:693
#, kde-format
msgid "The name that you typed, %1, may not exist: it may be incorrectly typed."
msgstr "Dat gifft dat den angeven Naam (%1) villicht nich, wiel Du Di villicht vertippt hest."

#. +> trunk future stable
#: kio/global.cpp:700
msgid "Access Denied"
msgstr "Togriep torüchwiest"

#. +> trunk future stable
#: kio/global.cpp:701
#, kde-format
msgid "Access was denied to the specified resource, <strong>%1</strong>."
msgstr "Togriep op de angeven Ressource (<strong>%1</strong>) torüchwiest."

#. +> trunk future stable
#: kio/global.cpp:703 kio/global.cpp:919
msgid "You may have supplied incorrect authentication details or none at all."
msgstr "Du hest bi de Identiteetprööv villicht nich richtige oder gor keen Daten angeven"

#. +> trunk future stable
#: kio/global.cpp:705 kio/global.cpp:921
msgid "Your account may not have permission to access the specified resource."
msgstr "Villicht hest Du nich de Verlöven för't Togriepen op de angeven Ressource"

#. +> trunk future stable
#: kio/global.cpp:707 kio/global.cpp:923 kio/global.cpp:935
msgid "Retry the request and ensure your authentication details are entered correctly."
msgstr "Versöök dat nochmaal, un stell seker, dat Dien Angaven för de Identiteetprööv richtig sünd."

