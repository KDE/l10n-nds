#: ../kfile/kfileplaceeditdialog.cpp:115
#, kde-format
msgid ""
"<qt>This is the location associated with the entry. Any valid URL may be used. For example:<br />"
"<br />"
"%1<br />"
"http://www.kde.org<br />"
"ftp://ftp.kde.org/pub/kde/stable<br />"
"<br />"
"By clicking on the button next to the text edit box you can browse to an appropriate URL.</qt>"
msgstr ""
"<qt>Disse Steed warrt den Indrag towiest. Du kannst jichtenseen gellen URL bruken, a.B.:<br />"
"<br />"
"%1<br />"
"http://www.kde.org<br />"
"ftp://ftp.kde.org/pub/kde/stable<br />"
"<br />"
"Wenn Du op denn Knoop rechterhand vun dat Ingaavfeld klickst, kannst Du de Steed utsöken.</qt>"

