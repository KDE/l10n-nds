#. +> trunk stable
#: wordcompletion/docwordcompletion_config.cpp:44
msgid "Automatically &show completion list"
msgstr "Kompletterenlist automaatsch wie&sen"

#. +> trunk stable
#: wordcompletion/docwordcompletion_config.cpp:57
msgctxt "Translators: This is the first part of two strings which will comprise the sentence 'Show completions when a word is at least N characters'. The first part is on the right side of the N, which is represented by a spinbox widget, followed by the second part: 'characters long'. Characters is a integer number between and including 1 and 30. Feel free to leave the second part of the sentence blank if it suits your language better. "
msgid "Show completions &when a word is at least"
msgstr "Kompletteren wiesen, &wenn en Woort tominnst"

#. +> trunk stable
#: wordcompletion/docwordcompletion_config.cpp:65
msgctxt "This is the second part of two strings that will comprise the sentence 'Show completions when a word is at least N characters'"
msgid "characters long."
msgstr "Bookstaven lang is."

#. +> trunk stable
#: wordcompletion/docwordcompletion_config.cpp:68
msgid "Enable the automatic completion list popup as default. The popup can be disabled on a view basis from the 'Tools' menu."
msgstr "Dat automaatsche Opdukfinster för de Kompletterenlist anmaken. De Opduker kann över dat \"Warktüüch\"-Menü utmaakt warrn."

#. +> trunk stable
#: wordcompletion/docwordcompletion_config.cpp:71
msgid "Define the length a word should have before the completion list is displayed."
msgstr "Leggt fast, wo lang en Woort wesen mutt, ehr de Kompletterenlist wiest warrt."

