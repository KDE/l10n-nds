#: services/fileindexer/nepomukfileindexer.notifyrc:38
msgctxt "Comment"
msgid "Indexing of local files for fast searches has started."
msgstr "Dat Indizeren vun lokaal Dateien för gau Söken hett anfungen"

#. +> trunk
#: services/fileindexer/nepomukfileindexer.notifyrc:57
msgctxt "Name"
msgid "Initial Indexing finished"
msgstr "Eerst Indizeren afslaten"

