#. +> trunk
#: ActivityManager.cpp:215
msgid "Unprotect activity"
msgstr "Aktiviteet-Schuul utmaken"

#. +> trunk
#: ActivityManager.cpp:215
msgid ""
"You are cancelling the protection of this activity. Its content will become "
"public again and be accessed without a password."
msgstr ""
"Du maakst de Schuul vun disse Aktiviteet ut. Ehr Inholt warrt wedder apen un "
"Jan un Allemann köönt dor ahn Passwoort op togriepen."

#. +> trunk
#: ActivityManager.cpp:217 ActivityManager.cpp:326 ActivityManager.cpp:501
msgid ""
"Error unlocking the activity.\n"
"You've probably entered a wrong password."
msgstr ""
"Fehler bi't Opsluten vun de Aktiviteet.\n"
"Du hest wull en leeg Passwoort ingeven."

#. +> trunk
#: ActivityManager.cpp:323
msgid "Unlock activity"
msgstr "Aktiviteet opsluten"

#. +> trunk
#: ActivityManager.cpp:323
msgid "Enter the password to unlock the activity"
msgstr "Bitte dat Passwoort för't Opsluten ingeven"

#. +> trunk
#: ActivityManager.cpp:486
msgid "Confirmation"
msgstr "Beglöven"

#. +> trunk
#: ActivityManager.cpp:487
msgid ""
"If you delete a private activity, all the documents and files that belong to "
"it will also be deleted."
msgstr ""
"Deist Du en schuult Aktiviteet weg, warrt ok all Dokmenten un Dateien "
"wegdaan, de dor tohöört."

#. +> trunk
#: ActivityManager.cpp:499
msgid "Delete activity"
msgstr "Aktiviteet wegdoon"

#. +> trunk
#: ActivityManager.cpp:499
msgid "Enter the password to delete this protected activity."
msgstr ""
"Bitte dat Passwoort för't Wegdoon vun disse schuulte Aktiviteet ingeven"

