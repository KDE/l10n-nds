msgid "A parameter in a function cannot be declared to be a tunnel."
msgstr "En Parameter binnen en Funkschoon lett sik nich to en Tunnel verkloren."

#. +> trunk
#: xmlpatterns/parser/qxslttokenizer.cpp:2378
#, qt-format
msgid "This processor is not Schema-aware and therefore %1 cannot be used."
msgstr "Disse Perzessor kennt keen Mustern, dorüm lett sik %1 nich bruken."

#. +> trunk
#: xmlpatterns/parser/qxslttokenizer.cpp:2435
#, qt-format
msgid "Top level stylesheet elements must be in a non-null namespace, which %1 isn't."
msgstr "Stilvörlaag-Elementen in de böverste Evene mööt binnen en Null-Naamruum wesen. \"%1\" is dat nich."

#. +> trunk
#: xmlpatterns/parser/qxslttokenizer.cpp:2483
#, qt-format
msgid "The value for attribute %1 on element %2 must either be %3 or %4, not %5."
msgstr "De Weert vun Attribut %1 in Element %2 mutt %3 oder %4 wesen, nich %5."

#. +> trunk
#: xmlpatterns/parser/qxslttokenizer.cpp:2503
#, qt-format
msgid "Attribute %1 cannot have the value %2."
msgstr "De Weert vun Attribut %1 kann nich %2 wesen."

#. +> trunk
#: xmlpatterns/parser/qxslttokenizer.cpp:2561
#, qt-format
msgid "The attribute %1 can only appear on the first %2 element."
msgstr "Dat Attribut \"%1\" kann bloots in't eerste \"%2\"-Element opduken."

#. +> trunk
#: xmlpatterns/parser/qxslttokenizer.cpp:2660
#, qt-format
msgid "At least one %1 element must appear as child of %2."
msgstr "Tominnst een %1-Element mutt as Ünnerelement vun %2 opduken."

