#. i18n: ectx: property (toolTip), widget (QCheckBox, runInTerminal)
#. +> trunk stable
#: nativeappconfig.ui:191
msgid "<p>By default applications will be run in the background and only their output will be displayed in a toolview. This makes it impossible to interact with applications requiring user input from a terminal emulator. To run such applications, you should use an external terminal.</p>"
msgstr "<p>Standardwies löppt Programmen in'n Achtergrund, un ehr Utgaven warrt bloots as Warktüüchansichten wiest. Dorwegen laat sik ok keen Brukeringaven utföhren. Wullt Du disse Programmen utföhren, bruuk man en extern Konsool ansteed en Konsool-Emulater.</p>"

#. i18n: ectx: property (text), widget (QCheckBox, runInTerminal)
#. +> trunk stable
#: nativeappconfig.ui:194
#, fuzzy
#| msgid "Use External Terminal"
msgid "Use External Terminal:"
msgstr "Extern Konsool bruken"

#. i18n: ectx: property (toolTip), widget (KComboBox, terminal)
#. +> trunk stable
#: nativeappconfig.ui:219
#, no-c-format
msgid ""
"<p>Defines the command to execute the external terminal emulator. Use the following placeholders:</p>"
"\n"
"<dl>\n"
"<dt><code>%exe</code></dt>"
"\n"
"<dd>The path to the executable selected above.</dd>"
"\n"
"<dt><code>%workdir</code></dt>"
"\n"
"<dd>The path to the working directory selected above.</dd>"
"\n"
"</dl>"
"\n"
"<p>The arguments defined above will get appended to this command.</p>"
msgstr ""
"<p>Leggt den Befehl för den Start vun den extern Konsool-Emulater fast. Bruuk disse Platzhollers:</p>"
"\n"
"<dl>\n"
"<dt><code>%exe</code></dt>"
"\n"
"<dd>De Padd na't baven utsöcht utföhrbor Programm.</dd>"
"\n"
"<dt><code>%workdir</code></dt>"
"\n"
"<dd>De Padd na den baven utsöchten Arbeitorner.</dd>"
"\n"
"</dl>"
"\n"
"<p>De baven fastleggt Argumenten warrt dissen Befehl anhangt.</p>"

