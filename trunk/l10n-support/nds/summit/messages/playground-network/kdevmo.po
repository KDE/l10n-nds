#. i18n: ectx: property (toolTip), widget (QLabel, general_refreshTimeLabel)
#. +> trunk
#: prefsdialog.ui:58
msgid "Refresh time (in milliseconds)"
msgstr "Opfrischtiet (in Millisekunnen)"

#. i18n: ectx: property (whatsThis), widget (QLabel, general_refreshTimeLabel)
#. +> trunk
#: prefsdialog.ui:64
msgid ""
"<b>Refresh time</b>\n"
"<p>\n"
"The refresh time determines how often diagrams and stats are updated. You can select one of the proposed values or edit the field manually.\n"
"</p>"
msgstr ""
"<b>Opfrischtiet</b>\n"
"<p>\n"
"De Opfrischtiet leggt fast, wo faken Diagrammen un Statistiken opfrischt warrt. Du kannst een vun de vörslaan Weerten övernehmen, oder dat Feld vun Hand bewerken.\n"
"</p>"

#. i18n: ectx: property (text), widget (QLabel, general_refreshTimeLabel)
#. +> trunk
#: prefsdialog.ui:67
msgid "Refresh time"
msgstr "Opfrischtiet"

#. i18n: ectx: property (toolTip), widget (QLabel, general_smoothFactorLabel)
#. i18n: ectx: property (text), widget (QLabel, general_smoothFactorLabel)
#. +> trunk
#: prefsdialog.ui:83 prefsdialog.ui:92
msgid "Smooth factor"
msgstr "Weekheit-Faktor"

#. i18n: ectx: property (whatsThis), widget (QLabel, general_smoothFactorLabel)
#. +> trunk
#: prefsdialog.ui:89
msgid ""
"<b>Smooth factor</b>\n"
"<p>\n"
"A smooth factor of <b>n</b> means that the last <b>n</b> traffic values are averaged. With a high <b>n</b> the graphs look smoother. You can choose one of the values in the combo box or select a custom value.\n"
"</p>"
msgstr ""
"<b>Weekheit-Faktor</b>\n"
"<p>\n"
"En Weekheit-Faktor vun <b>n</b> bedüüdt, dat de verleden <b>n</b> Verkehrweerten middelt warrt. Mit en höger <b>n</b> lett dat Diagramm weeker. Du kannst en Weert ut dat Utsöökfeld bruken, oder en egen Weert kören.\n"
"</p>"

#. i18n: ectx: property (toolTip), widget (Q3GroupBox, general_colorButtonGroup)
#. i18n: ectx: property (title), widget (Q3GroupBox, general_colorButtonGroup)
#. i18n: ectx: property (toolTip), widget (Q3GroupBox, mainFrame_colorGroupBox)
#. i18n: ectx: property (title), widget (Q3GroupBox, mainFrame_colorGroupBox)
#. +> trunk
#: prefsdialog.ui:134 prefsdialog.ui:143 prefsdialog.ui:611 prefsdialog.ui:620
msgid "Colors"
msgstr "Klören"

#. i18n: ectx: property (whatsThis), widget (Q3GroupBox, general_colorButtonGroup)
#. +> trunk
#: prefsdialog.ui:140
msgid ""
"<b>Colors</b>\n"
"<p>\n"
"Set the colors for incoming and outgoing traffic. This influences both the diagram and the stats views.\n"
"</p>"
msgstr ""
"<b>Klören</b>\n"
"<p>\n"
"De Klören för ankamen ut rutgahn Verkehr fastleggen. Dit gellt för dat Diagramm un för de Statistik.\n"
"</p>"

#. i18n: ectx: property (text), widget (QLabel, general_colors_incomingLabel)
#. +> trunk
#: prefsdialog.ui:168
msgid "Incoming traffic"
msgstr "Ankamen Verkehr"

#. i18n: ectx: property (text), widget (QLabel, general_colors_outgoingLabel)
#. +> trunk
#: prefsdialog.ui:184
msgid "Outgoing traffic"
msgstr "Rutgahn Verkehr"

#. i18n: ectx: property (toolTip), widget (Q3ButtonGroup, general_unitButtonGroup)
#. i18n: ectx: property (title), widget (Q3ButtonGroup, general_unitButtonGroup)
#. +> trunk
#: prefsdialog.ui:214 prefsdialog.ui:223
msgid "Unit"
msgstr "Eenheit"

#. i18n: ectx: property (whatsThis), widget (Q3ButtonGroup, general_unitButtonGroup)
#. +> trunk
#: prefsdialog.ui:220
msgid ""
"<b>Unit</b>\n"
"<p>\n"
"Set whether the stats are shown in bits or bytes per second.\n"
"</p>"
msgstr ""
"<b>Eenheit</b>\n"
"<p>\n"
"Fastleggen, wat de Eenheit för de Statistiken in Bits oder in Bytes per Sekunn angeven warrt.\n"
"</p>"

#. i18n: ectx: property (text), widget (QRadioButton, general_unit_bytesRadioButton)
#. +> trunk
#: prefsdialog.ui:235
msgid "Bytes per second"
msgstr "Bytes per Sekunn"

#. i18n: ectx: property (text), widget (QRadioButton, general_unit_bitsRadioButton)
#. +> trunk
#: prefsdialog.ui:248
msgid "Bits per second"
msgstr "Bits per Sekunn"

#. i18n: ectx: attribute (title), widget (QWidget, diagramTab)
#. +> trunk
#: prefsdialog.ui:263
msgid "Diagram"
msgstr "Diagramm"

#. i18n: ectx: property (toolTip), widget (QLabel, diagram_deviceLabel)
#. +> trunk
#: prefsdialog.ui:301
msgid "Network device"
msgstr "Nettwarkreedschap"

#. i18n: ectx: property (whatsThis), widget (QLabel, diagram_deviceLabel)
#. +> trunk
#: prefsdialog.ui:307
msgid ""
"<b>device</b>\n"
"<p>\n"
"Set the device to be monitored. If the device you look for is not in the list you can edit the field manually.\n"
"</p>"
msgstr ""
"<b>Reedschap</b>\n"
"<p>\n"
"De Reedschap för't Beluern fastleggen. Wenn de List de Reedschap nich bargt, lett sik dat Feld vun Hand bewerken.\n"
"</p>"

#. i18n: ectx: property (text), widget (QLabel, diagram_deviceLabel)
#. +> trunk
#: prefsdialog.ui:310
msgid "Device"
msgstr "Reedschap"

#. i18n: ectx: property (toolTip), widget (Q3ButtonGroup, diagram_graphStyleButtonGroup)
#. +> trunk
#: prefsdialog.ui:326
msgid "Graph style"
msgstr "Diagramm-Stil"

#. i18n: ectx: property (whatsThis), widget (Q3ButtonGroup, diagram_graphStyleButtonGroup)
#. +> trunk
#: prefsdialog.ui:332
msgid ""
"<b>Graph style</b>\n"
"<p>\n"
"Set the graph style. It determines whether the graph is drawn <b>shaded</b>, <b>solid</b> or with <b>lines</b>.\n"
"</p>"
msgstr ""
"<b>Diagramm-Stil</b>\n"
"<p>\n"
"den Diagramm-Stil instellen. Leggt fast, wat dat Diagramm <b>indüüstert</b>, <b>vull</b> oder mit <b>Lienen</b> teekt warrt.\n"
"</p>"

#. i18n: ectx: property (title), widget (Q3ButtonGroup, diagram_graphStyleButtonGroup)
#. +> trunk
#: prefsdialog.ui:335
msgid "Graph Style"
msgstr "Diagramm-Stil"

#. i18n: ectx: property (text), widget (QRadioButton, diagram_graphStyle_shadedRadioButton)
#. +> trunk
#: prefsdialog.ui:347
msgid "Shaded"
msgstr "Indüstert"

#. i18n: ectx: property (text), widget (QRadioButton, diagram_graphStyle_solidRadioButton)
#. +> trunk
#: prefsdialog.ui:360
msgid "Solid"
msgstr "Vull"

#. i18n: ectx: property (text), widget (QRadioButton, diagram_graphStyle_linesRadioButton)
#. +> trunk
#: prefsdialog.ui:373
msgid "Lines"
msgstr "Lienen"

#. i18n: ectx: property (toolTip), widget (Q3ButtonGroup, diagram_scalingModeButtonGroup)
#. +> trunk
#: prefsdialog.ui:387
msgid "Scaling mode (determines how small traffic rates are drawn)"
msgstr "Topassmetood (leggt fast, wodennig lütte Överdregenraten wiest warrt)"

#. i18n: ectx: property (whatsThis), widget (Q3ButtonGroup, diagram_scalingModeButtonGroup)
#. +> trunk
#: prefsdialog.ui:394
msgid ""
"<b>Scaling mode</b>\n"
"<p>\n"
"<b>Cubic root</b> means that the diagrams are drawn with the cubic root of each traffic value. The result is that small values are shown higher than they are.\n"
"<b>Normal</b> means just what it says.\n"
"</p>"
msgstr ""
"<b>Topassmetood</b>\n"
"<p>\n"
"<b>Kubikwörtel</b> bedüüdt, dat de Diagrammen mit elk Weert sien Kubikwörtel wiest warrt. So warrt lütter Weerten grötter dorstellt, as se sünd.\n"
"<b>Normaal</b> bedüüdt \"normaal\" Dorstellen.\n"
"</p>"

#. i18n: ectx: property (title), widget (Q3ButtonGroup, diagram_scalingModeButtonGroup)
#. +> trunk
#: prefsdialog.ui:397
msgid "Scaling mode"
msgstr "Topassmetood"

#. i18n: ectx: property (text), widget (QRadioButton, diagram_scalingMode_normalRadioButton)
#. +> trunk
#: prefsdialog.ui:409
msgid "Normal"
msgstr "Normaal"

#. i18n: ectx: property (text), widget (QRadioButton, diagram_scalingMode_cbrtRadioButton)
#. +> trunk
#: prefsdialog.ui:422
msgid "Cubic root"
msgstr "Kubikwörtel"

#. i18n: ectx: property (toolTip), widget (Q3ButtonGroup, diagram_graphPositionButtonGroup)
#. i18n: ectx: property (title), widget (Q3ButtonGroup, diagram_graphPositionButtonGroup)
#. +> trunk
#: prefsdialog.ui:436 prefsdialog.ui:446
msgid "Graph position"
msgstr "Diagrammpositschoon"

#. i18n: ectx: property (whatsThis), widget (Q3ButtonGroup, diagram_graphPositionButtonGroup)
#. +> trunk
#: prefsdialog.ui:443
msgid ""
"<b>Graph position</b>\n"
"<p>\n"
"<b>Top and bottom</b> means that the output graph is drawn on the top of the frame and the output graph on the bottom.<br>"
"\n"
"With <b>Only bottom</b> the input graph is drawn on the bottom of the frame and the output graph on top of the input graph.\n"
"</p>"
msgstr ""
"<b>Diagrammpositschoon</b>\n"
"<p>\n"
"<b>Baven un nerrn</b> bedüüdt, dat dat Utgang-Diagramm binnen dat Hööftfinster baven un dat Ingang-Diagramm nerrn wiest warrt.<br>"
"\n"
"Mit <b>Bloots nerrn</b> warrt dat Ingang-Diagramm binnen dat Finster nerrn dorstellt, un dat Utgang-Diagramm böver em.\n"
"</p>"

#. i18n: ectx: property (text), widget (QRadioButton, diagram_graphPosition_topBottomRadioButton)
#. +> trunk
#: prefsdialog.ui:458
msgid "Top and bottom"
msgstr "Baven un nerrn"

#. i18n: ectx: property (text), widget (QRadioButton, diagram_graphPosition_bottomRadioButton)
#. +> trunk
#: prefsdialog.ui:471
msgid "Only bottom"
msgstr "Bloots nerrn"

#. i18n: ectx: property (toolTip), widget (QLabel, diagram_scalingLabel)
#. +> trunk
#: prefsdialog.ui:485
msgid "Scale factor (bits per second)"
msgstr "Topassfaktor (Bits per Sekunn)"

#. i18n: ectx: property (whatsThis), widget (QLabel, diagram_scalingLabel)
#. +> trunk
#: prefsdialog.ui:491
msgid ""
"<b>Scaling</b>\n"
"<p>\n"
"Set the scaling of the diagrams (bits per second). It is a good idea to select the maximum throughput rate of your device. If none of the entries fits edit the field manually.\n"
"</p>"
msgstr ""
"<b>Topassen</b>\n"
"<p>\n"
"De Dorstellen-Grött (Bits per Sekunn) för Diagrammen fastleggen. De Reedschap ehr Maximaal-Dörsatz is en goot Weert. Wenn keen Indrag passt, giff vun Hand en Weert in.\n"
"</p>"

#. i18n: ectx: property (text), widget (QLabel, diagram_scalingLabel)
#. +> trunk
#: prefsdialog.ui:494
msgid "Scaling (bits per second)"
msgstr "Topassen (Bits per Sekunn)"

#. i18n: ectx: property (toolTip), widget (QCheckBox, diagram_showGridCheckBox)
#. i18n: ectx: property (text), widget (QCheckBox, diagram_showGridCheckBox)
#. +> trunk
#: prefsdialog.ui:510 prefsdialog.ui:519
msgid "Show grid"
msgstr "Gadder wiesen"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, diagram_showGridCheckBox)
#. +> trunk
#: prefsdialog.ui:516
msgid ""
"<b>Show grid</b>\n"
"<p>\n"
"Decide whether the diagram in the main frame should show a grid or not.\n"
"</p>"
msgstr ""
"<b>Gadder wiesen</b>\n"
"<p>\n"
"Fastleggen, wat dat Diagramm binnen dat Hööftfinster mit Gadder wiest warrt.\n"
"</p>"

#. i18n: ectx: attribute (title), widget (QWidget, mainFrameTab)
#. +> trunk
#: prefsdialog.ui:533
msgid "Main frame"
msgstr "Hööftfinster"

#. i18n: ectx: property (toolTip), widget (QCheckBox, mainFrame_transparentCheckBox)
#. +> trunk
#: prefsdialog.ui:545
msgid "Toggle transparency"
msgstr "Dörschienen an-/utmaken"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, mainFrame_transparentCheckBox)
#. +> trunk
#: prefsdialog.ui:551
msgid ""
"<b>Transparent</b>\n"
"<p>\n"
"Toggle pseudo transparency for the main frame.\n"
"</p>"
msgstr ""
"<b>Dörsichtig</b>\n"
"<p>\n"
"Dörschienen för't Hööftfinster an-/utmaken.\n"
"</p>"

#. i18n: ectx: property (text), widget (QCheckBox, mainFrame_transparentCheckBox)
#. +> trunk
#: prefsdialog.ui:554
msgid "Transparent"
msgstr "Dörsichtig"

#. i18n: ectx: property (toolTip), widget (QCheckBox, mainFrame_showDecorationsCheckBox)
#. i18n: ectx: property (text), widget (QCheckBox, mainFrame_showDecorationsCheckBox)
#. +> trunk
#: prefsdialog.ui:567 prefsdialog.ui:576
msgid "Show decorations"
msgstr "Dekoratschonen wiesen"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, mainFrame_showDecorationsCheckBox)
#. +> trunk
#: prefsdialog.ui:573
msgid ""
"<b>Show decorations</b>\n"
"<p>\n"
"If this checkbox is not selected the main frame has no window decorations like titlebar and borders.\n"
"</p>"
msgstr ""
"<b>Dekoratschonen wiesen</b>\n"
"<p>\n"
"Wenn dit utmaakt is, bargt dat Hööftfinster keen Dekoratschonen, as a.B. Titelbalken un Ränners.\n"
"</p>"

#. i18n: ectx: property (toolTip), widget (QCheckBox, mainFrame_showStatsBarCheckBox)
#. i18n: ectx: property (text), widget (QCheckBox, mainFrame_showStatsBarCheckBox)
#. +> trunk
#: prefsdialog.ui:589 prefsdialog.ui:598
msgid "Show stats bar"
msgstr "Statistikbalken wiesen"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, mainFrame_showStatsBarCheckBox)
#. +> trunk
#: prefsdialog.ui:595
msgid ""
"<b>Show stats bar</b>\n"
"<p>\n"
"Choose whether the small bar that shows the current traffic rate should be shown.\n"
"</p>"
msgstr ""
"<b>Statistikbalken wiesen</b>\n"
"<p>\n"
"Fastleggen, wat de lütte Balken för de aktuelle Överdregen-Raat wiest warrt.\n"
"</p>"

#. i18n: ectx: property (whatsThis), widget (Q3GroupBox, mainFrame_colorGroupBox)
#. +> trunk
#: prefsdialog.ui:617
msgid ""
"<b>Colors</b>\n"
"<p>\n"
"Set the colors for background and grid. \n"
"</p>"
msgstr ""
"<b>Klören</b>\n"
"<p>\n"
"Achtergrund- un Gadderklören fastleggen. \n"
"</p>"

#. i18n: ectx: property (text), widget (QLabel, mainFrame_bgColorLabel)
#. i18n: ectx: property (text), widget (QLabel, dockFrame_bgColorLabel)
#. i18n: ectx: property (text), widget (QLabel, statsFrame_bgColorLabel)
#. +> trunk
#: prefsdialog.ui:658 prefsdialog.ui:737 prefsdialog.ui:867
msgid "Background color"
msgstr "Achtergrundklöör"

#. i18n: ectx: property (text), widget (QLabel, mainFrame_gridColorLabel)
#. i18n: ectx: property (text), widget (QLabel, dockFrame_gridColorLabel)
#. +> trunk
#: prefsdialog.ui:674 prefsdialog.ui:754
msgid "Grid color"
msgstr "Gadderklöör"

#. i18n: ectx: property (toolTip), widget (QCheckBox, mainFrame_showTooltipsCheckBox)
#. i18n: ectx: property (text), widget (QCheckBox, mainFrame_showTooltipsCheckBox)
#. +> trunk
#: prefsdialog.ui:691 prefsdialog.ui:700
msgid "Show tooltips"
msgstr "Kortinformatschonen wiesen"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, mainFrame_showTooltipsCheckBox)
#. +> trunk
#: prefsdialog.ui:697
msgid ""
"<b>Show tooltips</b>\n"
"<p>\n"
"If this checkbox is enabled a tooltip is shown when you hold the mouse cursor on the main Frame. The tooltip shows the throughput rate of the device during a particular time.\n"
"</p>"
msgstr ""
"<b>Kortinformatschonen wiesen</b>\n"
"<p>\n"
"Wenn dit anmaakt is, warrt bi't Anrögen vun den Hööftbalken mit de Muus en Kortinformatschoon wiest, de de Reedschap ehr Dörsatz wielt en angeven Tiet wiest.\n"
"</p>"

#. i18n: ectx: attribute (title), widget (QWidget, otherFramesTab)
#. +> trunk
#: prefsdialog.ui:714
msgid "Other frames"
msgstr "Anner Finstern"

#. i18n: ectx: property (toolTip), widget (Q3GroupBox, dockFrameGroupBox)
#. +> trunk
#: prefsdialog.ui:722
msgid "dock frame"
msgstr "Andockfinster"

#. i18n: ectx: property (whatsThis), widget (Q3GroupBox, dockFrameGroupBox)
#. +> trunk
#: prefsdialog.ui:728
msgid ""
"<b>Dock frame</b>\n"
"<p>\n"
"Select the background color and the grid color of the diagram in the dock frame.\n"
"</p>"
msgstr ""
"<b>Andockfinster</b>\n"
"<p>\n"
"Achtergrund- un Gadderklöör för't Diagramm binnen dat Andockfinster fastleggen.\n"
"</p>"

#. i18n: ectx: property (title), widget (Q3GroupBox, dockFrameGroupBox)
#. +> trunk
#: prefsdialog.ui:731
msgid "Dock frame"
msgstr "Andockfinster"

#. i18n: ectx: property (toolTip), widget (QCheckBox, dockFrame_showTextCheckBox)
#. i18n: ectx: property (text), widget (QCheckBox, dockFrame_showTextCheckBox)
#. +> trunk
#: prefsdialog.ui:771 prefsdialog.ui:780
msgid "Show text instead of diagram"
msgstr "Text ansteed vun Diagramm wiesen"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, dockFrame_showTextCheckBox)
#. +> trunk
#: prefsdialog.ui:777
msgid ""
"<b>Show grid instead of diagram</b>\n"
"<p>\n"
"If this box is checked the dock frame shows the current traffic value instead of a diagram.\n"
"</p>"
msgstr ""
"<b>Text ansteed vun Diagramm wiesen</b>\n"
"<p>\n"
"Wenn anmaakt, wiest dat Andockfinster den aktuellen Öveerdregen-Weert ansteed vun en Diagramm.\n"
"</p>"

#. i18n: ectx: property (text), widget (QLabel, label)
#. +> trunk
#: prefsdialog.ui:805
msgid "Text size"
msgstr "Textgrött"

#. i18n: ectx: property (toolTip), widget (Q3GroupBox, statsFrameGroupBox)
#. i18n: ectx: property (title), widget (Q3GroupBox, statsFrameGroupBox)
#. +> trunk
#: prefsdialog.ui:846 prefsdialog.ui:855
msgid "Stats frame"
msgstr "Statistikfinster"

#. i18n: ectx: property (whatsThis), widget (Q3GroupBox, statsFrameGroupBox)
#. +> trunk
#: prefsdialog.ui:852
msgid ""
"<b>Stats frame</b>\n"
"<p>\n"
"Set the background and the foreground color of the stats frame. The stats frame is the small window that shows some stats and popups when you middle-click on the dock or the main frame.\n"
"</p>"
msgstr ""
"<b>Statistikfinster</b>\n"
"<p>\n"
"Achter- un Vörgundklöör för dat Statistikfinster fastleggen. Dat Statistikfinster is dat lütte Finster, dat na en Middelklick op dat Andock- oder Hööftfinster en poor Statistiken un Opdukfinstern praatstellt.\n"
"</p>"

