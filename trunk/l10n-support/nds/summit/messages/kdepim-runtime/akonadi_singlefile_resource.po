msgstr "Datei \"%1\" lett sik nich laden."

#. +> trunk
#: singlefileresourcebase.cpp:266
#, kde-format
msgid "Could not save file '%1'."
msgstr "Datei \"%1\" lett sik nich sekern."

#. i18n: ectx: attribute (title), widget (QWidget, SingleFileResourceConfigWidget)
#. +> trunk
#: singlefileresourceconfigdialogbase.cpp:37
#: singlefileresourceconfigwidget_desktop.ui:12
msgid "File"
msgstr "Datei"

#. +> trunk
#: singlefileresourceconfigwidget.cpp:115
msgctxt "@info:status"
msgid "Checking file information..."
msgstr "Datei-Informatschonen warrt pröövt..."

#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:18
msgid "Access Rights"
msgstr "Togriepverlöven"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:24
#: singlefileresourceconfigwidget_mobile.ui:51
msgid "Read only"
msgstr "Bloots leesbor"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:31
msgid "If read-only mode is enabled, no changes will be written to the file selected above. Read-only mode will be automatically enabled if you do not have write access to the file or the file is on a remote server that does not support write access."
msgstr "Is de Bloots-leesbor-Bedrief anmaakt, warrt keen Ännern na de baven utsöchte Datei schreven. Hest Du keen Schriefverlöven för de Datei oder liggt se op en Server, na den Du nich schrieven muttst, warrt de Bloots-leesbor-Bedrief automaatsch anmaakt."

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_MonitorFile)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:44
msgid "Monitoring"
msgstr "Beluern"

#. i18n: ectx: property (text), widget (QLabel, label_5)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:50
msgid "If file monitoring is enabled the resource will reload the file when changes are made by other programs. It also tries to create a backup in case of conflicts whenever possible."
msgstr "Is Dateibeluern anmaakt, laadt de Ressource de Datei na Ännern dör anner Programmen nieg. Wenn mööglich, warrt bi Konflikten ok en Sekerheitkopie opstellt."

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_MonitorFile)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:60
#: singlefileresourceconfigwidget_mobile.ui:58
msgid "Enable file &monitoring"
msgstr "Datei&beluern anmaken"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:70
msgid "Filename"
msgstr "Dateinaam"

#. i18n: ectx: property (text), widget (QLabel, label)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:78
#: singlefileresourceconfigwidget_mobile.ui:19
msgid "&Filename:"
msgstr "&Dateinaam:"

#. i18n: ectx: property (text), widget (QLabel, statusLabel)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:93
msgid "Status:"
msgstr "Status:"

#. i18n: ectx: property (text), widget (QLabel, label_3)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:100
msgid "Select the file whose contents should be represented by this resource. If the file does not exist, it will be created. A URL of a remote file can also be specified, but note that monitoring for file changes will not work in this case."
msgstr "De Datei utsöken, de ehr Inholt disse Ressource praatstellen schall. Gifft dat de Datei nich, warrt se opstellt. Du kannst ok en URL vun en Datei op en anner Reekner angeven, man denn funkscheneert dat beluern op Ännern nich."

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:113
msgid "Display Name"
msgstr "Wiesnaam"

#. i18n: ectx: property (text), widget (QLabel, label_1)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:121
msgid "&Name:"
msgstr "&Naam:"

#. i18n: ectx: property (text), widget (QLabel, label_4)
#. +> trunk
#: singlefileresourceconfigwidget_desktop.ui:136
msgid "Enter the name used to identify this resource in displays. If not specified, the filename will be used."
msgstr "Giff den Wiesnaam för disse Ressource in. Lettst Du dit leddig, warrt de Dateinaam bruukt."

#. i18n: ectx: property (text), widget (QLabel, label_2)
#. +> trunk
#: singlefileresourceconfigwidget_mobile.ui:36
msgid "&Display name:"
msgstr "&Wiesnaam:"

#~ msgid "Tuning"
#~ msgstr "Fieninstellen"

#~ msgid "The options on this page allow you to change parameters that balance data safety and consistency against performance. In general you should be careful with changing anything here, the defaults are good enough in most cases."
#~ msgstr "Mit de Optschonen op disse Siet kannst Du de Balangs twischen Datensekerheit un -konsistenz op de een un de Leisten op de anner Siet topassen. Wees man vörsichtig mit de Instellen op disse Siet, de Vörinstellen passt tomehrst."

#~ msgid "Autosave delay:"
#~ msgstr "Töövtiet för't automaatsche Sekern:"

#~ msgid "min"
#~ msgstr "Min"
