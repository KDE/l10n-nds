msgstr "An't Töven, dat de Nepomuk-Server starten deit..."

#. +> trunk stable
#: nepomukfeederagent.cpp:234
msgid "Nepomuk is not running."
msgstr "Nepomuk löppt nich."

#. +> trunk stable
#: nepomukfeederagent.cpp:259
#, kde-format
msgid "Nepomuk is not operational: %1"
msgstr "Nepomuk funkscheneert nich: %1"

#. +> trunk stable
#: nepomukfeederagent.cpp:304
msgid "Indexing recent changes..."
msgstr "Verleden Ännern warrt indizeert…"

#. +> trunk stable
#: nepomukfeederagent.cpp:313
msgid "System idle, ready to index data."
msgstr "Keen Systemaktiviteet. - Praat för de Dateidörkiek."

