msgstr "De Nepomuk-Wohrdeenst lett sik nich opropen: '%1'."

#. +> trunk stable
#: nepomukfeederagentbase.cpp:370
msgid "Nepomuk is not running."
msgstr "Nepomuk löppt nich."

#. +> trunk stable
#: nepomukfeederagentbase.cpp:377
msgid "Nepomuk backend for Strigi is not available."
msgstr "Nepomuk-Hülpprogramm för Strigi nich verföögbor."

#. +> trunk stable
#: nepomukfeederagentbase.cpp:389
msgid "Ready to index data."
msgstr "Praat för de Dateidörkiek"

#. +> trunk stable
#: nepomukfeederagentbase.cpp:396
#, kde-format
msgid ""
"<b>Nepomuk Indexing Agents Have Been Disabled</b><br/>"
"The Nepomuk service is not available or fully operational and attempts to rectify this have failed. Therefore indexing of all data stored in the Akonadi PIM service has been disabled, which will severely limit the capabilities of any application using this data.<br/>"
"<br/>"
"The following problems were detected:"
"<ul>"
"<li>%1</li>"
"</ul>"
"Additional help can be found here: <a href=\"http://userbase.kde.org/Akonadi\">userbase.kde.org/Akonadi</a>"
msgstr ""
"<b>De Nepomuk-Datendörkiek wöör utmaakt</b><br/>"
"De Nepomuk-Deenst is nich verföögbor oder löppt nich propper, un dat Richten vun dissen Fehler is fehlslaan. Dorwegen wöör de Dörkiek vun all binnen den PIM-Deenst vun Akonadi sekert Daten utmaakt. Dat minnert man bannig de Leisten vun Programmen, de op disse Daten togriepen wullt.<br/>"
"<br/>"
"Disse Problemen wöörn opdeckt:"
"<ul>"
"<li>%1</li>"
"</ul>"
"Hier gifft dat mehr Hülp: <a href=\"http://userbase.kde.org/Akonadi\">userbase.kde.org/Akonadi</a>"

#. +> trunk stable
#: nepomukfeederagentbase.cpp:405
msgid "Nepomuk not operational"
msgstr "Nepomuk funkscheneert nich."

#. +> trunk stable
#: nepomukfeederagentbase.cpp:408
msgid "Nepomuk Indexing Disabled"
msgstr "Nepomuk-Indizeren utmaakt"

#. +> trunk stable
#: nepomukfeederagentbase.cpp:468
msgid "Strigi is not available for indexing."
msgstr "Strigi för't Indizeren nich verföögbor."

#. +> trunk
#: nepomukfeederagentbase.cpp:528
msgid "System idle, ready to index data."
msgstr "Keen Systemaktiviteet. - Praat för de Dateidörkiek."

#. +> trunk
#: nepomukfeederagentbase.cpp:539
msgid "System busy, indexing suspended."
msgstr "System is utlast, de Dateidörkiek wöör anhollen."
