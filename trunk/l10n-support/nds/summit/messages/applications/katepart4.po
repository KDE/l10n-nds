#. i18n: ectx: property (whatsThis), widget (QCheckBox, chkShowFoldingMarkers)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:23
msgid "If this option is checked, every new view will display marks for code folding, if code folding is available."
msgstr "Wenn anmaakt, warrt nieg Ansichten linkerhand Marken för dat Infoolden vun Textafsnitten wiesen, wenn dat mööglich is."

#. i18n: ectx: property (text), widget (QCheckBox, chkShowFoldingMarkers)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:26
msgid "Show &folding markers (if available)"
msgstr "&Fooldmarken wiesen (wenn mööglich)"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, chkIconBorder)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:33
msgid ""
"<p>If this option is checked, every new view will display an icon border on the left hand side.</p>"
"<p>The icon border shows bookmark signs, for instance.</p>"
msgstr ""
"<p>Wenn anmaakt, warrt bi nieg Ansichten linkerhand en Rand för Lüttbiller wiest.</p>"
"<p>De Lüttbildrand wiest a.B. Leestekens.</p>"

#. i18n: ectx: property (text), widget (QCheckBox, chkIconBorder)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:36
msgid "Show &icon border"
msgstr "Rand för &Lüttbiller wiesen"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, chkLineNumbers)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:43
msgid "If this option is checked, every new view will display line numbers on the left hand side."
msgstr "Wenn anmaakt, warrt bi nieg Ansichten linkerhand de Reegnummern wiest."

#. i18n: ectx: property (text), widget (QCheckBox, chkLineNumbers)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:46
msgid "Show &line numbers"
msgstr "Reeg&nummern wiesen"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, chkShowLineModification)
#. +> trunk
#: dialogs/bordersappearanceconfigwidget.ui:53
#, fuzzy
#| msgid "If this option is checked, every new view will display line numbers on the left hand side."
msgid "If this option is checked, a small indicator for modified and saved lines is shown on the left hand side."
msgstr "Wenn anmaakt, warrt bi nieg Ansichten linkerhand de Reegnummern wiest."

#. i18n: ectx: property (text), widget (QCheckBox, chkShowLineModification)
#. +> trunk
#: dialogs/bordersappearanceconfigwidget.ui:56
#, fuzzy
#| msgid "Show Folding &Markers"
msgid "Show line modification markers"
msgstr "Foold&marken wiesen"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, chkScrollbarMarks)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:63
msgid ""
"<p>If this option is checked, every new view will show marks on the vertical scrollbar.</p>"
"<p>These marks will show bookmarks, for instance.</p>"
msgstr ""
"<p>Wenn anmaakt, wiest nieg Ansichten Marken op den pielrechten Rullbalken.</p>"
"<p>Disse Marken wiest a.B. de Leestekens.</p>"

#. i18n: ectx: property (text), widget (QCheckBox, chkScrollbarMarks)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:66
msgid "Show &scrollbar marks"
msgstr "Marken op den &Rullbalken wiesen"

#. i18n: ectx: property (whatsThis), widget (QGroupBox, gbSortBookmarks)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:76
msgid "Choose how the bookmarks should be ordered in the <b>Bookmarks</b> menu."
msgstr "Legg fast, wodennig de Leestekens in't <b>Leestekenmenü</b> wiest warrt."

#. i18n: ectx: property (title), widget (QGroupBox, gbSortBookmarks)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:79
msgid "Sort Bookmarks Menu"
msgstr "Leestekenmenü sorteren"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, rbSortBookmarksByCreation)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:85
msgid "Each new bookmark will be added to the bottom, independently from where it is placed in the document."
msgstr "Nieg Leestekens warrt nerrn toföögt, ehr Positschoon in't Dokment speelt keen Rull."

#. i18n: ectx: property (text), widget (QRadioButton, rbSortBookmarksByCreation)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:88
msgid "By c&reation"
msgstr "Na &Opstellen"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, rbSortBookmarksByPosition)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:95
msgid "The bookmarks will be ordered by the line numbers they are placed at."
msgstr "De Leestekens warrt na de Nummer vun de Reeg sorteert, woneem se staht."

#. i18n: ectx: property (text), widget (QRadioButton, rbSortBookmarksByPosition)
#. +> trunk stable
#: dialogs/bordersappearanceconfigwidget.ui:98
msgid "By &position"
msgstr "Na &Positschoon"

