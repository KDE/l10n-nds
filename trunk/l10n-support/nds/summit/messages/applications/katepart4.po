msgstr "Text-Utsöökmetood"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, rbNormal)
#. +> trunk stable
#: dialogs/cursorconfigwidget.ui:97
msgid "Selections will be overwritten by typed text and will be lost on cursor movement."
msgstr "Kören warrt vun ingeven Text överschreven un bi Blinkerbewegen opheevt."

