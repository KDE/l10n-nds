#: kplayerpropertiessize.ui:485
msgid "Mai&ntain aspect"
msgstr "&Proportschoon wohren"

#. i18n: ectx: property (toolTip), widget (QLabel, l_maintain_aspect)
#. i18n: ectx: property (toolTip), widget (QComboBox, c_maintain_aspect)
#. +> trunk
#: kplayerpropertiessize.ui:494 kplayerpropertiessize.ui:507
msgid "Maintain video aspect when resizing window"
msgstr "Videoproportschoon bi't Ännern vun de Finstergrött wohren"

#. i18n: ectx: property (whatsThis), widget (QLabel, l_maintain_aspect)
#. i18n: ectx: property (whatsThis), widget (QComboBox, c_maintain_aspect)
#. +> trunk
#: kplayerpropertiessize.ui:497 kplayerpropertiessize.ui:510
msgid "Option to maintain video aspect when resizing KPlayer window. Default leaves the maintain aspect option unchanged for this file. It is easier to set this property by clicking Maintain Aspect button on the main KPlayer toolbar while holding Shift key down."
msgstr "Mit disse Optschoon kannst Du fastleggen, wat de Proportschoon vun't Videobild bi't Topassen vun KPlayer sien Finstergrött wohrt warrt. Dat Fastleggen vun disse Optschoon geiht lichter, wenn Du op den Knoop \"Proportschoon wohren\" op KPlayer sien Hööft-Warktüüchbalken klickst un dor de Ümschalttast bi daalhöllst."

