#. +> trunk
#: kplayersettingsvideo.ui:264
msgid "Enable do&uble buffering"
msgstr "D&ubbelpuffern anmaken"

#. i18n: ectx: property (toolTip), widget (QCheckBox, c_direct_rendering)
#. +> trunk
#: kplayersettingsvideo.ui:271
msgid "Enable direct rendering for video output"
msgstr "Direktdorstellen för de Bildweddergaav anmaken"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_direct_rendering)
#. +> trunk
#: kplayersettingsvideo.ui:274
msgid "Option to choose whether direct rendering should be used for video output. This option may give performance improvement, but may also cause video display problems, for example when used along with double buffering option or when playing with subtitles."
msgstr "Mit disse Instellen lett sik Direktdorstellen för de Bildweddergaav anmaken. Dat kann en Leistenverbetern bringen, man ok to Problemen mit de Bilddorstellen föhren, a.B. tosamen mit de Optschoon \"Dubbelpuffer\" oder mit Ünnertiteln."

#. i18n: ectx: property (text), widget (QCheckBox, c_direct_rendering)
#. +> trunk
#: kplayersettingsvideo.ui:277
msgid "Enable direc&t rendering"
msgstr "Direk&tdorstellen anmaken"

