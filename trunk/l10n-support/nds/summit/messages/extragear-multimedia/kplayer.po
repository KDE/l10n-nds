msgstr "Norweegsch"

#. +> trunk
#: kplayeractionlist.cpp:439
msgid "&None"
msgstr "&Keen"

#. +> trunk
#: kplayeractionlist.cpp:440
msgid "Turns off subtitle display"
msgstr "Maakt dat Wiesen vun Ünnertiteln ut"

#. +> trunk
#: kplayeractionlist.cpp:441
msgid "Subtitles None command turns off subtitle display."
msgstr "De Ünnertitelbefehl \"Keen\" maakt de Ünnertiteln ut."

#. +> trunk
#: kplayerengine.cpp:489
msgid "&Properties..."
msgstr "&Egenschappen..."

#. +> trunk
#: kplayerengine.cpp:492
msgid "Opens the File Properties dialog"
msgstr "Maakt den Dateiegenschappen-Dialoog op"

#. +> trunk
#: kplayerengine.cpp:493
msgid "Properties command opens the File Properties dialog that lets you choose many options specific to the currently loaded file. See the File properties micro-HOWTO for details."
msgstr "De Befehl \"Egenschappen\" maakt den Dialoog \"Datei-Egenschappen\" op. Dor binnen kannst Du en Reeg Optschonen för de opstunns laadte Datei fastleggen. Kiek binnen de \"Kortanleden Dateiegenschappen\", wenn Du mehr weten wullt."

#. +> trunk
#: kplayerengine.cpp:498 kplayernodeview.cpp:3286
msgid "&Play"
msgstr "&Afspelen"

#. +> trunk
#: kplayerengine.cpp:501
msgid "Plays the currently loaded file"
msgstr "Speelt de aktuell laadt Datei af"

#. +> trunk
#: kplayerengine.cpp:502
msgid "Play command starts playback of the current file. If the player has been paused, this command resumes playback. This command is available when a file is loaded."
msgstr "De Befehl \"Afspelen\" start dat Afspelen vun de aktuelle Datei. Wöör de Afspeler anhollen, geiht dat Afspelen wieder. De Befehl is verföögbor, wenn dor opstunns en Datei laadt is."

#. +> trunk
#: kplayerengine.cpp:507
msgid "Paus&e"
msgstr "&Paus"

#. +> trunk
#: kplayerengine.cpp:510
msgid "Pauses the player"
msgstr "Afspelen ünnerbreken"

#. +> trunk
#: kplayerengine.cpp:511
msgid "Pause command pauses or resumes playback of the current file. This command is available when the player is not idle."
msgstr "De Befehl \"Paus\" höllt dat Afspelen an oder maakt dor mit wieder. Disse Befehl is verföögbor, wenn de Afspeler wat speelt."

#. +> trunk
#: kplayerengine.cpp:516
msgid "&Stop"
msgstr "&Ophollen"

#. +> trunk
#: kplayerengine.cpp:519
msgid "Stops the player"
msgstr "Afspelen ophollen"

#. +> trunk
#: kplayerengine.cpp:520
msgid "Stop command stops playback of the current file. This command is available when the player is not idle."
msgstr "De Befehl \"Ophollen\" höört mit dat Afspelen vun de aktuelle Datei op. Disse Befehl is verföögbor, wenn de Afspeler wat speelt."

#. +> trunk
#: kplayerengine.cpp:525 kplayernodeview.cpp:3403
msgid "&Forward"
msgstr "&Vörut"

#. +> trunk
#: kplayerengine.cpp:527
msgid "Moves playback forward"
msgstr "Jumpt bi't Afspelen vörut"

#. +> trunk
#: kplayerengine.cpp:528
msgid "Forward command moves playback forward by one percent of the time length of the current file. This command is available when playing a file."
msgstr "De Befehl \"Vörut\" jumpt bi't Afspelen en Perzent vun dat Stück sien Längde vörut. Disse Befehl is verföögbor, wenn en Datei afspeelt warrt."

#. +> trunk
#: kplayerengine.cpp:533
msgid "F&ast Forward"
msgstr "G&au vörut"

#. +> trunk
#: kplayerengine.cpp:536
msgid "Moves playback forward fast"
msgstr "Jumpt bi't Afspelen en groot Stoot vörut"

#. +> trunk
#: kplayerengine.cpp:537
msgid "Fast Forward command moves playback forward by ten percent of the time length of the current file. This command is available when playing a file."
msgstr "De Befehl \"Gau vörut\" jumpt bi't Afspelen teihn Perzent vun dat Stück sien Längde vörut. Disse Befehl is verföögbor, wenn en Datei afspeelt warrt."

#. +> trunk
#: kplayerengine.cpp:542
msgid "&Backward"
msgstr "&Torüch"

#. +> trunk
#: kplayerengine.cpp:544
msgid "Moves playback backward"
msgstr "Jumpt bi't Afspelen torüch"

#. +> trunk
#: kplayerengine.cpp:545
msgid "Backward command moves playback backward by one percent of the time length of the current file. This command is available when playing a file."
