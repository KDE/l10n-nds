msgstr "&Reedschap"

#. i18n: ectx: property (toolTip), widget (QLabel, l_device)
#. i18n: ectx: property (toolTip), widget (QLineEdit, c_device)
#. +> trunk
#: kplayersettingsvideo.ui:93 kplayersettingsvideo.ui:123
msgid "Video device to use for the chosen output"
