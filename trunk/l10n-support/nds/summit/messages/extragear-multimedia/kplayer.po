#. +> trunk
#: kplayerplaylist.cpp:51
msgid "&Play..."
msgstr "Afs&pelen..."

#. +> trunk
#: kplayerplaylist.cpp:52
msgid "Plays an existing file"
msgstr "En vörhannen Datei afspelen"

#. +> trunk
#: kplayerplaylist.cpp:53
msgid "Play command displays the standard Open File dialog and lets you choose a file or several files to put on the playlist and start playing."
msgstr "De Befehl \"Afspelen\" maakt den normalen \"Datei opmaken\"-Dialoog op. Dor binnen kannst Du en oder mehr Dateien utsöken, de denn op de Afspeellist sett un afspeelt warrt."

#. +> trunk
#: kplayerplaylist.cpp:58
msgid "Play &URL..."
msgstr "&URL afspelen"

#. +> trunk
#: kplayerplaylist.cpp:61
msgid "Plays a URL"
msgstr "En URL afspelen"

#. +> trunk
#: kplayerplaylist.cpp:62
msgid "Play URL command displays the standard URL dialog and lets you type or paste in a URL to put on the playlist and start playing. The URL can be a remote network location, a local file path, or a KDE I/O Slave URL."
msgstr "De Befehl \"URL afspelen\" maakt den normalen URL-Dialoog op, Dor kannst Du denn en URL ingeven oder infögen, de denn op de Afspeellist sett un afspeelt warrt. De URL kann op en Steed in't Nett oder en lokaal Datei wiesen, oder en KDE-In-/Utgaavmoduul-URL wesen."

#. +> trunk
#: kplayerplaylist.cpp:64
#, kde-format
msgid "Plays the %1 list"
msgstr "De List \"%1\" afspelen"

#. +> trunk
#: kplayerplaylist.cpp:65
#, kde-format
msgid "Play List %1 starts playing the list."
msgstr "De Befehl \"List '%1' afspelen\" speelt de List af."

#. +> trunk
#: kplayerplaylist.cpp:68
#, kde-format
msgid "Plays %1"
msgstr "\"%1\" afspelen"

#. +> trunk
#: kplayerplaylist.cpp:69
#, kde-format
msgid "Play Recent %1 starts playing the recently played item."
msgstr "De Befehl \"Lest Stück '%1' afspelen\" speelt dat tolest speelte Stück af."

#. +> trunk
#: kplayerplaylist.cpp:74
#, kde-format
msgid "Shows commands and options available for %1"
msgstr "För \"%1\" verföögbor Befehlen un Optschonen wiesen"

#. +> trunk
#: kplayerplaylist.cpp:75
#, kde-format
msgid "Submenu that shows commands and options available for %1."
msgstr "Ünnermenü, dat de Befehlen un Optschonen wiest, de för \"%1\" verföögbor sünd"

#. +> trunk
#: kplayerplaylist.cpp:80
msgid "&Next"
msgstr "&Nakamen"

#. +> trunk
#: kplayerplaylist.cpp:83
msgid "Plays the next item on the playlist"
msgstr "Speelt den nakamen Indrag binnen de Afspeellist af"

#. +> trunk
#: kplayerplaylist.cpp:84
msgid "Next command starts playing the next item on the current playlist."
msgstr "De Befehl \"Nakamen\" speelt den nakamen Indrag binnen de aktuelle Afspeellist af."

#. +> trunk
#: kplayerplaylist.cpp:89
msgid "P&revious"
msgstr "Ve&rleden"

#. +> trunk
#: kplayerplaylist.cpp:92
msgid "Plays the previous item on the playlist"
msgstr "Speelt den verleden Indrag binnen de Afspeellist af"

#. +> trunk
#: kplayerplaylist.cpp:93
msgid "Previous command starts playing the previous item on the current playlist."
msgstr "De Befehl \"Verleden\" speelt den verleden Indrag binnen de aktuelle Afspeellist af."

#. +> trunk
#: kplayerplaylist.cpp:102
msgid "Shows playlist items and allows you to select an item to play"
msgstr "Wiest Indrääg binnen de Afspeellist un lett ehr Afspelen to"

#. +> trunk
#: kplayerplaylist.cpp:103
msgid "Playlist combo box in the closed state displays the current playlist item. You can drop down the combo box to see the entire list and select a different item to load and play."
msgstr "Dat Afspeellist-Utsöökfeld wiest dat aktuelle Stück op de Afspeellist, wenn dat to is. Du kannst dat Feld opmaken un en anner Stück utsöken, dat denn laadt un afspeelt warrt."

#. +> trunk
#: kplayerplaylist.cpp:112
msgid "&Loop"
msgstr "&Wedderhalen"

#. +> trunk
#: kplayerplaylist.cpp:114
msgid "Turns the option to loop through the list on/off"
msgstr "Maakt de Afspeellist-Wedderhalen an/ut"

#. +> trunk
#: kplayerplaylist.cpp:115
msgid "Loop command toggles the option to start playing items from the beginning of the playlist after playing the last item on the playlist."
msgstr "Mit den Befehl \"Wedderhalen\" lett sik an/utmaken, wat de Afspeellist na den lesten Indrag wedder vun vörn afspeelt warrt."

#. +> trunk
#: kplayerplaylist.cpp:122
msgid "S&huffle"
msgstr "&Mischen"

#. +> trunk
#: kplayerplaylist.cpp:124
msgid "Turns the option to play items in random order on or off"
msgstr "Maakt de Optschoon för't Afspelen vun Indrääg in tofällige Reeg an/ut"

#. +> trunk
#: kplayerplaylist.cpp:125
msgid "Shuffle command toggles the option to play items in a random order."
msgstr "De Befehl \"Mischen\" maakt de Optschoon för't Afspelen vun Indrääg in tofällige Reeg an/ut."

#. +> trunk
#: kplayerplaylist.cpp:133
msgid "Adds files to the playlist"
msgstr "Föögt Dateien na de Afspeellist to"

#. +> trunk
#: kplayerplaylist.cpp:134
msgid "Add files command displays the standard Open File dialog and lets you choose a file or several files to add to the playlist."
msgstr "De Befehl \"Dateien tofögen\" wiest den normalen Datei-Opmaakdialoog. Hier kannst Du en oder mehr Dateien utsöken, de Du de Afspeellist tofögen wullt."

#. +> trunk
#: kplayerplaylist.cpp:140
msgid "Adds a URL to the playlist"
msgstr "Föögt en URL na de Afspeellist to"

#. +> trunk
#: kplayerplaylist.cpp:141
msgid "Add URL command displays the standard Open URL dialog and lets you type or paste in a URL to add to the playlist."
msgstr "De Befehl \"URL tofögen\" wiest den normalen URL-Opmaakdialoog. Hier kannst Du en URL ingeven oder infögen, de Du de Afspeellist tofögen wullt."

#. +> trunk
#: kplayerplaylist.cpp:146
msgid "&Playlists..."
msgstr "Afs&peellisten..."

#. +> trunk
#: kplayerplaylist.cpp:147
msgid "Saves the playlist under a new name"
msgstr "Sekert de Afspeellist mit en nieg Naam"

#. +> trunk
#: kplayerplaylist.cpp:148
msgid "Add to new playlist command prompts for a new playlist name and saves the playlist under the new name."
msgstr "De Befehl \"Na nieg Afspeellist tofögen\" fraagt na en nieg Naam för de Afspeellist un sekert ehr mit dissen Naam."

#. +> trunk
#: kplayerplaylist.cpp:150
#, kde-format
msgid "Adds playlist items to %1 playlist"
msgstr "Föögt Afspeellist-Indrääg na Afspeellist %1 to"

#. +> trunk
#: kplayerplaylist.cpp:151
#, kde-format
msgid "Add to playlist command adds the playlist items to the %1 playlist."
msgstr "De Befehl \"Na Afspeellist tofögen\" föögt de Afspeellist ehr Indrääg de Afspeellist \"%1\" to."

#. +> trunk
#: kplayerplaylist.cpp:157
msgid "&Collection..."
msgstr "&Sammeln..."

#. +> trunk
#: kplayerplaylist.cpp:158
msgid "Saves the playlist in the collection"
msgstr "Sekert de Afspeellist binnen de Sammeln"

#. +> trunk
#: kplayerplaylist.cpp:159
msgid "Add to collection command prompts for a new folder name and saves the playlist under the new name in the multimedia collection."
msgstr "De Befehl \"Na Sammeln tofögen\" fraagt na en nieg Ornernaam un sekert de Afspeellist mit den niegen Naam binnen de Multimedia-Sammeln"

