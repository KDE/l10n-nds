#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:13
msgid "Whether to display a second, left time label."
msgstr "Linkerhand en tweet Tietdorstellen wiesen"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:14
msgid "Set this to display a second time label to the left of the seek slider in the player window."
msgstr "Maak dit an, wenn Du en tweet Tietdorstellen linkerhand vun den Stück-Schuver wiest hebben wullt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:18
msgid "Whether to display remaining track time in the left time label."
msgstr "Nablieven Speeltiet linkerhand wiesen"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:19
msgid "Set this to display remaining track time instead of past track time in the player window."
msgstr "Maak dit an, wenn Du lever de nablieven Speeltiet as de al aflopen Tiet vun dat aktuelle Stück binnen dat Afspeler-Finster wiest hebben wullt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:23
msgid "Which track(s) to play repeatedly"
msgstr "Leggt de Stück(en), de wedderhaalt warrt"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:24
msgid "Whether to repeat the current track, the current album, or the current playlist indefinitely, or neither."
msgstr "Dat aktuelle Stück, Album, de aktuelle Afspeellist oder gor nix ahn Enn wedderhalen"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:27
msgid "Do not Repeat"
msgstr "Nich wedderhalen"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:30
msgid "Repeat Track"
msgstr "Stück wedderhalen"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:33
msgid "Repeat Album"
msgstr "Album wedderhalen"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:36
msgid "Repeat Playlist"
msgstr "Afspeellist wedderhalen"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:42
msgid "Which tracks or albums to favor in Random Mode"
msgstr "Leggt de Stücken un Alben fast, de in den Tofallbedrief vörtrocken warrt"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:43
msgid "Tracks or albums with the chosen property will be more likely to be chosen in Random Mode."
msgstr "Stücken un Alben mit de utsöchte Egenschap warrt in den Tofallbedrief fakener utsöcht as anner."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:53
msgid "Whether to play tracks or albums in random order"
msgstr "Stücken un Alben na Tofall spelen"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:54
msgid "If set, Amarok plays the tracks or albums in the playlist in a random order."
msgstr "Wenn anmaakt, speelt Amarok de Stücken un Alben op de Afspeellist in en tofällig Reeg."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:63
msgid "The status of dynamic mode."
msgstr "Den dünaamschen Bedrief sien Status"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:64
msgid "If set, dynamic mode will be on, and tracks will be added according to the dynamic playlist specified."
msgstr "Wenn anmaakt, is de dünaamsche Bedrief an, un Stücken warrt ut de angeven dünaamsche Afspeellist toföögt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:68
msgid "The most recently used Dynamic Mode"
msgstr "De tolest bruukt dünaamsch Bedrief"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:69
msgid "The title of the Dynamic Mode that was most recently loaded in the playlist"
msgstr "De Titel vun den dünaamschen Bedrief, de tolest in de Afspeellist weer"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:73
msgid "Whether to show icon in system tray"
msgstr "Lüttbild binnen Systeemafsnitt wiesen"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:74
msgid "Enable/Disable tray icon for Amarok."
msgstr "Dat Amarok-Lüttbild binnen den Systeemafsnitt vun't Paneel an- oder utmaken"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk
#: amarokconfig.kcfg:78
msgid "Whether to hide the context view."
msgstr "Kontextkieker versteken"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk
#: amarokconfig.kcfg:79
msgid "Enable/Disable context view in Amarok."
msgstr "Den Kontextkieker an- oder utmaken"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:83
msgid "Whether to animate the systray icon"
msgstr "Systeemafsnitt-Lüttbild blinken laten"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:84
msgid "Enable/Disable tray icon animation."
msgstr "Animeren för Systeemafsnitt-Lüttbild an-/utmaken"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:88
msgid "Delay between tracks, in milliseconds"
msgstr "Paus twischen Stücken, in Millisekunnen."

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:89
msgid "Delay between tracks, in milliseconds."
msgstr "Paus twischen Stücken, in Millisekunnen."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:93
msgid "Number of undo levels in playlist"
msgstr "Torüchnehm-Schreed binnen Afspeellist"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:94
msgid "The number of undo levels in the playlist."
msgstr "Tall vun Schreed, de binnen dat Afspeellist-Finster torüchnahmen warrn köönt"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:98
msgid "Whether a splash-screen should be displayed on startup"
msgstr "Startschirm bi't Starten wiesen"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:99
msgid "Enable/Disable splashscreen during Amarok startup."
msgstr "Dat Wiesen vun den Startschirm bi Amarok sien Start an-/utmaken"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:103
msgid "Whether playlists store relative path"
msgstr "Afspeellisten bruukt relative Padden"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:104
msgid "If set, Amarok's manually saved playlists will contain a relative path to each track, not an absolute path."
msgstr "Wenn anmaakt, bargt vun Hand sekerte Amarok-Afspeellisten relative Padden na de Stücken."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:108
msgid "Whether organize files will overwrite existing files."
msgstr "Bi't Bestüern vörhannen Dateien överschrieven"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:109
msgid "If set, Organize files will overwrite any existing destination."
msgstr "Wenn anmaakt, warrt bi't Bestüern al vörhannen Dateien överschreven."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:113
msgid "Whether organize files will group directories according to their filetype."
msgstr "Bi't Bestüern Ornern na Dateityp tohoop stellen"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:114
msgid "If set, Organize files will group directories containing the same filetype."
msgstr "Wenn anmaakt, warrt bi't Bestüern Ornern mit den sülven Dateityp tohoop stellt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk
#: amarokconfig.kcfg:118
msgid "Whether organize files will group artists whose names start with the same character."
msgstr "Bi't Bestüern Künstlers mit den sülven Anfangbookstaav tohoop stellen"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk
#: amarokconfig.kcfg:119
msgid "If set, Organize files will group artists whose names start with the same character."
msgstr "Wenn anmaakt, warrt Künstlers mit den sülven Anfangbookstaav tohoop stellt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:123
msgid "Whether organize files will ignore The in artist names."
msgstr "Bi't Bestüern en \"The\" binnen den Künstlernaam övergahn"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:124
msgid "If set, Organize files will ignore The in artist names."
msgstr "Wenn anmaakt, warrt bi't Bestüern en \"The\" binnen den Künstlernaam övergahn."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk
#: amarokconfig.kcfg:128
msgid "Whether organize files will replace spaces in filenames with underscores."
msgstr "Bi't Bestüern Freetekens binnen Dateinaams mit Ünnerstreek utwesseln"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk
#: amarokconfig.kcfg:129
msgid "If set, Organize files will replace spaces in filenames with underscores."
msgstr "Wenn anmaakt, warrt bi't Bestüern Freetekens binnen Dateinaams mit Ünnerstreek utwesselt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:133
msgid "Whether organize files will use cover art as folder icons."
msgstr "Bi't Bestüern Titelbiller as Lüttbiller för Ornern bruken"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:134
msgid "If set, Organize files will use cover art as folder icons."
msgstr "Wenn anmaakt, warrt bi't Bestüern Titelbiller as Lüttbiller för de Ornern bruukt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:138
msgid "Index of collection folder destination for Organize files."
msgstr "Index vun dat Sammelnorner-Teel bi't Bestüern"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:139
msgid "The ID of the collection folder destination for Organize files."
msgstr "De ID vun dat Sammelnorner-Teel bi't Bestüern"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:143
msgid "Whether organize files will rename files in a manner compatible with vfat filesystems."
msgstr "Bi't Bestüern Dateien so ümnömen, dat se kompatibel to VFAT warrt"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:144
msgid "If set, Organize files will replace characters that are not compatible with vfat filesystems (such as ':', '*' and '?')."
msgstr "Wenn anmaakt, warrt bi't Bestüern Tekens utwesselt, de nich kompatibel to VFAT-Dateisystemen sünd (as a.B. \":\", \"*\" un \"?\")."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:148
msgid "Whether organize files will rename files such that they only contain 7-bit ASCII characters."
msgstr "Bi't Bestüern Dateien so ümnömen, dat se bloots ASCII-Tekens bruukt"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:149
msgid "If set, Organize files will replace characters that are not compatible with the 7-bit ASCII character set."
msgstr "Wenn anmaakt, warrt Dateien bi't Bestüern so ümnöömt, dat se bloots ASCII-Tekens bargt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:153
msgid "Whether organize files will use a custom file naming scheme."
msgstr "Bi't Bestüern en egen Dateinaam-Schema bruken"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:154
msgid "If set, Organize files will rename files according to a custom format string."
msgstr "Wenn anmaakt, warrt Dateien bi't Bestüern langs en egen Formaattekenkeed ümnöömt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:158
msgid "Format string for Organize files, if a custom naming scheme is used."
msgstr "Formaattekenkeed för't Bestüern, wenn en egen Naamschema bruukt warrt."

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:159
msgid "If the custom filename scheme is enabled, then Organize files will rename files according to this format string."
msgstr "Wenn en egen Dateinaam-Muster anmaakt is, warrt Dateien bi't Bestüern langs disse Formaattekenkeed ümnöömt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:163
msgid "Regular expression that is to be replaced."
msgstr "Reguleer Utdruck, de utwesselt warrt"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:164
msgid "Organize files will replace substrings matching this regular expression."
msgstr "Bi't Bestüern warrt Ünnertekenkeden utwesselt, op de disse regulere Utdruck passt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:168
msgid "Replacing string."
msgstr "De Tekenkeed, mit de utwesselt warrt"

#. i18n: ectx: whatsthis, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:169
msgid "Organize files will replace matching substrings with this string."
msgstr "Bi't Bestüern warrt passen Ünnertekenkeden mit disse Tekenkeed utwesselt."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:173
msgid "Filename of the external web browser to be invoked by Amarok."
msgstr "De Dateinaam vun den extern Nettkieker, den Amarok bruken schall."

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk stable
#: amarokconfig.kcfg:177
msgid "Whether to automatically attempt to fetch cover art as needed"
msgstr "Leggt fast, wat Du Albenbiller automaatsch halen laten wullt"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk
#: amarokconfig.kcfg:181
msgid "Automatically scroll the playlist to make the currently playing song visible"
msgstr "Op de Afspeellist automaatsch na't aktuell afspeelt Stück gahn un dat wiesen"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk
#: amarokconfig.kcfg:185
msgid "Show Album art in the Collection Browser"
msgstr "Titelbild binnen den Sammelnkieker wiesen"

#. i18n: ectx: label, entry, group (General Options)
#. +> trunk
#: amarokconfig.kcfg:189
#, fuzzy
msgid "Show the Context View"
msgstr "Wenn anmaakt, warrt de Kontextkieker verstickt"

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:196
msgid "Master volume"
msgstr "Hööft-Luutstärk"

#. i18n: ectx: whatsthis, entry, group (Playback)
#. +> trunk
#: amarokconfig.kcfg:197
msgid "The Amarok master volume, a value between 0 and 100."
msgstr "De Hööftinstellen för de Amarok-Luutstärk, en Weert twischen 0 un 100."

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk
#: amarokconfig.kcfg:203
msgid "Mute state"
msgstr "\"Stumm\"-Tostand"

#. i18n: ectx: whatsthis, entry, group (Playback)
#. +> trunk
#: amarokconfig.kcfg:204
msgid "Mute/Unmute sound."
msgstr "Stumm/Luut maken"

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:208
msgid "Whether to crossfade between tracks"
msgstr "Twischen Stücken överblennen"

#. i18n: ectx: whatsthis, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:209
msgid "Enable/Disable crossfading between track changes."
msgstr "Dat Överblennen twischen Stücken an-/utmaken"

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:213
msgid "Length of crossfade, in milliseconds"
msgstr "Duer vun't Överblennen, in Millisekunnen"

#. i18n: ectx: whatsthis, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:214
msgid "The length of the crossfade between tracks in milliseconds."
msgstr "De Duer vun't Överblennen twischen Stücken, in Millisekunnen."

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:219
msgid "When to Crossfade"
msgstr "Wannehr överblendt warrt"

#. i18n: ectx: whatsthis, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:220
msgid "Determines whether to crossfade always, or on automatic/manual track changes only."
msgstr "Leggt fast, wat jümmers oder bloots bi't Wesseln vun Stücken automaatsch/per Hand överblendt warrt."

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:224
msgid "Whether to fade out tracks when pressing stop."
msgstr "Stücken bi't Klicken op \"Anhollen\" utblennen"

#. i18n: ectx: whatsthis, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:225
msgid "Enable/Disable fadeout."
msgstr "Utblennen an-/utmaken"

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:229
msgid "Length of fadeout, in milliseconds"
msgstr "Duer vun't Utblennen, as Millisekunnen"

#. i18n: ectx: whatsthis, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:230
msgid "The length of the fadeout in milliseconds."
msgstr "De Duer vun't Utblennen vun Stücken in Millisekunnen."

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:235
msgid "Whether to fade out when exiting the program."
msgstr "Bi't Beennen vun Amarok utblennen"

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:239
msgid "Enables the equalizer plugin"
msgstr "Liekmaker bruken"

#. i18n: ectx: whatsthis, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:240
msgid "When enabled, an equalizer plugin filters the audio stream."
msgstr "Wenn anmaakt, warrt de Klangstroom dör en Liekmaker föhrt."

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:244
msgid "Equalizer pre-amplification value, range -100..100, 0 is normal."
msgstr "Liekmaker-Vörverstärken, vun -100 bet 100, 0 is normaal."

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:250
msgid "Band gains for equalizer, 10 values, range -100..100, 0 is normal."
msgstr "Verstärken för Liekmaker-Bänner, 10 Weerten, vun -100 bet 100, 0 is normaal."

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk stable
#: amarokconfig.kcfg:254
msgid "Equalizer preset name."
msgstr "Naam vun dat Liekmakerprofil"

#. i18n: ectx: label, entry, group (Playback)
#. +> trunk
#: amarokconfig.kcfg:258
msgid "The mode for adjusting playback volume."
msgstr "De Metood för't Topassen vun de Afspeel-Luutstärk"

#. i18n: ectx: whatsthis, entry, group (Playback)
#. +> trunk
#: amarokconfig.kcfg:259
msgid "Whether to adjust the volume of tracks to make them sound the same volume, and if so whether to make the adjustments per-track or per-album."
msgstr "Leggt fast, wat de Stück-Luutstärk so topasst warrt, dat se sik liek luut anhöört, un wenn, wat de Topassen per Stück oder per Album maakt warrt."

