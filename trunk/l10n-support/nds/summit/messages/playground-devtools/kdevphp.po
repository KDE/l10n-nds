msgstr "PHP-Internal %1 lett sik nich nochmaal angeven."

#. +> trunk
#: duchain/declarationbuilder.cpp:458
msgid "Cannot redeclare %1, already declared in %2 on line %3."
msgstr "%1 lett sik nich nochmaal verkloren, dat wöör al in %2, Reeg %3 verkloort."

