msgstr ""

#. Tag: para
#. +> trunk stable
#: advanced.docbook:875
#, no-c-format
msgid "<literal>a.icon</literal> [optional]: The icon appears next to the text in the menu. All KDE icon names can be used here."
msgstr ""

#. Tag: para
#. +> trunk stable
#: advanced.docbook:876
#, no-c-format
msgid "<literal>a.category</literal> [optional]: If a category is specified, the script appears in a submenu. Make sure to use <literal>i18n</literal> for translation."
msgstr ""

#. Tag: para
#. +> trunk stable
#: advanced.docbook:877
#, no-c-format
