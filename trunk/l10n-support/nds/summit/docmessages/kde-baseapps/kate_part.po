#. Tag: title
#. +> trunk stable
#: part.docbook:9
#, no-c-format
msgid "Working with the &kate; editor"
msgstr ""

#. Tag: title
#. +> trunk stable
#: part.docbook:13
#, no-c-format
msgid "Overview"
msgstr "Översicht"

#. Tag: para
#. +> trunk stable
#: part.docbook:15
#, no-c-format
msgid "The &kate; editor is the editing area of the &kate; window. This editor is also used by &kwrite;, and it can be used in &konqueror; for displaying text files from your local computer, or from the network."
msgstr ""

#. Tag: para
#. +> trunk stable
#: part.docbook:20
#, no-c-format
msgid "The editor is composed of the following components:"
msgstr ""

#. Tag: term
#. +> trunk stable
#: part.docbook:25
#, no-c-format
msgid "The editing area"
msgstr ""

#. Tag: para
#. +> trunk stable
#: part.docbook:26
#, no-c-format
msgid "This is where the text of your document is located."
msgstr ""

#. Tag: term
#. +> trunk stable
#: part.docbook:30
#, no-c-format
msgid "The Scroll bars"
msgstr "De Rullbalkens"

#. Tag: para
#. +> trunk stable
#: part.docbook:32
#, no-c-format
msgid "The scroll bars indicate the position of the visible part of the document text, and can be used to move around the document. Dragging the scrollbars will not cause the insertion cursor to be moved."
msgstr ""

#. Tag: para
#. +> trunk stable
#: part.docbook:36
#, no-c-format
msgid "The scroll bars are displayed and hidden as required."
msgstr ""

#. Tag: term
#. +> trunk stable
#: part.docbook:41
#, no-c-format
msgid "The Icon Border"
msgstr ""

#. Tag: para
#. +> trunk stable
#: part.docbook:43
#, no-c-format
msgid "The icon border is a small pane on the left side of the editor, displaying a small icon next to marked lines."
msgstr ""

#. Tag: para
#. +> trunk stable
#: part.docbook:45
#, no-c-format
msgid "You can set or remove a <link linkend=\"kate-part-bookmarks\">bookmark</link> in a visible line by clicking the &LMB; in the icon border next to that line."
msgstr ""

#. Tag: para
#. +> trunk stable
#: part.docbook:48
#, no-c-format
msgid "The display of the icon border can be toggled using the <menuchoice><guimenu>View</guimenu> <guimenuitem>Show Icon Border</guimenuitem></menuchoice> menu item."
msgstr ""

#. Tag: term
#. +> trunk stable
#: part.docbook:55
#, no-c-format
msgid "The Line Numbers Pane"
msgstr ""

#. Tag: para
#. +> trunk stable
#: part.docbook:57
#, no-c-format
msgid "The Line numbers pane shows the line numbers of all visible lines in the document."
msgstr ""

#. Tag: para
#. +> trunk stable
#: part.docbook:59
#, no-c-format
msgid "The display of the Line Numbers Pane can be toggled using the <menuchoice><guimenu>View</guimenu> <guimenuitem>Show Line Numbers</guimenuitem></menuchoice> menu item."
msgstr ""

#. Tag: term
#. +> trunk stable
#: part.docbook:66
#, no-c-format
msgid "The Folding Pane"
msgstr ""

#. Tag: para
#. +> trunk stable
#: part.docbook:68
#, no-c-format
msgid "The folding pane allows you to collapse or expand foldable blocks of lines. The calculation of the foldable regions are done according to rules in the syntax highlight definition for the document."
msgstr ""

