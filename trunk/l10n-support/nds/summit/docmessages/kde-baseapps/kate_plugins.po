#. Tag: title
#. +> trunk stable
#: plugins.docbook:888
#, no-c-format
msgid "Search in Files"
msgstr "In Dateien söken"

#. Tag: title
#. +> trunk stable
#: plugins.docbook:891
#, no-c-format
msgid "Introduction"
msgstr "Inföhren"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:892
#, no-c-format
msgid "&kappname;'s Search in Files plugin allows you to search for text or <link linkend=\"regular-expressions\">regular expressions</link> in many different files at once. You can search all open files, or all the files in one directory, and optionally its subdirectories. You can even filter by filename, for instance searching only files that end with a particular file extension."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:898
#, no-c-format
msgid "The Search in Files plugin is not enabled by default, as it is new in &kappname; 3.7. Enable it in the <link linkend=\"config-dialog-plugins\">Plugins</link> panel of &kappname;'s settings. It will replace the old <link linkend=\"kate-application-plugin-findinfiles\">Find in Files plugin</link> in the next version of &kappname;."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:907 plugins.docbook:1185
#, no-c-format
msgid "Interface"
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:910
#, no-c-format
msgid "Search Query"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:912
#, no-c-format
msgid "The following options are always displayed at the top of the Search in Files tool view:"
msgstr ""

#. Tag: guiicon
#. +> trunk stable
#: plugins.docbook:918
#, no-c-format
msgid "New Tab"
msgstr "Nieg Paneel"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:919
#, no-c-format
msgid "You can have as many searches as you want open at the same time. Simply click the <guibutton>New Tab</guibutton> button at the top-left corner of the Search tool view and a new results tab will open permitting you to perform another search."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:928
#, no-c-format
msgid "Query"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:929
#, no-c-format
msgid "The long text box at the top is where you type in what you want to find. You may enter standard text, or a regular expression if enabled."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:936
#, no-c-format
msgid "Search"
msgstr "Söken"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:937
#, no-c-format
msgid "When you've finished configuring everything, just press the <guibutton>Search</guibutton> button to perform your search. You may also press &Enter; in the Query text box to do the same."
msgstr ""

#. Tag: guimenu
#. +> trunk stable
#: plugins.docbook:945
#, no-c-format
msgid "Location"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:946
#, no-c-format
msgid "This has two options. Select <guilabel>in Open Files</guilabel> to search all files currently open in &kappname;. Select <guilabel>in Folder</guilabel> to search inside a folder and optionally its subfolders."
msgstr ""

#. Tag: guimenu
#. +> trunk stable
#: plugins.docbook:954
#, no-c-format
msgid "<guimenu>Options</guimenu>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:955
#, no-c-format
msgid "There are two available options. If enabled, <guilabel>Match case</guilabel> will restrict search results to only those that have the exact same combination of upper and lower-case letters as your search query. <guilabel>Regular expressions</guilabel> permits you to use <link linkend=\"regular-expressions\">regular expressions</link> instead of simple text as your search query."
msgstr ""

#. Tag: guiicon
#. +> trunk stable
#: plugins.docbook:966
#, no-c-format
msgid "Toggle Results"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:967
#, no-c-format
msgid "The down arrow in the top right-corner of the Search in Files tool view will toggle the bottom half of the tool view between displaying additional options for the Search in Folder mode and the results of your search."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:978
#, no-c-format
msgid "Search in Folder Options"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:980
#, no-c-format
msgid "These options are displayed below the aforementioned query options. If search results are being displayed instead, press the <guiicon>Toggle Results</guiicon> button to display them. These options apply only when Search in Folder mode is enabled. If Search in Open Files is selected, they will be disabled."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:988
#, no-c-format
msgid "Folder"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:989
#, no-c-format
msgid "You may enter the path of the folder you wish to search. For instance, you might enter <userinput>~/development/kde/kate/</userinput> if you wished to search the &kate; source code."
msgstr ""

#. Tag: guiicon
#. +> trunk stable
#: plugins.docbook:997
#, no-c-format
msgid "Open file dialog"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:998
#, no-c-format
msgid "Press this button to locate for the folder in your desktop's folder browser."
msgstr ""

#. Tag: guiicon
#. +> trunk stable
#: plugins.docbook:1004
#, no-c-format
msgid "<guiicon>Up</guiicon>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1005
#, no-c-format
msgid "Press this button to change <guilabel>Folder</guilabel> to the parent of the currently selected folder."
msgstr ""

#. Tag: guiicon
#. +> trunk stable
#: plugins.docbook:1012
#, no-c-format
msgid "Restore Current Folder"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1013
#, no-c-format
msgid "This button will set the <guilabel>Folder</guilabel> entry to the folder in which the currently open document is located."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1020
#, no-c-format
msgid "Filter"
msgstr "Filter"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1021
#, no-c-format
msgid "This permits you to only search filenames that match a particular pattern. For instance, to only search files written in C++, change it to <userinput>*.cpp</userinput>. To search only files beginning with <literal>kate</literal>, change it to <userinput>kate*</userinput>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1030
#, no-c-format
msgid "Recursive"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1031
#, no-c-format
msgid "If this option is enabled, &kappname; will also search in all subfolders of the selected folder."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1038
#, no-c-format
msgid "Include hidden"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1039
#, no-c-format
msgid "If this option is enabled, &kappname; will also search in files or folders that are typically hidden by your &OS;."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1046
#, no-c-format
msgid "Follow symbolic links"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1047
#, no-c-format
msgid "The Search in Files plugin typically doesn't follow <ulink url=\"http://en.wikipedia.org/wiki/Symbolic_link\">symbolic links</ulink>. When this option is enabled, the plugin will follow them instead and search inside the files or folders they reference."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1053
#, no-c-format
msgid "It's possible for symbolic links to reference a folder that is the parent of the folder currently being searched, or other folders that contain symbolic links to their parent. If there is such a link in the folder being searched and this option is enabled, &kappname; will repeatedly follow the link and search the folder, and the search will never complete."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:1065
#, no-c-format
msgid "Search Results"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1067
#, no-c-format
msgid "The results of your search are displayed below the query options. If options for Search in Folder mode are displayed, simply press the <guiicon>Toggle Results</guiicon> button to display them. They will also automatically be displayed as soon as a search is performed."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1072
#, no-c-format
msgid "The search results displays three columns providing information about each result of your search query. The <guilabel>File</guilabel> column shows the name of the file. The <guilabel>Line</guilabel> column displays the line number the contents of your query were found in. The <guilabel>Text</guilabel> column displays the full text of that line."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1078
#, no-c-format
msgid "To open the file your result was found in, simply double-click it. &kappname; will open the file if needed, and place the cursor at the beginning of the text entered as your query as found in the file."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: plugins.docbook:1104
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show Search in Files</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1110
#, no-c-format
msgid "Toggle the display of &kappname;'s <guilabel>Search in Files</guilabel> tool."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:1127
#, no-c-format
msgid "Mail Files"
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: plugins.docbook:1135
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Mail...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1141
#, no-c-format
msgid "Open your mail client and attach the file in the mail."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:1159
#, no-c-format
msgid "Filesystem Browser"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1161
#, no-c-format
msgid "The Filesystem Browser is a folder viewer, allowing you to open files from a displayed folder in the current frame."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: plugins.docbook:1171
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show Filesystem Browser</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1177
#, no-c-format
msgid "Toggle the display of &kate;'s Filesystem Browser"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1187
#, no-c-format
msgid "From top down, the Filesystem Browser consist of the following elements:"
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:1192
#, no-c-format
msgid "A Toolbar"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1194
#, no-c-format
msgid "This contains standard navigations tool buttons:"
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1197
#, no-c-format
msgid "Back"
msgstr "Torüch"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1198
#, no-c-format
msgid "Causes the folder view to <command>cd</command> to the previously displayed folder in the history. This button is disabled, if there is no previous item."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1202
#, no-c-format
msgid "Forward"
msgstr "Vörut"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1203
#, no-c-format
msgid "Causes the folder view to <command>cd</command> to the next folder in the history. This button is disabled, if there is no next folder."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1212
#, no-c-format
msgid "Bookmarks"
msgstr "Leestekens"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1213
#, no-c-format
msgid "Opens a submenu to edit or add bookmarks and to add a new bookmark folder."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1216
#, no-c-format
msgid "Current Document Folder"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1217
#, no-c-format
msgid "This button will cause the folder view to <command>cd</command> to the folder of the currently active document if possible. This button is disabled, if the active document is a new, unsaved file, or the folder in which it resides can not be decided."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1224
#, no-c-format
msgid "<guibutton>Options</guibutton>"
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:1228
#, no-c-format
msgid "Short View"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1229
#, no-c-format
msgid "Displays only the filenames."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:1232
#, no-c-format
msgid "Detailed View"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1233
#, no-c-format
msgid "Displays <guilabel>Name</guilabel>, <guilabel>Date</guilabel>, <guilabel>Size</guilabel> and <guilabel>Type</guilabel> of the files."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:1237
#, no-c-format
msgid "Tree View"
msgstr "Boomansicht"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1238
#, no-c-format
msgid "Like Short View, but folders can be expanded to view their contents."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:1241
#, no-c-format
msgid "Detailed Tree View"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1242
#, no-c-format
msgid "This also allows folders to be expanded, but displays the additional columns available in Detailed View."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:1246
#, no-c-format
msgid "Show Hidden Files"
msgstr "Versteken Dateien wiesen"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1247
#, no-c-format
msgid "Displays files normally hidden by your operating system."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:1250
#, no-c-format
msgid "Automatically synchronize with current document"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1251
#, no-c-format
msgid "When this option is enabled the filesystem browser will automatically <command>cd</command> to the folder of the document currently open in the editing area every time it changes."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:1262
#, no-c-format
msgid "A Location Entry"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1264
#, no-c-format
msgid "This displays a breadcrumb navigation to the currently open folder, like &dolphin;. You can click on a any folder to browse to it, or click on one of the arrows to the left of a folder to select any folders beneath it. You may also select from your list of Places by clicking the leftmost icon in the breadcrumb navigation, which displays an icon that represents your current Place."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1270
#, no-c-format
msgid "You can also click to the right of the breadcrumbs to change them to a text box where you can type the path of a folder to browse. The &URL; entry maintains a list of previously typed paths. To choose one, use the arrow button to the right of the entry."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1274
#, no-c-format
msgid "The &URL; entry has folder auto-completion. The completion method can be set using the &RMB; menu of the text entry."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:1281
#, no-c-format
msgid "A Folder View"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1282
#, no-c-format
msgid "This is a standard &kde; folder view."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:1286
#, no-c-format
msgid "A Filter Entry"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1288
#, no-c-format
msgid "The Filter entry allows you to enter a filter for the files displayed in the folder view. The filter uses standard globs; patterns must be separated by white space. Example: <userinput>*.cpp *.h *.moc</userinput>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1292
#, no-c-format
msgid "To display all files, enter a single asterisk <userinput>*</userinput>."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1294
#, no-c-format
msgid "The filter entry saves the last 10 filters entered between sessions. To use one, press the arrow button on the right of the entry and select the desired filter string. You can disable the filter by pressing the <guibutton>Clear text</guibutton> button to the left of the autocompletion arrow button."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:1307 plugins.docbook:1360
#, no-c-format
msgid "Configuration"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1309
#, no-c-format
msgid "This plugin can be configured on the <guilabel>Filesystem Browser</guilabel> page of <link linkend=\"configuring-kate-configdialog\">&kate;'s configuration</link>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1314
#, no-c-format
msgid "Toolbar"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1315
#, no-c-format
msgid "Configure the buttons on the file system browser toolbar by moving the ones you want enabled to the <guilabel>Selected Actions</guilabel> list, and order them using the arrow buttons at the side of the list."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:1334
#, no-c-format
msgid "<title>External Tools</title>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1336
#, no-c-format
msgid "In the <guimenu>Tools</guimenu> menu you will find a submenu labeled <guisubmenu>External Tools</guisubmenu>, if you have enabled them in &kate; settings. These tools invoke external applications with data related to the current document, for example its URL, directory, text or selection."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1341
#, no-c-format
msgid "External tools are user defined, you can add, edit or remove tools using the <link linkend=\"exttools-config\">External Tools</link> configuration panel."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: plugins.docbook:1350
#, no-c-format
msgid "<guimenu>Tools</guimenu><guisubmenu>External Tools</guisubmenu>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1352
#, no-c-format
msgid "This submenu contains all the external tools you have configured."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1362
#, no-c-format
msgid "External tools are configured on the <guilabel>External Tools</guilabel> page of <link linkend=\"configuring-kate-configdialog\">&kate;'s configuration</link>. These tools invoke external applications with data related to the current document, for example its URL, directory, text or selection. This page allows you to manage the menu and edit, remove or add new tools."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1368
#, no-c-format
msgid "Each external tool is a shell command which contains macros representing the document data. When activated, the macros are substituted with data from the active document."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:1373
#, no-c-format
msgid "Available Commands"
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1376
#, no-c-format
msgid "<guibutton>New</guibutton>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1377
#, no-c-format
msgid "Add a new external tool to the list. This will launch the property sheet described below where you can configure an external tool."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1382
#, no-c-format
msgid "Edit"
msgstr "Bewerken"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1383
#, no-c-format
msgid "Edit the currently selected external tool, using the property sheet described below."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1388
#, no-c-format
msgid "Insert Separator"
msgstr "Trennlien infögen"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1389
#, no-c-format
msgid "Adds a separator line that appears in the menu below the currently selected item."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1394
#, no-c-format
msgid "Up Arrow"
msgstr "Piel hooch"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1395
#, no-c-format
msgid "Moves the currently selected item above the previous one."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1400
#, no-c-format
msgid "Down Arrow"
msgstr "Piel daal"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1401
#, no-c-format
msgid "Moves the currently selected item below the subsequent one."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:1408
#, no-c-format
msgid "External Tools Properties"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1410
#, no-c-format
msgid "Label"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1411
#, no-c-format
msgid "A friendly label that will appear in the <guisubmenu>External Tools</guisubmenu> menu."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: plugins.docbook:1415
#, no-c-format
msgid "Icon"
msgstr "Lüttbild"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1416
#, no-c-format
msgid "Allows you to select an icon that appears next to the label in the <guisubmenu>External Tools</guisubmenu> menu."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1421
#, no-c-format
msgid "Script"
msgstr "Skript"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1422
#, no-c-format
msgid "The script to execute when the tool is activated. Before passing the script to the shell, the following macros are substituted:"
msgstr ""

#. Tag: userinput
#. +> trunk stable
#: plugins.docbook:1427
#, no-c-format
msgid "%URL"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1428
#, no-c-format
msgid "The full URL of the current document, or an empty string if the document is unsaved."
msgstr ""

#. Tag: userinput
#. +> trunk stable
#: plugins.docbook:1433
#, no-c-format
msgid "%URLs"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1434
#, no-c-format
msgid "A space separated list of the URLs of all open documents (except unsaved ones)."
msgstr ""

#. Tag: userinput
#. +> trunk stable
#: plugins.docbook:1439
#, no-c-format
msgid "%directory"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1440
#, no-c-format
msgid "The directory part of the current documents URL or an empty string if the current document is unsaved."
msgstr ""

#. Tag: userinput
#. +> trunk stable
#: plugins.docbook:1445
#, no-c-format
msgid "%filename"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1446
#, no-c-format
msgid "The filename of the current document without the path, or an empty string if the current document is unsaved."
msgstr ""

#. Tag: userinput
#. +> trunk stable
#: plugins.docbook:1451
#, no-c-format
msgid "%line"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1452
#, no-c-format
msgid "The line number of the insertion cursor is in the current document."
msgstr ""

#. Tag: userinput
#. +> trunk stable
#: plugins.docbook:1457
#, no-c-format
msgid "%column"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1458
#, no-c-format
msgid "The column number of the insertion cursor in the current document."
msgstr ""

#. Tag: userinput
#. +> trunk stable
#: plugins.docbook:1463
#, no-c-format
msgid "%selection"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1464
#, no-c-format
msgid "The selected text in the current document, or an empty string if no text is selected"
msgstr ""

#. Tag: userinput
#. +> trunk stable
#: plugins.docbook:1469
#, no-c-format
msgid "%text"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1470
#, no-c-format
msgid "The full text of the current document. Beware that this may potentially exceed the maximum command length allowed on your system. Use with care."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1481
#, no-c-format
msgid "Executable"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1482
#, no-c-format
msgid "The main executable in the script. This is mandatory, and is used to test if the command can be run at all. A fully qualified path is allowed in case the executable is not in your <envar>PATH</envar> variable."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1488
#, no-c-format
msgid "Mime types"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1489
#, no-c-format
msgid "A semicolon separated list of mimetypes for which this command should be enabled."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1494
#, no-c-format
msgid "Save"
msgstr "Sekern"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1495
#, no-c-format
msgid "You can optionally select to have the current or all documents saved prior to executing the script. This is handy if your script reads the file from disk."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: plugins.docbook:1501
#, no-c-format
msgid "Command line name"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:1502
#, no-c-format
msgid "If you fill this, the tool will be available in the <link linkend=\"advanced-editing-tools-commandline\">editors command line</link> as <command>exttool-<replaceable>Command Line Name</replaceable></command> (the string you enter here prepended <quote>exttool-</quote>)."
msgstr ""
