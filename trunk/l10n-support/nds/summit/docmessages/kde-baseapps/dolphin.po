#. Tag: para
#. +> trunk stable
#: index.docbook:148
#, no-c-format
msgid "The toolbar, which can be used for quick access to frequently used actions. The toolbar can be customized by clicking it with the &RMB; and choosing <menuchoice><guimenuitem>Configure Toolbars...</guimenuitem></menuchoice> from the context menu, with <guimenuitem>Configure Toolbars...</guimenuitem> from the <guibutton>Configure and control &dolphin;</guibutton> button at the right of the toolbar or via <menuchoice><guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem></menuchoice> from the main menu."
msgstr ""

#. Tag: screeninfo
#. +> trunk stable
#: index.docbook:159 index.docbook:264 index.docbook:291
#, fuzzy, no-c-format
#| msgid "Here's a screenshot of &dolphin;"
