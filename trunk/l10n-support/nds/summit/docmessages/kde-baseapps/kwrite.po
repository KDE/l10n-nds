#. Tag: term
#. +> trunk stable
#: index.docbook:1331
#, no-c-format
msgid "<menuchoice> <guimenu>Tools</guimenu> <guisubmenu>Mode</guisubmenu></menuchoice> (Power user mode)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1335
#, no-c-format
