msgstr ""

#. Tag: term
#. +> trunk stable
#: index.docbook:1345
#, no-c-format
msgid "<menuchoice> <guimenu>Tools</guimenu> <guisubmenu>Highlighting</guisubmenu></menuchoice> (Power user mode)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1349
#, no-c-format
msgid "Choose the Highlighting scheme you prefer for the active document. This overwrites the global highlighting mode set in <menuchoice> <guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></menuchoice> for your current document only."
msgstr ""

#. Tag: term
#. +> trunk stable
#: index.docbook:1358
#, no-c-format
msgid "<menuchoice> <guimenu>Tools</guimenu> <guisubmenu>Indentation</guisubmenu></menuchoice> (Power user mode)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1362
#, no-c-format
msgid "Choose the style of indentation you want for your active document. This overwrites the global indentation mode set in <menuchoice> <guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1371
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1375
#, no-c-format
msgid "You can overwrite the default encoding set in <menuchoice> <guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></menuchoice> in the <guilabel>Open/Save</guilabel> page to set a different encoding for your current document. The encoding you set here will be only valid for your current document."
msgstr ""

#. Tag: term
#. +> trunk stable
#: index.docbook:1385
#, no-c-format
msgid "<menuchoice> <guimenu>Tools</guimenu> <guisubmenu>End of Line</guisubmenu></menuchoice> (Power user mode)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1389
#, no-c-format
msgid "Choose your preferred end of line mode for your active document. This overwrites the global end of line mode set in <menuchoice> <guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1398
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Add Byte Mark Order (BOM)</guisubmenu>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1402
#, no-c-format
msgid "Checking this action you can explicitly add a byte order mark for unicode encoded documents. The byte order mark (BOM) is a Unicode character used to signal the endianness (byte order) of a text file or stream, for more information see <ulink url=\"http://en.wikipedia.org/wiki/Byte_Order_Mark\">Byte Order Mark</ulink>."
msgstr ""

#. Tag: term
#. +> trunk stable
#: index.docbook:1410
#, no-c-format
msgid "<menuchoice> <shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Space</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Invoke Code Completion</guimenuitem> </menuchoice> (Power user mode)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1418
#, no-c-format
msgid "Manually invoke command completion, usually by using a shortcut bound to this action."
msgstr ""

#. Tag: term
#. +> trunk stable
#: index.docbook:1423
#, no-c-format
msgid "<menuchoice> <guimenu>Tools</guimenu> <guimenuitem>Word Completion</guimenuitem> </menuchoice> (Power user mode)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1428
#, no-c-format
msgid "<guimenuitem>Reuse Word Below</guimenuitem> (<keycombo action=\"simul\">&Ctrl; <keycap>9</keycap></keycombo>) and <guimenuitem>Reuse Word Above</guimenuitem> (<keycombo action=\"simul\">&Ctrl; <keycap>8</keycap></keycombo>) complete the currently typed text by searching for similar words backward or forward from the current cursor position. <guimenuitem>Shell Completion</guimenuitem> pops up a completion box with matching entries."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1438
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>O</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Automatic Spell Checking</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1446
#, no-c-format
msgid "When <guimenuitem>Automatic Spell Checking</guimenuitem> is enabled, wrong text is underlined in the document on-the-fly."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1452
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Spelling...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1461
#, no-c-format
msgid "<action>This initiates the spellchecking program - a program designed to help the user catch and correct any spelling errors.</action> Clicking on this entry will start the checker and bring up the speller dialog box through which the user can control the process. There are four settings lined up vertically in the center of the dialog with their corresponding labels just to the left. Starting at the top they are:"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1470
#, no-c-format
msgid "Unknown word:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1471
#, no-c-format
msgid "Here, the spellchecker indicates the word currently under consideration. This happens when the checker encounters a word not in its dictionary - a file containing a list of correctly spelled words against which it compares each word in the editor."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1477
#, no-c-format
msgid "Replace with:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1478
#, no-c-format
msgid "If the checker has any similar words in its dictionary the first one will be listed here. The user can accept the suggestion, type in his or her own correction, or choose a different suggestion from the next box."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1484
#, no-c-format
msgid "Language:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1485
#, no-c-format
msgid "If you have installed multiple dictionaries, here you can select which dictionary/language should be used."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1490
#, no-c-format
msgid "On the right side of the dialog box are 6 buttons that allow the user to control the spellcheck process. They are:"
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: index.docbook:1495
#, no-c-format
msgid "Add to Dictionary"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1496
#, no-c-format
msgid "Pressing this button adds the <guilabel>Unknown word </guilabel> to the checker's dictionary. This means that in the future the checker will always consider this word to be correctly spelled."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1502
#, no-c-format
msgid "Suggest"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1503
#, no-c-format
msgid "The checker may list here a number of possible replacements for the word under consideration. Clicking on any one of the suggestions will cause that word to be entered in the <guilabel>Replace with</guilabel> box, above."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: index.docbook:1509
#, no-c-format
msgid "<guibutton>Replace</guibutton>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1510
#, no-c-format
msgid "This button has the checker replace the word under consideration in the document with the word in the <guilabel>Replace with</guilabel> box."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: index.docbook:1515
#, no-c-format
msgid "Replace All"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1516
#, no-c-format
msgid "This button causes the checker to replace not only the current <guilabel>Unknown word:</guilabel> but to automatically make the same substitution for any other occurrences of this <guilabel>Unknown word</guilabel> in the document."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: index.docbook:1522
#, no-c-format
msgid "Ignore"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1523
#, no-c-format
msgid "Activating this button will have the checker move on without making any changes."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: index.docbook:1527
#, no-c-format
msgid "Ignore All"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1528
#, no-c-format
msgid "This button tells the checker to do nothing with the current <guilabel>Unknown word:</guilabel> and to pass over any other instances of the same word."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1530
#, no-c-format
msgid "This only applies to the current spellcheck run. If the checker is run again later it will stop on this same word."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1536
#, no-c-format
msgid "Three more buttons are located horizontally along the bottom of the spellcheck dialog. They are:"
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: index.docbook:1541
#, no-c-format
msgid "<guibutton>Help</guibutton>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1542
#, no-c-format
msgid "This invokes the &kde; help system with the help page for this dialog."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: index.docbook:1547
#, no-c-format
msgid "Finished"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1548
#, no-c-format
msgid "This button ends the spellcheck process, and returns to the document."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: index.docbook:1553
#, no-c-format
msgid "Cancel"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1554
#, no-c-format
msgid "This button cancels the spellcheck process, all modifications are reverted, and you will return to your document."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1564
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spelling (from cursor)...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1568
#, no-c-format
msgid "This initiates the spellchecking program but it starts where your cursor is instead of at the beginning of the document."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1574
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spellcheck Selection...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1578
#, no-c-format
msgid "Spellchecks the current selection."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1583
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Change Dictionary</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1587
#, no-c-format
msgid "Displays a drop down box with all available dictionaries for spellchecking at the bottom of the editor window. This allows easy switching of the spellcheck dictionary &eg; for automatic spellcheck of text in different languages."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1621
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1624
#, no-c-format
msgid "This cleans the indentation for the current selection or for the line the cursor is currently in. Cleaning the indentation ensures that all your selected text follows the indentation mode you choose."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1631
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Align</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1636
#, no-c-format
msgid "Causes a realign of the current line or selected lines using the indentation mode and indentation settings in the document."
msgstr ""

#. Tag: term
#. +> trunk stable
#: index.docbook:1642
#, no-c-format
msgid "<menuchoice> <shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>D</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem> </menuchoice> (Power user mode)"
