#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1669
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1676
#, no-c-format
msgid "Put the selected text or the letter after the cursor in uppercase."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1681
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>U</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Lowercase</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1688
#, no-c-format
msgid "Put the selected text or the letter after the cursor in lowercase."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1693
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;&Alt;<keycap>U</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Capitalize</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1700
#, no-c-format
msgid "Capitalize the selected text or the current word."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1705
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>J</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Join Lines</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1712
#, no-c-format
msgid "Joins the selected lines, or the current line and the line below with one white space character as a separator. Leading/trailing white space on joined lines is removed in the affected ends."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1718
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Apply Word Wrap</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1722
#, no-c-format
msgid "Apply static word wrapping on all the document. That means that a new line of text will automatically start when the current line exceeds the length specified by the <guilabel>Wrap words at</guilabel> option in the Editing tab in <menuchoice> <guimenu>Settings</guimenu><guimenuitem>Configure Editor...</guimenuitem></menuchoice>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1731
#, no-c-format
msgid "If the <link linkend=\"pref-plugins\">plugin</link> Insert File is enabled, you will find here an additional menu item <guimenuitem>Insert File...</guimenuitem>."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:1740
#, no-c-format
msgid "The Settings Menu"
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1744
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1748
#, no-c-format
msgid "When checked, this displays a small bar at the bottom of the editor containing information about the status of the current document. When unchecked the status bar is hidden."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1755
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1761
#, no-c-format
msgid "When checked, this displays a movable toolbar containing buttons used to initiate frequently used commands. When unchecked the toolbar is hidden."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1769
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Path</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1773
#, no-c-format
msgid "When selected, this displays in the titlebar the path (its location in the file system) of the current document. When unchecked the path is hidden."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1779
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1785
#, no-c-format
msgid "This menu item opens a dialog whereby several different <link linkend=\"pref-dialog\">settings</link> may be adjusted."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1793
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1797
#, no-c-format
msgid "This command opens a dialog box whereby the <link linkend=\"keybindings\">shortcuts</link> may be changed. A display window shows the list of commands (actions) and their assigned shortcuts, alternates and global shortcuts. The <guilabel>Search</guilabel> line above the list window is used to filter the shortcut list. Selecting an action with a &LMB; click (either on the action name or shortcut cell for the default shortcut or on the alternate cell for an alternative) displays the <guilabel>Default</guilabel> and <guilabel>Custom</guilabel> radio buttons below the selected action."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1806
#, no-c-format
msgid "To assign or change a shortcut click on the <guilabel>None</guilabel> button. Its label changes then to <guilabel>Input</guilabel>, now press the new key combination for the action."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1809
#, no-c-format
msgid "For example, with the <guilabel>About &kde;</guilabel> action selected in the display window, press the &Ctrl;, &Alt; and the <keycap>K</keycap> key on the keyboard. This would mean that anytime you hold down the &Ctrl; and &Alt; buttons and pressed <keycap>K</keycap> (while using &kappname;) the <guilabel>About &kde;</guilabel> display box would be called."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1814
#, no-c-format
msgid "Use the buttons at the bottom of the dialog to set all shortcuts back to their defaults, print the shortcut list or cancel all changes. Click the <guilabel>OK</guilabel> button to close the dialog and accept all changes."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: index.docbook:1821
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1824
#, no-c-format
msgid "This will open the dialog whereby the toolbar configuration may be changed. The user can choose which shortcut buttons should appear on the toolbar. A display window on the left lists the commands available to placed on the toolbar. A display on the right lists those commands already on the toolbar. A set of four arrow buttons between the two displays manipulates the selections. The right pointing arrow places any command selected in the left pane onto the right pane, <abbrev>i.e.</abbrev>, it is added to the toolbar. The left arrow does just the opposite, removing any action selected in the right window from the toolbar. The up and down pointing arrows change the position of an action selected in the right window which changes the position of its button in the toolbar."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:1841
#, no-c-format
msgid "The Help Menu"
msgstr ""

#. Tag: sect1
#. +> trunk stable
#: index.docbook:1841
#, no-c-format
msgid "&help.menu.documentation;"
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:1857
#, no-c-format
msgid "Configure &kappname;"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1859
#, no-c-format
msgid "Selecting <menuchoice><guimenu>Settings</guimenu><guimenuitem>Configure Editor...</guimenuitem></menuchoice> from the menu brings up the <guilabel>Configure Editor</guilabel> dialog box. This dialog can be used to alter a number of different settings. The settings available for change vary according to which category the user chooses from a vertical list on the left side of the dialog. By means of three buttons along the bottom of the box the user can control the process."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1869
#, no-c-format
msgid "You may invoke the <guilabel>Help</guilabel> system, accept the current settings and close the dialog by means of the <guibutton>OK</guibutton> button, or <guibutton>Cancel</guibutton> the process. The categories <guilabel>Appearance</guilabel>, <guilabel>Fonts &amp; Colors</guilabel>, <guilabel>Editing</guilabel>, <guilabel>Open/Save</guilabel> and <guilabel>Extensions</guilabel> are detailed below."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:1880
#, no-c-format
msgid "Appearance"
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:1883 index.docbook:2173 index.docbook:2567
#, no-c-format
msgid "<title>General</title>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1887
#, no-c-format
msgid "<guilabel>Dynamic Word Wrap</guilabel>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1889
#, no-c-format
msgid "If this option is checked, the text lines will be wrapped at the view border on the screen."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1893
#, no-c-format
msgid "Dynamic word wrap indicators (if applicable)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1894
#, no-c-format
msgid "Choose when the Dynamic word wrap indicators should be displayed, either <guilabel>Off</guilabel>, <guilabel>Follow Line Numbers</guilabel> or <guilabel>Always on</guilabel>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1899
#, no-c-format
msgid "Align dynamically wrapped lines to indentation depth:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1902
#, no-c-format
msgid "Enables the start of dynamically wrapped lines to be aligned vertically to the indentation level of the first line. This can help to make code and markup more readable."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1905
#, no-c-format
msgid "Additionally, this allows you to set a maximum width of the screen, as a percentage, after which dynamically wrapped lines will no longer be vertically aligned. For example, at 50%, lines whose indentation levels are deeper than 50% of the width of the screen will not have vertical alignment applied to subsequent wrapped lines."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1917
#, no-c-format
msgid "Whitespace Highlighting"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1921
#, no-c-format
msgid "Highlight tabulators"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1922
#, no-c-format
msgid "The editor will display a &raquo; symbol to indicate the presence of a tab in the text."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1926
#, no-c-format
msgid "Highlight trailing spaces"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1927
#, no-c-format
msgid "The editor will display dots to indicate the presence of extra whitespace at the end of lines."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1935
#, no-c-format
msgid "<guilabel>Advanced</guilabel>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1940
#, no-c-format
msgid "Show indentation lines"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1942
#, no-c-format
msgid "If this is checked, the editor will display vertical lines to help identifying indent lines."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1946
#, no-c-format
msgid "Highlight range between selected brackets"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1948
#, no-c-format
msgid "If this is enabled, the range between the selected matching brackets will be highlighted."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:1958
#, no-c-format
msgid "<title>Borders</title>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1962
#, no-c-format
msgid "<guilabel>Borders</guilabel>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1966
#, no-c-format
msgid "Show folding markers (if available)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1968
#, no-c-format
msgid "If this option is checked, the current view will display marks for code folding, if code folding is available."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1972
#, no-c-format
msgid "Show icon border"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1974
#, no-c-format
msgid "If this is checked, you will see an icon border on the left hand side. The icon border shows bookmark signs for instance."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1978
#, no-c-format
msgid "Show line numbers"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1980
#, no-c-format
msgid "If this is checked, you will see line numbers on the left hand side."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1984
#, no-c-format
msgid "Show scrollbar marks"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1986
#, no-c-format
msgid "If this option is checked the current view will show marks on the vertical scrollbar. These marks will for instance show bookmarks."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:1995
#, no-c-format
msgid "Sort Bookmarks Menu"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1997
#, no-c-format
msgid "These options are only displayed, if <guilabel>Enable power user mode (&kde; 3 mode)</guilabel> in the next section is checked."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2002
#, no-c-format
msgid "By creation"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2004
#, no-c-format
msgid "Each new bookmark will be added to the bottom, independently from where it is placed in the document."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2008
#, no-c-format
msgid "By position"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2010
#, no-c-format
msgid "The bookmarks will be ordered by the line numbers they are placed at."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2022
#, no-c-format
msgid "Fonts &amp; Colors"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2024
#, no-c-format
msgid "This section of the dialog lets you configure all fonts and colors in any color scheme you have, as well creating new schemes or deleting existing ones. Each scheme has settings for colors, fonts and normal and highlight text styles."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2030
#, no-c-format
msgid "&kappname; will preselect the currently active scheme for you, if you want to work on a different scheme start by selecting that from the <guilabel>Schema</guilabel> combobox. With the <guibutton>New</guibutton> and <guibutton>Delete</guibutton> button you can create a new scheme or delete existing ones."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2034
#, no-c-format
msgid "At the bottom of the page you can select the <guilabel>Default schema for &kappname;</guilabel>."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2037
#, no-c-format
msgid "Colors"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2041
#, no-c-format
msgid "Text Area Background"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2047
#, no-c-format
msgid "Normal text"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2048
#, no-c-format
msgid "This is the default background for the editor area, it will be the dominant color on the editor area."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2053
#, no-c-format
msgid "Selected text"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2054
#, no-c-format
msgid "This is the background for selected text. The default is the global selection color, as set in your &kde; color preferences."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2060
#, no-c-format
msgid "Current line"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2061
#, no-c-format
msgid "Set the color for the current line. Setting this a bit different from the Normal text background helps to keep focus on the current line."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2067
#, no-c-format
msgid "Bookmark"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2068
#, no-c-format
msgid "This combobox lets you set overlay colors for various mark types. The color is mixed into the background color of a marked line, so that a line with more marks or a marked line that is current has a background that is a mix of more colors. The mark colors are also used if you enable display of scrollbar marks."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2080
#, no-c-format
msgid "Additional Elements"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2084
#, no-c-format
msgid "Left border background"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2085
#, no-c-format
msgid "This color is used for the marks, line numbers and folding marker borders in the left side of the editor view when they are displayed."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2090
#, no-c-format
msgid "Line numbers"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2091
#, no-c-format
msgid "This color is used to draw the line numbers on the left side of the view when displayed."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2095
#, no-c-format
msgid "Bracket highlight"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2096
#, no-c-format
msgid "This color is used to draw the background of matching brackets."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2100
#, no-c-format
msgid "Word wrap markers"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2101
#, no-c-format
msgid "This color is used to draw a pattern to the left of dynamically wrapped lines when those are aligned vertically, as well as for the static word wrap marker."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2106
#, no-c-format
msgid "Tab and space markers"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2107
#, no-c-format
msgid "This color is used to draw white space indicators when enabled."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2111
#, no-c-format
msgid "Spelling mistake line"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2112
#, no-c-format
msgid "sets the color of the line that is used to indicate spelling mistakes."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2123
#, no-c-format
msgid "Fonts"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2124
#, no-c-format
msgid "Here you can choose the font for the schema. You can choose from any font available on your system, and set a default size. A sample text displays at the bottom of the dialog, so you can see the effect of your choices."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2132
#, no-c-format
msgid "Normal Text Styles"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2133
#, no-c-format
msgid "The normal text styles are inherited by the highlight text styles, allowing the editor to present text in a very consistent way, for example comment text is using the same style in almost all of the text formats that &kappname; can highlight."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2137 index.docbook:2152
#, no-c-format
msgid "The name in the list of styles is using the style configured for the item, providing you with an immediate preview when configuring a style."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2140
#, no-c-format
msgid "Each style lets you select common attributes as well as foreground and background colors. To unset a background color, rightclick to use the context menu."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2146
#, no-c-format
msgid "Highlighting Text Styles"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2147
#, no-c-format
msgid "Here you can edit the text styles used by a specific highlight definition. The editor preselects the highlight used by your current document. To work on a different highlight, select one in the <guilabel>Highlight</guilabel> combobox above the style list."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2155
#, no-c-format
msgid "Each style lets you select common attributes as well as foreground and background colors. To unset a background color, rightclick to use the context menu. In addition you can see if a style is equal to the default style used for the item, and set it to that if not."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2159
#, no-c-format
msgid "You will notice that many highlights contain other highlights represented by groups in the style list. For example most highlights import the Alert highlight, and many source code formats imports the Doxygen highlight. Editing colors in those groups only affects the styles when used in the edited highlight format."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2170
#, no-c-format
msgid "Editing"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2178
#, no-c-format
msgid "Static Word Wrap"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2179
#, no-c-format
msgid "Word wrap is a feature that causes the editor to automatically start a new line of text and move (wrap) the cursor to the beginning of that new line. &kappname; will automatically start a new line of text when the current line reaches the length specified by the <link linkend=\"pref-wrap-words-at\">Wrap Words At:</link> option."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2187
#, no-c-format
msgid "Enable static word wrap"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2189
#, no-c-format
msgid "Turns static word wrap on or off."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2193
#, no-c-format
msgid "Show static word wrap markers (if applicable)"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2204
#, no-c-format
msgid "Wrap words at:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2206
#, no-c-format
msgid "If the <link linkend=\"pref-word-wrap\">Enable static word wrap</link> option is selected this entry determines the length (in characters) at which the editor will automatically start a new line."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2216
#, no-c-format
msgid "Misc"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2220
#, no-c-format
msgid "Remove trailing spaces while editing"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2221
#, no-c-format
msgid "&kappname; will automatically eliminate extra spaces at the ends of lines of text."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2225
#, no-c-format
msgid "Auto brackets"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2225
#, no-c-format
msgid "When the user types a left bracket ([, (, or {) &kappname; automatically enters the right bracket (}, ), or ]) to the right of the cursor."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2231
#, no-c-format
msgid "Copy/Cut the current line if no selection"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2232
#, no-c-format
msgid "If this option is enabled and the text selection is empty, copy and cut action are performed for the line of text at the actual cursor position."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2237
#, no-c-format
msgid "Allow scrolling past the end of the document"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2238
#, no-c-format
msgid "This option lets you scroll past the end of the document. This can be used to vertically centre the bottom of the document, or put it on top of the current view."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2249
#, no-c-format
msgid "Cursor &amp; Selection"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2254
#, no-c-format
msgid "Text Cursor Movement"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2258
#, no-c-format
msgid "Smart home and smart end"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2260
#, no-c-format
msgid "When selected, pressing the home key will cause the cursor to skip white space and go to the start of a line's text."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2265
#, no-c-format
msgid "Wrap cursor"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2267
#, no-c-format
msgid "When on, moving the insertion cursor using the <emphasis role=\"bold\">Left</emphasis> and <emphasis role=\"bold\">Right</emphasis> keys will go on to previous/next line at beginning/end of the line, similar to most editors."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2270
#, no-c-format
msgid "When off, the insertion cursor cannot be moved left of the line start, but it can be moved off the line end, which can be very handy for programmers. When this option is chosen, moving the cursor with the arrow keys off the end of a line (to the right) causes it to jump down to the beginning of the next line. Likewise when the cursor is moved past the beginning of a line (to the left) it jumps up to the end of the preceding line. When this option is not selected, moving the cursor right past the end of a line merely causes it to continue horizontally in the same line and trying to move it left past the beginning does nothing."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2282
#, no-c-format
msgid "PageUp/PageDown moves cursor"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2284
#, no-c-format
msgid "This option changes the behavior of the cursor when the user presses the <keycap>Page Up</keycap> or <keycap>Page Down</keycap> key. If unselected the text cursor will maintain its relative position within the visible text in &kappname; as new text becomes visible as a result of the operation. So if the cursor is in the middle of the visible text when the operation occurs it will remain there (except when one reaches the beginning or end.) With this option selected, the first key press will cause the cursor to move to either the top or bottom of the visible text as a new page of text is displayed."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2295
#, no-c-format
msgid "Autocenter cursor (lines):"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2297
#, no-c-format
msgid "Sets the number of lines to maintain visible above and below the cursor when possible."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2306
#, no-c-format
msgid "Text Selection Mode"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2310
#, no-c-format
msgid "Normal"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2312
#, no-c-format
msgid "Selections will be overwritten by typed text and will be lost on cursor movement."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2317
#, no-c-format
msgid "Persistent"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2319
#, no-c-format
msgid "Selections will stay even after cursor movement and typing."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2330
#, no-c-format
msgid "Indentation"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2335
#, no-c-format
msgid "Default Indentation mode:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2337
#, no-c-format
msgid "Select the automatic indentation mode you want to use as default. It is strongly recommended to use <userinput>None</userinput> or <userinput>Normal</userinput> here, and use filetype configurations to set other indentation modes for text formats like C/C++ code or &XML;."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2345
#, no-c-format
msgid "Indent using"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2349
#, no-c-format
msgid "Tabulators"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2351
#, no-c-format
msgid "When this is enabled the editor will insert tabulator characters when you press the &Tab; key or use automatic indentation."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2356
#, no-c-format
msgid "Spaces"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2358
#, no-c-format
msgid "When this is enabled the editor will insert a calculated number of spaces according to the position in the text and the <option>tab-width</option> setting when you press the &Tab; key or use automatic indentation."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2364
#, no-c-format
msgid "Tabulators and Spaces"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2366
#, no-c-format
msgid "When this is enabled, the editor will insert spaces as describe above when indenting or pressing &Tab; at the beginning of a line, but insert tabulators when the &Tab; key is pressed in the middle or end of a line."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2372
#, no-c-format
msgid "Tab width:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2374
#, no-c-format
msgid "This configures the number of spaces that are displayed in place of a tabulator character."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2379
#, no-c-format
msgid "Indentation width:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2381
#, no-c-format
msgid "The indentation width is the number of spaces which is used to indent a line. If configured to indent using tabulators, a tabulator character is inserted if the indentation is divisible by the tab width."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2391
#, no-c-format
msgid "Indentation Properties"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2395
#, no-c-format
msgid "Keep Extra Spaces"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2396
#, no-c-format
msgid "If this option is disabled, changing the indentation level aligns a line to a multiple of the width specified in <guilabel>Indentation width</guilabel>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2401
#, no-c-format
msgid "Adjust indentation of code pasted from the clipboard"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2403
#, no-c-format
msgid "If this option is selected, pasted code from the clipboard is indented. Triggering the <guimenuitem>Undo</guimenuitem> action removes the indentation."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2412
#, no-c-format
msgid "Indentation Actions"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2416
#, no-c-format
msgid "Backspace key in leading blank space unindents"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2418
#, no-c-format
msgid "If this option is selected, the &Backspace; key decreases the indentation level if the cursor is located in the leading blank space of a line."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2423
#, no-c-format
msgid "Tab key action (if no selection exists)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2425
#, no-c-format
msgid "If you want &Tab; to align the current line in the current code block like in emacs, make &Tab; a shortcut to the action <guimenuitem>Align</guimenuitem>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2431
#, no-c-format
msgid "Always advance to the next tab position"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2433
#, no-c-format
msgid "If this option is selected, the &Tab; key always inserts white space so that the next tab position is reached. If the option <guilabel>Insert spaces instead of tabulators</guilabel> on the <guilabel>General</guilabel> tab in the <guilabel>Editing</guilabel> page is enabled, spaces are inserted; otherwise, a single tabulator is inserted."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2440
#, no-c-format
msgid "Always increase indentation level"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2442
#, no-c-format
msgid "If this option is selected, the &Tab; key always indents the current line by the number of character positions specified in <guilabel>Indentation width</guilabel>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2448
#, no-c-format
msgid "Increase indentation level if in leading blank space"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2450
#, no-c-format
msgid "If this option is selected, the &Tab; key either indents the current line or advances to the next tab position. If the insertion point is at or before the first non-space character in the line, or if there is a selection, the current line is indented by the number of character positions specified in <guilabel>Indentation width</guilabel>. If the insertion point is located after the first non-space character in the line and there is no selection, white space is inserted so that the next tab position is reached: if the option <guilabel>Insert spaces instead of tabulators</guilabel> on the <guilabel>General</guilabel> tab in the <guilabel>Editing</guilabel> page is enabled, spaces are inserted; otherwise, a single tabulator is inserted."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2474
#, no-c-format
msgid "Auto Completion"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2477 index.docbook:2508
#, no-c-format
msgid "<guilabel>General</guilabel>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2481
#, no-c-format
msgid "Auto Completion enabled"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2483
#, no-c-format
msgid "If enabled, a word completion box automatically pops up during typing showing a list of text entries to complete the current text under the cursor."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2493
#, no-c-format
msgid "Minimal word length to complete"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2494
#, no-c-format
msgid "While typing text, the word completion searches for words in the document starting with the already typed text. This option configures the minimal amount of characters that are needed to make the word completion active and pop up a completion box."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2505
#, no-c-format
msgid "Vi Input Mode"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2512
#, no-c-format
msgid "Use the VI Input mode"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2514
#, no-c-format
msgid "When selected, the vi input mode will be enabled when opening a new view. You can still toggle the vi input mode on/off for a particular view in the <guilabel>Edit</guilabel> menu."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2520
#, no-c-format
msgid "Let VI commands override Kate shortcuts"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2522
#, no-c-format
msgid "When selected, vi commands will override &kappname;'s built-in commands. For example: <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo> will redo, and override the standard action (showing the search and replace dialog)."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2528
#, no-c-format
msgid "Hide the VI mode status bar"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2530
#, no-c-format
msgid "By default, an extra status bar will be used when the Vi input mode is enabled. This status bar shows commands while they are being typed and messages/errors produced by Vi commands."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2533
#, no-c-format
msgid "Checking this option will hide this extra status line."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2540
#, no-c-format
msgid "Key Mapping"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2541
#, no-c-format
msgid "Key mapping is used to change the meaning of typed keys. This allows you to move commands to other keys or make special keypresses for doing a series of commands."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2545
#, no-c-format
msgid "Example:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2546
#, no-c-format
msgid "<keycap>F2</keycap> -> <keycap>I--</keycap> &Esc;"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2547
#, no-c-format
msgid "This will prepend <keycap>I--</keycap> to a line when pressing <keycap>F2</keycap>."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2556
#, no-c-format
msgid "Spellcheck"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2557
#, no-c-format
msgid "These configuration options are described in the documentation for the &systemsettings; module <ulink url=\"help:kcontrol/spellchecking\">Spell Checker</ulink>."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2564
#, no-c-format
msgid "Open/Save"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2572
#, no-c-format
msgid "File Format"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2577
#, no-c-format
msgid "Encoding:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2579
#, no-c-format
msgid "This defines the standard encoding to use to open/save files, if not changed in the open/save dialog or by using a command line option."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2585
#, no-c-format
msgid "Encoding Detection"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2587
#, no-c-format
msgid "Select an item from the drop down box, either to disable autodetection or use <guilabel>Universal</guilabel> to enable autodetection for all encodings. But as this may probably only detect utf-8/utf-16, selecting a region will use custom heuristics for better results. If neither the encoding chosen as standard above, nor the encoding specified in the open/save dialog, nor the encoding specified on command line match the content of the file, this detection will be run."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2598
#, no-c-format
msgid "Fallback Encoding"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2600
#, no-c-format
msgid "This defines the fallback encoding to try for opening files if neither the encoding chosen as standard above, nor the encoding specified in the open/ save dialog, nor the encoding specified on command line match the content of the file. Before this is used, an attempt will be made to determine the encoding to use by looking for a byte order marker at start of file: if one is found, the right unicode encoding will be chosen; otherwise encoding detection will run, if both fail fallback encoding will be tried."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2611
#, no-c-format
msgid "End of line:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2613
#, no-c-format
msgid "Choose your preferred end of line mode for your active document. You have the choice between &UNIX;, DOS/&Windows; or Macintosh."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2619
#, no-c-format
msgid "Automatic end of line detection"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2621
#, no-c-format
msgid "Check this if you want the editor to autodetect the end of line type. The first found end of line type will be used for the whole file."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2627
#, no-c-format
msgid "Enable byte order marker"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2629
#, no-c-format
msgid "The byte order mark is a special sequence at the beginning of unicode encoded documents. It helps editors to open text documents with the correct unicode encoding. For more information see <ulink url=\"http://en.wikipedia.org/wiki/Byte_Order_Mark\">Byte Order Mark</ulink>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2641
#, no-c-format
msgid "Automatic Cleanups on Load/Save"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2645
#, no-c-format
msgid "Remove trailing spaces"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2647
#, no-c-format
msgid "The editor will automatically eliminate extra spaces at the ends of lines of text while loading/saving the file."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2659
#, no-c-format
msgid "<title>Advanced</title>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2663
#, no-c-format
msgid "Folder Config File"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2667
#, no-c-format
msgid "Search depth for config file:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2669
#, no-c-format
msgid "The editor will search the given number of folder levels upwards for &kappname; config file and load the settings line from it. Further information about these hidden folder config files you find in the article <ulink url=\"http://kate-editor.org/article/.kateconfig\">The File .kateconfig</ulink>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2680
#, no-c-format
msgid "Backup on Save"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2681
#, no-c-format
msgid "Backing up on save will cause &kappname; to copy the disk file to &lt;prefix&gt;&lt;filename&gt;&lt;suffix&gt; before saving changes. The suffix defaults to <emphasis role=\"bold\">~</emphasis> and prefix is empty by default."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2687
#, no-c-format
msgid "Local files"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2689
#, no-c-format
msgid "Check this if you want backups of local files when saving."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2694
#, no-c-format
msgid "Remote files"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2696
#, no-c-format
msgid "Check this if you want backups of remote files when saving."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2700
#, no-c-format
msgid "Prefix"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2702
#, no-c-format
msgid "Enter the prefix to prepend to the backup file names."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2706
#, no-c-format
msgid "Suffix"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2708
#, no-c-format
msgid "Enter the suffix to add to the backup file names."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2712
#, no-c-format
msgid "Disable swap file syncing"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2714
#, no-c-format
msgid "&kappname; is able to recover (most of) what was written after last save in case of a crash or power failure. A swap file (.swp.&lt;filename&gt;) is created after the first editing action on a document. If the user doesn’t save the changes and &kappname; crashes, the swap file remains on the disk. When opening a file, &kappname; checks if there is a swap file for the document and if it is, it asks the user whether he wants to recover the lost data or not. The user has the possibility to view the differences between the original file and the recovered one, too. The swap file is deleted after every save and on normal exit."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2722
#, no-c-format
msgid "&kappname; syncs the swap files on the disk every 15 seconds, but only if they have changed since the last sync. The user can disable the swap files syncing if he wants, by checking the <guilabel>Disable swap file syncing</guilabel> box, but this can lead to more data loss."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2737
#, no-c-format
msgid "Modes &amp; Filetypes"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2738
#, no-c-format
msgid "This page allows you to override the default configuration for documents of specified mimetypes. When the editor loads a document, it will try if it matches the file masks or mimetypes for one of the defined filetypes, and if so apply the variables defined. If more filetypes match, the one with the highest priority will be used."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2746
#, no-c-format
msgid "Filetype:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2747 index.docbook:2767
#, no-c-format
msgid "The filetype with the highest priority is the one displayed in the first drop down box. If more filetypes were found, they are also listed."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2752
#, no-c-format
msgid "<guilabel>New</guilabel>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2753
#, no-c-format
msgid "This is used to create a new filetype. After you click on this button, the fields below get empty and you can fill the properties you want for the new filetype."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2758
#, no-c-format
msgid "<guilabel>Delete</guilabel>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2759
#, no-c-format
msgid "To remove an existing filetype, select it from the drop down box and press the Delete button."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2766
#, no-c-format
msgid "Properties of <replaceable>current filetype</replaceable>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2772
#, no-c-format
msgid "Name:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2773
#, no-c-format
msgid "The name of the filetype will be the text of the corresponding menu item. This name is displayed in the <menuchoice><guimenu>Tools</guimenu><guimenuitem>Filetypes</guimenuitem> </menuchoice>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2779
#, no-c-format
msgid "Section:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2780
#, no-c-format
msgid "The section name is used to organize the file types in menus. This is also used in the <menuchoice><guimenu>Tools</guimenu><guimenuitem>Filetypes</guimenuitem> </menuchoice> menu."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2786
#, no-c-format
msgid "Variables:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2787
#, no-c-format
msgid "This string allows you to configure &kappname;'s settings for the files selected by this mimetype using &kappname; variables. You can set almost any configuration option, such as highlight, indent-mode, etc."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2790
#, no-c-format
msgid "For a full list of known variables, see the manual."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2794
#, no-c-format
msgid "Highlighting:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2795
#, no-c-format
msgid "If you create a new file type, this drop down box allows you to select a filetype for highlighting."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2800
#, no-c-format
msgid "Indentation Mode:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2801
#, no-c-format
msgid "The drop down box specifies the indentation mode for new documents."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2806
#, no-c-format
msgid "File extensions:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2807
#, no-c-format
msgid "The wildcards mask allows you to select files by filename. A typical mask uses an asterisk and the file extension, for example <filename>*.txt; *.text</filename>. The string is a semicolon-separated list of masks."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2813
#, no-c-format
msgid "MIME types:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2814
#, no-c-format
msgid "Displays a wizard that helps you easily select mimetypes."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2818
#, no-c-format
msgid "Priority:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2819
#, no-c-format
msgid "Sets a priority for this file type. If more than one file type selects the same file, the one with the highest priority will be used."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: index.docbook:2826
#, no-c-format
msgid "Download Highlighting Files..."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2828
#, no-c-format
msgid "Click this button to download new or updated syntax highlight descriptions from the &kate; website."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2841
#, no-c-format
msgid "Extensions"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2842
#, no-c-format
msgid "The <guilabel>Plugins</guilabel> tab lists all available plugins and you can check those you want to use. Click on the <guibutton>Information</guibutton> button to open the <guilabel>About</guilabel> dialog of this plugin."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2845
#, no-c-format
msgid "Once a configurable plugin is checked, the <guibutton>Configure</guibutton> button is enabled and you can click it in order to configure the highlighted plugin."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:2849
#, no-c-format
msgid "Editor Component Plugins"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2858
#, no-c-format
msgid "AutoBrace"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2859
#, no-c-format
msgid "The autobrace plugin supersedes the &kappname; internal <quote>Auto Brackets</quote> feature. It automatically inserts a closing brace <keycap>}</keycap> at the beginning of the next line after ending a line with an opening one <keycap>{</keycap> and pressing the &Enter; key."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2871
#, no-c-format
msgid "Data Tools"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2872
#, no-c-format
msgid "Enables data tools like thesaurus and spell check (if installed). Data tools are only available when text is selected, or when the right mouse button is clicked over a word. If no data tools are offered even when text is selected, you need to install them. Some data tools are part of the &koffice; package. If this plugin is enabled and data tools are installed, additional items appear at the end of the context menu."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2881
#, no-c-format
msgid "Exporter"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2882
#, no-c-format
msgid "This command allows you to export the current document with all highlighting information into a HTML document using <menuchoice><guimenu>File</guimenu><guimenuitem>Export as HTML</guimenuitem></menuchoice>. Additionally you can use <menuchoice><guimenu>Edit</guimenu> <guimenuitem>Copy as HTML</guimenuitem></menuchoice> to copy the currently selected text as HTML to the system clipboard."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2889
#, no-c-format
msgid "IconInserter"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2890
#, no-c-format
msgid "The icon inserter plugin is only of use for &kde; developers: It adds an item <guimenuitem>Insert KIcon-Code</guimenuitem> into the context menu of the editor. If activated, the &kde;'s icon chooser opens (showing application icons, action icons &etc;..). If you click on it, the file name without file extension will be inserted as text. Useful only for setting icons via &kde;'s framework through the KIcon() class."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2898
#, no-c-format
msgid "Insane (not ZEN) HTML coding (light edition)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2899
#, no-c-format
msgid "A plugin, which does zen-coding like selector completion. For more information see <ulink url=\"http://en.wikipedia.org/wiki/Zen_Coding\"> Zen Coding</ulink>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: index.docbook:2905
#, no-c-format
msgid "Insert File"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:2906
#, no-c-format
msgid "This plugin allows you to insert any readable file at the cursor position. If enabled, the <guimenu>Tools</guimenu> menu has an additional menu item <guimenuitem>Insert File</guimenuitem>."
msgstr ""

