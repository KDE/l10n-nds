#. Tag: term
#. +> trunk stable
#: index.docbook:1656
#, no-c-format
msgid "<menuchoice> <shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>D</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uncomment</guimenuitem> </menuchoice> (Power user mode)"
msgstr ""

