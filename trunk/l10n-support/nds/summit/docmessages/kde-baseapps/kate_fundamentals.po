#. Tag: keycap
#. +> trunk stable
#: fundamentals.docbook:452
#, no-c-format
msgid "<keycap>F3</keycap>"
msgstr ""

#. Tag: link
#. +> trunk stable
#: fundamentals.docbook:453
#, no-c-format
msgid "Find again"
