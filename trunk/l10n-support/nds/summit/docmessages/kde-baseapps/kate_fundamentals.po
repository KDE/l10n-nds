#. +> trunk stable
#: fundamentals.docbook:495
#, no-c-format
msgid "&Ctrl;<keycap>Z</keycap>"
msgstr ""

#. Tag: link
#. +> trunk stable
#: fundamentals.docbook:496
#, no-c-format
msgid "Undo"
msgstr "Torüchnehmen"

