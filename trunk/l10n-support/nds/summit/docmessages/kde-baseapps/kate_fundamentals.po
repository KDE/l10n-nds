msgstr ""

#. Tag: term
#. +> trunk stable
#: fundamentals.docbook:612
#, no-c-format
msgid "What's This Help"
msgstr ""

#. Tag: para
#. +> trunk stable
#: fundamentals.docbook:614
#, no-c-format
msgid "What's This help offers immediate help with single elements of graphical windows, such as buttons or other window areas."
msgstr ""

#. Tag: para
#. +> trunk stable
#: fundamentals.docbook:617
#, no-c-format
msgid "We strive to provide What's This help for any elements for which it makes sense. It is available throughout the configuration dialog, and in many other dialogs as well."
msgstr ""

#. Tag: para
#. +> trunk stable
#: fundamentals.docbook:621
#, no-c-format
msgid "To employ What's This help, press <keycombo action=\"simul\">&Shift;<keycap>F1</keycap></keycombo> or use the <menuchoice><guimenu>Help</guimenu><guimenuitem>What's This</guimenuitem></menuchoice> menu item to enable What's This mode. The cursor will turn into an arrow with a question mark, and you can now click any element in the window to read the What's This help for that element, if it is available."
msgstr ""

#. Tag: term
#. +> trunk stable
#: fundamentals.docbook:632
#, no-c-format
msgid "Help Buttons in Dialogs"
msgstr ""

#. Tag: para
#. +> trunk stable
#: fundamentals.docbook:634
#, no-c-format
msgid "Some dialogs have a <guibutton>Help</guibutton> Button. Pressing it will start the &khelpcenter; and open the relevant documentation."
msgstr ""

