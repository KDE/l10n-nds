#. +> trunk stable
#: fundamentals.docbook:491
#, no-c-format
msgid "&Ctrl;<keycap>X</keycap>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: fundamentals.docbook:492
#, no-c-format
msgid "Delete the marked text and copy it to the clipboard."
msgstr ""

