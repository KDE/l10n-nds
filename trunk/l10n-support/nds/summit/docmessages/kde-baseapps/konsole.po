#: index.docbook:1029
#, no-c-format
msgid "Pressing &Ctrl; while selecting text will cause lines breaks to be converted to spaces when pasted."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1033
#, no-c-format
msgid "Pressing the <keycombo action=\"simul\">&Ctrl;&Alt;</keycombo> keys while selecting text will select columns."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1037
#, no-c-format
msgid "When a program evaluates either mouse button, pressing the &Shift; key will allow the popup menu to appear."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1041
#, no-c-format
msgid "The <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>F10</keycap></keycombo> shortcut will activate the menu."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1045
#, no-c-format
msgid "The <keycombo action=\"simul\">&Shift;<keycap>Insert</keycap></keycombo> keys will insert the clipboard."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1049
#, no-c-format
msgid "Double-clicking will select a whole word. Continuing to hold the mouse button and moving the mouse will extend the selection."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1053
#, no-c-format
msgid "Triple-clicking will select a whole line. Continuing to hold the mouse button and moving the mouse will extend the selection."
msgstr ""

#. Tag: title
#. +> trunk stable
#: index.docbook:1063
#, no-c-format
msgid "Common Issues"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1066
#, no-c-format
msgid "By default when started from a terminal, &konsole; will run in the background. Use <option>--nofork</option> to force &konsole; to run in the foreground."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1070
#, no-c-format
msgid "This is needed for some scripts and commands to work as expected:"
msgstr ""

#. Tag: command
#. +> trunk stable
#: index.docbook:1075
#, no-c-format
msgid "konsole --nofork -e sleep 3 ; echo 1"
msgstr ""

#. Tag: command
#. +> trunk stable
#: index.docbook:1079
#, no-c-format
msgid "kdesu -u kdeuser konsole --nofork"
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1086
#, no-c-format
msgid "In KDE3, each tab had its own process ID. However, in KDE4, all the tabs use the same process ID. This has the side-effect that if one tab's process has issues, all the other tabs may experience issues as well."
msgstr ""

#. Tag: para
#. +> trunk stable
#: index.docbook:1089
#, no-c-format
msgid "This is most noticeable when a command that connects to an external device or system (ssh, nfs) has issues."
msgstr ""

