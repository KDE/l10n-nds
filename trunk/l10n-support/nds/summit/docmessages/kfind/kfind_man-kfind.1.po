#. +> trunk stable
#: man-kfind.1.docbook:46
#, no-c-format
msgid "Options"
msgstr "Optschonen"

#. Tag: option
#. +> trunk stable
#: man-kfind.1.docbook:49
#, no-c-format
msgid "searchpath"
msgstr ""

#. Tag: para
#. +> trunk stable
#: man-kfind.1.docbook:50
#, no-c-format
msgid "You may optionally supply a colon separated path to prefill the dialog. You might use this ability to set up different icons on your panel or desktop to quickly run searches in different locations."
msgstr ""

