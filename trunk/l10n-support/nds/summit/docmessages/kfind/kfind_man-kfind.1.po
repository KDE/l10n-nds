#. Tag: title
#. +> trunk stable
#: man-kfind.1.docbook:34
#, no-c-format
msgid "Description"
msgstr "Beschrieven"

#. Tag: para
#. +> trunk stable
#: man-kfind.1.docbook:35
#, no-c-format
msgid "The Find Files tool is a useful method of searching for specific files on your computer, or for searching for files that match a pattern. An example of this could include searching for files of a particular type or with certain letters in the filename, or that contain a certain piece of text in their contents."
msgstr ""

#. Tag: para
#. +> trunk stable
#: man-kfind.1.docbook:40
#, no-c-format
msgid "&kfind; is a graphical tool, and not normally run from the command line."
msgstr ""

