#. Tag: title
#. +> trunk
#: index.docbook:119
#, no-c-format
msgid "Using &skanlite;"
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:122
#, no-c-format
msgid "Scanner Selection"
msgstr "Bildinleser-Utwahl"

#. Tag: para
#. +> trunk
#: index.docbook:123
#, no-c-format
msgid "A default scanner can be specified on the command line of &skanlite; using <userinput>skanlite -d [device name]</userinput> in a terminal. If the selected scanner cannot be opened or if no default scanner is provided, a scanner selection dialog is opened."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:127
#, no-c-format
msgid "<screeninfo>&skanlite; scanner selection dialog</screeninfo>"
msgstr ""

#. Tag: phrase
#. +> trunk
#: index.docbook:133
#, no-c-format
msgid "<phrase>&skanlite; scanner selection dialog</phrase>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:138
#, no-c-format
msgid "The user can choose the scanner to be used and press <guibutton>OK</guibutton> to open the scanner. Pressing <guibutton>Cancel</guibutton> will cause &skanlite; to exit."
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:145
#, no-c-format
msgid "&skanlite; Main Window"
msgstr "&skanlite;-Hööftfinster"

#. Tag: screeninfo
#. +> trunk
#: index.docbook:147
#, no-c-format
msgid "<screeninfo>&skanlite; main window</screeninfo>"
msgstr "<screeninfo>&skanlite;-Hööftfinster</screeninfo>"

#. Tag: phrase
#. +> trunk
#: index.docbook:153
#, no-c-format
msgid "<phrase>&skanlite; main window</phrase>"
msgstr "<phrase>&skanlite;-Hööftfinster</phrase>"

#. Tag: para
#. +> trunk
#: index.docbook:158
#, no-c-format
msgid "In the main window, the user has two sets of scan options: <guilabel>Basic Options</guilabel> and <guilabel>Scanner Specific Options</guilabel>. The <guilabel>Basic Options</guilabel> tab contains the most common parameters that the SANE scanner backends provide, while the <guilabel>Scanner Specific Options</guilabel> tab contains all the options of the backend. The options listed here depend on SANE support for your driver: libksane (which &skanlite; uses) should be able to display most of the types of parameters that SANE provides (analog gamma tables are not supported at this time)."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:163
#, no-c-format
msgid "<screeninfo>Scanner Specific Options tab</screeninfo>"
msgstr "<screeninfo>Paneel \"Inleser-egen Optschonen\"</screeninfo>"

#. Tag: phrase
#. +> trunk
#: index.docbook:169
#, no-c-format
msgid "<phrase>Scanner Specific Options tab</phrase>"
msgstr "<phrase>Paneel \"Inleser-egen Optschonen\"</phrase>"

#. Tag: para
#. +> trunk
#: index.docbook:174
#, no-c-format
msgid "The scanner specific options contains more detailed options of the backends. &skanlite; (libksane) does not have any special handling for these options."
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:179
#, no-c-format
msgid "Scanning"
msgstr "Bildinlesen"

#. Tag: para
#. +> trunk
#: index.docbook:180
#, no-c-format
msgid "To scan an image, the user can start with a preview scan and then select the part of the scan area to do the final scan on. The preview scan is started by pressing the preview button."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:185
#, no-c-format
msgid "<screeninfo>The Preview Button</screeninfo>"
msgstr "<screeninfo>De Vöransicht-Knoop</screeninfo>"

#. Tag: phrase
#. +> trunk
#: index.docbook:191
#, no-c-format
msgid "<phrase>The Preview Button</phrase>"
msgstr "<phrase>De Vöransicht-Knoop</phrase>"

#. Tag: para
#. +> trunk
#: index.docbook:196
#, no-c-format
msgid "When the preview is scanned the area for the final image can be selected."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:200
#, no-c-format
msgid "<screeninfo>Selection and zoom</screeninfo>"
msgstr "<screeninfo>Köör un Ansichtgrött</screeninfo>"

#. Tag: phrase
#. +> trunk
#: index.docbook:206
#, no-c-format
msgid "<phrase>Selection and zoom</phrase>"
msgstr "<phrase>Köör un Ansichtgrött</phrase>"

#. Tag: para
#. +> trunk
#: index.docbook:210
#, no-c-format
msgid "To better select the image the user can zoom in, out, to the current selection or zoom to fit the whole preview to the window."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:214
#, no-c-format
msgid "<screeninfo>The \"zoom to fit\" button</screeninfo>"
msgstr ""

#. Tag: phrase
#. +> trunk
#: index.docbook:220
#, no-c-format
msgid "<phrase>The \"zoom to fit\" button</phrase>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:224
#, no-c-format
msgid "When the image is selected the final image can be acquired by pressing the final scan button."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:229
#, no-c-format
msgid "<screeninfo>The final scan button</screeninfo>"
msgstr ""

#. Tag: phrase
#. +> trunk
#: index.docbook:235
#, no-c-format
msgid "<phrase>The final scan button</phrase>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:240
#, no-c-format
msgid "You will see the progress of the scan."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:244
#, no-c-format
msgid "<screeninfo>Scanning in progress</screeninfo>"
msgstr ""

#. Tag: phrase
#. +> trunk
#: index.docbook:250
#, no-c-format
msgid "<phrase>Scanning in progress</phrase>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:255
#, no-c-format
msgid "If <guilabel>Preview before saving</guilabel> is selected in the settings, the scanned image is displayed in a preview window as you can see below on the screenshot. If <guibutton>Save</guibutton> is pressed, the image is saved and if <guibutton>Close</guibutton> is pressed the preview is discarded and you return to the main window."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:259
#, no-c-format
msgid "<screeninfo>The Preview Window</screeninfo>"
msgstr ""

#. Tag: phrase
#. +> trunk
#: index.docbook:265
#, no-c-format
msgid "<phrase>The Preview Window</phrase>"
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:272
#, no-c-format
msgid "Scanning Multiple Selections"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:273
#, no-c-format
msgid "Sometimes you need only certain parts of an image. Instead of scanning the whole picture and then using a graphics application (&eg; &kolourpaint;) to save the different image parts into separate files, use &skanlite;'s multiple selection feature."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:280
#, no-c-format
msgid "<screeninfo>Multiple Selections</screeninfo>"
msgstr ""

#. Tag: phrase
#. +> trunk
#: index.docbook:286
#, no-c-format
msgid "<phrase>Multiple Selections</phrase>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:290
#, no-c-format
msgid "Scan a preview and then use the &LMB; to select the first part of the image in the preview. Hoover the selected area with mouse cursor and click on the green <guiicon>+</guiicon> icon to select the area. Selected areas are indicated by a red border. Now select the next parts of the image in the same way."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:294
#, no-c-format
msgid "To remove a single selection hoover the area with the mouse cursor and click on the red <guiicon>-</guiicon> icon. With <guilabel>Clear Selections</guilabel> from the context menu launched with the &RMB; all selections in a preview can be removed."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:298
#, no-c-format
msgid "If you placed two separate images or photos on you scanner and started a preview &skanlite; automatically preselect the different areas. This behavour can be switched off in the settings dialog."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:301
#, no-c-format
msgid "If you are satisfied with your choice starting the final batch scan of all selections. The images are saved using the batch renaming feature described in the settings dialog."
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:307
#, no-c-format
msgid "&skanlite; settings"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:308
#, no-c-format
msgid "By clicking the <guibutton>Settings</guibutton> button, the settings dialog is brought up before the main window. You can choose the most important settings here."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:313
#, no-c-format
msgid "Here's a screenshot of &skanlite; settings dialog"
msgstr ""

#. Tag: phrase
#. +> trunk
#: index.docbook:319
#, no-c-format
msgid "&skanlite; settings dialog"
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:326
#, no-c-format
msgid "Preview before saving:"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:327
#, no-c-format
msgid "The user can chose to preview the image before saving. In this case the <guilabel>Preview before saving</guilabel> option can be left checked. If the user does not want to preview the image this option should then be unchecked."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:331
#, no-c-format
msgid "Save Mode:"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:332
#, no-c-format
msgid "This setting allows you to choose how &skanlite; will save the images. If you choose <guilabel>Open the save dialog for every image</guilabel> then the save dialog will be opened for every scanned image. If you prefer &skanlite; to auto-save (by auto-generating a name and saving the image in a predefined folder) then you can choose <guilabel>Save without asking for a filename</guilabel> or <guilabel>Open the save dialog for the first image only</guilabel>."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:337
#, no-c-format
msgid "Save Location:"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:338
#, no-c-format
msgid "This setting defines where the images should be saved when <guilabel>Save without asking for a filename</guilabel> is chosen in the previous option. If the save dialog is to be opened for every image the default save location for the dialog will be the same as this parameter. The default save location is your home folder and you can change this location by clicking on the <guibutton>...</guibutton> button."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:343
#, no-c-format
msgid "Name Format:"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:344
#, no-c-format
msgid "This parameter defines the image prefix for the auto-saved images and is also the suggested name for the image in the save dialog. The auto-saved image will have a numeric suffix (the ### will be replaced by numbers) that is increased every time an image is saved."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:345
#, no-c-format
msgid "You can also choose the save format of the file, default is png."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:348
#, no-c-format
msgid "Specify save quality:"
msgstr "Gööd för't Sekern angeven:"

#. Tag: para
#. +> trunk
#: index.docbook:349
#, no-c-format
msgid "The user can chose to specify the image quality to be used for saving the images. The image quality setting affects the compression level used for saving. If <guilabel>Specify save quality</guilabel> is not checked, the quality is the default value chosen by &Qt;."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:359
#, no-c-format
msgid "Disable automatic selections"
msgstr "Automaatsche Köör utmaken"

#. Tag: para
#. +> trunk
#: index.docbook:360
#, no-c-format
msgid "After a preview, libksane does try to automatically select the images in the preview and should batch scan the selected areas. If you have enabled this option and place two photos on the scanner and do a preview, &skanlite; will automatically add selections of the photos."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:365
#, no-c-format
msgid "If on the other hand you are usually scanning documents it might be that the automatic selection will select a lot of different parts in the documents and you have to manually remove the selections. To avoid that disable this option."
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:380
#, no-c-format
msgid "Help, About, Settings and Close"
msgstr "\"Hülp\", \"Vertell wat över\", \"Instellen\" un \"Tomaken\""

#. Tag: para
#. +> trunk
#: index.docbook:381
#, no-c-format
msgid "At the bottom of the main window you find the <guibutton>Help</guibutton>, <guibutton>About</guibutton>, <guibutton>Settings</guibutton> and <guibutton>Close</guibutton> buttons."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:385
#, no-c-format
msgid "<screeninfo>The Main Window Buttons</screeninfo>"
msgstr ""

#. Tag: phrase
#. +> trunk
#: index.docbook:391
#, no-c-format
msgid "<phrase>The Main Window Buttons</phrase>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:396
#, no-c-format
msgid "The <guibutton>Help</guibutton> button brings up the &kde; Help center with the &skanlite; manual. The <guibutton>About</guibutton> button brings up the &kde; About dialog for &skanlite;. The <guibutton>Settings</guibutton> button displays the settings dialog and the <guibutton>Close</guibutton> button is used to exit &skanlite;."
msgstr ""

