#. Tag: title
#. +> trunk stable
#: plugins.docbook:17
#, no-c-format
msgid "&Netscape; Plugins"
msgstr "&Netscape;-Modulen"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:19
#, no-c-format
msgid "Currently, &konqueror; supports &Netscape; plugins."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:21
#, no-c-format
msgid "Selecting <menuchoice><guimenu>Settings</guimenu><guimenuitem> Configure Konqueror...</guimenuitem> </menuchoice> opens the configuration dialog. Select the <guilabel>Plugins</guilabel> page, where you find two tabs; <guilabel>Global Settings</guilabel> to enable plugins and configure how they are used in &konqueror; and the <guilabel>Plugins</guilabel> which shows you the &Netscape; plugins that &kde; has found and allows you to scan for plugins."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:30
#, no-c-format
msgid "For more information see the <ulink url=\"help:/kcontrol/khtml-plugins/index.html\"> Browser Plugins</ulink> help page."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:36
#, no-c-format
msgid "&konqueror; Plugins"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:38
#, no-c-format
msgid "&kde; releases several useful plugins that interact with &konqueror; in various ways. These are explained briefly below."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:41
#, no-c-format
msgid "Use <menuchoice><guimenu>Settings</guimenu><guimenuitem>Configure Extensions...</guimenuitem></menuchoice> to open a dialog with all installed plugins and select the ones you need. All plugins are accessible in the <guimenu>Tools</guimenu> menu."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:45
#, no-c-format
msgid "Only plugins appropriate for the current mode (file manager or browser) are listed in the dialog."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:49
#, no-c-format
msgid "Browser Mode"
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:51
#, no-c-format
msgid "Web Page Translation"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:52
#, no-c-format
msgid "This uses the machine translation service provided by <ulink url=\"http://babelfish.yahoo.com/\">Yahoo's BabelFish site</ulink> to translate the current <acronym>HTML</acronym> page to whatever language you want (within reason). It can be launched with <menuchoice><guimenu>Tools</guimenu><guisubmenu>Translate Web Page</guisubmenu></menuchoice>."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:57
#, no-c-format
msgid "If you have a portion of the text on the page selected, that will be translated instead of the entire &URL;."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:60
#, no-c-format
msgid "Not all languages are available from the Babelfish service."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:63
#, no-c-format
msgid "Machine translation is not a perfect science! Babelfish will at best give you a rough translation, and at worst will give you a very funny read. Don't base important decisions on things you have read from a Babelfish translated page, without confirming that the translation is indeed accurate."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:71
#, no-c-format
msgid "You may only translate web pages that are accessible on the world wide web. To translate any other text, you should go directly to the Babelfish site itself, where you are able to paste in text for translation."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:80
#, no-c-format
msgid "DOM Tree Viewer"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:82
#, no-c-format
msgid "The <acronym>DOM</acronym> Tree Viewer allows a developer to view the styles, attributes and elements of a web document."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:84
#, no-c-format
msgid "Selecting <menuchoice><guimenu>Tools</guimenu><guisubmenu>Show DOM Tree</guisubmenu></menuchoice> opens a new window which displays the document object model (DOM) of the current <acronym>HTML</acronym> page."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:88
#, no-c-format
msgid "By default the display starts at the root node of the document, example: <quote>documentElement</quote>, all other nodes that you will see are children or descendants of the root node."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:89
#, no-c-format
msgid "If you wish to manipulate the <acronym>DOM</acronym> tree in any way you will have to use an external script to do so."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:94
#, no-c-format
msgid "Web Page Validator"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:96
#, no-c-format
msgid "This plugin uses the W3C HTML validator to validate the current page, very useful when creating web pages."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:101
#, no-c-format
msgid "<guimenuitem>Validate &HTML; (by URI)</guimenuitem> / <guimenuitem>Validate &HTML; (by Upload)</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:102
#, no-c-format
msgid "The validate &HTML; option allows you to compare your &HTML; document to the defined syntax of &HTML; and reports any errors found. Validating your &HTML; will ensure that your pages display properly on all browsers."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:106
#, no-c-format
msgid "Validate CSS (by URI)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:107
#, no-c-format
msgid "Allows you to validate your &CSS; style sheet that is embedded in an &HTML; or &XHTML; document. Having valid &CSS; is critical to ensuring that your web site maintains a consistent look regardless of the browser that is being used."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:112
#, no-c-format
msgid "Validate Links"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:113
#, no-c-format
msgid "Allows you to confirm that the links on your site contain no redirects or broken links. This tool recursively checks all links on a site."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:117
#, no-c-format
msgid "Validate Page"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:118
#, no-c-format
msgid "Validates the current page but does not show the result in another window or tab as the previous actions. Using this item enables the action <guimenuitem>View Validator Report</guimenuitem> to display a summary of the validation."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:123
#, no-c-format
msgid "Configure Validator"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:124
#, no-c-format
msgid "The configure validator item allows you to view the preset validators you can use to validate your &HTML; and &CSS;."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:132
#, no-c-format
msgid "HTML Settings"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:133
#, no-c-format
msgid "Select <menuchoice><guimenu>Tools</guimenu><guisubmenu>HTML Settings</guisubmenu></menuchoice> to enable or disable a number of HTML settings without going through the <guimenu>Settings</guimenu> dialog."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:139
#, no-c-format
msgid "JavaScript"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:140
#, no-c-format
msgid "Allows you to turn the use of JavaScript in &konqueror; on or off."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:144
#, no-c-format
msgid "Java"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:145
#, no-c-format
msgid "Allows you to turn the use of &Java; in &konqueror; on or off."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:149
#, no-c-format
msgid "Cookies"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:150
#, no-c-format
msgid "Allows you to turn the use of Cookies in &konqueror; on or off."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:154
#, no-c-format
msgid "<guimenuitem>Plugins</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:155
#, no-c-format
msgid "Allows you to turn the use of the &konqueror; plugins you have installed on or off."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:159
#, no-c-format
msgid "Autoload Images"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:160
#, no-c-format
msgid "Allows you to turn on or off the loading of images in web pages."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:164
#, no-c-format
msgid "Enable Proxy"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:165
#, no-c-format
msgid "Allows you to enable or disable the use of a proxy in the &konqueror; browser."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:169
#, no-c-format
msgid "Enable Cache"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:170
#, no-c-format
msgid "Allows you to enable or disable the use of cache in the &konqueror; browser."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:174
#, no-c-format
msgid "Cache Policy"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:176
#, no-c-format
msgid "The Cache Policy submenu provides you with a way to configure the how &konqueror; uses cache. The possible uses include:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:179
#, no-c-format
msgid "Keep Cache in Sync"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:180
#, no-c-format
msgid "Use Cache if Possible"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:181
#, no-c-format
msgid "Offline Browsing Mode"
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:191
#, no-c-format
msgid "User Agent Changer"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:192
#, no-c-format
msgid "Select <menuchoice><guimenu>Tools</guimenu><guisubmenu>Change Browser Identification</guisubmenu></menuchoice> to get a menu that allows you to change the User Agent string without going through the <guimenu>Settings </guimenu> dialog procedure."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:197
#, no-c-format
msgid "The plugin allows you to change the Browser and Operating System identification on a domain-by-domain basis. This is useful when browsing websites that limit access to those using a particular web browser."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:203
#, no-c-format
msgid "Default Identification"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:204
#, no-c-format
msgid "The default User Agent header for &konqueror; is Mozilla/5.0(compatible;Konqueror/4.7)(KHTML/4.7, like Gecko). If you come across a site that refuses this browser access, change your User Agent to one of the options below."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:208
#, no-c-format
msgid "Browser submenu"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:209
#, no-c-format
msgid "The following menu items show a lot of popular browsers like <guimenuitem>Firefox</guimenuitem>, <guimenuitem>Internet Explorer</guimenuitem>, <guimenuitem>Netscape Navigator</guimenuitem>, <guimenuitem>Opera</guimenuitem>, <guimenuitem>Other</guimenuitem>, and <guimenuitem>Safari</guimenuitem>."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:217
#, no-c-format
msgid "Apply To Entire Site"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:218
#, no-c-format
msgid "This option allows you to specify that the defined User Agent applies across every page on the site you are visiting."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:222
#, no-c-format
msgid "Configure"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:223
#, no-c-format
msgid "Selecting <guimenuitem>Configure</guimenuitem> opens the settings dialog and allows you to fine tune the amount of information you wish to reveal about the browser and operating system being used."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:231
#, no-c-format
msgid "Archive Web Page"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:232
#, no-c-format
msgid "Invoked with <menuchoice><guimenu>Tools</guimenu><guisubmenu> Archive Web Page</guisubmenu></menuchoice>, this tool creates an archive (<literal role=\"extension\">.war</literal> ) file containing the web page being viewed including the images. <mousebutton>Left</mousebutton> click on the archive file name to view the saved page."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:243
#, no-c-format
msgid "File Manager Mode"
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:247
#, no-c-format
msgid "Folder View Filter"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:248
#, no-c-format
msgid "This is controlled by <menuchoice><guimenu>Tools</guimenu><guisubmenu>View Filter</guisubmenu></menuchoice> and allows you to choose which types of item are displayed in a folder."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:255
#, no-c-format
msgid "Image Gallery"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:256
#, no-c-format
msgid "In File Manager mode, you can select <menuchoice><guimenu>Tools</guimenu><guisubmenu>Create Image Gallery</guisubmenu></menuchoice> or use <keycombo>&Ctrl;<keycap>I</keycap></keycombo> to create an HTML page with thumbnails of all the images in the current folder. By default the HTML page is called <filename>images.html</filename> and the thumbnails are put into a new <filename>images</filename> folder."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:262
#, no-c-format
msgid "When you start the Image Gallery plugin a dialog opens allowing you to adjust the way the gallery is created."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:266
#, no-c-format
msgid "Page Look"
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:268
#, no-c-format
msgid "The Look dialog is for adjusting the appearance of the gallery page."
msgstr ""

#. Tag: screeninfo
#. +> trunk stable
#: plugins.docbook:272
#, no-c-format
msgid "Look Dialog Screenshot"
msgstr ""

#. Tag: phrase
#. +> trunk stable
#: plugins.docbook:278 plugins.docbook:346 plugins.docbook:397
#, no-c-format
msgid "Screenshot"
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:286
#, no-c-format
msgid "Page title"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:287
#, no-c-format
msgid "The Page title option has a text input box for changing the title of the image gallery page."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:291
#, no-c-format
msgid "Images per row"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:292
#, no-c-format
msgid "The Images per row option has a slider and a spin box for adjusting the number of thumbnails that are in a single row in the gallery."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:296
#, no-c-format
msgid "Show image file name"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:297
#, no-c-format
msgid "The Show image file name check box allows you to turn on or off the use of the filenames below the gallery thumbnails."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:301
#, no-c-format
msgid "Show image file size"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:302
#, no-c-format
msgid "The Show image filesize check box allows you to turn on or off the use of the filesizes below the gallery thumbnails."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:306
#, no-c-format
msgid "Show image dimensions"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:307
#, no-c-format
msgid "The Show image dimensions check box allows you to turn on or off the use of the image dimensions in pixels below the gallery thumbnails."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:311
#, no-c-format
msgid "Font name"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:312
#, no-c-format
msgid "The Font name combo box provides you with a choice of which font to use in creating the gallery."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:316
#, no-c-format
msgid "Font size"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:317
#, no-c-format
msgid "The Font size spin box is for changing the size of the font you selected."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:321
#, no-c-format
msgid "Foreground color"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:322
#, no-c-format
msgid "The Foreground color option has a selector for choosing the foreground color of the gallery, this includes the text areas."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:326
#, no-c-format
msgid "Background color"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:327
#, no-c-format
msgid "The Background color option has a selector for choosing the background color of the gallery."
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:333
#, no-c-format
msgid "Folders"
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:335
#, no-c-format
msgid "The Folders dialog is used for choosing where to save the gallery. This dialog is also used to configure what folders are used."
msgstr ""

#. Tag: screeninfo
#. +> trunk stable
#: plugins.docbook:340
#, no-c-format
msgid "Folders Dialog Screenshot"
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:354
#, no-c-format
msgid "Save to HTML file"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:355
#, no-c-format
msgid "The Save to file selector decides where you want to save you image gallery html page."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:359
#, no-c-format
msgid "Recurse subfolders"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:360
#, no-c-format
msgid "The Recurse subfolders check box enables recursing of subdirectories. If the check box is enabled, a slider and spin box are enabled to select the recursion depth."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:364
#, no-c-format
msgid "Copy original files"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:365
#, no-c-format
msgid "The Copy original files check box creates an image folder storing copies of the original images used in the gallery."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:369
#, no-c-format
msgid "Use comment file"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:370
#, no-c-format
msgid "The use comment file check box enables a file selector to choose a comments file to use with your gallery. The comment file contains the subtitles for the images."
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:372
#, no-c-format
msgid "The format of this file is:"
msgstr ""

#. Tag: programlisting
#. +> trunk stable
#: plugins.docbook:373
#, no-c-format
msgid ""
"# this is a comment, lines starting with '#' are ignored\n"
"FILENAME1:\n"
"Description\n"
"\n"
"FILENAME2:\n"
"Description"
msgstr ""

#. Tag: title
#. +> trunk stable
#: plugins.docbook:385
#, no-c-format
msgid "Thumbnails"
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:387
#, no-c-format
msgid "The thumbnails dialog is used for adjusting the properties of the thumbnails in the gallery."
msgstr ""

#. Tag: screeninfo
#. +> trunk stable
#: plugins.docbook:391
#, no-c-format
msgid "Thumbnails Dialog Screenshot"
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:405
#, no-c-format
msgid "Image format for the thumbnails"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:406
#, no-c-format
msgid "The image format combo box allows you to choose what format is used for the thumbnail images."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:410
#, no-c-format
msgid "Thumbnail size"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:411
#, no-c-format
msgid "The thumbnail size option provides a slider and spin box for adjusting the size of the thumbnails used in the gallery."
msgstr ""

#. Tag: guimenuitem
#. +> trunk stable
#: plugins.docbook:415
#, no-c-format
msgid "Set different color depth"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:416
#, no-c-format
msgid "The set different color depth check box enables a combo box for selecting a different color depth for the thumbnails if you wish to use a color depth other than the depth used in the original image."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:436
#, no-c-format
msgid "Search Bar"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:437
#, no-c-format
msgid "Provides a text box for easy access to search engines like Google. Clicking on the icon on the left side of the search box opens a menu to select and enable different search engines and configure their <ulink url=\"help:/kcontrol/ebrowsing/index.html\">Web Shortcuts</ulink>."
msgstr ""

#. Tag: term
#. +> trunk stable
#: plugins.docbook:445
#, no-c-format
msgid "Shell Command Plugin"
msgstr ""

#. Tag: para
#. +> trunk stable
#: plugins.docbook:446
#, no-c-format
msgid "This plugin enables you to execute a shell command in the current folder and view the output in a separate window."
msgstr ""
