msgid "Menu Entries"
msgstr "Menüindrääg"

#. Tag: title
#. +> trunk stable
#: menus.docbook:11
#, no-c-format
msgid "The File Menu"
msgstr "Dat Dateimenü"

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:17
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:26
#, no-c-format
msgid "This command <action>starts a new document</action> in the editing window. In the <guibutton>Documents</guibutton> list on the left the new file is named <emphasis>Untitled</emphasis>."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:37
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:46
#, no-c-format
msgid "Displays a standard &kde; <guilabel>Open File</guilabel> dialog. Use the file view to select the file you want to open, and click on <guibutton>Open</guibutton> to open it."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:56
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open Recent</guisubmenu>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:62
#, no-c-format
msgid "This is a shortcut to open recently saved documents. Clicking on this item opens a list to the side of the menu with several of the most recently saved files. Clicking on a specific file will open it in &kappname; - if the file still resides at the same location."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:75
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open With</guisubmenu>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:81
#, no-c-format
msgid "This submenu presents a list of applications known to handle the mime type of your current document. Activating an entry will open the current document with that application."
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:85
#, no-c-format
msgid "In addition, a entry <guimenuitem>Other...</guimenuitem> command launches the open with dialog box that allows you to <action>select another application to open the active file</action>. Your file will still be open in &kate;."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:95
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:104
#, no-c-format
msgid "This command <action>saves your file</action>. Use it often. If the file is <emphasis>Untitled</emphasis> then <guimenuitem>Save</guimenuitem> becomes <guimenuitem>Save As</guimenuitem>."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:116
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:122
#, no-c-format
msgid "<action>Name and rename files</action> with this command. It launches the save file dialog box. This dialog works just as the open file dialog box does. You can use it to navigate through your file system, preview existing files, or filter your file view with file masks."
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:130
#, no-c-format
msgid "Type the name you want to give the file you are saving in the Location combo box and press the <guibutton>OK</guibutton> button."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:141
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo> </shortcut> <guimenu>File</guimenu> <guimenuitem>Save All</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:150
#, no-c-format
msgid "This command <action>saves all modified open files</action>."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:159
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\"><keycap>F5</keycap></keycombo> </shortcut> <guimenu>File</guimenu> <guimenuitem>Reload</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:168
#, no-c-format
msgid "<action>Reloads the active file</action>. This command is useful if another program or process has changed the file while you have it open in &kate;"
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:179
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Reload All</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:185
#, no-c-format
msgid "<action>Reloads all opened files.</action>."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:194
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close Orphaned</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:200
#, no-c-format
msgid "<action>Close</action> all documents in the file list, which could not be reopened during startup, because they are not accessible anymore."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:209
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:218
#, no-c-format
msgid "<action>Print the active file</action>."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:226
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo> </shortcut> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:235
#, no-c-format
msgid "Close the active file with this command. If you have made unsaved changes, you will be prompted to save the file before &kate; closes it."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:245
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close Other</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:251
#, no-c-format
msgid "Close other open documents."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:260
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close All</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:266
#, no-c-format
msgid "This command <action>closes all the files you have open</action> in &kate;."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:276
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:285
#, no-c-format
msgid "This command <action>closes &kate;</action> and any files you were editing. If you have made unsaved changes to any of the files you were editing, you will be prompted to save them."
msgstr ""

#. Tag: title
#. +> trunk stable
#: menus.docbook:296
#, no-c-format
msgid "The Edit Menu"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:297
#, no-c-format
msgid "The <guimenu>Edit</guimenu> menu contains a host of commands, all to work with the currently active document."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:305
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:312
#, no-c-format
msgid "Undo the last editing command (typing, copying, cutting etc.)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:313
#, no-c-format
msgid "If grouped undo is enabled, this may undo several editing commands of the same type, like typing in characters."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:320
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:327
#, no-c-format
msgid "Redo the last undo step."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:334
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:341
#, no-c-format
msgid "Removes selected text if any, and places a copy of the removed text in the clipboard."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:348
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:355
#, no-c-format
msgid "Copies selected text, if any, to the clipboard."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:362
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:369
#, no-c-format
msgid "Copies the first item in the clipboard into the editor at cursor position."
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:370
#, no-c-format
msgid "If Overwrite Selection is enabled, the pasted text will overwrite the selection, if any."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:377
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:384
#, no-c-format
msgid "Selects all text in the editor."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:391
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>A</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Deselect</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:398
#, no-c-format
msgid "Deselects the selected text in the editor if any."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:405
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;&Shift; <keycap>B</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Block Selection Mode</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:413
#, no-c-format
msgid "Toggles Selection Mode. When the Selection Mode is <quote>BLOCK</quote>, you can make vertical selections, &eg; select column 5 to 10 in lines 9 to 15."
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:415
#, no-c-format
msgid "The status bar shows the current state of the Selection Mode, either <quote>LINE</quote> or <quote>BLOCK</quote>."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:420
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\"><keysym>Meta</keysym>&Ctrl;<keycap>V</keycap></keycombo> </shortcut> <guimenu>Edit</guimenu><guimenuitem>VI input Mode</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:427
#, no-c-format
msgid "Switch to a vi-like, modal editing mode. This mode supports the most used commands and motions from vim's normal and visual mode and has an optional vi mode statusbar. This status bar shows commands while they are being entered, output from commands and the current mode.The behavior of this mode can be configured in the <link linkend=\"pref-edit-vi-input-mode\">Vi Input Mode</link> section of the <guilabel>Editing</guilabel> page in &kappname;'s settings dialog."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:437
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\"><keycap>Ins</keycap></keycombo> </shortcut> <guimenu>Edit</guimenu><guimenuitem>Overwrite Mode</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:444
#, no-c-format
msgid "Toggles the Insert/Overwrite modes. When the mode is <guilabel>INS</guilabel>, you insert characters where the cursor is. When the mode is <guilabel>OVR</guilabel>, writing characters will replace the current characters if your cursor is positioned before any character. The status bar shows the current state of the Overwrite Mode, either <guilabel>INS</guilabel> or <guilabel>OVR</guilabel>."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:455
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:462
#, no-c-format
msgid "Launch the incremental search bar to allow you to search for text in the edited document."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:469
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\"><keycap>F3</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:476
#, no-c-format
msgid "Go to the nearest downwards match of the last text or regular expression searched for, starting from cursor position"
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:483
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Shift;<keycap>F3</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Previous</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:490
#, no-c-format
msgid "Go to the nearest upwards match of the last text or regular expression searched for, starting from cursor position"
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:497
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:504
#, no-c-format
msgid "Launch the power search and replace bar to replace one or more instances of a defined text with something else."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:510
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo></shortcut> <guimenu>Edit</guimenu><guimenuitem>Find Selected</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:515
#, no-c-format
msgid "Finds next occurrence of selected text."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:521
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>H</keycap></keycombo></shortcut> <guimenu>Edit</guimenu><guimenuitem>Find Selected Backwards</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:526
#, no-c-format
msgid "Finds previous occurrence of selected text."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:533
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Go to Line...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:540
#, no-c-format
msgid "Launches the Go To Line bar, allowing you to enter the number of a line to find in the document"
msgstr ""

#. Tag: title
#. +> trunk stable
#: menus.docbook:550
#, no-c-format
msgid "The View Menu"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:552
#, no-c-format
msgid "The <guimenu>View</guimenu> menu allows you to manage settings specific to the active editor, and to manage frames."
msgstr ""

#. Tag: title
#. +> trunk stable
#: menus.docbook:556 menus.docbook:982
#, no-c-format
msgid "Menu Items"
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:561
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>New Window</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:567
#, no-c-format
msgid "<action>Opens another instance of &kate;</action>. The new instance will be identical to your previous instance."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:577
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Alt;<keysym>Left</keysym></keycombo></shortcut> <guimenu>View</guimenu> <guimenuitem>Back</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:584
#, no-c-format
msgid "Opens the document displayed above the currently open document in the Documents list."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:591
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Alt;<keysym>Right</keysym></keycombo></shortcut> <guimenu>View</guimenu> <guimenuitem>Forward</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:598
#, no-c-format
msgid "Opens the document displayed below the currently open document in the Documents list."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:605
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Alt;<keycap>A</keycap></keycombo></shortcut> <guimenu>View</guimenu> <guimenuitem>Show Active</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:612
#, no-c-format
msgid "Displays the currently open document in the Documents list."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:619
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Shift;<keycap>F8</keycap></keycombo></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</guisubmenu> <guimenuitem>Previous Split View</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:626
#, no-c-format
msgid "Focus the previous document view, if you have split the editor area in more views."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:634
#, no-c-format
msgid "<shortcut><keycap>F8</keycap></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</guisubmenu> <guimenuitem>Next Split View</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:641
#, no-c-format
msgid "Focus the next document view, if you have split the editor area in more views."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:649
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>L</keycap></keycombo></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</guisubmenu> <guimenuitem>Split Vertical</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:656
#, no-c-format
msgid "This will split the frame (which may be the main editing area) in two equally sized frames, the new one to the left of the current one. The new frame gets the focus, and will display the same document as the old one."
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:659 menus.docbook:676 menus.docbook:694
#, no-c-format
msgid "See also <link linkend=\"kate-mdi\">Working with the &kate; MDI</link>"
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:666
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>T</keycap></keycombo></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</guisubmenu> <guimenuitem>Split Horizontal</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:673
#, no-c-format
msgid "Splits the current frame (which may be the main editing area) in two equally sized frames, the new one at the bottom half. The new frame gets the focus, and displays the same document as the old one."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:683
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>R</keycap></keycombo></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</guisubmenu> <guimenuitem>Close Current View</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:690
#, no-c-format
msgid "Closes the active frame. This is disabled, if there is only one frame (the main editing area)."
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:691
#, no-c-format
msgid "No documents get closed by closing a frame &ndash; they will still be available in the <link linkend=\"view-menu\"><guimenu>View</guimenu> Menu</link> as well as in the File List."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:703
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu>"
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:709
#, no-c-format
msgid "<shortcut><keycombo action=\"simul\">&Ctrl;&Alt;&Shift;<keycap>F</keycap> </keycombo></shortcut><guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show Sidebars</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:712
#, no-c-format
msgid "Toggles the display of the sidebar button rows. This command does not affect the display of the sidebar content widgets, any sidebar that is visible will stay visible, and if you assigned shortcuts to the below commands those will of course continue to work."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:721
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show Documents</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:727
#, no-c-format
msgid "Toggle the display of &kate;'s Documents list"
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:734
#, no-c-format
