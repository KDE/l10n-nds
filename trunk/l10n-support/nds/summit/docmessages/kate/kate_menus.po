msgid "<guimenu>Tools</guimenu><guimenuitem>Spelling...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1284
#, no-c-format
msgid "<action>This initiates the spellchecking program - a program designed to help the user catch and correct any spelling errors.</action> Clicking on this entry will start the checker and bring up the speller dialog box through which the user can control the process. There are four settings lined up vertically in the center of the dialog with their corresponding labels just to the left. Starting at the top they are:"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: menus.docbook:1293
#, no-c-format
msgid "Unknown word:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1294
#, no-c-format
msgid "Here, the spellchecker indicates the word currently under consideration. This happens when the checker encounters a word not in its dictionary - a file containing a list of correctly spelled words against which it compares each word in the editor."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: menus.docbook:1300
#, no-c-format
msgid "Replace with:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1301
#, no-c-format
msgid "If the checker has any similar words in its dictionary the first one will be listed here. The user can accept the suggestion, type in his or her own correction, or choose a different suggestion from the next box."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: menus.docbook:1307
#, no-c-format
msgid "Language:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1308
#, no-c-format
msgid "If you have installed multiple dictionaries, here you can select which dictionary/language should be used."
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1313
#, no-c-format
msgid "On the right side of the dialog box are 6 buttons that allow the user to control the spellcheck process. They are:"
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: menus.docbook:1318
#, no-c-format
msgid "Add to Dictionary"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1319
#, no-c-format
msgid "Pressing this button adds the <guilabel>Unknown word </guilabel> to the checker's dictionary. This means that in the future the checker will always consider this word to be correctly spelled."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: menus.docbook:1325
#, no-c-format
msgid "Suggest"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1326
#, no-c-format
msgid "The checker may list here a number of possible replacements for the word under consideration. Clicking on any one of the suggestions will cause that word to be entered in the <guilabel>Replace with</guilabel> box, above."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: menus.docbook:1332
#, no-c-format
msgid "Replace"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1333
#, no-c-format
msgid "This button has the checker replace the word under consideration in the document with the word in the <guilabel>Replace with</guilabel> box."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: menus.docbook:1338
#, no-c-format
msgid "Replace All"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1339
#, no-c-format
msgid "This button causes the checker to replace not only the current <guilabel>Unknown word:</guilabel> but to automatically make the same substitution for any other occurrences of this <guilabel>Unknown word</guilabel> in the document."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: menus.docbook:1345
#, no-c-format
msgid "Ignore"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1346
#, no-c-format
msgid "Activating this button will have the checker move on without making any changes."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: menus.docbook:1350
#, no-c-format
msgid "Ignore All"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1351
#, no-c-format
msgid "This button tells the checker to do nothing with the current <guilabel>Unknown word:</guilabel> and to pass over any other instances of the same word."
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1353
#, no-c-format
msgid "This only applies to the current spellcheck run. If the checker is run again later it will stop on this same word."
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1359
#, no-c-format
msgid "Three more buttons are located horizontally along the bottom of the spellcheck dialog. They are:"
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: menus.docbook:1364
#, no-c-format
msgid "Help"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1365
#, no-c-format
msgid "This invokes the &kde; help system with the help page for this dialog."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: menus.docbook:1370
#, no-c-format
msgid "Finished"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1371
#, no-c-format
msgid "This button ends the spellcheck process, and returns to the document."
msgstr ""

#. Tag: guibutton
#. +> trunk stable
#: menus.docbook:1376
#, no-c-format
msgid "Cancel"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1377
#, no-c-format
msgid "This button cancels the spellcheck process, all modifications are reverted, and you will return to your document."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1387
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spelling (from cursor)...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1391
#, no-c-format
msgid "This initiates the spellchecking program but it starts where your cursor is instead of at the beginning of the document."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1397
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spellcheck Selection...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1401
#, no-c-format
msgid "Spellchecks the current selection."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1406
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Change Dictionary</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1410
#, no-c-format
msgid "Displays a drop down box with all available dictionaries for spellchecking at the bottom of the editor window. This allows easy switching of the spellcheck dictionary &eg; for automatic spellcheck of text in different languages."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1442
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1445
#, no-c-format
msgid "This cleans the indentation for the current selection or for the line the cursor is currently in. Cleaning the indentation ensures that all your selected text follows the indentation mode you choose."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1452
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Align</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1457
#, no-c-format
msgid "Causes a realign of the current line or selected lines using the indentation mode and indentation settings in the document."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1463
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>D</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1470
#, no-c-format
msgid "This adds one space to the beginning of the line where the text cursor is located or to the beginning of any selected lines."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1477
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>D</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uncomment</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1484
#, no-c-format
msgid "This removes one space (if any exist) from the beginning of the line where the text cursor is located or from the beginning of any selected lines."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1490
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1497
#, no-c-format
msgid "Put the selected text or the letter after the cursor in uppercase."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1502
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>U</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Lowercase</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1509
#, no-c-format
msgid "Put the selected text or the letter after the cursor in lowercase."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1514
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>U</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Capitalize</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1521
#, no-c-format
msgid "Capitalize the selected text or the current word."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1526
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>J</keycap></keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Join Lines</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1533
#, no-c-format
msgid "Joins the selected lines, or the current line and the line below with one white space character as a separator. Leading/trailing white space on joined lines is removed in the affected ends."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1539
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Apply Word Wrap</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1543
#, no-c-format
msgid "Apply static word wrapping on all the document. That means that a new line of text will automatically start when the current line exceeds the length specified by the <guilabel>Wrap words at</guilabel> option in the Editing tab in <menuchoice> <guimenu>Settings</guimenu><guimenuitem>Configure Editor...</guimenuitem></menuchoice>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1552
#, no-c-format
msgid "Menu items for the selected <link linkend=\"pref-plugins\">plugins</link> are displayed at the end of this menu"
msgstr ""

#. Tag: title
#. +> trunk stable
#: menus.docbook:1560
#, no-c-format
msgid "The Settings Menu"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1562
#, no-c-format
msgid "The <guimenu>Settings</guimenu> menu allows you to change the properties of the main window, such as showing/hiding toolbars, and provides access to the configuration dialogs."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1569
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1575
#, no-c-format
msgid "When this is checked, this displays a movable toolbar containing buttons used to initiate frequently used commands. When unchecked the toolbar is hidden."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1583
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1587
#, no-c-format
msgid "When checked, this displays a small bar at the bottom of the editor containing information about the status of the current document. When unchecked the status bar is hidden."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1594
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Path</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1598
#, no-c-format
msgid "When selected, this displays in the titlebar the path (its location in the file system) of the current document. When unchecked the path is hidden."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1604
#, no-c-format
msgid "<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>F</keycap></keycombo> </shortcut> <guimenu>Settings</guimenu><guimenuitem>Full Screen Mode</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1610
#, no-c-format
msgid "Toggles full screen display."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1617
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1623
#, no-c-format
msgid "Display the familiar &kde; Keyboard Shortcut Configuration Dialog."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1632
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1638
#, no-c-format
msgid "Display the familiar &kde; Toolbar Configuration Dialog."
msgstr ""

#. Tag: menuchoice
#. +> trunk stable
#: menus.docbook:1645
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure &kate;...</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:1651
#, no-c-format
msgid "Launch the <link linkend=\"config-dialog\">Main Configuration Dialog</link>"
msgstr ""

