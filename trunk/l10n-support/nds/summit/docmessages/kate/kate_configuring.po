#. Tag: title
#. +> trunk stable
#: configuring.docbook:8
#, no-c-format
msgid "Configuring &kate;"
msgstr "&kate; instellen"

#. Tag: title
#. +> trunk stable
#: configuring.docbook:11
#, no-c-format
msgid "Overview"
msgstr "Översicht"

#. Tag: primary
#. +> trunk stable
#: configuring.docbook:14
#, no-c-format
msgid "configure"
msgstr "Instellen"

#. Tag: secondary
#. +> trunk stable
#: configuring.docbook:15
#, no-c-format
msgid "settings"
msgstr "Instellen"

#. Tag: tertiary
#. +> trunk stable
#: configuring.docbook:16
#, no-c-format
msgid "preferences"
msgstr "Vörinstellen"

#. Tag: para
#. +> trunk stable
#: configuring.docbook:16
#, no-c-format
msgid "&kate; offers several means of tweaking the application to behave as desired. The most important ones are:"
msgstr ""

#. Tag: term
#. +> trunk stable
#: configuring.docbook:30
#, no-c-format
msgid "The Configuration Dialog"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:31
#, no-c-format
msgid "The main configuration tool, allowing you to configure the &kate; application, the editor component and the usage of plugins."
msgstr ""

#. Tag: term
#. +> trunk stable
#: configuring.docbook:35
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:36
#, no-c-format
msgid "Allows you to change often used settings, and to launch the configuration dialogs."
msgstr ""

#. Tag: term
#. +> trunk stable
#: configuring.docbook:40
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:41
#, no-c-format
msgid "Allows you to split the current frame, as well as to display the icons and line numbers pane for the currently edited document."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:47
#, no-c-format
msgid "The embedded terminal is using the configuration defined in the &systemsettings;, and may be configured by clicking the <mousebutton>right</mousebutton> mouse button to display a context menu."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:54
#, no-c-format
msgid "The Main Configuration Dialog"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:62
#, no-c-format
msgid "The &kate; configuration dialog displays a tree of topics on the left, and a configuration page corresponding to the selected topic on the right."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:66
#, no-c-format
msgid "The configuration is divided into two groups, namely"
msgstr ""

#. Tag: link
#. +> trunk stable
#: configuring.docbook:68
#, no-c-format
msgid "Application configuration"
msgstr ""

#. Tag: link
#. +> trunk stable
#: configuring.docbook:70
#, no-c-format
msgid "Editor component configuration"
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:79
#, no-c-format
msgid "The &kate; Application Configuration"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:80
#, no-c-format
msgid "This group contains pages to configure the main &kate; application"
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:83 configuring.docbook:292 configuring.docbook:580
#: configuring.docbook:975
#, no-c-format
msgid "<title>General</title>"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:84
#, no-c-format
msgid "This section contains a few global options for &kate;"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:90
#, no-c-format
msgid "Behavior"
msgstr "Bedregen"

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:96
#, no-c-format
msgid "Warn about files modified by foreign processes"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:97
#, no-c-format
msgid "When enabled, &kate; will notify you about files modified from outside the application whenever the main window receives input focus. You will be able to deal with several modified files at once, you can reload, save or discard changed files in groups."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:101
#, no-c-format
msgid "If not enabled, &kate; will prompt you for action when a externally modified file receives focus within the application."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:112
#, no-c-format
msgid "Meta Information"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:118
#, no-c-format
msgid "Keep meta-information past sessions"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:119
#, no-c-format
msgid "When enabled, &kate; will store meta data such as bookmarks and session configuration even when you close your documents. The data will be used if the document is unchanged when reopened."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:126
#, no-c-format
msgid "Delete unused meta information after"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:127
#, no-c-format
msgid "Set the maximum number of days to keep meta information for unopen files. This helps keeping the database of meta information reasonably sized."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:139
#, no-c-format
msgid "Default text-editing component"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:140
#, no-c-format
msgid "Select the text-editing component used by &kate;. By default, it is configured to use the system default text-editing component as configured in &systemsettings;."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:149
#, no-c-format
msgid "Sessions"
msgstr "Törns"

#. Tag: para
#. +> trunk stable
#: configuring.docbook:151
#, no-c-format
msgid "This section contains options related to <link linkend=\"fundamentals-using-sessions\">using sessions</link>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:158
#, no-c-format
msgid "Elements of Sessions"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:162
#, no-c-format
msgid "Include window configuration"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:163
#, no-c-format
msgid "If enabled, &kate; will save the window configuration with each session."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:172
#, no-c-format
msgid "Behavior on Application Startup"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:174
#, no-c-format
msgid "Select how you want &kate; to behave at startup. This setting can be overridden by specifying what to do on the <link linkend=\"command-line-options\">command line</link>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:179
#, no-c-format
msgid "Start new session"
msgstr "Niegen Törn starten"

#. Tag: para
#. +> trunk stable
#: configuring.docbook:180
#, no-c-format
msgid "With this option, &kate; will start a new, unnamed session when you start it."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:184
#, no-c-format
msgid "Load last-used session"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:185
#, no-c-format
msgid "&kate; will use the most recently opened session at startup. This is good if you want to use the same session always or switch rarely."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:190
#, no-c-format
msgid "Manually choose a session"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:191
#, no-c-format
msgid "&kate; will display a small dialog that lets you choose your preferred session, or load the default session if none have been saved. This is the default behavior. Nice if you use a lot of different sessions frequently."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:201
#, no-c-format
msgid "The changes to the session data (opened files and if enabled, window configuration) will always be saved."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:207
#, no-c-format
msgid "Tree View"
msgstr "Boomansicht"

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:211
#, no-c-format
msgid "Background Shading"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:212
#, no-c-format
msgid "This section allows you to enable or disable the background shading visualization of your recent activity, and chose which colors to use if enabled. See the section about <link linkend=\"kate-mdi-tools-file-list\">The Document List</link> for more about this feature."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:219
#, no-c-format
msgid "Sort By"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:220
#, no-c-format
msgid "Set how you want the document list sorted. This can be set from the &RMB; menu in the document list as well."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:227
#, no-c-format
msgid "Show Full Path"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:228
#, no-c-format
msgid "When enabled, in tree mode, top level folders will show up with their full path rather than just the last folder name."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:237
#, no-c-format
msgid "Plugins"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:239
#, no-c-format
msgid "This page provides a list of installed plugins for the &kate; application. Each plug-in is represented with its name and a short description. You can check the checkbox with an item to enable the plug-in it represents."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:244
#, no-c-format
msgid "If a plug-in provides configuration options, a section to access those will appear as a child of this page."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:250
#, no-c-format
msgid "Terminal"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:252
#, no-c-format
msgid "This page is only displayed by the Terminal Tool View plugin, which is enabled by default."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:258
#, no-c-format
msgid "Automatically synchronize the terminal with the current document when possible"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:259
#, no-c-format
msgid "This will cause the built-in terminal to <command>cd</command> into the directory of the active document when launched and when a new document gets the focus. If not enabled, you have to do all your navigation in the terminal on your own."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:267
#, no-c-format
msgid "Set EDITOR environment variable to 'kate -b'"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:268
#, no-c-format
msgid "This sets the <envar>EDITOR</envar> environment variable so programs run in the built-in terminal that automatically open a file in an editor will open them in &kate; instead of the default editor configured in your shell. You will not be able to continue using the terminal until you have closed the file in &kate;, so the calling program is aware you have finished editing the file."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:280
#, no-c-format
msgid "The Editor Component Configuration"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:281
#, no-c-format
msgid "This group contains all pages related to the editor component of &kate;. Most of the settings here are defaults, they can be overridden by <link linkend=\"pref-open-save-modes-filetypes\">defining a filetype</link>, by <link linkend=\"config-variables\">Document Variables</link> or by changing them per document during an editing session."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:289
#, no-c-format
msgid "Appearance"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:296
#, no-c-format
msgid "Dynamic Word Wrap"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:298
#, no-c-format
msgid "If this option is checked, the text lines will be wrapped at the view border on the screen."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:302
#, no-c-format
msgid "Dynamic word wrap indicators (if applicable)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:303
#, no-c-format
msgid "Choose when the Dynamic word wrap indicators should be displayed, either <guilabel>Off</guilabel>, <guilabel>Follow Line Numbers</guilabel> or <guilabel>Always on</guilabel>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:308
#, no-c-format
msgid "Align dynamically wrapped lines to indentation depth:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:311
#, no-c-format
msgid "Enables the start of dynamically wrapped lines to be aligned vertically to the indentation level of the first line. This can help to make code and markup more readable."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:314
#, no-c-format
msgid "Additionally, this allows you to set a maximum width of the screen, as a percentage, after which dynamically wrapped lines will no longer be vertically aligned. For example, at 50%, lines whose indentation levels are deeper than 50% of the width of the screen will not have vertical alignment applied to subsequent wrapped lines."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:326
#, no-c-format
msgid "Whitespace Highlighting"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:330
#, no-c-format
msgid "Highlight tabulators"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:331
#, no-c-format
msgid "The editor will display a &raquo; symbol to indicate the presence of a tab in the text."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:335
#, no-c-format
msgid "Highlight trailing spaces"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:336
#, no-c-format
msgid "The editor will display dots to indicate the presence of extra whitespace at the end of lines."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:344
#, no-c-format
msgid "<guilabel>Advanced</guilabel>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:349
#, no-c-format
msgid "Show indentation lines"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:351
#, no-c-format
msgid "If this is checked, the editor will display vertical lines to help identifying indent lines."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:355
#, no-c-format
msgid "Highlight range between selected brackets"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:357
#, no-c-format
msgid "If this is enabled, the range between the selected matching brackets will be highlighted."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:367
#, no-c-format
msgid "<title>Borders</title>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:371
#, no-c-format
msgid "<guilabel>Borders</guilabel>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:375
#, no-c-format
msgid "Show folding markers (if available)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:377
#, no-c-format
msgid "If this option is checked, the current view will display marks for code folding, if code folding is available."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:381
#, no-c-format
msgid "Show icon border"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:383
#, no-c-format
msgid "If this is checked, you will see an icon border on the left hand side. The icon border shows bookmark signs for instance."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:387
#, no-c-format
msgid "Show line numbers"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:389
#, no-c-format
msgid "If this is checked, you will see line numbers on the left hand side."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:393
#, no-c-format
msgid "Show scrollbar marks"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:395
#, no-c-format
msgid "If this option is checked the current view will show marks on the vertical scrollbar. These marks will for instance show bookmarks."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:404
#, no-c-format
msgid "Sort Bookmarks Menu"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:409
#, no-c-format
msgid "By creation"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:411
#, no-c-format
msgid "Each new bookmark will be added to the bottom, independently from where it is placed in the document."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:415
#, no-c-format
msgid "By position"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:417
#, no-c-format
msgid "The bookmarks will be ordered by the line numbers they are placed at."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:429
#, no-c-format
msgid "Fonts &amp; Colors"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:431
#, no-c-format
msgid "This section of the dialog lets you configure all fonts and colors in any color scheme you have, as well creating new schemes or deleting existing ones. Each scheme has settings for colors, fonts and normal and highlight text styles."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:437
#, no-c-format
msgid "&kappname; will preselect the currently active scheme for you, if you want to work on a different scheme start by selecting that from the <guilabel>Schema</guilabel> combobox. With the <guibutton>New</guibutton> and <guibutton>Delete</guibutton> button you can create a new scheme or delete existing ones."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:441
#, no-c-format
msgid "At the bottom of the page you can select the <guilabel>Default schema for &kappname;</guilabel>."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:444
#, no-c-format
msgid "Colors"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:448
#, no-c-format
msgid "Text Area Background"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:454
#, no-c-format
msgid "Normal text"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:455
#, no-c-format
msgid "This is the default background for the editor area, it will be the dominant color on the editor area."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:460
#, no-c-format
msgid "Selected text"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:461
#, no-c-format
msgid "This is the background for selected text. The default is the global selection color, as set in your &kde; color preferences."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:467
#, no-c-format
msgid "Current line"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:468
#, no-c-format
msgid "Set the color for the current line. Setting this a bit different from the Normal text background helps to keep focus on the current line."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:474
#, no-c-format
msgid "Bookmark"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:475
#, no-c-format
msgid "This combobox lets you set overlay colors for various mark types. The color is mixed into the background color of a marked line, so that a line with more marks or a marked line that is current has a background that is a mix of more colors. The mark colors are also used if you enable display of scrollbar marks."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:487
#, no-c-format
msgid "Additional Elements"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:491
#, no-c-format
msgid "Left border background"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:492
#, no-c-format
msgid "This color is used for the marks, line numbers and folding marker borders in the left side of the editor view when they are displayed."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:497
#, no-c-format
msgid "Line numbers"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:498
#, no-c-format
msgid "This color is used to draw the line numbers on the left side of the view when displayed."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:502
#, no-c-format
msgid "Bracket highlight"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:503
#, no-c-format
msgid "This color is used to draw the background of matching brackets."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:507
#, no-c-format
msgid "Word wrap markers"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:508
#, no-c-format
msgid "This color is used to draw a pattern to the left of dynamically wrapped lines when those are aligned vertically, as well as for the static word wrap marker."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:513
#, no-c-format
msgid "Tab and space markers"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:514
#, no-c-format
msgid "This color is used to draw white space indicators when enabled."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:518
#, no-c-format
msgid "Spelling mistake line"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:519
#, no-c-format
msgid "sets the color of the line that is used to indicate spelling mistakes."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:530
#, no-c-format
msgid "Fonts"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:531
#, no-c-format
msgid "Here you can choose the font for the schema. You can choose from any font available on your system, and set a default size. A sample text displays at the bottom of the dialog, so you can see the effect of your choices."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:539
#, no-c-format
msgid "Normal Text Styles"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:540
#, no-c-format
msgid "The normal text styles are inherited by the highlight text styles, allowing the editor to present text in a very consistent way, for example comment text is using the same style in almost all of the text formats that &kappname; can highlight."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:544 configuring.docbook:559
#, no-c-format
msgid "The name in the list of styles is using the style configured for the item, providing you with an immediate preview when configuring a style."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:547
#, no-c-format
msgid "Each style lets you select common attributes as well as foreground and background colors. To unset a background color, rightclick to use the context menu."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:553
#, no-c-format
msgid "Highlighting Text Styles"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:554
#, no-c-format
msgid "Here you can edit the text styles used by a specific highlight definition. The editor preselects the highlight used by your current document. To work on a different highlight, select one in the <guilabel>Highlight</guilabel> combobox above the style list."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:562
#, no-c-format
msgid "Each style lets you select common attributes as well as foreground and background colors. To unset a background color, rightclick to use the context menu. In addition you can see if a style is equal to the default style used for the item, and set it to that if not."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:566
#, no-c-format
msgid "You will notice that many highlights contain other highlights represented by groups in the style list. For example most highlights import the Alert highlight, and many source code formats imports the Doxygen highlight. Editing colors in those groups only affects the styles when used in the edited highlight format."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:577
#, no-c-format
msgid "Editing"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:584
#, no-c-format
msgid "Static Word Wrap"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:585
#, no-c-format
msgid "Word wrap is a feature that causes the editor to automatically start a new line of text and move (wrap) the cursor to the beginning of that new line. &kappname; will automatically start a new line of text when the current line reaches the length specified by the <link linkend=\"pref-wrap-words-at\">Wrap Words At:</link> option."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:593
#, no-c-format
msgid "Enable static word wrap"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:595
#, no-c-format
msgid "Turns static word wrap on or off."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:599
#, no-c-format
msgid "Show static word wrap markers (if applicable)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:602
#, no-c-format
msgid "If this option is checked, a vertical line will be drawn at the word wrap column as defined in the <menuchoice> <guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></menuchoice> in the Editing tab. Please note that the word wrap marker is only drawn if you use a fixed pitch font."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:610
#, no-c-format
msgid "Wrap words at:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:612
#, no-c-format
msgid "If the <link linkend=\"pref-word-wrap\">Enable static word wrap</link> option is selected this entry determines the length (in characters) at which the editor will automatically start a new line."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:622
#, no-c-format
msgid "Misc"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:626
#, no-c-format
msgid "Remove trailing spaces while editing"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:627
#, no-c-format
msgid "&kappname; will automatically eliminate extra spaces at the ends of lines of text."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:631
#, no-c-format
msgid "Auto brackets"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:631
#, no-c-format
msgid "When the user types a left bracket ([, (, or {) &kappname; automatically enters the right bracket (}, ), or ]) to the right of the cursor."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:637
#, no-c-format
msgid "Copy/Cut the current line if no selection"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:638
#, no-c-format
msgid "If this option is enabled and the text selection is empty, copy and cut action are performed for the line of text at the actual cursor position."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:643
#, no-c-format
msgid "Allow scrolling past the end of the document"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:644
#, no-c-format
msgid "This option lets you scroll past the end of the document. This can be used to vertically centre the bottom of the document, or put it on top of the current view."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:655
#, no-c-format
msgid "Cursor &amp; Selection"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:660
#, no-c-format
msgid "Text Cursor Movement"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:664
#, no-c-format
msgid "Smart home and smart end"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:666
#, no-c-format
msgid "When selected, pressing the home key will cause the cursor to skip white space and go to the start of a line's text."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:671
#, no-c-format
msgid "Wrap cursor"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:673
#, no-c-format
msgid "When on, moving the insertion cursor using the <emphasis role=\"bold\">Left</emphasis> and <emphasis role=\"bold\">Right</emphasis> keys will go on to previous/next line at beginning/end of the line, similar to most editors."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:676
#, no-c-format
msgid "When off, the insertion cursor cannot be moved left of the line start, but it can be moved off the line end, which can be very handy for programmers. When this option is chosen, moving the cursor with the arrow keys off the end of a line (to the right) causes it to jump down to the beginning of the next line. Likewise when the cursor is moved past the beginning of a line (to the left) it jumps up to the end of the preceding line. When this option is not selected, moving the cursor right past the end of a line merely causes it to continue horizontally in the same line and trying to move it left past the beginning does nothing."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:688
#, no-c-format
msgid "PageUp/PageDown moves cursor"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:690
#, no-c-format
msgid "This option changes the behavior of the cursor when the user presses the <keycap>Page Up</keycap> or <keycap>Page Down</keycap> key. If unselected the text cursor will maintain its relative position within the visible text in &kappname; as new text becomes visible as a result of the operation. So if the cursor is in the middle of the visible text when the operation occurs it will remain there (except when one reaches the beginning or end.) With this option selected, the first key press will cause the cursor to move to either the top or bottom of the visible text as a new page of text is displayed."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:701
#, no-c-format
msgid "Autocenter cursor (lines):"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:703
#, no-c-format
msgid "Sets the number of lines to maintain visible above and below the cursor when possible."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:712
#, no-c-format
msgid "Text Selection Mode"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:716
#, no-c-format
msgid "Normal"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:718
#, no-c-format
msgid "Selections will be overwritten by typed text and will be lost on cursor movement."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:723
#, no-c-format
msgid "Persistent"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:725
#, no-c-format
msgid "Selections will stay even after cursor movement and typing."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:736
#, no-c-format
msgid "Indentation"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:741
#, no-c-format
msgid "Default Indentation mode:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:743
#, no-c-format
msgid "Select the automatic indentation mode you want to use as default. It is strongly recommended to use <userinput>None</userinput> or <userinput>Normal</userinput> here, and use filetype configurations to set other indentation modes for text formats like C/C++ code or &XML;."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:751
#, no-c-format
msgid "Indent using"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:755
#, no-c-format
msgid "Tabulators"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:757
#, no-c-format
msgid "When this is enabled the editor will insert tabulator characters when you press the &Tab; key or use <link linkend=\"kate-part-autoindent\">automatic indentation</link>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:763
#, no-c-format
msgid "Spaces"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:765
#, no-c-format
msgid "When this is enabled the editor will insert a calculated number of spaces according to the position in the text and the <option>tab-width</option> setting when you press the &Tab; key or use <link linkend=\"kate-part-autoindent\">automatic indentation</link>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:772
#, no-c-format
msgid "Tabulators and Spaces"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:774
#, no-c-format
msgid "When this is enabled, the editor will insert spaces as describe above when indenting or pressing &Tab; at the beginning of a line, but insert tabulators when the &Tab; key is pressed in the middle or end of a line."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:780
#, no-c-format
msgid "Tab width:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:782
#, no-c-format
msgid "This configures the number of spaces that are displayed in place of a tabulator character."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:787
#, no-c-format
msgid "Indentation width:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:789
#, no-c-format
msgid "The indentation width is the number of spaces which is used to indent a line. If configured to indent using tabulators, a tabulator character is inserted if the indentation is divisible by the tab width."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:799
#, no-c-format
msgid "Indentation Properties"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:803
#, no-c-format
msgid "Keep Extra Spaces"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:804
#, no-c-format
msgid "If this option is disabled, changing the indentation level aligns a line to a multiple of the width specified in <guilabel>Indentation width</guilabel>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:809
#, no-c-format
msgid "Adjust indentation of code pasted from the clipboard"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:811
#, no-c-format
msgid "If this option is selected, pasted code from the clipboard is indented. Triggering the <guimenuitem>Undo</guimenuitem> action removes the indentation."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:820
#, no-c-format
msgid "Indentation Actions"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:824
#, no-c-format
msgid "Backspace key in leading blank space unindents"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:826
#, no-c-format
msgid "If this option is selected, the &Backspace; key decreases the indentation level if the cursor is located in the leading blank space of a line."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:831
#, no-c-format
msgid "Tab key action (if no selection exists)"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:833
#, no-c-format
msgid "If you want &Tab; to align the current line in the current code block like in emacs, make &Tab; a shortcut to the action <guimenuitem>Align</guimenuitem>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:839
#, no-c-format
msgid "Always advance to the next tab position"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:841
#, no-c-format
msgid "If this option is selected, the &Tab; key always inserts white space so that the next tab position is reached. If the option <guilabel>Insert spaces instead of tabulators</guilabel> on the <guilabel>General</guilabel> tab in the <guilabel>Editing</guilabel> page is enabled, spaces are inserted; otherwise, a single tabulator is inserted."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:848
#, no-c-format
msgid "Always increase indentation level"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:850
#, no-c-format
msgid "If this option is selected, the &Tab; key always indents the current line by the number of character positions specified in <guilabel>Indentation width</guilabel>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:856
#, no-c-format
msgid "Increase indentation level if in leading blank space"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:858
#, no-c-format
msgid "If this option is selected, the &Tab; key either indents the current line or advances to the next tab position. If the insertion point is at or before the first non-space character in the line, or if there is a selection, the current line is indented by the number of character positions specified in <guilabel>Indentation width</guilabel>. If the insertion point is located after the first non-space character in the line and there is no selection, white space is inserted so that the next tab position is reached: if the option <guilabel>Insert spaces instead of tabulators</guilabel> on the <guilabel>General</guilabel> tab in the <guilabel>Editing</guilabel> page is enabled, spaces are inserted; otherwise, a single tabulator is inserted."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:882
#, no-c-format
msgid "Auto Completion"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:885 configuring.docbook:916
#, no-c-format
msgid "<guilabel>General</guilabel>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:889
#, no-c-format
msgid "Enable auto completion"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:891
#, no-c-format
msgid "If enabled, a word completion box automatically pops up during typing showing a list of text entries to complete the current text under the cursor."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:901
#, no-c-format
msgid "Minimal word length to complete"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:902
#, no-c-format
msgid "While typing text, the word completion searches for words in the document starting with the already typed text. This option configures the minimal amount of characters that are needed to make the word completion active and pop up a completion box."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:913
#, no-c-format
msgid "Vi Input Mode"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:920
#, no-c-format
msgid "Use VI input mode"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:922
#, no-c-format
msgid "When selected, the vi input mode will be enabled when opening a new view. You can still toggle the vi input mode on/off for a particular view in the <guimenu>Edit</guimenu> menu."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:928
#, no-c-format
msgid "Let Vi commands override Kate shortcuts"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:930
#, no-c-format
msgid "When selected, Vi commands will override &kappname;'s built-in commands. For example: <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo> will redo, and override the standard action (showing the search and replace dialog)."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:936
#, no-c-format
msgid "Hide the Vi mode status bar"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:938
#, no-c-format
msgid "By default, an extra status bar will be used when the Vi input mode is enabled. This status bar shows commands while they are being typed and messages/errors produced by Vi commands."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:941
#, no-c-format
msgid "Checking this option will hide this extra status line."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:948
#, no-c-format
msgid "Key Mapping"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:949
#, no-c-format
msgid "Key mapping is used to change the meaning of typed keys. This allows you to move commands to other keys or make special keypresses for doing a series of commands."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:953
#, no-c-format
msgid "Example:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:954
#, no-c-format
msgid "<keycap>F2</keycap> -> <keycap>I--</keycap> &Esc;"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:955
#, no-c-format
msgid "This will prepend <keycap>I--</keycap> to a line when pressing <keycap>F2</keycap>."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:964
#, no-c-format
msgid "Spellcheck"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:965
#, no-c-format
msgid "These configuration options are described in the documentation for the &systemsettings; module <ulink url=\"help:kcontrol/spellchecking\">Spell Checker</ulink>."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:972
#, no-c-format
msgid "Open/Save"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:980
#, no-c-format
msgid "File Format"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:985
#, no-c-format
msgid "Encoding:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:987
#, no-c-format
msgid "This defines the standard encoding to use to open/save files, if not changed in the open/save dialog or by using a command line option."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:993
#, no-c-format
msgid "Encoding Detection"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:995
#, no-c-format
msgid "Select an item from the drop down box, either to disable autodetection or use <guilabel>Universal</guilabel> to enable autodetection for all encodings. But as this may probably only detect utf-8/utf-16, selecting a region will use custom heuristics for better results. If neither the encoding chosen as standard above, nor the encoding specified in the open/save dialog, nor the encoding specified on command line match the content of the file, this detection will be run."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1006
#, no-c-format
msgid "Fallback Encoding"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1008
#, no-c-format
msgid "This defines the fallback encoding to try for opening files if neither the encoding chosen as standard above, nor the encoding specified in the open/ save dialog, nor the encoding specified on command line match the content of the file. Before this is used, an attempt will be made to determine the encoding to use by looking for a byte order marker at start of file: if one is found, the right unicode encoding will be chosen; otherwise encoding detection will run, if both fail fallback encoding will be tried."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1019
#, no-c-format
msgid "End of line:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1021
#, no-c-format
msgid "Choose your preferred end of line mode for your active document. You have the choice between &UNIX;, DOS/&Windows; or Macintosh."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1026
#, no-c-format
msgid "Automatic end of line detection"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1028
#, no-c-format
msgid "Check this if you want the editor to autodetect the end of line type. The first found end of line type will be used for the whole file."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1034
#, no-c-format
msgid "Enable byte order marker"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1036
#, no-c-format
msgid "The byte order mark is a special sequence at the beginning of unicode encoded documents. It helps editors to open text documents with the correct unicode encoding. For more information see <ulink url=\"http://en.wikipedia.org/wiki/Byte_Order_Mark\">Byte Order Mark</ulink>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1050
#, no-c-format
msgid "Automatic Cleanups on Load/Save"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1054
#, no-c-format
msgid "Remove trailing spaces"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1056
#, no-c-format
msgid "The editor will automatically eliminate extra spaces at the ends of lines of text while loading/saving the file."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:1068
#, no-c-format
msgid "<title>Advanced</title>"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1071
#, no-c-format
msgid "Folder Config File"
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1075
#, no-c-format
msgid "Search depth for config file:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1077
#, no-c-format
msgid "The editor will search the given number of folder levels upwards for &kappname; config file and load the settings line from it. Further information about these hidden folder config files you find in the <link linkend=\"config-variables\">document variables section</link>."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1089
#, no-c-format
msgid "Backup on Save"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1090
#, no-c-format
msgid "Backing up on save will cause &kappname; to copy the disk file to &lt;prefix&gt;&lt;filename&gt;&lt;suffix&gt; before saving changes. The suffix defaults to <emphasis role=\"bold\">~</emphasis> and prefix is empty by default."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1096
#, no-c-format
msgid "Local files"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1098
#, no-c-format
msgid "Check this if you want backups of local files when saving."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1103
#, no-c-format
msgid "Remote files"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1105
#, no-c-format
msgid "Check this if you want backups of remote files when saving."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1109
#, no-c-format
msgid "Prefix"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1111
#, no-c-format
msgid "Enter the prefix to prepend to the backup file names."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1115
#, no-c-format
msgid "Suffix"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1117
#, no-c-format
msgid "Enter the suffix to add to the backup file names."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1121
#, no-c-format
msgid "Disable swap file syncing"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1123
#, no-c-format
msgid "&kappname; is able to recover (most of) what was written after last save in case of a crash or power failure. A swap file (.swp.&lt;filename&gt;) is created after the first editing action on a document. If the user doesn’t save the changes and &kappname; crashes, the swap file remains on the disk. When opening a file, &kappname; checks if there is a swap file for the document and if it is, it asks the user whether he wants to recover the lost data or not. The user has the possibility to view the differences between the original file and the recovered one, too. The swap file is deleted after every save and on normal exit."
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1131
#, no-c-format
msgid "&kappname; syncs the swap files on the disk every 15 seconds, but only if they have changed since the last sync. The user can disable the swap files syncing if he wants, by checking the <guilabel>Disable swap file syncing</guilabel> box, but this can lead to more data loss."
msgstr ""

#. Tag: title
#. +> trunk stable
#: configuring.docbook:1146
#, no-c-format
msgid "Modes &amp; Filetypes"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1147
#, no-c-format
msgid "This page allows you to override the default configuration for documents of specified mimetypes. When the editor loads a document, it will try if it matches the file masks or mimetypes for one of the defined filetypes, and if so apply the variables defined. If more filetypes match, the one with the highest priority will be used."
msgstr ""

#. Tag: guilabel
#. +> trunk stable
#: configuring.docbook:1155
#, no-c-format
msgid "Filetype:"
msgstr ""

#. Tag: para
#. +> trunk stable
#: configuring.docbook:1156 configuring.docbook:1176
#, no-c-format
