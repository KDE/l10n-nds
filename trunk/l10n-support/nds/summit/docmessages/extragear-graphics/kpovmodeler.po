#. +> trunk
#: index.docbook:1500
#, no-c-format
msgid "Objects Reference"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:1502
#, no-c-format
msgid "For a complete reference to all objects and attributes see the &Povray; user documentation."
msgstr ""

