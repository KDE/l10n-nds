#, no-c-format
msgid "Screenshot"
msgstr "Schirmfoto"

#. Tag: title
#. +> trunk
#: index.docbook:123
#, no-c-format
msgid "More &kuickshow; features"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:125
#, no-c-format
msgid "The options dialog makes available more possibilities:"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:128
#, no-c-format
msgid "Images can be automatically shrunk to fit onto the screen, if they are larger."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:131
#, no-c-format
msgid "You can configure whether images should show up in their own window, or always use the same window."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:134
#, no-c-format
msgid "You can set the delay time for a slide show."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:136
#, no-c-format
msgid "You can tell the browser which file types to show."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:138
#, no-c-format
msgid "You can tweak the speed/quality ratio"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:142
#, no-c-format
msgid "If you are looking for a certain file, just enter the first few characters of its filename in the browser. A small edit window will pop up in the bottom right corner. When a matching file is found, it is highlighted. You can leave the edit window by pressing <keycap>Return</keycap> or &Esc;."
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:152
#, no-c-format
msgid "The <guilabel>&kuickshow; Configuration</guilabel> Dialog"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:155
#, no-c-format
msgid "The <guilabel>&kuickshow; Configuration</guilabel> dialog contains 5 tabs. Three of them, <link linkend=\"general-options\"><guilabel>General</guilabel></link>, <link linkend=\"modifications-options\"><guilabel>Modifications</guilabel></link> and <link linkend=\"slideshow-options\"><guilabel>Slideshow</guilabel></link> configure the operation of &kuickshow;, and the other two, <link linkend=\"shortcuts-options\"><guilabel>Viewer Shortcuts</guilabel></link> and <link linkend=\"shortcuts-options\"><guilabel>Browser Shortcuts</guilabel></link> allow you to personalize the shortcuts for the respective windows."
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:167
#, no-c-format
msgid "<guilabel>General</guilabel> Options"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:169
#, no-c-format
msgid "The <guilabel>General</guilabel> contains the options to configure and tune &kuickshow;."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:174
#, no-c-format
msgid "Fullscreen mode"
msgstr "Heelschirmbedrief"

#. Tag: para
#. +> trunk
#: index.docbook:176
#, no-c-format
msgid "If this is selected, images open in full screen mode. If the image is not large enough to fill the screen, the rest of the screen is filled with the background color selected below. The default is off."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:184
#, no-c-format
msgid "Preload next image"
msgstr "Nakamen Bild vörladen"

#. Tag: para
#. +> trunk
#: index.docbook:186
#, no-c-format
msgid "If this is selected, &kuickshow; will load the next image in the folder, while you are looking at the current one. This reduces the delay when you select the next image, and is especially useful for slide shows."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:194
#, no-c-format
msgid "Remember last folder"
msgstr "Verleden Orner wohren"

#. Tag: para
#. +> trunk
#: index.docbook:196
#, no-c-format
msgid "If this is selected, &kuickshow; saves the name of the last folder on exit. On next start &kuickshow; will open this folder in the browser window."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:202
#, no-c-format
msgid "Background color:"
msgstr "Achtergrundklöör:"

#. Tag: para
#. +> trunk
#: index.docbook:204
#, no-c-format
msgid "Click on the colored bar to select a background color. This is used to fill the screen in fullscreen mode, or the window, if you have resized it larger than the image."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:211
#, no-c-format
msgid "Show only files with extension:"
msgstr "Bloots Dateien mit disse Verwiedern wiesen:"

#. Tag: para
#. +> trunk
#: index.docbook:213
#, no-c-format
msgid "You can configure &kuickshow; to only show you some of the file types it is capable of."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:221
#, no-c-format
msgid "Quality/Speed"
msgstr "Gööd / Gauheit"

#. Tag: guilabel
#. +> trunk
#: index.docbook:223
#, no-c-format
msgid "Fast rendering"
msgstr "Gau Dorstellen"

#. Tag: para
#. +> trunk
#: index.docbook:224
#, no-c-format
msgid "Render things fast."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:229
#, no-c-format
msgid "Dither in HiColor (15/16bit) modes"
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:236
#, no-c-format
msgid "Dither in LowColor (&lt;=8bit) modes"
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:243
#, no-c-format
msgid "Use own color palette"
msgstr "Egen Klörensett bruken"

#. Tag: guilabel
#. +> trunk
#: index.docbook:250
#, no-c-format
msgid "Fast palette remapping"
msgstr "Gau Klörensett-Wesseln"

#. Tag: guilabel
#. +> trunk
#: index.docbook:257
#, no-c-format
msgid "Maximum cache size (MB):"
msgstr "Hööchst Twischenspiekergrött (MB):"

#. Tag: title
#. +> trunk
#: index.docbook:268
#, no-c-format
msgid "The <guilabel>Modifications</guilabel> Tab"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:270
#, no-c-format
msgid "Check <guilabel>Apply default image modifications</guilabel> to open an image with these modifications in &kuickshow;."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:274
#, fuzzy, no-c-format
msgid "Scaling"
msgstr "Topassen"

#. Tag: guilabel
#. +> trunk
#: index.docbook:276
#, no-c-format
msgid "Shrink image to screen size, if larger"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:278
#, no-c-format
msgid "If this is selected, large images are displayed in maximized window. The default is on."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:284
#, no-c-format
msgid "Shrink image to screen size, if smaller, up to factor:"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:286
#, no-c-format
msgid "If this is selected, &kuickshow; increases the magnification of small images up to the selected factor."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:294
#, no-c-format
msgid "Geometry"
msgstr "Grött"

#. Tag: guilabel
#. +> trunk
#: index.docbook:296
#, no-c-format
msgid "Flip vertically"
msgstr "Pielrecht ümdreihen"

#. Tag: para
#. +> trunk
#: index.docbook:297
#, no-c-format
msgid "Flips the image vertically."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:302
#, no-c-format
msgid "Flip horizontally"
msgstr "Kimmrecht ümdreihen"

#. Tag: para
#. +> trunk
#: index.docbook:303
#, no-c-format
msgid "Flips the image horizontally."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:308
#, no-c-format
msgid "Rotate image"
msgstr "Bild dreihen"

#. Tag: para
#. +> trunk
#: index.docbook:309
#, no-c-format
msgid "Rotates the image to 0, 90, 180 or 270 degrees."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:317
#, no-c-format
msgid "Adjustments"
msgstr "Topassen"

#. Tag: guilabel
#. +> trunk
#: index.docbook:319
#, no-c-format
msgid "Brightness:"
msgstr "Helligkeit:"

#. Tag: para
#. +> trunk
#: index.docbook:320
#, no-c-format
msgid "Lightens/darkens the image."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:325
#, no-c-format
msgid "Contrast:"
msgstr "Kontrast:"

#. Tag: para
#. +> trunk
#: index.docbook:326
#, no-c-format
msgid "Adds/Removes contrast."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:330
#, no-c-format
msgid "Gamma:"
msgstr "Gamma:"

#. Tag: para
#. +> trunk
#: index.docbook:331
#, no-c-format
msgid "More/less gamma."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:338
#, no-c-format
msgid "A <guilabel>Preview</guilabel> of the <guilabel>Original</guilabel> and <guilabel>Modified</guilabel> image is displayed below this options."
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:344
#, no-c-format
msgid "The <guilabel>Slideshow</guilabel> Tab"
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:349
#, no-c-format
msgid "Switch to full-screen"
msgstr "Na Heelschirmbedrief wesseln"

#. Tag: para
#. +> trunk
#: index.docbook:351
#, no-c-format
msgid "Indicates if &kuickshow; should switch to full-screen mode when starting the slideshow."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:357
#, no-c-format
msgid "Start with current image"
msgstr "Mit dat aktuelle Bild starten"

#. Tag: para
#. +> trunk
#: index.docbook:359
#, no-c-format
msgid "Indicates if the slideshow should start with the first image in the folder or with the image which is selected."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:365
#, no-c-format
msgid "Delay between slides:"
msgstr "Töövtiet twischen Dias:"

#. Tag: para
#. +> trunk
#: index.docbook:367
#, no-c-format
msgid "The length of time between image changes during the slideshow. You can use the slider, type a new value into the field, or use the small arrows to increase or decrease the value. The default is 3 seconds."
msgstr ""

#. Tag: guilabel
#. +> trunk
#: index.docbook:375
#, no-c-format
msgid "Iterations (0 = infinite):"
msgstr "Wedderhalen (0 = ahn Enn):"

#. Tag: para
#. +> trunk
#: index.docbook:377
#, no-c-format
msgid "The amount of iterations. If set to 0 it will loop until you abort the slideshow. You can use the slider, type a new value into the field, or use the small arrows to increase or decrease the value. The default is 1."
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:388
#, no-c-format
msgid "The <guimenu>Shortcuts</guimenu> Tabs"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:389
#, no-c-format
msgid "Change the shortcuts for the different modes of &kuickshow; in the <guilabel>Viewer Shortcuts</guilabel> and the <guilabel>Browser Shortcuts</guilabel> tabs."
msgstr ""

