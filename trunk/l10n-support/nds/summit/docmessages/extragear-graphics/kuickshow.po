#. Tag: title
#. +> trunk
#: index.docbook:100
#, no-c-format
msgid "Using &kuickshow;"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:102
#, no-c-format
msgid "Using &kuickshow; is very simple. The file browser lists files, which you can select with a &LMB; click or the <keycap>Return</keycap> key."
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:107
#, no-c-format
msgid "Here's a screenshot of &kuickshow;"
