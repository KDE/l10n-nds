#. +> trunk
#: index.docbook:516
#, no-c-format
msgid "<shortcut><keycap>F6</keycap></shortcut> <guimenu>View</guimenu> <guimenuitem>Short View</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:521
#, no-c-format
msgid "If this option is selected, only the names of the files and folders will be shown."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:522
#, no-c-format
msgid "Compare this to detailed view."
msgstr ""

#. Tag: menuchoice
#. +> trunk
#: index.docbook:526
#, no-c-format
msgid "<shortcut><keycap>F7</keycap></shortcut> <guimenu>View</guimenu> <guimenuitem>Detailed View</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:531
#, no-c-format
msgid "If this option is selected, the names, sizes, dates, permissions, file owners and group ownerships are shown."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:532
#, no-c-format
msgid "Compare this to short view."
msgstr ""

#. Tag: menuchoice
#. +> trunk
#: index.docbook:536
#, no-c-format
msgid "<shortcut><keycap>F8</keycap></shortcut> <guimenu>View</guimenu> <guimenuitem>Show Hidden Files</guimenuitem>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:541
#, no-c-format
msgid "This will toggle between revealing and hiding normally hidden files."
msgstr ""

#. Tag: menuchoice
#. +> trunk
#: index.docbook:545
#, no-c-format
msgid "<shortcut><keycap>F12</keycap></shortcut> <guimenu>View</guimenu> <guimenuitem>Separate Folders</guimenuitem>"
