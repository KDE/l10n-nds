#. Tag: title
#. +> trunk
#: index.docbook:54
#, no-c-format
msgid "Introduction"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:56
#, no-c-format
msgid "&kooka; is a &kde; application that enables easy scanning using <acronym>SANE</acronym> libraries. Therefore,<acronym>SANE</acronym> the package must be installed to use &kooka;. Clear and concise use was the focus of its development."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:61
#, no-c-format
msgid "Character recognition is also provided by the built-in text recognition program gocr. Install <application>gocr</application> to use this functionality. After character recognition is complete, the recognized material can be opened in the text editor &kate; with just one click, where you can edit the contents."
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:70
#, no-c-format
msgid "Application Instructions"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:72
#, no-c-format
msgid "The web site <ulink url=\"http://www.sane-project.org/\">http://www.sane-project.org</ulink> has information about supported scanners. Refer to it before purchasing a scanner, if possible."
msgstr ""

#. Tag: title
#. +> trunk
#: index.docbook:78
#, no-c-format
msgid "<title>The &kooka; Main Window</title>"
msgstr ""

#. Tag: screeninfo
#. +> trunk
#: index.docbook:81
#, no-c-format
msgid "<screeninfo>The &kooka; Main Window</screeninfo>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:89
#, no-c-format
msgid "Start &kooka; from a console by simply entering <userinput><command>kooka</command></userinput>. Create a link on the &kde; desktop, which uses a scanner icon, if desired."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:93
#, no-c-format
msgid "The main window in &kooka; consists of three frames. At the top, see both icon and a menu panels. Use the mouse to enlarge or reduce the windows as needed."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:99
#, no-c-format
msgid "The navigation window consists of two tabs, which allow you to switch between the <guilabel>Preview</guilabel> and the integrated file browser called the <guilabel>Gallery</guilabel>. The working folder is displayed in the lower part of the window along with the folder where the scan will be saved."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:107
#, no-c-format
msgid "Make your scanner-dependent settings, which are dependent on the scanner you have connected, in the lower left window. Usually, these are settings for resolution, brightness and contrast, scanning mode (&eg;, color, gray, or binary), and for gamma values."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:112
#, no-c-format
msgid "Configure your settings here first. Afterwards, initiate the preview scan with <guimenuitem>Preview</guimenuitem>. If the <guilabel>Preview</guilabel> tab in the upper window is selected, see the results there."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:117
#, no-c-format
msgid "Select the various formats in the preview image itself to define the final dimensions. The <guilabel>User</guilabel> setting is recommended for this, so you select the area to scan in the preview display with the mouse."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:122
#, no-c-format
msgid "After this is done, click <guimenu>Scan</guimenu> to scan the selection made in the preview. After scanning, you will be asked in which format to save the image whether to make this your standard format (without being prompted to confirm your selection in the future)."
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:128
#, no-c-format
msgid "If you checked that you do not want to be asked about the save format, the memory assistant will no longer appear. To change the format some time in the future, select <menuchoice> <guimenu>Settings</guimenu> <guimenuitem>Configure Kooka...</guimenuitem> <guimenuitem>Save Image</guimenuitem> <guimenuitem>Always show memory assistant</guimenuitem> </menuchoice>"
msgstr ""

#. Tag: para
#. +> trunk
#: index.docbook:138
#, no-c-format
msgid "The large window shows how the image appears after a final scan."
msgstr ""

