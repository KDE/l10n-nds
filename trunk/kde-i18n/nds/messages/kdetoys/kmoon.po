#: kmoonapplet.cpp:52
msgid "Moon Phase Indicator for KDE"
msgstr "Maandwieser för KDE"

#: kmoonapplet.cpp:84
msgid "&Configure..."
msgstr "&Instellen..."

#: kmoonapplet.cpp:100
msgid "About Moon Phase Indicator"
msgstr "Vertell wat över den Maandwieser"

#: kmoonapplet.cpp:108
msgid ""
"Written by Stephan Kulow <coolo@kde.org>\n"
"\n"
"Made an applet by M G Berberich <berberic@fmi.uni-passau.de>\n"
"\n"
"Lunar code by Chris Osburn <chris@speakeasy.org>\n"
"\n"
"Moon graphics by Tim Beauchamp <timb@googol.com>"
msgstr ""
"Schreven hett dat Stephan Kulow <coolo@kde.org>\n"
"\n"
"Lüttprogramm dorvun maakt hett M G Berberich <berberic@fmi.uni-passau.de>\n"
"\n"
"De Code för't Utreken vun den Maand is vun Chris Osburn "
"<chris@speakeasy.org>\n"
"\n"
"De Maandbiller sünd vun Tim Beauchamp <timb@googol.com>\n"
"\n"
"Plattmaakt hett dat Heiko Evermann <heiko.evermann@gmx.de> \n"
"un de plattdüütschen Wöör för den Maand kummt vun Marlou Lessing vun "
"www.marless.de"

#: kmoondlg.cpp:33
msgid "Change View"
msgstr "Ansicht verännern"

#: kmoondlg.cpp:44
msgid "View angle:"
msgstr "Kiekwinkel:"

#: kmoondlg.cpp:45
msgid ""
"You can use this to rotate the moon to the correct\n"
"angle for your location.\n"
"\n"
"This angle is (almost) impossible to\n"
"calculate from any system-given data,\n"
"therefore you can configure how you\n"
"want KMoon to display your moon here.\n"
"The default value is 0, but it is very\n"
"unlikely that you would see the moon\n"
"at this angle."
msgstr ""
"Hier kannst du den Maand dreihen\n"
"so dat dat to dien Oort passt.\n"
"\n"
"Disse Winkel lett sik nich goot ut den Daten\n"
"vun dien Systeem utreken, un so kannst du hier \n"
" instellen, woans KMoon den Maand wiesen schull.\n"
"De Startweert is 0, man dat is nich sehr wohrschienlich,\n"
" dat du den Maand mit dissen Winkel sehn kannst."

#: kmoondlg.cpp:69 kmoondlg.cpp:103
msgid "Switch to Southern Hemisphere"
msgstr "Wesseln na de Süüdhalfkugel"

#: kmoondlg.cpp:70 kmoondlg.cpp:104
msgid "Switch to Northern Hemisphere"
msgstr "Wesseln na de Noordhalfkugel"

#: kmoondlg.cpp:75 kmoondlg.cpp:110
msgid "Switch Masking Off"
msgstr "Mask utmaken"

#: kmoondlg.cpp:76 kmoondlg.cpp:111
msgid "Switch Masking On"
msgstr "Mask anmaken"

#: kmoondlg.cpp:84
msgid ""
"The moon as KMoon would display it\n"
"following your current setting and time."
msgstr ""
"De Maand so as KMoon den mit dien aktuellen\n"
"Instellen un dien Reeknertiet wiesen warrt."

#: kmoonwidget.cpp:127
msgid "Full Moon"
msgstr "Vullmaand"

#: kmoonwidget.cpp:170
msgid "New Moon"
msgstr "Niemaand"

#: kmoonwidget.cpp:178
#, c-format
msgid ""
"_n: Waxing Crescent (New Moon was yesterday)\n"
"Waxing Crescent (%n days since New Moon)"
msgstr ""
"Tonehmen Maand (gistern weer Niemaand)\n"
"Tonehmen Maand (%n Daag siet Niemaand)"

#: kmoonwidget.cpp:181
msgid "First Quarter"
msgstr "Tonehmen Halfmaand"

#: kmoonwidget.cpp:189
#, c-format
msgid ""
"_n: Waxing Gibbous (Tomorrow is Full Moon)\n"
"Waxing Gibbous (%n days to Full Moon)"
msgstr ""
"Tonehmen Maand (morgen is Vullmaand)\n"
"Tonehmen Maand (%n Daag bet Vullmaand)"

#: kmoonwidget.cpp:200
#, c-format
msgid ""
"_n: Waning Gibbous (Yesterday was Full Moon)\n"
"Waning Gibbous (%n days since Full Moon)"
msgstr ""
"Afnehmen Maand (gistern weer Vullmaand)\n"
"Afnehmen Maand (%n Daag siet Vullmaand)"

#: kmoonwidget.cpp:203
msgid "Last Quarter"
msgstr "Afnehmen Halfmaand"

#: kmoonwidget.cpp:213
#, c-format
msgid ""
"_n: Waning Crescent (Tomorrow is New Moon)\n"
"Waning Crescent (%n days to New Moon)"
msgstr ""
"Afnehmen Maand (morgen is Niemaand)\n"
"Afnehmen Maand (%n Daag bet Niemaand)"

