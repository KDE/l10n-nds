#: format.cpp:469 format.cpp:512
msgid ""
"Cannot access floppy or floppy drive.\n"
"Please insert a floppy and make sure that you have selected a valid floppy "
"drive."
msgstr ""
"Kunn nich op de Diskett oder dat Diskettenloopwark togriepen.\n"
"Büdde legg 'n Diskett in un kiek dat du dat richtige Diskettenloopwark "
"tofaat hest."

