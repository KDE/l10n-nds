#: main.cpp:35
msgid "KDE Floppy Disk utility"
msgstr "KDE Diskettenloopwark Programm"

#: main.cpp:41
msgid "Default Device"
msgstr "standart Gereedschap"

#: main.cpp:48
msgid "KFloppy"
msgstr "KDiskettenloopwark"

#: main.cpp:53
msgid ""
"KFloppy helps you format removeable media (like floppy, Zip,\n"
"or LS120 disks) with the filesystem of your choice."
msgstr ""
"KDiskettenloopwark hülps di Disketten, Zip, oder LS120 Disketten\n"
"mit den Filesysteem wat du formateern wüllst"

#: main.cpp:57
msgid "Author, Maintainer"
msgstr "Autor Pleeger"

#: main.cpp:58
msgid "User interface re-design"
msgstr "Bruker Ansluss nee utsehn"

#: main.cpp:59
msgid "Add BSD support"
msgstr "BSD stütten tofögen"

#: format.cpp:258
#, c-format
msgid "Unexpected drive number %1."
msgstr "Di loopwark gifft dat nit %1."

#: format.cpp:264
#, c-format
msgid "Unexpected density number %1."
msgstr "Beswärnis mit density nummer %1."

#: format.cpp:279
msgid "Cannot find a device for drive %1 and density %2."
msgstr "Kunn dat reedschapen för dat loopwark nit finden %1 un density %2"

#: format.cpp:298
msgid ""
"Cannot access %1\n"
"Make sure that the device exists and that you have write permission to it."
msgstr ""
"Kunn nit togriepen %1\n"
"Verseker di dat de reedschapen do is un dat du schriev verlööf hest"

#: format.cpp:327
msgid "%1 terminated abnormally."
msgstr "%1 afbroken "

#: format.cpp:396
msgid "Cannot find fdformat."
msgstr "Kunn fdformat nit finden"

#: format.cpp:429
msgid "Could not start fdformat."
msgstr "fdformat geit nit"

#: format.cpp:456
#, c-format
msgid "Error formatting track %1."
msgstr "Fehler bi den formateern vun track %1"

#: floppy.cpp:511 floppy.cpp:640 format.cpp:502
msgid ""
"Cannot access floppy or floppy drive.\n"
"Please insert a floppy and make sure that you have selected a valid floppy "
"drive."
msgstr ""
"Kunn nit op di Diskette oder Diskettenloopwark togriepen.\n"
"Büdde Diskette infögen un kiek dat du richtige Diskettenloopwark hest"

#: format.cpp:560
msgid "Cannot find a program to create FAT filesystems."
msgstr "Kunn keen programm finden üm een FAT Filesysteem to maken"

#: format.cpp:591
msgid "Cannot start FAT format program."
msgstr "FAT formateer programm geit nit los"

#: format.cpp:635
msgid "Cannot find a program to create UFS filesystems."
msgstr "Kunn keen programm finden üm een UFS Filesysteem to maken"

#: format.cpp:649
msgid "Cannot start UFS format program."
msgstr "UFS formateer programm geit nit los"

#: format.cpp:706
msgid "Cannot find a program to create ext2 filesystems."
msgstr "Kunn keen programm finden üm een ext2 Filesysteem to maken"

#: format.cpp:721
msgid "Cannot start ext2 format program."
msgstr "ext2 formateer programm geit nit los"

