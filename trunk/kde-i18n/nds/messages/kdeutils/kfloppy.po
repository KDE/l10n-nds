#: main.cpp:36
msgid "KDE Floppy Disk Utility"
msgstr "KDE-Warktüüch för dat Diskettenloopwark "

#: main.cpp:40
msgid "Default device"
msgstr "Standardreedschap"

#: main.cpp:47
msgid "KFloppy"
msgstr "KDiskett"

#: main.cpp:52
msgid ""
"KFloppy helps you format removeable media (like floppy, Zip,\n"
"or LS120 disks) with the filesystem of your choice."
msgstr ""
"KDiskett hülpt di Disketten, Zip-, oder LS120-Disketten\n"
"mit 'n Dateisysteem to formateern, dat du di utsöken kannst."

#: main.cpp:56
msgid "Author, Maintainer"
msgstr "Autor, Pleeger"

#: main.cpp:57
msgid "User interface re-design"
msgstr "Grafsche Böversiet nee makt"

#: main.cpp:58
msgid "Add BSD support"
msgstr "BSD-Stütten tofögt"

#: format.cpp:254
#, c-format
msgid "Unexpected drive number %1."
msgstr "Dat Loopwark %1 gifft dat nich."

#: format.cpp:260
#, c-format
msgid "Unexpected density number %1."
msgstr "De Schrievdichte %1 gifft dat nich."

#: format.cpp:275
msgid "Cannot find a device for drive %1 and density %2."
msgstr "Kunn dat Reedschap för dat Loopwark %1 un de Schrievdichte %2 nich finnen."

#: format.cpp:294
msgid ""
"Cannot access %1\n"
"Make sure that the device exists and that you have write permission to it."
msgstr ""
"Kunn op %1 nich togriepen\n"
"Verseker di dat dat Reedschap dor is und du Verlööf hest, dor to schrieven."

#: format.cpp:323
msgid "%1 terminated abnormally."
msgstr "%1 mitmal afbroken."

#: format.cpp:392
msgid "Cannot find fdformat."
msgstr "Kunn dat Programm fdformat nich finnen."

#: format.cpp:424
msgid "Could not start fdformat."
msgstr "Dat Programm fdformat lett sik nich starten."

#: format.cpp:451
#, c-format
msgid "Error formatting track %1."
msgstr "Fehler bi't Formateern vun Spoor %1"

#: format.cpp:492
msgid ""
"Cannot access floppy or floppy drive.\n"
"Please insert a floppy and make sure that you have selected a valid floppy "
"drive."
msgstr ""
"Kunn nich op de Diskett oder dat Diskettenloopwark togriepen.\n"
"Büdde legg 'n Diskett in un kiek dat du dat richtige Diskettenloopwark "
"tofaat hest."

#: format.cpp:550
msgid "Cannot find a program to create FAT filesystems."
msgstr "Kunn keen Programm finnen üm een FAT Dateisysteem to maken."

#: format.cpp:581
msgid "Cannot start FAT format program."
msgstr "Dat FAT-Formateerprogramm lett sik nich starten."

#: format.cpp:625
msgid "Cannot find a program to create UFS filesystems."
msgstr "Kunn keen Programm finnen üm een UFS Dateisysteem to maken"

#: format.cpp:639
msgid "Cannot start UFS format program."
msgstr "Dat UFS-Formateerprogramm lett sik nich starten."

#: format.cpp:696
msgid "Cannot find a program to create ext2 filesystems."
msgstr "Kunn keen Programm finnen üm een ext2 Dateisysteem to maken"

#: format.cpp:712
msgid "Cannot start ext2 format program."
msgstr "Dat ext2-Formateerprogramm lett sik nich starten."

