msgstr "Block %1 is klöterig. Geit wieder..."

#: floppy.cpp:652
msgid ""
"Cannot create a filesystem on: %1\n"
"%2"
msgstr ""
"Kunn keen Filesysteem maken ut: %1\n"
"%2"

#: floppy.cpp:680
msgid ""
"The floppy was successfully formatted.\n"
"Blocks marked bad: %1\n"
"Raw Capacity: %2\n"
msgstr ""
"Di Diskette is good formateer.\n"
"Blocks di klöterig sünd: %1\n"
"RAW Capacity: %2\n"

#: floppy.cpp:689
msgid "All files were successfully erased."
msgstr "All files sünd platt."

