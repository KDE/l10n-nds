#: piece.cpp:20
msgid "Color #%1:"
msgstr "Klöör #%1:"

#: field.cpp:17
msgid "Remaining blocks"
msgstr "Restliche Steen"

#: field.cpp:20
msgid ""
"<qt>Display the number of remaining blocks."
"<br/>It turns <font color=\"blue\">blue</font> if it is a highscore and "
"<font color=\"red\">red</font> if it is the best local score.</qt>"
msgstr ""
"<qt>Wies de Tall vun de restlichen Steen."
"<br/>De Klöör is <font color=\"blue\">blau</font>, wenn Du een vun de "
"Bestlüüd in't Nett büst un <font color=\"red\">root</font> wenn Du een "
"vun de Bestlüüd op dien Reekner büst.</qt>"

#: field.cpp:29
msgid "Elapsed time"
msgstr "Vegahne tiet"

