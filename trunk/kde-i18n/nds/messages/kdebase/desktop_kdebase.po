#: kdebase/drkonqi/presets/developerrc:1
msgid ""
"Name=The application %progname (%appname), pid %pid, crashed and caused the "
"signal %signum (%signame)."
msgstr ""
"Name=Dat Programm %progname (%appname), pid %pid, is afstört un hett dat "
"Signaal %signum (%signame) geven."

#: kdebase/drkonqi/presets/developerrc:1
msgid "Name=You might want to fix your program. Take a look at the backtrace tab."
msgstr ""
"Name=Villicht wullt Du dat Programm utbetern (laten). Denn kiek maal op de "
"Siet \"Fehlerspoor\"."

