#: kwriteconfig.cpp:19
msgid "Use <file> instead of global config"
msgstr "Bruuk <Datei> ansteed vun de globaale Instellen"

#: kwriteconfig.cpp:20
msgid "Group to look in"
msgstr "Grupp to't Nakieken"

#: kwriteconfig.cpp:21
msgid "Key to look for"
msgstr "Slötel, de söcht warrt"

#: kwriteconfig.cpp:22
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"Typ vun de Variable. Bruuk \"bool\" för'n Boolsche, wenn nich warrt dat "
"as'n Tekenkeed behannelt"

#: kwriteconfig.cpp:23
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr ""
"De Weert, de schreven warrn schall. Mutt angeven warrn, op'n Konsool kannst "
"du tweemaal Apostrof (&raquo;'&laquo;), also &raquo;''&laquo; bruken, üm'n "
"leddig Weert antogeven"

#: kwriteconfig.cpp:28
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:30
msgid "Write KConfig entries - for use in shell scripts"
msgstr "KConfig-Indrääg schrieven - to bruken in Konsoolskripten"

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Sönke Dibbern"

