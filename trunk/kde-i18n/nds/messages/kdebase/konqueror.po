msgid ""
"<A HREF=\"%1\">DOM</A> (Level 1, partially Level 2) based <A "
"HREF=\"%2\">HTML 4.01</A>"
msgstr ""
"<A HREF=\"%2\">HTML 4.01</A> brukt <A HREF=\"%1\">DOM</A> (Level 1, to'n "
"Deel Level 2)"

