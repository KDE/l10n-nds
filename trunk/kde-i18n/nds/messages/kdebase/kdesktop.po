#: lock/lockdlg.cc:76
msgid "<nobr><b>The session is locked</b><br>"
msgstr "<nobr><b>De Törn is afslaten</b><br>"

#: lock/lockdlg.cc:77
msgid "<nobr><b>The session is locked by %1</b><br>"
msgstr "<nobr><b>%1 hett den Törn afslaten</b><br>"

#: lock/lockdlg.cc:87
msgid "&Start New Session..."
msgstr "Niegen Törn &starten..."

#: lock/lockdlg.cc:188
msgid "<b>Unlocking failed</b>"
msgstr "<b>Dat Opsluten is scheefgahn</b>"

#: lock/lockdlg.cc:194
msgid "<b>Warning: Caps Lock on</b>"
msgstr "<b>Wohrschoen: De Fastholl-Tast is an</b>"

#: lock/lockdlg.cc:420
msgid ""
"Cannot unlock the session because the authentication system failed to work.\n"
"You must kill kdesktop_lock (pid %1) manually."
msgstr ""
"Kann den Törn nich opsluten. Dat Passwoort-Systeem geiht nich.\n"
"Man Du kannst kdesktop_lock (PID %1) vun Hand doot maken."

#: lock/lockdlg.cc:518
msgid ""
"You have chosen to open another desktop session instead of resuming the "
"current one."
"<br>The current session will be hidden and a new login screen will be "
"displayed."
"<br>An F-key is assigned to each session; F%1 is usually assigned to the "
"first session, F%2 to the second session and so on. You can switch between "
"sessions by pressing CTRL, ALT and the appropriate F-key at the same time."
msgstr ""
"Du wullt een annern Schrievdischtörn opmaken, stats na den aktuellen "
"torüch to gahn. "
"<br>De aktuelle Törn warrt verstekt un een niegen Anmell-Scherm wiest. "
"<br>För jeden Törn gifft dat een Funktschoons-Tast; F%1 is för den "
"eersten Törn, F%2 för den tweeten usw. Mit STRG, ALT un de passenden "
"Funktschoons-Tast kannst Du mang den Törns wesseln."

#: krootwm.cc:748 lock/lockdlg.cc:529
msgid "&Start New Session"
msgstr "Niegen Törn &starten"

#: lock/lockprocess.cc:659
