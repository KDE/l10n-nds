#: effectoptionsdialog.cpp:225
msgid ""
"<p>Select here the value which represents the tightness of the swirling effect. "
"You get a more dramatic effect as the degrees move from 1 to 360."
msgstr ""
"<p>Hier kannst Du den Dreihweert vun den Küsel fastleggen. Bi Weerten dichter "
"bi 360 Graad warrt de Effekt dramaatscher."

#: effectoptionsdialog.cpp:234
msgid "Amplitude:"
msgstr "Bülghööchde:"

#: effectoptionsdialog.cpp:238
msgid "<p>Select here the value which represents the amplitude of the sine wave."
msgstr "<p>Hier kannst Du de Hööchde vun de Sinusbülg fastleggen."

#: effectoptionsdialog.cpp:243
