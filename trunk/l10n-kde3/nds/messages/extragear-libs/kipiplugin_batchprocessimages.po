msgstr "Eenheitlich"

#: filterimagesdialog.cpp:312 filteroptionsdialog.cpp:66
msgid "Multiplicative"
msgstr "Maalnehmen"

#: filterimagesdialog.cpp:313 filteroptionsdialog.cpp:67
msgid "Impulse"
msgstr "Tacken"

#: filterimagesdialog.cpp:314 filteroptionsdialog.cpp:68
msgid "Laplacian"
msgstr "Laplace"

