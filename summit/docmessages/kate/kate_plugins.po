#, no-c-format
msgid "Name"
msgstr "Naam"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:807
#, no-c-format
msgid ""
"This is the name that will be set for the document, and displayed in the "
"file list and title bar. If the name contains <userinput>%N</userinput> that "
"will be replaced with a number, increasing if more documents has the same "
"name."
msgstr ""

#. Tag: varname
#. +> trunk stable
#: plugins.docbook:814
#, no-c-format
msgid "Highlight"
msgstr "Rutheven"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:815
#, no-c-format
msgid ""
