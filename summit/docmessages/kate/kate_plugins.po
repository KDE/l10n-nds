msgstr "Koppel"

#. Tag: para
#. +> trunk stable
#: plugins.docbook:802
#, no-c-format
msgid ""
"The group places the template in a submenu of the <menuchoice><guimenu>File</"
"guimenu><guimenuitem>New from Template</guimenuitem></menuchoice> menu."
msgstr ""

#. Tag: varname
#. +> trunk stable
