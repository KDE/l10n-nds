msgstr ""

#. Tag: para
#. +> trunk stable
#: menus.docbook:106
#, no-c-format
msgid ""
"This command <action>saves your file</action>. Use it often. If the file is "
"<emphasis>Untitled</emphasis> then <guimenuitem>Save</guimenuitem> becomes "
"<guimenuitem>Save As</guimenuitem>."
msgstr ""

