"of this variable. The value should be the name, as found in the "
"<menuchoice><guimenu>Tools</guimenu> <guimenuitem>Highlighting</guimenuitem> "
"</menuchoice>."
msgstr ""

#. Tag: varname
#. +> trunk stable
