#. Tag: para
#: plugins.docbook:208
#, no-c-format
msgid "User-defined text expansions."
msgstr ""

#. Tag: para
#: plugins.docbook:210
#, no-c-format
msgid ""
"Each text expansion is a simple function which must return a string. This "
"string will be inserted into a document by the <command>expandAtCursor</"
"command> action. For example, if you have a function <quote>foo</quote> in "
"the <filename>all.expand</filename> file which is defined as:"
msgstr ""

#. Tag: programlisting
#: plugins.docbook:215
#, no-c-format
msgid ""
"def foo:\n"
"  return 'Hello from foo!'"
msgstr ""

#. Tag: para
#: plugins.docbook:217
#, no-c-format
msgid ""
"after typing <quote>foo</quote>, the action will replace <quote>foo</quote> "
"with <quote>Hello from foo!</quote>. The expansion function may have "
"parameters as well. For example, the <filename>text_x-c++src.expand</"
"filename> file contains the <function>cl</function> function which creates a "
"class (or class template). This will expand <quote>cl(test)</quote> into:"
msgstr ""

#. Tag: programlisting
#: plugins.docbook:223
#, no-c-format
msgid ""
"/**\n"
" * \\\\brief Class \\c test\n"
" */\n"
"class test\n"
"{\n"
"public:\n"
"    /// Default constructor\n"
"    explicit test()\n"
"    {\n"
"    }\n"
"    /// Destructor\n"
"    virtual ~test()\n"
"    {\n"
"    }\n"
"};"
msgstr ""

#. Tag: para
#: plugins.docbook:225
#, no-c-format
msgid "but <quote>cl(test, T1, T2, T3)</quote> will expand to:"
msgstr ""

#. Tag: programlisting
#: plugins.docbook:227
#, no-c-format
msgid ""
"/**\n"
" * \\\\brief Class \\c test\n"
" */\n"
"template &lt;typename T1, typename T2, typename T3&gt;\n"
"class test\n"
"{\n"
"public:\n"
"    /// Default constructor\n"
"    explicit test()\n"
"    {\n"
"    }\n"
"    /// Destructor\n"
"    virtual ~test()\n"
"    {\n"
"    }\n"
"};"
msgstr ""

