#. Tag: term
#: index.docbook:3408
#, no-c-format
msgid ""
"<menuchoice> <shortcut><keycombo action=\"simul\">&Ctrl;<keycap>I</keycap> </"
"keycombo> </shortcut> <guimenu>View</guimenu> <guimenuitem>View Document "
"Information</guimenuitem></menuchoice> (Browser mode - KHTML view)"
msgstr ""

