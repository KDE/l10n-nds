#. (itstool) path: component/developer_name
#: org.kde.kmail2.appdata.xml:6
msgid "The KDE Community"
msgstr ""

#. (itstool) path: component/name
#: org.kde.kmail2.appdata.xml:7
msgid "KMail"
msgstr "KMail"

#. (itstool) path: component/summary
#: org.kde.kmail2.appdata.xml:8
msgid "A feature-rich email application"
msgstr ""

#. (itstool) path: description/p
#: org.kde.kmail2.appdata.xml:10
msgid ""
"KMail is a state-of-the-art email client that integrates well with widely "
"used email providers like GMail. It provides many tools and features to "
"maximize your productivity and makes working with large email accounts easy "
"and fast. KMail supports a large variety of email protocols - POP3, IMAP, "
"Microsoft Exchange (EWS) and more."
msgstr ""

#. (itstool) path: description/p
#: org.kde.kmail2.appdata.xml:13
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#: org.kde.kmail2.appdata.xml:15
msgid ""
"Secure - KMail has secure default settings to protect your privacy, great "
"end-to-end encryption support, and spam detection."
msgstr ""

#. (itstool) path: ul/li
#: org.kde.kmail2.appdata.xml:16
msgid ""
"Powerful - Features include offline support, multiple sender identities, "
"multi-language support, powerful filtering, searching and tagging "
"functionality, mailing list management and very flexible configuration."
msgstr ""

#. (itstool) path: ul/li
#: org.kde.kmail2.appdata.xml:17
msgid ""
"Integrated - Meeting invitations can be easily added as events into "
"KOrganizer, address auto-completion, avatars and crypto preferences are "
"loaded from KAddressBook."
msgstr ""

#. (itstool) path: ul/li
#: org.kde.kmail2.appdata.xml:18
msgid ""
"Standard Compliant - Supports standard mail protocols, push email, server-"
"side filtering and inline OpenPGP, PGP/MIME and S/MIME."
msgstr ""

#~ msgid ""
#~ "KMail is the email component of Kontact, the integrated personal "
#~ "information manager from KDE."
#~ msgstr ""
#~ "KMail is de Nettpostkomponent vun Kontact, KDE sien inbuut Pleger för "
#~ "persöönlich Informatschonen"

#~ msgid "Supports the standard mail protocols IMAP, POP3 and SMTP."
#~ msgstr "Ünnerstütt de Standard-Nettpostprotokollen IMAP, POP3 un SMTP."

#~ msgid ""
#~ "Supports authentication via NTLM (Microsoft Windows) and GSSAPI (Kerberos)"
#~ msgstr ""
#~ "Ünnerstütt de Identiteetprööv över NTLM (Windows) un GSSAPI (Kerberos)."

#~ msgid "Supports plain text and secure logins, using SSL and TLS."
#~ msgstr "Ünnerstütt dat Anmellen mit Eenfachtext un mit seker SSL un TLS."

#~ msgid ""
#~ "Integration of international character sets and spell-checking (as-you-"
#~ "type and on demand)"
#~ msgstr ""
#~ "Inbuut internatschonaal Tekensetten un Schriefwiesprööv (bi't Tippen un "
#~ "op Anföddern)"

#~ msgid "Native support for inline OpenPGP, PGP/MIME, and S/MIME."
#~ msgstr "Inbuut Ünnerstütten för OpenPGP, PGP/MIME un S/MIME"

#~ msgid "Reading and writing of HTML mail."
#~ msgstr "HTML-Nettbreven wiesen un schrieven."

#~ msgid "Ability to display plain text only from an HTML mail."
#~ msgstr "Kann HTML-Nettbreven as Eenfachtext wiesen."

#~ msgid "Allows you to receive and accept invitations."
#~ msgstr "Inladen laat sik dor mit kriegen un ok annehmen"

#~ msgid ""
#~ "Integration with popular spam checkers, e.g. SpamAssassin, Bogofilter, "
#~ "etc."
#~ msgstr ""
#~ "Arbeidt mit faken bruukt Warven-Pröövprogrammen as SpamAssassin oder "
#~ "Bogofilter tosamen."

#~ msgid "An optional spam probability meter can be displayed"
#~ msgstr ""
#~ "Köörwies lett sik en Maat wiesen, wo wohrschienlich de Nettbreef Warven is"

#~ msgid "Powerful search and filter abilities"
#~ msgstr "Deegte Söök un Filtern"

#~ msgid "Can import mail from many other clients"
#~ msgstr "Kann Nettbreven ut en Barg anner Nettpostprogrammen importeren"

#~ msgid "Searching in IMAP folders fully supported"
#~ msgstr "Söken binnen IMAP-Ornern warrt heel ünnerstütt"

#~ msgid "Highly integrated with other Kontact components"
#~ msgstr "Arbeidt drang mit anner Kontact-Komponenten tosamen"

#~ msgid "Encrypted password saving in KWallet"
#~ msgstr "Passwöör warrt verslötelt binnen KWallet wohrt"

#~ msgid ""
#~ "Flagging and tagging of messages to aid sorting and recovery of "
#~ "information"
#~ msgstr ""
#~ "Narichten laat sik markeren un dor laat sik Slötelwöör na tofögen; de "
#~ "Narichten laat sik denn beter sorteren un Informatschonen beter finnen"

#~ msgid "Supports mailing list management features"
#~ msgstr "Funkschonen för't Plegen vun Nettpostlisten sünd al inbuut"

#~ msgid "Can replace text smilies with emoticons"
#~ msgstr "Kann för Text-Snuten Biller insetten"

#~ msgid ""
#~ "Displays the sender's picture or avatar if present in the address book"
#~ msgstr ""
#~ "Wiest den Senner sien Bild oder Bildteken, wenn dat een binnen dat "
#~ "Adressbook gifft"

#~ msgid "Supports X-Face (b/w pictures in messages)"
#~ msgstr "Ünnerstütt X-Face (Swattwitt-Biller binnen Narichten)"

#~ msgid "Compression of attachments"
#~ msgstr "Komprimeren vun Bilagen"

#~ msgid "KMail supports Groupware functionality."
#~ msgstr "KMail ünnerstütt Arbeitkoppel-Funkschonen."
