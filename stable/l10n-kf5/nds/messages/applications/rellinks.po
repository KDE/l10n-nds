msgstr "<p>Dit Menü wiest na de Kapitels vun dat Dokment.</p>"

#: plugin_rellinks.cpp:145
#, kde-format
msgid "Sections"
msgstr "Afsnitten"

#: plugin_rellinks.cpp:151
#, kde-format
