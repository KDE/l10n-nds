msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Manfred Wiese, Sönke Dibbern"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "m.j.wiese@web.de, s_dibbern@web.de"

#: plugin_rellinks.cpp:64
#, kde-format
msgid "Rellinks"
msgstr "Rellinks"

#: plugin_rellinks.cpp:72
#, kde-format
msgid "&Top"
msgstr "&Baven"

#: plugin_rellinks.cpp:75
#, kde-format
msgid "<p>This link references a home page or the top of some hierarchy.</p>"
msgstr ""
"<p>Disse Link wiest na en Tohuussiet oder de böverst Evene vun en Struktuur."
"</p>"

#: plugin_rellinks.cpp:79
#, kde-format
msgid "&Up"
msgstr "&Na baven"

#: plugin_rellinks.cpp:82
#, kde-format
msgid ""
"<p>This link references the immediate parent of the current document.</p>"
msgstr ""
"<p>Disse Link wiest direktemang na dat överornte Element vun dat aktuelle "
"Dokment.</p>"

#: plugin_rellinks.cpp:88
#, kde-format
msgid "&First"
msgstr "&Eerst"

#: plugin_rellinks.cpp:91
#, kde-format
msgid ""
"<p>This link type tells search engines which document is considered by the "
"author to be the starting point of the collection.</p>"
msgstr ""
"<p>Disse Link vertellt Söökmaschinen, welk Dokment sik de Autor as "
"Startpunkt vun en Reeg dacht hett.</p>"

#: plugin_rellinks.cpp:95
#, kde-format
msgid "&Previous"
msgstr "&Verleden"

#: plugin_rellinks.cpp:98
#, kde-format
msgid ""
"<p>This link references the previous document in an ordered series of "
"documents.</p>"
msgstr ""
"<p>Disse Link wiest na dat verleden Dokment vun en ornt Reeg vun Dokmenten.</"
"p>"

#: plugin_rellinks.cpp:102
#, kde-format
msgid "&Next"
msgstr "&Nakamen"

#: plugin_rellinks.cpp:105
#, kde-format
msgid ""
"<p>This link references the next document in an ordered series of documents."
"</p>"
msgstr ""
"<p>Disse Link wiest na dat nakamen Dokment vun en ornt Reeg vun Dokmenten.</"
"p>"

#: plugin_rellinks.cpp:109
#, kde-format
msgid "&Last"
msgstr "&Verleden"

#: plugin_rellinks.cpp:112
#, kde-format
msgid "<p>This link references the end of a sequence of documents.</p>"
msgstr "<p>Disse Link wiest na dat leste ut en Reeg vun Dokmenten.</p>"

#: plugin_rellinks.cpp:117
#, kde-format
msgid "&Search"
msgstr "&Söken"

#: plugin_rellinks.cpp:120
#, kde-format
msgid "<p>This link references the search.</p>"
msgstr "<p>Disse Link wiest na de Söök</p>"

#: plugin_rellinks.cpp:124
#, kde-format
msgid "Document"
msgstr "Dokment"

#: plugin_rellinks.cpp:126
#, kde-format
msgid "<p>This menu contains the links referring the document information.</p>"
msgstr "<p>Dit Menü bargt de Links na de Dokmentinformatschonen.</p>"

#: plugin_rellinks.cpp:130
#, kde-format
msgid "Table of &Contents"
msgstr "&Inholtverteken"

#: plugin_rellinks.cpp:132
#, kde-format
msgid "<p>This link references the table of contents.</p>"
msgstr "<p>Disse Link wiest na dat Inholtverteken.</p>"

#: plugin_rellinks.cpp:136
#, kde-format
msgid "Chapters"
msgstr "Kapitels"

#: plugin_rellinks.cpp:141
#, kde-format
msgid "<p>This menu references the chapters of the document.</p>"
msgstr "<p>Dit Menü wiest na de Kapitels vun dat Dokment.</p>"

#: plugin_rellinks.cpp:144
#, kde-format
msgid "Sections"
msgstr "Afsnitten"

#: plugin_rellinks.cpp:150
#, kde-format
msgid "<p>This menu references the sections of the document.</p>"
msgstr "<p>Dit Menü wiest na de Afsnitten vun dat Dokment.</p>"

#: plugin_rellinks.cpp:153
#, kde-format
msgid "Subsections"
msgstr "Ünnerafsnitten"

#: plugin_rellinks.cpp:158
#, kde-format
msgid "<p>This menu references the subsections of the document.</p>"
msgstr "<p>Dit Menü wiest na de Ünnerafsnitten vun dat Dokment.</p>"

#: plugin_rellinks.cpp:161
#, kde-format
msgid "Appendix"
msgstr "Anhang"

#: plugin_rellinks.cpp:166
#, kde-format
msgid "<p>This link references the appendix.</p>"
msgstr "<p>Disse Link wiest na den Anhang.</p>"

#: plugin_rellinks.cpp:170
#, kde-format
msgid "&Glossary"
msgstr "Beg&reeplist"

#: plugin_rellinks.cpp:172
#, kde-format
msgid "<p>This link references the glossary.</p>"
msgstr "<p>Disse Link wiest na de Begreeplist.</p>"

#: plugin_rellinks.cpp:177
#, kde-format
msgid "&Index"
msgstr "&Index"

#: plugin_rellinks.cpp:179
#, kde-format
msgid "<p>This link references the index.</p>"
msgstr "<p>Disse Link wiest na den Index.</p>"

#: plugin_rellinks.cpp:184
#, kde-format
msgid "More"
msgstr "Mehr"

#: plugin_rellinks.cpp:186
#, kde-format
msgid "<p>This menu contains other important links.</p>"
msgstr "<p>Dit Menü bargt anner wichtige Links.</p>"

#: plugin_rellinks.cpp:190
#, kde-format
msgid "&Help"
msgstr "&Hülp"

#: plugin_rellinks.cpp:193
#, kde-format
msgid "<p>This link references the help.</p>"
msgstr "<p>Disse Link wiest na de Hülp.</p>"

#: plugin_rellinks.cpp:198
#, kde-format
msgid "&Authors"
msgstr "&Autoren"

#: plugin_rellinks.cpp:201
#, kde-format
msgid "<p>This link references the author.</p>"
msgstr "<p>Disse Link wiest na den Autor.</p>"

#: plugin_rellinks.cpp:206
#, kde-format
msgid "Copy&right"
msgstr "&Copyright"

#: plugin_rellinks.cpp:209
#, kde-format
msgid "<p>This link references the copyright.</p>"
msgstr "<p>Disse Link wiest na de Kopeerverlöven.</p>"

#: plugin_rellinks.cpp:213
#, kde-format
msgid "Bookmarks"
msgstr "Leestekens"

#: plugin_rellinks.cpp:216
#, kde-format
