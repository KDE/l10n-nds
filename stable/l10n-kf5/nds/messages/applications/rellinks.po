#, kde-format
msgid "Appendix"
msgstr "Anhang"

#: plugin_rellinks.cpp:167
#, kde-format
msgid "<p>This link references the appendix.</p>"
msgstr "<p>Disse Link wiest na den Anhang.</p>"

#: plugin_rellinks.cpp:171
#, kde-format
msgid "&Glossary"
msgstr "Beg&reeplist"

#: plugin_rellinks.cpp:173
#, kde-format
msgid "<p>This link references the glossary.</p>"
msgstr "<p>Disse Link wiest na de Begreeplist.</p>"

#: plugin_rellinks.cpp:178
#, kde-format
msgid "&Index"
msgstr "&Index"

#: plugin_rellinks.cpp:180
#, kde-format
msgid "<p>This link references the index.</p>"
msgstr "<p>Disse Link wiest na den Index.</p>"

#: plugin_rellinks.cpp:185
#, kde-format
msgid "More"
msgstr "Mehr"

#: plugin_rellinks.cpp:187
#, kde-format
