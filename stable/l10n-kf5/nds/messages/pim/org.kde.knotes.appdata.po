#. (itstool) path: component/summary
#: org.kde.knotes.appdata.xml:8
msgid "Sticky notes application"
msgstr ""

#. (itstool) path: description/p
#: org.kde.knotes.appdata.xml:10
msgid ""
"KNotes is a program that lets you write the computer equivalent of sticky "
"notes. The notes are saved automatically when you exit the program, and they "
"display when you open the program."
msgstr ""
"Mit KNotes kannst Du so wat as Anback-Notizen för den Reekner maken. De "
"Notizen warrt bi't Utmaken vun't Programm automaatsch sekert un wedder "
"wiest, wenn Du dat Programm wedder opröppst."

#. (itstool) path: description/p
#: org.kde.knotes.appdata.xml:14
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#: org.kde.knotes.appdata.xml:16
msgid "Write notes in your choice of font and background color"
msgstr "De Notizen mit Dien Schriftoort un Achtergrundklöör schrieven"

#. (itstool) path: ul/li
#: org.kde.knotes.appdata.xml:17
msgid "Use drag and drop to email your notes"
msgstr "Notizen över Trecken un Afleggen mit Nettpost loosstüern"

#. (itstool) path: ul/li
#: org.kde.knotes.appdata.xml:18
msgid "Can be dragged into Calendar to book a time-slot"
msgstr "Laat sik na den Kalenner trecken, wat en Stoot Tiet reserveren deit"

#. (itstool) path: ul/li
#: org.kde.knotes.appdata.xml:19
msgid "Notes can be printed"
msgstr "Notizen laat sik drucken"
