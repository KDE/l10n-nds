#: configdialog.cpp:35
#, kde-format
msgid "Select a KMail Mail folder"
msgstr "En KMail-Nettpostorner utsöken"

#: configdialog.cpp:62
#, kde-format
msgid "The selected path is empty."
msgstr "De utsöchte Padd is leddig."

#: configdialog.cpp:75
#, kde-format
msgid "The selected path contains valid Maildir folders."
msgstr "De utsöchte Padd bargt gellen Nettpostornern."

