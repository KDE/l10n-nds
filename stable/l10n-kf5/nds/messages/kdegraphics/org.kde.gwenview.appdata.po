#. (itstool) path: component/name
#: org.kde.gwenview.appdata.xml:6
msgid "Gwenview"
msgstr "Gwenview"

#. (itstool) path: description/p
#: org.kde.gwenview.appdata.xml:8
msgid "Gwenview is a fast and easy to use image viewer for KDE."
msgstr "Gwenview is en gau Bildkieker för KDE, de sik eenfach bruken lett."

#. (itstool) path: description/p
#: org.kde.gwenview.appdata.xml:11
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:13
msgid "Supports simple image manipulations: rotate, mirror, flip, and resize"
msgstr ""
"Ünnerstütt eenfach Bildbewerken: Dreihen, Spegeln, Ümdreihen und Grött "
"topassen"

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:14
msgid ""
"Supports basic file management actions such as copy, move, delete, and others"
msgstr ""
"Ünnerstütt eenfach Dateipleegakschonen as Koperen, Verschuven, Wegdoon un en "
"poor anner."

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:15
msgid ""
"Functions both as a standalone application and an embedded viewer in the "
"Konqueror web browser"
msgstr "Funkscheneert för sik oder inbett na den Nettkieker Konqueror"

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:16
msgid "Can be extended using KIPI plugins."
msgstr "Laat sik mit KIPI-Modulen verwiedern"
