#: powerdevil.notifyrc:2
msgctxt "Name"
msgid "KDE Power Management System"
msgstr "Stroomkuntrullsysteem för KDE"

#: powerdevil.notifyrc:47
msgctxt "Comment"
msgid "Power Management System"
msgstr "Stroompleegsysteem"

#: powerdevil.notifyrc:93
msgctxt "Name"
msgid "Warning"
msgstr "Wohrschoen"

#: powerdevil.notifyrc:137
msgctxt "Comment"
msgid "Used for warning notifications"
msgstr "Bi Wohrschoen bruukt"

#: powerdevil.notifyrc:181
msgctxt "Name"
msgid "Notification"
msgstr "Bescheed"

#: powerdevil.notifyrc:225
msgctxt "Comment"
msgid "Used for standard notifications"
msgstr "Bi Standardbescheden bruukt"

#: powerdevil.notifyrc:270
msgctxt "Name"
msgid "Critical notification"
msgstr "Kritisch Bescheed"

#: powerdevil.notifyrc:313
msgctxt "Comment"
msgid "Notifies a critical event"
msgstr "Gifft över en kritisch Begeefnis bescheed"

#: powerdevil.notifyrc:358
msgctxt "Name"
msgid "Battery Low"
msgstr "Batterie siet"

#: powerdevil.notifyrc:401
msgctxt "Comment"
msgid "Your battery has reached low level"
msgstr "Dien Batteriestoop is nu \"Siet\""

#: powerdevil.notifyrc:451
msgctxt "Name"
msgid "Battery Critical"
msgstr "Batterie kritisch"

#: powerdevil.notifyrc:494
msgctxt "Comment"
msgid ""
"Your battery has reached critical level. This notification triggers a "
"countdown before doing the configured action, hence it is strongly advised "
"to leave that on."
msgstr ""
"Dien Batterie is bi de kritische Stoop ankamen. Disse Bescheed tellt en Tiet "
"daal, ehr he de instellte Akschoon utföhrt, laat em also beter an."

#: powerdevil.notifyrc:543
msgctxt "Name"
msgid "Charge Complete"
msgstr "Opladen afslaten"

#: powerdevil.notifyrc:586
msgctxt "Comment"
msgid "The battery is fully charged"
msgstr "De Batterie is heel laadt"

#: powerdevil.notifyrc:635
msgctxt "Name"
msgid "AC adaptor plugged in"
msgstr "Stroomkavel tokoppelt"

#: powerdevil.notifyrc:679
msgctxt "Comment"
