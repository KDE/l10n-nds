#. (itstool) path: component/name
#: blogilo.appdata.xml:6
msgid "Blogilo"
msgstr "Blogilo"

#. (itstool) path: component/summary
#: blogilo.appdata.xml:7
msgid "A KDE Blogging Client"
msgstr "En Nettdaagbook-Programm för KDE"

#. (itstool) path: description/p
#: blogilo.appdata.xml:9
msgid ""
"Blogilo is a blogging client for KDE, which supports various blogging APIs."
msgstr ""
"Blogilo is en Nettdaagbook-Client för KDE, de en Reeg Nettdaagbook-APIs "
"ünnerstütten deit."

#. (itstool) path: description/p
#: blogilo.appdata.xml:10
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#: blogilo.appdata.xml:12
msgid "A full featured WYSIWYG editor + An HTML editor"
msgstr "En WYSIWYG-Editor mit all Funkschonen un en HTML-Editor"

#. (itstool) path: ul/li
#: blogilo.appdata.xml:13
msgid "Previewing your post with your blog style"
msgstr "Dien Bidrag mit Dien Stil vörweg ankieken"

#. (itstool) path: ul/li
#: blogilo.appdata.xml:14
msgid ""
"Support for Blogger1.0, MetaWeblog, MovableType (Wordpress supports All of "
"these!) and Google GData (used on Blogspot.com blogs) APIs"
msgstr ""
"Ünnerstütt de Blogger1.0-, MetaWeblog-, MovableType-APIs (Wordpress "
"ünnerstütt de all!) un de GData-API (bruukt op Blogspot.com-Nettdaagböker)"

#. (itstool) path: ul/li
#: blogilo.appdata.xml:15
msgid "Support for Creating/Modifying/Deleting posts."
msgstr "Ünnerstütt dat Opstellen, Ännern un Wegdoon vun Bidrääg."

#. (itstool) path: ul/li
#: blogilo.appdata.xml:16
msgid "Support for creating drafts and scheduled posts"
msgstr "Ünnerstütt dat Opstellen vun Vörverschonen un tietplaant Bidrääg."

#. (itstool) path: ul/li
#: blogilo.appdata.xml:17
msgid ""
"Support for uploading media files to your blog (Just on supported APIs e.g. "
"MetaWeblog and MovableType)"
msgstr ""
"Ünnerstütt dat Hoochladen vun Mediendateien na Dien Nettdaagbook (bloots bi "
"ünnerstütten APIs as MetaWeblog un MovableType)."

#. (itstool) path: ul/li
#: blogilo.appdata.xml:18
msgid "Support for Fetching your recent blog entries."
msgstr "Ünnerstütt dat Halen vun Dien niegst Nettdaagbook-Indrääg."

#. (itstool) path: ul/li
#: blogilo.appdata.xml:19
msgid ""
"Support for adding Images to post from your system. It will upload them on "
"Submitting post to blog (Just on supported APIs e.g. MetaWeblog and "
"MovableType)"
msgstr ""
"Ünnerstütt dat Tofögen vun Biller na Bidrääg vun Dien Reekner ut. Se warrt "
"bi't Hoochladen vun den Bidrag na't Nettdaagbook mit hoochlaadt (bloots bi "
"ünnerstütten APIs as MetaWeblog un MovableType)."

#. (itstool) path: ul/li
#: blogilo.appdata.xml:20
msgid "Support for saving local entries before publishing."
msgstr "Ünnerstütt dat lokale Sekern vun Indrääg ehr Du ehr apenmaakst."

#. (itstool) path: ul/li
#: blogilo.appdata.xml:21
msgid ""
"Saving your writing copy to prevent data loss, at configurable intervals."
msgstr ""
"Sekert Dien Texten bi't Schrieven na en instellbor Tiet, so kaamt Di keen "
"Daten weg."

#. (itstool) path: ul/li
#: blogilo.appdata.xml:22
msgid ""
"Internal auto spell checker. (KDE spell checker used so most of languages "
"are supported)"
msgstr ""
"Intern automaatsch Klookschriever (KDE sien Klookschriever, also warrt de "
"mehrsten Spraken ünnerstütt)"
