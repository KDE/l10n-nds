#. (itstool) path: component/name
#: kalarm.appdata.xml:6
msgid "KAlarm"
msgstr "KAlarm"

#. (itstool) path: component/summary
#: kalarm.appdata.xml:7
msgid "Personal Alarm Scheduler"
msgstr "Persöönlich Anstöötgever"

#. (itstool) path: description/p
#: kalarm.appdata.xml:9
msgid "KAlarm is a personal alarm message, command and email scheduler"
msgstr ""
"KAlarm is en persöönlich Planer för Anstootnarichten, Befehlen un Nettbreven."

#. (itstool) path: description/p
#: kalarm.appdata.xml:10
msgid "Features:"
msgstr "Markmalen:"

#. (itstool) path: ul/li
#: kalarm.appdata.xml:12
msgid ""
"Display alarms using your own text message, the text generated by a command, "
"or a text or image file."
msgstr ""
"Anstööt mit Dien egen oder vun en Programm opstellt Texten oder en Text- "
"oder Bilddatei wiesen"

#. (itstool) path: ul/li
#: kalarm.appdata.xml:13
msgid "Audible alarm using a sound file"
msgstr "Höörbor Anstööt mit en Klangdatei"

#. (itstool) path: ul/li
#: kalarm.appdata.xml:14
msgid ""
"Recurring alarm on an hours/minutes, daily, weekly, monthly or annual basis, "
"or set it to trigger every time you log in."
msgstr ""
"Wedderkamen Anstööt na Stünnen/Minuten, na Daag, Weken, Maanden oder elk "
"Johr, oder jümmers, wenn Du Di anmellen deist."

#. (itstool) path: ul/li
#: kalarm.appdata.xml:15
msgid "Display alarms color and font customization"
msgstr "Instellbor Anstootklöör un -Schriftoort"

#. (itstool) path: ul/li
#: kalarm.appdata.xml:16
msgid ""
"Support for multiple alarm calendars, which for example enables you to share "
"alarms between a laptop and desktop computer."
msgstr ""
"Ünnerstütt en Reeg Anstootkalenners, so kannst Du Anstööt twischen Klapp- un "
"normaal Reekner uttuschen."
