#: executor/main.cpp:47
msgid ""
"Executor is a component of the Kommander dialog system that executes .kmdr "
"files given as arguments or via stdin"
msgstr ""
"\"Executor\" is en Komponent vun dat Dialoogsysteem vun \"Kommander\", de as "
"Argumenten oder per Standardingaav angeven .kmdr-Dateien utföhrt."

#: executor/main.cpp:52
msgid "Read dialog from standard input"
msgstr "Dialoog ut Standardutgaav lesen"

#: executor/main.cpp:53
msgid "Use given catalog for translation"
msgstr "Den angeven Kataloog för de Översetten bruken"

#: executor/main.cpp:60
msgid "Kommander Executor"
msgstr "Kommander-Executor"

#: executor/main.cpp:95
msgid ""
"Error: no dialog given. Use --stdin option to read dialog from standard input.\n"
msgstr ""
"Fehler: keen Dialoog angeven. Bruuk de Optschoon \"--stdin\", wenn Du den "
"Dialoog ut de Standardutgaav lesen wullt.\n"

#: executor/instance.cpp:87
msgid "<qt>Kommander file<br><b>%1</b><br>does not exist.</qt>"
msgstr "<qt> Kommander-Datei<br>%1<b></b><br>gifft dat nich.</qt>"

#: executor/instance.cpp:97
msgid "<qt>Unable to create dialog from file<br><b>%1</b></qt>"
msgstr "<qt>Ut de Datei<br><b>%1</b> lett sik keen Dialoog opstellen.</qt>"

#: executor/instance.cpp:124
msgid "Unable to create dialog from input."
msgstr "Ut de Ingaav lett sik keen Dialoog opstellen."

#: executor/instance.cpp:136
msgid ""
"<qt>This file does not have a <b>.kmdr</b> extension. As a security precaution "
"Kommander will only run Kommander scripts with a clear identity.</qt>"
msgstr ""
"<qt>Disse Datei hett keen <b>.kmdr</b>-Verwiedern. Ut Sekerheitgrünn föhrt "
"Kommander bloots Skripten mit eensoortet Identiteet ut.</qt>"

#: executor/instance.cpp:138
msgid "Wrong Extension"
msgstr "Leeg Verwiedern"

#: executor/instance.cpp:155
msgid ""
"<qt>This dialog is running from your <i>/tmp</i> directory.  This may mean that "
"it was run from a KMail attachment or from a webpage. "
"<p>Any script contained in this dialog will have write access to all of your "
"home directory; <b>running such dialogs may be dangerous: </b>"
"<p>are you sure you want to continue?</qt>"
msgstr ""
"<qt>Disse Dialoog warrt vun Dien <i>/tmp</i>-Verteken utgeföhrt. Dat kann "
"bedüden, dat em vun en KMail-Anhang oder en Nettsiet start wöör. "
"<p> All Skripten, de disse Dialoog bargt, hebbt Schriefverlöven na allens "
"binnen Dien Tohuus-Orner. <b>Dat Utföhren vun dissen Dialogen kann riskant "
"wesen: </b>"
"<p>Wullt Du redig wiedermaken?</qt>"

#: executor/instance.cpp:159
msgid "Run Nevertheless"
msgstr "Liekers utföhren"

#: executor/register.cpp:64
msgid "Return EOL-separated list of all values in the array."
msgstr ""
"En mit EOL (Reeg-Enn) trennt List mit all Weerten binnen dat Feld torüchgeven."

#: executor/register.cpp:65
msgid "Return EOL-separated list of all keys in the array."
msgstr ""
"En mit EOL (Reeg-Enn) trennt List mit all Slötels binnen dat Feld torüchgeven."

#: executor/register.cpp:66
msgid "Remove all elements from the array."
msgstr "All Elementen ut dat Feld wegmaken."

#: executor/register.cpp:67
msgid "Return number of elements in the array."
msgstr "De Tall vun Elementen binnen dat Feld torüchgeven."

#: executor/register.cpp:68
msgid "Return the value associated with given key."
msgstr "Den to den angeven Slötel tohören Weert torüchgeven."

#: executor/register.cpp:69
msgid "Remove element with given key from the array."
msgstr "Element mit den angeven Slötel un Weert ut dat Feld wegmaken."

#: executor/register.cpp:70
msgid "Add element with given key and value to the array"
msgstr "Element mit den angeven Slötel un Weert na't Feld tofögen"

#: executor/register.cpp:71
msgid ""
"Add all elements in the string to the array. String should have <i>key>"
"\\tvalue\\n</i> format."
msgstr ""
"All Elementen binnen de Tekenkeed na't Feld tofögen. De Tekenkeed mutt in'n "
"Formaat <i>Slötel>\\tWeert\\n</i> wesen."

#: executor/register.cpp:73
msgid ""
"Return all elements in the array in <i>key>\\tvalue\\n</i> format."
msgstr ""
"All Elementen binnen dat Feld in'n Formaat <i>Slötel>\\tWeert\\n</i> "
"torüchgeven."

#: executor/register.cpp:77
msgid "Return number of chars in the string."
msgstr "Torüchgeven, woveel Tekens de Tekenkeed bargt."

#: executor/register.cpp:78
msgid "Check if the string contains given substring."
msgstr "Pröven, wat en Tekenkeed de angeven Deeltekenkeed bargt."

#: executor/register.cpp:79
msgid "Return position of a substring in the string, or -1 if it isn't found."
msgstr ""
"Positschoon vun en Deeltekenkeed torüchgeven, oder -1, wenn se sik nich finnen "
"lett."

#: executor/register.cpp:81
msgid "Return first n chars of the string."
msgstr "De eersten n Tekens vun de Tekenkeed torüchgeven."

#: executor/register.cpp:82
msgid "Return last n chars of the string."
msgstr "De lesten n Tekens vun de Tekenkeed torüchgeven."

#: executor/register.cpp:83
msgid "Return substring of the string, starting from given position."
msgstr ""
"En Deeltekenkeed vun de Tekenkeed ehr angeven Positschoon af torüchgeven."

#: executor/register.cpp:85
msgid "Replace all occurencies of given substring."
msgstr "All Vörkamen vun de angeven Deeltekenkeed utwesseln."

#: executor/register.cpp:86
msgid "Replace all occurencies of given substring with given replacement."
msgstr ""
"All Vörkamen vun en angeven Deeltekenkeed mit en angeven Tuusch-Tekenkeed "
"utwesseln."

#: executor/register.cpp:88
msgid "Convert the string to uppercase."
msgstr "De Tekenkeed na Grootbookstaven ümwanneln."

#: executor/register.cpp:89
msgid "Convert the string to lowercase."
msgstr "De Tekenkeed na Lüttbookstaven ümwanneln."

#: executor/register.cpp:90
msgid ""
"Compare two strings. Return 0 if they are equal, -1 if the first one is lower, "
"1 if the first one is higher"
msgstr ""
"Twee Tekenkeden verglieken. \"0\" torüchgeven, wenn se liek sünd, \"1\", wenn "
"de eerste lütter is, \"1\", wenn de eerste grötter is."

#: executor/register.cpp:92
msgid "Check if string is empty."
msgstr "Pröven, wat en Tekenkeed leddig is."

#: executor/register.cpp:93
msgid "Check if string is a valid number."
msgstr "Pröven, wat en Tekenkeed en gellen Tall is."

#: executor/register.cpp:96
msgid "Return content of given file."
msgstr "Inholt vun en angeven Datei torüchgeven."

#: executor/register.cpp:97
msgid "Write given string to a file."
msgstr "En angeven Tekenkeed na en Datei schrieven."

#: executor/register.cpp:98
msgid "Append given string to the end of a file."
msgstr "De angeven Tekenkeed na't Enn vun en Datei anhangen."

#: widgets/closebutton.cpp:116
msgid "Failed to start shell process."
msgstr "Konsool-Perzess lett sik nich starten."
