#: widget/specials.cpp:24
msgid "Inserts the item if it will not create a duplicate."
msgstr "Föögt dat Element in, wenn dor keen Kopie vun opstellt warrt."

#: widget/specials.cpp:26
msgid ""
"Returns scripts associated with widget. This is an advanced feature that would "
"not be commonly used."
msgstr ""
"Gifft de Skripten torüch, de dat Stüerelement toornt sünd. Dit is en verwiedert "
"Funkschoon, de nich faken bruukt warrt."

#: widget/specials.cpp:27
msgid "Stops execution of the script associated with the widget."
msgstr "Hollt dat Utföhren vun dat dat Stüerelement tohören Skript an."

#: widget/specials.cpp:29
msgid "Returns text of a cell in a table."
msgstr "Gifft den Text vun en Zell ut en Tabell torüch."

#: widget/specials.cpp:31
msgid "Returns 1 for checked boxes, 0 for unchecked."
msgstr "Gifft \"1 för anmaakt, un \"0\" för utmaakt Feller torüch."

#: widget/specials.cpp:33
msgid ""
"Returns the list of child widgets contained in the parent widget. Set the <i>"
"recursive</i> parameter to <i>true</i> to include widgets contained by child "
"widgets."
msgstr ""
"Gifft en List mit ünnerornt Stüerelementen torüch, de dat överornt Stüerelement "
"bargt. Sett den Parameter <i>rekursiv</i> op <i>wohr</i>"
", wenn de binnen de ünnerornt Stüerelementen bargt Stüerelementen inslaten "
"warrn schöölt."

#: widget/specials.cpp:35
msgid "Removes all content from the widget."
msgstr "Deit den helen Inholt vun dat Stüerelement weg."

#: widget/specials.cpp:38
msgid "Returns number of items in a widget such as combobox or listbox."
msgstr ""
"Gifft de Tall vun Indrääg binnen en Stüerelement liek as en Utsöökfeld oder en "
"Listfeld torüch."

#: widget/specials.cpp:40
msgid "Returns index of current column."
msgstr "Gifft den aktuellen Striep sien Index torüch."

#: widget/specials.cpp:42
msgid "Returns index of current item."
msgstr "Gifft den aktuellen Indrag sien Index torüch."

#: widget/specials.cpp:44
msgid "Returns index of current row."
msgstr "Gifft de aktuell Reeg ehr Index torüch."

#: widget/specials.cpp:45
msgid "Executes the script associated with the widget."
msgstr "Föhrt dat dat Element toornt Skript ut."

#: widget/specials.cpp:47
msgid "Returns the index of an item with the given text."
msgstr "Gifft den Index vun en Indrag mit den angeven Text torüch."

#: widget/specials.cpp:49
msgid "Inserts new column (or <i>count</i> columns) at <i>column</i> position."
msgstr ""
"Föögt en nieg Striep (oder <i>count</i>-Striepen) na de Positschoon <i>"
"column</i> in."

#: widget/specials.cpp:51
msgid "Inserts item at <i>index</i> position."
msgstr "Föögt dat Element na Positschoon <i>Index</i> in."

#: widget/specials.cpp:54
msgid "Inserts multiple items (EOL-separated) at <i>index</i> position."
msgstr ""
"Föögt mehr Indrääg (mit Reegenn trennt) na de Positschoon <i>Index</i> in."

#: widget/specials.cpp:57
msgid "Inserts new row (or <i>count</i> rows) at <i>row</i> position."
msgstr ""
"Föögt en nieg Reeg (oder <i>count</i>-Regen) na de Positschoon <i>row</i> in."

#: widget/specials.cpp:59
msgid "Returns the text of the item at the given index."
msgstr "Gifft den Text vun en Indrag an den angeven Index torüch."

#: widget/specials.cpp:61
msgid ""
"Returns the depth of the current item in the tree. Root items have depth 0."
msgstr ""
"Gifft de Deepde vun den aktuellen Indrag binnen den Boom ut. Wörtelindrääg "
"hebbt de Deepde \"0\"."

#: widget/specials.cpp:63
msgid "Returns the slash-separated path to the given item in the tree."
msgstr ""
"Gifft den mit Dwarsstreek trennt Padd na den binnen den Boom angeven Indrag ut."

#: widget/specials.cpp:65
msgid ""
"Removes the column (or <i>count</i> consecutive columns) with the given index."
msgstr ""
"Deit den Striep (oder <i>count</i> Striepen naenanner) mit den angeven Index "
"weg."

#: widget/specials.cpp:67
msgid "Removes the item with the given index."
msgstr "Deit den Indrag mit den angeven Index weg."

#: widget/specials.cpp:70
msgid ""
"Removes the row (or <i>count</i> consecutive rows) with the given index."
msgstr ""
"Deit de Reeg (oder <i>count</i> Regen naenanner) mit den angeven Index weg."

#: widget/specials.cpp:73
msgid "Returns selected text or text of current item."
msgstr ""
"Gifft den markeerten Text oder den Text vun den aktuellen Indrag torüch."

#: widget/specials.cpp:75
msgid ""
"Sets scripts associated with widget. This is an advanced feature that would not "
"be commonly used."
msgstr ""
"Leggt de dat Stüerelement toornt Skripten fast. Dit is en verwiedert "
"Funkschoon, de nich faken bruukt warrt."

#: widget/specials.cpp:77
msgid "Enables or disables widget."
msgstr "Maakt en Stüerelement an oder ut."

#: widget/specials.cpp:80
msgid "Sets text of a cell in a table."
msgstr "Leggt den Text för en Zell binnen en Tabell fast."

#: widget/specials.cpp:82
msgid "Sets/unsets checkbox."
msgstr "Maakt en Ankrüüzfeld an/ut."

#: widget/specials.cpp:84
msgid "Sets caption of the column <i>column</i>."
msgstr "Leggt de Överschrift för den Striep <i>column</i> fast."

#: widget/specials.cpp:86
msgid "Selects the item at the specified index. Indexes are zero based."
msgstr ""
"Söcht den Indrag binnen den angeven Index. Indexen fangt bi \"Null\" an."

#: widget/specials.cpp:89
msgid "Sets maximum numeric value"
msgstr "Leggt den höögst numeersch Weert fast"

#: widget/specials.cpp:91
msgid ""
"Sets pixmap at the given index to the specified icon. Use <i>index = -1</i> "
"to set the pixmap for all items."
msgstr ""
"Leggt dat Kachelbild binnen en angeven Index na dat angeven Lüttbild fast. "
"Bruuk <i>Index = -1</i>, wenn Du dat Kachelbild för all Indrääg fastleggen "
"wullt."

#: widget/specials.cpp:93
msgid "Sets caption of the row <i>row</i>."
msgstr "Leggt de Överschrift för de Reeg <i>row</i> fast.."

#: widget/specials.cpp:95
msgid "Selects given text or select item containing given text."
msgstr "Söcht en angeven Text oder en Indrag ut, de den angeven Text bargt."

#: widget/specials.cpp:98
msgid "Sets widget's content."
msgstr "Leggt den Inholt vun en Stüerelement fast."

#: widget/specials.cpp:101
msgid "Shows/hides widget."
msgstr "Stüerelement wiesen/versteken."

#: widget/specials.cpp:102
msgid "Returns content of widget."
msgstr "Gifft den Inholt vun en Stüerelement torüch."

#: widget/specials.cpp:104
msgid "Returns type(class) of widget."
msgstr "Gifft den Typ (Klass) vun en Stüerelement torüch."

#: widget/specials.cpp:107
msgid ""
"Returns current widget's content. This was required inside widget A to return "
"widget A content when requested by widget B. The new method is to use @A.text "
"inside B instead of just @A if you just want the unaltered text."
msgstr ""
"Gifft den Inholt vun dat aktuelle Stüerelement ut. Dit dee binnen Stüerelement "
"A noot, dormit sik de Inholt vun Stüerelement A torüchgeven lett, wenn "
"Stüerelement B em anfraagt. De niege Metood bruukt @A.text binnen B ansteed vun "
"jüst @A, wenn Du bloots den nich ännert Text hebben wullt."

#: widget/specials.cpp:109
msgid ""
"Returns selected text or text of current item. This is deprecated for <i>"
"@mywidget.selected</i>."
msgstr ""
"Gifft den markeerten Text oder den Text vun den aktuellen Indrag torüch. Dit is "
"wegen <i>@mywidget.selected</i> överhaalt."

#: widget/specials.cpp:111
msgid ""
"Does nothing. This is useful if you request a CheckBox or RadioButton to return "
"a value where a state, typically the unchecked state, has no value. The @null "
"prevents an error indicating it is empty."
msgstr ""
"Deit nix. Dat is goot, wenn Du vun en Ankrüüzfeld oder en Utwahlknoop en Weert "
"utgeven wullt, de in dissen Status (normalerwies in utlaten Status) keen Weert "
"bargt. \"@null\" verhöödt en Fehlermellen, dat de Utgaav leddig is."

#: widget/specials.cpp:113
msgid "Returns the pid (process ID) of the current process."
msgstr "Giifft de Perzess-ID vun den aktuellen Perzess torüch."

#: widget/specials.cpp:115
msgid ""
"Returns DCOP identifier of current process. This is shorthand for <i>"
"kmdr-executor-@pid</i>."
msgstr ""
"Gifft den DCOP-Beteker vun den aktuellen Perzess torüch. Dit is de kort "
"Schriefwies för <i>kmdr-executor-@pid></i>."

#: widget/specials.cpp:118
msgid "Returns the pid of the parent Kommander window."
msgstr "Giifft de Perzess-ID vun dat överornt Kommander-Finster torüch."

#: widget/specials.cpp:120
msgid "Writes <i>text</i> on stderr."
msgstr "Schrievt <i>Text</i> na de Standard-Fehlerutgaav."

#: widget/specials.cpp:122
msgid "Writes <i>text</i> on standard output."
msgstr "Schrievt <i>Text</i> na de Standardutgaav."

#: widget/specials.cpp:124
msgid ""
"Executes a script block. Bash is used if no shell is given. It is primarily for "
"use in non-button widgets where script actions are not expected. Full path is "
"not required for the shell which may be useful for portability. "
"<p><i>If this is used inside a button it allows alternate script languages to "
"be used and will return a value to the main script, which may be unexpected.</i>"
msgstr ""
"Föhrt en Skript-Block ut. As Konsool warrt de Bash bruukt, wenn anners nix "
"angeven wöör. Dit is in de Hööftsaak för Stüerelementen ahn Knööp maakt, binnen "
"de keen Skriptakschonen verwacht warrt. För de Konsool deit de heel Padd nich "
"noot, wat goot för't Porteren is."
"<p><i>Wenn Een dit binnen en Knoop bruukt, laat sik anner Skriptspraken bruken "
"un na dat Hööftskript warrt en nicht verwacht Weert torüchgeven.</i>"

#: widget/specials.cpp:126
msgid ""
"Returns value of an environment (shell) variable. Do not use <i>$</i> "
"in the name. For example, <i>@env(PATH)</i>."
msgstr ""
"Gifft den Weert vun en Ümgevenvariabel (Konsool) torüch. Bruuk keen <i>$</i> "
"binnen den Naam. To'n Bispeel <i>@env(PATH)</i>."

#: widget/specials.cpp:128
msgid "Executes an external shell command."
msgstr "Föhrt en extern Konsoolbefehl ut."

#: widget/specials.cpp:130
msgid "Parses an expression and returns computed value."
msgstr "Leest en Utdruck in un gifft den utreken Weert torüch."

#: widget/specials.cpp:132
msgid ""
"Executes loop: values from <i>items</i> list (passed as EOL-separated string) "
"are assigned to the variable. "
"<br> <i>@forEach(i,A\\nB\\nC\\n)"
"<br>  @# @i=A"
"<br>@endif</i>"
msgstr ""
"Föhrt en Slööp ut: De Variabel warrt Weerten ut de <i>items</i>"
"-List (as mit Regenümbröök trennt Tekenkeed övergeven) toornt. "
"<br> <i>@forEach(i,A\\nB\\nC\\n)"
"<br> @# @i=A"
"<br>@endif</i>"

#: widget/specials.cpp:134
msgid ""
"Executes loop: variable is set to <i>start</i> and is increased by <i>step</i> "
"each time loop is executed. Execution stops when variable becomes larger then "
"<i>end</i>. "
"<br><i>@for(i,1,10,1)"
"<br>  @# @i=1"
"<br>@endif</i>."
msgstr ""
"Föhrt en Slööp ut: De Variabel warrt op <i>start</i> "
"sett un na elk Dörloop een <i>step</i> höger sett. Utföhren warrt beendt, wenn "
"de Weert grötter warrt as <i>end</i>. "
"<br><i>@for(i,1,10,1)"
"<br>  @# @i=1"
"<br>@endif</i>."

#: widget/specials.cpp:136
msgid "Returns the value of a global variable."
msgstr "Gifft den Weert vun en globaal Variabel torüch."

#: widget/specials.cpp:138
msgid ""
"Translates the string into the current language. Texts in GUI would be "
"automatically extracted for translation."
msgstr ""
"Översett de Tekenkeed na de aktuell Spraak. Texten binnen en Böversiet warrt "
"autommatsch för de Översetten ruttrocken."

#: widget/specials.cpp:140
msgid ""
"Executes block if expression is true (non-zero number or non-empty string.) "
"<p>Close with <b>@endif</b></p>"
msgstr ""
"Föhrt en Block ut, wenn de Utdruck wohr is (en Tall de nich \"Null\" is un ok "
"keen leddig Tekenkeed.) "
"<p>Tomaken mit <b>@endif</b></p>"

#: widget/specials.cpp:142
msgid ""
"Executes another Kommander dialog. Current dialog directory is used if no path "
"is given. Arguments may be given as named arguments which will become global "
"variables in the new dialog. For instance: <i>var=val</i>"
msgstr ""
"Föhrt en anner Kommander-Dialog ut. Wenn keen Padd angeven is, warrt dat "
"aktuelle Dialoog-Verteken bruukt. De Argumenten laat sik as nöömt Argumenten "
"övergeven, un warrt binnen den niegen Dialoog to globaal Variabeln, t.B.: <i>"
"var = val</i>"

#: widget/specials.cpp:144
msgid "Reads setting from configration file for this dialog."
msgstr "Leest de Instellen för dissen Dialoog ut de Instellendatei."

#: widget/specials.cpp:146
msgid ""
"Sets the value of a global variable. Global variables exist for the life of the "
"Kommander window."
msgstr ""
"Leggt den Weert vun en globaal Variabel fast. Globaal Variabeln gellt as lang "
"as dat Kommander-Finster apen is."

#: widget/specials.cpp:148
msgid "Stores setting in configuration file for this dialog."
msgstr "Sekert de Instellen för dissen Dialoog na en Instellendatei."

#: widget/specials.cpp:150
msgid ""
"Begin of <b>switch</b> block. Following <b>case</b> values are compared to <i>"
"expression</i>."
"<p>@switch()"
"<br>@case()"
"<br>@end"
msgstr ""
"Anfang vun en <b>switch</b>-Block. De nakamen <b>case</b>"
"-Weerten warrt mit den <i>Utdruck</i> vergleken."
"<p>@switch()"
"<br>@case()"
"<br>@end"

#: widget/specials.cpp:152
msgid "Executes an external DCOP call."
msgstr "Föhrt en extern DCOP-Oproop ut."

#: widget/specials.cpp:154
msgid "Adds a comment to EOL that Kommander will not parse"
msgstr "Föögt en Kommentar na't Reegenn (EOL) to, den Kommander nich inleest"

#: widget/specials.cpp:158
msgid "Returns an EOL-separated list of all values in the array."
msgstr ""
"Gifft en mit Reegümbröök trennt List mit all Weerten binnen dat Feld ut."

#: widget/specials.cpp:160
msgid "Returns an EOL-separated list of all keys in the array."
msgstr ""
"Gifft en mit Reegümbröök trennt List mit all Slöteln binnen dat Feld ut."

#: widget/specials.cpp:162
msgid "Removes all elements from the array."
msgstr "Deit all Elementen ut dat Feld weg."

#: widget/specials.cpp:164
msgid "Returns the number of elements in the array."
msgstr "Gifft de Tall vun Elementen binnen dat Feld torüch."

#: widget/specials.cpp:166
msgid "Returns the value associated with the given key."
msgstr "Gifft den en angeven Slötel tohören Weert ut."

#: widget/specials.cpp:168
msgid "Removes element with the given key from the array."
msgstr "Deit dat Element mit den angeven Slötel ut dat Feld weg."

#: widget/specials.cpp:170
msgid "Adds element with the given key and value to the array"
msgstr "Föögt dat Element mit den angeven Slötel un Weert na't Feld to"

#: widget/specials.cpp:172
msgid ""
"Adds all elements in the string to the array. String should have <i>"
"key\\tvalue\\n</i> format."
msgstr ""
"Föögt all Elementen in de Tekenkeed na't Feld to. De Tekenkeed mutt in'n "
"Formaat <i>Slötel\\tWeert\\n</i> wesen."

#: widget/specials.cpp:175
msgid ""
"Returns all elements in the array in "
"<pre>key\\tvalue\\n</pre> format."
msgstr ""
"Gifft all Elementen binnen dat Feld in'n Formaat "
"<pre>Slötel\\tWeert\\n</pre> torüch."

#: widget/specials.cpp:180
msgid "Returns number of chars in the string."
msgstr "Gifft de Tall vun Tekens binnen en Tekenkeed torüch."

#: widget/specials.cpp:182
msgid "Checks if the the string contains the given substring."
msgstr "Pröövt, wat en Tekenkeed de angeven Deeltekenkeed bargt."

#: widget/specials.cpp:184
msgid ""
"Returns the position of a substring in the string, or -1 if it is not found."
msgstr ""
"Gifft de Positschoon vun en Deeltekenkeed binnen de Tekenkeed torüch, oder "
"\"-1\", wenn sik keen finnen lett."

#: widget/specials.cpp:186
msgid ""
"Returns the position of a substring in the string, or -1 if it is not found. "
"String is searched backwards"
msgstr ""
"Gifft de Positschoon vun en Deeltekenkeed binnen de Tekenkeed torüch, oder "
"\"-1\", wenn sik keen finnen lett. De Tekenkeed warrt vun't Enn an dörsöcht"

#: widget/specials.cpp:188
msgid "Returns the first <i>n</i> chars of the string."
msgstr "Gifft de eersten <i>n</i> Tekens vun de Tekenkeed torüch."

#: widget/specials.cpp:190
msgid "Returns the last <i>n</i> chars of the string."
msgstr "Gifft de lesten <i>n</i> Tekens vun de Tekenkeed torüch."

#: widget/specials.cpp:192
msgid "Returns <i>n</i> chars of the string, starting from <i>start</i>."
msgstr ""
"Gifft vun <i>Start</i> af de eerst <i>n</i> Tekens vun de Tekenkeed torüch."

#: widget/specials.cpp:194
msgid "Removes all occurrences of given substring."
msgstr "Deit all Vörkamen vun de angeven Deeltekenkeed weg."

#: widget/specials.cpp:196
msgid ""
"Replaces all occurrences of the given substring with the given replacement."
msgstr ""
"Wesselt all Vörkamen vun en angeven Deeltekenkeed mit en angeven Uttuusch ut."

#: widget/specials.cpp:198
msgid "Converts the string to uppercase."
msgstr "Wannelt de Tekenkeed na Grootbookstaven üm."

#: widget/specials.cpp:200
msgid "Converts the string to lowercase."
msgstr "Wannelt de Tekenkeed na Lüttbookstaven üm."

#: widget/specials.cpp:202
msgid ""
"Compares two strings. Returns 0 if they are equal, -1 if the first one is "
"lower, 1 if the first one is higher"
msgstr ""
"Verglickt twee Tekenkeden. Gifft \"0\" torüch, wenn se liek sünd, \"1\", wenn "
"de eerste lütter is, \"1\", wenn de eerste grötter is"

#: widget/specials.cpp:205
msgid "Checks if the string is empty."
msgstr "Pröövt, wat en Tekenkeed leddig is."

#: widget/specials.cpp:207
msgid "Checks if the string is a valid number."
msgstr "Pröövt, wat en Tekenkeed en gellen Tall is."

#: widget/specials.cpp:209
msgid "Returns given section of a string."
msgstr "Gifft den angeven Afsnitt vun en Tekenkeed torüch."

#: widget/specials.cpp:211
msgid ""
"Returns the given string with %1, %2, %3 replaced with <i>arg1</i>, <i>arg2</i>"
", <i>arg3</i> accordingly."
msgstr ""
"Gifft de angeven Tekenkeed mit %1, %2, %3 torüch, utwesselt mit de tohören <i>"
"arg1</i>, <i>arg2</i>, <i>arg3</i>."

#: widget/specials.cpp:215
msgid "Returns content of given file."
msgstr "Gifft den Inholt vun en angeven Datei torüch."

#: widget/specials.cpp:217
msgid "Writes given string to a file."
msgstr "Schrievt de angeven Tekenkeed na en Datei."

#: widget/specials.cpp:219
msgid "Appends given string to the end of a file."
msgstr "Hangt de angeven Tekenkeed na't Enn vun en Datei an."

#: widget/specials.cpp:222
msgid "Shows color dialog. Returns color in #RRGGBB format."
msgstr ""
"Wiest en Dialoog för de Klöörutwahl. Gifft de Klöör in't Formaat #RRGGBB "
"torüch."

#: widget/specials.cpp:224
msgid "Shows text selection dialog. Returns entered text."
msgstr "Wiest en Textutwahl-Dialoog. Gifft den ingevenText torüch."

#: widget/specials.cpp:226
msgid "Shows a dialog asking user for password and returns it."
msgstr ""
"Wiest en Dialoog för en Passwoortaffraag un gifft dat ingeven Passwoort torüch."

#: widget/specials.cpp:228
msgid "Shows value selection dialog. Returns entered value."
msgstr "Wiest en Weertutwahl-Dialoog. Gifft den ingeven Weert torüch."

#: widget/specials.cpp:230
msgid "Shows float value selection dialog. Returns entered value."
msgstr ""
"Wiest en Utwahldialoog för Fleetkommaweerten. Gifft den ingeven Weert torüch."

#: widget/specials.cpp:232
msgid "Shows existing file selection dialog. Returns selected file."
msgstr ""
"Wiest en Dialoog för de Utwahl ut vörhannen Dateien. Gifft de utsöchte Datei "
"torüch."

#: widget/specials.cpp:234
msgid "Shows save file selection dialog. Returns selected file."
msgstr ""
