#: xml_doc.cc:1716
#, no-c-format
msgid "RECEIVED(settlement; maturity; investment; discount; basis)"
msgstr ""
"RECEIVED(Utbetahldatum; Afloopdatum; Investitschoon; Diskontsatz; Basis)"

