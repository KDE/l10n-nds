#. i18n: file dialogs/position_cell_format.ui line 198
#: rc.cpp:273
#, no-c-format
msgid ""
"This is only available when the rotation is 0°.\n"
"Wrap text wraps the text so it fits in the previous cell size. If this is not "
"checked, the text will stay on one line and the cell size will be adjusted to "
"contain the text.\n"
"Vertical text puts your text vertically."
msgstr ""
"Dit lett sik bloots mit Dreihen \"0\" bruken. \n"
"\"Textümbrook\" passt den Text na de verleden Zellgrött to. Wenn dit nich "
"anmaakt is, blifft de Text as Reeg stahn un de Zellbreed warrt den Text "
"topasst.\n"
"\"Pielliek Text\" föögt den Text pielliek na de Zell in."

#. i18n: file dialogs/position_cell_format.ui line 209
#: rc.cpp:278
#, no-c-format
msgid "Wrap text"
