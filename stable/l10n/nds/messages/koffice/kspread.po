#. i18n: file extensions/statistical.xml line 1401
#: xml_doc.cc:5325
#, no-c-format
msgid ""
"The CHIDIST() function returns the probability value from the indicated Chi "
"square that a hypothesis is confirmed."
msgstr ""
"De Funkschoon CHIDIST() gifft den Wohrschienlichkeitsweert vun dat angeven "
"Chi-Quadraat torüch, dat en Vermoden beglöövt warrt."

#. i18n: file extensions/statistical.xml line 1402
#: xml_doc.cc:5328
#, no-c-format
msgid ""
"CHIDIST compares the Chi square value to be given for a random sample that is "
"calculated from the sum of (observed value-expected value)^2/expected value for "
"all values with the theoretical Chi square distribution and determines from "
"this the probability of error for the hypothesis to be tested."
msgstr ""
"CHIDIST vergliekt den Weert vun Chi-Quadraat för en tofällig Steekproov, de ut "
"de Summ vun \"(beluert Weert-verwacht Weert)^2/verwacht Weert\" för all Weerten "
"mit mööglich Chi-Quadraatverdelen un reekt dor de Fehlerwohrschienlichkeit för "
"de Vermoden mit ut, de pröövt warrn schall."

#. i18n: file extensions/statistical.xml line 1403
#: xml_doc.cc:5331
#, no-c-format
msgid "CHIDIST(number;degrees_freedom)"
msgstr "CHIDIST(Tall;Freeheitgraad)"

