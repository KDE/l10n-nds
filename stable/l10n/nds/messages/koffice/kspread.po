#: xml_doc.cc:4917
#, no-c-format
msgid "Floating point values"
msgstr "Fleetkommaweerten"

#. i18n: file extensions/statistical.xml line 228
#: xml_doc.cc:4290
#, no-c-format
msgid ""
"The KURT() function calculates an unbiased estimate of the kurtosis of a data "
"set. You have to provide at least 4 values, otherwise an error is returned."
msgstr ""
"De Funkschoon KURT() reekt en verwacht Vermoden vun en Datensett sien Timp "
"(Kurtosis) ut. Tominnst veer Weerten mööt angeven wesen, anners warrt en Fehler "
"torüchgeven."

#. i18n: file extensions/statistical.xml line 229
#: xml_doc.cc:4293
#, no-c-format
msgid "KURT(value; value;...)"
msgstr "KURT(Weert; Weert;...)"

#. i18n: file extensions/statistical.xml line 230
#: xml_doc.cc:4296
#, no-c-format
msgid "KURT(A1:A5)"
msgstr "KURT(A1:A5)"

#. i18n: file extensions/statistical.xml line 231
#: xml_doc.cc:4299
#, no-c-format
msgid "KURT(21; 33; 54; 23) returns 1.344239"
msgstr "KURT(21; 33; 54; 23) gifft \"1.344239\" torüch"

#. i18n: file extensions/statistical.xml line 260
#: xml_doc.cc:4317
#, no-c-format
msgid ""
"The KURTP() function calculates an population kurtosis of a data set. You have "
"to provide at least 4 values, otherwise an error is returned."
msgstr ""
"De Funkschoon KURTP() reekt en Populatschoon-Timp vun en Datensett ut. Tominnst "
"veer Weerten mööt angeven wesen, anners warrt en Fehler torüchgeven."

#. i18n: file extensions/statistical.xml line 261
#: xml_doc.cc:4320
#, no-c-format
msgid "KURTP(value; value;...)"
msgstr "KURTP(Weert; Weert;...)"

#. i18n: file extensions/statistical.xml line 262
#: xml_doc.cc:4323
#, no-c-format
msgid "KURTP(A1:A5)"
msgstr "KURTP(A1:A5)"

#. i18n: file extensions/statistical.xml line 263
#: xml_doc.cc:4326
#, no-c-format
msgid "KURTP(21; 33; 54; 23) returns -1.021"
msgstr "KURTP(21; 33; 54; 23) gifft \"-1.021\" torüch"

#. i18n: file extensions/statistical.xml line 292
#: xml_doc.cc:4344
#, no-c-format
msgid "The DEVSQ() function calculates the sum of squares of deviations."
msgstr "De Funkschoon DEVSQ() reekt de Summ vun Quadraten vun Verschelen ut."

#. i18n: file extensions/statistical.xml line 293
#: xml_doc.cc:4347
#, no-c-format
msgid "DEVSQ(value; value;...)"
msgstr "DEVSQ(Weert; Weert;...)"

#. i18n: file extensions/statistical.xml line 294
#: xml_doc.cc:4350
#, no-c-format
msgid "DEVSQ(A1:A5)"
msgstr "DEVSQ(A1:A5)"

#. i18n: file extensions/statistical.xml line 295
#: xml_doc.cc:4353
#, no-c-format
msgid "DEVSQ(21; 33; 54; 23) returns 684.75"
msgstr "DEVSQ(21; 33; 54; 23) gifft \"684.75\" torüch"

#. i18n: file extensions/statistical.xml line 303
#: xml_doc.cc:4356
#, no-c-format
msgid "Number of success in the sample"
msgstr "Tall vun Drepers in en Steekproov"

#. i18n: file extensions/statistical.xml line 307
#: xml_doc.cc:4359 xml_doc.cc:4449 xml_doc.cc:4530
#, no-c-format
msgid "Number of trials"
msgstr "Tall vun Versöken"

#. i18n: file extensions/statistical.xml line 311
#: xml_doc.cc:4362
#, no-c-format
msgid "Number of success overall"
msgstr "Tall vun Drepers tosamen"

#. i18n: file extensions/statistical.xml line 315
#: xml_doc.cc:4365
#, no-c-format
msgid "Population size"
msgstr "Populatschoon-Grött"

#. i18n: file extensions/statistical.xml line 319
#: xml_doc.cc:4368
#, no-c-format
msgid "The HYPGEOMDIST() function returns the hypergeometric distribution."
msgstr "De Funkschoon HYPGEOMDIST() gifft de hypergeometersch Verdelen torüch."

#. i18n: file extensions/statistical.xml line 320
#: xml_doc.cc:4371
#, no-c-format
msgid "HYPGEOMDIST(x; n; M; N)"
msgstr "HYPGEOMDIST(x; n; M; N)"

#. i18n: file extensions/statistical.xml line 321
#: xml_doc.cc:4374
#, no-c-format
msgid "HYPGEOMDIST(2; 5; 6; 20) returns 0.3522"
msgstr "HYPGEOMDIST(2; 5; 6; 20) gifft \"0.3522\" torüch"

#. i18n: file extensions/statistical.xml line 349
#: xml_doc.cc:4392
#, no-c-format
msgid ""
"The GEOMEAN() function returns the geometric mean of the given arguments. This "
"is equal to the Nth root of the product of the terms."
msgstr ""
"De Funkschoon GEOMEAN() gifft den geometerschen Dörsnitt vun de angeven "
"Argumenten torüch. Dit is dat Sülve as de n-te Wörtel vun dat Produkt vun de "
"Weerten."

#. i18n: file extensions/statistical.xml line 350
#: xml_doc.cc:4395
#, no-c-format
msgid "GEOMEAN(value; value;...)"
msgstr "GEOMEAN(Weert; Weert;...)"

#. i18n: file extensions/statistical.xml line 351
#: xml_doc.cc:4398
#, no-c-format
msgid "GEOMEAN(A1:A5)"
msgstr "GEOMEAN(A1:A5)"

#. i18n: file extensions/statistical.xml line 352
#: xml_doc.cc:4401
#, no-c-format
msgid "GEOMEAN(21; 33; 54; 23) returns 30.45886"
msgstr "GEOMEAN(21; 33; 54; 23) gifft \"30.45886\" torüch"

#. i18n: file extensions/statistical.xml line 381
#: xml_doc.cc:4419
#, no-c-format
msgid ""
"The HARMEAN() function returns the harmonic mean of the N data points (N "
"divided by the sum of the inverses of the data points)."
msgstr ""
"De Funkschoon HARMEAN() gifft den harmoonsch Dörsnitt vun den N Datenpünkt "
"torüch (N deelt dör de Summ vun de Ümdreihfunkschonen vun de Datenpünkt)."

#. i18n: file extensions/statistical.xml line 382
#: xml_doc.cc:4422
#, no-c-format
msgid "HARMEAN(value; value;...)"
msgstr "HARMEAN(Weert; Weert;...)"

#. i18n: file extensions/statistical.xml line 383
#: xml_doc.cc:4425
#, no-c-format
msgid "HARMEAN(A1:A5)"
msgstr "HARMEAN(A1:A5)"

#. i18n: file extensions/statistical.xml line 384
#: xml_doc.cc:4428
#, no-c-format
msgid "HARMEAN(21; 33; 54; 23) returns 28.588"
msgstr "HARMEAN(21; 33; 54; 23) gifft \"28.588\" torüch"

#. i18n: file extensions/statistical.xml line 393
#: xml_doc.cc:4431 xml_doc.cc:4533
#, no-c-format
msgid "Number of failures"
msgstr "Fehlertall"

#. i18n: file extensions/statistical.xml line 397
#: xml_doc.cc:4434 xml_doc.cc:4452
#, no-c-format
msgid "Number of successful trials"
msgstr "Tall vun glückt Versöken"

#. i18n: file extensions/statistical.xml line 401
#: xml_doc.cc:4437 xml_doc.cc:4455
#, no-c-format
msgid "Probability of success"
msgstr "Dreperwohrschienlichkeit"

#. i18n: file extensions/statistical.xml line 405
#: xml_doc.cc:4440
#, no-c-format
msgid "The NEGBINOMDIST() function returns the negative binomial distribution."
msgstr ""
"De Funkschoon NEGBINOMDIST() gifft de negative binoomsch Verdelen torüch."

#. i18n: file extensions/statistical.xml line 406
#: xml_doc.cc:4443
#, no-c-format
msgid "NEGBINOMDIST(failures; success; prob_of_success)"
msgstr "NEGBINOMDIST(Fehlers; Drepers; Dreperwohrschienlichkeit)"

#. i18n: file extensions/statistical.xml line 407
#: xml_doc.cc:4446
#, no-c-format
msgid "NEGBINOMDIST(2;5;0.55) returns 0.152872629"
msgstr "NEGBINOMDIST(2;5;0.55) gifft \"0.152872629\" torüch"

#. i18n: file extensions/statistical.xml line 427
#: xml_doc.cc:4458
#, no-c-format
msgid "The BINO() function returns the binomial distribution."
msgstr "De Funkschoon BINO() gifft de binoomsch Verdelen torüch."

#. i18n: file extensions/statistical.xml line 428
#: xml_doc.cc:4461
#, no-c-format
msgid ""
"The first parameter is the number of trials, the second parameter is the number "
"of successes, and the third is the probability of success. The number of trials "
"should be greater than the number of successes and the probability should be "
"smaller or equal to 1."
msgstr ""
"De eerste Parameter is de Tall vun Versöken, de twete de Tall vun Drepers un de "
"drüdde de Dreperwohrschienlichkeit. De Tall vun Versöken schall grötter wesen "
"as de Tall vun Drepers un de de Wohrschienlichkeit schall lütter oder liek 1 "
"wesen."

#. i18n: file extensions/statistical.xml line 429
#: xml_doc.cc:4464
#, no-c-format
msgid "BINO(trials;success;prob_of_success)"
msgstr "BINO(Versöken;Drepers;Dreperwohrschienlichkeit)"

#. i18n: file extensions/statistical.xml line 430
#: xml_doc.cc:4467
#, no-c-format
msgid "BINO(12;9;0.8) returns 0.236223201"
msgstr "BINO(12;9;0,8) gifft \"0,236223201\" torüch"

#. i18n: file extensions/statistical.xml line 438
#: xml_doc.cc:4470 xml_doc.cc:4473 xml_doc.cc:4485 xml_doc.cc:4488
#: xml_doc.cc:4500 xml_doc.cc:4503 xml_doc.cc:4515 xml_doc.cc:4518
#, no-c-format
msgid "Value (array)"
msgstr "Weert (Feld)"

#. i18n: file extensions/statistical.xml line 446
#: xml_doc.cc:4476
#, no-c-format
msgid ""
"The SUMPRODUCT() function (SUM(X*Y)) returns the sum of the product of these "
"values. The number of values in the two arrays should be equal. Otherwise this "
"function returns Err."
msgstr ""
"De Funkschoon SUMPRODUCT() (SUM(X*Y)) gifft de Summ vun dat Produkt vun disse "
"Weerten torüch. De Tall vun Weerten binnen de twee Feller schall liek wesen. "
"Anners gifft disse Funkschoon \"Err\" torüch."

#. i18n: file extensions/statistical.xml line 447
#: xml_doc.cc:4479
#, no-c-format
msgid "SUMPRODUCT(array1;array2)"
msgstr "SUMPRODUCT(Feld1;Feld2)"

#. i18n: file extensions/statistical.xml line 448
#: xml_doc.cc:4482
#, no-c-format
msgid "SUMPRODUCT(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 31"
msgstr "SUMPRODUCT(A1:A2;B1:B2) mit A1=2 A2=5 B1=3 un B2=5 gifft \"31\" torüch"

#. i18n: file extensions/statistical.xml line 464
#: xml_doc.cc:4491
#, no-c-format
msgid ""
"The SUMX2PY2() function (SUM(X^2+Y^2)) returns the sum of the squares of these "
"values. The number of values in the two arrays should be equal. Otherwise this "
"function returns Err."
msgstr ""
"De Funkschoon SUMX2PY2() (SUM(X^2+Y^2)) gifft de Sum vun de Quadraten vun "
"dissen Weerten torüch. De Tall vun Weerten binnen de twee Feller schall liek "
"wesen. Anners gifft disse Funkschoon \"Err\" torüch."

#. i18n: file extensions/statistical.xml line 465
#: xml_doc.cc:4494
#, no-c-format
msgid "SUMX2PY2(array1;array2)"
msgstr "SUMX2PY2(Feld1;Feld2)"

#. i18n: file extensions/statistical.xml line 466
#: xml_doc.cc:4497
#, no-c-format
msgid "SUMX2PY2(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 63"
msgstr "SUMX2PY2(A1:A2;B1:B2) mit A1=2 A2=5 B1=3 un B2=5 gifft \"63\" torüch"

#. i18n: file extensions/statistical.xml line 482
#: xml_doc.cc:4506
#, no-c-format
msgid ""
"The SUMX2MY2() function (SUM(X^2-Y^2)) returns the difference of the squares of "
"these values. The number of values in the two arrays should be equal. Otherwise "
"this function returns Err."
msgstr ""
"De Funkschoon SUMX2MY2() (SUM(X^2-Y^2)) gifft den Verscheel vun de Quadraten "
"vun disse Weerten torüch. De Tall vun Weerten binnen de twee Feller schall liek "
"wesen. Anners gifft disse Funkschoon \"Err\" torüch."

#. i18n: file extensions/statistical.xml line 483
#: xml_doc.cc:4509
#, no-c-format
msgid "SUMX2MY2(array1;array2)"
msgstr "SUMX2MY2(Feld1;Feld2)"

#. i18n: file extensions/statistical.xml line 484
#: xml_doc.cc:4512
#, no-c-format
msgid "SUMX2MY2(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns -5"
msgstr "SUMX2MY2(A1:A2;B1:B2) mit A1=2 A2=5 B1=3 un B2=5 gifft \"-5\" torüch"

#. i18n: file extensions/statistical.xml line 500
#: xml_doc.cc:4521
#, no-c-format
msgid ""
"The SUM2XMY() function (SUM((X-Y)^2)) returns the square of the differences of "
"these values. The number of values in the two arrays should be equal. Otherwise "
"this function returns Err."
msgstr ""
"De Funkschoon SUM2XMY() (SUM((X-Y)^2)) gifft dat Quadraat vun disse Weerten ehr "
"Verschelen torüch. De Tall vun Weerten binnen de twee Feller schall liek wesen. "
"Anners gifft disse Funkschoon \"Err\" torüch."

#. i18n: file extensions/statistical.xml line 501
#: xml_doc.cc:4524
#, no-c-format
msgid "SUM2XMY(array1;array2)"
msgstr "SUM2XMY(Feld1;Feld2)"

#. i18n: file extensions/statistical.xml line 502
#: xml_doc.cc:4527
#, no-c-format
msgid "SUM2XMY(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 1"
msgstr "SUM2XMY(A1:A2;B1:B2) mit A1=2 A2=5 B1=3 un B2=5 gifft \"1\" torüch"

#. i18n: file extensions/statistical.xml line 519
#: xml_doc.cc:4536
#, no-c-format
msgid "Probability of failure"
msgstr "Fehlslaagwohrschienlichkeit"

#. i18n: file extensions/statistical.xml line 523
#: xml_doc.cc:4539
#, no-c-format
msgid ""
"The INVBINO() function returns the negative binomial distribution. The first "
"parameter is the number of trials, the second parameter is the number of "
"failures, and the third is the probability of failure. The number of trials "
"should be larger than the number of failures and the probability should be "
"smaller or equal to 1."
msgstr ""
"De Funkschoon INVBINO() gifft de negative binoomsch Verdelen torüch. De eerste "
"Parameter is de Tall vun Versöken, de twete de Tall vun Fehlslään, de drüdde de "
"Fehlslaagwohrschienlichkeit. De Tall vun Versöken schall grötter wesen as de "
"Tall vun Fehlslään un de Wohrschienlichkeit schall lütter oder liek 1 wesen."

#. i18n: file extensions/statistical.xml line 524
#: xml_doc.cc:4542
#, no-c-format
msgid "INVBINO(trials;failure;prob_of_failure)"
msgstr "INVBINO(Versöök;Fehlslään;Fehlslaagwohrschienlichkeit)"

#. i18n: file extensions/statistical.xml line 525
#: xml_doc.cc:4545
#, no-c-format
msgid "INVBINO(12;3;0.2) returns 0.236223201"
msgstr "INVBINO(12;3;0,2) gifft \"0,236223201\" torüch"

#. i18n: file extensions/statistical.xml line 533
#: xml_doc.cc:4548 xml_doc.cc:4566
#, no-c-format
msgid "Total number of elements"
msgstr "Tall vun Elementen"

#. i18n: file extensions/statistical.xml line 537
#: xml_doc.cc:4551
#, no-c-format
msgid "Number of elements to choose"
msgstr "Tall vun utsöökbor Elementen"

#. i18n: file extensions/statistical.xml line 541
#: xml_doc.cc:4554
#, no-c-format
msgid ""
"The COMBIN() function calculates the count of possible combinations. The first "
"parameter is the total count of elements. The second parameter is the count of "
"elements to choose. Both parameters should be positive and the first parameter "
"should not be less than the second. Otherwise the function returns an error."
msgstr ""
"De Funkschoon COMBIN() reekt de Tall vun mööglich Kombinatschonen ut. De eerste "
"Parameter is de Tall vun all Elementen tosamen. De twete Parameter is de Tall "
"vun Elementen för de Utwahl. Beed Parameters mööt positiv wesen un de eerste "
"Parameter schall nich lütter wesen as de twete. Anners gifft de Funkschoon en "
"Fehler ut."

#. i18n: file extensions/statistical.xml line 542
#: xml_doc.cc:4557
#, no-c-format
msgid "COMBIN(total;chosen)"
msgstr "COMBIN(tosamen;utsöcht)"

#. i18n: file extensions/statistical.xml line 543
#: xml_doc.cc:4560
#, no-c-format
msgid "COMBIN(12;5) returns 792"
msgstr "COMBIN(12;5) gifft \"792\" torüch"

#. i18n: file extensions/statistical.xml line 544
#: xml_doc.cc:4563
#, no-c-format
msgid "COMBIN(5;5) returns 1"
msgstr "COMBIN(5;5) gifft \"1\" torüch"

#. i18n: file extensions/statistical.xml line 556
#: xml_doc.cc:4569
#, no-c-format
msgid "Number of elements to permutate"
msgstr "Tall vun Elementen för't Permuteren"

#. i18n: file extensions/statistical.xml line 560
#: xml_doc.cc:4572
#, no-c-format
msgid ""
"The PERMUT() function returns the number of permutations. The first parameter "
"is the number of elements, and the second parameter is the number of elements "
"used in the permutation."
msgstr ""
"De Funkschoon PERMUT() gifft de Tall vun Permutatschonen (Ännern) torüch. De "
"eerste Parameter is de Tall vun Elementen, de twete de Tall vun Elementen för "
"de Permutatschoon."

#. i18n: file extensions/statistical.xml line 561
#: xml_doc.cc:4575
#, no-c-format
msgid "PERMUT(total;permutated)"
msgstr "PERMUT(tosamen;bruukt)"

#. i18n: file extensions/statistical.xml line 562
#: xml_doc.cc:4578
#, no-c-format
msgid "PERMUT(8;5) equals 6720"
msgstr "PERMUT(8;5) gifft \"6720\" torüch"

#. i18n: file extensions/statistical.xml line 563
#: xml_doc.cc:4581
#, no-c-format
msgid "PERMUT(1;1) equals 1"
msgstr "PERMUT(1;1) gifft \"1\" torüch"

#. i18n: file extensions/statistical.xml line 591
#: xml_doc.cc:4599
#, no-c-format
msgid ""
"The AVERAGE() function calculates the average of all the values given as "
"parameters. You can calculate the average of a range AVERAGE(A1:B5) or a list "
"of values like AVERAGE(12;5;12.5)."
msgstr ""
"De Funkschoon AVERAGE() reekt den Dörsnitt vun all as Parameters angeven "
"Weerten ut. Een kann den Dörsnitt vun en Rebeet AVERAGE(A1:B5) oder en List vun "
"Weerten liek AVERAGE(12;5;12.5) utreken."

#. i18n: file extensions/statistical.xml line 592
#: xml_doc.cc:4602
#, no-c-format
msgid "AVERAGE(value;value;...)"
msgstr "AVERAGE(Weert;Weert;...)"

#. i18n: file extensions/statistical.xml line 593
#: xml_doc.cc:4605
#, no-c-format
msgid "AVERAGE(12;5;7) equals 8"
msgstr "AVERAGE(12;5;7) gifft \"8\" torüch"

#. i18n: file extensions/statistical.xml line 594
#: xml_doc.cc:4608
#, no-c-format
msgid "AVERAGE(12.5;2) equals 7.25"
msgstr "AVERAGE(12,5;2) gifft \"7,25\" torüch"

#. i18n: file extensions/statistical.xml line 606
#: xml_doc.cc:4614 xml_doc.cc:5625 xml_doc.cc:5628 xml_doc.cc:5631
#: xml_doc.cc:5634 xml_doc.cc:5637
#, no-c-format
msgid "String values"
msgstr "Tekenkeden"

#. i18n: file extensions/statistical.xml line 610
#: xml_doc.cc:4617
#, no-c-format
msgid ""
"The AVERAGEA() calculates the average of the given arguments. Numbers, text and "
"logical values are included in the calculation too. If the cell contains text "
"or the argument evaluates to FALSE, it is counted as value zero (0). If the "
"argument evaluates to TRUE, it is counted as one (1). Note that empty cells are "
"not counted."
msgstr ""
"De Funkschoon AVERAGEA() reekt den Dörsnitt vun de angeven Parameters ut. "
"Tallen, Text un boolsch Weerten warrt ok inslaten. Wenn de Zell Text bargt oder "
"dat Resultaat \"falsch\" is, warrt de Weert as Null (0) tellt, un as Een (1), "
"wenn dat Argument \"wohr\" is. Beacht, dat leddig Zellen nich tellt warrt."

#. i18n: file extensions/statistical.xml line 611
#: xml_doc.cc:4620
#, no-c-format
msgid "AVERAGEA(value;value;...)"
msgstr "AVERAGEA(Weert;Weert;...)"

#. i18n: file extensions/statistical.xml line 612
#: xml_doc.cc:4623
#, no-c-format
msgid "AVERAGEA(11.4;17.3;\"sometext\";25.9;40.1) equals 18.94"
msgstr "AVERAGEA(11,4;17,3;\"wattext\";25,9;40,1) gifft \"18,94\" torüch"

#. i18n: file extensions/statistical.xml line 641
#: xml_doc.cc:4641
#, no-c-format
msgid ""
"The AVEDEV() function calculates the average of the absolute deviations of a "
"data set from their mean."
msgstr ""
"De Funkschoon AVEDEV() reekt den Dörsnitt vun de afsoluten Verschelen vun en "
"Datensett ut ehr Middelweerten ut."

#. i18n: file extensions/statistical.xml line 642
#: xml_doc.cc:4644
#, no-c-format
msgid "AVEDEV(value;value;...)"
msgstr "AVEDEV(Weert;Weert;...)"

#. i18n: file extensions/statistical.xml line 643
#: xml_doc.cc:4647
#, no-c-format
msgid "AVEDEV(11.4;17.3;21.3;25.9;40.1) returns 7.84"
msgstr "AVEDEV(11,4;17.3;21,3;25,9;40,1) gifft \"7,84\" torüch"

#. i18n: file extensions/statistical.xml line 644
#: xml_doc.cc:4650
#, no-c-format
msgid "AVEDEV(A1:A5) ..."
msgstr "AVEDEV(A1:A5) ..."

