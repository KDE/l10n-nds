#: caldialog.cpp:38 joywidget.cpp:333
msgid "Calibration"
msgstr "Fieninstellen"

#: caldialog.cpp:53
msgid "Please wait a moment to calculate the precision"
msgstr "De Akkraatheit warrt utreekt, bitte en beten töven."

#: caldialog.cpp:76
msgid ""
"<qt>Calibration is about to check the value range your device delivers."
"<br>"
"<br>Please move <b>axis %1</b> on your device to the <b>minimum</b> position."
"<br>"
"<br>Press any button on the device to continue with the next step.</qt>"
msgstr ""
"<qt>För de Fieninstellen warrt nu de Weerten pröövt, de Dien Reedschap utgifft. "
"<br>"
"<br>Bitte nu de <b>Richt %1</b> op den <b>lüttsten</b> Weert schuven."
"<br>"
"<br>Na dat bitte jichtenseen Knoop vun de Reedschap drücken.</qt>"

#: caldialog.cpp:89
msgid ""
"<qt>Calibration is about to check the value range your device delivers."
"<br>"
"<br>Please move <b>axis %1</b> on your device to the <b>center</b> position."
"<br>"
"<br>Press any button on the device to continue with the next step.</qt>"
msgstr ""
"<qt>För de Fieninstellen warrt nu de Weerten pröövt, de Dien Reedschap utgifft. "
"<br>"
"<br>Bitte nu de <b>Richt %1</b> na de <b>Mitt</b> schuven."
"<br>"
"<br>Na dat bitte jichtenseen Knoop vun de Reedschap drücken.</qt>"

#: caldialog.cpp:102
msgid ""
"<qt>Calibration is about to check the value range your device delivers."
"<br>"
"<br>Please move <b>axis %1</b> on your device to the <b>maximum</b> position."
"<br>"
"<br>Press any button on the device to continue with the next step.</qt>"
msgstr ""
"<qt>För de Fieninstellen warrt nu de Weerten pröövt, de Dien Reedschap utgifft. "
"<br>"
"<br>Bitte nu de <b>Richt %1</b> op den <b>gröttsten</b> Weert schuven."
"<br>"
"<br>Na dat bitte jichtenseen Knoop vun de Reedschap drücken.</qt>"

