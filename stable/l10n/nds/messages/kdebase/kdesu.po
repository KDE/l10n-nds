#: kdesu.cpp:56 kdesu.cpp:57
msgid "Specifies the command to run"
msgstr "Befehl, de utföhrt warrn schall"

#: kdesu.cpp:58
msgid "Run command under target uid if <file> is not writable"
msgstr "Befehl ünner düsse UID utföhrn, wenn <file> nich schreven warrn kann"

#: kdesu.cpp:59
msgid "Specifies the target uid"
msgstr "Gifft de Teel-UID an"

#: kdesu.cpp:60
msgid "Do not keep password"
msgstr "Passwoort nich behollen"

#: kdesu.cpp:61
msgid "Stop the daemon (forgets all passwords)"
msgstr "Den Daemon anhollen (vergitt all Passwöör)"

#: kdesu.cpp:62
msgid "Enable terminal output (no password keeping)"
msgstr "Utgaav na't Terminal anmaken (Passwöör nich behollen)"

#: kdesu.cpp:63
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest"
msgstr "Prioriteetsweert setten: 0<= Weert <= 100, 0 is minnst"

#: kdesu.cpp:64
msgid "Use realtime scheduling"
msgstr "Echttiedplaanen bruken"

#: kdesu.cpp:65
msgid "Let command use existing dcopserver"
msgstr "Den Befehl op en vörhannen Dcopserver togriepen laten"

#: kdesu.cpp:66
msgid "Specify icon to use in the password dialog"
msgstr "Lüttbild för'n Passwoort-Dialoog utsöken"

#: kdesu.cpp:67
msgid "Do not show the command to be run in the dialog"
msgstr "Den Befehl nich wiesen, de in'n Dialoog utföhrt warrn schall"

#: kdesu.cpp:98
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:99
msgid "Runs a program with elevated privileges."
msgstr "Föhrt'n Programm mit vörwiederte Rechten ut."

#: kdesu.cpp:102
msgid "Maintainer"
msgstr "Warrt pleegt vun"

#: kdesu.cpp:104
msgid "Original author"
msgstr "Eerst Autor"

#: kdesu.cpp:127
msgid "Command '%1' not found."
msgstr "Befehl '%1' nich funnen."

#: kdesu.cpp:203
#, c-format
msgid "Illegal priority: %1"
msgstr "Lege Prioriteet: %1"

#: kdesu.cpp:231
msgid "No command specified."
msgstr "Keen Befehl utsökt."

#: kdesu.cpp:339
msgid "Su returned with an error.\n"
msgstr "Neen Befehl angeven!\n"

#: kdesu.cpp:360
msgid "Command:"
msgstr "Befehl:"

#: kdesu.cpp:365
msgid "realtime: "
msgstr "Echttied: "

#: kdesu.cpp:368
msgid "Priority:"
msgstr "Prioriteet:"

#: sudlg.cpp:19
#, c-format
msgid "Run as %1"
msgstr "As %1 utföhrn"

#: sudlg.cpp:23
msgid ""
"The action you requested needs root privileges. Please enter root's password "
"below or click Ignore to continue with your current privileges."
msgstr ""
"De verlangte Aktschoon brukt de Rechten vun den Systempleeger. Bitte em sien "
"Passwoort nerrn ingven oder op Ignoreern klicken, üm mit diene aktuellen "
"Rechten wiedertomaken."

#: sudlg.cpp:27
msgid ""
"The action you requested needs additional privileges. Please enter the password "
"for \"%1\" below or click Ignore to continue with your current privileges."
msgstr ""
"De verlangte Aktschoon brukt mehr Rechten. Bitte dat Passwoort för \"%1\" nerrn "
"ingeven, oder Ignoreern anklicken, üm mit diene aktuellen Rechten "
"wiedertomaken."

#: sudlg.cpp:32
msgid "&Ignore"
msgstr "&Ignoreern"

#: sudlg.cpp:48
msgid "Conversation with su failed."
msgstr "Kommunikatschoon mit Su is fehlslaan."

#: sudlg.cpp:57
msgid ""
"The program 'su' is not found;\n"
"make sure your PATH is set correctly."
msgstr ""
"De Befehle 'su' wöör ni funnen!\n"
"Büst du seker, dat de PATH richtig instellt is?"

#: sudlg.cpp:64
msgid ""
"You are not allowed to use 'su';\n"
"on some systems, you need to be in a special group (often: wheel) to use this "
"program."
msgstr ""
"Du dörffst 'su' nich bruken!\n"
"Op welken Systemen muttst du in'n besünnere Grupp wesen (faken: wheel) üm 'su' "
"to bruken."

#: sudlg.cpp:71
msgid "Incorrect password; please try again."
msgstr "Leeg Passwoort! Versök dat nochmaal."

#: sudlg.cpp:75
msgid "Internal error: illegal return from SuProcess::checkInstall()"
msgstr "Intern Fehler: Leeg Torüchgaav vun SuProcess::checkInstall()"

