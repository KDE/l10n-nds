#. i18n: file ./projects/base_k3bdataimagesettings.ui line 269
#: rc.cpp:791
#, no-c-format
msgid "Replace all spaces"
msgstr "All Leertekens utwesseln"

#. i18n: file ./projects/base_k3bdataimagesettings.ui line 273
#: rc.cpp:794
