#: conflictdialog.cpp:36
msgid "Resolve Conflict"
msgstr "Konflikt oplösen"

#: conflictdialog.cpp:48
msgid "Keep Both"
msgstr "Beed wohren"

#: conflictdialog.cpp:55
msgid "Both entries have changed fields"
msgstr "Beed Indrääg hebbt ännerte Feller"

#: conflictdialog.cpp:55
msgid "Unknown"
msgstr "Nich bekannt"

#: conflictdialog.cpp:84
msgid "Which entry do you want to take precedence?"
msgstr "Welk Indrag schall vörgahn?"

#: syncuikde.cpp:62
msgid "\"%1\" was deleted on %2. Do you want to delete it?"
msgstr "\"%1\" wöör op %2 wegdaan. Wullt Du dat wegdoon?"

#: syncuikde.cpp:64
msgid "Delete?"
msgstr "Wegdoon?"

#: syncuikde.cpp:76
msgid "\"%1\" was deleted on %2 and changed on %3"
msgstr "\"%1\" wöör op %2 wegdaan un op %3 ännert"

#: syncuikde.cpp:77
msgid "Delete or Modify?"
msgstr "Wegdoon oder ännern?"

#: syncuikde.cpp:90
msgid "\"%1\" was changed on both sources. Which one do you want to take?"
msgstr "\"%1\" wöör op beed Borns ännert. Welk Verschoon wullt Du bruken?"

#: syncuikde.cpp:92
msgid "Modified Two Entries"
msgstr "Twee Indrääg ännert"

#: syncuikde.cpp:107
msgid "The entry with the id %1 was deleted on %2 and %3"
msgstr "De Indrag mit de ID %1 wöör op %2 un %3 wegdaan"

