#: fontchooserwidget.cpp:85
msgid "Here you can choose the font to be used."
msgstr "Hier kannst Du de Schriftoort utsöken."

#: fontchooserwidget.cpp:112
msgid "Change font family?"
msgstr "Schriftoorden-Familie ännern?"

#: fontchooserwidget.cpp:114
msgid "Enable this checkbox to change the font family settings."
msgstr "Aktiveer dit, wenn Du de Schriftoorden-Familie ännern wullt."

#: fontchooserwidget.cpp:122
msgid "Font:"
msgstr "Schriftoort:"

#: fontchooserwidget.cpp:132 fontchooserwidget.cpp:149
msgid "Style:"
msgstr "Stil:"

#: fontchooserwidget.cpp:139
msgid "Change font style?"
msgstr "Wullt Du den Schriftstil ännern?"

#: fontchooserwidget.cpp:141
msgid "Enable this checkbox to change the font style settings."
msgstr "Aktiveer dit, wenn Du den Schriftstil ännern wullt."

#: fontchooserwidget.cpp:160
msgid "Size"
msgstr "Grött"

#: fontchooserwidget.cpp:167
msgid "Change font size?"
msgstr "Schriftgrött ännern?"

#: fontchooserwidget.cpp:169
msgid "Enable this checkbox to change the font size settings."
msgstr "Aktiveer dit, wenn Du de Schriftgrött ännern wullt."

#: fontchooserwidget.cpp:177
msgid "Size:"
msgstr "Grött:"

#: fontchooserwidget.cpp:193
msgid "Here you can choose the font family to be used."
msgstr "Hier kannst Du de Schriftoorden-Familie utsöken."

#: fontchooserwidget.cpp:215
msgid "Here you can choose the font style to be used."
msgstr "Hier kannst Du den Schriftstil utsöken."

#: fontchooserwidget.cpp:218 fontchooserwidget.cpp:475
#: fontchooserwidget.cpp:477 fontchooserwidget.cpp:486
#: fontchooserwidget.cpp:487
msgid "Regular"
msgstr "Normaal"

#: fontchooserwidget.cpp:220
msgid "Bold"
msgstr "Fett"

#: fontchooserwidget.cpp:221
msgid "Bold Italic"
msgstr "Fett kursiev"

#: fontchooserwidget.cpp:238
msgid "Relative"
msgstr "Relativ"

#: fontchooserwidget.cpp:240
msgid "Font size<br><i>fixed</i> or <i>relative</i><br>to environment"
msgstr "Schriftgrött <br><i>fast</i> oder <i>relativ</i><br>to de Ümgeven"

#: fontchooserwidget.cpp:242
msgid ""
"Here you can switch between fixed font size and font size to be calculated "
"dynamically and adjusted to changing environment (e.g. widget dimensions, paper "
"size)."
msgstr ""
"Hier kannst Du twischen faste un dünaamsche Schriftgrött wählen. De dünaamsche "
"Schriftgrött warrt automaatsch de Ümgeven topasst (t.B. Elementafmeten oder "
"Papeergrött)."

#: fontchooserwidget.cpp:267
msgid "Here you can choose the font size to be used."
msgstr "Hier kannst Du de Schriftgrött utsöken."

#: fontchooserwidget.cpp:292
msgid "Actual Font"
msgstr "De aktuelle Schriftoort"

#: imageeffect_inserttext.cpp:71
msgid "Insert Text on Photograph"
msgstr "Text in en Foto infögen"

#: imageeffect_inserttext.cpp:79 imageeffect_inserttext.cpp:339
msgid "Insert Text"
msgstr "Text infögen"

#: imageeffect_inserttext.cpp:81
msgid "A digiKam image plugin for inserting text on a photograph."
msgstr "En digiKam-Moduul för't Infögen vun Text in en Bild."

#: imageeffect_inserttext.cpp:87
msgid "Author and maintainer"
msgstr "Autor un Pleger"

#: imageeffect_inserttext.cpp:99
msgid ""
"<p>This is the preview of the text inserted to the image. You can use the mouse "
"for moving the text at the right location."
msgstr ""
"<p>Dit is de Vöransicht vun dat Bild mit den inföögten Text. Du kannst den Text "
"mit de Muus na en anner Steed trecken."

#: imageeffect_inserttext.cpp:111
msgid "<p>Enter here your text to insert on your image."
msgstr "<p>Giff hier den Text in, den Du to Dien Bild tofögen wullt."

#: imageeffect_inserttext.cpp:117
msgid "<p>Here you can choose the font to be used."
msgstr "<p>Hier kannst Du de bruukte Schriftoort utsöken."

#: imageeffect_inserttext.cpp:129
msgid "Align text to the left"
msgstr "Text links utrichten"

#: imageeffect_inserttext.cpp:135
msgid "Align text to the right"
msgstr "Text rechts utrichten"

#: imageeffect_inserttext.cpp:141
msgid "Align text to center"
msgstr "Text in de Merrn utrichten"

#: imageeffect_inserttext.cpp:147
msgid "Align text to a block"
msgstr "Blocksatz"

#: imageeffect_inserttext.cpp:155
msgid "Rotation:"
msgstr "Dreihen:"

#: imageeffect_inserttext.cpp:157
msgid "None"
msgstr "Keen"

#: imageeffect_inserttext.cpp:158
msgid "90 Degrees"
msgstr "90 Graad"

#: imageeffect_inserttext.cpp:159
msgid "180 Degrees"
msgstr "180 Graad"

#: imageeffect_inserttext.cpp:160
msgid "270 Degrees"
msgstr "270 Graad"

#: imageeffect_inserttext.cpp:161
msgid "<p>Select here the text rotation to use."
msgstr "<p>Söök hier de Textdreihen ut."

#: imageeffect_inserttext.cpp:167
msgid "Color:"
msgstr "Klöör:"

#: imageeffect_inserttext.cpp:169
msgid "<p>Set here the font color to use."
msgstr "<p>Legg hier de Schriftklöör fast."

#: imageeffect_inserttext.cpp:175
msgid "Add border"
msgstr "Rahmen tofögen"

#: imageeffect_inserttext.cpp:176
msgid "Add a solid border around text using current text color"
msgstr "Fasten Rahmen mit de aktuelle Textklöör rund den Text tofögen"

#: imageeffect_inserttext.cpp:178
msgid "Semi-transparent"
msgstr "Half-dörsichtig"

#: imageeffect_inserttext.cpp:179
msgid "Use semi-transparent text background under image"
msgstr "Half-dörsichtigen Textachtergrund bruken"

#: imageeffect_inserttext.cpp:236
msgid "Enter your text here!"
msgstr "Giff hier Dien Text in."

#: imageplugin_inserttext.cpp:42
msgid "Insert Text..."
msgstr "Text infögen..."

