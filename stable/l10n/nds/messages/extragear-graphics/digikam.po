#: showfoto/setupeditor.cpp:58 utilities/setup/setupeditor.cpp:59
msgid "&JPEG quality:"
msgstr "&JPEG-Gööd:"

#: showfoto/setupeditor.cpp:60 utilities/setup/setupeditor.cpp:61
msgid ""
"<p>The quality value for JPEG images:"
"<p><b>1</b>: low quality (high compression and small file size)"
"<p><b>50</b>: medium quality"
"<p><b>75</b>: good quality (default)"
"<p><b>100</b>: high quality (no compression and large file size)"
"<p><b>Note: JPEG is not a lossless image compression format.</b>"
msgstr ""
"<p>De Gööd-Weert för JPEG-Biller:"
"<p><b>1</b>: Siete Gööd (hoge Komprimeren un siete Dateigrött)"
"<p><b>50</b>: Middlere Gööd"
"<p><b>75</b>: Gode Gööd (Vörinstellen)"
"<p><b>100</b>: Hoge Gööd (keen Komprimeren un hoge Dateigrött)"
"<p><b>Anmarken: JPEG is en Bildkomprimerenformaat mit Verlusten.</b>"

#: showfoto/setupeditor.cpp:69 utilities/setup/setupeditor.cpp:70
msgid "&PNG compression:"
msgstr "&PNG-Komprimeren:"

#: showfoto/setupeditor.cpp:71 utilities/setup/setupeditor.cpp:72
msgid ""
"<p>The compression value for PNG images:"
"<p><b>1</b>: low compression (large file size but short compression duration - "
"default)"
"<p><b>5</b>: medium compression"
"<p><b>9</b>: high compression (small file size but long compression duration)"
"<p><b>Note: PNG is always a lossless image compression format.</b>"
msgstr ""
"<p>De Komprimeren-Weert för PNG-Biller:"
"<p><b>1</b>: Siete Komprimeren (hoge Dateigrött, man gaue Komprimeren-Duer - "
"Vörinstellen)"
"<p><b>5</b>: Middlere Komprimeren"
"<p><b>9</b>: Hoge Komprimeren (siete Dateigrött, man lange Komprimeren-Duer)"
"<p><b>Anmarken: PNG is jümmers en Bildkomprimerenformaat ahn Verlusten.</b>"

#: showfoto/setupeditor.cpp:79 utilities/setup/setupeditor.cpp:80
msgid "Compress TIFF files"
msgstr "TIFF-Dateien komprimeren"

#: showfoto/setupeditor.cpp:82 utilities/setup/setupeditor.cpp:83
msgid ""
"<p>Toggle compression for TIFF images."
"<p>If you enable this option, you can reduce the final file size of the TIFF "
"image.</p>"
"<p>A lossless compression format (Adobe Deflate) is used to save the file."
"<p>"
msgstr ""
"<p>Komprimeren för TIFF-Biller an-/utmaken."
"<p>Wenn Du disse Optschoon anmaakst, kannst Du de Enngrött vun dat TIFF-Bild "
"minnern.</p>"
"<p>För't Sekern vun de Datei warrt en Komprimeren-Formaat ahn Verlusten (Adobe "
"Deflate) bruukt."
"<p>"

