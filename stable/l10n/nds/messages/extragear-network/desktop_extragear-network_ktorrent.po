#: ktorrent/ktorrent.desktop:2
msgid "Name=KTorrent"
msgstr "Name=KTorrent"

#: ktorrent/ktorrent.desktop:6
msgid "GenericName=BitTorrent Client"
msgstr "GenericName=Bittorrent-Programm"

#: ktorrent/ktorrent.desktop:48
msgid "Comment=A BitTorrent program for KDE"
msgstr "Comment=En Bittorrent-Programm för KDE"

#: ktorrent/ktorrentplugin.desktop:4
msgid "Name=KTorrent Plugin"
msgstr "Name=KTorrent-Moduul"

#: plugins/bitfinder/ktbitfinderplugin.desktop:2
msgid "Name=BitFinderPlugin"
msgstr "Name=\"BitFinder\"-Moduul"

#: plugins/bitfinder/ktbitfinderplugin.desktop:4
msgid "Comment=Plugin to automatically downloads torrents from various sources"
msgstr ""
"Comment=Moduul för't automaatsche Daalladen vun Torrents vun verscheden Borns"

#: plugins/bwscheduler/ktbwschedulerplugin.desktop:2
msgid "Name=BandwidthSchedulerPlugin"
msgstr "Name=Bandbreedplaner-Moduul"

#: plugins/bwscheduler/ktbwschedulerplugin.desktop:4
msgid ""
"Comment=Plugin to schedule upload and download limits over a period of a week"
msgstr "Comment=Moduul för't Planen vun Hooch- un Daallaadgrenzen över en Week"

#: plugins/infowidget/ktinfowidgetplugin.desktop:2
msgid "Name=InfoWidgetPlugin"
msgstr "Name=Infolüttprogramm-Moduul"

#: plugins/infowidget/ktinfowidgetplugin.desktop:4
msgid ""
"Comment=Plugin which displays general information about a torrent in several "
"tabs"
msgstr ""
"Comment=Moduul, dat allgemeen Informatschonen över en Torrent op en Reeg "
"Paneels wiest"

#: plugins/ipfilter/ktipfilterplugin.desktop:2
msgid "Name=IPFilterPlugin"
msgstr "Name=\"IP-Filter\"-Moduul"

#: plugins/ipfilter/ktipfilterplugin.desktop:23
msgid "Comment=IP filter plugin for KTorrent"
msgstr "Comment=\"IP-Filter\"-Moduul för KTorrent"

#: plugins/logviewer/ktlogviewerplugin.desktop:2
msgid "Name=LogViewerPlugin"
msgstr "Name=Logbookkieker-Moduul"

#: plugins/logviewer/ktlogviewerplugin.desktop:22
msgid "Comment=Plugin which displays the logging output generated by KTorrent"
msgstr "Comment=Moduul, dat KTorrent sien Logbook-Utgaven wiest"

#: plugins/mediaplayer/ktmediaplayerplugin.desktop:2
msgid "Name=MediaPlayerPlugin"
msgstr "Name=Afspeler-Moduul"

#: plugins/mediaplayer/ktmediaplayerplugin.desktop:4
msgid "Comment=Phonon based media player plugin for KTorrent"
msgstr "Comment=Afspeler-Moduul för KTorrent, op Phonon opbuut"

#: plugins/scanfolder/ktscanfolderplugin.desktop:2
msgid "Name=ScanFolderPlugin"
msgstr "Name=Moduul för't Dörkieken vun Ornern"

#: plugins/scanfolder/ktscanfolderplugin.desktop:23
msgid ""
"Comment=Plugin to scan directories for torrent files, when files are found, "
"they are loaded"
msgstr ""
"Comment=Moduul för't Dörkieken vun Ornern na Torrentdateien; warrt Dateien "
"funnen, warrt se laadt"

#: plugins/search/ktsearchplugin.desktop:2
msgid "Name=SearchPlugin"
msgstr "Name=Söök-Moduul"

#: plugins/search/ktsearchplugin.desktop:26
msgid "Comment=Search plugin for KTorrent"
msgstr "Comment=Söök-Moduul för KTorrent"

#: plugins/stats/ktstatsplugin.desktop:3
msgid "Name=StatsPlugin"
msgstr "Name=Statistik-Moduul"

#: plugins/stats/ktstatsplugin.desktop:21
msgid "Comment=Plugin which shows statistics about torrents in several graphs"
msgstr ""
"Comment=Moduul, dat Statistiken över Torrents binnen en Reeg Diagrammen wiest"

#: plugins/upnp/ktupnpplugin.desktop:2
msgid "Name=UPnPPlugin"
msgstr "Name=UPnP-Moduul"

#: plugins/upnp/ktupnpplugin.desktop:23
msgid "Comment=Plugin to forward ports using UPnP"
msgstr "Comment=Moduul för't Wiederledden vun Porten mit UPnP"

#: plugins/webinterface/ktwebinterfaceplugin.desktop:2
msgid "Name=WebInterface"
msgstr "Name=Nettkoppelsteed"

#: plugins/webinterface/ktwebinterfaceplugin.desktop:19
msgid "Comment=Plugin to control KTorrent via a webinterface"
msgstr "Comment=Moduul för't Stüern vun KTorrent över en Nettböversiet"

#: plugins/zeroconf/ktzeroconfplugin.desktop:2
msgid "Name=ZeroConfPlugin"
msgstr "Name=ZeroConf-Moduul"

#: plugins/zeroconf/ktzeroconfplugin.desktop:19
msgid ""
"Comment=Plugin to discover peers on the local network using the zeroconf "
"protocol"
msgstr ""
"Comment=Moduul för't Finnen vun Partners in't lokale Nettwark över't "
"Zeroconf-Protokoll"

