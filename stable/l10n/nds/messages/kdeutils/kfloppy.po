#: format.cpp:264
#, c-format
msgid "Unexpected drive number %1."
msgstr "Dat Loopwark %1 gifft dat nich."

#: format.cpp:270
#, c-format
msgid "Unexpected density number %1."
msgstr "De Schrievdichte %1 gifft dat nich."

#: format.cpp:285
msgid "Cannot find a device for drive %1 and density %2."
msgstr "Kunn dat Reedschap för dat Loopwark %1 un de Schrievdichte %2 nich finnen."

#: format.cpp:304
msgid ""
"Cannot access %1\n"
"Make sure that the device exists and that you have write permission to it."
msgstr ""
"Kunn op %1 nich togriepen\n"
"Verseker di dat dat Reedschap dor is und du Verlööf hest, dor to schrieven."

#: format.cpp:333
msgid "%1 terminated abnormally."
msgstr "%1 mitmal afbroken."

#: format.cpp:402
msgid "Cannot find fdformat."
msgstr "Kunn dat Programm fdformat nich finnen."

#: format.cpp:434
msgid "Could not start fdformat."
msgstr "Dat Programm fdformat lett sik nich starten."

#: format.cpp:461
#, c-format
msgid "Error formatting track %1."
msgstr "Fehler bi't Formateern vun Spoor %1"

#: format.cpp:469 format.cpp:502
msgid ""
"Cannot access floppy or floppy drive.\n"
"Please insert a floppy and make sure that you have selected a valid floppy "
"drive."
msgstr ""
"Kunn nich op de Diskett oder dat Diskettenloopwark togriepen.\n"
"Büdde legg 'n Diskett in un kiek dat du dat richtige Diskettenloopwark "
"tofaat hest."

