#. Tag: title
#: index.docbook:732
#, no-c-format
msgid "Rename Tab Dialog"
msgstr ""

#. Tag: para
#: index.docbook:734
#, no-c-format
msgid ""
"The name of the current tab can be changed from this dialog. The dialog can "
"be displayed via the menu, the shortcut <keycombo action=\"simul\">&Ctrl;"
"&Alt;<keycap>S</keycap></keycombo> or by double-clicking on the tab in the "
"tab bar. These changes can be made permanent by editing the current profile."
msgstr ""

#. Tag: para
#: index.docbook:741
#, no-c-format
msgid "&konsole; will substitute these tokens:"
msgstr ""

#. Tag: para
#: index.docbook:744
#, no-c-format
msgid "%n : program name"
msgstr ""

#. Tag: para
#: index.docbook:745
#, no-c-format
msgid "%d : current directory (short)"
msgstr ""

#. Tag: para
#: index.docbook:746
#, no-c-format
msgid "%D : current directory (long)"
msgstr ""

#. Tag: para
#: index.docbook:747
#, no-c-format
msgid "%w : window title set by shell"
msgstr ""

#. Tag: para
#: index.docbook:748
#, no-c-format
msgid "%# : session number"
msgstr ""

#. Tag: para
#: index.docbook:749
#, no-c-format
msgid "%u : user name"
msgstr ""

#. Tag: para
#: index.docbook:753 index.docbook:1022
#, no-c-format
msgid "Examples:"
msgstr ""

#. Tag: para
#: index.docbook:757
#, no-c-format
msgid ""
"<userinput>%d : %n</userinput> with /usr/src as current directory and "
"running <application>bash</application> will display <guibutton>usr/s : "
"bash</guibutton>"
msgstr ""

#. Tag: para
#: index.docbook:764
#, no-c-format
msgid ""
"<userinput>%D : %n</userinput> with /usr/src as current directory and "
"running <application>top</application> will display <guibutton>/usr/src : "
"top</guibutton>"
msgstr ""

#. Tag: para
#: index.docbook:771
#, no-c-format
msgid ""
"<userinput>%w (%#)</userinput> with ~ as current directory and running "
"<application>vim</application> in the first tab will display <guibutton>[No "
"Name] (~) - VIM(1)</guibutton>"
msgstr ""

#. Tag: title
#: index.docbook:785
#, no-c-format
msgid "Copy Input Dialog"
msgstr ""

#. Tag: para
#: index.docbook:787
#, no-c-format
msgid ""
"The text entered in one tab can simultaneously be sent to other tabs. This "
"dialog allows you to select which tabs will get that input. The current tab "
"will be greyed out."
msgstr ""

#. Tag: title
#: index.docbook:809
#, no-c-format
msgid "Adjust Scrollback Dialog"
msgstr ""

#. Tag: para
#: index.docbook:811
#, no-c-format
msgid ""
"The <link linkend=\"scrollback\">scrollback</link> options for the history "
"size can be changed in this dialog. Any changes are for the current tab only "
"and will not be saved to the profile."
msgstr ""

#. Tag: title
#: index.docbook:822
#, no-c-format
msgid "Command-line Options"
msgstr ""

#. Tag: para
#: index.docbook:824
#, no-c-format
msgid ""
"When &konsole; is started from the command line, various options can be "
"specified to modify its behavior."
msgstr ""

#. Tag: option
#: index.docbook:829
#, no-c-format
msgid "--help"
msgstr ""

#. Tag: para
#: index.docbook:830
#, no-c-format
msgid "<action>List various options</action>."
msgstr ""

#. Tag: term
#: index.docbook:834
#, no-c-format
msgid "<option>--profile</option> <parameter>file</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:835
#, no-c-format
msgid ""
"<action>Start &konsole;</action> using the specified profile instead of the "
"default profile."
msgstr ""

#. Tag: option
#: index.docbook:840
#, no-c-format
msgid "--list-profiles"
msgstr ""

#. Tag: para
#: index.docbook:841
#, no-c-format
msgid "<action>List</action> all available profiles."
msgstr ""

#. Tag: option
#: index.docbook:846
#, no-c-format
msgid "--list-profile-properties"
msgstr ""

#. Tag: para
#: index.docbook:848
#, no-c-format
msgid ""
"<action>List</action> all possible properties with name and type. See option "
"<option>-p</option> ."
msgstr ""

#. Tag: para
#: index.docbook:850
#, no-c-format
msgid ""
"For more information, please visit <ulink url=\"http://api.kde.org/4.x-api/"
"kde-baseapps-apidocs/konsole/html/classKonsole_1_1Profile."
"html#a57848e15fe69d3f27565851fe7cda429\">&konsole; API Reference</ulink>."
msgstr ""

#. Tag: option
#: index.docbook:858
#, no-c-format
msgid "--background-mode"
msgstr ""

#. Tag: para
#: index.docbook:859
#, no-c-format
msgid ""
"<action>Start &konsole;</action> in the background and bring to the front "
"when <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>F12</keycap></keycombo> "
"(by default) is pressed."
msgstr ""

#. Tag: option
#: index.docbook:864
#, no-c-format
msgid "--new-tab"
msgstr ""

#. Tag: para
#: index.docbook:865
#, no-c-format
msgid ""
"<action>Create a new tab</action> in an existing window rather than creating "
"a new window."
msgstr ""

#. Tag: term
#: index.docbook:870
#, no-c-format
msgid "<option>--tabs-from-file </option><parameter>file</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:871
#, no-c-format
msgid ""
"<action>Create tabs</action> as specified in the given tabs configuration "
"file."
msgstr ""

#. Tag: para
#: index.docbook:873
#, no-c-format
msgid "The file has one tab per line in the following format:"
msgstr ""

#. Tag: para
#: index.docbook:873
#, no-c-format
msgid ""
"title: PUT A TITLE ;; command: PUT A COMMAND ;; workdir: PUT A DIRECOTRY"
msgstr ""

#. Tag: term
#: index.docbook:880
#, no-c-format
msgid "<option>--workdir</option> <parameter>dir</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:881
#, no-c-format
msgid ""
"<action>Open with</action> <parameter>dir</parameter> as the initial working "
"directory."
msgstr ""

#. Tag: option
#: index.docbook:886
#, no-c-format
msgid "--show-menubar"
msgstr ""

#. Tag: para
#: index.docbook:887
#, no-c-format
msgid "<action>Show</action> the menubar, overriding the default behavior."
msgstr ""

#. Tag: option
#: index.docbook:892
#, no-c-format
msgid "--hide-menubar"
msgstr ""

#. Tag: para
#: index.docbook:893
#, no-c-format
msgid "<action>Hide</action> the menubar, overriding the default behavior."
msgstr ""

#. Tag: option
#: index.docbook:898
#, no-c-format
msgid "--show-tabbar"
msgstr ""

#. Tag: para
#: index.docbook:899
#, no-c-format
msgid "<action>Show</action> the tabbar, overriding the default behavior."
msgstr ""

#. Tag: option
#: index.docbook:904
#, no-c-format
msgid "--hide-tabbar"
msgstr ""

#. Tag: para
#: index.docbook:905
#, no-c-format
msgid "<action>Hide</action> the tabbar, overriding the default behavior."
msgstr ""

#. Tag: option
#: index.docbook:910
#, no-c-format
msgid "--notransparency"
msgstr ""

#. Tag: para
#: index.docbook:911
#, no-c-format
msgid ""
"<action>Disable</action> transparent backgrounds, even if the system "
"supports them."
msgstr ""

#. Tag: option
#: index.docbook:916
#, no-c-format
msgid "--hold, --noclose"
msgstr ""

#. Tag: para
#: index.docbook:917
#, no-c-format
msgid ""
"<action>Do not close</action> the initial session automatically when it ends."
msgstr ""

#. Tag: term
#: index.docbook:922
#, no-c-format
msgid "<option>-p</option> <parameter>property=value</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:923
#, no-c-format
msgid "<action>Change</action> the value of a profile property."
msgstr ""

#. Tag: term
#: index.docbook:928
#, no-c-format
msgid "<option>-e</option> <parameter>command</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:929
#, no-c-format
msgid ""
"<action>Execute</action> <parameter>command</parameter> instead of the "
"normal shell."
msgstr ""

#. Tag: para
#: index.docbook:931
#, no-c-format
msgid ""
"This option will catch all following arguments passed to &konsole;, and "
"execute it as <parameter>command</parameter>. So this option should always "
"be used as the last option."
msgstr ""

#. Tag: option
#: index.docbook:936
#, no-c-format
msgid "--nofork"
msgstr ""

#. Tag: para
#: index.docbook:937
#, no-c-format
msgid ""
"<action>Do not run in the background</action>. This is often needed to mimic "
"other terminal emulators."
msgstr ""

#. Tag: para
#: index.docbook:943
#, no-c-format
msgid "&konsole; also accepts generic &Qt; and &kde; options:"
msgstr ""

#. Tag: option
#: index.docbook:947
#, no-c-format
msgid "--help-qt"
msgstr ""

#. Tag: action
#: index.docbook:948
#, no-c-format
msgid "List &Qt;-specific options"
msgstr ""

#. Tag: para
#: index.docbook:952
#, no-c-format
