#. Tag: title
#: configuring.docbook:8
#, no-c-format
msgid "Configuring &kate;"
msgstr "&kate; instellen"

#. Tag: title
#: configuring.docbook:11
#, no-c-format
msgid "Overview"
msgstr "Översicht"

#. Tag: primary
#: configuring.docbook:14
#, no-c-format
msgid "configure"
msgstr "Instellen"

#. Tag: secondary
#: configuring.docbook:15
#, no-c-format
msgid "settings"
msgstr "Instellen"

#. Tag: tertiary
#: configuring.docbook:16
#, no-c-format
msgid "preferences"
msgstr "Vörinstellen"

#. Tag: para
#: configuring.docbook:16
#, no-c-format
msgid ""
"&kate; offers several means of tweaking the application to behave as "
"desired. The most important ones are:"
msgstr ""

#. Tag: term
#: configuring.docbook:30
#, no-c-format
msgid "The Configuration Dialog"
msgstr ""

#. Tag: para
#: configuring.docbook:31
#, no-c-format
msgid ""
"The main configuration tool, allowing you to configure the &kate; "
"application, the editor component and the usage of plugins."
msgstr ""

#. Tag: term
#: configuring.docbook:35
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: para
#: configuring.docbook:36
#, no-c-format
msgid ""
"Allows you to change often used settings, and to launch the configuration "
"dialogs."
msgstr ""

#. Tag: term
#: configuring.docbook:40
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: para
#: configuring.docbook:41
#, no-c-format
msgid ""
"Allows you to split the current frame, as well as to display the icons and "
"line numbers pane for the currently edited document."
msgstr ""

#. Tag: para
#: configuring.docbook:47
#, no-c-format
msgid ""
"The embedded terminal is using the configuration defined in the "
"&systemsettings;, and may be configured by clicking the <mousebutton>right</"
"mousebutton> mouse button to display a context menu."
msgstr ""

#. Tag: title
#: configuring.docbook:54
#, no-c-format
msgid "The Main Configuration Dialog"
msgstr ""

#. Tag: para
#: configuring.docbook:62
#, no-c-format
msgid ""
"The &kate; configuration dialog displays a tree of topics on the left, and a "
"configuration page corresponding to the selected topic on the right."
msgstr ""

#. Tag: para
#: configuring.docbook:66
#, no-c-format
msgid "The configuration is divided into two groups, namely"
msgstr ""

#. Tag: link
#: configuring.docbook:68
#, no-c-format
msgid "Application configuration"
msgstr ""

#. Tag: link
#: configuring.docbook:70
#, no-c-format
msgid "Editor component configuration"
msgstr ""

#. Tag: title
#: configuring.docbook:79
#, no-c-format
msgid "The &kate; Application Configuration"
msgstr ""

#. Tag: para
#: configuring.docbook:80
#, no-c-format
msgid "This group contains pages to configure the main &kate; application"
msgstr ""

#. Tag: title
#: configuring.docbook:83
#, no-c-format
msgid "General"
msgstr ""

#. Tag: para
#: configuring.docbook:84
#, no-c-format
msgid "This section contains a few global options for &kate;"
msgstr ""

#. Tag: guilabel
#: configuring.docbook:90
#, no-c-format
msgid "Behavior"
msgstr "Bedregen"

#. Tag: guilabel
#: configuring.docbook:96
#, no-c-format
msgid "Warn about files modified by foreign processes"
msgstr ""

#. Tag: para
#: configuring.docbook:97
#, no-c-format
msgid ""
"When enabled, &kate; will notify you about files modified from outside the "
"application whenever the main window receives input focus. You will be able "
"to deal with several modified files at once, you can reload, save or discard "
"changed files in groups."
msgstr ""

#. Tag: para
#: configuring.docbook:101
#, no-c-format
msgid ""
"If not enabled, &kate; will prompt you for action when a externally modified "
"file receives focus within the application."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:112
#, no-c-format
msgid "Meta Information"
msgstr ""

#. Tag: guilabel
#: configuring.docbook:118
#, no-c-format
msgid "Keep meta-information past sessions"
msgstr ""

#. Tag: para
#: configuring.docbook:119
#, no-c-format
msgid ""
"When enabled, &kate; will store meta data such as bookmarks and session "
"configuration even when you close your documents. The data will be used if "
"the document is unchanged when reopened."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:126
#, no-c-format
msgid "Delete unused meta information after"
msgstr ""

#. Tag: para
#: configuring.docbook:127
#, no-c-format
msgid ""
"Set the maximum number of days to keep meta information for unopen files. "
"This helps keeping the database of meta information reasonably sized."
msgstr ""

#. Tag: title
#: configuring.docbook:141
#, no-c-format
msgid "Sessions"
msgstr "Törns"

#. Tag: para
#: configuring.docbook:143
#, no-c-format
msgid ""
"This section contains options related to <link linkend=\"fundamentals-using-"
"sessions\">using sessions</link>."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:150
#, no-c-format
msgid "Elements of Sessions"
msgstr ""

#. Tag: guilabel
#: configuring.docbook:154
#, no-c-format
msgid "Include window configuration"
msgstr ""

#. Tag: para
#: configuring.docbook:155
#, no-c-format
msgid ""
"If enabled, &kate; will save the window configuration with each session."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:164
#, no-c-format
msgid "Behavior on Application Startup"
msgstr ""

#. Tag: para
#: configuring.docbook:166
#, no-c-format
msgid ""
"Select how you want &kate; to behave at startup. This setting can be "
"overridden by specifying what to do on the <link linkend=\"command-line-"
"options\">command line</link>."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:171
#, no-c-format
msgid "Start new session"
msgstr "Niegen Törn starten"

#. Tag: para
#: configuring.docbook:172
#, no-c-format
msgid ""
"With this option, &kate; will start a new, unnamed session when you start it."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:176
#, no-c-format
msgid "Load last-used session"
msgstr ""

#. Tag: para
#: configuring.docbook:177
#, no-c-format
msgid ""
"&kate; will use the most recently opened session at startup. This is good if "
"you want to use the same session always or switch rarely."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:182
#, no-c-format
msgid "Manually choose a session"
msgstr ""

#. Tag: para
#: configuring.docbook:183
#, no-c-format
msgid ""
"&kate; will display a small dialog that lets you choose your preferred "
"session, or load the default session if none have been saved. This is the "
"default behavior. Nice if you use a lot of different sessions frequently."
msgstr ""

#. Tag: para
#: configuring.docbook:193
#, no-c-format
msgid ""
"The changes to the session data (opened files and if enabled, window "
"configuration) will always be saved."
msgstr ""

#. Tag: title
#: configuring.docbook:199
#, no-c-format
msgid "Plugins"
msgstr ""

#. Tag: para
#: configuring.docbook:201
#, no-c-format
msgid ""
"This page provides a list of installed plugins for the &kate; application. "
"Each plug-in is represented with its name and a short description. You can "
"check the checkbox with an item to enable the plug-in it represents."
msgstr ""

#. Tag: para
#: configuring.docbook:206
#, no-c-format
msgid ""
"If a plug-in provides configuration options, a section to access those will "
"appear as a child of this page."
msgstr ""

#. Tag: para
#: configuring.docbook:209
#, no-c-format
msgid ""
"For more information about the available plugins, see <xref linkend=\"plugins"
"\"/>."
msgstr ""

#. Tag: title
#: configuring.docbook:215
#, no-c-format
msgid "Documents"
msgstr ""

#. Tag: guilabel
#: configuring.docbook:219
#, no-c-format
msgid "Background Shading"
msgstr ""

#. Tag: para
#: configuring.docbook:220
#, no-c-format
msgid ""
"This section allows you to enable or disable the background shading "
"visualization of your recent activity, and chose which colors to use if "
"enabled. See the section about <link linkend=\"kate-mdi-tools-file-list"
"\">The Document List</link> for more about this feature."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:228
#, no-c-format
msgid "Sort By"
msgstr ""

#. Tag: para
#: configuring.docbook:229
#, no-c-format
msgid ""
"Set how you want the document list sorted. This can be set from the &RMB; "
"menu in the document list as well."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:234 configuring.docbook:249
#, no-c-format
msgid "Show Full Path"
msgstr ""

#. Tag: para
#: configuring.docbook:235
#, no-c-format
msgid ""
"When enabled, in tree mode, top level folders will show up with their full "
"path rather than just the last folder name."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:240
#, no-c-format
msgid "View Mode"
msgstr ""

#. Tag: para
#: configuring.docbook:241
#, no-c-format
msgid ""
"This provides two options that effect the display of the Documents tool "
"view. The <guilabel>Tree View</guilabel> option will display the documents "
"in a tree underneath the folders they are in, while the <guilabel>List View</"
"guilabel> option will display a flat list of documents."
msgstr ""

#. Tag: para
#: configuring.docbook:250
#, no-c-format
msgid ""
"When Tree View and this option are enabled, the folder entries displayed in "
"the Documents tool view will display the full filesystem path to the folder "
"in addition to the name of the folder. It has no effect in List View."
msgstr ""

#. Tag: title
#: configuring.docbook:261
#, no-c-format
msgid "Terminal"
msgstr ""

#. Tag: para
#: configuring.docbook:263
#, no-c-format
msgid ""
"This page is only displayed by the Terminal Tool View plugin, which is "
"enabled by default."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:269
#, no-c-format
msgid ""
"Automatically synchronize the terminal with the current document when "
"possible"
msgstr ""

#. Tag: para
#: configuring.docbook:270
#, no-c-format
msgid ""
"This will cause the built-in terminal to <command>cd</command> into the "
"directory of the active document when launched and when a new document gets "
"the focus. If not enabled, you have to do all your navigation in the "
"terminal on your own."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:278
#, no-c-format
msgid "Set EDITOR environment variable to 'kate -b'"
msgstr ""

#. Tag: para
#: configuring.docbook:279
#, no-c-format
msgid ""
"This sets the <envar>EDITOR</envar> environment variable so programs run in "
"the built-in terminal that automatically open a file in an editor will open "
"them in &kate; instead of the default editor configured in your shell. You "
"will not be able to continue using the terminal until you have closed the "
"file in &kate;, so the calling program is aware you have finished editing "
"the file."
msgstr ""

#. Tag: chapter
#: configuring.docbook:288
#, fuzzy, no-c-format
#| msgid "Configuring &kate;"
msgid "&configuring-part-sections;"
msgstr "&kate; instellen"

#. Tag: title
#: configuring.docbook:293
#, no-c-format
msgid "Configuring With Document Variables"
msgstr ""

#. Tag: para
#: configuring.docbook:295
#, no-c-format
msgid ""
"&kappname; variables is katepart's implementation of document variables, "
"similar to emacs and vi modelines. In katepart, the lines have the following "
"format: <userinput>kate: VARIABLENAME VALUE; [ VARIABLENAME VALUE; ... ]</"
"userinput> The lines can of course be in a comment, if the file is in a "
"format with comments. Variable names are single words (no whitespace), and "
"anything up to the next semicolon is the value. The semicolon is required."
msgstr ""

#. Tag: para
#: configuring.docbook:304
#, no-c-format
msgid ""
"Here is an example variable line, forcing indentation settings for a C++, "
"java or javascript file:"
msgstr ""

#. Tag: programlisting
#: configuring.docbook:307
#, no-c-format
msgid "// kate: replace-tabs on; indent-width 4; indent-mode cstyle;"
msgstr ""

#. Tag: para
#: configuring.docbook:310
#, no-c-format
msgid "Only the first and last 10 lines are searched for variable lines."
msgstr ""

#. Tag: para
#: configuring.docbook:312
#, no-c-format
msgid ""
"Additionally, document variables can be placed in a file called <filename>."
"kateconfig</filename> in any directory, and the configured settings will be "
"applied as if the modelines were entered on every file in the directory and "
"its subdirectories, as far down as the <link linkend=\"pref-open-save-"
"advanced\">configured search depth.</link> Document variables in <filename>."
"kateconfig</filename> use the same syntax as in modelines."
msgstr ""

#. Tag: para
#: configuring.docbook:320
#, no-c-format
msgid ""
"There are variables to support almost all configurations in katepart, and "
"additionally plugins can use variables, in which case it should be "
"documented in the plugin's documentation."
msgstr ""

#. Tag: title
#: configuring.docbook:325
#, no-c-format
msgid "How &kappname; uses Variables"
msgstr ""

#. Tag: para
#: configuring.docbook:327
#, no-c-format
msgid ""
"When reading configuration, katepart looks in the following places (in that "
"order): <itemizedlist> <listitem><para>The global configuration.</para></"
"listitem> <listitem><para>Optional session data.</para></listitem> "
"<listitem><para>The \"Filetype\" configuration.</para></listitem> "
"<listitem><para>Document variables in <filename>.kateconfig</filename>.</"
"para></listitem> <listitem><para>Document variables in the document itself.</"
"para></listitem> <listitem><para>Settings made during editing from menu or "
"command line.</para></listitem> </itemizedlist> As you see, document "
"variables are only overriden by changes made at runtime. Whenever a document "
"is saved, the document variables are reread, and will overwrite changes made "
"using menu items or the command line."
msgstr ""

#. Tag: para
#: configuring.docbook:343
#, no-c-format
msgid ""
"Any variable not listed below is stored in the document and can be queried "
"by other objects such as plugins, which can use them for their own purpose. "
"For example, the variable indent mode uses document variables for its "
"configuration."
msgstr ""

#. Tag: para
#: configuring.docbook:348
#, no-c-format
msgid ""
"The variables listed here documents &kappname; version 3.7. More variables "
"may be added in the future. There are 3 possible types of values for "
"variables, with the following valid expressions:"
msgstr ""

#. Tag: para
#: configuring.docbook:352
#, no-c-format
msgid "BOOL - on|off|true|false|1|0"
msgstr ""

#. Tag: para
#: configuring.docbook:353
#, no-c-format
msgid "INTEGER - any integer number"
msgstr ""

#. Tag: para
#: configuring.docbook:354
#, no-c-format
msgid "STRING - anything else"
msgstr ""

#. Tag: title
#: configuring.docbook:361
#, no-c-format
msgid "Available Variables"
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:366
#, no-c-format
msgid "<command>auto-center-lines</command><arg>INT</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:367
#, no-c-format
msgid "Set the number of autocenter lines."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:371
#, no-c-format
msgid "<command>auto-insert-doxygen</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:372
#, no-c-format
msgid ""
"Turn insertion of the leading asterisk in doxygen comments on or off. This "
"has no effect unless you use the C-style auto-indenter."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:377
#, no-c-format
msgid "<command>background-color</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:378
#, no-c-format
msgid ""
"Set the document background color. The value must be something that can be "
"evaluated to a valid color, for example <userinput>#ff0000</userinput>."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:384
#, no-c-format
msgid "<command>backspace-indents</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:385
#, no-c-format
msgid "Enable or disable unindenting when &Backspace; is pressed."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:389
#, no-c-format
msgid "<command>block-selection</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:390
#, no-c-format
msgid ""
"Turn <link linkend=\"kate-part-selection-block\">block selection</link> on "
"or off."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:395
#, no-c-format
msgid "<command>bom | byte-order-marker</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:396
#, no-c-format
msgid ""
"Enable/disable the byte order marker when saving files in unicode format "
"(utf8, utf16, utf32)."
msgstr ""

#. Tag: para
#: configuring.docbook:398 configuring.docbook:426
#, no-c-format
msgid "Since: Kate 3.4 (KDE 4.4)"
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:402
#, no-c-format
msgid "<command>encoding</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:403
#, no-c-format
msgid ""
"Set the encoding used for loading or saving the file. As the variables in "
"the document will be read after loading, this impacts only the saving. If "
"you place it in a <filename>.kateconfig</filename> file, it will have an "
"effect for the loading, too."
msgstr ""

#. Tag: para
#: configuring.docbook:406
#, no-c-format
msgid "Since: Kate 3.10 (KDE 4.10)"
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:410
#, no-c-format
msgid "<command>bracket-highlight-color</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:411
#, no-c-format
msgid ""
"Set the color for the bracket highlight. The value must be something that "
"can be evaluated to a valid color, for example <userinput>#ff0000</"
"userinput>."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:417
#, no-c-format
msgid "<command>current-line-color</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:418
#, no-c-format
msgid ""
"Set the color for the current line. The value must be something that can be "
"evaluated to a valid color, for example <userinput>#ff0000</userinput>"
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:424
#, no-c-format
msgid "<command>default-dictionary</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:425
#, no-c-format
msgid "Sets the default dictionary used for spell checking."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:430
#, no-c-format
msgid "<command>dynamic-word-wrap</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:431
#, no-c-format
msgid ""
"Turns <link linkend=\"kate-part-auto-wrap\">dynamic word wrap</link> on or "
"off."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:436
#, no-c-format
msgid "<command>eol | end-of-line</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:437
#, no-c-format
msgid ""
"Set the end of line mode. Valid settings are <userinput>unix</userinput>, "
"<userinput>mac</userinput> and <userinput>dos</userinput>"
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:442
#, no-c-format
msgid "<command>folding-markers</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:443
#, no-c-format
msgid ""
"Set the display of <ulink url=\"help:/kate/advanced-editing-tools-code-"
"folding.html\">folding markers</ulink> on or off."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:450
#, no-c-format
msgid "<command>font-size</command><arg>INT</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:451
#, no-c-format
msgid "Set the point size of the document font."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:455
#, no-c-format
msgid "<command>font</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:456
#, no-c-format
msgid ""
"Set the font of the document. The value should be a valid font name, for "
"example <userinput>courier</userinput>."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:461
#, no-c-format
msgid "<command>hl | syntax</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:462
#, no-c-format
msgid ""
"Set the syntax highlighting. Valid strings are all the names available in "
"the menus. For instance, for C++ simply write <userinput>C++</userinput>."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:467
#, no-c-format
msgid "<command>icon-bar-color</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:468
#, no-c-format
msgid ""
"Set the icon bar color. The value must be something that can be evaluated to "
"a valid color, for example <userinput>#ff0000</userinput>."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:473
#, no-c-format
msgid "<command>icon-border</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:474
#, no-c-format
msgid "Set the display of the icon border on or off."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:478
#, no-c-format
msgid "<command>indent-mode</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:479
#, no-c-format
msgid ""
"Set the auto-indentation mode. The options <userinput>none</userinput>, "
"<userinput>normal</userinput>, <userinput>cstyle</userinput>, "
"<userinput>haskell</userinput>, <userinput>lilypond</userinput>, "
"<userinput>lisp</userinput>, <userinput>python</userinput>, <userinput>ruby</"
"userinput> and <userinput>xml</userinput> are recognized. See the section "
"<xref linkend=\"kate-part-autoindent\"/> for details."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:487
#, no-c-format
msgid "<command>indent-pasted-text</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:488
#, no-c-format
msgid "Enable/disable adjusting indentation of text pasted from the clipboard."
msgstr ""

#. Tag: para
#: configuring.docbook:489
#, no-c-format
msgid "Since: Kate 3.11 (KDE 4.11)"
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:493
#, no-c-format
msgid "<command>indent-width</command><arg>INT</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:494
#, no-c-format
msgid "Set the indentation width."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:498
#, no-c-format
msgid "<command>keep-extra-spaces</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:499
#, no-c-format
msgid "Set whether to keep extra spaces when calculating indentation width."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:503
#, no-c-format
msgid "<command>line-numbers</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:504
#, no-c-format
msgid "Set the display of line numbers on or off."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:508
#, no-c-format
msgid "<command>mixed-indent</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:509
#, no-c-format
