msgstr ""

#. Tag: para
#: plugins.docbook:1256
#, no-c-format
msgid ""
"The following options are always displayed at the top of the Search in Files "
"tool view:"
msgstr ""

#. Tag: guiicon
#: plugins.docbook:1262
