#, no-c-format
msgid ""
"Displays <guilabel>Name</guilabel>, <guilabel>Date</guilabel>, "
"<guilabel>Size</guilabel> and <guilabel>Type</guilabel> of the files."
msgstr ""

#. Tag: guimenuitem
