msgstr "Inföhren"

#. Tag: para
#: plugins.docbook:1241
#, no-c-format
msgid ""
"&kappname;'s Search &amp; Replace plugin allows you to search for text or "
"<link linkend=\"regular-expressions\">regular expressions</link> in many "
"different files at once. You can search all open files, all the files in one "
"directory and optionally its subdirectories, or all files in the current "
"project. You can even filter by filename, for instance searching only files "
"that end with a particular file extension."
msgstr ""

#. Tag: title
#: plugins.docbook:1251 plugins.docbook:1629
#, no-c-format
msgid "Interface"
msgstr ""

#. Tag: title
#: plugins.docbook:1254
#, no-c-format
