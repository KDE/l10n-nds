#. Tag: guibutton
#: plugins.docbook:1513
#, no-c-format
msgid "Bookmarks"
msgstr "Leestekens"

#. Tag: para
#: plugins.docbook:1514
#, no-c-format
msgid ""
"Opens a submenu to edit or add bookmarks and to add a new bookmark folder."
