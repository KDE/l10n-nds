#. Tag: title
#: functions.docbook:3503
#, no-c-format
msgid "EURO"
msgstr "Euro"

#. Tag: para
#: functions.docbook:3504
#, no-c-format
msgid ""
"The EURO() function converts one Euro to a given national currency in the "
"European monetary union. Currency is one of the following: ATS (Austria), "
"BEF (Belgium), DEM (Germany), ESP (Spain), EUR (Euro), FIM (Finland), FRF "
"(France), GRD (Greece), IEP (Ireland), ITL (Italy), LUF (Luxembourg), NLG "
"(Netherlands), or PTE (Portugal)."
msgstr ""
"De Funkschoon EURO() wannelt een Euro na en angeven natschonaal Geldsort in "
"de europääsch Geldsortenunioon üm. Geldsorten sünd: ATS (Österriek), BEF "
"(Belgien), DEM (Düütschland), ESP (Spanien), EUR (Euro), FIM (Finnland), FRF "
"(Frankriek), GRD (Grekenland), IEP (Irland), ITL (Italien), LUF (Luxemborg), "
"NLG (Nedderlannen), oder PTE (Portugal)."

#. Tag: para
#: functions.docbook:3509
#, no-c-format
msgid "EURO(currency)"
msgstr "EURO(Geldsort)"

