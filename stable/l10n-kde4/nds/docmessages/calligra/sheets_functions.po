#, no-c-format
msgid "TRANSPOSE(A1:C3)"
msgstr "TRANSPOSE(A1:C3)"

#. Tag: title
#: functions.docbook:7512
#, no-c-format
msgid "TRUNC"
msgstr ""

#. Tag: para
#: functions.docbook:7513
#, no-c-format
msgid ""
"The TRUNC() function truncates a numeric value to a certain precision. If "
"the precision is omitted 0 is assumed."
msgstr ""
"De Funkschoon TRUNC() sniedt en numeersch Weert na en angeven Nauigkeit af. "
"Wenn keen Nauigkeit angeven is, warrt \"0\" vermoodt."

#. Tag: para
#: functions.docbook:7518
#, no-c-format
msgid "TRUNC(value; precision)"
msgstr "TRUNC(Weert; Nauigkeit)"

#. Tag: seg
#: functions.docbook:7523
#, no-c-format
msgid "Precision"
msgstr "Nauigkeit"

#. Tag: para
#: functions.docbook:7526
#, no-c-format
msgid "TRUNC(1.2) returns 1"
msgstr "TRUNC(1.2) gifft \"1\" torüch"

#. Tag: para
#: functions.docbook:7529
#, no-c-format
msgid "TRUNC(213.232; 2) returns 213.23"
msgstr "TRUNC(213.232; 2) gifft \"213.23\" torüch"

#. Tag: title
#: functions.docbook:7542
#, no-c-format
msgid "Statistical"
msgstr "Statistik"

#. Tag: title
#: functions.docbook:7545
#, no-c-format
msgid "AVEDEV"
msgstr ""

#. Tag: para
#: functions.docbook:7546
#, no-c-format
msgid ""
"The AVEDEV() function calculates the average of the absolute deviations of a "
"data set from their mean."
msgstr ""
"De Funkschoon AVEDEV() reekt den Dörsnitt vun de afsoluten Verschelen vun en "
"Datensett ut ehr Middelweerten ut."

#. Tag: para
#: functions.docbook:7551
#, no-c-format
msgid "AVEDEV(value;value;...)"
msgstr "AVEDEV(Weert;Weert;...)"

