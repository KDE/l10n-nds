#: functions.docbook:3513
#, no-c-format
msgid "Currency"
msgstr "Geldsort"

#. Tag: para
#: functions.docbook:3516
#, no-c-format
msgid "EURO(\"DEM\") equals 1.95583"
msgstr "EURO(\"DEM\") is liek as 1,95583"

