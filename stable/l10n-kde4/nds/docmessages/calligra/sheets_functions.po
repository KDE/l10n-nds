#: functions.docbook:10572
#, no-c-format
msgid "ATAN2(value;value)"
msgstr "ATAN2(Weert;Weert)"

#. Tag: para
#: functions.docbook:10580
#, no-c-format
msgid "ATAN2(0.5;1.0) equals 1.107149"
msgstr "ATAN2(0,5;1,0) is 1,107149"

#. Tag: para
#: functions.docbook:10583
#, no-c-format
msgid "ATAN2(-0.5;2.0) equals 1.815775"
msgstr "ATAN2(-0,5;2,0) is 1,815775"

