msgid "&File"
msgstr "&Datei"

#~ msgid "Failed to expand the command '%1'."
#~ msgstr "Befehl \"%1\" lett sik nich utfüllen."

#~ msgid "Kate External Tools"
#~ msgstr "Extern Kate-Warktüüch"

#~ msgid "Edit External Tool"
#~ msgstr "Extern Warktüüch bewerken"

#~ msgid "&Label:"
#~ msgstr "&Beteker:"

#~ msgid "The name will be displayed in the 'Tools->External' menu"
#~ msgstr "De Naam warrt binnen dat Menü \"Warktüüch->Extern\" wiest"

#~ msgid "S&cript:"
#~ msgstr "S&kript:"

#~ msgid ""
#~ "<p>The script to execute to invoke the tool. The script is passed to /bin/"
#~ "sh for execution. The following macros will be expanded:</p><ul><li><code>"
#~ "%URL</code> - the URL of the current document.</li><li><code>%URLs</code> "
#~ "- a list of the URLs of all open documents.</li><li><code>%directory</"
#~ "code> - the URL of the directory containing the current document.</"
#~ "li><li><code>%filename</code> - the filename of the current document.</"
#~ "li><li><code>%line</code> - the current line of the text cursor in the "
#~ "current view.</li><li><code>%column</code> - the column of the text "
#~ "cursor in the current view.</li><li><code>%selection</code> - the "
#~ "selected text in the current view.</li><li><code>%text</code> - the text "
#~ "of the current document.</li></ul>"
#~ msgstr ""
#~ "<p>Dat Skript, mit dat Du dat Warktüüch opröppst. Dat warrt vun \"/bin/sh"
#~ "\" utföhrt. Du kannst dissen Platzhollers bruken:</p><ul><li><code>%URL</"
#~ "code> - dat aktuelle Dokment sien URL</li><li><code>%URLs</code> - en "
#~ "List mit de URLs vun all opstunns opmaakt Dokmenten</li><li><code>%"
#~ "directory</code> - de URL vun den Ornern vun't aktuelle Dokment</"
#~ "li><li><code>%filename</code> - de Dateinaam vun't aktuelle Dokment</"
#~ "li><li><code>%line</code> - den Blinker sien aktuelle Reeg binnen de "
#~ "aktuelle Ansicht</li><li><code>%column</code> - den Blinker sien Striep "
#~ "binnen de aktuelle Ansicht</li><li><code>%selection</code> - de utsöchte "
#~ "Text binnen de aktuelle Ansicht</li><li><code>%text</code> - de Text "
#~ "vun't aktuelle Dokment</li></ul>"

#~ msgid "&Executable:"
#~ msgstr "&Utföhrbor Datei:"

#~ msgid ""
#~ "The executable used by the command. This is used to check if a tool "
#~ "should be displayed; if not set, the first word of <em>command</em> will "
#~ "be used."
#~ msgstr ""
#~ "De utföhrbore Datei, de de Befehl bruukt. Leggt fast, wat en Warktüüch "
#~ "wiest warrt: wenn nich angeven, warrt dat eerste Woort vun <em>Befehl</"
#~ "em> bruukt."

#~ msgid "&Mime types:"
#~ msgstr "&MIME-Typen:"

#~ msgid ""
#~ "A semicolon-separated list of mime types for which this tool should be "
#~ "available; if this is left empty, the tool is always available. To choose "
#~ "from known mimetypes, press the button on the right."
#~ msgstr ""
#~ "En List vun MIME-Typen, trennt mit Streekpünkt, för de dat Warktüüch "
#~ "verföögbor wesen schall. Lettst Du dit leddig, is dat Warktüüch jümmers "
#~ "verfögbor. Klick op den Knoop rechts, wenn Du de Typen ut de List mit "
#~ "begäng MIME-Typen utsöken wullt."

#~ msgid "Click for a dialog that can help you creating a list of mimetypes."
#~ msgstr ""
#~ "Röppt en Dialoog op, mit den Du en List vun MIME-Typen opstellen kannst."

#~ msgid "&Save:"
#~ msgstr "&Sekern:"

#~ msgid "None"
#~ msgstr "Keen"

#~ msgid "Current Document"
#~ msgstr "Aktuell Dokment"

#~ msgid "All Documents"
#~ msgstr "All Dokmenten"

#~ msgid ""
#~ "You can elect to save the current or all [modified] documents prior to "
#~ "running the command. This is helpful if you want to pass URLs to an "
#~ "application like, for example, an FTP client."
#~ msgstr ""
#~ "Du kannst fastleggen, Du wullt dat aktuelle oder all (ännerte) Dokmenten "
#~ "sekern, ehr de Befehl utföhrt warrt. Dat is denn goot, wenn Du URLs na en "
#~ "Programm, a.B. en FTP-Programm, wiedergeven wullt."

#~ msgid "&Command line name:"
#~ msgstr "&Befehlsreegnaam:"

#~ msgid ""
#~ "If you specify a name here, you can invoke the command from the view "
#~ "command lines with exttool-the_name_you_specified_here. Please do not use "
#~ "spaces or tabs in the name."
#~ msgstr ""
#~ "Giffst Du hier en Naam in, kannst Du den Befehl vun de Ansicht-Konsool ut "
#~ "mit \"exttool-de_hier_angeven_Naam\" opropen. Bruuk binnen den Naam bitte "
#~ "keen Free- oder Tabtekens."

#~ msgid "You must specify at least a name and a command"
#~ msgstr "Du muttst tominnst en Naam un en Befehl ingeven"

#~ msgid "Select the MimeTypes for which to enable this tool."
#~ msgstr ""
#~ "De MIME-Typen utsöken, för de Du dat Warktüüch verföögbor maken wullt."

#~ msgid "Select Mime Types"
#~ msgstr "MIME-Typen utsöken"

