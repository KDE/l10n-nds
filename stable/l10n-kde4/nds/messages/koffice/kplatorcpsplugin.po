#: KPlatoRCPSPlugin.cpp:73
#, kde-format
msgid "Failed to build a valid RCPS project: %1"
msgstr "Fehler bi't Opstellen vun gellen RCPS-Projekt: %1"

#: KPlatoRCPSPlugin.cpp:80
msgctxt "@info"
msgid ""
"<b>This scheduler does not support all the requested scheduling "
"functionality.</b>"
msgstr "<b>Disse Planer ünnerstütt nich all nödig Funkschonen.</b>"

#: KPlatoRCPSScheduler.cpp:126
#, kde-format
msgid "Scheduling halted after %1 generations"
msgstr "Tietplaan na %1 Opstellen ophollen"

#: KPlatoRCPSScheduler.cpp:207
msgid "Init"
msgstr "Torechtmaken"

#: KPlatoRCPSScheduler.cpp:209
#, kde-format
msgid "Schedule project using RCPS Scheduler, starting at %1"
msgstr "Projekt mit RCPS-Planer opstellen. Start: %1"

#: KPlatoRCPSScheduler.cpp:210
#, kde-format
msgid "Schedule project from start time: %1"
msgstr "Projekt planen vun Starttiet: %1"

#: KPlatoRCPSScheduler.cpp:212
msgid "Schedule"
msgstr "Planen"

#: KPlatoRCPSScheduler.cpp:219
#, kde-format
msgid "Invalid scheduling solution. Result: %1"
msgstr "Leeg Plaanlösen. Resultaat: %1"

#: KPlatoRCPSScheduler.cpp:272
msgctxt "@item:inlistbox"
msgid "Scheduling backwards from target end time is not supported."
msgstr "Planen vun Opgaven vun de Enntiet af warrt nich ünnerstütt."

#: KPlatoRCPSScheduler.cpp:273
msgctxt "@item:inlistbox"
msgid "The project will be scheduled forward from target start time."
msgstr "Dat Projekt warrt vun de plaante Starttiet af vörut plaant."

#: KPlatoRCPSScheduler.cpp:277
msgctxt "@item:inlistbox"
msgid "Scheduling tasks with time constraints is not supported."
msgstr "Planen vun Opgaven mit Tietbedingen warrt nich ünnerstütt."

#: KPlatoRCPSScheduler.cpp:278 KPlatoRCPSScheduler.cpp:283
msgctxt "@item:inlistbox"
msgid "Tasks will be scheduled As Soon As Possible (ASAP)."
msgstr "Opgaven warrt \"As fröh as mööglich\" plaant."

#: KPlatoRCPSScheduler.cpp:282
msgctxt "@item:inlistbox"
msgid "Scheduling tasks As Late As Possible (ALAP) is not supported."
msgstr "Planen vun Opgaven \"As laat as mööglich\" warrt nich ünnerstütt."

#: KPlatoRCPSScheduler.cpp:303
#, kde-format
msgid "Task '%1' estimate: %2"
msgstr "Estemeren för Opgaav \"%1\": %2"

#: KPlatoRCPSScheduler.cpp:304
#, kde-format
msgid "Task '%1' duration called %2 times, cached values: %3"
msgstr "Duer för Opgaav \"%1\" %2-maal opropen, twischenspiekert Weerten: %3"

#: KPlatoRCPSScheduler.cpp:309
#, kde-format
msgid "Task '%1' start: %2, duration: %3 (%4, %5 hours)"
msgstr "Start vun Opgaav \"%1\": %2, Duer: %3 (%4, %5 Stünnen)"

#: KPlatoRCPSScheduler.cpp:315
#, kde-format
msgid "Task '%1' start=%2, duration=%3: %4 - %5"
msgstr "Start vun Opgaav \"%1\" = %2, Duer = %3: %4 - %5"

#: KPlatoRCPSScheduler.cpp:325
#, kde-format
msgid "Job %1: resource %2 is %3 available"
msgstr "Opgaav %1: Ressource %2 is för %3 verföögbor"

#: KPlatoRCPSScheduler.cpp:330
msgid "No resource request is registered"
msgstr "Keen Ressource-Anfraag anmeldt"

#: KPlatoRCPSScheduler.cpp:370
#, kde-format
msgid "Scheduled task to start at %1 and finish at %2"
msgstr "Plaant Opgavenstart: %1, Enn: %2"

#: KPlatoRCPSScheduler.cpp:404
#, kde-format
msgid "Project scheduled to start at %1 and finish at %2"
msgstr "Plaant Projektstart: %1, Enn: %2"

#: KPlatoRCPSScheduler.cpp:411
#, kde-format
msgid "Project scheduling finished at %1"
msgstr "Projektplaan afslaten: %1"

#: KPlatoRCPSScheduler.cpp:420
msgctxt "Project Evaluation and Review Technique"
msgid "PERT"
msgstr "PERT"
