#: rc.cpp:9
msgid "Low"
msgstr "Siet"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 62
#: rc.cpp:12
msgid "Medium"
msgstr "Middel"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 67
#: rc.cpp:15
msgid "High"
msgstr "Hooch"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 72
#: rc.cpp:18
msgid "Custom"
msgstr "Egen"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 80
#: rc.cpp:21
msgid "Financial Information"
msgstr "Finanz-Informatschoon"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 89
#: rc.cpp:24
msgid ""
"Warn me when I visit a site that uses my financial or purchase information:"
msgstr ""
"Wohrschoen, wenn ik en Nettsiet besöök, de mien Finanz- oder "
"Kööpinformatschonen bruken will för't..."

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 99
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 135
#: rc.cpp:27 rc.cpp:39
msgid "For marketing or advertising purposes"
msgstr "Vermarkten oder Warven"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 106
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 142
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 178
#: rc.cpp:30 rc.cpp:42 rc.cpp:54
msgid "To share with other companies"
msgstr "Delen mit anner Bedrieven"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 116
#: rc.cpp:33
msgid "Health Information"
msgstr "Sundheit-Informatschonen"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 125
#: rc.cpp:36
msgid ""
"Warn me when I visit a site that uses my health or medical information: "
msgstr ""
"Wohrschoen, wenn ik en Siet besöök, de mien Sundheit- oder medizinsche "
"Informatschonen bruken will för't... "

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 152
#: rc.cpp:45
msgid "Demographics"
msgstr "Demografie"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 161
#: rc.cpp:48
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr ""
"Wohrschoen, wenn ik en Siet besöök, de nich persöönlich totoornen "
"Informatschonen bruken will för't..."

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 171
#: rc.cpp:51
msgid "To determine my interests, habits or general behavior"
msgstr "Faststellen vun Intressen, Wennsten oder allgemeen Verhollen"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 188
#: rc.cpp:57
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr ""
"Wohrschoen, wenn ik en Siet besöök, de mien persöönliche Informatschonen mit "
"annere Bedrieven deelt"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 195
#: rc.cpp:60
msgid ""
"Warn me when I visit a site that does not let me know what information they "
"have about me"
msgstr ""
"Wohrschoen, wenn ik en Siet besöök, vun de de Eegner mi nich weten laten "
"will, wat he över mi weet"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 202
#: rc.cpp:63
msgid "Personal Information"
msgstr "Persöönliche Informatschonen"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 211
#: rc.cpp:66
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"Wohrschoen, wenn ik en Siet besöök, de mi villicht üm anner Produkten "
"kontakteert:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 221
#: rc.cpp:69
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr ""
"Wohrschoen, wenn ik en Siet besöök, de mien persöönliche Informatschonen "
"villicht bruukt för't..."

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 231
#: rc.cpp:72
msgid "Determine my habits, interests or general behavior"
msgstr "Faststellen vun mien Intressen, Wennsten oder allgemeen Verhollen"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 243
#: rc.cpp:75
msgid "Via telephone"
msgstr "Över Telefoon"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 250
#: rc.cpp:78
msgid "Via mail"
msgstr "Över Post"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 264
#: rc.cpp:81
msgid "Via email"
msgstr "Över Nettpost"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 271
#: rc.cpp:84
msgid "And do not allow me to remove my contact information"
msgstr "un dat Wegdoon vun mien Daten nich verlöövt"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 27
#: rc.cpp:87
msgid ""
"Check all cleanup actions you would like to perform. These will be executed "
"by pressing the button below"
msgstr ""
"Aktiveer all Oprüüm-Akschonen, de Du utföhren wullt. Se warrt utföhrt, wenn "
"Du op den Knoop nerrn klickst."

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 42
#: rc.cpp:93
msgid "Description"
msgstr "Beschrieven"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 58
#: rc.cpp:96
msgid "Select &All"
msgstr "&All utsöken"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 65
#: rc.cpp:99
msgid "Select &None"
msgstr "&Nix utsöken"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 88
#: rc.cpp:102
msgid "Immediately performs the cleanup actions selected above"
msgstr "Baven utsöcht Akschonen warrt fuurts utföhrt"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 91
#: rc.cpp:105
msgid "&Clean Up"
msgstr "&Oprümen"

#: rc.cpp:106
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Sönke Dibbern"

#: rc.cpp:107
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "s_dibbern@web.de"

#: sweeper.cpp:48
msgctxt "General system content"
msgid "General"
msgstr "Allgemeen"

#: sweeper.cpp:50
msgctxt "Web browsing content"
msgid "Web Browsing"
msgstr "Nettkieken"

#: sweeper.cpp:136
msgid ""
"You are deleting data that is potentially valuable to you. Are you sure?"
msgstr ""
"Du wullt Daten wegdoon, de villicht doch noch bruukst. Wullt Du redig "
"wiedermaken?"

#: sweeper.cpp:141
msgid "Starting cleanup..."
msgstr "Oprümen fangt an..."

#: sweeper.cpp:147
#, kde-format
msgid "Clearing %1..."
msgstr "%1 warrt wegdaan..."

#: sweeper.cpp:152
#, kde-format
msgid "Clearing of %1 failed: %2"
msgstr "Dat Wegdoon vun \"%1\" is fehlslaan: %2"

#: sweeper.cpp:158
msgid "Clean up finished."
msgstr "Oprümen is beendt."

#: privacyfunctions.h:38
msgid "Cookies"
msgstr "Kookjes"

#: privacyfunctions.h:39
msgid "Clears all stored cookies set by websites"
msgstr "Deit all vun Nettsieden sekerte Kookjes weg"

#: privacyfunctions.h:49
msgid "Cookie Policies"
msgstr "Kookje-Regeln"

#: privacyfunctions.h:50
msgid "Clears the cookie policies for all visited websites"
msgstr "Sett de Kookje-Regeln för all besöcht Nettsieden torüch"

#: privacyfunctions.h:59
msgid "Saved Clipboard Contents"
msgstr "Sekerte Twischenaflaag-Inholden"

#: privacyfunctions.h:60
msgid "Clears the clipboard contents stored by Klipper"
msgstr "Deit de Twischenaflaag-Inholden vun Klipper weg"

#: privacyfunctions.h:70
msgid "Clears all cached thumbnails"
msgstr "Deit all wohrte Vöransichten weg"

#: privacyfunctions.h:79
msgid "Run Command History"
msgstr "\"Befehl utföhren\"-Vörgeschicht"

#: privacyfunctions.h:80
msgid ""
"Clears the history of commands run through the Run Command tool on the "
"desktop"
msgstr ""
"Maakt de Vörgeschicht vun den \"Befehl utföhren\"-Schriefdischdialoog leddig"

#: privacyfunctions.h:89
msgid "Form Completion Entries"
msgstr "Kompletteer-Indrääg för Formuloren"

#: privacyfunctions.h:90
msgid "Clears values which were entered into forms on websites"
msgstr "Deit de  Weerten weg, de Du in Formuloren op Nettsieden ingeven hest"

#: privacyfunctions.h:99
msgid "Web History"
msgstr "Nett-Vörgeschicht"

#: privacyfunctions.h:100
msgid "Clears the history of visited websites"
msgstr "Maakt de Vörgeschicht vun besöcht Nettsieden leddig"

#: privacyfunctions.h:109
msgid "Web Cache"
msgstr "Nett-Twischenspieker"

#: privacyfunctions.h:110
msgid "Clears the temporary cache of websites visited"
msgstr "Maakt den Twischenspieker mit besöcht Nettsieden leddig"

#: privacyfunctions.h:119
msgid "Recent Documents"
msgstr "Tolest bruukte Dokmenten"

#: privacyfunctions.h:120
msgid ""
"Clears the list of recently used documents from the KDE applications menu"
msgstr ""
"Maakt de List vun tolest bruukt Dokmenten in't KDE-Programmmenü (K-Menü) "
"leddig"

#: privacyfunctions.h:129
msgid "Favorite Icons"
msgstr "Sieden-Lüttbiller"

#: privacyfunctions.h:130
msgid "Clears the FavIcons cached from visited websites"
msgstr "Deit all Sieden-Lüttbiller vun besöcht Nettsieden weg"

#~ msgid "Quick Start Menu"
#~ msgstr "Fixstart-Menü"

#~ msgid "Clears the entries from the list of recently started applications"
#~ msgstr "Maakt de List mit Programmen leddig, de Du tolest start hest"
