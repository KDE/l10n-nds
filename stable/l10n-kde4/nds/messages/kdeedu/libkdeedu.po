msgstr "Nöömt na den Wetenschopler Alfred Nobel."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 208
#: rc.cpp:662
msgid "Named after the scientist Ernest Orlando Lawrence."
msgstr "Nöömt na den Wetenschopler Ernest Orlando Lawrence."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 210
#: rc.cpp:665
