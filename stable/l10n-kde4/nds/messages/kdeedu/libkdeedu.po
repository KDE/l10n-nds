#. i18n: tag scalar
#. i18n: file element_tiny.xml line 108
#: rc.cpp:512
msgid "Greek 'ioeides' for 'violett'"
msgstr "Greeksch 'ioeides' bedüüdt'vigelett'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 110
#: rc.cpp:515
msgid "Greek 'xenos' for 'foreigner'"
msgstr "Greeksch 'xenos' bedüüdt 'frömd'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 112
#: rc.cpp:518
msgid "Latin 'caesius' for 'heavenblue'"
msgstr "Latiensch 'caesius' bedüüdt 'hevenblaag'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 114
#: rc.cpp:521
msgid "Greek 'barys' for 'heavy'"
msgstr "Greeksch 'barys' bedüüdt 'swoor'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 116
#: rc.cpp:524
msgid ""
"Greek 'lanthanein' for 'hidden'. The Lanthanoids are also called the 'rare "
"earth'"
msgstr ""
"Greeksch 'lanthanein' för 'versteekt'. De Lanthanoiden warrt ok 'Rore "
"Eerden' nöömt"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 118
#: rc.cpp:527
msgid "Named after the planetoid Ceres"
msgstr "Nöömt na den Dwargplanet 'Ceres'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 120
#: rc.cpp:530
msgid "Greek 'prasinos didymos' for 'green twin'"
msgstr "Greeksch 'prasinos didymos' bedüüdt 'Gröön Tweeschen'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 122
#: rc.cpp:533
msgid "Greek 'neos didymos' for 'new twin'"
msgstr "Greeksch 'neos didymos' för den 'niegen Tweeschen'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 124
#: rc.cpp:536
msgid ""
"Named after the greek Prometheus. Prometheus stole the fire from the gods "
"and gave it to mankind"
msgstr ""
"Na den greekschen Prometheus nöömt. Prometheus hett dat Füer vun de Gödder "
"stahlen un dat de Minschen geven"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 126
#: rc.cpp:539
msgid "Named after the mineral Samarskit"
msgstr "Na dat Mineral Samarskit nöömt"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 128
#: rc.cpp:542
msgid "Named after Europe"
msgstr "Na Europa nöömt"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 130
#: rc.cpp:545
msgid "Named after the Finnish chemist Johan Gadolin"
msgstr "Na den finnschen Chemiker Johan Gadolin nöömt"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 132
#: rc.cpp:548
msgid "Named after the Swedish town of Ytterby"
msgstr "Na de Sweedsche Stadt Ytterby nöömt"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 134
#: rc.cpp:551
msgid "Greek 'dysprositor' for 'difficult to reach'"
msgstr "Greeksch 'dysprositor' bedüüdt 'lett sik nich faatkriegen'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 136
#: rc.cpp:554
msgid "Latin 'holmia' for the old name of Stockholm"
msgstr "Latin 'holmia', de ole Naam vun Stockholm"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 138
#: rc.cpp:557
msgid ""
"Named ofter the Swedish town of Ytterby. Terbium and Ytterbium are also "
"named after this town."
msgstr ""
"Na de sweedsche Stadt Ytterby nöömt. Ok 'Terbium un Ytterbium sünd na disse "
"Stadt nöömt."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 140
#: rc.cpp:560
msgid "Named after the old name of Scandinavia. 'Thule'"
msgstr "Na den olen Naam vun Skandinavien nöömt: 'Thule'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 142
#: rc.cpp:563
msgid ""
"Like Terbium and Gadolinium. this is named after the Swedish town of Ytterby"
msgstr ""
"So as ok Terbium un Gadolinium is ok dit Element na de sweedsche Stadt "
"Ytterby nöömt"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 144
#: rc.cpp:566
msgid "Named after the Roman name 'Lutetia' for Paris"
msgstr "Nöömt na den röömschen Naam för Paris: 'Lutetia'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 146
#: rc.cpp:569
msgid "'Hafnia' is the old name of Kopenhagen (Denmark)"
msgstr "Nöömt na den latienschen Naam vun Kopenhagen, <i>Hafnia</i>"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 148
#: rc.cpp:572
msgid "Named after the Greek myth of Tantalos"
msgstr "Nöömt na de greeksche <i>Tantalos</i>-Saag."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 150
#: rc.cpp:575
msgid ""
"'tung sten' means 'heavy stone' in Swedish. The old name (and thus the "
"symbol 'W') was Wolfram. named after a mineral"
msgstr ""
"Bi't Tinnkaken in Sachsen verschannel en Mineraal de Tinnsmölt, dat se "
"hoochdüütsch <i>Wolfra(h)m</i> nöömt hebbt. <i>Ra(h)m</i> bedüüd do "
"\"Schiet, Smeer\" un nich \"Rahm, Flott\". De engelsche un franzöösche Naam "
"<i>Tungsten<i> is vun sweedsch <i>tung sten</i> (\"swoor Steen\") afleddt, "
"wat de sweedsche Naam för Scheelit (Kalziumwulframaat) weer."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 152
#: rc.cpp:578
msgid "Named after the German river Rhine (latin 'Rhenium')"
msgstr "Nöömt na den düütschen Stroom Rhien (latiensch 'Rhenus')"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 154
#: rc.cpp:581
msgid "Greek for 'smell'. Its oxides smell strongly like radishes"
msgstr "Greeksch för 'Röök'. Dat rüükt bannig na Rettich"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 156
#: rc.cpp:584
msgid "Greek 'iris' for 'rainbow'"
msgstr "Greeksch 'iris' is de Regenbagen"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 158
#: rc.cpp:587
msgid "Spanish 'platina' means 'small silver'"
msgstr "Spaansch 'platina' bedüüdt 'lütt Sülver'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 160
#: rc.cpp:590
msgid "Latin 'aurum'. named after Aurora. the goddess of sunrise"
msgstr "Latiensch 'aurum' bedüüdt 'Gold'."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 162
#: rc.cpp:593
msgid "Graeco-Latin 'hydrargyrum' for 'liquid silver'"
msgstr "Greeksch-latiesch 'hydrargyrum' bedüüdt 'fleten Sülver'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 164
#: rc.cpp:596
msgid "Greek 'tallos' for 'young twig'"
msgstr "Greeksch 'tallos' bedüüdt 'jung (gröön)' Twieg."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 166
#: rc.cpp:599
msgid "Latin 'plumbum' for Lead"
msgstr "Latiensch 'plumbum' bedüüdt Blee"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 168
#: rc.cpp:602
msgid "The old name of Bismuth is 'Wismut'. This stood for 'white mass'"
msgstr ""
"Dat Woort geiht wull torüch op de eerste Fundsteed, de Wischen (hd. <i> Wi(e)"
"se</i>) an den Sneebarg in de Ertbargen. De tweet Woortdeel mhd. <i> muten</"
"i>, <i>die Mutung</i> höört to \"Moot\" un bedüüd in't Middelöller so veel "
"as \"üm Verlööf för den Afbuu fragen\". Dat Symbool <i>Bi</i> is vun de "
"latienschmaakte Form <i>bismutum</i> afleddt."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 170
#: rc.cpp:605
msgid "Named after Poland to honor Marie Curie"
msgstr "Nöömt na Polen, to de Ehr vun Marie Curie"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 172
#: rc.cpp:608
msgid "Greek 'astator' for 'changing'"
msgstr "Greeksch 'astator' bedüüdt 'wesselt sik'"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 174
#: rc.cpp:611
msgid ""
"Named after Radium. It ends with 'on' to make it clear that it is a noble gas"
msgstr ""
"Nöömt na Radium. Dat ennt op 'on', üm to wiesen, dat dat en Eddelgas is."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 176
#: rc.cpp:614
msgid "Named after France to honor Marguerite Perey"
msgstr "Nöömt na Frankriek to de Ehr vun Marguerite Perey"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 178
#: rc.cpp:617
msgid "Latin 'radius' for 'beam', as it is radioactive"
msgstr "Latienst 'radius' bedüüdt 'Strahl', dat is radioaktiv."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 180
#: rc.cpp:620
msgid "Greek 'aktis' for 'beam' - actinium is radioactive"
msgstr "Greeksch 'aktis' bedüüdt 'Strahl' - Aktinium is radioaktiv"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 182
#: rc.cpp:623
