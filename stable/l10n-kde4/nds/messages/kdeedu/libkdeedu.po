msgstr ""
"Nöömt na de düütsche Stadt Darmstad, wonehm se vele Elementen opdeckt hebbt."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 224
#: rc.cpp:686
msgid "Named after Wilhelm Conrad Röntgen."
msgstr "Nöömt na Wilhelm Conrad Röntgen."
