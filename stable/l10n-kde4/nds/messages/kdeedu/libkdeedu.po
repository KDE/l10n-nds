msgstr ""
"Greeksch 'protos' för 'Vörfohr'. Protaktinium steiht in dat Periodensysteem "
"vör Aktinium."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 186
#: rc.cpp:629
msgid "Greek 'ouranos' for 'heaven'. Named after the planet Uranus"
msgstr "Greeksch 'ouranos' bedüüdt 'Heben'. Nöömt na den Planet Uranus."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 188
#: rc.cpp:632
msgid "Named after the planet Neptune."
msgstr "Nöömt na den Planet Neptun."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 190
#: rc.cpp:635
msgid "Named after the planet Pluto."
msgstr "Nöömt na den Planet Pluto."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 192
#: rc.cpp:638
msgid "Named after America."
msgstr "Nöömt na Amerika."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 194
#: rc.cpp:641
msgid "Named after Marie Curie."
msgstr "Nöömt na Marie Curie."

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 196
#: rc.cpp:644
