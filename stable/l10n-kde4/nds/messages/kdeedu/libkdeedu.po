msgstr "Greeksch 'rhodeos' bedüüdt 'root as en Roos'"

#. i18n: file: element_tiny.xml:94
#: rc.cpp:451
msgid "Named after the asteroid Pallas"
msgstr "Na den Lüttplanet Pallas nöömt"

#. i18n: file: element_tiny.xml:96
#: rc.cpp:453
msgid "Latin 'argentum' for silver"
msgstr "Latiensch 'argentum' bedüüdt Sülver"

#. i18n: file: element_tiny.xml:98
#: rc.cpp:455
