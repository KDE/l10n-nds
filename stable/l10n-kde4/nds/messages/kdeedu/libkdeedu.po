msgstr "Na den Lüttplanet Pallas nöömt"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 96
#: rc.cpp:494
msgid "Latin 'argentum' for silver"
msgstr "Latiensch 'argentum' bedüüdt Sülver"

#. i18n: tag scalar
#. i18n: file element_tiny.xml line 98
#: rc.cpp:497
