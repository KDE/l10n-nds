#: src/lib/marble/MarbleAboutDialog.cpp:225
msgid ""
"<p><i>Shuttle Radar Topography Mission (SRTM30, 1 km / pixel )</i><br />NASA "
"Jet Propulsion Laboratory <a href=\"http://www2.jpl.nasa.gov/srtm/\">http://"
"www2.jpl.nasa.gov/srtm/</a></p>"
