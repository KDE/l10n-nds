#: kwlanapplication.cpp:108
#, kde-format
msgid ""
"You (%1) do not have permissions to start pppd or pppd was not found. Dialup "
"networking will not work."
msgstr ""
"Du (%1) muttst \"pppd\" nich opropen, oder dat lett sik nich finnen. Dat "
"Inwähl-Nettwark funkscheneert nich."

#: kwlanapplication.cpp:125
msgid "/etc/ppp/peers does not exist. Dialup networking will not work."
msgstr ""
"Dat gifft \"/etc/ppp/peers\" nich. Dat Inwähl-Nettwark funkscheneert nich."

#: kwlaninterface.cpp:97
msgid ""
"Could not find wpa_supplicant binary. Without it Kwlan can't connect to "
"encrypted networks.\n"
"Please check your wpa_supplicant installation."
msgstr ""
"Dat Programm \"wpa_supplicant\" lett sik nich finnen. Ahn dit Programm kann "
"sik Kwlan keen verslötelt Nettwarken tokoppeln.\n"
"Prööv bitte Dien Installatschoon vun \"wpa_supplicant\"."

#: kwlaninterface.cpp:110
msgid ""
"Neither dhclient nor dhcpcd found. Dynamic IP configuration will not work."
msgstr ""
"All beed, \"dhclient\" un \"dhcpcd\", laat sik nich finnen. De IP-Adress "
"lett sik nich dünaamsch instellen. "

#: kwlaninterface.cpp:114
msgid ""
"ifconfig not found. Network statistics and static ip addresses will not work."
msgstr ""
"\"ifconfig\" lett sik nich finnen. De Nettwark-Statistik un faste IP-"
"Adressen funkscheneert nich."

#: kwlaninterface.cpp:117
msgid "iwconfig not found. Wireless statistics might not work."
msgstr ""
"\"iwconfig\" lett sik nich finnen. De Funknettwark-Statistik funkscheneert "
"wull nich."

