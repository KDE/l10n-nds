#: dbushandler.cpp:96
msgid ""
"The Web share for magnet-links is disabled. You can set it up at settings:/"
"network-and-connectivity/sharing"
msgstr ""
"De Nettfreegaav för Magnetlinks is utmaakt. Du kannst se ünner „settings:/"
"network-and-connectivity/sharing“ inrichten."

#: dbushandler.cpp:120
msgid ""
"Cannot start process for KTorrent.                           This should not "
"happen, even if KTorrent is not installed.                           Check "
"your machines resources and limits."
msgstr ""
"Perzess för KTorrent lett sik nich starten. Dit schull nich vörkamen, ok "
"wenn KTorrent nich installeert is. Prööv de Reeknerleisten un "
"Systeemvörutsetten."

#: dbushandler.cpp:158
#, kde-format
msgid ""
"Could not connect to KTorrent via DBus                                     "
"after %1 seconds. Is it broken?"
msgstr ""
"KTorrent na %1 Sekunnen nich över DBus tokoppelt. Is dor wat schaadhaftig?"

#: dbushandler.cpp:180
msgid ""
"Could not get the group list, do you have a compatible KTorrent version "
"running?"
msgstr ""
"De Koppellist lett sik nich halen. Löppt en kompatibel Verschoon vun "
"KTorrent?"

#: dbushandler.cpp:333
#, kde-format
msgid "The link for %1 does not contain the required btih hash-parameter."
msgstr "De Link för \"%1\" bargt nich den nödige BTIH-Pröövsummkenngrött."

#: dbushandler.cpp:345
#, kde-format
msgid "The found value (%1) for the hash is neither 32 nor 40 chars long."
msgstr ""
"De funnen Weert (%1) för de Pröövsumm is nich 32 un ok nich 40 Tekens lang."

#: dbushandler.cpp:624
msgid "Torrent has been removed from KTorrent."
msgstr "De Torrent wöör ut KTorrent wegmaakt."

#: kio_magnet.cpp:294 kio_magnet.cpp:395
#, kde-format
msgid ""
"File exists in KTorrent, but cannot open it on disk at path\"%1\". Have you "
"removed the file manually?"
msgstr ""
"Dat gifft de Datei binnen KTorrent, man lett sik över den Padd „%1“ op de "
"Fastplaat nich opmaken. Hest Du ehr villicht vun Hand wegmaakt?"

#: kio_magnet.cpp:375
msgid "You cannot write to magnet resources."
msgstr "Na Magnet-Ressource lett sik nich schrieven."

#: kio_magnet.cpp:403
#, kde-format
msgid "File \"%1\" is a directory. This should not happen. Please file a bug."
msgstr ""
"Datei \"%1\" is en Orner. Dit schull nich vörkamen. Stüer bitte en "
"Fehlerbericht loos."

#: kio_magnet.cpp:429
#, kde-format
msgid ""
"File exists in KTorrent, but cannot open it on disk at path \"%1\". Have you "
"removed the file manually?"
msgstr ""
"Dat gifft de Datei twaars binnen KTorrent, man över den Padd \"%1\" op de "
"Fastplaat lett se sik nich opmaken. Hest Du de Datei villicht vun Hand "
"wegmaakt?"

#. i18n: ectx: label, entry (Enabled), group (Magnet)
#: magnetsettings.kcfg:10
msgid "Enable the global magnet-link support."
msgstr "Globaal Ünnerstütten för Magnetlinks anmaken"

#. i18n: ectx: label, entry (ShareSize), group (Magnet)
#: magnetsettings.kcfg:14
msgid "Total maximum size used by the share in MiB."
msgstr "Bruukt Hööchstgrött för all Freegaven tohoop (in MiB)"

#. i18n: ectx: label, entry (TrustedHosts), group (Magnet)
#: magnetsettings.kcfg:18
msgid "List of hosts which are directly accepted on loading"
msgstr "List vun Reekners, de bi't Laden direktemang tolaten warrt"

#. i18n: ectx: label, entry (ManagedTorrents), group (Magnet)
#: magnetsettings.kcfg:21
msgid "Torrents inside KTorrent which are managed by these modules."
msgstr "Torrents binnen KTorrent de vun disse Modulen pleegt warrt."

#. i18n: ectx: label, entry (RunningTorrents), group (Magnet)
#: magnetsettings.kcfg:24
msgid "Torrents currently used by the I/O-Slaves."
msgstr "Jüst nu vun de In-/Utgaavmodulen bruukte Torrents"

#. i18n: ectx: label, entry (MaxShareRatio), group (Magnet)
#: magnetsettings.kcfg:27
msgid "The maximum share ratio which should be targeted for each torrent."
msgstr "De hööchste Verdeelrelatschoon för elk Torrent"

