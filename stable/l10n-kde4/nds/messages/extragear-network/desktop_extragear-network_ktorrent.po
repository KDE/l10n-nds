#: ktorrent/ktorrent.desktop:2
msgctxt "Name"
msgid "KTorrent"
msgstr "KTorrent"

#: ktorrent/ktorrent.desktop:4
msgctxt "GenericName"
msgid "BitTorrent Client"
msgstr "BitTorrent-Client"

#: ktorrent/ktorrent.desktop:32
msgctxt "Comment"
msgid "A BitTorrent program for KDE"
msgstr "En BitTorrent-Programm för KDE"

#: ktorrent/ktorrent.notifyrc:3
msgctxt "Comment"
msgid "KTorrent"
msgstr "KTorrent"

#: ktorrent/ktorrent.notifyrc:7
msgctxt "Name"
msgid "Torrent stopped by error"
msgstr "Torrent na Fehler anhollen"

#: ktorrent/ktorrent.notifyrc:32
msgctxt "Name"
msgid "Torrent has finished downloading"
msgstr "Torrent hett Daalladen afslaten"

#: ktorrent/ktorrent.notifyrc:57
msgctxt "Name"
msgid "Maximum share ratio reached"
msgstr "Bi hööchst Deelrelatschoon anlangt"

#: ktorrent/ktorrent.notifyrc:82
msgctxt "Name"
msgid "Maximum seed time reached"
msgstr "Bi hööchst Verdeeltiet anlangt"

#: ktorrent/ktorrent.notifyrc:107
msgctxt "Name"
msgid "Disk space is running low"
msgstr "Fastplaaatruum geiht to Enn"

#: ktorrent/ktorrent.notifyrc:132
msgctxt "Name"
msgid "Corrupted data has been found"
msgstr "Schaadhaftig Daten funnen"

#: ktorrent/ktorrent.notifyrc:157
msgctxt "Name"
msgid "Torrent cannot be enqueued"
msgstr "Torrent lett sik nich inregen"

#: ktorrent/ktorrent.notifyrc:182
msgctxt "Name"
msgid "Torrent cannot be started"
msgstr "Torrent lett sik nich starten"

#: ktorrent/ktorrent.notifyrc:207
msgctxt "Name"
msgid "Torrent cannot be loaded silently"
msgstr "Torrent lett sik nich still laden"

#: ktorrent/ktorrentplugin.desktop:4
msgctxt "Name"
msgid "KTorrent Plugin"
msgstr "KTorrent-Moduul"

#: plugins/bitfinder/ktbitfinderplugin.desktop:2
msgctxt "Name"
msgid "BitFinderPlugin"
msgstr "BitFinder-Moduul"

#: plugins/bitfinder/ktbitfinderplugin.desktop:18
msgctxt "Comment"
msgid "Plugin to automatically downloads torrents from various sources"
msgstr "Moduul, dat automaatsch Torrents vun verscheden Borns daallaadt"

#: plugins/bwscheduler/ktbwschedulerplugin.desktop:2
msgctxt "Name"
msgid "BandwidthSchedulerPlugin"
msgstr "Bandbreedplaan-Moduul"

#: plugins/bwscheduler/ktbwschedulerplugin.desktop:18
msgctxt "Comment"
msgid "Plugin to schedule upload and download limits over a period of a week"
msgstr ""
"Moduul, mit dat sik Grenzen för't Hooch- un Daalladen över en Week planen "
"laat"

#: plugins/infowidget/ktinfowidgetplugin.desktop:2
msgctxt "Name"
msgid "InfoWidgetPlugin"
msgstr "Info-Moduul"

#: plugins/infowidget/ktinfowidgetplugin.desktop:19
msgctxt "Comment"
msgid ""
"Plugin which displays general information about a torrent in several tabs"
msgstr "Moduul, dat Informatschonen över en Torrent op en Reeg Paneels wiest"

#: plugins/ipfilter/ktipfilterplugin.desktop:2
msgctxt "Name"
msgid "IPFilterPlugin"
msgstr "IPFilter-Moduul"

#: plugins/ipfilter/ktipfilterplugin.desktop:19
msgctxt "Comment"
msgid "IP filter plugin for KTorrent"
msgstr "IPFilter-Moduul för KTorrent"

#: plugins/logviewer/ktlogviewerplugin.desktop:2
msgctxt "Name"
msgid "LogViewerPlugin"
msgstr "Logbookkieker-Moduul"

#: plugins/logviewer/ktlogviewerplugin.desktop:19
msgctxt "Comment"
msgid "Plugin which displays the logging output generated by KTorrent"
msgstr "Moduul, dat de Logbookutgaav vun KTorrent wiest"

#: plugins/mediaplayer/ktmediaplayerplugin.desktop:2
msgctxt "Name"
msgid "MediaPlayerPlugin"
msgstr "Afspeler-Moduul"

#: plugins/mediaplayer/ktmediaplayerplugin.desktop:18
msgctxt "Comment"
msgid "Phonon based media player plugin for KTorrent"
msgstr "Op Phonon opbuut Afspeler-Moduul för KTorrent"

#: plugins/scanfolder/ktscanfolderplugin.desktop:2
msgctxt "Name"
msgid "ScanFolderPlugin"
msgstr "Orner-Moduul"

#: plugins/scanfolder/ktscanfolderplugin.desktop:18
msgctxt "Comment"
msgid ""
"Plugin to scan directories for torrent files, when files are found, they are "
"loaded"
msgstr "Moduul, dat Ornern op Torrent-Dateien dörkiekt, de denn laadt warrt"

#: plugins/search/ktsearchplugin.desktop:2
msgctxt "Name"
msgid "SearchPlugin"
msgstr "Söök-Moduul"

#: plugins/search/ktsearchplugin.desktop:19
msgctxt "Comment"
msgid "Search plugin for KTorrent"
msgstr "Söök-Moduul för KTorrent"

#: plugins/stats/ktstatsplugin.desktop:3
msgctxt "Name"
msgid "StatsPlugin"
msgstr "Statistik-Moduul"

#: plugins/stats/ktstatsplugin.desktop:20
msgctxt "Comment"
msgid "Plugin which shows statistics about torrents in several graphs"
msgstr "Moduul, dat Statistiken över Torrents op en Reeg Paneels wiest"

#: plugins/upnp/ktupnpplugin.desktop:2
msgctxt "Name"
msgid "UPnPPlugin"
msgstr "UPnP-Moduul"

#: plugins/upnp/ktupnpplugin.desktop:19
msgctxt "Comment"
msgid "Plugin to forward ports using UPnP"
msgstr "Moduul, dat Porten över UPnP wiederleddt"

#: plugins/webinterface/ktwebinterfaceplugin.desktop:2
msgctxt "Name"
msgid "WebInterface"
msgstr "Nettkoppelsteed"

#: plugins/webinterface/ktwebinterfaceplugin.desktop:18
msgctxt "Comment"
msgid "Plugin to control KTorrent via a webinterface"
msgstr "Moduul, mit dat KTorrent sik över en Nettkieker stüern lett"

#: plugins/zeroconf/ktzeroconfplugin.desktop:2
msgctxt "Name"
msgid "ZeroConfPlugin"
msgstr "ZeroConf-Moduul"

#: plugins/zeroconf/ktzeroconfplugin.desktop:18
msgctxt "Comment"
msgid ""
"Plugin to discover peers on the local network using the zeroconf protocol"
msgstr ""
"Moduul, dat Partners in't lokale Nett över't zeroconf-Protokoll opdeckt"
