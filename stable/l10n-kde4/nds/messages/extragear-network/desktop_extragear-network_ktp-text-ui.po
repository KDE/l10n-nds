#: config/kcm_ktp_chat_appearance.desktop:14
msgctxt "Name"
msgid "Chat Window Appearance"
msgstr "Klöönfinster-Utsehn"

#: config/kcm_ktp_chat_appearance.desktop:56
msgctxt "Comment"
msgid "Choose a Style for your Chat Window and customize it"
msgstr "Söök en Stil för Dien Klöönfinster ut un pass em to"

#: config/kcm_ktp_chat_behavior.desktop:14
msgctxt "Name"
msgid "Chat Tab Behavior"
msgstr "Klöönpaneel-Bedregen"

#: config/kcm_ktp_chat_messages.desktop:2
msgctxt "Name"
msgid "Plugins"
msgstr "Modulen"

#: config/kcm_ktp_chat_messages.desktop:48
msgctxt "Comment"
msgid "How to deal with extra information obtained from messages"
msgstr "Fastleggen, wat Du mit Bito-Informatschonen ut Narichten doon wullt"

#: filters/bugzilla/ktptextui_message_filter_bugzilla.desktop.cmake:3
msgctxt "Name"
msgid "Bugzilla Information"
msgstr "Bugzilla-Informatschonen"

#: filters/bugzilla/ktptextui_message_filter_bugzilla.desktop.cmake:41
msgctxt "Comment"
msgid ""
"When receiving a link to a bug on bugzilla show additional information such "
"as the title and status"
msgstr ""
"Informatschonen as Titel un Status wiesen, wenn en Link op en Fehler binnen "
"Bugzilla ankummt"

#: filters/emoticons/ktptextui_message_filter_emoticons.desktop.cmake:2
msgctxt "Name"
msgid "Emoticons"
msgstr "Snuten"

#: filters/emoticons/ktptextui_message_filter_emoticons.desktop.cmake:47
msgctxt "Comment"
msgid "Show emoticons (smiley faces) inside the chat"
msgstr "Snuten (Smiley-Lüttbiller) binnen den Klöönsnack wiesen"

#: filters/formatting/ktptextui_message_filter_formatting.desktop.cmake:3
msgctxt "Name"
msgid "Text Formatting"
msgstr "Textformateren"

#: filters/formatting/ktptextui_message_filter_formatting.desktop.cmake:41
msgctxt "Comment"
msgid ""
"Use /, _, * and - to make text italic, underlined, bold or strikeout "
"respectively"
msgstr ""
"»/«, »_«, »*« un »-« bruken un Text dor mit kursiev, ünnerstreken, fett oder "
"dörstreken wiesen"

#: filters/highlight/ktptextui_message_filter_highlight.desktop.cmake:17
msgctxt "Name"
msgid "Highlight"
msgstr "Rutheven"

#: filters/highlight/ktptextui_message_filter_highlight.desktop.cmake:61
msgctxt "Comment"
msgid ""
"If any incoming messages contain your nickname, it will highlight them in red"
msgstr "Bargt en rinkamen Naricht Dien Ökelnaam, warrt he in root rutheevt"

#: filters/images/ktptextui_message_filter_images.desktop.cmake:2
msgctxt "Name"
msgid "Image Preview"
msgstr "Bild-Vöransicht"

#: filters/images/ktptextui_message_filter_images.desktop.cmake:44
msgctxt "Comment"
msgid "Embed a thumbnail of any image URL sent in a chat"
msgstr ""
"En Vöransicht för elkeen binnen en Klöönsnack loosstüert Bild-URL inbetten"

#: filters/latex/kcm_ktptextui_message_filter_latex.desktop:9
msgctxt "Name"
msgid "LaTeX"
msgstr "LaTeX"

#: filters/latex/ktptextui_message_filter_latex.desktop.cmake:17
msgctxt "Name"
msgid "LaTeX Renderer"
msgstr "LaTeX-Wieser"

#: filters/latex/ktptextui_message_filter_latex.desktop.cmake:51
msgctxt "Comment"
msgid ""
"If incoming messages contain LaTeX between $$, it will render it directly "
"into the chat."
msgstr ""
"Bargt rinkamen Narichten LaTeX twischen $-Tekens, warrt dat direktemang "
"binnen den Klöönsnack wiest"

#: filters/searchexpansion/ktptextui_message_filter_searchexpansion.desktop.cmake:2
msgctxt "Name"
msgid "Web Shortcuts"
msgstr "Söökafkörten"

#: filters/searchexpansion/ktptextui_message_filter_searchexpansion.desktop.cmake:47
msgctxt "Comment"
msgid ""
"Expand a KDE-shortened URI into a URL (i.e. typing wp:KDE will translate to "
"http://en.wikipedia.org/wiki/KDE)"
msgstr ""
"En binnen KDE gellen Söökafkörten to en URL utfoolden (a.B. warrt ut "
"„wp:KDE“ de URL „http://de.wikipedia.org/wiki/KDE“)"

#: filters/texttospeech/ktptextui_message_filter_tts.desktop.cmake:2
msgctxt "Name"
msgid "Text To Speech"
msgstr "Vörleser"

#: filters/texttospeech/ktptextui_message_filter_tts.desktop.cmake:44
msgctxt "Comment"
msgid "Read out incoming messages using text-to-speech service"
msgstr "Rinkamen Narichten mit den Vörleesdeenst vörlesen laten"

#: filters/urlexpansion/ktptextui_message_filter_urlexpansion.desktop.cmake:3
msgctxt "Name"
msgid "Short URLs"
msgstr "Kort URLs"

#: filters/urlexpansion/ktptextui_message_filter_urlexpansion.desktop.cmake:38
msgctxt "Comment"
msgid "Shows the actual URL to which a shortened URL is redirecting to"
msgstr "Wiest de redige URL, op de en afkört URL wiest"

#: filters/youtube/ktptextui_message_filter_youtube.desktop.cmake:2
msgctxt "Name"
msgid "YouTube Preview"
msgstr "YouTube-Vöransicht"

#: filters/youtube/ktptextui_message_filter_youtube.desktop.cmake:41
msgctxt "Comment"
msgid ""
"If any messages contains a link to a YouTube video, it will embed a preview "
"in the chat"
msgstr ""
"För elkeen binnen en Naricht vörhannen Link op en YouTube-Video en "
"Vöransicht inbetten"

#: lib/ktptxtui_message_filter.desktop:4
msgctxt "Comment"
msgid "Telepathy Text-Ui Message Filter"
msgstr "Telepathy-Textböversiet-Narichtenfilter"

#: logviewer/config/kcm_ktp_logviewer_behavior.desktop:14
msgctxt "Name"
msgid "LogViewer Behavior"
msgstr "Logbookkieker-Bedregen"

#: logviewer/ktp-log-viewer.desktop:2
msgctxt "Name"
msgid "KDE IM Log Viewer"
msgstr "KDE-KN-Logbookkieker"

#: logviewer/ktp-log-viewer.desktop:43
msgctxt "GenericName"
msgid "KDE Instant Messenger Log Viewer"
msgstr "KDE sien Kortnarichten-Logbookkieker"

#: logviewer/ktp-log-viewer.desktop:84
msgctxt "Comment"
msgid "Displays your KDE Instant Messenger logs"
msgstr "Wiest Dien KDE-Kortnarichten-Logböker"
