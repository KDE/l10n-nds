msgstr "(Standard)"

#: shutdowndlg.cpp:492
msgid "&Cancel"
msgstr "&Afbreken"

#: shutdowndlg.cpp:554
#, kde-format
msgid "Logging out in 1 second."
msgid_plural "Logging out in %1 seconds."
msgstr[0] "Du warrst in 1 Sekunn afmeldt."
msgstr[1] "Du warrst in %1 Sekunnen afmeldt."

#: shutdowndlg.cpp:557
#, kde-format
