#: rc.cpp:57
msgid "Select &audio backend:"
msgstr "&Klangspeel-Hölper utsöken:"

#. i18n: tag string
#. i18n: file configWidgetUI.ui line 235
#: rc.cpp:60
msgid "Select audio de&vice:"
msgstr "&Klangreedschap utsöken:"

