#: interfaces/kimproxy/interface/dbusinstantmessenger.desktop:4
msgctxt "Comment"
msgid "Instant Messenger with a D-Bus interface"
msgstr "Kortnarichten-Maker mit en D-Bus-Koppelsteed"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:2
msgctxt "Name|standard desktop component"
msgid "Instant Messenger"
msgstr "Kortnarichten-Maker"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:65
msgctxt "Comment"
msgid ""
"The instant messenger allows two-way chat between individuals and groups."
msgstr ""
"Mit den Kortnarichten-Maker köönt enkelte Minschen oder Gruppen ünnerenanner "
"snacken."

#: interfaces/kspeech/dbustexttospeech.desktop:4
msgctxt "Comment"
msgid "Text-to-Speech Service with a D-Bus interface"
msgstr "Vörleesdeenst mit en DBUS-Koppelsteed"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:2
msgctxt "Name|standard desktop component"
msgid "Embedded Text Editor"
msgstr "Inbett Texteditor"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:64
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"De Texteditor-Deenst föögt Programmen en Textwieser un -editor to. KDE-"
"Programmen, mit de Texten bewerkt warrt, schöölt em bruken."

#: interfaces/ktexteditor/ktexteditor.desktop:5
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr "Inbettbor Texteditor-Komponent (mit Dokment/Ansicht-Trennen)"

#: interfaces/ktexteditor/ktexteditor_loadsavefiltercheckplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor load/save filter/check plugin"
msgstr "KTextEditor-Moduul för't Filtern/Pröven bi't Laden un Sekern"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "KTextEditor-Moduul"

#: kate/data/katepart.desktop:2
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Inbett verwiedert Texteditor"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:16
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Leestekensetter"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:99
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr "Sett al bi't Laden Leestekens för Regen, op de en Muster passt"

#: kate/plugins/autobrace/ktexteditor_autobrace.desktop:18
msgctxt "Name"
msgid "AutoBrace"
msgstr "AutoKlemmen"

#: kate/plugins/autobrace/ktexteditor_autobrace.desktop:70
msgctxt "Comment"
msgid "Insert closing braces on pressing Enter"
msgstr "Afsluten Klemmen mit de Ingaavtast infögen"

#: kate/plugins/exporter/ktexteditor_exporter.desktop:18
msgctxt "Name"
msgid "Exporter"
msgstr "Export"

#: kate/plugins/exporter/ktexteditor_exporter.desktop:71
msgctxt "Comment"
msgid "Export highlighted document to HTML"
msgstr "Syntaxmarkeert Dokment as HTML exporteren"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:17
msgctxt "Name"
msgid "Insert File"
msgstr "Datei infögen"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:104
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Jichtenseen leesbore Datei bi'n Blinker infögen"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:17
msgctxt "Name"
msgid "Data Tools"
msgstr "Datenwarktüüch"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:94
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr "Warktüüch as Thesaurus oder Klookschriever anmaken (wenn installeert)"

#: kate/plugins/pythonencoding/ktexteditor_python-encoding.desktop:5
msgctxt "Name"
msgid "Python encoding checker/adder"
msgstr "Python-Koderenprööv"

#: kate/plugins/pythonencoding/ktexteditor_python-encoding.desktop:73
msgctxt "Comment"
msgid "While saving check encoding of python files and add an encoding line"
msgstr ""
"Bi't Sekern de Koderen vun Python-Dateien pröven un en Koderen-Reeg tofögen"

#: kate/plugins/timedate/ktexteditor_timedate_config.desktop:7
msgctxt "Name"
msgid "Format of Time & Date insertion"
msgstr "Formaat för inföögt Datum un Tiet"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:18
msgctxt "Name"
msgid "Time & Date"
msgstr "Datum un Tiet"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:103
msgctxt "Comment"
msgid "Insert current Time & Date"
msgstr "Aktuell Datum un Tiet infögen"

