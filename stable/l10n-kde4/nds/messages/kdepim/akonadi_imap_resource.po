#: imapresource.cpp:187 imapresource.cpp:664 imapresource.cpp:884
msgid "There is currently no connection to the IMAP server."
msgstr "Opstunns gifft dat keen Verbinnen na den IMAP-Server."

#: imapresource.cpp:247
msgid "No message retrieved, server reply was empty."
msgstr "Keen Naricht kregen, de Server-Antwoort weer leddig."

#: imapresource.cpp:285
msgid "No server configured yet."
msgstr "Noch keen Server fastleggt."

#: imapresource.cpp:346
msgid "Connection established."
msgstr "Tokoppelt."

#: imapresource.cpp:544
msgid "Cannot move message, it does not exist on the server."
msgstr "De Naricht lett sik nich verschuven, dat gifft ehr op den Server nich."

#: imapresource.cpp:550
#, kde-format
msgid "Cannot move message out of '%1', '%1' does not exist on the server."
msgstr ""
"De Naricht lett sik nich ut \"%1\" rutschuven, dat gifft \"%1\" op den "
"Server nich."

#: imapresource.cpp:557
#, kde-format
msgid "Cannot move message to '%1', '%1' does not exist on the server."
msgstr ""
"De Naricht lett sik nich na \"%1\" verschuven, dat gifft \"%1\" op den "
"Server nich."

#: imapresource.cpp:601
#, kde-format
msgid ""
"Failed to move message out of '%1' on the IMAP server. Could not select '%1'."
msgstr ""
"De Naricht lett sik op den IMAP-Server nich ut \"%1\" rutschuven, \"%1\" "
"lett sik nich utsöken."

#: imapresource.cpp:636
#, kde-format
msgid ""
"Failed to move message to '%1' on the IMAP server. Could not copy into '%1'."
msgstr ""
"De Naricht lett sik op den IMAP-Server nich na \"%1\" verschuven, koperen na "
"\"%1\" nich mööglich."

#: imapresource.cpp:649
#, kde-format
msgid ""
"Failed to mark the message from '%1' for deletion on the IMAP server. It "
"will reappear on next sync."
msgstr ""
"De Naricht ut \"%1\" lett sik op den IMAP-Server nich för't Wegdoon "
"markeren. Se dukt bi de nakamen Synkroniseren wedder op."

#: imapresource.cpp:762
msgid "Inbox"
msgstr "Postingang"

#: imapresource.cpp:779
msgid "Shared Folders"
msgstr "Freegeven Ornern"

#: imapresource.cpp:1034
#, kde-format
msgid "Cannot add IMAP folder '%1' for a non-existing parent folder '%2'."
msgstr ""
"IMAP-Orner \"%1\" lett sik nich na en Böverorner \"%2\" tofögen, den dat "
"nich gifft."

#: imapresource.cpp:1069
#, kde-format
msgid "Failed to create folder '%1' on the IMAP server."
msgstr "De Orner \"%1\" lett sik op den IMAP-Server nich opstellen."

#: imapresource.cpp:1080
#, kde-format
msgid "Cannot modify IMAP folder '%1', it does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich ännern, dat gifft em op den Server nich."

#: imapresource.cpp:1131
#, kde-format
msgid ""
"ACLs for '%1' need to be retrieved from the IMAP server first. Skipping ACL "
"change"
msgstr ""
"För \"%1\" deit toeerst dat Halen vun Togriepkuntrulllisten (\"ACLs\") vun "
"den IMAP-Server noot. ACL-Ännern warrt övergahn."

#: imapresource.cpp:1302
msgid "Failed to rename the folder, restoring folder list."
msgstr "De Orner lett sik nich ümnömen, Ornerlist warrt wedderherstellt."

#: imapresource.cpp:1313
#, kde-format
msgid "Failed to write the new ACLs for '%1' on the IMAP server. %2"
msgstr ""
"För \"%1\" laat sik keen nieg Togriepkuntrulllisten op den IMAP-Server "
"schrieven. %2"

#: imapresource.cpp:1328
#, kde-format
msgid "Failed to write the new annotations for '%1' on the IMAP server. %2"
msgstr ""
"För \"%1\" laat sik keen nieg Anmarken op den IMAP-Server schrieven. %2"

#: imapresource.cpp:1356
msgid "Failed to delete the folder, restoring folder list."
msgstr "De Orner lett sik nich wegmaken, Ornerlist warrt wedderherstellt."

#: imapresource.cpp:1369
#, kde-format
msgid "Cannot move IMAP folder '%1', it does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich verschuven, dat gifft em op den Server "
"nich."

#: imapresource.cpp:1376
#, kde-format
msgid ""
"Cannot move IMAP folder '%1' out of '%2', '%2' does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich ut \"%2\" rutschuven, dat gifft \"%2\" op "
"den Server nich."

#: imapresource.cpp:1384
#, kde-format
msgid ""
"Cannot move IMAP folder '%1' to '%2', '%2' does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich na \"%2\" verschuven, dat gifft \"%2\" op "
"den Server nich."

#: imapresource.cpp:1421
#, kde-format
msgid "Failed to move folder '%1' out of '%2' on the IMAP server."
msgstr "De Orner \"%1\" lett sik op den IMAP-Server nich ut \"%2\" rutschuven."

#: imapresource.cpp:1431
#, kde-format
msgid "Failed to subscribe to the newly moved folder '%1' on the IMAP server."
msgstr ""
"De jüst op den IMAP-Server verschaven Orner \"%1\" lett sik nich bestellen."

