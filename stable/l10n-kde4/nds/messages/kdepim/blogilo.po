#: src/uploadmediadialog.cpp:160
msgid ""
"Inserted FTP URL is not a valid URL.\n"
"Note: The URL must start with \"ftp\" or \"sftp\", and end with a \"/\" that "
"indicates the directory to which the file should be uploaded."
