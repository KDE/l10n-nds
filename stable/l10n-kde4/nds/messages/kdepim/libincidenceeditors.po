msgid "End &after"
msgstr "Beennen n&a"

#: editorrecurrence.cpp:768
msgctxt "@label"
msgid "&occurrence(s)"
msgstr "Wedder&halen"

#: editorrecurrence.cpp:777
msgctxt "@info:whatsthis"
msgid "Sets the event or to-do to stop recurring on a certain date."
msgstr ""
"Leggt dat Datum fast, na dat de Opgaav oder dat Begeefnis nich wieder "
"wedderhaalt warrt."

#: editorrecurrence.cpp:779
