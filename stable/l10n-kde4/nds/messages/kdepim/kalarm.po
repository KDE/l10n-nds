#: rc.cpp:167 rc.cpp:515
msgctxt "@label"
msgid "Days to keep expired alarms"
msgstr "Wohrtiet in Daag för aflopen Alarms"

#. i18n: file: kalarmconfig.kcfg:194
#. i18n: ectx: whatsthis, entry (ArchivedKeepDays), group (General)
#: rc.cpp:170 rc.cpp:518
msgctxt "@info:whatsthis"
msgid ""
"<para>Specify how many days to keep alarms after they expire or are deleted "
"(except deleted alarms which were never triggered):\n"
"        <list><item>0 to not keep</item>\n"
"        <item>-1 to keep indefinitely</item>\n"
"        <item>>0 number of days to keep.</item></list></para>\n"
"      "
msgstr ""
"<para>Leggt fast, wo vele Daag Alarms ok na't Aflopen oder Wegdoon wohrt "
"warrt (utbenahmen wegdaan Alarms, de nienich utlööst wöörn):\n"
"        <list><item>\"0\" wohrt nix</item>\n"
"        <item>\"-1\" wohrt för all Tiet</item>\n"
"        <item>En Tall >0 gifft de Daag an, de Alarms wohrt warrt</item></"
"list></para>\n"
"      "

#. i18n: file: kalarmconfig.kcfg:202
