#. i18n: file: kalarmconfig.kcfg:84
#. i18n: ectx: label, entry (MessageButtonDelay), group (General)
#: rc.cpp:51 rc.cpp:399
msgctxt "@label"
msgid "Delay before message window buttons are enabled"
msgstr "Paus, ehr de Knööp binnen Bescheden anmaakt warrt"

#. i18n: file: kalarmconfig.kcfg:89
#. i18n: ectx: whatsthis, entry (MessageButtonDelay), group (General)
#: rc.cpp:54 rc.cpp:402
msgctxt "@info:whatsthis"
msgid ""
"<para>Specify the positioning of alarm message windows, and the delay in "
"seconds after a window shows until its buttons are enabled.\n"
"        <list><item>0 to position message windows as far from the cursor as "
"possible with no enable delay.</item>\n"
"        <item>> 0 to position in center of screen and specify delay before "
"enabling buttons.</item>\n"
"        <item>-1 for no special positioning and no enable delay.</item></"
"list></para>\n"
"      "
msgstr ""
"<para>Leggt de Steed för Bescheden fast un de Töövtiet in Sekunnen, ehr den "
"Bescheed sien Knööp anmaakt warrt.\n"
"        <list><item>\"0\" wiest den Bescheed so wiet as mööglich weg vun den "
"Muuswieser, keen Töövtiet</item>\n"
"        <item>En Tall >0 wiest den Bescheed op de Schirmmerrn, de Tall gifft "
"de Töövtiet för de Knööp an</item>\n"
"        <item>\"-1\" leggt keen besünner Steed fast, keen Töövtiet</item></"
"list></para>\n"
"      "

#. i18n: file: kalarmconfig.kcfg:95
#. i18n: ectx: label, entry (TooltipAlarmCount), group (General)
#: rc.cpp:61 rc.cpp:409
msgctxt "@label"
msgid "Number of alarms to show in system tray tooltip"
msgstr "Tall vun Alarms binnen de Systeemafsnitt-Kortinformatschoon"

#. i18n: file: kalarmconfig.kcfg:100
#. i18n: ectx: whatsthis, entry (TooltipAlarmCount), group (General)
#: rc.cpp:64 rc.cpp:412
msgctxt "@info:whatsthis"
msgid ""
"<para>How many alarms due in the next 24 hours to show in the system tray "
"tooltip:\n"
"        <list><item>0 to display none</item>\n"
"        <item>-1 to display all</item>\n"
"        <item>>0 to set a limit.</item></list></para>\n"
"      "
msgstr ""
"<para>Leggt fast, wo vele vun de Alarms binnen de Systeemafsnitt-Kortinfo "
"wiest warrt, de binnen de tokamen 24 Stünnen afloopt:\n"
"        <list><item>\"0\" wiest keeneen</item>\n"
"        <item>\"-1\" wiest all</item>\n"
"        <item>En Tall >0 sett en Grenz fast</item></list></para>\n"
"      "

