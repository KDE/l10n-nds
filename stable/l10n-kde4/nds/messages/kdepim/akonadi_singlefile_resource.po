#. i18n: file: singlefileresourceconfigdialog_desktop.ui:109
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:33 rc.cpp:96
msgid ""
"Select the file whose contents should be represented by this resource. If "
"the file does not exist, it will be created. A URL of a remote file can also "
"be specified, but note that monitoring for file changes will not work in "
"this case."
msgstr ""
"De Datei utsöken, de ehr Inholt disse Ressource praatstellen schall. Gifft "
"dat de Datei nich, warrt se opstellt. Du kannst ok en URL vun en Datei op en "
"anner Reekner angeven, man denn funkscheneert dat beluern op Ännern nich."

#: singlefileresourcebase.cpp:227
#, kde-format
msgid ""
"The file '%1' was changed on disk while there were still pending changes in "
"Akonadi. To avoid data loss, a backup of the internal changes has been "
"created at '%2'."
msgstr ""
"De Datei \"%1\" wöör op de Fastplaat ännert, bides stunnen binnen Akonadi ok "
"noch Ännern ut. Dormit keen Daten wegkaamt, hett Akonadi en Kopie mit sien "
"intern Ännern as \"%2\" sekert."

#: singlefileresourcebase.cpp:249
#, kde-format
msgid "Could not load file '%1'."
msgstr "Datei \"%1\" lett sik nich laden."

#: singlefileresourcebase.cpp:257 singlefileresourcebase.cpp:269
#: singlefileresource.h:90 singlefileresource.h:110 singlefileresource.h:173
msgctxt "@info:status"
msgid "Ready"
msgstr "Praat"

#: singlefileresourcebase.cpp:263
#, kde-format
msgid "Could not save file '%1'."
msgstr "Datei \"%1\" lett sik nich sekern."

#: singlefileresourceconfigdialogbase.cpp:89
msgctxt "@info:status"
msgid "Checking file information..."
msgstr "Datei-Informatschonen warrt pröövt..."

#: singlefileresource.h:61
msgid "No file selected."
msgstr "Keen Datei utsöcht."

#: singlefileresource.h:92
#, kde-format
msgid "Could not create file '%1'."
msgstr "Datei \"%1\" lett sik nich opstellen."

#: singlefileresource.h:102
#, kde-format
msgid "Could not read file '%1'"
msgstr "De Datei \"%1\" lett sik nich lesen."

#: singlefileresource.h:116
msgid "Another download is still in progress."
msgstr "Dor warrt noch wat anners daallaadt."

#: singlefileresource.h:123 singlefileresource.h:184
msgid "Another file upload is still in progress."
msgstr "Dor warrt noch wat anners hoochlaadt."

#: singlefileresource.h:137
msgid "Downloading remote file."
msgstr "Feern Datei warrt daallaadt."

#: singlefileresource.h:147
#, kde-format
msgid "Trying to write to a read-only file: '%1'."
msgstr "Schrieven op bloots-leesbor Datei \"%1\" nich mööglich."

#: singlefileresource.h:155
msgid "No file specified."
msgstr "Keen Datei angeven."

#: singlefileresource.h:178
msgid "A download is still in progress."
msgstr "Dor warrt noch wat daallaadt."

#: singlefileresource.h:209
msgid "Uploading cached file to remote location."
msgstr "Twischenspiekert Datei warrt na anner Reekner hoochlaadt."

