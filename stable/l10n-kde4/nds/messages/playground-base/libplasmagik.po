#: rc.cpp:3 rc.cpp:195
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600; font-style:italic;\">NOTE</span><span style=\" font-style:italic;"
"\"> that the </span><span style=\" font-weight:600; font-style:italic;"
"\">whole directory</span><span style=\" font-style:italic;\"> will be "
"packaged!</span><br />Please select the folder containing the content you "
"want to <br />have packaged:</p></body></html>"
