#: board.cpp:403
#, kde-format
msgid ""
"You won.\n"
"You even removed the last stone, great job!\n"
" Your score was %1."
msgstr ""
"Du hest wunnen.\n"
"Du hest sogor den lesten Steen wegdaan, goot maakt!\n"
" Du hest %1 Pünkt."

#: board.cpp:405
#, kde-format
msgid ""
"Game over.\n"
"There are no more removable stones.\n"
" Your score was %1."
msgstr ""
"Speel vörbi.\n"
"Du kannst keen Stenen mehr wegdoon.\n"
" Du hest %1 Pünkt."

