#: addcollectiontask.cpp:46
#, kde-format
msgid "Cannot add IMAP folder '%1' for a non-existing parent folder '%2'."
msgstr ""
"IMAP-Orner \"%1\" lett sik nich na en Böverorner \"%2\" tofögen, den dat "
"nich gifft."

#: addcollectiontask.cpp:100 movecollectiontask.cpp:107
#, kde-format
msgid ""
"Failed to subscribe to the folder '%1' on the IMAP server. It will disappear "
"on next sync. Use the subscription dialog to overcome that"
msgstr ""
"De Orner \"%1\" op den IMAP-Server lett sik nich bestellen. He dukt bi de "
"nakamen Synkroniseren nich wedder op. Bruuk den Bestelldialoog, wenn Du dat "
"wegkriegen wullt."

#: addcollectiontask.cpp:144 changecollectiontask.cpp:279
#, kde-format
msgid "Failed to write some annotations for '%1' on the IMAP server. %2"
msgstr ""
"En poor Anmarken för \"%1\" laat sik op den IMAP-Server nich schrieven. %2"

#: additemtask.cpp:135 changeitemtask.cpp:212 changeitemtask.cpp:237
#: moveitemtask.cpp:209
msgid "Could not determine the UID for the newly created message on the server"
msgstr ""
"De UID för de tolest op den Server opstellt Naricht lett sik nich fastslaan."

#: changecollectiontask.cpp:48
#, kde-format
msgid "Cannot modify IMAP folder '%1', it does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich ännern, dat gifft em op den Server nich."

#: changecollectiontask.cpp:61
#, kde-format
msgid ""
"ACLs for '%1' need to be retrieved from the IMAP server first. Skipping ACL "
"change"
msgstr ""
"För \"%1\" deit toeerst dat Halen vun Togriepkuntrulllisten (\"ACLs\") vun "
"den IMAP-Server noot. ACL-Ännern warrt övergahn."

#: changecollectiontask.cpp:239
msgid "Failed to rename the folder, restoring folder list."
msgstr "De Orner lett sik nich ümnömen, Ornerlist warrt wedderherstellt."

#: changecollectiontask.cpp:258
#, kde-format
msgid ""
"Failed to subscribe to the renamed folder '%1' on the IMAP server. It will "
"disappear on next sync. Use the subscription dialog to overcome that"
msgstr ""
"De ümnöömt Orner \"%1\" op den IMAP-Server lett sik nich bestellen. He dukt "
"bi de nakamen Synkroniseren nich wedder op. Bruuk den Bestelldialoog, wenn "
"Du dat wegkriegen wullt."

#: changecollectiontask.cpp:269
#, kde-format
msgid "Failed to write some ACLs for '%1' on the IMAP server. %2"
msgstr ""
"En poor Togriepkuntrulllisten för \"%1\" laat sik op den IMAP-Server nich "
"schrieven. %2"

#: imapresource.cpp:107
#, kde-format
msgid "IMAP Account %1"
msgstr "IMAP-Konto %1"

#: imapresource.cpp:109
msgid "IMAP Account"
msgstr "IMAP-Konto"

#: imapresource.cpp:205
msgid "No server configured yet."
msgstr "Noch keen Server fastleggt."

#: imapresource.cpp:225
msgid "Connection established."
msgstr "Tokoppelt."

#: movecollectiontask.cpp:44
#, kde-format
msgid "Cannot move IMAP folder '%1', it does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich verschuven, dat gifft em op den Server "
"nich."

#: movecollectiontask.cpp:51
#, kde-format
msgid ""
"Cannot move IMAP folder '%1' out of '%2', '%2' does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich ut \"%2\" rutschuven, dat gifft \"%2\" op "
"den Server nich."

#: movecollectiontask.cpp:59
#, kde-format
msgid ""
"Cannot move IMAP folder '%1' to '%2', '%2' does not exist on the server."
msgstr ""
"De IMAP-Orner \"%1\" lett sik nich na \"%2\" verschuven, dat gifft \"%2\" op "
"den Server nich."

#: moveitemtask.cpp:53
msgid "Cannot move message, it does not exist on the server."
msgstr "De Naricht lett sik nich verschuven, dat gifft ehr op den Server nich."

#: moveitemtask.cpp:59
#, kde-format
msgid "Cannot move message out of '%1', '%1' does not exist on the server."
msgstr ""
"De Naricht lett sik nich ut \"%1\" rutschuven, dat gifft \"%1\" op den "
"Server nich."

#: moveitemtask.cpp:66
#, kde-format
msgid "Cannot move message to '%1', '%1' does not exist on the server."
msgstr ""
"De Naricht lett sik nich na \"%1\" verschuven, dat gifft \"%1\" op den "
"Server nich."

#: moveitemtask.cpp:115
#, kde-format
msgid "Failed to copy item, it has no message payload. Remote id: %1"
msgstr "Indrag lett sik nich koperen, he bargt keen Bruukdaten. Feern ID: %1"

#: moveitemtask.cpp:164
#, kde-format
msgid ""
"Failed to mark the message from '%1' for deletion on the IMAP server. It "
"will reappear on next sync."
msgstr ""
"De Naricht ut \"%1\" lett sik op den IMAP-Server nich för't Wegdoon "
"markeren. Se dukt bi de nakamen Synkroniseren wedder op."

