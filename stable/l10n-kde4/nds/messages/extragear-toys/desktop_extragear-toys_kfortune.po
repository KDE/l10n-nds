#: eventsrc:3
msgctxt "Comment"
msgid "KFortune"
msgstr "KFortune"

#: eventsrc:13
msgctxt "Name"
msgid "Could not execute the 'fortune' program"
msgstr "Kann dat Programm 'fortune' nich utföhren."

#: eventsrc:59
msgctxt "Comment"
msgid "KFortune failed to execute the external 'fortune' program"
msgstr ""
"KFortune hett versöcht, dat externe Programm 'fortune' uttoföhren, man dat "
"hett dorbi en Fehler geven."

#: eventsrc:107
msgctxt "Name"
msgid "Could not create output file"
msgstr "Kann de Utgaav-Datei nich opstellen"

#: eventsrc:154
msgctxt "Comment"
msgid "KFortune failed to create the output file to save the text"
msgstr ""
"KFortune hett versöcht de Utgaav-Datei optostellen üm den Text to sekern, "
"man dorbi hett dat en Fehler geven."

