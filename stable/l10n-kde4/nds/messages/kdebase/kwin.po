#: killer/killer.cpp:67
#, kde-format
msgid ""
"<p>Window with title \"<b>%2</b>\" is not responding. This window belongs to "
"application <b>%1</b> (PID=%3, hostname=%4).</p><p>Do you wish to terminate "
"this application? (All unsaved data in this application will be lost.)</p>"
msgstr ""
"<p>Dat Finster mit den Titel \"<b>%2</b>\" reageert nich. Dat höört dat "
"Programm <b>%1</b> (PID=%3, Reeknernaam=%4) to.</p><p>Wullt du dit Programm "
"afbreken (all nich sekerte Daten vun dit Programm warrt verloren gahn) ?</p>"

