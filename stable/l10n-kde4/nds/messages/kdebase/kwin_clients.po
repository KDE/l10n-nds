#. i18n: file: ozone/config/oxygenconfig.ui:55
#. i18n: ectx: property (whatsThis), widget (QCheckBox, blendTitlebarColors)
#: rc.cpp:45
msgid ""
"When enabled, this option makes the window title bar use the same colors as "
"the window contents, instead of using the system title bar colors."
msgstr ""
"Wenn anmaakt, bruukt de Finster-Titelbalken de sülven Klören as de Finster-"
"Inholt, man nich de Systeem-Titelbalkenklören."

#. i18n: file: ozone/config/oxygenconfig.ui:58
#. i18n: ectx: property (text), widget (QCheckBox, blendTitlebarColors)
#: rc.cpp:48
msgid "Blend title bar colors with window contents"
msgstr "Titelbalken-Klören na Finsterinholt mischen"

#. i18n: file: ozone/config/oxygenconfig.ui:65
#. i18n: ectx: property (whatsThis), widget (QCheckBox, showStripes)
#. i18n: file: oxygen/config/oxygenconfig.ui:55
#. i18n: ectx: property (whatsThis), widget (QCheckBox, showStripes)
#: rc.cpp:51 rc.cpp:72
msgid ""
"When enabled, this option increases the visibility of the window titlebar by "
"showing stripes"
msgstr ""
"Wenn anmaakt, maakt disse Optschoon den Finster-Titelbalken mit Striepen "
"beter sichtbor."

#. i18n: file: ozone/config/oxygenconfig.ui:68
#. i18n: ectx: property (text), widget (QCheckBox, showStripes)
#. i18n: file: oxygen/config/oxygenconfig.ui:58
#. i18n: ectx: property (text), widget (QCheckBox, showStripes)
#: rc.cpp:54 rc.cpp:75
msgid "Show stripes next to the title"
msgstr "Striepen blang Titel wiesen"

